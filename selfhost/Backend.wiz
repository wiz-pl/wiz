-- The backend, in Wiz (stage 21): from the kernel terms the self-hosted frontend checks
-- to C. Load it after `Frontend.wiz`. A first, minimal version (21a–b): no reference
-- counting (the runtime collects garbage); payloads are nested pairs, though the
-- runtime keeps a chain of them as one object (`chainE`).
--
-- **Erasure** (21a) follows `Wiz/Compiler/Erase.lean`: a checked term becomes an
-- untyped program (`ETm`) without what has no runtime content. Types (anything whose
-- type is a sort), proofs (anything whose type is a proposition) and sizes become `◾`,
-- and so do the arguments and the first components of quantity `0`. Binders are kept
-- (an erased argument is passed as `◾`), so de Bruijn indices don't change. Erasure is
-- type directed: `eraseCheck` knows the expected type, `eraseInfer` computes it.
--
-- **Data.** A value of `μ D i` is its payload, nested pairs `(tag, (f₁, … ◾))`, except
-- for a type shaped like the natural numbers (two constructors, the second with one
-- recursive field, no index): its values are native numbers, and a match on one first
-- unpacks it (`natUnpack`). Descriptions are runtime data (`ret i` is `⟨0 i⟩`, `arg S F`
-- is `⟨1 ◾ F⟩`, `rec j E` is `⟨2 j E⟩`, `hrec H j E` is `⟨3 ◾ j E⟩`): the runtime's `ind`
-- walks them to compute the induction hypotheses.

mutual
inductive ETm where
  | erased
  | var (i : Nat)
  | glob (name : String)
  | lam (body : ETm)
  | app (f a : ETm)
  | letE (val body : ETm)
  -- an object: a tag and fields (a pair is `obj 0 [a, b]`, a tag `obj k []`)
  | obj (tag : Nat) (fields : ETms)
  | proj (i : Nat) (t : ETm)
  -- branch on the tag of a value
  | case (scrut : ETm) (branches : ETms)
  | nat (n : Nat)
  -- a runtime operation: `ind`, `natSucc`, `natUnpack`, `natPack`, `unreachable`
  | prim (op : String) (args : ETms)
inductive ETms where
  | nil
  | cons (t : ETm) (rest : ETms)
end

def etms1 (a : ETm) : ETms := .cons a .nil
def etms2 (a b : ETm) : ETms := .cons a (etms1 b)
def etms4 (a b c d : ETm) : ETms := .cons a (.cons b (etms2 c d))
def epair (a b : ETm) : ETm := .obj 0 (etms2 a b)
def eapps : ETm → ETms → ETm
  | f, .nil => f
  | f, .cons a rest => eapps (.app f a) rest

mutual
def showE : ETm → String
  | .erased => "◾"
  | .var i => String.append "#" (Nat.toString i)
  | .glob n => n
  | .lam b => String.append "(λ " (String.append (showE b) ")")
  | .app f a => String.append "(" (String.append (showE f) (String.append " " (String.append (showE a) ")")))
  | .letE v b => String.append "(let " (String.append (showE v) (String.append "; " (String.append (showE b) ")")))
  | .obj t fs => String.append "⟨" (String.append (Nat.toString t) (String.append (showEs fs) "⟩"))
  | .proj i t => String.append (showE t) (String.append "." (Nat.toString i))
  | .case s bs => String.append "(case " (String.append (showE s) (String.append " [" (String.append (showEs bs) "])")))
  | .nat n => Nat.toString n
  | .prim op as => String.append "(" (String.append op (String.append (showEs as) ")"))
def showEs : ETms → String
  | .nil => ""
  | .cons t rest => String.append " " (String.append (showE t) (showEs rest))
end

-- Has a value of this type no runtime content? (types, proofs, sizes, and their lifts)
partial def erasable (c : TCtx) (ty : Val) : Bool := match whnf ty with
  | .vsort _ => .true
  | .vsize => .true
  | .vsizeLt _ => .true
  | .vulift _ _ A => erasable c A
  | t => isProp c t

-- Is this `μ` shaped like the natural numbers? Its values are numbers at runtime.
def isNatDesc (D : Val) : Bool := match whnf D with
  | .vdarg _ S F => match whnf S with
    | .venum k => match Nat.beq k 2 with
      | .true => match whnf (vapp F (.vtag 2 0)) with
        | .vdret _ => match whnf (vapp F (.vtag 2 1)) with
          | .vdrec _ _ E => match whnf E with
            | .vdret _ => .true
            | _ => .false
          | _ => .false
        | _ => .false
      | .false => .false
    | _ => .false
  | _ => .false
def isNatTy (ty : Val) : Bool := match whnf ty with
  | .vmu _ I D _ _ => match whnf I with
    | .vunit _ => isNatDesc D
    | _ => .false
  | _ => .false

-- (the kernel has accepted the term: nothing to require of its proof markers, `inProof`)
def inferTy (c : TCtx) (t : Tm) : Option Val := match infer (TCtx.inProof c) t with
  | .ok ty _ => .some ty
  | .err _ => .none
-- the type of a term already known to be well typed, without checking it again: along
-- an elimination spine, else by the kernel's `infer` (erasure asks for the type of
-- every subterm; a full `infer` at each would be quadratic in the nesting depth)
partial def quickType (c : TCtx) (t : Tm) : Option Val := match t with
  | .var i => .some (lookup (TCtx.types c) i)
  | .const _ ps ls _ ty => .some (eval .nil (substIfAny ps ls ty))
  | .app f a => match quickType c f with
    | .some fty => match whnf fty with
      -- (the argument evaluated only if the codomain mentions it, as in the kernel)
      | .vpi _ _ _ _ env cod => .some (eval (.cons (match usesVar 0 cod with
          | .true => eval (TCtx.env c) a
          | .false => .vtt) env) cod)
      | _ => inferTy c t
    | .none => .none
  | .fst p => match quickType c p with
    | .some pty => match whnf pty with
      | .vsigma _ _ _ A _ _ => .some A
      | _ => inferTy c t
    | .none => .none
  | .snd p => match quickType c p with
    | .some pty => match whnf pty with
      | .vsigma _ _ _ _ env B => .some (eval (.cons (vfst (eval (TCtx.env c) p)) env) B)
      | _ => inferTy c t
    | .none => .none
  | .ann _ ty => .some (eval (TCtx.env c) ty)
  | .ecase m s _ => .some (eval (.cons (eval (TCtx.env c) s) (TCtx.env c)) m)
  | .ind _ _ _ _ P _ i x => .some (vapp (vapp (eval (TCtx.env c) P) (eval (TCtx.env c) i)) (eval (TCtx.env c) x))
  -- (the forms a match leaves: without these, erasing a match inferred the whole match
  -- again at every nested split)
  | .scase _ _ _ _ _ P _ _ i x => .some (vapp (vapp (eval (TCtx.env c) P) (eval (TCtx.env c) i)) (eval (TCtx.env c) x))
  | .exfalso m _ => .some (eval (TCtx.env c) m)
  | .coe _ B _ _ => .some (eval (TCtx.env c) B)
  | .tag k _ => .some (.venum k)
  | .star => .some (.vunit 1)
  | .letE A v b => quickType (TCtx.define c (eval (TCtx.env c) v) (eval (TCtx.env c) A)) b
  | .letq _ A v b => quickType (TCtx.define c (eval (TCtx.env c) v) (eval (TCtx.env c) A)) b
  | .letUnit _ b => quickType c b
  | .down x => match quickType c x with
    | .some xty => match whnf xty with
      | .vulift _ _ A => .some A
      | _ => inferTy c t
    | .none => .none
  | _ => inferTy c t

-- the payload of a value of `ty` for a match: unpacked from a number
def payloadOf (ty : Val) (x : ETm) : ETm := match isNatTy ty with
  | .true => .prim "natUnpack" (etms1 x)
  | .false => x

-- the result of erasing: the term, or why it failed
inductive ER where
  | ok (t : ETm)
  | err (msg : String)
inductive ERs where
  | ok (ts : ETms)
  | err (msg : String)

-- a literal payload `(tag k, rest)` of a natural number: `0` or the successor of the
-- field in `rest` (else the generic `natPack`)
def natOf (x : Tm) (x' : ETm) : ETm := match x' with
  | .obj _ fs => match fs with
    | .cons tg rest => match tg with
      | .obj k _ => match k with
        | .zero => .nat 0
        | .succ _ => match rest with
          | .cons r _ => match r with
            | .obj _ gs => match gs with
              | .cons f _ => .prim "natSucc" (etms1 f)
              | .nil => .prim "natPack" (etms1 x')
            | _ => .prim "natPack" (etms1 x')
          | .nil => .prim "natPack" (etms1 x')
      | _ => .prim "natPack" (etms1 x')
    | .nil => .prim "natPack" (etms1 x')
  | _ => .prim "natPack" (etms1 x')

mutual
-- **Exercise 21.1.** Erase `t`, checking it against `ty` (`eraseCheck` in `Erase.lean`):
-- an erasable type gives `◾`; `fun` against a Π erases the body under the binder; a
-- pair against a Σ is `⟨0 a b⟩` (`a` erased for quantity `0`); `con x` against `μ D i`
-- is the erased payload (a number for a type shaped like the naturals: `natOf`); the
-- descriptions are objects (see above); `tt` is `◾`; a `let` keeps its binder;
-- anything else is inferred (`eraseInfer`).
def eraseCheck (c : TCtx) (t : Tm) (ty : Val) : ER := match erasable c ty with
  | .true => .ok .erased
  | .false =>
  --<sol
  match t with
  | .lam b => match whnf ty with
    | .vpi _ _ _ dom env cod => match eraseCheck (TCtx.bind c dom) b (eval (.cons (fresh (TCtx.lvl c)) env) cod) with
      | .ok b' => .ok (.lam b')
      | e => e
    | _ => eraseInfer c t
  | .pair a b => match whnf ty with
    | .vsigma q _ _ A env B =>
      let ar : ER := match q with
        | .qz => .ok .erased
        | _ => eraseCheck c a A;
      match ar with
      | .ok a' => match eraseCheck c b (eval (.cons (eval (TCtx.env c) a) env) B) with
        | .ok b' => .ok (epair a' b')
        | e => e
      | e => e
    | _ => eraseInfer c t
  | .con x => match whnf ty with
    | .vmu l I D i sz => match eraseCheck c x (vInterp l I D (muFamilyAt l I D (sizePredOrInf sz)) i) with
      | .ok x' => match isNatTy ty with
        | .true => .ok (natOf x x')
        | .false => .ok x'
      | e => e
    | _ => eraseInfer c t
  | .dret i => match whnf ty with
    | .vdesc _ I => match eraseCheck c i I with
      | .ok i' => .ok (.obj 0 (etms1 i'))
      | e => e
    | _ => eraseInfer c t
  | .darg _ S D => match whnf ty with
    | .vdesc l I => match eraseCheck c D (.vpi .qw (ln (l + 1)) (ln (l + 2)) (eval (TCtx.env c) S) (.cons I .nil) (.descr l (.var 1))) with
      | .ok D' => .ok (.obj 1 (etms2 .erased D'))
      | e => e
    | _ => eraseInfer c t
  | .drec _ j D => match whnf ty with
    | .vdesc _ I => match eraseCheck c j I with
      | .ok j' => match eraseCheck c D ty with
        | .ok D' => .ok (.obj 2 (etms2 j' D'))
        | e => e
      | e => e
    | _ => eraseInfer c t
  | .dhrec _ H j D => match whnf ty with
    | .vdesc l I => match eraseCheck c j (.vpi .qw (ln (l + 1)) (ln (l + 1)) (eval (TCtx.env c) H) (.cons I .nil) (.var 1)) with
      | .ok j' => match eraseCheck c D ty with
        | .ok D' => .ok (.obj 3 (.cons .erased (etms2 j' D')))
        | e => e
      | e => e
    | _ => eraseInfer c t
  | .star => .ok .erased
  -- (P2) a marked proof is erased; a marker at another level is transparent
  | .prf l x => match lvlIsZero l with
    | .true => .ok .erased
    | .false => eraseCheck c x ty
  -- (Q4) `ULift` has no runtime content
  | .up a => match whnf ty with
    | .vulift _ _ A => eraseCheck c a A
    | _ => eraseInfer c t
  | .letE A v b =>
    let vA := eval (TCtx.env c) A;
    match eraseCheck c v vA with
    | .ok v' => match eraseCheck (TCtx.define c (eval (TCtx.env c) v) vA) b ty with
      | .ok b' => .ok (.letE v' b')
      | e => e
    | e => e
  -- a `let` at a quantity: at 0 the value is never computed (the kernel checks it as an
  -- erased position, so it may only be valid erased). The frontend produces it for a
  -- `let` with a written quantity (stage 21m)
  | .letq q A v b =>
    let vA := eval (TCtx.env c) A;
    let vr : ER := match q with
      | .qz => .ok .erased
      | _ => eraseCheck c v vA;
    match vr with
    | .ok v' => match eraseCheck (TCtx.define c (eval (TCtx.env c) v) vA) b ty with
      | .ok b' => .ok (.letE v' b')
      | e => e
    | e => e
  -- (linear-case stage 2) `let () := u; b` must evaluate `u` before `b`, and this
  -- backend's `let`s are lazy (a `let` whose variable is unused is dropped): refuse it
  -- rather than skip `u`. The self-hosted frontend never produces it.
  | .letUnit _ _ => .err "erasure: `let () := u` (the unit eliminator) is not supported by the self-hosted backend"
  | _ => eraseInfer c t
  --|ex
  --| .err "not implemented"
  --sol>
-- erase `t`, computing its type
def eraseInfer (c : TCtx) (t : Tm) : ER := match quickType c t with
  | .none => .err "erasure: an ill-typed term"
  | .some ty => match erasable c ty with
    | .true => .ok .erased
    | .false => match t with
      | .var i => .ok (.var i)
      | .const n _ _ _ _ => .ok (.glob n)
      | .app _ _ => eraseApp c t
      | .ann x A => eraseCheck c x (eval (TCtx.env c) A)
      | .letE _ _ _ => eraseCheck c t ty
      | .letq _ _ _ _ => eraseCheck c t ty
      | .letUnit _ _ => eraseCheck c t ty
      | .fst p => match eraseInfer c p with
        | .ok p' => .ok (.proj 0 p')
        | e => e
      | .snd p => match eraseInfer c p with
        | .ok p' => .ok (.proj 1 p')
        | e => e
      | .tag _ i => .ok (.obj i .nil)
      | .ecase m s bs => match eraseInfer c s with
        | .ok s' => match eraseBranches c m 0 bs with
          | .ok bs' => .ok (.case s' bs')
          | .err msg => .err msg
        | e => e
      | .coe A _ _ x => eraseCheck c x (eval (TCtx.env c) A)   -- (a function under a cast is checked)
      | .exfalso _ _ => .ok (.prim "unreachable" .nil)
      | .down x => eraseInfer c x
      | .prf _ x => eraseInfer c x
      | .ind l I D v P m i x =>
        let vI := eval (TCtx.env c) I;
        let vD := eval (TCtx.env c) D;
        let vP := eval (TCtx.env c) P;
        match eraseCheck c m (indMethodTy l v vI vD vP) with
        | .ok m' => match eraseCheck c D (.vdesc l vI) with
          | .ok D' => match eraseCheck c i vI with
            | .ok i' => match eraseInfer c x with
              | .ok x' =>
                let nat := match isNatTy (.vmu l vI vD (eval (TCtx.env c) i) .vszInf) with
                  | .true => 1
                  | .false => 0;
                .ok (.prim "ind" (.cons (.nat nat) (etms4 D' m' i' x')))
              | e => e
            | e => e
          | e => e
        | e => e
      | .scase l q I D v P m sz i x =>
        -- `m ◾ i payload` (K1: a case at 0 has an erased scrutinee, whose payload is ◾)
        let vI := eval (TCtx.env c) I;
        let vD := eval (TCtx.env c) D;
        match eraseCheck c m (scaseMethodTy l v q vI vD (eval (TCtx.env c) P) (eval (TCtx.env c) sz)) with
        | .ok m' => match eraseCheck c i vI with
          | .ok i' => match q with
            | .qz => .ok (eapps m' (.cons .erased (etms2 i' .erased)))
            | _ => match eraseInfer c x with
              | .ok x' => .ok (eapps m' (.cons .erased (etms2 i' (payloadOf (.vmu l vI vD (eval (TCtx.env c) i) .vszInf) x'))))
              | e => e
          | e => e
        | e => e
      | _ => .err "erasure: unsupported term"
-- the branches of an `ecase` with motive `m` (under the tag's binder), from tag `k`
def eraseBranches (c : TCtx) (m : Tm) (k : Nat) : Tms → ERs
  | .tnil => .ok .nil
  | .tcons b rest => match eraseCheck c b (eval (.cons (.vtag (k + 1 + tmsLen rest) k) (TCtx.env c)) m) with
    | .ok b' => match eraseBranches c m (k + 1) rest with
      | .ok bs => .ok (.cons b' bs)
      | e => e
    | .err msg => .err msg
-- an application: the head and the arguments, each erased against the head's type (an
-- argument of quantity `0`, or of an erasable type, is `◾`)
def eraseApp (c : TCtx) (t : Tm) : ER := match quickType c (spineHead t) with
  | .none => .err "erasure: an ill-typed head"
  | .some hty => match eraseInfer c (spineHead t) with
    | .ok h' => eraseArgs c h' hty (spineArgsTm t .nil)
    | e => e
def eraseArgs (c : TCtx) (f : ETm) (fty : Val) : List Tm → ER
  | .nil => .ok f
  | .cons a rest => match whnf fty with
    | .vpi q _ _ dom env cod =>
      let ar : ER := match q with
        | .qz => .ok .erased
        | _ => eraseCheck c a dom;
      match ar with
      | .ok a' => eraseArgs c (.app f a') (eval (.cons (match usesVar 0 cod with
          | .true => eval (TCtx.env c) a
          | .false => .vtt) env) cod) rest
      | e => e
    | _ => .err "erasure: applying a non-function"
end


-- **C generation** (21b). Each erased term becomes one C expression (GNU statement
-- expressions `({ … })` for `let` and `case`); a `λ` is lifted to a C function of its
-- captured variables and its argument, and becomes a closure. A global is a value built
-- the first time it is used (`get_g()`), named by its name, so the recursive calls of
-- a partial definition (to its axiom) reach the definition. Some globals are native
-- (`isNative`): the runtime provides them, their Wiz definitions are not compiled.

-- the C name of a global: letters and digits kept, any other character as `_code_`
def mangleChars : List Char → List Char
  | .nil => .nil
  | .cons c rest =>
    let k := Char.code c;
    match Bool.or (Bool.or (between k 48 57) (between k 65 90)) (between k 97 122) with
    | .true => .cons c (mangleChars rest)
    | .false => match Nat.toString k with
      | .mk ds => .cons (Char.mk 95) (List.append ds (.cons (Char.mk 95) (mangleChars rest)))
def mangle (n : String) : String := match n with
  | .mk cs => .mk (mangleChars cs)

def isNative (n : String) : Bool := elemStr n nativeNames

-- the free variables of a term (indices at its top, each once)
def addVar (i : Nat) : List Nat → List Nat
  | .nil => .cons i .nil
  | .cons j rest => match Nat.beq i j with
    | .true => .cons j rest
    | .false => .cons j (addVar i rest)
def dropBound : List Nat → List Nat
  | .nil => .nil
  | .cons i rest => match i with
    | .zero => dropBound rest
    | .succ j => .cons j (dropBound rest)
mutual
def freeE : ETm → List Nat → List Nat
  | .var i, acc => addVar i acc
  | .lam b, acc => mergeVars (dropBound (freeE b .nil)) acc
  | .app f a, acc => freeE a (freeE f acc)
  | .letE v b, acc => mergeVars (dropBound (freeE b .nil)) (freeE v acc)
  | .obj _ fs, acc => freeEs fs acc
  | .proj _ t, acc => freeE t acc
  | .case s bs, acc => freeEs bs (freeE s acc)
  | .prim _ as, acc => freeEs as acc
  | _, acc => acc
def freeEs : ETms → List Nat → List Nat
  | .nil, acc => acc
  | .cons t rest, acc => freeEs rest (freeE t acc)
def mergeVars : List Nat → List Nat → List Nat
  | .nil, acc => acc
  | .cons i rest, acc => mergeVars rest (addVar i acc)
end

-- Code is built as a rope (`Doc`), printed piece by piece at the end: a `String` is a
-- list of characters, and appending copies its left side, so building a deep
-- expression by appending (2600 nested `ap(…)`s for a string literal) was quadratic.
inductive Doc where
  | t (s : String)
  | c (a b : Doc)
infixl:65 " ⧺ " => Doc.c
def Doc.nat (n : Nat) : Doc := .t (Nat.toString n)

-- the code so far: the lifted functions (latest first), a counter for names, and the
-- arity of each global defined by `λ`s (called directly when applied to that many
-- arguments: through curried closures, a call of `n` arguments made `n` closures, each
-- copying the arguments before it), and (reference counting mode) a reuse token wanted
-- by an allocation not yet given one (`Wish`, see `rcE`), and the projection prefixes
-- bound in the current scope (stage 15j, by level of their variable: `x.2`, …, `x.2^k`)
-- (the prefixes bound, by level: `x.2`, …, `x.2^k`)
inductive PE where
  | nil
  | cons (x k : Nat) (rest : PE)
inductive Wish where
  | idle
  | want (w : String) (n : Nat)
inductive CG where
  | mk (fns : List Doc) (n : Nat) (ar : StrMap Nat) (pend : Wish) (pe : PE)
inductive CR where
  | mk (code : Doc) (st : CG)
inductive FR where
  | mk (name : String) (st : CG)
def CG.fresh (st : CG) (base : String) : FR := match st with
  | .mk fns n ar p pe => .mk (String.append base (Nat.toString n)) (.mk fns (n + 1) ar p pe)
def CG.emit (st : CG) (f : Doc) : CG := match st with
  | .mk fns n ar p pe => .mk (.cons f fns) n ar p pe
def CG.arity (st : CG) (g : String) : Nat := match st with
  | .mk _ _ ar _ _ => StrMap.findD ar (Str.ofString g) 0
def CG.pend (st : CG) : Wish := match st with
  | .mk _ _ _ p _ => p
def CG.setPend (st : CG) (p : Wish) : CG := match st with
  | .mk fns n ar _ pe => .mk fns n ar p pe
def CG.pe (st : CG) : PE := match st with
  | .mk _ _ _ _ pe => pe
def CG.setPe (st : CG) (pe : PE) : CG := match st with
  | .mk fns n ar p _ => .mk fns n ar p pe
-- an application's head and arguments
inductive ESpine where
  | mk (head : ETm) (args : List ETm)
def spineE : ETm → List ETm → ESpine
  | .app f a, acc => spineE f (.cons a acc)
  | t, acc => .mk t acc
def lamsOf : ETm → Nat
  | .lam b => lamsOf b + 1
  | _ => 0
def underLams : Nat → ETm → ETm
  | .zero, t => t
  | .succ k, t => match t with
    | .lam b => underLams k b
    | _ => t

-- the C expression of variable `i`: `names` are the C names of the variables in scope,
-- innermost first
def nthName' : List String → Nat → String
  | .nil, _ => "BOX(0)"
  | .cons x rest, i => match i with
    | .zero => x
    | .succ j => nthName' rest j
def joinC : List String → String
  | .nil => ""
  | .cons x rest => match rest with
    | .nil => x
    | .cons _ _ => x +++ ", " +++ joinC rest
def indexOfNat : Nat → List Nat → Nat → Option Nat
  | _, .nil, _ => .none
  | x, .cons y rest, i => match Nat.beq x y with
    | .true => .some i
    | .false => indexOfNat x rest (i + 1)
-- the captured variables' names inside a lifted function: `env[0]`, `env[1]`, …
def envNames (caps : List Nat) : Nat → Nat → List String
  | _, .zero => .nil
  | k, .succ m => .cons (match indexOfNat k caps 0 with
      | .some j => "env[" +++ Nat.toString j +++ "]"
      | .none => "BOX(0)") (envNames caps (k + 1) m)
def capsCode (names : List String) : List Nat → List String
  | .nil => .nil
  | .cons i rest => .cons (nthName' names i) (capsCode names rest)
-- inside a lifted chain of `k` `λ`s with `nc` captured variables: the parameters
-- (innermost first) are `a[nc+k-1]`, …, `a[nc]`; the captured ones `a[0]`, …
def paramNamesA (nc : Nat) : Nat → Nat → List String
  | _, .zero => .nil
  | k, .succ j => .cons ("a[" +++ Nat.toString (nc + j) +++ "]") (paramNamesA nc k j)
def capNamesA (caps : List Nat) : Nat → Nat → List String
  | _, .zero => .nil
  | i, .succ m => .cons (match indexOfNat i caps 0 with
      | .some j => "a[" +++ Nat.toString j +++ "]"
      | .none => "BOX(0)") (capNamesA caps (i + 1) m)
def dropBoundK : Nat → List Nat → List Nat
  | _, .nil => .nil
  | k, .cons i rest => match Nat.lt i k with
    | .true => dropBoundK k rest
    | .false => .cons (i - k) (dropBoundK k rest)
def maxVar : List Nat → Nat
  | .nil => 0
  | .cons i rest => Nat.max (i + 1) (maxVar rest)

def etmsLen : ETms → Nat
  | .nil => 0
  | .cons _ rest => etmsLen rest + 1

-- a chain of pairs `(e₀, (e₁, … t))` as its elements, at most `k` of them, then its tail
-- (`[t]` when `t` is not a pair): the runtime keeps a chain as one object
def chainE : Nat → ETm → ETms
  | .zero, t => etms1 t
  | .succ k, t => match t with
    | .obj tg fs => match tg with
      | .zero => match fs with
        | .cons a r => match r with
          | .cons b r2 => match r2 with
            | .nil => .cons a (chainE k b)
            | .cons _ _ => etms1 t
          | .nil => etms1 t
        | .nil => etms1 t
      | .succ _ => etms1 t
    | _ => etms1 t

-- **Constants.** A numeral the frontend built from `Nat.zero`, `Nat.succ` and `Nat.mul`
-- (binary numerals), and a string literal (`String.mk` of a list of `Char.mk` codes),
-- are recognised: a string becomes its code points in the C code, built once (strings
-- are immutable). Spelled out, each character was a chain of applications (800 bytes of
-- C), and the text was built again at every evaluation.
-- (A number of this runtime is a 63-bit word, and its arithmetic wraps. The constant is
-- computed the same way, whatever numbers the compiler itself runs on: built by the Lean
-- compiler its numbers are unbounded, and `BOX(18446744073709551616UL)` is not C.)
def natWord (n : Nat) : Nat := Nat.land n 9223372036854775807
partial def natConst (t : ETm) : Option Nat := match t with
  | .nat n => .some (natWord n)
  | .glob g => match strEq g "Nat.zero" with
    | .true => .some 0
    | .false => .none
  | .app f a => match f with
    | .glob g => match strEq g "Nat.succ" with
      | .true => match natConst a with
        | .some n => .some (natWord (n + 1))
        | .none => .none
      | .false => .none
    | .app h x => match h with
      | .glob g => match Bool.or (strEq g "Nat.mul") (strEq g "Nat.add") with
        | .true => match natConst x with
          | .some m => match natConst a with
            | .some n => .some (natWord (match strEq g "Nat.mul" with
              | .true => m * n
              | .false => m + n))
            | .none => .none
          | .none => .none
        | .false => .none
      | _ => .none
    | _ => .none
  | _ => .none
-- the codes of a constant `List Char`
partial def charsConst (t : ETm) : Option (List Nat) := match t with
  | .app f a => match f with
    | .glob g => match strEq g "List.nil" with
      | .true => .some .nil
      | .false => .none
    | .app h c => match h with
      | .app k _ => match k with
        | .glob g => match strEq g "List.cons" with
          | .true => match c with
            | .app m code => match m with
              | .glob ch => match strEq ch "Char.mk" with
                | .true => match natConst code with
                  | .some n => match charsConst a with
                    | .some rest => .some (.cons n rest)
                    | .none => .none
                  | .none => .none
                | .false => .none
              | _ => .none
            | _ => .none
          | .false => .none
        | _ => .none
      | _ => .none
    | _ => .none
  | _ => .none
def stringConst (t : ETm) : Option (List Nat) := match t with
  | .app f a => match f with
    | .glob g => match strEq g "String.mk" with
      | .true => charsConst a
      | .false => .none
    | _ => .none
  | _ => .none
-- **Self tail calls** (stage 15f). A function's call of itself in tail position (the
-- body, under `let`s and in `case` branches), with all its arguments, is a jump: the
-- arguments are computed, the parameters `p0 …` reassigned (through temporaries, since
-- an argument may be a parameter) and control goes back to the label `top_` at the
-- function's start. Recursion that only calls itself in tail position runs in constant
-- stack, whatever the C compiler does. Under reference counting, an argument in a
-- borrowed position must be a borrowed parameter (else it would need releasing after
-- the call); otherwise the call stays a call.
def etmsList : ETms → List ETm
  | .nil => .nil
  | .cons t rest => .cons t (etmsList rest)
def etmsOfList : List ETm → ETms
  | .nil => .nil
  | .cons t rest => .cons t (etmsOfList rest)
def selfTemps : Nat → List Doc → Doc
  | _, .nil => .t ""
  | i, .cons a rest => .t ("V tc_" +++ Nat.toString i +++ " = ") ⧺ a ⧺ .t "; " ⧺ selfTemps (i + 1) rest
def selfSets : Nat → Nat → String
  | _, .zero => ""
  | i, .succ m => "p" +++ Nat.toString i +++ " = tc_" +++ Nat.toString i +++ "; " +++ selfSets (i + 1) m
def selfJumpDoc (atoms : List Doc) : Doc := selfTemps 0 atoms ⧺ .t (selfSets 0 (lenL atoms) +++ "goto top_; ")
def codesC : List Nat → Doc
  | .nil => .t ""
  | .cons n rest => match rest with
    | .nil => Doc.nat n
    | .cons _ _ => Doc.nat n ⧺ .t "," ⧺ codesC rest
-- **Shared projection prefixes** (stage 15j). Field `k` of a structure (a right-nested
-- chain of pairs) is read as `k` projections `.2` and a `.1`, so reading every field of
-- a wide structure took n²/2 `fld`s. As the Lean compiler's simplifier shares the
-- projections already bound, a region's head (a function's body, a `case` branch, a
-- `λ`'s body) binds each prefix `x.2.2…` of a variable bound outside it that the region
-- uses twice, once on its straight-line path (so it is evaluated there anyway), as C
-- locals: `qx_1 = fld(x, 1)`, `qx_2 = fld(qx_1, 1)`, … A `let` does the same for its
-- own variable, with the plan of its region's head. Uses then read from the longest
-- prefix bound. Only `.2`s are shared: `fld(·, 1)` is total and never forces a
-- hypothesis. Under reference counting the locals are borrowed from `x` (no `inc`):
-- every use of one is still a use of `x`, so `x` lives as long, and nothing else
-- changes.
-- the uses of each variable (by level): the two longest prefixes and the longest on
-- the straight-line path
inductive PS where
  | nil
  | cons (x a1 a2 s1 : Nat) (rest : PS)
-- the prefixes a head binds for variables bound outside it: `x`'s from `k0 + 1` to `k`
inductive EM where
  | nil
  | cons (x k0 k : Nat) (rest : EM)
inductive Plan where
  | mk (pe : PE) (em : EM)
-- a path's innermost run of `.2`s on a variable (its index, its length)
inductive PRun where
  | no
  | at (j r : Nat)
def pMin (a b : Nat) : Nat := match Nat.lt a b with
  | .true => a
  | .false => b
def psAdd (x r : Nat) (s : Bool) : PS → PS
  | .nil => .cons x r 0 (match s with
    | .true => r
    | .false => 0) .nil
  | .cons y a1 a2 s1 rest => match Nat.beq x y with
    | .true => .cons y (Nat.max a1 r) (match Nat.lt a1 r with
        | .true => a1
        | .false => Nat.max a2 r) (match s with
        | .true => Nat.max s1 r
        | .false => s1) rest
    | .false => .cons y a1 a2 s1 (psAdd x r s rest)
def run1 : ETm → PRun
  | .var j => .at j 0
  | .proj i t => match i with
    | .zero => .no
    | .succ z => match z with
      | .zero => match run1 t with
        | .at j r => .at j (r + 1)
        | .no => .no
      | .succ _ => .no
  | _ => .no
def innerRun : ETm → PRun
  | .proj i u => match run1 (.proj i u) with
    | .at j r => .at j r
    | .no => innerRun u
  | t => run1 t
def pBase : ETm → ETm
  | .proj _ t => pBase t
  | t => t
def peFind (x : Nat) : PE → Nat
  | .nil => 0
  | .cons y k rest => match Nat.beq x y with
    | .true => k
    | .false => peFind x rest
def peSet (x k : Nat) : PE → PE
  | .nil => .cons x k .nil
  | .cons y k2 rest => match Nat.beq x y with
    | .true => .cons y k rest
    | .false => .cons y k2 (peSet x k rest)
-- (the entries of levels from `d0`: variables of another region)
def peBelow (d0 : Nat) : PE → PE
  | .nil => .nil
  | .cons y k rest => match Nat.lt y d0 with
    | .true => .cons y k (peBelow d0 rest)
    | .false => peBelow d0 rest
-- the uses in `t` at depth `d`: on the straight-line path (`s`), or in a branch, where
-- only the variables bound outside the branches (levels below `lim`) count; not under
-- a `λ` (another function)
mutual
def cseScan (s : Bool) (lim d : Nat) (t : ETm) (acc : PS) : PS := match t with
  | .proj i u => match innerRun (.proj i u) with
    | .at j r => match Bool.and (Nat.lt 0 r) (Nat.lt j d) with
      | .true => match Bool.or s (Nat.lt (d - 1 - j) lim) with
        | .true => psAdd (d - 1 - j) r s acc
        | .false => acc
      | .false => acc
    | .no => cseScan s lim d (pBase u) acc
  | .letE v b => cseScan s lim (d + 1) b (cseScan s lim d v acc)
  | .app f a => cseScan s lim d a (cseScan s lim d f acc)
  | .obj _ fs => cseScanEs s lim d fs acc
  | .prim _ as => cseScanEs s lim d as acc
  | .case sc bs => cseScanEs .false (match s with
      | .true => d
      | .false => lim) d bs (cseScan s lim d sc acc)
  | _ => acc
def cseScanEs (s : Bool) (lim d : Nat) (ts : ETms) (acc : PS) : PS := match ts with
  | .nil => acc
  | .cons t rest => cseScanEs s lim d rest (cseScan s lim d t acc)
end
def planPS (d0 : Nat) : PE → EM → PS → Plan
  | pe, em, .nil => .mk pe em
  | pe, em, .cons x _ a2 s1 rest =>
    let k := pMin a2 s1;
    match Nat.lt 0 k with
    | .false => planPS d0 pe em rest
    | .true => match Nat.lt x d0 with
      | .false => planPS d0 (peSet x k pe) em rest
      | .true =>
        let k0 := peFind x pe;
        match Nat.lt k0 k with
        | .true => planPS d0 (peSet x k pe) (.cons x k0 k em) rest
        | .false => planPS d0 pe em rest
-- the plan of a head at depth `d0` with body `t`, the prefixes bound outside being `pe`
def csePlan (pe : PE) (d0 : Nat) (t : ETm) : Plan :=
  planPS d0 (peBelow d0 pe) .nil (cseScan .true 0 d0 t .nil)
def aliasName (root : String) (l : Nat) : String := "q" +++ mangle root +++ "_" +++ Nat.toString l
-- the locals for `root.2^(l+1)` … `root.2^(l+n)`
def chainDecls (root : String) : Nat → Nat → Doc
  | _, .zero => .t ""
  | l, .succ n => .t ("V " +++ aliasName root (l + 1) +++ " = fld(" +++ (match l with
      | .zero => root
      | .succ _ => aliasName root l) +++ ", 1); ") ⧺ chainDecls root (l + 1) n
-- a head's locals
def emDeclsG (names : List String) (d : Nat) : EM → Doc
  | .nil => .t ""
  | .cons x k0 k rest => emDeclsG names d rest ⧺ chainDecls (nthName' names (d - 1 - x)) k0 (k - k0)
def fldsC (base : Doc) : Nat → Doc
  | .zero => base
  | .succ n => .t "fld(" ⧺ fldsC base n ⧺ .t ", 1)"
-- the C text of a path of projections from variable index `j` (`d`: the depth), from
-- the longest prefix bound
def projRun (pe : PE) (names : List String) (d j r : Nat) : Doc :=
  let nm := nthName' names j;
  let k := pMin r (peFind (d - 1 - j) pe);
  match k with
  | .zero => fldsC (.t nm) r
  | .succ _ => fldsC (.t (aliasName nm k)) (r - k)
def projText (pe : PE) (names : List String) (d : Nat) : ETm → Doc
  | .proj i u => match run1 (.proj i u) with
    | .at j r => projRun pe names d j r
    | .no => .t "fld(" ⧺ projText pe names d u ⧺ .t ", " ⧺ Doc.nat i ⧺ .t ")"
  | t => match run1 t with
    | .at j r => projRun pe names d j r
    | .no => .t "unreach()"
-- a projection path from a variable (C text), when prefixes are bound
def projHere (pe : PE) (names : List String) (t : ETm) : Option Doc := match pe with
  | .nil => .none
  | .cons _ _ _ => match pBase t with
    | .var j =>
      let d := lenL names;
      match Nat.lt j d with
      | .true => .some (projText pe names d t)
      | .false => .none
    | _ => .none
-- a `let`'s locals for its variable (the plan of its region's head)
def letAliases (pe : PE) (names : List String) (x : String) : Doc := match pe with
  | .nil => .t ""
  | .cons _ _ _ => chainDecls x 0 (peFind (lenL names) pe)
mutual
-- **Exercise 21.2.** The C expression of a term (`names`: the variables in scope).
def cgE (st : CG) (names : List String) : ETm → CR
  --<sol
  | .erased => .mk (.t "BOX(0)") st
  | .var i => .mk (.t (nthName' names i)) st
  | .glob n => .mk (.t ("get_" +++ mangle n +++ "()")) st
  | .nat n => .mk (.t "BOX(" ⧺ Doc.nat n ⧺ .t "UL)") st
  | .app f a => match stringConst (.app f a) with
    -- a string literal: `({ static V s; s ? s : (s = wstr_codes(…)); })`
    | .some cs => match CG.fresh st "str" with
      | .mk x st1 => .mk (.t ("({ static V " +++ x +++ " = 0; if (!" +++ x +++ ") " +++ x +++ " = wcodes((uint32_t[]){") ⧺ codesC cs ⧺
          .t ((match cs with
            | .nil => "0"
            | .cons _ _ => "") +++ "}, " +++ Nat.toString (lenL cs) +++ "); " +++ x +++ "; })")) st1
    | .none => match natConst (.app f a) with
    | .some n => .mk (.t "BOX(" ⧺ Doc.nat n ⧺ .t "UL)") st
    | .none => match spineE f (.cons a .nil) with
    | .mk h args => match h with
      | .glob g =>
        let k := CG.arity st g;
        match Bool.and (Nat.lt 0 k) (Nat.le k (lenL args)) with
        -- a saturated call: `d_g(…)`, then the rest applied
        | .true => match cgList st names (takeL k args) with
          | .mk acs st1 => cgApps st1 names (.t ("d_" +++ mangle g +++ "(") ⧺ acs ⧺ .t ")") (dropL k args)
        | .false => cgApps st names (.t ("get_" +++ mangle g +++ "()")) args
      | _ => match cgE st names h with
        | .mk hc st1 => cgApps st1 names hc args
  | .proj i t => match projHere (CG.pe st) names (.proj i t) with
    | .some pc => .mk pc st
    | .none => match cgE st names t with
      | .mk tc st1 => .mk (.t "fld(" ⧺ tc ⧺ .t ", " ⧺ Doc.nat i ⧺ .t ")") st1
  | .obj k fs => match fs with
    | .nil => .mk (.t "BOX(" ⧺ Doc.nat k ⧺ .t ")") st
    | .cons _ _ =>
      -- a chain of pairs is one object, its elements and then its tail
      let cs : ETms := chainE 8 (.obj k fs);
      match Nat.lt 1 (etmsLen cs) with
      | .true => match cgEs st names cs with
        | .mk fcs st1 => .mk (.t "mkobj(0, " ⧺ Doc.nat (etmsLen cs) ⧺ .t ", (V[]){" ⧺ fcs ⧺ .t "})") st1
      | .false => match cgEs st names fs with
        | .mk fcs st1 => .mk (.t "mkobj(" ⧺ Doc.nat k ⧺ .t ", " ⧺ Doc.nat (etmsLen fs) ⧺ .t ", (V[]){" ⧺ fcs ⧺ .t "})") st1
  | .letE v b => match cgE st names v with
    | .mk vc st1 => match CG.fresh st1 "l" with
      | .mk x st2 => match cgE st2 (.cons x names) b with
        | .mk bc st3 => .mk (.t ("({ V " +++ x +++ " = ") ⧺ vc ⧺ .t "; " ⧺ letAliases (CG.pe st) names x ⧺ bc ⧺ .t "; })") st3
  | .case s bs => match cgE st names s with
    | .mk sc st1 => match CG.fresh st1 "s" with
      | .mk x st2 => match cgBranches st2 names 0 bs with
        | .mk bcs st3 => .mk (.t ("({ V " +++ x +++ " = ") ⧺ sc ⧺ .t ("; V r_; switch (tagof(" +++ x +++ ")) { ") ⧺ bcs ⧺
            .t "default: r_ = unreach(); } r_; })") st3
  | .prim op as => match strEq op "wiz.self" with
    -- a self tail call (`markSelf`): out of the statement expressions, to the start
    | .true => match as with
      | .cons _ rest => match cgTemps st names 0 (etmsList rest) with
        | .mk tcs st1 => .mk (.t "({ " ⧺ tcs ⧺ .t (selfSets 0 (lenL (etmsList rest)) +++ "goto top_; BOX(0); })")) st1
      | .nil => .mk (.t "unreach()") st
    | .false => match cgEs st names as with
      | .mk acs st1 => .mk (.t ("p_" +++ mangle op +++ "(") ⧺ acs ⧺ .t ")") st1
  | .lam b0 =>
    -- a chain of `k` `λ`s, lifted to one `static V lamN(V *a)` over the captured
    -- variables and the `k` arguments: a function closure (`mkfun`) that collects them
    let k := lamsOf (.lam b0);
    let body := underLams k (.lam b0);
    let caps := dropBoundK k (freeE body .nil);
    let nc := lenL caps;
    match CG.fresh st "lam" with
    | .mk fname st1 =>
      let inner := List.append (paramNamesA nc k k) (capNamesA caps 0 (maxVar caps));
      match cgHead st1 inner .nil body with
      | .mk bc st2 =>
        let st3 := CG.emit st2 (.t ("static V " +++ fname +++ "(V *a) { return ") ⧺ bc ⧺ .t "; }");
        match caps with
        | .nil => .mk (.t ("mkfun(" +++ fname +++ ", " +++ Nat.toString k +++ ", 0, NULL)")) st3
        | .cons _ _ => .mk (.t ("mkfun(" +++ fname +++ ", " +++ Nat.toString (nc + k) +++ ", " +++ Nat.toString nc +++
            ", (V[]){" +++ joinC (capsCode names caps) +++ "})")) st3
  --|ex
  --| | _ => .mk (.t "unreach()") st
  --sol>
def cgEs (st : CG) (names : List String) : ETms → CR
  | .nil => .mk (.t "") st
  | .cons t rest => match cgE st names t with
    | .mk tc st1 => match rest with
      | .nil => .mk tc st1
      | .cons _ _ => match cgEs st1 names rest with
        | .mk rc st2 => .mk (tc ⧺ .t ", " ⧺ rc) st2
def cgList (st : CG) (names : List String) : List ETm → CR
  | .nil => .mk (.t "") st
  | .cons t rest => match cgE st names t with
    | .mk tc st1 => match rest with
      | .nil => .mk tc st1
      | .cons _ _ => match cgList st1 names rest with
        | .mk rc st2 => .mk (tc ⧺ .t ", " ⧺ rc) st2
def cgApps (st : CG) (names : List String) (f : Doc) : List ETm → CR
  | .nil => .mk f st
  | .cons a rest => match rest with
    | .nil => match cgE st names a with
      | .mk ac st1 => .mk (.t "ap(" ⧺ f ⧺ .t ", " ⧺ ac ⧺ .t ")") st1
    -- several arguments at once
    | .cons _ _ => match cgList st names (.cons a rest) with
      | .mk acs st1 => .mk (.t "apn(" ⧺ f ⧺ .t (", " +++ Nat.toString (lenL (.cons a rest)) +++ ", (V[]){") ⧺ acs ⧺ .t "})") st1
def cgTemps (st : CG) (names : List String) (i : Nat) : List ETm → CR
  | .nil => .mk (.t "") st
  | .cons t rest => match cgE st names t with
    | .mk tc st1 => match cgTemps st1 names (i + 1) rest with
      | .mk rc st2 => .mk (.t ("V tc_" +++ Nat.toString i +++ " = ") ⧺ tc ⧺ .t "; " ⧺ rc) st2
def cgBranches (st : CG) (names : List String) (k : Nat) : ETms → CR
  | .nil => .mk (.t "") st
  | .cons b rest => match cgHead st names (CG.pe st) b with
    | .mk bc st1 => match cgBranches st1 names (k + 1) rest with
      | .mk rc st2 => .mk (.t "case " ⧺ Doc.nat k ⧺ .t ": r_ = " ⧺ bc ⧺ .t "; break; " ⧺ rc) st2
-- (15j) a region's head (`pe0`: the prefixes bound outside it): its prefixes bound, then
-- its code
def cgHead (st : CG) (names : List String) (pe0 : PE) (t : ETm) : CR := match csePlan pe0 (lenL names) t with
  | .mk pe em => match cgE (CG.setPe st pe) names t with
    | .mk c st1 => .mk (match em with
        | .nil => c
        | .cons _ _ _ _ => .t "({ " ⧺ emDeclsG names (lenL names) em ⧺ c ⧺ .t "; })") (CG.setPe st1 (CG.pe st))
end


-- **Lazy `let`s.** The match compiler binds with `let`s things only some branches use:
-- a shared catch-all (`dflt✝`), the hypotheses of `ind` (each the result of a recursive
-- call). Evaluated eagerly they cost every call a full walk of its argument, or worse.
-- A cheap value (a variable, a global, projections of a variable) is substituted at its
-- uses; any other is suspended (`memo`) and forced where it is used.
mutual
def liftE (k c : Nat) : ETm → ETm
  | .var i => match Nat.lt i c with
    | .true => .var i
    | .false => .var (i + k)
  | .lam b => .lam (liftE k (c + 1) b)
  | .app f a => .app (liftE k c f) (liftE k c a)
  | .letE v b => .letE (liftE k c v) (liftE k (c + 1) b)
  | .obj t fs => .obj t (liftEs k c fs)
  | .proj i t => .proj i (liftE k c t)
  | .case s bs => .case (liftE k c s) (liftEs k c bs)
  | .prim op as => .prim op (liftEs k c as)
  | t => t
def liftEs (k c : Nat) : ETms → ETms
  | .nil => .nil
  | .cons t rest => .cons (liftE k c t) (liftEs k c rest)
end
mutual
-- the body of `let` with variable `c` (at this depth) replaced by `v` (a term at the
-- `let`'s depth), and the variables above it moved down
def substE (v : ETm) (c : Nat) : ETm → ETm
  | .var i => match Nat.lt i c with
    | .true => .var i
    | .false => match Nat.beq i c with
      | .true => liftE c 0 v
      | .false => .var (i - 1)
  | .lam b => .lam (substE v (c + 1) b)
  | .app f a => .app (substE v c f) (substE v c a)
  | .letE x b => .letE (substE v c x) (substE v (c + 1) b)
  | .obj t fs => .obj t (substEs v c fs)
  | .proj i t => .proj i (substE v c t)
  | .case s bs => .case (substE v c s) (substEs v c bs)
  | .prim op as => .prim op (substEs v c as)
  | t => t
def substEs (v : ETm) (c : Nat) : ETms → ETms
  | .nil => .nil
  | .cons t rest => .cons (substE v c t) (substEs v c rest)
end
def cheapE : ETm → Bool
  | .var _ => .true
  | .glob _ => .true
  | .erased => .true
  | .nat _ => .true
  | .proj _ t => cheapE t
  | .obj _ fs => match fs with
    | .nil => .true
    | .cons _ _ => .false
  | _ => .false
-- `f a` with `f` a lambda is a let (strict, as the application was), or `a` put in
-- place when cheap: a `match` is a method applied to the payload (`m ◾ i payload`), and
-- the closure built and called for every match was most of the allocation
def betaE : ETm → ETm → ETm
  | .lam b, a => match cheapE a with
    | .true => substE a 0 b
    | .false => .letE a b
  | .letE v b, a => .letE v (betaE b (liftE 1 0 a))
  | f, a => .app f a
-- **Strict `let`s** (reference counting mode): a `let` whose variable every path of its
-- body evaluates (not under a `λ`) is evaluated where it stands: suspending it costs a
-- thunk and gains nothing. (`unreachable` counts as using everything.)
mutual
def neededE (c : Nat) : ETm → Bool
  | .var i => Nat.beq i c
  | .app f a => match neededE c f with
    | .true => .true
    | .false => neededE c a
  | .letE v b => match neededE c v with
    | .true => .true
    | .false => neededE (c + 1) b
  | .obj _ fs => neededAny c fs
  | .proj _ t => neededE c t
  | .case s bs => match neededE c s with
    | .true => .true
    | .false => neededAll c bs
  | .prim op as => match strEq op "unreachable" with
    | .true => .true
    | .false => neededAny c as
  | _ => .false
def neededAny (c : Nat) : ETms → Bool
  | .nil => .false
  | .cons t rest => match neededE c t with
    | .true => .true
    | .false => neededAny c rest
def neededAll (c : Nat) : ETms → Bool
  | .nil => .true
  | .cons t rest => match neededE c t with
    | .true => neededAll c rest
    | .false => .false
end
-- (`sl`: strict `let`s, in the reference counting mode)
def strictLet (sl : Bool) (b : ETm) : Bool := match sl with
  | .true => neededE 0 b
  | .false => .false
mutual
def lazyLets (sl : Bool) : ETm → ETm
  | .letE v b =>
    let v' := lazyLets sl v;
    let b' := lazyLets sl b;
    match cheapE v' with
    | .true => substE v' 0 b'
    | .false => match strictLet sl b' with
      | .true => .letE v' b'
      -- `let x := memo (λ _. v); b[x ◾ / x]`
      | .false => .letE (.prim "memo" (etms1 (.lam (liftE 1 0 v')))) (substE (.app (.var 0) .erased) 0 (liftE 1 1 b'))
  | .lam b => .lam (lazyLets sl b)
  | .app f a => betaE (lazyLets sl f) (lazyLets sl a)
  | .obj t fs => .obj t (lazyLetsEs sl fs)
  | .proj i t => .proj i (lazyLets sl t)
  | .case s bs => .case (lazyLets sl s) (lazyLetsEs sl bs)
  | .prim op as => .prim op (lazyLetsEs sl as)
  | t => t
def lazyLetsEs (sl : Bool) : ETms → ETms
  | .nil => .nil
  | .cons t rest => .cons (lazyLets sl t) (lazyLetsEs sl rest)
end
-- (reference counting mode) the same, but a source `let` that isn't put in place is only
-- marked, `let (lazy v); b`: whether it is strict, suspended or dropped is decided after
-- pushing and inlining (`decideLets`), with the whole program in view
mutual
def markLets : ETm → ETm
  | .letE v b =>
    let v' := markLets v;
    let b' := markLets b;
    match cheapE v' with
    | .true => substE v' 0 b'
    | .false => .letE (.prim "lazy" (etms1 v')) b'
  | .lam b => .lam (markLets b)
  | .app f a => betaE (markLets f) (markLets a)
  | .obj t fs => .obj t (markLetsEs fs)
  | .proj i t => .proj i (markLets t)
  | .case s bs => .case (markLets s) (markLetsEs bs)
  | .prim op as => .prim op (markLetsEs as)
  | t => t
def markLetsEs : ETms → ETms
  | .nil => .nil
  | .cons t rest => .cons (markLets t) (markLetsEs rest)
end
-- a marked `let`'s value
def lazyVal : ETm → Option ETm
  | .prim op as => match strEq op "lazy" with
    | .true => match as with
      | .cons v rest => match rest with
        | .nil => .some v
        | .cons _ _ => .none
      | .nil => .none
    | .false => .none
  | _ => .none
-- **Demand analysis** (reference counting mode). The demand of a term on a variable is
-- how it is used (`u`: 0 bottom, the path ends in `unreachable`; 1 strict, evaluated on
-- every path; 2 lazy, maybe evaluated; 3 absent) and at most how many times (`n`: 0, 1,
-- or 2 for many). Application is call by value, so what is lazy is a suspended `let`'s
-- value and what is under a `λ`.
inductive Dmd where
  | mk (u n : Nat)
def Dmd.u : Dmd → Nat
  | .mk u _ => u
def Dmd.n : Dmd → Nat
  | .mk _ n => n
def dAbs : Dmd := .mk 3 0
def dBot : Dmd := .mk 0 0
def nAdd (a b : Nat) : Nat := match Nat.lt 1 (a + b) with
  | .true => 2
  | .false => a + b
def nMax (a b : Nat) : Nat := match Nat.lt a b with
  | .true => b
  | .false => a
-- both evaluated
def dSeq (a b : Dmd) : Dmd := .mk (match Nat.beq (Dmd.u a) 0 with
  | .true => 0
  | .false => match Nat.beq (Dmd.u b) 0 with
    | .true => 0
    | .false => match Bool.or (Nat.beq (Dmd.u a) 1) (Nat.beq (Dmd.u b) 1) with
      | .true => 1
      | .false => match Bool.or (Nat.beq (Dmd.u a) 2) (Nat.beq (Dmd.u b) 2) with
        | .true => 2
        | .false => 3) (nAdd (Dmd.n a) (Dmd.n b))
-- one or the other (branches of a `case`)
def dJoin (a b : Dmd) : Dmd := .mk (match Nat.beq (Dmd.u a) 0 with
  | .true => Dmd.u b
  | .false => match Nat.beq (Dmd.u b) 0 with
    | .true => Dmd.u a
    | .false => match Nat.beq (Dmd.u a) (Dmd.u b) with
      | .true => Dmd.u a
      | .false => 2) (nMax (Dmd.n a) (Dmd.n b))
-- (`mode` 0: under a `λ`, maybe and any number of times; 1: maybe)
def dWeak (mode : Nat) (a : Dmd) : Dmd := match Nat.beq (Dmd.u a) 3 with
  | .true => dAbs
  | .false => match Nat.beq mode 0 with
    | .true => .mk 2 2
    | .false => .mk 2 (Dmd.n a)
-- the demands of a term on the variables, by level, descending; a missing variable is
-- absent, or bottom when `bot` (every path ends in `unreachable`)
inductive DE where
  | mk (lv : Nat) (d : Dmd)
inductive DEnv where
  | mk (bot : Bool) (es : List DE)
def DEnv.bot : DEnv → Bool
  | .mk b _ => b
def DEnv.es : DEnv → List DE
  | .mk _ es => es
def deNone : DEnv := .mk .false .nil
def deMiss (bot : Bool) : Dmd := match bot with
  | .true => dBot
  | .false => dAbs
def deLook (x : Nat) : List DE → Option Dmd
  | .nil => .none
  | .cons (.mk y d) rest => match Nat.beq x y with
    | .true => .some d
    | .false => match Nat.lt x y with
      | .true => deLook x rest
      | .false => .none
def denvAt (x : Nat) (e : DEnv) : Dmd := match deLook x (DEnv.es e) with
  | .some d => d
  | .none => deMiss (DEnv.bot e)
def deOp (sq : Bool) (a b : Dmd) : Dmd := match sq with
  | .true => dSeq a b
  | .false => dJoin a b
-- both sides' entries combined (`sq`: both evaluated, else one or the other), a side's
-- missing entries being `ma` and `mb`
partial def deMerge (sq : Bool) (ma mb : Dmd) (xs ys : List DE) : List DE := match xs with
  | .nil => match ys with
    | .nil => .nil
    | .cons (.mk y d) rest => .cons (.mk y (deOp sq ma d)) (deMerge sq ma mb .nil rest)
  | .cons (.mk x dx) xr => match ys with
    | .nil => .cons (.mk x (deOp sq dx mb)) (deMerge sq ma mb xr .nil)
    | .cons (.mk y dy) yr => match Nat.beq x y with
      | .true => .cons (.mk x (deOp sq dx dy)) (deMerge sq ma mb xr yr)
      | .false => match Nat.lt y x with
        | .true => .cons (.mk x (deOp sq dx mb)) (deMerge sq ma mb xr ys)
        | .false => .cons (.mk y (deOp sq ma dy)) (deMerge sq ma mb xs yr)
def denvSeq (a b : DEnv) : DEnv :=
  .mk (Bool.or (DEnv.bot a) (DEnv.bot b)) (deMerge .true (deMiss (DEnv.bot a)) (deMiss (DEnv.bot b)) (DEnv.es a) (DEnv.es b))
def denvJoin (a b : DEnv) : DEnv :=
  .mk (Bool.and (DEnv.bot a) (DEnv.bot b)) (deMerge .false (deMiss (DEnv.bot a)) (deMiss (DEnv.bot b)) (DEnv.es a) (DEnv.es b))
def deWeak (mode : Nat) : List DE → List DE
  | .nil => .nil
  | .cons (.mk y d) rest => .cons (.mk y (dWeak mode d)) (deWeak mode rest)
-- the entries of the variables of levels `< d`
def deBelow (d : Nat) : List DE → List DE
  | .nil => .nil
  | .cons (.mk y dy) rest => match Nat.lt y d with
    | .true => .cons (.mk y dy) rest
    | .false => deBelow d rest
def denvBelow (d : Nat) (e : DEnv) : DEnv := .mk (DEnv.bot e) (deBelow d (DEnv.es e))
-- what a `let`'s value demands, its variable demanded by `x`
def denvScale (x : Dmd) (e : DEnv) : DEnv := match Nat.beq (Dmd.u x) 3 with
  | .true => deNone
  | .false => match Nat.beq (Dmd.u x) 2 with
    | .true => .mk .false (deWeak 1 (DEnv.es e))
    | .false => e
-- a suspended `let`'s value (`memo (λ _. v)`)
def memoVal : ETm → Option ETm
  | .prim op as => match strEq op "memo" with
    | .true => match as with
      | .cons f rest => match rest with
        | .nil => match f with
          | .lam v => .some v
          | _ => .none
        | .cons _ _ => .none
      | .nil => .none
    | .false => .none
  | _ => .none
mutual
-- the demands of `t`, in a scope of `d` variables
def dmdA (d : Nat) (t : ETm) : DEnv := match t with
  | .var i => match Nat.lt i d with
    | .true => .mk .false (.cons (.mk (d - 1 - i) (.mk 1 1)) .nil)
    | .false => deNone
  | .app f a => denvSeq (dmdA d f) (dmdA d a)
  | .letE v b =>
    let eb := dmdA (d + 1) b;
    let rest := denvBelow d eb;
    match memoVal v with
    | .some mv => denvSeq (denvScale (denvAt d eb) (denvBelow d (dmdA (d + 1) mv))) rest
    | .none => match lazyVal v with
      | .some lv => denvSeq (denvScale (denvAt d eb) (dmdA d lv)) rest
      | .none => denvSeq (dmdA d v) rest
  | .obj _ fs => dmdSeq d fs
  | .proj _ x => dmdA d x
  | .case s bs => denvSeq (dmdA d s) (dmdJoin d bs)
  | .prim op as => match strEq op "unreachable" with
    | .true => .mk .true .nil
    | .false => dmdSeq d as
  | .lam b => .mk .false (deWeak 0 (deBelow d (DEnv.es (dmdA (d + 1) b))))
  | _ => deNone
def dmdSeq (d : Nat) (ts : ETms) : DEnv := match ts with
  | .nil => deNone
  | .cons t rest => denvSeq (dmdA d t) (dmdSeq d rest)
def dmdJoin (d : Nat) (ts : ETms) : DEnv := match ts with
  | .nil => .mk .true .nil
  | .cons t rest => denvJoin (dmdA d t) (dmdJoin d rest)
end
-- the demand of `t` (in a scope of `d + 1`) on the variable of level `d`
def dmdOn (d : Nat) (t : ETm) : Dmd := denvAt d (dmdA (d + 1) t)
-- the branch of `bs` that alone uses the variable of level `d` (by position), if one does
partial def soleUser (d : Nat) (bs : ETms) (i : Nat) (found : Option Nat) : Option Nat := match bs with
  | .nil => found
  | .cons b rest => match Nat.beq (Dmd.u (dmdOn d b)) 3 with
    | .true => soleUser d rest (i + 1) found
    | .false => match found with
      | .some _ => .none
      | .none => soleUser d rest (i + 1) (.some i)
-- `let x := memo (λ _. v); b[x ◾ / x]`
def suspendLet (v b : ETm) : ETm :=
  .letE (.prim "memo" (etms1 (.lam (liftE 1 0 v)))) (substE (.app (.var 0) .erased) 0 (liftE 1 1 b))
mutual
-- a source `let` of `v` over `b` (both decided), in a scope of `d`: strict when its
-- variable is demanded on every path (or the path ends in `unreachable`), dropped when
-- absent; used on some paths only, moved into the one branch of a `case` that uses it
-- (not its scrutinee) and decided again there; else suspended
def placeLet (d : Nat) (v b : ETm) : ETm :=
  let dx := dmdOn d b;
  match Nat.lt (Dmd.u dx) 2 with
  | .true => .letE v b
  | .false => match Nat.beq (Dmd.u dx) 3 with
    | .true => substE .erased 0 b
    | .false => match b with
      | .case s bs => match Nat.beq (Dmd.u (dmdOn d s)) 3 with
        | .true => match soleUser d bs 0 .none with
          | .some i => .case (substE .erased 0 s) (placeIn d v i 0 bs)
          | .none => suspendLet v b
        | .false => suspendLet v b
      | _ => suspendLet v b
def placeIn (d : Nat) (v : ETm) (i j : Nat) (bs : ETms) : ETms := match bs with
  | .nil => .nil
  | .cons b rest => match Nat.beq i j with
    | .true => .cons (placeLet d v b) (placeIn d v i (j + 1) rest)
    | .false => .cons (substE .erased 0 b) (placeIn d v i (j + 1) rest)
end
mutual
-- (in a scope of `d` variables)
def decideLets (d : Nat) : ETm → ETm
  | .letE v b =>
    let b' := decideLets (d + 1) b;
    match lazyVal v with
    | .some lv => placeLet d (decideLets d lv) b'
    | .none => .letE (decideLets d v) b'
  | .lam b => .lam (decideLets (d + 1) b)
  | .app f a => .app (decideLets d f) (decideLets d a)
  | .obj t fs => .obj t (decideLetsEs d fs)
  | .proj i t => .proj i (decideLets d t)
  | .case s bs => .case (decideLets d s) (decideLetsEs d bs)
  | .prim op as => .prim op (decideLetsEs d as)
  | t => t
def decideLetsEs (d : Nat) : ETms → ETms
  | .nil => .nil
  | .cons t rest => .cons (decideLets d t) (decideLetsEs d rest)
end

-- **Reference counting** (stage 22, the `rc` mode; see `rt.c`). The C is in A-normal
-- form, statements in evaluation order (left to right), each intermediate value in a
-- local, so that every reference is accounted for (Perceus, as `Compiler/RC.lean`):
-- every variable is owned, and consumed exactly once, by its last use (a later use
-- `inc`s it first) or by a `dec` where it dies (a `let` whose body doesn't use it, a
-- parameter the body doesn't use, a `case` branch that doesn't use it). Functions own
-- their arguments and return an owned result; a projection reads its object (`inc`s
-- the field) and only then releases it, if that was its last use.
--
-- Liveness is computed backwards, in one pass: a term is compiled knowing the
-- variables used after it (`live`, by de Bruijn *level*, descending), and returns
-- those used from its start; the arguments of a call are compiled right to left.
def lvIns (x : Nat) : List Nat → List Nat
  | .nil => .cons x .nil
  | .cons y rest => match Nat.beq x y with
    | .true => .cons y rest
    | .false => match Nat.lt y x with
      | .true => .cons x (.cons y rest)
      | .false => .cons y (lvIns x rest)
def lvMem (x : Nat) : List Nat → Bool
  | .nil => .false
  | .cons y rest => match Nat.beq x y with
    | .true => .true
    | .false => match Nat.lt x y with
      | .true => lvMem x rest
      | .false => .false
-- a head's locals under reference counting: only for variables still used or borrowed
-- (the others may already be released)
def emDeclsRC (live bor : List Nat) (names : List String) (d : Nat) : EM → Doc
  | .nil => .t ""
  | .cons x k0 k rest =>
    let mine := chainDecls (nthName' names (d - 1 - x)) k0 (k - k0);
    match Bool.or (lvMem x live) (lvMem x bor) with
    | .true => emDeclsRC live bor names d rest ⧺ mine
    | .false => emDeclsRC live bor names d rest
def lvDel (x : Nat) : List Nat → List Nat
  | .nil => .nil
  | .cons y rest => match Nat.beq x y with
    | .true => rest
    | .false => .cons y (lvDel x rest)
partial def lvUnion (a b : List Nat) : List Nat := match a with
  | .nil => b
  | .cons x xs => match b with
    | .nil => a
    | .cons y ys => match Nat.beq x y with
      | .true => .cons x (lvUnion xs ys)
      | .false => match Nat.lt y x with
        | .true => .cons x (lvUnion xs b)
        | .false => .cons y (lvUnion a ys)
-- the levels in `a` and not in `b`
partial def lvDiff (a b : List Nat) : List Nat := match a with
  | .nil => .nil
  | .cons x xs => match b with
    | .nil => a
    | .cons y ys => match Nat.beq x y with
      | .true => lvDiff xs ys
      | .false => match Nat.lt y x with
        | .true => .cons x (lvDiff xs b)
        | .false => lvDiff a ys

-- the code of a term: its statements, the C expression of its (owned) value (a local
-- or a constant), the variables used from its start
inductive RR where
  | mk (code atom : Doc) (live : List Nat) (st : CG)
inductive RRs where
  | mk (code : Doc) (atoms : List Doc) (live : List Nat) (st : CG)
inductive RB where
  | mk (code atom : Doc) (live : List Nat) (pend : Wish)
-- the branches of a `case`, and the variables any of them uses
inductive RBs where
  | mk (bs : List RB) (live : List Nat) (st : CG)
inductive RU where
  | mk (code : Doc) (live : List Nat)

def joinDocs : List Doc → Doc
  | .nil => .t ""
  | .cons x rest => match rest with
    | .nil => x
    | .cons _ _ => x ⧺ .t ", " ⧺ joinDocs rest
def rangeL : Nat → Nat → List Nat
  | _, .zero => .nil
  | i, .succ m => .cons i (rangeL (i + 1) m)
def addK (k : Nat) : List Nat → List Nat
  | .nil => .nil
  | .cons i rest => .cons (i + k) (addK k rest)
-- `dec` the variables at these levels
def decsOf (names : List String) (d : Nat) : List Nat → Doc
  | .nil => .t ""
  | .cons x rest => .t ("dec(" +++ nthName' names (d - 1 - x) +++ "); ") ⧺ decsOf names d rest
-- at a function's start: `dec` the parameters (these indices) its body doesn't use
def entryDrops (names : List String) (d : Nat) (live : List Nat) : List Nat → Doc
  | .nil => .t ""
  | .cons j rest => match lvMem (d - 1 - j) live with
    | .true => entryDrops names d live rest
    | .false => .t ("dec(" +++ nthName' names j +++ "); ") ⧺ entryDrops names d live rest
-- the context: the **borrowed** variables (by level: parameters of the function being
-- compiled that it never consumes, so its callers keep them alive and it neither
-- releases them nor counts them as live), and each global function's borrowed
-- parameters (`true`: borrowed, first parameter first); and the variables whose cells
-- may be reused here (the owned variables matched on by the enclosing `case`s)
inductive RE where
  | mk (bor : List Nat) (sigs : StrMap (List Bool)) (cands : List Nat)
def RE.bor : RE → List Nat
  | .mk b _ _ => b
def RE.inner : RE → RE
  | .mk _ s _ => .mk .nil s .nil
def RE.sig (re : RE) (g : String) : List Bool := match re with
  | .mk _ s _ => StrMap.findD s (Str.ofString g) .nil
def RE.cands : RE → List Nat
  | .mk _ _ c => c
def RE.withCand (re : RE) (x : Nat) : RE := match re with
  | .mk b s c => .mk b s (lvIns x c)
-- **Reuse** (Perceus' reuse tokens). In a `case` branch on an owned variable `x`, an
-- allocation is compiled first (backwards) and leaves a wish for a cell of its size
-- (`CG.pend`); the place where `x` then dies (going on backwards: its last projection,
-- a lending call, the branch's start) grants it: `w = reset(x, n)` frees `x`'s fields
-- and keeps its cell if `x` was unique and of the same size class, and the allocation
-- `reuseobj(w, …)` writes there (else allocates). A wish not granted by the start of
-- the branch is `w = 0`. Branches and functions are separate: a token never crosses
-- into another branch.
inductive DropR where
  | mk (code : Doc) (st : CG)
-- `x` (C name `nm`) dies here
def dropC (re : RE) (st : CG) (nm : String) (x : Nat) : DropR := match lvMem x (RE.cands re) with
  | .true => match CG.pend st with
    | .want w n => .mk (.t ("V " +++ w +++ " = reset(" +++ nm +++ ", " +++ Nat.toString n +++ "); ")) (CG.setPend st .idle)
    | .idle => .mk (.t ("dec(" +++ nm +++ "); ")) st
  | .false => .mk (.t ("dec(" +++ nm +++ "); ")) st
def dropsCs (re : RE) (names : List String) (d : Nat) : CG → List Nat → DropR
  | st, .nil => .mk (.t "") st
  | st, .cons x rest => match dropC re st (nthName' names (d - 1 - x)) x with
    | .mk c st1 => match dropsCs re names d st1 rest with
      | .mk cs st2 => .mk (c ⧺ cs) st2
def dropsC (re : RE) (st : CG) (names : List String) (d : Nat) (xs : List Nat) : DropR := dropsCs re names d st xs
-- **Drop specialisation**: `x` dies at its projection `r` (a borrowed field): if `x` is
-- unique, `r` takes over `x`'s reference to it and the rest is released (`dropTake`;
-- `resetTake` also keeps the cell for a wish), else `r` is `inc`ed and `x` released
def takeC (re : RE) (st : CG) (nm r : String) (x : Nat) : DropR :=
  let plain : DropR := .mk (.t ("dropTake(" +++ nm +++ ", " +++ r +++ "); ")) st;
  match lvMem x (RE.cands re) with
  | .true => match CG.pend st with
    | .want w n => .mk (.t ("V " +++ w +++ " = resetTake(" +++ nm +++ ", " +++ Nat.toString n +++ ", " +++ r +++ "); ")) (CG.setPend st .idle)
    | .idle => plain
  | .false => plain
-- a branch's drops (`x` in `cands` may grant its wish `p`); a wish left is `w = 0`
def branchDrops (cands : List Nat) (names : List String) (d : Nat) : Wish → List Nat → Doc
  | p, .nil => match p with
    | .want w _ => .t ("V " +++ w +++ " = 0; ")
    | .idle => .t ""
  | p, .cons x rest =>
    let nm := nthName' names (d - 1 - x);
    match p with
    | .want w n => match lvMem x cands with
      | .true => .t ("V " +++ w +++ " = reset(" +++ nm +++ ", " +++ Nat.toString n +++ "); ") ⧺ branchDrops cands names d .idle rest
      | .false => .t ("dec(" +++ nm +++ "); ") ⧺ branchDrops cands names d p rest
    | .idle => .t ("dec(" +++ nm +++ "); ") ⧺ branchDrops cands names d p rest
-- the captured variables (indices) put in a closure: each `inc`ed if used after (or
-- borrowed)
def capUses (bor : List Nat) (names : List String) (d : Nat) (live : List Nat) : List Nat → RU
  | .nil => .mk (.t "") live
  | .cons c rest => match capUses bor names d live rest with
    | .mk rc rl => match Bool.or (lvMem (d - 1 - c) live) (lvMem (d - 1 - c) bor) with
      | .true => .mk (.t ("inc(" +++ nthName' names c +++ "); ") ⧺ rc) rl
      | .false => .mk rc (lvIns (d - 1 - c) rl)
def headB : List Bool → Bool
  | .nil => .false
  | .cons b _ => b
def tailB : List Bool → List Bool
  | .nil => .nil
  | .cons _ rest => rest
-- the owned variables (levels) passed in borrowed positions: lent to the call
def lentVars (bor : List Nat) (d : Nat) : List Bool → List ETm → List Nat
  | _, .nil => .nil
  | sig, .cons t rest => match headB sig with
    | .true => match t with
      | .var i => match Bool.and (Nat.lt i d) (Bool.not (lvMem (d - 1 - i) bor)) with
        | .true => lvIns (d - 1 - i) (lentVars bor d (tailB sig) rest)
        | .false => lentVars bor d (tailB sig) rest
      | _ => lentVars bor d (tailB sig) rest
    | .false => lentVars bor d (tailB sig) rest
-- the arguments of a direct call: their code, values, what to release after the call
inductive RRp where
  | mk (code : Doc) (atoms : List Doc) (posts : Doc) (live : List Nat) (st : CG)
-- a path of projections: its root, and its C text from a root `o`
def projRoot : ETm → ETm
  | .proj _ t => projRoot t
  | t => t
def projC (o : Doc) : ETm → Doc
  | .proj i t => .t "fld(" ⧺ projC o t ⧺ .t ", " ⧺ Doc.nat i ⧺ .t ")"
  | _ => o
-- the C expression applying `f` to `atoms`
def callC (f : Doc) (atoms : List Doc) : Doc := match atoms with
  | .nil => f
  | .cons a rest => match rest with
    | .nil => .t "ap(" ⧺ f ⧺ .t ", " ⧺ a ⧺ .t ")"
    | .cons _ _ => .t "apn(" ⧺ f ⧺ .t (", " +++ Nat.toString (lenL atoms) +++ ", (V[]){") ⧺ joinDocs atoms ⧺ .t "})"
-- `code`, then the value of `e` in a new local
def bindTo (st : CG) (code e : Doc) (live : List Nat) : RR := match CG.fresh st "t" with
  | .mk x st1 => .mk (code ⧺ .t ("V " +++ x +++ " = ") ⧺ e ⧺ .t "; ") (.t x) live st1
def branchesC (cands : List Nat) (names : List String) (d : Nat) (u : List Nat) (r : String) : Nat → List RB → Doc
  | _, .nil => .t ""
  | k, .cons b rest => match b with
    | .mk bc ba bl bp => .t "case " ⧺ Doc.nat k ⧺ .t ": { " ⧺ branchDrops cands names d bp (lvDiff u bl) ⧺ bc ⧺ .t (r +++ " = ") ⧺ ba ⧺
        .t "; break; } " ⧺ branchesC cands names d u r (k + 1) rest
-- the context of a `case`'s branches: the scrutinee's variable, if owned, may be reused
def caseRE (re : RE) (d : Nat) (s : ETm) : RE := match projRoot s with
  | .var j => match Nat.lt j d with
    | .true => match lvMem (d - 1 - j) (RE.bor re) with
      | .true => re
      | .false => RE.withCand re (d - 1 - j)
    | .false => re
  | _ => re
-- **Static objects**: a value of a constructor without fields is `(k, ◾)`, the same
-- every time: the runtime keeps one for each `k < 64` (`nul(k)`, never freed), as for
-- the Bools its natives return
def scalarOf : ETm → Option Nat
  | .nat n => .some n
  | .erased => .some 0
  | .obj k fs => match fs with
    | .nil => .some k
    | .cons _ _ => .none
  | _ => .none
def staticNul (tag : Nat) (items : ETms) : Option Nat := match tag with
  | .zero => match items with
    | .cons a rest => match rest with
      | .cons b more => match more with
        | .nil => match scalarOf a with
          | .some k => match scalarOf b with
            | .some z => match Bool.and (Nat.beq z 0) (Nat.lt k 64) with
              | .true => .some k
              | .false => .none
            | .none => .none
          | .none => .none
        | .cons _ _ => .none
      | .nil => .none
    | .nil => .none
  | .succ _ => .none
-- an object: in a reuse context with no wish open, it wishes for a cell (`w`)
-- a term built only from constants (numbers, `◾`, closed `λ`s, such objects)
mutual
def closedConstE (t : ETm) : Bool := match t with
  | .nat _ => .true
  | .erased => .true
  | .lam _ => match freeE t .nil with
    | .nil => .true
    | .cons _ _ => .false
  | .obj _ fs => closedConstEs fs
  | _ => .false
def closedConstEs (ts : ETms) : Bool := match ts with
  | .nil => .true
  | .cons t rest => match closedConstE t with
    | .true => closedConstEs rest
    | .false => .false
end
def objC (w : String) (k n : Nat) (atoms : List Doc) : Doc := match strEq w "" with
  | .true => .t "mkobj(" ⧺ Doc.nat k ⧺ .t ", " ⧺ Doc.nat n ⧺ .t ", (V[]){" ⧺ joinDocs atoms ⧺ .t "})"
  | .false => .t ("reuseobj(" +++ w +++ ", ") ⧺ Doc.nat k ⧺ .t ", " ⧺ Doc.nat n ⧺ .t ", (V[]){" ⧺ joinDocs atoms ⧺ .t "})"


-- **Dead code** (stage 15e). A value without effects (no application, no `ind`, no
-- `unreachable`), so when its variable is dead it need not be computed: liveness is
-- known when a `let` is compiled (its body first), and such a `let` is skipped.
mutual
def pureE : ETm → Bool
  | .erased => .true
  | .var _ => .true
  | .glob _ => .true
  | .nat _ => .true
  | .lam _ => .true
  | .obj _ fs => pureEs fs
  | .proj _ t => pureE t
  | .letE v b => Bool.and (pureE v) (pureE b)
  | .case s bs => Bool.and (pureE s) (pureEs bs)
  | .prim op as => Bool.and (Bool.or (strEq op "memo") (Bool.or (strEq op "natSucc")
      (Bool.or (strEq op "natPack") (strEq op "natUnpack")))) (pureEs as)
  | .app f a => match natConst (.app f a) with
    | .some _ => .true
    | .none => match stringConst (.app f a) with
      | .some _ => .true
      | .none => .false
def pureEs : ETms → Bool
  | .nil => .true
  | .cons t rest => Bool.and (pureE t) (pureEs rest)
end

mutual
-- the code of `t` in a scope of `d` variables (`names`), `live` used after it
def rcE (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (t : ETm) : RR := match t with
  | .erased => .mk (.t "") (.t "BOX(0)") live st
  | .nat n => .mk (.t "") (.t "BOX(" ⧺ Doc.nat n ⧺ .t "UL)") live st
  | .var i => match Nat.lt i d with
    | .false => .mk (.t "") (.t "BOX(0)") live st
    | .true =>
      let nm := nthName' names i;
      match Bool.or (lvMem (d - 1 - i) live) (lvMem (d - 1 - i) (RE.bor re)) with
      | .true => .mk (.t ("inc(" +++ nm +++ "); ")) (.t nm) live st
      | .false => .mk (.t "") (.t nm) (lvIns (d - 1 - i) live) st
  | .glob n => bindTo st (.t "") (.t ("get_" +++ mangle n +++ "()")) live
  | .app f a => match stringConst t with
    -- a string literal, built once (a constant: released at exit)
    | .some cs => match CG.fresh st "str" with
      | .mk x st1 => .mk (.t ("static V " +++ x +++ " = 0; if (!" +++ x +++ ") { " +++ x +++ " = wcodes((uint32_t[]){") ⧺ codesC cs ⧺
          .t ((match cs with
            | .nil => "0"
            | .cons _ _ => "") +++ "}, " +++ Nat.toString (lenL cs) +++ "); rt_root(&" +++ x +++ "); } inc(" +++ x +++ "); ")) (.t x) live st1
    | .none => match natConst t with
      | .some n => .mk (.t "") (.t "BOX(" ⧺ Doc.nat n ⧺ .t "UL)") live st
      | .none => match spineE f (.cons a .nil) with
        | .mk h args => match h with
          | .glob g =>
            let k := CG.arity st g;
            match Bool.and (Nat.lt 0 k) (Nat.le k (lenL args)) with
            -- a saturated call `d_g(…)`, then the rest applied
            | .true => rcCall re st names d live g k args
            | .false => rcApply re st names d live h args
          | _ => rcApply re st names d live h args
  | .proj _ _ => match projRoot t with
    | .var j => match Nat.lt j d with
      -- a field of a variable: read, `inc`ed, and the variable released if this was its
      -- last use
      | .true =>
        let nm := nthName' names j;
        let x := d - 1 - j;
        match CG.fresh st "t" with
        | .mk r st1 => match lvMem x (RE.bor re) with
          | .true => .mk (.t ("V " +++ r +++ " = ") ⧺ projText (CG.pe st) names d t ⧺ .t ("; inc(" +++ r +++ "); ")) (.t r) live st1
          | .false => match lvMem x live with
            | .true => .mk (.t ("V " +++ r +++ " = ") ⧺ projText (CG.pe st) names d t ⧺ .t ("; inc(" +++ r +++ "); ")) (.t r) (lvIns x live) st1
            | .false => match takeC re st1 nm r x with
              | .mk tc st2 => .mk (.t ("V " +++ r +++ " = ") ⧺ projText (CG.pe st) names d t ⧺ .t "; " ⧺ tc) (.t r) (lvIns x live) st2
      | .false => .mk (.t "") (.t "BOX(0)") live st
    | root => match rcE re st names d live root with
      | .mk oc oa ol st1 => match CG.fresh st1 "t" with
        | .mk r st2 => .mk (oc ⧺ .t ("V " +++ r +++ " = ") ⧺ projC oa t ⧺ .t ("; inc(" +++ r +++ "); dec(") ⧺ oa ⧺ .t "); ") (.t r) ol st2
  | .obj k fs => match fs with
    | .nil => .mk (.t "") (.t "BOX(" ⧺ Doc.nat k ⧺ .t ")") live st
    | .cons _ _ =>
      -- a chain of pairs is one object, its elements and then its tail
      let cs : ETms := chainE 8 t;
      let isChain := Nat.lt 1 (etmsLen cs);
      let items : ETms := match isChain with
        | .true => cs
        | .false => fs;
      let tag := match isChain with
        | .true => 0
        | .false => k;
      let n := etmsLen items;
      let wish : FR := match RE.cands re with
        | .nil => .mk "" st
        | .cons _ _ => match CG.pend st with
          | .idle => match CG.fresh st "w" with
            | .mk w st0 => .mk w (CG.setPend st0 (.want w n))
          | .want _ _ => .mk "" st;
      match staticNul tag items with
      -- (a constant `(k, ◾)`: the runtime's static object, `nul(k)`)
      | .some kk => .mk (.t "") (.t ("nul(" +++ Nat.toString kk +++ ")")) live st
      | .none => match closedConstEs items with
        -- (built only from constants: built once, a constant)
        | .true => match CG.fresh st "cst" with
          | .mk x st0 => match rcEs (RE.inner re) st0 .nil 0 .nil items with
            | .mk fc atoms _ st1 => .mk (.t ("static V " +++ x +++ " = 0; if (!" +++ x +++ ") { ") ⧺ fc ⧺ .t (x +++ " = ") ⧺ objC "" tag n atoms ⧺
                .t ("; rt_root(&" +++ x +++ "); } inc(" +++ x +++ "); ")) (.t x) live st1
        | .false => match wish with
          | .mk w st0 => match rcEs re st0 names d live items with
            | .mk fc atoms fl st1 => bindTo st1 fc (objC w tag n atoms) fl
  | .letE v b => match CG.fresh st "l" with
    | .mk x st1 => match rcE re st1 (.cons x names) (d + 1) live b with
      | .mk bc ba bl st2 => match lvMem d bl with
        -- a dead value without effects: not computed at all (stage 15e)
        | .false => match pureE v with
          | .true => .mk bc ba bl st2
          | .false => rcLet re st2 names d x v bc ba bl
        | .true => rcLet re st2 names d x v bc ba bl
  | .case s bs =>
    let re2 := caseRE re d s;
    match rcBranches re2 st names d live bs with
    | .mk rbs u st1 => match CG.fresh st1 "r" with
      | .mk r st2 => match CG.fresh st2 "k" with
        | .mk k st3 =>
          -- (an owned variable matched on and used by no branch dies in each branch)
          let ux := match projRoot s with
            | .var j => match Nat.lt j d with
              | .true => match lvMem (d - 1 - j) (RE.bor re) with
                | .true => u
                | .false => lvIns (d - 1 - j) u
              | .false => u
            | _ => u;
          let body := branchesC (RE.cands re2) names d ux r 0 rbs ⧺ .t ("default: " +++ r +++ " = unreach(); } ");
          match projRoot s with
          -- (the tag of a variable's field: read in place)
          | .var j => match Nat.lt j d with
            | .true =>
              let nm := nthName' names j;
              let isB := lvMem (d - 1 - j) (RE.bor re);
              .mk (.t ("uint32_t " +++ k +++ " = tagof(") ⧺ projText (CG.pe st) names d s ⧺ .t ("); V " +++ r +++ "; switch (" +++ k +++ ") { ") ⧺ body) (.t r) (match isB with
                  | .true => u
                  | .false => lvIns (d - 1 - j) u) st3
            | .false => .mk (.t ("V " +++ r +++ "; switch (0) { ") ⧺ body) (.t r) u st3
          | _ => match rcE re st3 names d u s with
            | .mk sc sa sl st4 => .mk (sc ⧺ .t ("uint32_t " +++ k +++ " = tagof(") ⧺ sa ⧺ .t "); dec(" ⧺ sa ⧺
                .t ("); V " +++ r +++ "; switch (" +++ k +++ ") { ") ⧺ body) (.t r) sl st4
  | .prim op as =>
    -- a suspended `let` (`memo (λ _. v)`, see `lazyLets`): one object, the lifted
    -- function's captured variables and then its value
    match strEq op "memo" with
    | .true => match as with
      | .cons f rest => match rest with
        | .nil => match f with
          | .lam fb => match lamsOf fb with
            | .zero => rcLam re st names d live f .true
            | .succ _ => rcPrim re st names d live op as
          | _ => rcPrim re st names d live op as
        | .cons _ _ => rcPrim re st names d live op as
      | .nil => rcPrim re st names d live op as
    | .false => rcPrim re st names d live op as
  | .lam _ => rcLam re st names d live t .false
-- (15j) a region's head (`pe0`: the prefixes bound outside it): its prefixes bound, then
-- its code
def rcHead (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (pe0 : PE) (t : ETm) : RR :=
  match csePlan pe0 d t with
  | .mk pe em => match rcE re (CG.setPe st pe) names d live t with
    | .mk c a l st1 => .mk (emDeclsRC l (RE.bor re) names d em ⧺ c) a l (CG.setPe st1 (CG.pe st))
-- `let x := v` before the body's code `bc` (whose value is `ba`, which uses `bl`); if
-- the body uses `x`, the prefixes of `x` its region's head planned (15j)
def rcLet (re : RE) (st : CG) (names : List String) (d : Nat) (x : String) (v : ETm) (bc ba : Doc) (bl : List Nat) : RR :=
  match rcE re st names d (lvDel d bl) v with
  | .mk vc va vl st3 => .mk (vc ⧺ .t ("V " +++ x +++ " = ") ⧺ va ⧺ .t "; " ⧺ (match lvMem d bl with
      | .true => chainDecls x 0 (peFind d (CG.pe st))
      | .false => .t ("dec(" +++ x +++ "); ")) ⧺ bc) ba vl st3
def rcPrim (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (op : String) (as : ETms) : RR :=
  match strEq op "wiz.self" with
  | .true => rcSelf re st names d live as
  | .false => match rcEs re st names d live as with
    | .mk ac atoms al st1 => bindTo st1 ac (.t ("p_" +++ mangle op +++ "(") ⧺ joinDocs atoms ⧺ .t ")") al
-- a self tail call (`markSelf`, its function first): the arguments, then the parameters
-- reassigned and a jump back to the function's start
def rcSelf (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (as : ETms) : RR := match as with
  | .cons h rest => match h with
    | .glob g => match rcArgs re st names d live (RE.sig re g) (etmsList rest) with
      | .mk ac atoms _ al st1 => .mk (ac ⧺ .t "{ " ⧺ selfJumpDoc atoms ⧺ .t "} ") (.t "BOX(0)") al st1
    | _ => .mk (.t "") (.t "unreach()") live st
  | .nil => .mk (.t "") (.t "unreach()") live st
-- a chain of `λ`s, lifted (as in `cgE`): a function closure, or with `thunk` a
-- suspension (`mkthunk`: a closure computing its value once, then releasing what it
-- captured)
def rcLam (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (t : ETm) (thunk : Bool) : RR :=
    -- a chain of `k` `λ`s, lifted as in `cgE`; the function owns its captured
    -- variables and arguments (`dec`ing those it doesn't use)
    let k := lamsOf t;
    let body := underLams k t;
    let caps := dropBoundK k (freeE body .nil);
    let nc := lenL caps;
    let d2 := k + maxVar caps;
    match CG.fresh st "lam" with
    | .mk fname st1 =>
      let inner := List.append (paramNamesA nc k k) (capNamesA caps 0 (maxVar caps));
      match rcHead (RE.inner re) st1 inner d2 .nil .nil body with
      | .mk bc ba bl st2 =>
        let st3 := CG.emit st2 (.t ("static V " +++ fname +++ "(V *a) { ") ⧺ entryDrops inner d2 bl (List.append (rangeL 0 k) (addK k caps)) ⧺
          bc ⧺ .t "return " ⧺ ba ⧺ .t "; }");
        match capUses (RE.bor re) names d live caps with
        | .mk cc cl => match thunk with
          | .true => match caps with
            | .nil => bindTo st3 cc (.t ("mkthunk(" +++ fname +++ ", 0, NULL)")) cl
            | .cons _ _ => bindTo st3 cc (.t ("mkthunk(" +++ fname +++ ", " +++ Nat.toString nc +++
                ", (V[]){" +++ joinC (capsCode names caps) +++ "})")) cl
          | .false => match caps with
            -- (capturing nothing: one closure, built once, a constant)
            | .nil => match CG.fresh st3 "clo" with
              | .mk x st4 => .mk (cc ⧺ .t ("static V " +++ x +++ " = 0; if (!" +++ x +++ ") { " +++ x +++ " = mkfun(" +++ fname +++ ", " +++
                  Nat.toString k +++ ", 0, NULL); rt_root(&" +++ x +++ "); } inc(" +++ x +++ "); ")) (.t x) cl st4
            | .cons _ _ => bindTo st3 cc (.t ("mkfun(" +++ fname +++ ", " +++ Nat.toString (nc + k) +++ ", " +++ Nat.toString nc +++
                ", (V[]){" +++ joinC (capsCode names caps) +++ "})")) cl
-- a saturated call of `d_g`, then the rest applied: a variable in a borrowed position
-- is lent (kept alive across the call, released after it if that was its last use),
-- any other argument there is a temporary released after the call
def rcCall (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (g : String) (k : Nat) (args : List ETm) : RR :=
  let sig := RE.sig re g;
  let lent := lentVars (RE.bor re) d sig args;
  -- (the lent variables dying after the call are released first: compiled backwards)
  match dropsC re st names d (lvDiff lent live) with
  | .mk dc st0 => match rcArgs re st0 names d (lvUnion lent live) sig args with
    | .mk ac atoms posts al st1 => match bindTo st1 ac (.t ("d_" +++ mangle g +++ "(") ⧺ joinDocs (takeL k atoms) ⧺ .t ")") al with
      | .mk cc ca cl st2 =>
        let cc2 := cc ⧺ dc ⧺ posts;
        match dropL k atoms with
        | .nil => .mk cc2 ca cl st2
        | .cons _ _ => bindTo st2 cc2 (callC ca (dropL k atoms)) cl
def rcArgs (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (sig : List Bool) (ts : List ETm) : RRp := match ts with
  | .nil => .mk (.t "") .nil (.t "") live st
  | .cons t rest => match rcArgs re st names d live (tailB sig) rest with
    | .mk rc ras rp rl st1 => match headB sig with
      | .true => match t with
        | .var i => match Nat.lt i d with
          | .true => .mk rc (.cons (.t (nthName' names i)) ras) rp rl st1
          | .false => .mk rc (.cons (.t "BOX(0)") ras) rp rl st1
        | _ => match rcE re st1 names d rl t with
          | .mk tc ta tl st2 => .mk (tc ⧺ rc) (.cons ta ras) (.t "dec(" ⧺ ta ⧺ .t "); " ⧺ rp) tl st2
      | .false => match rcE re st1 names d rl t with
        | .mk tc ta tl st2 => .mk (tc ⧺ rc) (.cons ta ras) rp tl st2
-- a head applied to arguments: the head first, then the arguments
def rcApply (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (h : ETm) (args : List ETm) : RR :=
  match rcList re st names d live args with
  | .mk ac atoms al st1 => match rcE re st1 names d al h with
    | .mk hc ha hl st2 => bindTo st2 (hc ⧺ ac) (callC ha atoms) hl
-- terms evaluated left to right (compiled right to left)
def rcList (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (ts : List ETm) : RRs := match ts with
  | .nil => .mk (.t "") .nil live st
  | .cons t rest => match rcList re st names d live rest with
    | .mk rc ras rl st1 => match rcE re st1 names d rl t with
      | .mk tc ta tl st2 => .mk (tc ⧺ rc) (.cons ta ras) tl st2
def rcEs (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (ts : ETms) : RRs := match ts with
  | .nil => .mk (.t "") .nil live st
  | .cons t rest => match rcEs re st names d live rest with
    | .mk rc ras rl st1 => match rcE re st1 names d rl t with
      | .mk tc ta tl st2 => .mk (tc ⧺ rc) (.cons ta ras) tl st2
def rcBranches (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (bs : ETms) : RBs := match bs with
  | .nil => .mk .nil live st
  | .cons b rest => match rcBranches re st names d live rest with
    -- (each branch starts with no wish and keeps its own; the one from after the `case`
    -- is put back)
    | .mk rbs u st1 => match rcHead re (CG.setPend st1 .idle) names d live (CG.pe st1) b with
      | .mk bc ba bl st2 => .mk (.cons (.mk bc ba bl (CG.pend st2)) rbs) (lvUnion bl u) (CG.setPend st2 (CG.pend st1))
end

-- a whole program: every non-native global (the last of each name), erased; then the
-- code, a global of arity `k` as a C function `d_g` of `k` arguments (and `get_g()`
-- its curried closure), any other as a value built the first time it is used; then
-- `main` run on the world. The runtime is `#include`d.
-- the self tail calls of `g` (arity `k`, borrowed parameters `bor` by level, its
-- signature `sig`) in a body at depth `d`, as `wiz.self` (see `etmsList`)
def selfArgsOk (bor : List Nat) (d : Nat) : List Bool → List ETm → Bool
  | _, .nil => .true
  | sig, .cons t rest => match headB sig with
    | .true => match t with
      | .var i => Bool.and (Bool.and (Nat.lt i d) (lvMem (d - 1 - i) bor)) (selfArgsOk bor d (tailB sig) rest)
      | _ => .false
    | .false => selfArgsOk bor d (tailB sig) rest
mutual
def markSelf (g : String) (k : Nat) (sig : List Bool) (bor : List Nat) (d : Nat) (t : ETm) : ETm := match t with
  | .letE v b => .letE v (markSelf g k sig bor (d + 1) b)
  | .case s bs => .case s (markSelfEs g k sig bor d bs)
  | .app f a => match spineE f (.cons a .nil) with
    | .mk h args => match h with
      | .glob g2 => match Bool.and (strEq g g2) (Bool.and (Nat.beq (lenL args) k) (selfArgsOk bor d sig args)) with
        | .true => .prim "wiz.self" (.cons (.glob g) (etmsOfList args))
        | .false => t
      | _ => t
  | _ => t
def markSelfEs (g : String) (k : Nat) (sig : List Bool) (bor : List Nat) (d : Nat) : ETms → ETms
  | .nil => .nil
  | .cons t rest => .cons (markSelf g k sig bor d t) (markSelfEs g k sig bor d rest)
end

inductive Erased where
  | mk (name : String) (e : ETm)
inductive EraseR where
  | ok (gs : List Erased)
  | err (msg : String)
-- (stage 21t) the implementation `attribute [implemented_by g] f` gives `f` (the latest)
def implOf (n : String) : List Foreign → Option String
  | .nil => .none
  | .cons f rest => match f with
    | .impl m g => match strEq m n with
      | .true => .some g
      | .false => implOf n rest
    | _ => implOf n rest
partial def eraseGlobals (sl : Bool) (ffi : List Foreign) (all : Array Global) (seen : List String) (acc : List Erased) : Nat → EraseR
  | .zero => .ok acc
  | .succ k => match Array.getD all k (.mk "?" .star .star .star .nil) with
    | .mk n ty v _ _ => match Bool.or (elemStr n seen) (isNative n) with
      | .true => eraseGlobals sl ffi all seen acc k
      -- (an implemented definition's code is its implementation's)
      | .false => match implOf n ffi with
      | .some g => eraseGlobals sl ffi all (.cons n seen) (.cons (.mk n (.glob g)) acc) k
      | .none => match v with
        | .axiomC _ _ => eraseGlobals sl ffi all (.cons n seen) acc k
        | _ => match eraseCheck empty v (eval .nil ty) with
          | .err m => .err (n +++ ": " +++ m)
          | .ok e =>
            let e' := match sl with
              | .true => markLets e
              | .false => lazyLets .false e;
            eraseGlobals sl ffi all (.cons n seen) (.cons (.mk n e') acc) k
def arities : StrMap Nat → List Erased → StrMap Nat
  | ar, .nil => ar
  | ar, .cons (.mk n e) rest => arities (StrMap.insert ar (Str.ofString n) (lamsOf e)) rest
def paramNames (k : Nat) : Nat → List String
  | .zero => .nil
  | .succ i => .cons ("p" +++ Nat.toString i) (paramNames k i)
def paramDecls : Nat → Nat → String
  | _, .zero => ""
  | i, .succ m => match m with
    | .zero => "V p" +++ Nat.toString i
    | .succ _ => "V p" +++ Nat.toString i +++ ", " +++ paramDecls (i + 1) m
def argList : Nat → Nat → String
  | _, .zero => ""
  | i, .succ m => match m with
    | .zero => "a[" +++ Nat.toString i +++ "]"
    | .succ _ => "a[" +++ Nat.toString i +++ "], " +++ argList (i + 1) m
-- the code of each global: its prototypes and its definitions
inductive Code where
  | mk (protos defs : List Doc) (st : CG)
def genCode : CG → List Doc → List Doc → List Erased → Code
  | st, protos, defs, .nil => .mk protos defs st
  | st, protos, defs, .cons (.mk n e) rest =>
    let g := mangle n;
    let k := lamsOf e;
    match k with
    | .zero => match cgHead st .nil .nil e with
      | .mk code st1 =>
        genCode st1 (.cons (.t ("V get_" +++ g +++ "(void);")) protos)
          (.cons (.t ("static V g_" +++ g +++ "; static int i_" +++ g +++ "; V get_" +++ g +++
            "(void) { if (!i_" +++ g +++ ") { g_" +++ g +++ " = ") ⧺ code ⧺ .t ("; i_" +++ g +++ " = 1; } return g_" +++ g +++ "; }")) defs) rest
    | .succ _ =>
      -- the parameters: `p0` the first, so the innermost (index 0) is `p(k-1)`
      match cgHead st (paramNames k k) .nil (markSelf n k .nil .nil k (underLams k e)) with
      | .mk code st1 =>
        let ps := paramDecls 0 k;
        genCode st1 (.cons (.t ("V d_" +++ g +++ "(" +++ ps +++ "); V get_" +++ g +++ "(void);")) protos)
          (.cons (.t ("V d_" +++ g +++ "(" +++ ps +++ ") { top_: return ") ⧺ code ⧺ .t "; }") (.cons
            (.t ("static V w_" +++ g +++ "(V *a) { return d_" +++ g +++ "(" +++ argList 0 k +++ "); } " +++
             "V get_" +++ g +++ "(void) { static V c = 0; if (!c) c = native(w_" +++ g +++ ", " +++ Nat.toString k +++ "); return c; }")) defs)) rest
-- **Foreign functions** (stage 21l). An `extern` (`Foreign.fn`, from the frontend) is a
-- C function `d_g` of the Wiz function's arity (the world last, for an `IO` result) that
-- marshals its arguments by their kinds (as `C.glue` does for the Lean backends), calls
-- the C function, and builds the result: `Nat`, `UInt64` and `Float64` from/to their
-- C numbers, a `String` through a UTF-8 copy, `Bool` an `int`, `Unit` nothing, a
-- foreign pointer wrapped in an object that runs the type's finalizer when it dies
-- (under reference counting: its last reference; under the collector: when it is
-- collected, or at exit). Like any function it owns its arguments; a foreign pointer is
-- lent to C for the call and released after it. Without a header, a prototype is
-- written from the Wiz type (except for the runtime's own `wiz_…` functions).
def ffiArity (ps : List String) (io : Bool) : Nat := lenL ps + (match io with
  | .true => 1
  | .false => 0)
def ffiArities : StrMap Nat → List Foreign → StrMap Nat
  | ar, .nil => ar
  | ar, .cons f rest => match f with
    | .fn n _ _ ps _ io _ => ffiArities (StrMap.insert ar (Str.ofString n) (ffiArity ps io)) rest
    | _ => ffiArities ar rest
def ffiCType (k : String) : String := match strEq k "f" with
  | .true => "double"
  | .false => match strEq k "s" with
  | .true => "const char *"
  | .false => match strEq k "b" with
  | .true => "int"
  | .false => match strEq k "p" with
  | .true => "void *"
  | .false => match strEq k "w" with
  | .true => "V"
  | .false => match strEq k "v" with
  | .true => "void"
  | .false => "uint64_t"
-- the C type of a value Wiz gives C (a string is `malloc`ed: the caller frees it)
def ffiCTypeOut (k : String) : String := match strEq k "s" with
  | .true => "char *"
  | .false => ffiCType k
def commaSep : List String → String
  | .nil => ""
  | .cons x rest => match rest with
    | .nil => x
    | .cons _ _ => x +++ ", " +++ commaSep rest
def ffiPrefix : List Char → List Char → Bool
  | .nil, _ => .true
  | .cons _ _, .nil => .false
  | .cons a xs, .cons b ys => match Nat.beq (Char.code a) (Char.code b) with
    | .true => ffiPrefix xs ys
    | .false => .false
def strStarts (p s : String) : Bool := match p with
  | .mk ps => match s with
    | .mk cs => ffiPrefix ps cs
-- (stage 21q) A callback's kind `k[<params>/<result>]` (`K[…]` owned by C, `!` before a
-- result in `IO`), from the frontend: its signature.
inductive CbSig where
  | mk (owned : Bool) (params : List String) (res : String) (io : Bool)
inductive CbPs where
  | mk (params : List String) (rest : List Char)
def cbParams : List Char → CbPs
  | .nil => .mk .nil .nil
  | .cons c rest => match Nat.beq (Char.code c) 47 with
    | .true => .mk .nil rest
    | .false => match cbParams rest with
      | .mk ps r => .mk (.cons (String.mk (.cons c .nil)) ps) r
def cbRes (owned : Bool) (ps : List String) : List Char → Option CbSig
  | .nil => .none
  | .cons x more => match Nat.beq (Char.code x) 33 with
    | .true => (match more with
      | .cons y _ => .some (.mk owned ps (String.mk (.cons y .nil)) .true)
      | .nil => .none)
    | .false => .some (.mk owned ps (String.mk (.cons x .nil)) .false)
def cbOf (k : String) : Option CbSig := match k with
  | .mk cs => match cs with
    | .cons a (.cons b rest) => match Bool.and (Bool.or (Nat.beq (Char.code a) 107) (Nat.beq (Char.code a) 75)) (Nat.beq (Char.code b) 91) with
      | .true => (match cbParams rest with
        | .mk ps r => cbRes (Nat.beq (Char.code a) 75) ps r)
      | .false => .none
    | _ => .none
-- the trampoline of a signature (as the Lean backends name it): C calls it with the
-- context (the closure) first
def cbName (c : CbSig) : String := match c with
  | .mk _ ps r io => "wiz_cb_" +++ joinStrs ps +++ "_" +++ (match io with
    | .true => "io_"
    | .false => "") +++ r
def ffiCTypes : List String → List String
  | .nil => .nil
  | .cons k rest => .cons (ffiCType k) (ffiCTypes rest)
-- the C type of its function pointer
def cbPtrType (c : CbSig) : String := match c with
  | .mk _ ps r _ => ffiCTypeOut r +++ " (*)(" +++ commaSep (.cons "void *" (ffiCTypes ps)) +++ ")"
-- (stage 21r) the `c_struct` of a kind `S:T`
def kindStruct (ffi : List Foreign) (k : String) : Option Foreign := match dropPrefix (strChars "S:") (strChars k) with
  | .some r => cstructOf ffi (String.mk r)
  | .none => .none
def structCType (f : Foreign) : String := match f with
  | .cstruct _ c _ _ _ => c
  | _ => "void"
def structMangled (f : Foreign) : String := match f with
  | .cstruct n _ _ _ _ => mangle n
  | _ => ""
-- the C type of an extern's kind (a struct's C type)
def extCType (ffi : List Foreign) (k : String) : String := match kindStruct ffi k with
  | .some f => structCType f
  | .none => ffiCType k
-- the C parameter types of a prototype (`e` and `v` are not passed; a callback is a
-- function pointer and its context)
def ffiProtoParams (ffi : List Foreign) : List String → List String
  | .nil => .nil
  | .cons k rest => match Bool.or (strEq k "e") (strEq k "v") with
    | .true => ffiProtoParams ffi rest
    | .false => match cbOf k with
      | .some c => .cons (cbPtrType c) (.cons "void *" (ffiProtoParams ffi rest))
      | .none => .cons (extCType ffi k) (ffiProtoParams ffi rest)
inductive FfiIn where
  | mk (pre : String) (cargs : List String) (post : String)
-- (stage 21q) a callback: its trampoline and the closure as the context; a borrowed one
-- is released after the call, an owned one (`Callback`) is C's now. (21r) A struct by
-- value: filled from the structure, which is released after the call.
def ffiInMore (ffi : List Foreign) (k a c pre : String) (cargs : List String) (post : String) : FfiIn := match cbOf k with
  | .some cb => .mk pre (.cons (cbName cb) (.cons ("(void *)" +++ a) cargs)) (match cb with
    | .mk owned _ _ _ => match owned with
      | .true => post
      | .false => "rt_drop(" +++ a +++ "); " +++ post)
  | .none => match kindStruct ffi k with
    | .some f => .mk (structCType f +++ " " +++ c +++ "; wiz_sin_" +++ structMangled f +++ "(&" +++ c +++ ", " +++ a +++ "); " +++ pre) (.cons c cargs)
        ("wiz_sfree_" +++ structMangled f +++ "(&" +++ c +++ "); rt_drop(" +++ a +++ "); " +++ post)
    | .none => .mk ("uint64_t " +++ c +++ " = rt_in_nat(" +++ a +++ "); " +++ pre) (.cons c cargs) post
-- the marshalling of the parameters: the statements before the call, the C arguments,
-- and the statements after it
partial def ffiIn (ffi : List Foreign) (i : Nat) : List String → FfiIn
  | .nil => .mk "" .nil ""
  | .cons k rest => match ffiIn ffi (i + 1) rest with
    | .mk pre cargs post =>
      let a := "p" +++ Nat.toString i;
      let c := "c" +++ Nat.toString i;
      match strEq k "e" with
      | .true => .mk pre cargs post
      | .false => match strEq k "v" with
      | .true => .mk ("rt_drop(" +++ a +++ "); " +++ pre) cargs post
      | .false => match strEq k "w" with
      | .true => .mk pre (.cons a cargs) post
      | .false => match strEq k "s" with
      | .true => .mk ("char *" +++ c +++ " = rt_in_str(" +++ a +++ "); " +++ pre) (.cons c cargs) ("rt_free_cstr(" +++ c +++ "); " +++ post)
      | .false => match strEq k "p" with
      | .true => .mk ("void *" +++ c +++ " = rt_in_ptr(" +++ a +++ "); " +++ pre) (.cons c cargs) ("rt_drop(" +++ a +++ "); " +++ post)
      | .false => match strEq k "b" with
      | .true => .mk ("int " +++ c +++ " = rt_in_bool(" +++ a +++ "); " +++ pre) (.cons c cargs) post
      | .false => match strEq k "f" with
      | .true => .mk ("double " +++ c +++ " = rt_in_f64(" +++ a +++ "); " +++ pre) (.cons c cargs) post
      | .false => match strEq k "u" with
      | .true => .mk ("uint64_t " +++ c +++ " = rt_in_u64(" +++ a +++ "); " +++ pre) (.cons c cargs) post
      | .false => ffiInMore ffi k a c pre cargs post
-- the result, from the call
def ffiOut (ffi : List Foreign) (k fin call : String) : String := match strEq k "v" with
  | .true => call +++ "; V r = BOX(0); "
  | .false => match strEq k "w" with
  | .true => "V r = " +++ call +++ "; "
  | .false => match strEq k "s" with
  | .true => "V r = rt_out_str(" +++ call +++ "); "
  | .false => match strEq k "p" with
  | .true => "V r = rt_out_ptr((void *)" +++ call +++ ", " +++ (match strEq fin "" with
    | .true => "NULL"
    | .false => "(void (*)(void *))" +++ fin) +++ "); "
  | .false => match strEq k "b" with
  | .true => "V r = boolv(" +++ call +++ " != 0); "
  | .false => match strEq k "f" with
  | .true => "V r = rt_out_f64(" +++ call +++ "); "
  | .false => match strEq k "u" with
  | .true => "V r = rt_out_u64(" +++ call +++ "); "
  | .false => match kindStruct ffi k with
  | .some f => "V r = wiz_sout_" +++ structMangled f +++ "(" +++ call +++ "); "
  | .none => "V r = rt_out_nat(" +++ call +++ "); "
def elemS (x : String) : List String → Bool
  | .nil => .false
  | .cons y rest => Bool.or (strEq x y) (elemS x rest)
-- (stage 21r) A `c_struct`'s C side: its definition (without a header: `struct t { … };`
-- or a `typedef`, from the fields) and the marshalling helpers, as `structHelpers` in
-- `C.lean`: `wiz_sin_T(&c, v)` fills `c` from the structure `v` (borrowed: the payload
-- `(tag, (f₀, (f₁, … ◾)))`; fields not named are zero), `wiz_sfree_T` frees the strings
-- that made, and `wiz_sout_T(c)` builds a structure (strings copied, a pointer without a
-- finalizer).
def structFieldCType (ffi : List Foreign) (k : String) : String := match kindStruct ffi k with
  | .some f => structCType f
  | .none => ffiCType k
def structFieldDecls (ffi : List Foreign) : List String → List String → String
  | .cons f fs, .cons k ks => structFieldCType ffi k +++ " " +++ f +++ "; " +++ structFieldDecls ffi fs ks
  | _, _ => ""
def structDefinition (ffi : List Foreign) (ctype : String) (fs ks : List String) : String := match strStarts "struct " ctype with
  | .true => ctype +++ " { " +++ structFieldDecls ffi fs ks +++ "};"
  | .false => "typedef struct { " +++ structFieldDecls ffi fs ks +++ "} " +++ ctype +++ ";"
-- the structure's field `i` (borrowed)
def seconds : Nat → String → String
  | .zero, e => e
  | .succ k, e => seconds k ("fld(" +++ e +++ ", 1)")
def fieldPath (i : Nat) : String := "fld(" +++ seconds i "fld(v, 1)" +++ ", 0)"
def structIn (ffi : List Foreign) : Nat → List String → List String → String
  | i, .cons f fs, .cons k ks =>
    let x := fieldPath i;
    let lhs := "c->" +++ f;
    let dup := fun (conv : String) => "{ V t = " +++ x +++ "; rt_dup(t); " +++ lhs +++ " = " +++ conv +++ "(t); } ";
    (match strEq k "n" with
    | .true => lhs +++ " = rt_in_nat(" +++ x +++ "); "
    | .false => match strEq k "p" with
    | .true => lhs +++ " = rt_in_ptr(" +++ x +++ "); "
    | .false => match strEq k "u" with
    | .true => dup "rt_in_u64"
    | .false => match strEq k "f" with
    | .true => dup "rt_in_f64"
    | .false => match strEq k "b" with
    | .true => dup "rt_in_bool"
    | .false => match strEq k "s" with
    | .true => dup "rt_in_str"
    | .false => match kindStruct ffi k with
    | .some g => "wiz_sin_" +++ structMangled g +++ "(&" +++ lhs +++ ", " +++ x +++ "); "
    | .none => "") +++ structIn ffi (i + 1) fs ks
  | _, _, _ => ""
def structFree (ffi : List Foreign) : List String → List String → String
  | .cons f fs, .cons k ks => (match strEq k "s" with
    | .true => "rt_free_cstr((char *)c->" +++ f +++ "); "
    | .false => match kindStruct ffi k with
    | .some g => "wiz_sfree_" +++ structMangled g +++ "(&c->" +++ f +++ "); "
    | .none => "") +++ structFree ffi fs ks
  | _, _ => ""
def structOut (ffi : List Foreign) : Nat → List String → List String → String
  | i, .cons f fs, .cons k ks =>
    let x := "c." +++ f;
    "fs[" +++ Nat.toString i +++ "] = " +++ (match strEq k "s" with
    | .true => "rt_out_str(" +++ x +++ ")"
    | .false => match strEq k "p" with
    | .true => "rt_out_ptr((void *)" +++ x +++ ", NULL)"
    | .false => match strEq k "b" with
    | .true => "boolv(" +++ x +++ " != 0)"
    | .false => match strEq k "f" with
    | .true => "rt_out_f64(" +++ x +++ ")"
    | .false => match strEq k "u" with
    | .true => "rt_out_u64(" +++ x +++ ")"
    | .false => match kindStruct ffi k with
    | .some g => "wiz_sout_" +++ structMangled g +++ "(" +++ x +++ ")"
    | .none => "rt_out_nat(" +++ x +++ ")") +++ "; " +++ structOut ffi (i + 1) fs ks
  | _, _, _ => ""
def structHelpers (ffi : List Foreign) (n ctype : String) (fs ks : List String) : List Doc :=
  let m := mangle n;
  let k := lenL fs;
  .cons (.t ("static void wiz_sin_" +++ m +++ "(" +++ ctype +++ " *c, V v) { memset(c, 0, sizeof *c); " +++ structIn ffi 0 fs ks +++ "}"))
    (.cons (.t ("static void wiz_sfree_" +++ m +++ "(" +++ ctype +++ " *c) { (void)c; " +++ structFree ffi fs ks +++ "}"))
    (.cons (.t ("static V wiz_sout_" +++ m +++ "(" +++ ctype +++ " c) { V fs[" +++ Nat.toString k +++ "]; " +++ structOut ffi 0 fs ks +++
      "V r = BOX(0); for (int i = " +++ Nat.toString (k - 1) +++ "; i >= 0; i--) r = pair(fs[i], r); return pair(BOX(0), r); }")) .nil))
-- the headers to include (each once), the structs, and the prototypes
partial def ffiDecls (ffi : List Foreign) (seen : List String) : List Foreign → List Doc
  | .nil => .nil
  | .cons f rest => match f with
    | .fn _ cname header ps r _ _ => match strEq header "" with
      | .false => match elemS header seen with
        | .true => ffiDecls ffi seen rest
        | .false => .cons (.t ("#include <" +++ header +++ ">")) (ffiDecls ffi (.cons header seen) rest)
      | .true => match Bool.or (strStarts "wiz_" cname) (elemS cname seen) with
        | .true => ffiDecls ffi seen rest
        | .false =>
          let pts := ffiProtoParams ffi ps;
          .cons (.t ("extern " +++ extCType ffi r +++ " " +++ cname +++ "(" +++ (match pts with
            | .nil => "void"
            | .cons _ _ => commaSep pts) +++ ");")) (ffiDecls ffi (.cons cname seen) rest)
    | .cstruct n ctype header fs ks =>
      let helpers := structHelpers ffi n ctype fs ks;
      match strEq header "" with
      | .true => .cons (.t (structDefinition ffi ctype fs ks)) (List.append helpers (ffiDecls ffi seen rest))
      | .false => match elemS header seen with
        | .true => List.append helpers (ffiDecls ffi seen rest)
        | .false => .cons (.t ("#include <" +++ header +++ ">")) (List.append helpers (ffiDecls ffi (.cons header seen) rest))
    | _ => ffiDecls ffi seen rest
-- (stage 21q) A C function that applies the Wiz closure `f` (an owned value) to its C
-- arguments `c0 …` of kinds `ps` (C values become Wiz values: `Nat`/`UInt64` from
-- `uint64_t`, `Float64` from `double`, `String` copied from a `const char *`, `Bool` from
-- `int`, a foreign pointer lent without a finalizer, a Wiz value as it is), the world
-- last for an `IO` result (whose value is then the pair's first field, the payload
-- `(tag, (a, (w, ◾)))`), and converts the result back (a `String` as a `malloc`ed
-- `char *` the caller frees, `Unit` as `void`): the body of an export's wrapper and of
-- a callback's trampoline.
def exportArgs : Nat → List String → List String
  | _, .nil => .nil
  | i, .cons k rest =>
    let c := "c" +++ Nat.toString i;
    .cons (match strEq k "s" with
      | .true => "rt_out_str(" +++ c +++ ")"
      | .false => match strEq k "p" with
      | .true => "rt_out_ptr(" +++ c +++ ", NULL)"
      | .false => match strEq k "b" with
      | .true => "boolv(" +++ c +++ " != 0)"
      | .false => match strEq k "f" with
      | .true => "rt_out_f64(" +++ c +++ ")"
      | .false => match strEq k "u" with
      | .true => "rt_out_u64(" +++ c +++ ")"
      | .false => match strEq k "w" with
      | .true => c
      | .false => "rt_out_nat(" +++ c +++ ")") (exportArgs (i + 1) rest)
def exportParams : Nat → List String → List String
  | _, .nil => .nil
  | i, .cons k rest => .cons (ffiCType k +++ " c" +++ Nat.toString i) (exportParams (i + 1) rest)
def exportResult (k : String) : String := match strEq k "v" with
  | .true => "rt_drop(r); "
  | .false => match strEq k "s" with
  | .true => "return rt_export_str(r); "
  | .false => match strEq k "b" with
  | .true => "return rt_in_bool(r); "
  | .false => match strEq k "f" with
  | .true => "return rt_in_f64(r); "
  | .false => match strEq k "u" with
  | .true => "return rt_in_u64(r); "
  | .false => match strEq k "w" with
  | .true => "return r; "
  | .false => "return rt_in_nat(r); "
def callIntoWiz (rc : Bool) (f : String) (ps : List String) (r : String) (io : Bool) : String :=
  let args := List.append (exportArgs 0 ps) (match io with
    | .true => .cons "BOX(0)" .nil
    | .false => .nil);
  let call := match args with
    | .nil => f
    | .cons _ _ => "apn(" +++ f +++ ", " +++ Nat.toString (lenL args) +++ ", (V[]){" +++ commaSep args +++ "})";
  let res := match io with
    | .true => "V pr = " +++ call +++ "; V r = fld(fld(pr, 1), 0); " +++ (match rc with
      | .true => "inc(r); dec(pr); "
      | .false => "")
    | .false => "V r = " +++ call +++ "; ";
  res +++ exportResult r
-- (stage 21q) the trampolines, one per callback signature: the closure is the context,
-- which C keeps (so the trampoline takes a reference of its own for the call)
def cbKinds : List Foreign → List String
  | .nil => .nil
  | .cons f rest => match f with
    | .fn _ _ _ ps _ _ _ => List.append ps (cbKinds rest)
    | _ => cbKinds rest
partial def cbDocs (rc : Bool) (seen : List String) : List String → List Doc
  | .nil => .nil
  | .cons k rest => match cbOf k with
    | .none => cbDocs rc seen rest
    | .some c => match elemS (cbName c) seen with
      | .true => cbDocs rc seen rest
      | .false => match c with
        | .mk _ ps r io => .cons (.t ("static " +++ ffiCTypeOut r +++ " " +++ cbName c +++ "(" +++ commaSep (.cons "void *ctx" (exportParams 0 ps)) +++
            ") { rt_dup((V)ctx); " +++ callIntoWiz rc "(V)ctx" ps r io +++ "}")) (cbDocs rc (.cons (cbName c) seen) rest)
-- each foreign function's wrapper, `get_g` its curried closure (a constant computed
-- once, for arity 0)
def ffiWrappers (ffi : List Foreign) (rc : Bool) : List Foreign → List Doc
  | .nil => .nil
  | .cons f rest => match f with
    | .fn n cname _ ps r io fin =>
      let g := mangle n;
      let k := ffiArity ps io;
      let keep := match rc with
        | .true => "rt_root(&c); } inc(c); "
        | .false => "} ";
      match ffiIn ffi 0 ps with
      | .mk pre cargs post =>
        let body := pre +++ ffiOut ffi r fin (cname +++ "(" +++ commaSep cargs +++ ")") +++ post;
        let ret := match io with
          | .true => "return prodv(r, p" +++ Nat.toString (k - 1) +++ "); "
          | .false => "return r; ";
        match k with
        | .zero => .cons (.t ("V get_" +++ g +++ "(void) { static V c = 0; static int i = 0; if (!i) { i = 1; c = ({ " +++ body +++ "r; }); " +++
            keep +++ "return c; }")) (ffiWrappers ffi rc rest)
        | .succ _ => .cons (.t ("V d_" +++ g +++ "(" +++ paramDecls 0 k +++ ") { " +++ body +++ ret +++ "} " +++
            "static V w_" +++ g +++ "(V *a) { return d_" +++ g +++ "(" +++ argList 0 k +++ "); } " +++
            "V get_" +++ g +++ "(void) { static V c = 0; if (!c) { c = native(w_" +++ g +++ ", " +++ Nat.toString k +++ "); " +++ keep +++ "return c; }"))
          (ffiWrappers ffi rc rest)
    | _ => ffiWrappers ffi rc rest
-- (stage 21o) The C files and libraries of `link_c`/`link_lib`, as lines at the top of the
-- C the compiler prints: the C file is one translation unit with the runtime, so the
-- files are compiled and linked by whoever compiles it (`cc out.c f.c -lm`; the tests
-- read these lines).
def linkDocs : List Foreign → List Doc
  | .nil => .nil
  | .cons f rest => match f with
    | .link p lib => .cons (.t ((match lib with
        | .true => "// wiz-link-lib: "
        | .false => "// wiz-link-c: ") +++ p)) (linkDocs rest)
    | _ => linkDocs rest
-- (stage 21o) An `export`: a C function `cname` that applies the definition's closure
-- (`callIntoWiz`). (21s) It starts the runtime if nothing has (a library has no `main`).
def exportDocs (rc : Bool) : List Foreign → List Doc
  | .nil => .nil
  | .cons f rest => match f with
    | .exported n cname ps r io =>
      let ps' := exportParams 0 ps;
      .cons (.t (ffiCTypeOut r +++ " " +++ cname +++ "(" +++ (match ps' with
        | .nil => "void"
        | .cons _ _ => commaSep ps') +++ ") { rt_ensure(); " +++ callIntoWiz rc ("get_" +++ mangle n +++ "()") ps r io +++ "}")) (exportDocs rc rest)
    | _ => exportDocs rc rest
-- (stage 21s) The header of a library's exports (`--header`), as `exportHeader` in
-- `C.lean`: the handle functions and a prototype per export.
def headerParams : Nat → List String → List String
  | _, .nil => .nil
  | i, .cons k rest => .cons ((match strEq k "w" with
    | .true => "wiz_val"
    | .false => ffiCType k) +++ " a" +++ Nat.toString i) (headerParams (i + 1) rest)
def headerProtos : List Foreign → List Doc
  | .nil => .nil
  | .cons f rest => match f with
    | .exported _ cname ps r _ =>
      let ps' := headerParams 0 ps;
      .cons (.t ((match strEq r "w" with
        | .true => "wiz_val"
        | .false => ffiCTypeOut r) +++ " " +++ cname +++ "(" +++ (match ps' with
        | .nil => "void"
        | .cons _ _ => commaSep ps') +++ ");")) (headerProtos rest)
    | _ => headerProtos rest
def headerDocs (ffi : List Foreign) : List Doc :=
  .cons (.t "/* generated by wiz build --lib: the functions the Wiz program exports (stage 9g) */")
  (.cons (.t "#include <stdint.h>") (.cons (.t "#ifndef WIZ_VAL_DEFINED") (.cons (.t "#define WIZ_VAL_DEFINED")
  (.cons (.t "typedef uintptr_t wiz_val;") (.cons (.t "#endif") (.cons (.t "void wiz_release(void *v);")
  (.cons (.t "void wiz_retain(void *v);") (.cons (.t "long wiz_live_objects(void);") (headerProtos (List.reverseOf ffi .nil))))))))))
-- the C of a program's foreign functions (after the runtime)
def ffiDocs (rc : Bool) (ffi : List Foreign) : List Doc :=
  let fs := List.reverseOf ffi .nil;
  List.append (ffiDecls ffi .nil fs) (List.append (cbDocs rc .nil (cbKinds fs)) (ffiWrappers ffi rc fs))
-- **Applications pushed into `case`s** (reference counting mode). A match is a method
-- applied to the payload, and the method is chosen by a `case`: `(case s [bᵢ]) a⃗`
-- built a closure for the chosen branch and applied it. With cheap arguments
-- (variables, projections, `◾`), `case s [bᵢ a⃗]` is the same, and each `bᵢ a⃗` is
-- reduced by `betaE` (the arguments put in place): no closure at all.
mutual
def applyIn (b a : ETm) : ETm := match b with
  | .case s bs => .case s (applyInEs bs a)
  | .letE v body => .letE v (applyIn body (liftE 1 0 a))
  | _ => betaE b a
def applyInEs (bs : ETms) (a : ETm) : ETms := match bs with
  | .nil => .nil
  | .cons b rest => .cons (applyIn b a) (applyInEs rest a)
end
mutual
def pushE (t : ETm) : ETm := match t with
  | .app f a =>
    let f' := pushE f;
    let a' := pushE a;
    match f' with
    | .case s bs => match cheapE a' with
      | .true => .case s (applyInEs bs a')
      | .false => .app f' a'
    | _ => .app f' a'
  | .lam b => .lam (pushE b)
  | .letE v b => .letE (pushE v) (pushE b)
  | .obj k fs => .obj k (pushEs fs)
  | .proj i x => .proj i (pushE x)
  | .case s bs => .case (pushE s) (pushEs bs)
  | .prim op as => .prim op (pushEs as)
  | _ => t
def pushEs (ts : ETms) : ETms := match ts with
  | .nil => .nil
  | .cons t rest => .cons (pushE t) (pushEs rest)
end
def pushGlobals : List Erased → List Erased
  | .nil => .nil
  | .cons (.mk n e) rest => .cons (.mk n (pushE e)) (pushGlobals rest)
-- (the marked `let`s decided by their demands, `placeLet`)
def decideGlobals : List Erased → List Erased
  | .nil => .nil
  | .cons (.mk n e) rest => .cons (.mk n (decideLets 0 e)) (decideGlobals rest)
-- (stage 21s) the C `main`, unless the program is a library (`--lib`, `--no-main`)
def mainDocs (lib : Bool) (m : String) : List Doc := match lib with
  | .true => .nil
  | .false => .cons (.t m) .nil
-- the program's C text, one `Doc` per line
def genProgram (lib : Bool) (gs : Globals) : List Doc := match gs with
  | .mk all _ _ ffi => match eraseGlobals .false ffi all .nil .nil (Array.size all) with
    | .err m => .cons (.t ("#error " +++ m)) .nil
    | .ok es0 =>
      -- (applications pushed into `case`s, as under reference counting: a match is then
      -- no closure, and its recursive calls are in tail position)
      let es := pushGlobals es0;
      match genCode (.mk .nil 0 (arities (ffiArities StrMap.empty ffi) es) .idle .nil) .nil .nil es with
      | .mk protos defs st => match st with
        | .mk fns _ _ _ _ =>
          List.append (linkDocs (List.reverseOf ffi .nil)) (.cons (.t "#include \"rt.c\"") (List.append (ffiDocs .false ffi) (List.append protos
            (List.append (List.reverseOf fns .nil) (List.append defs (List.append (exportDocs .false (List.reverseOf ffi .nil))
              (mainDocs lib "int main(int argc, char **argv) { (void)argc; rt_start(argv); ap(get_main(), BOX(0)); rt_finishGC(); return 0; }")))))))

-- **Constructors inlined** (reference counting mode): a global whose body, under its
-- `λ`s, only builds an object from its parameters and constants (a constructor, as
-- `ETm.app`) is put in place where it is applied to all its arguments (the arguments
-- bound by `let`s, or put in place when cheap: `betaE`), so that the object is built
-- where reuse can see it.
mutual
def leafE : ETm → Bool
  | .var _ => .true
  | .erased => .true
  | .nat _ => .true
  | .obj _ fs => leafEs fs
  | _ => .false
def leafEs : ETms → Bool
  | .nil => .true
  | .cons t rest => match leafE t with
    | .true => leafEs rest
    | .false => .false
end
def isNulE : ETm → Bool
  | .obj k fs => match staticNul k fs with
    | .some _ => .true
    | .none => .false
  | _ => .false
def consMap : StrMap ETm → List Erased → StrMap ETm
  | m, .nil => m
  | m, .cons (.mk n e) rest => match lamsOf e with
    -- (a constant constructor: when it is a static object)
    | .zero => match isNulE e with
      | .true => consMap (StrMap.insert m (Str.ofString n) e) rest
      | .false => consMap m rest
    | .succ _ => match leafE (underLams (lamsOf e) e) with
      | .true => consMap (StrMap.insert m (Str.ofString n) e) rest
      | .false => consMap m rest
-- **Small branching functions inlined, their arguments suspended** (reference counting
-- mode): a global whose body, under its `λ`s, is a `case` on (a field of) a parameter
-- with cheap branches (`Bool.and`, `Bool.or`, `pick b x y`) is put in place where it is
-- applied to all its arguments, each bound by a marked `let` (`lazy`), so the demand
-- analysis evaluates an argument only in the branches that use it: `Bool.and a b` no
-- longer evaluates `b` when `a` is false (call by value did; `b` is pure, so this only
-- changes the cost). Marked in the constructor map as `lazyInl body`.
def smallBranchE : ETm → Bool
  | .glob _ => .true
  | t => leafE t
def smallBranches : ETms → Bool
  | .nil => .true
  | .cons t rest => match smallBranchE t with
    | .true => smallBranches rest
    | .false => .false
def lazyInlOf : ETm → Option ETm
  | .prim op as => match strEq op "lazyInl" with
    | .true => match as with
      | .cons b rest => match rest with
        | .nil => .some b
        | .cons _ _ => .none
      | .nil => .none
    | .false => .none
  | _ => .none
def caseShaped (k : Nat) (b : ETm) : Bool := match b with
  | .case s bs => match projRoot s with
    | .var i => Bool.and (Nat.lt i k) (smallBranches bs)
    | _ => .false
  | _ => .false
def caseMap : StrMap ETm → List Erased → StrMap ETm
  | m, .nil => m
  | m, .cons (.mk n e) rest => match lamsOf e with
    | .zero => caseMap m rest
    | .succ _ => match caseShaped (lamsOf e) (underLams (lamsOf e) e) with
      | .true => caseMap (StrMap.insert m (Str.ofString n) (.prim "lazyInl" (etms1 e))) rest
      | .false => caseMap m rest
-- `f a` with `f` a lambda: `a` put in place when cheap, else bound by a marked `let`
def betaLz : ETm → ETm → ETm
  | .lam b, a => match cheapE a with
    | .true => substE a 0 b
    | .false => .letE (.prim "lazy" (etms1 a)) b
  | .letE v b, a => .letE v (betaLz b (liftE 1 0 a))
  | f, a => .app f a
def betaLzL : ETm → List ETm → ETm
  | f, .nil => f
  | f, .cons a rest => betaLzL (betaLz f a) rest
def eappsL : ETm → List ETm → ETm
  | f, .nil => f
  | f, .cons a rest => eappsL (.app f a) rest
def betaL : ETm → List ETm → ETm
  | f, .nil => f
  | f, .cons a rest => betaL (betaE f a) rest
-- a global standing alone: a static object put in place
def inlConst (t body : ETm) : ETm := match isNulE body with
  | .true => body
  | .false => t
-- `h args`, `h` a global and `body` its definition if it is put in place (else `◾`)
def inlApp (h : ETm) (args : List ETm) (body0 : ETm) : ETm :=
  let lz := lazyInlOf body0;
  let body := match lz with
    | .some b => b
    | .none => body0;
  let k := lamsOf body;
  match Nat.lt 0 k with
  | .true => match Nat.le k (lenL args) with
    | .true => eappsL (match lz with
      | .some _ => betaLzL body (takeL k args)
      | .none => betaL body (takeL k args)) (dropL k args)
    | .false => eappsL h args
  | .false => eappsL h args
mutual
def inlE (m : StrMap ETm) (t : ETm) : ETm := match t with
  -- (a string literal stays one, for `rcE`)
  | .app f a => match stringConst t with
    | .some _ => t
    | .none => match spineE f (.cons a .nil) with
      | .mk h args =>
        let args2 := inlL m args;
        match h with
        | .glob g => inlApp h args2 (StrMap.findD m (Str.ofString g) .erased)
        | _ => eappsL (inlE m h) args2
  | .lam b => .lam (inlE m b)
  | .letE v b => .letE (inlE m v) (inlE m b)
  | .obj k fs => .obj k (inlEs m fs)
  | .proj i x => .proj i (inlE m x)
  | .case s bs => .case (inlE m s) (inlEs m bs)
  | .prim op as => .prim op (inlEs m as)
  | .glob g => inlConst t (StrMap.findD m (Str.ofString g) .erased)
  | _ => t
def inlEs (m : StrMap ETm) (ts : ETms) : ETms := match ts with
  | .nil => .nil
  | .cons t rest => .cons (inlE m t) (inlEs m rest)
def inlL (m : StrMap ETm) (ts : List ETm) : List ETm := match ts with
  | .nil => .nil
  | .cons t rest => .cons (inlE m t) (inlL m rest)
end
def inlGlobals (m : StrMap ETm) : List Erased → List Erased
  | .nil => .nil
  | .cons (.mk n e) rest => .cons (.mk n (inlE m e)) (inlGlobals m rest)

-- **Borrowed parameters** (as in Lean): a parameter of a global function that its body
-- only reads (projections, a `case`'s tag, borrowed arguments of direct calls) is
-- borrowed: the caller keeps it alive, the function neither `inc`s it for those reads
-- nor releases it. Found as a greatest fixed point: everything borrowed, then a
-- parameter the body consumes (passes to an owned position, returns, stores, captures)
-- made owned, until nothing changes.
-- does `t` build an object (not inside a `λ`)?
mutual
def buildsE : ETm → Bool
  | .obj _ fs => match fs with
    | .nil => .false
    | .cons _ _ => .true
  | .app f a => match buildsE f with
    | .true => .true
    | .false => buildsE a
  | .letE v b => match buildsE v with
    | .true => .true
    | .false => buildsE b
  | .proj _ t => buildsE t
  | .case s bs => match buildsE s with
    | .true => .true
    | .false => buildsEs bs
  | .prim _ as => buildsEs as
  | _ => .false
def buildsEs : ETms → Bool
  | .nil => .false
  | .cons t rest => match buildsE t with
    | .true => .true
    | .false => buildsEs rest
end
mutual
-- the variables (levels) `t` consumes, added to `acc`
def consumed (sigs : StrMap (List Bool)) (d : Nat) (t : ETm) (acc : List Nat) : List Nat := match t with
  | .var i => match Nat.lt i d with
    | .true => lvIns (d - 1 - i) acc
    | .false => acc
  | .app f a => match spineE f (.cons a .nil) with
    | .mk h args => match h with
      | .glob g =>
        let sig := StrMap.findD sigs (Str.ofString g) .nil;
        match Nat.le (lenL sig) (lenL args) with
        | .true => consumedArgs sigs d sig args acc
        | .false => consumedArgs sigs d .nil args acc
      | _ => consumedArgs sigs d .nil args (consumed sigs d h acc)
  | .proj _ _ => match projRoot t with
    | .var _ => acc
    | root => consumed sigs d root acc
  -- (a variable matched on where a branch builds an object is owned: its cell may be
  -- reused, as Lean's borrow inference counts a `reset`)
  | .case s bs => consumedEs sigs d bs (match projRoot s with
    | .var j => match Bool.and (Nat.lt j d) (buildsEs bs) with
      | .true => lvIns (d - 1 - j) acc
      | .false => acc
    | _ => consumed sigs d s acc)
  | .letE v b => consumed sigs (d + 1) b (consumed sigs d v acc)
  | .lam _ => capLevels d (freeE t .nil) acc
  | .obj _ fs => consumedEs sigs d fs acc
  | .prim _ as => consumedEs sigs d as acc
  | _ => acc
def consumedArgs (sigs : StrMap (List Bool)) (d : Nat) (sig : List Bool) (ts : List ETm) (acc : List Nat) : List Nat := match ts with
  | .nil => acc
  | .cons t rest => match headB sig with
    | .true => match t with
      | .var _ => consumedArgs sigs d (tailB sig) rest acc
      | _ => consumedArgs sigs d (tailB sig) rest (consumed sigs d t acc)
    | .false => consumedArgs sigs d (tailB sig) rest (consumed sigs d t acc)
def consumedEs (sigs : StrMap (List Bool)) (d : Nat) (ts : ETms) (acc : List Nat) : List Nat := match ts with
  | .nil => acc
  | .cons t rest => consumedEs sigs d rest (consumed sigs d t acc)
def capLevels (d : Nat) (cs : List Nat) (acc : List Nat) : List Nat := match cs with
  | .nil => acc
  | .cons c rest => match Nat.lt c d with
    | .true => capLevels d rest (lvIns (d - 1 - c) acc)
    | .false => capLevels d rest acc
end
-- parameters `i … k-1` (level `i` is parameter `i`): borrowed unless consumed
def borSig (used : List Nat) : Nat → Nat → List Bool
  | _, .zero => .nil
  | i, .succ m => .cons (Bool.not (lvMem i used)) (borSig used (i + 1) m)
def allTrue : Nat → List Bool
  | .zero => .nil
  | .succ m => .cons .true (allTrue m)
def allFalse : Nat → List Bool
  | .zero => .nil
  | .succ m => .cons .false (allFalse m)
def countTrue : List Bool → Nat
  | .nil => 0
  | .cons b rest => match b with
    | .true => countTrue rest + 1
    | .false => countTrue rest
inductive SigR where
  | mk (sigs : StrMap (List Bool)) (borrowed : Nat)
def sigsInit : StrMap (List Bool) → List Erased → StrMap (List Bool)
  | m, .nil => m
  | m, .cons (.mk n e) rest => sigsInit (StrMap.insert m (Str.ofString n) (allTrue (lamsOf e))) rest
-- **Tail calls kept** (as Lean's `preserveTailCall`): a function calling itself in tail
-- position with a borrowed parameter given something it would release after the call
-- (a variable it owns, or a temporary) makes that parameter owned, so that nothing
-- follows the call. `sig`: the function's signature from this round's `consumed` (not
-- the previous round's, which would make the fixed point oscillate); `k` its arity;
-- the result: the positions to make owned.
def nthB : List Bool → Nat → Bool
  | .nil, _ => .false
  | .cons b rest, n => match n with
    | .zero => b
    | .succ m => nthB rest m
-- the borrowed positions given anything but one of the function's borrowed parameters
def tailArgPos (sig : List Bool) (k d : Nat) : Nat → List ETm → List Nat → List Nat
  | _, .nil, acc => acc
  | i, .cons a rest, acc => tailArgPos sig k d (i + 1) rest (match nthB sig i with
    | .true => match a with
      | .var j => match Bool.and (Nat.lt j d) (Nat.lt (d - 1 - j) k) with
        | .true => match nthB sig (d - 1 - j) with
          | .true => acc
          | .false => lvIns i acc
        | .false => lvIns i acc
      | _ => lvIns i acc
    | .false => acc)
mutual
def tailOwned (sig : List Bool) (f : String) (k : Nat) : Nat → ETm → List Nat → List Nat
  | d, .letE _ b, acc => tailOwned sig f k (d + 1) b acc
  | d, .case _ bs, acc => tailOwnedEs sig f k d bs acc
  | d, .app g0 a0, acc => match spineE (.app g0 a0) .nil with
    | .mk h args => match h with
      | .glob g => match Bool.and (strEq g f) (Nat.beq (lenL args) k) with
        | .true => tailArgPos sig k d 0 args acc
        | .false => acc
      | _ => acc
  | _, _, acc => acc
def tailOwnedEs (sig : List Bool) (f : String) (k : Nat) : Nat → ETms → List Nat → List Nat
  | _, .nil, acc => acc
  | d, .cons t rest, acc => tailOwnedEs sig f k d rest (tailOwned sig f k d t acc)
end
-- `sig` with the positions in `ps` owned
def ownAt : List Bool → Nat → List Nat → List Bool
  | .nil, _, _ => .nil
  | .cons b rest, i, ps => .cons (match lvMem i ps with
      | .true => .false
      | .false => b) (ownAt rest (i + 1) ps)
-- one round: every function's parameters, from the current signatures
def sigsRound (old : StrMap (List Bool)) : StrMap (List Bool) → Nat → List Erased → SigR
  | m, c, .nil => .mk m c
  | m, c, .cons (.mk n e) rest =>
    let k := lamsOf e;
    let sig0 := borSig (consumed old k (underLams k e) .nil) 0 k;
    let sig := ownAt sig0 0 (tailOwned sig0 n k k (underLams k e) .nil);
    sigsRound old (StrMap.insert m (Str.ofString n) sig) (c + countTrue sig) rest
partial def sigsFix (sigs : StrMap (List Bool)) (count : Nat) (es : List Erased) : StrMap (List Bool) :=
  match sigsRound sigs sigs 0 es with
  | .mk s2 c2 => match Nat.beq c2 count with
    | .true => s2
    | .false => sigsFix s2 c2 es
-- the levels of the borrowed parameters, and the indices of the owned ones (as names
-- index them: parameter `i` of `k` is index `k-1-i`)
def borLevels : Nat → List Bool → List Nat
  | _, .nil => .nil
  | i, .cons b rest => match b with
    | .true => lvIns i (borLevels (i + 1) rest)
    | .false => borLevels (i + 1) rest
def ownedIdx (k : Nat) : Nat → List Bool → List Nat
  | _, .nil => .nil
  | i, .cons b rest => match b with
    | .true => ownedIdx k (i + 1) rest
    | .false => .cons (k - 1 - i) (ownedIdx k (i + 1) rest)
-- the wrapper releases the borrowed arguments after the call
def wrapDecs : Nat → List Bool → String
  | _, .nil => ""
  | i, .cons b rest => match b with
    | .true => "dec(a[" +++ Nat.toString i +++ "]); " +++ wrapDecs (i + 1) rest
    | .false => wrapDecs (i + 1) rest

-- **Unmemoised hypotheses** (reference counting mode). The method of an `ind` receives
-- its hypotheses as a chain of suspensions (`T_HYP`: a cell and a closure per recursive
-- field, each computed once when first read). When the method reads them only as
-- hypotheses (paths `hs.1ʲ.0`, never `hs` or a tail passed on) and either reads each at
-- most once on every path, not under a `λ`, or is itself a `λ` (a function-valued
-- motive: a read then only rebuilds a closure), memoising buys nothing: `indv` passes
-- a view of the payload instead (one object per call) and a read `hypAt hs j` computes
-- the `j`-th hypothesis where it stands (rt.c `p_hypAt`).
-- `proj 1ʲ (var c)`: `j`
def hypTail (c : Nat) : ETm → Option Nat
  | .var i => match Nat.beq i c with
    | .true => .some 0
    | .false => .none
  | .proj k t => match Nat.beq k 1 with
    | .true => match hypTail c t with
      | .some j => .some (j + 1)
      | .none => .none
    | .false => .none
  | _ => .none
def hypRead (c j : Nat) : ETm := .prim "hypAt" (etms2 (.var c) (.nat j))
-- a read `hypAt (var c) j`: `j`
def hypReadOf (c : Nat) (t : ETm) : Option Nat := match t with
  | .prim op as => match strEq op "hypAt" with
    | .true => match as with
      | .cons v rest => match v with
        | .var i => match Nat.beq i c with
          | .true => match rest with
            | .cons n _ => match n with
              | .nat j => .some j
              | _ => .none
            | .nil => .none
          | .false => .none
        | _ => .none
      | .nil => .none
    | .false => .none
  | _ => .none
mutual
-- the reads of the hypotheses `hs` (the variable `c`) rewritten, if `hs` is used only so
def hypRw (c : Nat) (t : ETm) : Option ETm := match t with
  | .var i => match Nat.beq i c with
    | .true => .none
    | .false => .some t
  | .proj k x => match Nat.beq k 0 with
    | .true => match hypTail c x with
      | .some j => .some (hypRead c j)
      | .none => match hypRw c x with
        | .some x' => .some (.proj k x')
        | .none => .none
    | .false => match hypRw c x with
      | .some x' => .some (.proj k x')
      | .none => .none
  | .lam b => match hypRw (c + 1) b with
    | .some b' => .some (.lam b')
    | .none => .none
  | .app f a => match hypRw c f with
    | .some f' => match hypRw c a with
      | .some a' => .some (.app f' a')
      | .none => .none
    | .none => .none
  | .letE v b => match hypRw c v with
    | .some v' => match hypRw (c + 1) b with
      | .some b' => .some (.letE v' b')
      | .none => .none
    | .none => .none
  | .obj k fs => match hypRwEs c fs with
    | .some fs' => .some (.obj k fs')
    | .none => .none
  | .case s bs => match hypRw c s with
    | .some s' => match hypRwEs c bs with
      | .some bs' => .some (.case s' bs')
      | .none => .none
    | .none => .none
  | .prim op as => match hypRwEs c as with
    | .some as' => .some (.prim op as')
    | .none => .none
  | _ => .some t
def hypRwEs (c : Nat) (ts : ETms) : Option ETms := match ts with
  | .nil => .some .nil
  | .cons t rest => match hypRw c t with
    | .some t' => match hypRwEs c rest with
      | .some r' => .some (.cons t' r')
      | .none => .none
    | .none => .none
end
mutual
-- the hypotheses read (`j`s, with repeats)
def hypJs (c : Nat) (t : ETm) (acc : List Nat) : List Nat := match hypReadOf c t with
  | .some j => .cons j acc
  | .none => match t with
    | .lam b => hypJs (c + 1) b acc
    | .app f a => hypJs c f (hypJs c a acc)
    | .letE v b => hypJs c v (hypJs (c + 1) b acc)
    | .obj _ fs => hypJsEs c fs acc
    | .proj _ x => hypJs c x acc
    | .case s bs => hypJs c s (hypJsEs c bs acc)
    | .prim _ as => hypJsEs c as acc
    | _ => acc
def hypJsEs (c : Nat) (ts : ETms) (acc : List Nat) : List Nat := match ts with
  | .nil => acc
  | .cons t rest => hypJs c t (hypJsEs c rest acc)
end
mutual
-- the reads of hypothesis `j` as the variable `c` itself, the other reads `◾` (to count
-- them with `dmdA`)
def hypOnly (c j : Nat) (t : ETm) : ETm := match hypReadOf c t with
  | .some j' => match Nat.beq j j' with
    | .true => .var c
    | .false => .erased
  | .none => match t with
    | .lam b => .lam (hypOnly (c + 1) j b)
    | .app f a => .app (hypOnly c j f) (hypOnly c j a)
    | .letE v b => .letE (hypOnly c j v) (hypOnly (c + 1) j b)
    | .obj k fs => .obj k (hypOnlyEs c j fs)
    | .proj k x => .proj k (hypOnly c j x)
    | .case s bs => .case (hypOnly c j s) (hypOnlyEs c j bs)
    | .prim op as => .prim op (hypOnlyEs c j as)
    | _ => t
def hypOnlyEs (c j : Nat) (ts : ETms) : ETms := match ts with
  | .nil => .nil
  | .cons t rest => .cons (hypOnly c j t) (hypOnlyEs c j rest)
end
-- each hypothesis read at most once on every path, not under a `λ` (`body` under the
-- method's three `λ`s: `hs` is level 2)
def hypsOnce (body : ETm) : List Nat → Bool
  | .nil => .true
  | .cons j rest => match Nat.lt 1 (Dmd.n (denvAt 2 (dmdA 3 (hypOnly 0 j body)))) with
    | .true => .false
    | .false => hypsOnce body rest
-- the method `λ i pl hs. body` with its reads rewritten, if it may take a view
def viewMethod (m : ETm) : Option ETm := match m with
  | .lam m1 => match m1 with
    | .lam m2 => match m2 with
      | .lam body => match hypRw 0 body with
        | .some body' =>
          let ok := match body with
            | .lam _ => .true
            | _ => hypsOnce body' (hypJs 0 body' .nil);
          match ok with
          | .true => .some (.lam (.lam (.lam body')))
          | .false => .none
        | .none => .none
      | _ => .none
    | _ => .none
  | _ => .none
mutual
def indvE (t : ETm) : ETm := match t with
  | .prim op as => match strEq op "ind" with
    | .true => match indvEs as with
      | .cons nat r1 => match r1 with
        | .cons D r2 => match r2 with
          | .cons m r3 => match viewMethod m with
            | .some m' => .prim "indv" (.cons nat (.cons D (.cons m' r3)))
            | .none => .prim op (.cons nat r1)
          | .nil => .prim op (.cons nat r1)
        | .nil => .prim op (.cons nat r1)
      | .nil => .prim op .nil
    | .false => .prim op (indvEs as)
  | .lam b => .lam (indvE b)
  | .app f a => .app (indvE f) (indvE a)
  | .letE v b => .letE (indvE v) (indvE b)
  | .obj k fs => .obj k (indvEs fs)
  | .proj i x => .proj i (indvE x)
  | .case s bs => .case (indvE s) (indvEs bs)
  | _ => t
def indvEs (ts : ETms) : ETms := match ts with
  | .nil => .nil
  | .cons t rest => .cons (indvE t) (indvEs rest)
end
def indvGlobals : List Erased → List Erased
  | .nil => .nil
  | .cons (.mk n e) rest => .cons (.mk n (indvE e)) (indvGlobals rest)

-- the same under reference counting: a constant global is built by `init_g` and kept
-- (a root, released at exit); `get_g()` returns a new reference
def genCodeRC (sigs : StrMap (List Bool)) : CG → List Doc → List Doc → List Erased → Code
  | st, protos, defs, .nil => .mk protos defs st
  | st, protos, defs, .cons (.mk n e) rest =>
    let g := mangle n;
    let k := lamsOf e;
    match k with
    | .zero => match rcHead (.mk .nil sigs .nil) st .nil 0 .nil .nil e with
      | .mk code atom _ st1 =>
        genCodeRC sigs st1 (.cons (.t ("V get_" +++ g +++ "(void);")) protos)
          (.cons (.t ("static V g_" +++ g +++ "; static int i_" +++ g +++ "; static V init_" +++ g +++ "(void) { ") ⧺ code ⧺
            .t "return " ⧺ atom ⧺ .t ("; } V get_" +++ g +++ "(void) { if (!i_" +++ g +++ ") { g_" +++ g +++ " = init_" +++ g +++
            "(); i_" +++ g +++ " = 1; rt_root(&g_" +++ g +++ "); } inc(g_" +++ g +++ "); return g_" +++ g +++ "; }")) defs) rest
    | .succ _ =>
      let names := paramNames k k;
      -- (no signature: every parameter owned)
      let sig := match StrMap.findD sigs (Str.ofString n) .nil with
        | .nil => allFalse k
        | sg => sg;
      match rcHead (.mk (borLevels 0 sig) sigs .nil) st names k .nil .nil (markSelf n k sig (borLevels 0 sig) k (underLams k e)) with
      | .mk code atom live st1 =>
        let ps := paramDecls 0 k;
        genCodeRC sigs st1 (.cons (.t ("V d_" +++ g +++ "(" +++ ps +++ "); V get_" +++ g +++ "(void);")) protos)
          (.cons (.t ("V d_" +++ g +++ "(" +++ ps +++ ") { top_: ; ") ⧺ entryDrops names k live (ownedIdx k 0 sig) ⧺ code ⧺ .t "return " ⧺ atom ⧺ .t "; }") (.cons
            (.t ("static V w_" +++ g +++ "(V *a) { V r = d_" +++ g +++ "(" +++ argList 0 k +++ "); " +++ wrapDecs 0 sig +++ "return r; } " +++
             "V get_" +++ g +++ "(void) { static V c = 0; if (!c) { c = native(w_" +++ g +++ ", " +++ Nat.toString k +++
             "); rt_root(&c); } inc(c); return c; }")) defs)) rest
def genProgramRC (lib : Bool) (borrow : Bool) (gs : Globals) : List Doc := match gs with
  | .mk all _ _ ffi => match eraseGlobals .true ffi all .nil .nil (Array.size all) with
    | .err m => .cons (.t ("#error " +++ m)) .nil
    | .ok es0 =>
      let es1 := pushGlobals es0;
      let es := indvGlobals (decideGlobals (inlGlobals (caseMap (consMap StrMap.empty es1) es1) es1));
      let sigs : StrMap (List Bool) := match borrow with
        | .true => sigsFix (sigsInit StrMap.empty es) 0 es
        | .false => StrMap.empty;
      match genCodeRC sigs (.mk .nil 0 (arities (ffiArities StrMap.empty ffi) es) .idle .nil) .nil .nil es with
      | .mk protos defs st => match st with
        | .mk fns _ _ _ _ =>
          List.append (linkDocs (List.reverseOf ffi .nil)) (.cons (.t "#define WIZ_RC 1") (.cons (.t "#include \"rt.c\"") (List.append (ffiDocs .true ffi) (List.append protos
            (List.append (List.reverseOf fns .nil) (List.append defs (List.append (exportDocs .true (List.reverseOf ffi .nil))
              (mainDocs lib "int main(int argc, char **argv) { (void)argc; rt_start(argv); dec(ap(get_main(), BOX(0))); rt_finish(); return 0; }"))))))))

-- The backend a program asks for: reference counting if its first line is `-- wiz: rc`,
-- else the garbage collector. (A command-line flag, once programs can read their
-- arguments.)
def charsPrefix : List Char → List Char → Bool
  | .nil, _ => .true
  | .cons c cs, ys => match ys with
    | .nil => .false
    | .cons y rest => match Nat.beq (Char.code c) (Char.code y) with
      | .true => charsPrefix cs rest
      | .false => .false
def wantsRC (text : String) : Bool := match text with
  | .mk cs => match "-- wiz: rc" with
    | .mk ps => charsPrefix ps cs
-- (`-- wiz: rc-owned`: every parameter owned, no borrowing; for comparisons)
def genProgramFor (lib : Bool) (text : String) (gs : Globals) : List Doc := match wantsRC text with
  | .true => genProgramRC lib (match text with
    | .mk cs => match "-- wiz: rc-owned" with
      | .mk ps => Bool.not (charsPrefix ps cs)) gs
  | .false => genProgram lib gs
-- (stage 21k) the backend the command line asks for: `--rc` (reference counting),
-- `--rc-owned` (every parameter owned, no borrowing) or `--gc`; without one, the first
-- line's pragma (`genProgramFor`, kept as a fallback for one release). (Stage 21s)
-- `--lib` or `--no-main`: the program without a C `main` (its exports, for C code to
-- call); `--header`: instead of the C, the header of the exports (`wiz build --lib`'s
-- `.h`).
def genProgramArgs (args : List String) (text : String) (gs : Globals) : List Doc :=
  let lib := Bool.or (elemStr "--lib" args) (elemStr "--no-main" args);
  match elemStr "--header" args with
  | .true => headerDocs (Globals.ffi gs)
  | .false => match elemStr "--rc-owned" args with
  | .true => genProgramRC lib .false gs
  | .false => match elemStr "--rc" args with
    | .true => genProgramRC lib .true gs
    | .false => match elemStr "--gc" args with
      | .true => genProgram lib gs
      | .false => genProgramFor lib text gs

-- printing a program: each line's pieces, then a newline
def printDoc : Doc → IO Unit
  | .t s => IO.print s
  | .c a b => do
    printDoc a;
    printDoc b
def printDocs : List Doc → IO Unit
  | .nil => IO.pure ()
  | .cons d rest => do
    printDoc d;
    IO.println "";
    printDocs rest

-- (stage 21t) The `link_c` files that don't exist, each the error of `command.linkC`, in
-- order. The frontend is pure, so the driver checks them before it prints the C (as the
-- Lean command line resolves the paths before elaboration); a path is relative to the
-- input's directory, the working directory. (`access` is 0 for a file that exists.)
extern "access" (header := "unistd.h") cAccessFails : String → Nat → IO Bool
def missingLinks : List Foreign → IO (List String)
  | .nil => IO.pure .nil
  | .cons f rest => IO.bind (missingLinks rest) (fun more => match f with
    | .link p lib => (match lib with
      | .true => IO.pure more
      | .false => IO.bind (cAccessFails p 0) (fun bad => IO.pure (match bad with
        | .true => List.cons (String.append "error: link_c: no file " (String.append p " (paths are relative to the .wiz file)")) more
        | .false => more)))
    | _ => IO.pure more)
