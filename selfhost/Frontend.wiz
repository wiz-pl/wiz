-- From text to a checked term, all in Wiz (stage 14b): the lexer and parser read the
-- full Wiz grammar, and this scope checker turns the syntax of a few term forms into
-- the kernel's `Tm` (names become de Bruijn indices), which `Kernel.wiz` type checks.
-- Load it after `Lex.wiz`, `Parse.wiz` and `Kernel.wiz`.
--
-- Supported: identifiers, `Type n`, `(x : A) → B`, `A → B`, `fun x (y : A) => b` (the
-- binder types are not kept: a λ is checked against a type), application,
-- `let x : A := v; b`, `(t : T)` and parentheses; and (stage 16) inductive types.

-- the arguments of a node, as a list
def argsOf : SyntaxF .false → List Syntax
  | .nil => .nil
  | .cons s rest => .cons s (argsOf rest)
def kids : Syntax → List Syntax
  | .node _ args => argsOf args
  | _ => .nil
def kid (s : Syntax) (i : Nat) : Syntax := Syntax.getArg s i
def kindOf : Syntax → String
  | .node k _ => k
  | _ => ""
def is (s : Syntax) (k : String) : Bool := strEq (kindOf s) k
-- the universe parameters written after a command's name (`def f.{u, v} …`): the
-- grammar's second child is `.{ … }`, whose second child is the list
def levelParamNames : List Syntax → List String
  | .nil => .nil
  | .cons x rest => match x with
    | .ident n => .cons n (levelParamNames rest)
    | _ => levelParamNames rest
def univParamsOf (cmd : Syntax) : List String := levelParamNames (kids (kid (kid cmd 2) 1))
def hasUnivParams : List String → Bool
  | .nil => .false
  | .cons _ _ => .true

def digits : List Char → Nat → Nat
  | .nil, acc => acc
  | .cons c cs, acc => digits cs (Nat.add (Nat.mul acc 10) (Char.code c - 48))

def indexOf : List String → String → Nat → Option Nat
  | .nil, _, _ => .none
  | .cons n ns, x, i => match strEq n x with
    | .true => .some i
    | .false => indexOf ns x (i + 1)

-- (stage 21n) `private` names are module-scoped. A private declaration `x` of module
-- `M` gets the kernel name `_private.M._0.x` (as the Lean toolchain names them), so two
-- modules' private `x`s are different constants (the kernel compares constants by
-- name) and never clash; a source name is resolved to the current module's private
-- declaration first, then to a public one. `privSplit` reads such a kernel name back.
def matchPrefix : List Char → List Char → Option (List Char)
  | .nil, rest => .some rest
  | .cons a as, .cons b bs => match Nat.beq (Char.code a) (Char.code b) with
    | .true => matchPrefix as bs
    | .false => .none
  | _, .nil => .none
def reverseChars : List Char → List Char → List Char
  | .nil, acc => acc
  | .cons c cs, acc => reverseChars cs (.cons c acc)
-- a kernel name's module and source name
inductive Mangled where
  | mk (mod base : String)
def privPrefixChars : List Char := match "_private." with
  | .mk cs => cs
def dotZeroChars : List Char := match "._0." with
  | .mk cs => cs
-- the rest after `._0.`, as (module, base)
def spliceDotZero : List Char → List Char → Option Mangled
  | _, .nil => .none
  | acc, .cons c cs => match matchPrefix dotZeroChars (.cons c cs) with
    | .some after => .some (.mk (String.mk (reverseChars acc .nil)) (String.mk after))
    | .none => spliceDotZero (.cons c acc) cs
def privSplit (x : String) : Option Mangled := match x with
  | .mk cs => match matchPrefix privPrefixChars cs with
    | .some rest => spliceDotZero .nil rest
    | .none => .none
-- the kernel name of a private declaration `x` of module `m`
def privName (m x : String) : String := "_private." +++ m +++ "._0." +++ x
-- (`privBase`, a kernel name's source name, is in `Kernel.wiz`: `show` needs it)
-- the module a private kernel name belongs to
def privMod (x : String) : Option String := match privSplit x with
  | .some (.mk m _) => .some m
  | .none => .none

-- a private declaration, for the "private to module" diagnostic: its source name and
-- its module
inductive PrivName where
  | mk (name mod : String)
-- a name's resolution: found (an index), not declared, or another module's private name
inductive Lookup where
  | ok (i : Nat)
  | missing
  | privTo (mod : String)
-- the names in scope: the local binders (innermost first, with their number), the
-- globals by kernel name (each with its position plus one; there are `count`), a marker
-- for every source name declared in each module (a source name is declared at most once
-- per module, private or not: `Scope.declaredIn`), the private declarations (for the
-- diagnostic), and the module being checked (`Scope.cur`)
inductive Scope where
  | mk (locals : List String) (depth : Nat) (globals : StrMap Nat) (names : StrMap Nat)
      (privs : List PrivName) (cur : String) (count : Nat)
def Scope.empty : Scope := .mk .nil 0 StrMap.empty StrMap.empty .nil "" 0
def Scope.bind (sc : Scope) (x : String) : Scope := match sc with
  | .mk ls d gs nms pvs cur n => .mk (.cons x ls) (d + 1) gs nms pvs cur n
-- the module being checked (`private` is module-scoped)
def Scope.setModule (sc : Scope) (m : String) : Scope := match sc with
  | .mk ls d gs nms pvs _ n => .mk ls d gs nms pvs m n
def Scope.cur : Scope → String
  | .mk _ _ _ _ _ c _ => c
def nameKey (m x : String) : String := "module:" +++ m +++ ":" +++ x
-- whether the source name `x` was declared in the module `m`
def Scope.declaredIn (sc : Scope) (m x : String) : Bool := match sc with
  | .mk _ _ _ nms _ _ _ => match StrMap.findD nms (Str.ofString (nameKey m x)) 0 with
    | .zero => .false
    | _ => .true
-- `key` is the kernel name (mangled when private), `x` the source name
def Scope.addGlobal (sc : Scope) (key x : String) (m : String) (priv : Bool) : Scope := match sc with
  | .mk ls d gs nms pvs cur n =>
    let pvs' := match priv with
      | .true => .cons (.mk x m) pvs
      | .false => pvs;
    .mk ls d (StrMap.insert gs (Str.ofString key) (n + 1))
      (StrMap.insert nms (Str.ofString (nameKey m x)) 1) pvs' cur (n + 1)
-- the global with the kernel name `key` (a closed scope, like `Globals.scope`), by its
-- position from the latest: for the internals that read a term's constant name
def Scope.find (sc : Scope) (key : String) : Option Nat := match sc with
  | .mk _ _ gs _ _ _ n => match StrMap.findD gs (Str.ofString key) 0 with
    | .zero => .none
    | .succ p => .some (n - 1 - p)
-- a private declaration of `x` in a module other than `cur`
def privOwner : List PrivName → String → String → Option String
  | .nil, _, _ => .none
  | .cons (.mk y m) rest, x, cur => match Bool.and (strEq y x) (Bool.not (strEq m cur)) with
    | .true => .some m
    | .false => privOwner rest x cur
-- (A12 hygiene) a macro-introduced identifier is `x✝N`; `stripScope` is the `x` a
-- global is looked up as, as the Leans host's `Elab.stripScope` (a local variable keeps
-- its scope, so a template's binders cannot capture a user's)
def stripScopeChars : List Char → List Char
  | .nil => .nil
  | .cons c cs => match Nat.beq (Char.code c) 10013 with
    | .true => .nil
    | .false => .cons c (stripScopeChars cs)
def stripScope (n : String) : String := match n with
  | .mk cs => .mk (stripScopeChars cs)
-- a name as written: a local binder, else the current module's private declaration of
-- it, else the public one (so a public name shadows another module's private name).
-- A kernel name written out (`_private.M._0.x`, from a term's constant) is visible only
-- to module M.
def lookupExact (sc : Scope) (x : String) : Lookup := match sc with
  | .mk ls d gs _ pvs cur n => match indexOf ls x 0 with
    | .some i => .ok i
    | .none => match StrMap.findD gs (Str.ofString (privName cur x)) 0 with
      | .succ p => .ok (d + (n - 1 - p))
      | .zero => match StrMap.findD gs (Str.ofString x) 0 with
        | .succ p => match privMod x with
          | .some m => match strEq m cur with
            | .true => .ok (d + (n - 1 - p))
            | .false => .privTo m
          | .none => .ok (d + (n - 1 - p))
        | .zero => match privOwner pvs x cur with
          | .some m => .privTo m
          | .none => .missing
def Scope.lookupV (sc : Scope) (x : String) : Lookup := match lookupExact sc x with
  | .missing => match strEq (stripScope x) x with
    -- (a macro's template introduced `x`; the scope-free name is the global it means)
    | .true => .missing
    | .false => lookupExact sc (stripScope x)
  | r => r
-- a name's index (none for another module's private name): a local binder's, or past
-- them a global's (the latest is the nearest)
def Scope.lookup (sc : Scope) (x : String) : Option Nat := match Scope.lookupV sc x with
  | .ok i => .some i
  | _ => .none

inductive Elab where
  | ok (t : Tm)
  | err (msg : String)

-- the names a binder introduces, and its type (if any)
-- the non-atom children (a `sepBy` list without its separators)
def nonAtomsS : List Syntax → List Syntax
  | .nil => .nil
  | .cons s rest => match s with
    | .atom _ => nonAtomsS rest
    | _ => .cons s (nonAtomsS rest)
def identNames : List Syntax → List String
  | .nil => .nil
  | .cons s rest => .cons (match s with
      | .ident n => n
      | _ => "_") (identNames rest)
-- (A11) the names of a `sepBy1` list (`C₁, C₂`): the `,` atoms are separators, not names
def sepIdentNames (xs : List Syntax) : List String := identNames (nonAtomsS xs)
-- (A10) a binder's kind, as the Lean frontend's `BinderInfo`: explicit, implicit
-- (`{x : A}`), or instance (`[i : C A]`, resolved by `resolveInstances`). The mask of a
-- global is one kind per parameter, and an `inst` binder inserts a class problem.
inductive BKind where
  | dflt
  | impl
  | inst
def instKinds : Nat → List BKind
  | .zero => .nil
  | .succ k => .cons .inst (instKinds k)
def isInstB (b : Syntax) : Bool := strEq (kindOf b) "binder.inst"
def implKinds : Nat → List BKind
  | .zero => .nil
  | .succ k => .cons .impl (implKinds k)
def dfltKinds : Nat → List BKind
  | .zero => .nil
  | .succ k => .cons .dflt (dfltKinds k)
def isImplK : BKind → Bool
  | .impl => .true
  | _ => .false
def binderNames (b : Syntax) : List String := match b with
  | .ident n => .cons n .nil
  | _ => match strEq (kindOf b) "term.hole" with
    | .true => .cons "_" .nil
    | .false => match isInstB b with
      -- `[x : C A]` names `x`; `[C A]` gets a deterministic name (de Bruijn resolution
      -- handles shadowing)
      | .true => match kids (kid b 1) with
        | .cons (.ident n) _ => .cons n .nil
        | _ => .cons "inst✝" .nil
      | .false => identNames (kids (kid b 2))
-- (an instance binder's type is at 2, the other binders' after their `:`)
def binderType (b : Syntax) : Option Syntax := match isInstB b with
  | .true => .some (kid b 2)
  | .false => match kids (kid b 3) with
    | .cons _ (.cons t _) => .some t
    | _ => .none

-- Quantities (stage 21m), as `elabQuantity` in the Lean elaborator: a binder's written
-- quantity (`(1 x : A)`, `{0 A : Type}`, `(ω f : …)`), or its default: ω on an explicit
-- binder, 0 on an implicit one. A written quantity is the optional `quantity` node
-- (`num`, `ω`, or `%t`); `bad` for one this frontend can't read (`%t`, a numeral other
-- than 0 or 1), which is an error (`qtyErr`) wherever it is written.
inductive QW where
  | dflt
  | is (q : Q)
  | bad
def qtyNode (q : Syntax) : QW := match kid q 0 with
  | .atom v => match strEq v "ω" with
    | .true => .is .qw
    | .false => .bad
  | n => match kid n 0 with
    | .atom d => match d with
      | .mk cs => match digits cs 0 with
        | .zero => .is .qz
        | .succ k => match k with
          | .zero => .is .qo
          | .succ _ => .bad
    | _ => .bad
-- the written quantity in an optional `quantity` (a `null` node)
def writtenQ (qs : Syntax) : QW := match kids qs with
  | .cons q _ => qtyNode q
  | .nil => .dflt
def qtyErr : String := "a quantity must be 0, 1 or ω (quantity terms %t are not supported by the self-hosted frontend)"
def isImplicitB (b : Syntax) : Bool := strEq (kindOf b) "binder.implicit"
-- a binder's written quantity (`dflt` for a bare name, a hole, an instance binder)
def binderW (b : Syntax) : QW := match b with
  | .ident _ => .dflt
  | _ => match Bool.or (strEq (kindOf b) "binder.explicit") (isImplicitB b) with
    | .true => writtenQ (kid b 1)
    | .false => .dflt
-- a binder's quantity, the default filled in
def binderQ (b : Syntax) : Option Q := match binderW b with
  | .is q => .some q
  | .dflt => .some (match isImplicitB b with
    | .true => .qz
    | .false => .qw)
  | .bad => .none
def qsFor (q : Q) : List String → List Q
  | .nil => .nil
  | .cons _ xs => .cons q (qsFor q xs)
def wsFor (w : QW) : List String → List QW
  | .nil => .nil
  | .cons _ xs => .cons w (wsFor w xs)
-- the quantities of a list of binders, one per name (as `paramMask`); `none` if one is bad
def binderQs : List Syntax → Option (List Q)
  | .nil => .some .nil
  | .cons b bs => match binderQ b with
    | .none => .none
    | .some q => match binderQs bs with
      | .none => .none
      | .some qs => .some (List.append (qsFor q (binderNames b)) qs)
-- the written quantities of a list of binders, one per name (`fun`'s binders)
def binderWs : List Syntax → List QW
  | .nil => .nil
  | .cons b bs => List.append (wsFor (binderW b) (binderNames b)) (binderWs bs)
def qName : Q → String
  | .qz => "0"
  | .qo => "1"
  | .qw => "ω"
def headQ : List Q → Q
  | .nil => .qw
  | .cons q _ => q
def tailQ : List Q → List Q
  | .nil => .nil
  | .cons _ qs => qs

-- all the names of a `fun`'s binders
def binders : List Syntax → List String
  | .nil => .nil
  | .cons b bs => List.append (binderNames b) (binders bs)

-- a term's universe from its level: `Type 0` is `U 0` (and `Sort 0` is `Prop`); a level
-- that is not a closed number stays a `sortL`, so a declaration's parameters stay symbolic
def lvlTypeTm (l : Lvl) : Tm := match lvlClosed l with
  | .some n => .univ n
  | .none => .sortL (.lsucc l)
def lvlTypeSort (l : Lvl) : Val := match lvlClosed l with
  | .some n => .vsort (.lnum (n + 2))
  | .none => .vsort (.lsucc (.lsucc l))
def lvlSortTm (l : Lvl) : Tm := match lvlClosed l with
  | .some n => match n with
    | .zero => .prop
    | .succ m => .univ m
  | .none => .sortL l
def lvlSortSort (l : Lvl) : Val := match lvlClosed l with
  | .some n => .vsort (.lnum (n + 1))
  | .none => .vsort (.lsucc l)
-- a level in the scope-checked path (`elab` below, inductive and structure fields): a
-- parameter is taken as written (the declaration check rejects one it does not declare)
-- and `_` is left a hole (there is no metavariable state here)
partial def lvlNumSyntax (s : Syntax) : Nat := match s with
  | .atom d => match d with
    | .mk cs => digits cs 0
  | .node _ _ => lvlNumSyntax (kid s 0)
  | _ => 0
def addLvlSyntax : Lvl → Nat → Lvl
  | l, .zero => l
  | l, .succ n => .lsucc (addLvlSyntax l n)
partial def levelSyntax (s : Syntax) : Lvl :=
  let k := kindOf s;
  match strEq k "level.num" with
  | .true => .lnum (lvlNumSyntax s)
  | .false => match strEq k "level.param" with
    | .true => match kid s 0 with
      | .ident u => .lparam u
      | _ => .lnum 0
    | .false => match strEq k "level.hole" with
      | .true => .lhole
      | .false => match strEq k "level.paren" with
        | .true => levelSyntax (kid s 1)
        | .false => match strEq k "level.max" with
          | .true => .lmax (levelSyntax (kid s 1)) (levelSyntax (kid s 2))
          | .false => match strEq k "level.imax" with
            | .true => .limax (levelSyntax (kid s 1)) (levelSyntax (kid s 2))
            | .false => match strEq k "level.add" with
              | .true => addLvlSyntax (levelSyntax (kid s 0)) (lvlNumSyntax (kid s 2))
              | .false => .lnum 0
def levelArgSyntax (s : Syntax) (dflt : Lvl) : Lvl := match kids (kid s 1) with
  | .nil => dflt
  | .cons l _ => levelSyntax l

-- **Exercise 14.4.** Scope checking: names to indices (`Scope.lookup`, `Scope.bind`).
mutual
def elab : Scope → Syntax → Elab
  --<sol
  | names, .ident n => match Scope.lookupV names n with
    | .ok i => .ok (.var i)
    | .privTo m => .err (("'" +++ privBase n) +++ "' is private to module " +++ m)
    | .missing => match strEq n "Unit" with
      | .true => .ok (.unit 0)
      | .false => .err ("unknown identifier " +++ n)
  | names, s => match strEq (kindOf s) "term.ident" with
    | .true => elab names (kid s 0)
    | .false => match strEq (kindOf s) "term.paren" with
      | .true => elab names (kid s 1)
      | .false => match strEq (kindOf s) "term.ascription" with
        | .true => both names (kid s 1) (kid s 3) (fun t ty => .ann t ty)
        | .false => match strEq (kindOf s) "term.type" with
          | .true => .ok (lvlTypeTm (levelArgSyntax s (.lnum 0)))
          | .false => match strEq (kindOf s) "term.sort" with
          | .true => .ok (lvlSortTm (levelArgSyntax s (.lnum 0)))
          | .false => match strEq (kindOf s) "term.prop" with
          | .true => .ok .prop
          | .false => match strEq (kindOf s) "term.arrow" with
            | .true => match elab names (kid s 0) with
              | .ok a => match elab (Scope.bind names "_") (kid s 2) with
                | .ok b => .ok (piH a b)
                | e => e
              | e => e
            | .false => match strEq (kindOf s) "term.depArrow" with
              | .true => match binderQ (kid s 0) with
                | .some q => pis names q (binderNames (kid s 0)) (binderType (kid s 0)) (kid s 2)
                | .none => .err qtyErr
              | .false => match strEq (kindOf s) "term.fun" with
                | .true => lams names (binders (kids (kid s 1))) (kid s 3)
                | .false => match strEq (kindOf s) "term.app" with
                  | .true => match elab names (kid s 0) with
                    | .ok f => apps names f (kids (kid s 1))
                    | e => e
                  | .false => match strEq (kindOf s) "term.let" with
                    | .true => match binderType s with
                      | .none => .err "let needs a type"
                      | .some ty => match elab names ty with
                        | .ok tyT => match elab names (kid s 5) with
                          | .ok v => match kid s 2 with
                            | .ident x => match elab (Scope.bind names x) (kid s 7) with
                              | .ok b => .ok (.letE tyT v b)
                              | e => e
                            | _ => .err "let needs a name"
                          | e => e
                        | e => e
                    | .false => match strEq (kindOf s) "term.prod" with
                      | .true => match elab names (kid s 0) with
                        | .ok a => match elab (Scope.bind names "_") (kid s 2) with
                          | .ok b => .ok (.sigma .qw .lhole .lhole a b)
                          | e => e
                        | e => e
                      -- (Σ types are elaborated by `inferType`; this scope-level path is
                      -- used for the simple type annotations in the C header parser)
                      | .false => .err ("unsupported syntax " +++ kindOf s)
  --|ex
  --| | _, _ => .err "not implemented"
  --sol>
def both : Scope → Syntax → Syntax → (Tm → Tm → Tm) → Elab
  | names, a, b, k => match elab names a with
    | .ok x => match elab names b with
      | .ok y => .ok (k x y)
      | e => e
    | e => e
-- `(x y : A) → B`: one Π per name, `A` read in each one's context
def pis : Scope → Q → List String → Option Syntax → Syntax → Elab
  | names, _, .nil, _, body => elab names body
  | names, q, .cons x xs, ty, body => match ty with
    | .none => .err "a Π needs a binder type"
    | .some a => match elab names a with
      | .ok aT => match pis (Scope.bind names x) q xs ty body with
        | .ok b => .ok (piTm q aT b)
        | e => e
      | e => e
def lams : Scope → List String → Syntax → Elab
  | names, .nil, body => elab names body
  | names, .cons x xs, body => match lams (Scope.bind names x) xs body with
    | .ok b => .ok (.lam b)
    | e => e
def apps : Scope → Tm → List Syntax → Elab
  | _, f, .nil => .ok f
  | names, f, .cons a rest => match elab names a with
    | .ok aT => apps names (.app f aT) rest
    | e => e
end

-- parse, scope check and type check a closed term
def checkText (cats : List Cat) (tokens : List String) (text : String) : String :=
  match parseSyntax cats tokens "term" text with
  | .err m => String.append "parse " m
  | .ok stx => match elab Scope.empty stx with
    | .err m => String.append "scope error: " m
    | .ok t => typeOf t

-- A file of commands (stage 14c): `def x (binders) : T := v`, `#check t` and
-- `#reduce t`. The global definitions are the kernel's constants.

-- binder groups `(x y : A) …` around a result: Π types, each `A` read in its context
mutual
def groupPis : Scope → List Syntax → Syntax → Elab
  | names, .nil, body => elab names body
  | names, .cons b bs, body => match binderType b with
    | .none => .err "the binders of a definition need types"
    | .some a => match binderQ b with
      | .some q => piGroup names q (binderNames b) a bs body
      | .none => .err qtyErr
def piGroup : Scope → Q → List String → Syntax → List Syntax → Syntax → Elab
  | names, _, .nil, _, bs, body => groupPis names bs body
  | names, q, .cons x xs, a, bs, body => match elab names a with
    | .ok aT => match piGroup (Scope.bind names x) q xs a bs body with
      | .ok b => .ok (piTm q aT b)
      | e => e
    | e => e
end

def List.reverseOf {A : Type} : List A → List A → List A
  | .nil, acc => acc
  | .cons x xs, acc => List.reverseOf xs (.cons x acc)

-- (A10) a class: its name and its methods, in field order. The class itself is an
-- ordinary structure (an inductive with one constructor `mk`); a method `C.f` is the
-- projection with an instance binder for its `self` argument.
inductive ClassInfo where
  | mk (methods : List String)
-- (A10) an instance: the class it is for, its global's name, its priority (as
-- `(priority := n)`, 1000 by default) and its declaration order (later first). Two
-- instances may not have definitionally equal types (our duplicate check); so priority
-- does not choose between overlapping candidates yet.
inductive InstInfo where
  | mk (cls : String) (name : String) (prio : Nat) (order : Nat)
-- a global: its name, its universe-level parameters, type, and value as closed terms
-- (other globals are constants in them), its value with every global inlined (for
-- `#reduce`, since `quote` doesn't unfold constants), its parameters' binder kinds, and
-- their names (A9, for named arguments)
inductive Global where
  | mk (name : String) (lparams : List String) (ty val inlined : Tm) (implicits : List BKind) (paramNames : List String)
-- an inductive type (stage 16): its description (with constants, and inlined), and
-- each constructor's fields: name, whether recursive, and type (over the fields before)
inductive CField where
  | mk (name : String) (isRec : Bool) (ty tyI : Tm)
-- (21x) and each field's quantity, and whether it is implicit
inductive Ctor where
  | mk (name : String) (fields : List CField) (res : Tm) (qs : List Q) (impl : List Bool)
-- (`params`: the parameter binders as written, for a deriver: the reflection
-- `getInductive` hands a Lean macro its `ParamView`s. Syntax, so a derived instance can
-- re-use the types exactly; the `A11` derivers re-elaborate them.)
inductive IndInfo where
  | mk (np : Nat) (I D DI : Tm) (ctors : List Ctor) (fixed : Option Tm) (fam : Tm) (params : List Syntax)
structure Header where
  name : String
  text : String

-- the C side of a program (stage 21l): its foreign functions (`extern`: the Wiz name,
-- the C name, the header or "", the marshalling kinds of the parameters and of the
-- result as in the Lean frontend, whether the result is in `IO`, and the finalizer of a
-- foreign pointer result) and its foreign pointer types (`foreign_type`, with their
-- finalizers), the latest first
inductive Foreign where
  | fn (name cname header : String) (params : List String) (res : String) (io : Bool) (fin : String)
  | ty (name fin cname : String)
  -- (stage 21o) `link_c "f.c"` (`lib := false`) and `link_lib "m"`, and `export "c" f`:
  -- the Wiz name, the C name, the kinds of the parameters and of the result, `IO`
  | link (path : String) (lib : Bool)
  | exported (name cname : String) (params : List String) (res : String) (io : Bool)
  -- (stage 21r) `c_struct "ctype" (header := "h") T where fields`: the Wiz structure `T`,
  -- the C type, the header or "" (then the C definition is generated), the fields' names
  -- and their marshalling kinds (`S:U` a nested `c_struct U`)
  | cstruct (name ctype header : String) (fields kinds : List String)
  -- (stage 21t) `attribute [implemented_by g] f`: compiled code runs `g` for `f`
  | impl (name target : String)
  -- (stage 30) a native representation: `attribute [implemented_by mk get] T.mk`
  | repr (T mk get : String)
  -- (stage 30) `import_c`: the functions glue may call, the header's structs, and the C
  -- text (an include, a glue function) the backend puts before the wrappers
  | cfunc (name : String) (params : List String) (res : String)
  | code (text : String)
-- (A11) the deriver of each class the frontend implements (`deriving C` runs it): the
-- Lean toolchain registers these with `attribute [deriver C] f` on import of
-- `lib/Deriving.wiz`, and the self-hosted prelude has no classes, so the five are
-- pre-registered here. The value is the deriver's name (`deriveBEq`, …), as
-- `attribute [deriver C] f` records it: dispatch is by **name**, like the host's table
-- (`CommandState.derivers`), not by the class's method shape.
def builtinDerivers : StrMap (Option String) :=
  StrMap.insert (StrMap.insert (StrMap.insert (StrMap.insert (StrMap.insert StrMap.empty
    (Str.ofString "Inhabited") (.some "deriveInhabited"))
    (Str.ofString "BEq") (.some "deriveBEq"))
    (Str.ofString "Repr") (.some "deriveRepr"))
    (Str.ofString "DecidableEq") (.some "deriveDecidableEq"))
    (Str.ofString "Compare") (.some "deriveCompare")
-- the globals so far: by position (the first is `0`), their names in scope, the
-- instances (the latest first), the preprocessed header texts (`import_c`; the driver
-- reads them, since the frontend is pure), and the derivers by class
inductive Globals where
  | mk (all : Array Global) (scope : Scope) (inds : StrMap (Option IndInfo)) (ffi : List Foreign)
       (classes : StrMap (Option ClassInfo)) (insts : List InstInfo) (headers : List Header)
       (priv : Bool) (ders : StrMap (Option String))
def Globals.empty : Globals := .mk Array.empty Scope.empty StrMap.empty .nil StrMap.empty .nil .nil .false builtinDerivers
def Globals.scope : Globals → Scope
  | .mk _ sc _ _ _ _ _ _ _ => sc
-- the module whose commands are being elaborated (`private` is module-scoped)
def Globals.setModule (gs : Globals) (m : String) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs p d => .mk all (Scope.setModule sc m) inds ffi cls ins hs p d
def Globals.setPrivate (gs : Globals) (p : Bool) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs _ d => .mk all sc inds ffi cls ins hs p d
-- the kernel name a declaration `x` of the command being elaborated gets
def Globals.declName (gs : Globals) (x : String) : String := match gs with
  | .mk _ sc _ _ _ _ _ p _ => match p with
    | .true => privName (Scope.cur sc) x
    | .false => x
def Globals.add (gs : Globals) (g : Global) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs p d => match g with
    | .mk x ps ty v iv im ns =>
      let k := match p with
        | .true => privName (Scope.cur sc) x
        | .false => x;
      .mk (Array.push all (.mk k ps ty v iv im ns)) (Scope.addGlobal sc k x (Scope.cur sc) p) inds ffi cls ins hs p d
def Globals.addInd (gs : Globals) (T : String) (info : IndInfo) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs p d =>
    let k := match p with
      | .true => privName (Scope.cur sc) T
      | .false => T;
    .mk all sc (StrMap.insert inds (Str.ofString k) (.some info)) ffi cls ins hs p d
-- an inductive type by its name (`T`, a source name, or a term's kernel name)
def Globals.ind (gs : Globals) (T : String) : Option IndInfo := match gs with
  | .mk _ sc inds _ _ _ _ _ _ => match StrMap.findD inds (Str.ofString (privName (Scope.cur sc) T)) .none with
    | .some info => .some info
    | .none => StrMap.findD inds (Str.ofString T) .none
def Globals.ffi : Globals → List Foreign
  | .mk _ _ _ ffi _ _ _ _ _ => ffi
def Globals.addFFI (gs : Globals) (f : Foreign) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs p d => .mk all sc inds (.cons f ffi) cls ins hs p d
def Globals.headers : Globals → List Header
  | .mk _ _ _ _ _ _ hs _ _ => hs
def Globals.addHeader (gs : Globals) (name text : String) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs p d => .mk all sc inds ffi cls ins (.cons (Header.mk name text) hs) p d
def headerGo (name : String) : List Header → Option String
  | .nil => .none
  | .cons e rest => match strEq e.name name with
    | .true => .some e.text
    | .false => headerGo name rest
def Globals.header (gs : Globals) (name : String) : Option String :=
  headerGo name (Globals.headers gs)
def Globals.withHeaders (gs : Globals) (hs : List Header) : Globals := match gs with
  | .mk all sc inds ffi cls ins _ p d => .mk all sc inds ffi cls ins hs p d
-- (A10) the classes by name
def Globals.class (gs : Globals) (T : String) : Option ClassInfo := match gs with
  | .mk _ _ _ _ cls _ _ _ _ => match StrMap.findD cls (Str.ofString T) .none with
    | .some info => .some info
    | .none => .none
def Globals.addClass (gs : Globals) (T : String) (info : ClassInfo) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs p d => .mk all sc inds ffi (StrMap.insert cls (Str.ofString T) (.some info)) ins hs p d
-- (A11) the deriver registered for a class (`deriving C` runs it), by class name
def Globals.deriver (gs : Globals) (C : String) : Option String := match gs with
  | .mk _ _ _ _ _ _ _ _ ders => match StrMap.findD ders (Str.ofString C) .none with
    | .some f => .some f
    | .none => .none
def Globals.addDeriver (gs : Globals) (C f : String) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs p d => .mk all sc inds ffi cls ins hs p (StrMap.insert d (Str.ofString C) (.some f))
-- (A10) the instances, the latest first
def Globals.insts : Globals → List InstInfo
  | .mk _ _ _ _ _ ins _ _ _ => ins
def Globals.addInst (gs : Globals) (i : InstInfo) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs p d => .mk all sc inds ffi cls (.cons i ins) hs p d
-- (A10) a global's parameter kinds replaced (a class's type former inserts its
-- instance parameters at every use, as in Lean)
def Globals.setMask (gs : Globals) (n : String) (m : List BKind) : Globals := match gs with
  | .mk all sc inds ffi cls ins hs p d => match Scope.lookup sc n with
    | .none => gs
    | .some i => match Array.getD all (Array.size all - 1 - i) (.mk "?" .nil .star .star .star .nil .nil) with
      | .mk nm ps ty v iv _ ns => .mk (Array.set all (Array.size all - 1 - i) (.mk nm ps ty v iv m ns)) sc inds ffi cls ins hs p d
-- the instances of class `C`, the latest first
def instsOf : String → List InstInfo → List InstInfo
  | _, .nil => .nil
  | C, .cons (.mk cls n p o) rest => match strEq C cls with
    | .true => .cons (.mk cls n p o) (instsOf C rest)
    | .false => instsOf C rest
-- the global at index `i` (the latest is `0`): a constant, or its value inlined
def globalTm (inline : Bool) (gs : Globals) (i : Nat) : Tm := match gs with
  | .mk all _ _ _ _ _ _ _ _ => match Array.getD all (Array.size all - 1 - i) (.mk "?" .nil .star .star .star .nil .nil) with
    | .mk n _ ty v iv _ _ => match inline with
      | .true => iv
      | .false => .const n .nil .nil v ty
-- the universe parameters a global declares (none at all before U1 for every definition)
def globalParams (gs : Globals) (i : Nat) : List String := match gs with
  | .mk all _ _ _ _ _ _ _ _ => match Array.getD all (Array.size all - 1 - i) (.mk "?" .nil .star .star .star .nil .nil) with
    | .mk _ ps _ _ _ _ _ => ps
-- a global's own parameters as levels (`fun u => .lparam u`, for a polymorphic global
-- used where no level syntax is available)
def lparamLvls : List String → List Lvl
  | .nil => .nil
  | .cons p rest => .cons (.lparam p) (lparamLvls rest)
-- the kernel name of a declaration by its source name (`Foreign` records these, and a
-- term's constants carry them: stage 21n)
def globalKeyOf (gs : Globals) (f : String) : String := match Scope.lookup (Globals.scope gs) f with
  | .none => f
  | .some i => match gs with
    | .mk all _ _ _ _ _ _ _ _ => match Array.getD all (Array.size all - 1 - i) (.mk "?" .nil .star .star .star .nil .nil) with
      | .mk k _ _ _ _ _ _ => k

-- close a scope-checked term: the variables beyond the `d` binders it is under are
-- globals (each command is checked in the empty context, so usage vectors and lookups
-- don't grow with the number of globals)
def closeG (inline : Bool) (gs : Globals) : Nat → Tm → Tm
  | d, .var i => match Nat.lt i d with
    | .true => .var i
    | .false => match inline with
      | .true => globalTm .true gs (i - d)
      -- (a polymorphic global is used at its own parameters: a field or a match's type
      -- has no level syntax of its own)
      | .false => let ps := globalParams gs (i - d); match globalTm .false gs (i - d) with
        | .const n _ _ v ty => .const n ps (lparamLvls ps) v ty
        | t => t
  | d, .pi q i j a b => .pi q i j (closeG inline gs d a) (closeG inline gs (d + 1) b)
  | d, .lam b => .lam (closeG inline gs (d + 1) b)
  | d, .app f a => .app (closeG inline gs d f) (closeG inline gs d a)
  | d, .letE ty v b => .letE (closeG inline gs d ty) (closeG inline gs d v) (closeG inline gs (d + 1) b)
  | d, .ann t ty => .ann (closeG inline gs d t) (closeG inline gs d ty)
  | _, t => t

-- the output of a command, and the globals after it
inductive Step where
  | mk (out : String) (gs : Globals)

-- Names are unique: the kernel compares two glued constants by their names
-- (`convHead`, `tmEq`, `headSame` in Kernel.wiz), and a constant carries its value, so a
-- second declaration of a name would be identified with the first wherever both stay
-- folded (`def T := Nat; def a : Box T := …; def T := Empty; def c : Box T := a`).
-- Checked in one place, for every command (`stepCommand`): none of the globals a command
-- added may be in scope before it, or twice among them. One exception: a partial
-- definition's signature (an axiom) is followed, once, by its body under the same name.
def Globals.all : Globals → Array Global
  | .mk all _ _ _ _ _ _ _ _ => all
inductive Seen where
  | mk (name : String) (axiomOnly : Bool)
def isAxiomTm : Tm → Bool
  | .axiomC _ _ => .true
  | _ => .false
-- `.none`: a first occurrence; else whether the name was seen as an axiom only
def seenAs : List Seen → String → Option Bool
  | .nil, _ => .none
  | .cons (.mk n ax) rest, x => match strEq n x with
    | .true => .some ax
    | .false => seenAs rest x
-- the first name declared twice among the globals `i, i + 1, …` (`fuel` of them).
-- Kernel names are compared (so two modules' private `x`s are different names), and a
-- source name may be declared only once per module (`Scope.declaredIn`: a private `x`
-- and a public `x` in the same module clash, as in the Lean frontend); other modules'
-- declarations of the name do not count.
def dupFrom (old : Scope) (all : Array Global) : Nat → Nat → List Seen → Option String
  | .zero, _, _ => .none
  | .succ fuel, i, seen => match Array.getD all i (.mk "?" .nil .star .star .star .nil .nil) with
    | .mk x _ _ v _ _ _ =>
      let base := privBase x;
      let owner := match privMod x with
        | .some m => m
        | .none => Scope.cur old;
      match Scope.find old x with
      | .some _ => .some base
      | .none => match Scope.declaredIn old owner base with
        | .true => .some base
        | .false => match seenAs seen x with
          | .none => dupFrom old all fuel (i + 1) (.cons (.mk x (isAxiomTm v)) seen)
          | .some ax => match Bool.and ax (Bool.not (isAxiomTm v)) with
            | .true => dupFrom old all fuel (i + 1) (.cons (.mk x .false) seen)
            | .false => .some base
def newDuplicate (gs gs' : Globals) : Option String :=
  let n := Array.size (Globals.all gs);
  dupFrom (Globals.scope gs) (Globals.all gs') (Array.size (Globals.all gs') - n) n .nil

def errStep (gs : Globals) (m : String) : Step := .mk (String.append "error: " m) gs


-- Inductive types (stage 16a): `inductive T where | c (x : A) (y : T) …`, without
-- parameters or indices, in `Type`. `T` is the constant `μ D tt` for the description
--   D := darg ω (Enum k) (fun t => ecase t [D₁, …, Dₖ])
-- and each constructor `T.c` the constant `fun fields => con (tag, fields…, tt, tt)`.

-- a binder of a telescope (a constructor's field, a parameter): its name, its quantity
-- (the default filled in: ω explicit, 0 implicit; 21x) and whether it is implicit, and
-- its type
inductive Field where
  | mk (name : String) (q : Q) (impl : Bool) (ty : Syntax)
-- the kinds of a constructor's parameters (all implicit), and a field's stated
-- implicitness as a kind
def impls : Nat → List BKind
  | .zero => .nil
  | .succ k => .cons .impl (impls k)
def fieldKinds : List Bool → List BKind
  | .nil => .nil
  | .cons b rest => .cons (match b with
      | .true => .impl
      | .false => .dflt) (fieldKinds rest)
-- which parameters are implicit (`{x : A}`) or instance (`[i : C A]`), one per name
def paramMask : List Syntax → List BKind
  | .nil => .nil
  | .cons b bs =>
    let n := List.length (binderNames b);
    List.append (match strEq (kindOf b) "binder.implicit" with
      | .true => implKinds n
      | .false => match isInstB b with
        | .true => instKinds n
        | .false => dfltKinds n) (paramMask bs)
-- the names a list of binders introduces, in order (A9: named arguments)
def binderParamNames : List Syntax → List String
  | .nil => .nil
  | .cons b bs => List.append (binderNames b) (binderParamNames bs)
-- (A9) the names a type's leading Π binders introduce: a declaration may write its
-- parameters in its type (`axiom f : {A : Type} → …`, `extern … : {A : Type} → …`)
partial def typeBinderNames : Syntax → List String
  | s => match strEq (kindOf s) "term.depArrow" with
    | .true => List.append (binderNames (kid s 0)) (typeBinderNames (kid s 2))
    | .false => match strEq (kindOf s) "term.arrow" with
      | .true => .cons "_" (typeBinderNames (kid s 2))
      | .false => .nil
-- a declaration's parameter names: its written binders, else its type's Π binders
def declParamNames (d : Syntax) : List String := match binderParamNames (kids (kid d 3)) with
  | .nil => match kids (kid d 4) with
    | .cons _ (.cons ty _) => typeBinderNames ty
    | _ => .nil
  | ns => ns

def fieldsNamed (q : Q) (impl : Bool) (ty : Syntax) : List String → List Field
  | .nil => .nil
  | .cons x xs => .cons (.mk x q impl ty) (fieldsNamed q impl ty xs)
def fieldsOf : List Syntax → List Field
  | .nil => .nil
  | .cons b bs => match binderType b with
    | .none => fieldsOf bs
    -- (a bad quantity is an error before: `ctorQtyErr`)
    | .some ty => List.append (fieldsNamed (match binderQ b with
        | .some q => q
        | .none => .qw) (isImplicitB b) ty (binderNames b)) (fieldsOf bs)
-- shift the variables from `c` on of a scope-checked term by `k`
def shiftTm (k : Nat) : Nat → Tm → Tm
  | c, .var i => match Nat.lt i c with
    | .true => .var i
    | .false => .var (i + k)
  | c, .pi q i j a b => .pi q i j (shiftTm k c a) (shiftTm k (c + 1) b)
  | c, .lam b => .lam (shiftTm k (c + 1) b)
  | c, .app f a => .app (shiftTm k c f) (shiftTm k c a)
  | c, .letE ty v b => .letE (shiftTm k c ty) (shiftTm k c v) (shiftTm k (c + 1) b)
  | c, .letq q ty v b => .letq q (shiftTm k c ty) (shiftTm k c v) (shiftTm k (c + 1) b)
  | c, .ann t ty => .ann (shiftTm k c t) (shiftTm k c ty)
  | c, .sigma q i j a b => .sigma q i j (shiftTm k c a) (shiftTm k (c + 1) b)
  | c, .sigmaQ q i j a b => .sigmaQ (shiftTm k c q) i j (shiftTm k c a) (shiftTm k (c + 1) b)
  | c, .eq A a b => .eq (shiftTm k c A) (shiftTm k c a) (shiftTm k c b)
  | c, .eqRefl A a => .eqRefl (shiftTm k c A) (shiftTm k c a)
  | c, .pair a b => .pair (shiftTm k c a) (shiftTm k c b)
  | c, .fst t => .fst (shiftTm k c t)
  | c, .snd t => .snd (shiftTm k c t)
  | c, .con t => .con (shiftTm k c t)
  | c, .exfalso m t => .exfalso (shiftTm k c m) (shiftTm k c t)
  | c, .letUnit u b => .letUnit (shiftTm k c u) (shiftTm k c b)
  | _, t => t
inductive TmsR where
  | ok (ts : Tms)
  | err (msg : String)
-- the normal form of a term under `d` binders (to reduce applied templates: the kernel
-- can't infer the type of a λ applied to arguments)
def freshEnv : Nat → Env
  | .zero => .nil
  | .succ k => .cons (fresh k) (freshEnv k)
def nfAt (d : Nat) (t : Tm) : Tm := quote d (eval (freshEnv d) t)
def identOf (s : Syntax) : String := match strEq (kindOf s) "term.ident" with
  | .true => match kid s 0 with
    | .ident n => n
    | _ => "_"
  | .false => "_"
def bindAll : Scope → List String → Scope
  | sc, .nil => sc
  | sc, .cons x xs => bindAll (Scope.bind sc x) xs
def argsAre : List Syntax → List String → Bool
  | .nil, .nil => .true
  | .cons a as, .cons p ps => Bool.and (strEq (identOf a) p) (argsAre as ps)
  | _, _ => .false
-- a recursive field's type is `T` applied to the parameters `ps` (and, for an indexed
-- type, an index: `isRecField` gives it)
inductive RecF where
  | no
  | yes (idx : Option Syntax)
def lastS : List Syntax → Syntax
  | .nil => .missing
  | .cons s rest => match rest with
    | .nil => s
    | .cons _ _ => lastS rest
def argsPrefix : List Syntax → List String → Bool
  | _, .nil => .true
  | .cons a as, .cons p ps => Bool.and (strEq (identOf a) p) (argsPrefix as ps)
  | .nil, .cons _ _ => .false
def recField (T : String) (ps : List String) (nidx : Nat) (ty : Syntax) : RecF := match strEq (kindOf ty) "term.ident" with
  | .true => match Bool.and (strEq (identOf ty) T) (Bool.and (argsAre .nil ps) (Nat.beq nidx 0)) with
    | .true => .yes .none
    | .false => .no
  | .false => match strEq (kindOf ty) "term.app" with
    | .true =>
      let as := kids (kid ty 1);
      match Bool.and (strEq (identOf (kid ty 0)) T) (Bool.and (argsPrefix as ps) (Nat.beq (List.length as) (List.length ps + nidx))) with
      | .true => .yes (match nidx with
        | .zero => .none
        | .succ _ => .some (lastS as))
      | .false => .no
    | .false => .no
def isRecField (T : String) (ps : List String) (ty : Syntax) : Bool := match recField T ps 0 ty with
  | .yes _ => .true
  | .no => .false
-- the parameters as variables at depth `d`: `var (d - 1), …, var (d - np)`
def pvars : Nat → Nat → Tms
  | .zero, _ => .tnil
  | .succ k, d => .tcons (.var (d - 1)) (pvars k (d - 1))
def tmsDrop : Nat → Tms → Tms
  | .zero, ts => ts
  | .succ k, ts => match ts with
    | .tnil => .tnil
    | .tcons _ rest => tmsDrop k rest
def tmsTake : Nat → Tms → Tms
  | .zero, _ => .tnil
  | .succ k, ts => match ts with
    | .tnil => .tnil
    | .tcons t rest => .tcons t (tmsTake k rest)
def tmsLenF : Tms → Nat
  | .tnil => 0
  | .tcons _ rest => tmsLenF rest + 1
def tmsAppend : Tms → Tms → Tms
  | .tnil, b => b
  | .tcons t rest, b => .tcons t (tmsAppend rest b)
def shiftTms (k : Nat) : Tms → Tms
  | .tnil => .tnil
  | .tcons t rest => .tcons (shiftTm k 0 t) (shiftTms k rest)
-- `Π (x₁ : A₁) … B` for a telescope of types
-- a telescope with a quantity for each binder (the missing ones ω)
def piTeleQ : List Q → Tms → Tm → Tm
  | _, .tnil, b => b
  | qs, .tcons a rest, b => piTm (headQ qs) a (piTeleQ (tailQ qs) rest b)
-- a constructor's parameters: implicit, at 0 (as in the Lean elaborator's `implicitΔ`)
def piTeleZ : Tms → Tm → Tm
  | .tnil, b => b
  | .tcons a rest, b => piTm .qz a (piTeleZ rest b)
def piTele : Tms → Tm → Tm
  | .tnil, b => b
  | .tcons a rest, b => piH a (piTele rest b)
def fieldNames : List Field → List String
  | .nil => .nil
  | .cons (.mk x _ _ _) rest => .cons x (fieldNames rest)
-- (13b: a constructor is "|" ["private"] ident binders [":" T]; privacy is the
-- Lean elaborator's, the self-hosted frontend ignores it)
def ctorName (c : Syntax) : String := match kid c 2 with
  | .ident n => n
  | _ => "_"
def ctorFields (c : Syntax) : List Field := fieldsOf (kids (kid c 3))

-- an index (`tt` without one), scope-checked in `sc` and closed at depth `d`
def idxTm (inline : Bool) (gs : Globals) (sc : Scope) (d : Nat) : Option Syntax → Elab
  | .none => .ok .star
  | .some s => match elab sc s with
    | .ok t => .ok (closeG inline gs d t)
    | e => e
-- **Exercise 16.1.** The description of a constructor's fields (`ctorDesc` in
-- `Inductive.lean`): a field `(q x : A)` is `darg q A (fun x => …)`, a recursive one (of
-- type `T ps j`, `recField`) is `drec q j …`, and the end is `dret i`, `i` the
-- constructor's index `res` (`idxTm`: `tt` for a type without indices). A recursive
-- field binds no variable. `sc` is the scope (the globals, then the parameters, `t✝`
-- and the fields so far that are bound) and `d` the number of those binders, for
-- closing a field's type over the globals (`closeG inline gs d`).
def ctorDesc (inline : Bool) (gs : Globals) (T : String) (ps : List String) (nidx : Nat) (res : Option Syntax) : Scope → Nat → List Field → Elab
  --<sol
  | sc, d, .nil => match idxTm inline gs sc d res with
    | .ok i => .ok (.dret i)
    | e => e
  | sc, d, .cons (.mk x q _ ty) rest => match recField T ps nidx ty with
    | .yes j => match idxTm inline gs sc d j with
      | .err m => .err m
      | .ok jt => match ctorDesc inline gs T ps nidx res sc d rest with
        | .ok D => .ok (.drec (.qlit q) jt D)
        | e => e
    | .no => match elab sc ty with
      | .err m => .err m
      | .ok A => match ctorDesc inline gs T ps nidx res (Scope.bind sc x) (d + 1) rest with
        | .ok D => .ok (.darg (.qlit q) (closeG inline gs d A) (.lam D))
        | e => e
  --|ex
  --| | _, _, _ => .err "not implemented"
  --sol>
-- a constructor's index: the last argument of its result type `T ps i`
def ctorRes (nidx : Nat) (c : Syntax) : Option Syntax := match nidx with
  | .zero => .none
  | .succ _ => match kids (kid c 4) with
    | .cons _ (.cons ty _) => .some (lastS (kids (kid ty 1)))
    | _ => .none

-- the constructors' descriptions, under the binder `t✝` of the tag
inductive Descs where
  | ok (ds : Tms)
  | err (msg : String)
def ctorDescs (inline : Bool) (gs : Globals) (T : String) (ps : List String) (nidx : Nat) : List Syntax → Descs
  | .nil => .ok .tnil
  | .cons c cs => match ctorDesc inline gs T ps nidx (ctorRes nidx c) (Scope.bind (bindAll (Globals.scope gs) ps) "t✝") (List.length ps + 1) (ctorFields c) with
    | .err m => .err m
    | .ok D => match ctorDescs inline gs T ps nidx cs with
      | .ok ds => .ok (.tcons D ds)
      | e => e
-- a constructor's fields with their types, every field bound in the later ones
inductive CFields where
  | ok (fs : List CField)
  | err (msg : String)
def idxArgs (gs : Globals) (sc : Scope) (d : Nat) : Option Syntax → TmsR
  | .none => .ok .tnil
  | .some s => match elab sc s with
    | .ok t => .ok (.tcons (closeG .false gs d t) .tnil)
    | .err m => .err m
def ctorFieldTys (gs : Globals) (T : String) (ps : List String) (nidx : Nat) (Tc TcI : Tm) : Scope → Nat → List Field → CFields
  | _, _, .nil => .ok .nil
  | sc, d, .cons (.mk x _ _ ty) rest =>
    let np := List.length ps;
    let A : CFields := match recField T ps nidx ty with
      | .yes j => match idxArgs gs sc d j with
        | .ok js => .ok (.cons (.mk x .true (tApps Tc (tmsAppend (pvars np d) js)) (tApps TcI (tmsAppend (pvars np d) js))) .nil)
        | .err m => .err m
      | .no => match elab sc ty with
        | .ok A => .ok (.cons (.mk x .false (closeG .false gs d A) (closeG .true gs d A)) .nil)
        | .err m => .err m;
    match A with
    | .err m => .err m
    | .ok f => match ctorFieldTys gs T ps nidx Tc TcI (Scope.bind sc x) (d + 1) rest with
      | .ok fs => .ok (List.append f fs)
      | e => e
-- a constructor's type: `(fields) → T`
def ctorType (Tc : Tm) : List Q → List CField → Tm
  | _, .nil => Tc
  | qs, .cons (.mk _ _ A _) rest => piTm (headQ qs) A (ctorType Tc (tailQ qs) rest)
-- (21x) the fields' quantities, and which are implicit
def fieldQs : List Field → List Q
  | .nil => .nil
  | .cons (.mk _ q _ _) rest => .cons q (fieldQs rest)
def fieldImpl : List Field → List Bool
  | .nil => .nil
  | .cons (.mk _ _ b _) rest => .cons b (fieldImpl rest)
-- the payload `(field₁, …, (tt, tt))`, the first field being `var (n - 1)`
def payloadTm : Nat → Nat → Tm
  | .zero, _ => .pair .star .star
  | .succ r, i => .pair (.var i) (payloadTm r (i - 1))
-- add the constructors from the `i`th on, collecting their fields
inductive Added where
  | ok (gs : Globals) (ctors : List Ctor)
  | err
-- the payload `(field₁, …, (p, tt))`, the first field being `var (n - 1)`, `p` the
-- proof that the index is the constructor's
def payloadP (p : Tm) : Nat → Nat → Tm
  | .zero, _ => .pair p .star
  | .succ r, i => .pair (.var i) (payloadP p r (i - 1))
-- A type with the sorts of the `Π`/`Σ` in its spine filled in where they are known
-- (`Sorts.type` in the Lean elaborator), and its sort: the types of declarations are
-- built without them (telescopes, constructor types), and type equality waits on a
-- `Π`/`Σ` without its sort. A sort is only written when the kernel's `sortOf` knows it.
inductive STm where
  | mk (t : Tm) (s : Option Lvl)
def STm.tm : STm → Tm
  | .mk t _ => t
-- (a defined type's sort comes from its declared type: unfolding it, as `sortOf` does,
-- would evaluate its whole description)
def leafSort (c : TCtx) (v : Val) : Option Lvl := match v with
  | .vglued h sp _ => match whnf (typeOfNe c h sp) with
    | .vsort l => .some l
    | _ => sortOf c v
  | v => sortOf c v
def sortLeaf (c : TCtx) (t : Tm) : STm := .mk t (leafSort c (eval (TCtx.env c) t))
def binTm (isPi : Bool) (q : Q) (a b : Tm) : Tm := match isPi with
  | .true => piTm q a b
  | .false => sigmaTm q a b
-- (a closed level is kept a number: a chain of `imax`es along a telescope would cost
-- the kernel's level normalization dearly)
def closedLvl (l : Lvl) : Lvl := match lvlClosed l with
  | .some n => .lnum n
  | .none => l
def binLvl (isPi : Bool) (i j : Lvl) : Lvl := match isPi with
  | .true => closedLvl (.limax i j)
  | .false => closedLvl (.lmax i j)
-- (mandatory sorts: the components' sorts are written, a hole where one is not known; the
-- sorts pass fills the rest, `sortsTy`)
def binSorted (isPi : Bool) (q : Q) (i j : Lvl) (a b : Tm) : Tm := match isPi with
  | .true => .pi q i j a b
  | .false => .sigma q i j a b
def sortJoin (isPi : Bool) (q : Q) (a b : STm) : STm := match a, b with
  | .mk a' (.some i), .mk b' (.some j) => .mk (binSorted isPi q (closedLvl i) (closedLvl j) a' b') (.some (binLvl isPi i j))
  | .mk a' (.some i), .mk b' _ => .mk (binSorted isPi q (closedLvl i) .lhole a' b') .none
  | .mk a' _, .mk b' (.some j) => .mk (binSorted isPi q .lhole (closedLvl j) a' b') .none
  | .mk a' _, .mk b' _ => .mk (binTm isPi q a' b') .none
def sortUnder (c : TCtx) (a : STm) : TCtx := TCtx.bind c (eval (TCtx.env c) (STm.tm a))
-- (a component sort already written is kept)
def keepLvl (l : Lvl) (s : Option Lvl) : Option Lvl := match lvlHasHole l with
  | .true => s
  | .false => .some l
def sortJoinK (isPi : Bool) (q : Q) (i j : Lvl) (a b : STm) : STm := match a, b with
  | .mk a' si, .mk b' sj => sortJoin isPi q (.mk a' (keepLvl i si)) (.mk b' (keepLvl j sj))
def sortSpine : TCtx → Tm → STm
  | c, .pi q i j a b => let sa := sortSpine c a; sortJoinK .true q i j sa (sortSpine (sortUnder c sa) b)
  | c, .sigma q i j a b => let sa := sortSpine c a; sortJoinK .false q i j sa (sortSpine (sortUnder c sa) b)
  | c, t => sortLeaf c t
-- a closed type with its sorts (`sortSpine`, then the sorts pass for what it left)
def sortTy (t : Tm) : Tm := sortsTy (STm.tm (sortSpine empty t))
-- **Phantom parameters** (stage 21i; `phantomTail` in `Elab/Inductive.lean`, README
-- 22e). Types are structural, so a parameter no constructor mentions would be forgotten
-- (`UIntN 8` and `UIntN 16` one type, `w` never inferred). For each such parameter
-- `p : P` the index type `Unit` becomes `(0 _ : D) → … → Unit`, with `D := p` for a
-- type and `D := (0 x : P) × (x = p)` otherwise; the indices are its one value
-- `fun _ => tt`. Proofs and sizes get none, nor does a parameter whose `D` would raise
-- the index type's universe. Erasure drops the tail (a function into `Unit` is a
-- proposition here: `erasable`). An indexed family with such a parameter is rejected
-- (the Lean frontend pairs the index with the tail; not mirrored yet).
mutual
-- does `t` mention the variable `i`? (exact on the forms of field types and
-- descriptions; any other form counts as a mention)
def occurs : Nat → Tm → Bool
  | i, .var j => Nat.beq i j
  | i, .pi _ _ _ a b => Bool.or (occurs i a) (occurs (i + 1) b)
  | i, .sigma _ _ _ a b => Bool.or (occurs i a) (occurs (i + 1) b)
  | i, .lam b => occurs (i + 1) b
  | i, .app f a => Bool.or (occurs i f) (occurs i a)
  | i, .letE ty v b => Bool.or (occurs i ty) (Bool.or (occurs i v) (occurs (i + 1) b))
  | i, .letq _ ty v b => Bool.or (occurs i ty) (Bool.or (occurs i v) (occurs (i + 1) b))
  | i, .ann t ty => Bool.or (occurs i t) (occurs i ty)
  | i, .pair a b => Bool.or (occurs i a) (occurs i b)
  | i, .fst t => occurs i t
  | i, .snd t => occurs i t
  | i, .con t => occurs i t
  | i, .eq A a b => Bool.or (occurs i A) (Bool.or (occurs i a) (occurs i b))
  | i, .eqRefl A a => Bool.or (occurs i A) (occurs i a)
  | i, .descr _ I => occurs i I
  | i, .dret x => occurs i x
  | i, .darg _ S D => Bool.or (occurs i S) (occurs i D)
  | i, .drec _ j D => Bool.or (occurs i j) (occurs i D)
  | i, .dhrec _ H j D => Bool.or (occurs i H) (Bool.or (occurs i j) (occurs i D))
  | i, .ecase m s bs => Bool.or (occurs (i + 1) m) (Bool.or (occurs i s) (occursTms i bs))
  | i, .mu _ I D x => Bool.or (occurs i I) (Bool.or (occurs i D) (occurs i x))
  | _, .const _ _ _ _ _ => .false
  | _, .axiomC _ _ => .false
  | _, .univ _ => .false
  | _, .prop => .false
  | _, .sortL _ => .false
  | _, .unit _ => .false
  | _, .star => .false
  | _, .empty _ => .false
  | _, .enum _ => .false
  | _, .tag _ _ => .false
  | _, _ => .true
def occursTms : Nat → Tms → Bool
  | _, .tnil => .false
  | i, .tcons t rest => Bool.or (occurs i t) (occursTms i rest)
end
-- the context of the parameters (their types, each over the ones before)
def paramCtx : TCtx → Tms → TCtx
  | c, .tnil => c
  | c, .tcons A rest => paramCtx (TCtx.bind c (eval (TCtx.env c) A)) rest
-- the phantom domain `D` of the parameter `k` of `np` (its type `A` over the ones
-- before), at depth `np` in the parameters' context `c`; `none` if it gets none
def phantomDom (c : TCtx) (np k : Nat) (A : Tm) : Option Tm :=
  let P := shiftTm (np - k) 0 A;
  let p : Tm := .var (np - 1 - k);
  let vP := eval (TCtx.env c) P;
  let D : Option Tm := match whnf vP with
    | .vsort _ => .some p
    | .vsize => .none
    | .vsizeLt _ => .none
    | _ => match isProp c vP with
      | .true => .none
      | .false => .some (sigmaTm .qz P (.eq (shiftTm 1 0 P) (.var 0) (shiftTm 1 0 p)));
  match D with
  | .none => .none
  | .some D' => match inferUniv c (sortsTyIn c (piTm .qz D' (.unit 0))) with
    | .ok ty _ => match ty with
      | .vsort l => match lvlEquiv l (.lnum 1) with
        | .true => .some D'
        | .false => .none
      | _ => .none
    | .err _ => .none
-- the phantom domains of the parameters from the `k`th on that `used` doesn't mention
def phantomDoms (c : TCtx) (np : Nat) (used : Nat → Bool) : Nat → Tms → Tms
  | _, .tnil => .tnil
  | k, .tcons A rest =>
    let more := phantomDoms c np used (k + 1) rest;
    match used k with
    | .true => more
    | .false => match phantomDom c np k A with
      | .some D => .tcons D more
      | .none => more
-- the tail `(0 _ : D₁) → … → Unit` (the `i` domains before already bound)
def phantomTy : Nat → Tms → Tm
  | _, .tnil => .unit 0
  | i, .tcons D rest => piTm .qz (shiftTm i 0 D) (phantomTy (i + 1) rest)
-- the index of a type without indices: the tail's value `fun _ … _ => tt` (`tt` for `Unit`)
partial def phantomVal (I : Tm) : Tm := match I with
  | .pi .qz _ _ _ b => .lam (phantomVal b)
  | .pi .qo _ _ _ b => .lam (phantomVal b)
  | _ => .star
-- a constructor's description with the indices (all `tt`) replaced by the tail's value
partial def retail (v : Tm) (D : Tm) : Tm := match D with
  | .darg q S F => match F with
    | .lam B => .darg q S (.lam (retail v B))
    | _ => D
  | .drec q _ E => .drec q v (retail v E)
  | .dret _ => .dret v
  | _ => D
def retailTms (v : Tm) : Tms → Tms
  | .tnil => .tnil
  | .tcons D rest => .tcons (retail v D) (retailTms v rest)
-- (`strct`: a structure's constructor, 18e. The Lean elaborator takes a structure apart
-- by projections at ω, `structPattern?`: so a match binds a linear field at ω, 21x; a
-- field at 0 stays at 0, so that the projections of the others, which are matches here,
-- are accepted)
def structBindQs : List Q → List Q
  | .nil => .nil
  | .cons q rest => .cons (match q with
    | .qz => .qz
    | _ => .qw) (structBindQs rest)
def addCtors (T : String) (ps : List String) (pts : Tms) (nidx : Nat) (I : Tm) (Tc TcI : Tm) (k : Nat) (strct : Bool) : Globals → Nat → List Syntax → Added
  | gs, _, .nil => .ok gs .nil
  | gs, i, .cons c cs =>
    let n := List.length (ctorFields c);
    let np := List.length ps;
    let scF := bindAll (bindAll (Globals.scope gs) ps) (fieldNames (ctorFields c));
    match ctorFieldTys gs T ps nidx Tc TcI (bindAll (Globals.scope gs) ps) np (ctorFields c) with
    | .err _ => .err
    | .ok fs => match idxArgs gs scF (np + n) (ctorRes nidx c) with
      | .err _ => .err
      | .ok ics =>
        let qs := fieldQs (ctorFields c);
        let ty := sortTy (piTeleZ pts (ctorType (tApps Tc (tmsAppend (pvars np (np + n)) ics)) qs fs));
        -- (without an index: `tt`, or `refl` at a phantom tail)
        let proof : Tm := match ics with
          | .tcons ic _ => .eqRefl (shiftTm n 0 I) ic
          | .tnil => match I with
            | .unit _ => .star
            | _ => .eqRefl (shiftTm n 0 I) (phantomVal I);
        -- (the index equation's proof gets its marker, P2)
        let v := markClosed (tLams (np + n) (.con (.pair (.tag k i) (payloadP proof n (n - 1))))) ty;
        match check empty v (eval .nil ty) with
        | .err _ => .err
        | .ok _ _ => match addCtors T ps pts nidx I Tc TcI k strct (Globals.add gs (.mk (String.append (String.append T ".") (ctorName c)) .nil ty v v
          (List.append (impls np) (fieldKinds (fieldImpl (ctorFields c)))) .nil)) (i + 1) cs with
        | .ok gs' rest => .ok gs' (.cons (.mk (ctorName c) fs (match ics with
          | .tcons ic _ => ic
          | .tnil => .star) (match strct with
            | .true => structBindQs qs
            | .false => qs) (fieldImpl (ctorFields c))) rest)
        | .err => .err
-- the types of a telescope, each over the ones before
def elabTele (gs : Globals) : Scope → Nat → List Field → TmsR
  | _, _, .nil => .ok .tnil
  | sc, d, .cons (.mk x _ _ ty) rest => match elab sc ty with
    | .err m => .err m
    | .ok A => match elabTele gs (Scope.bind sc x) (d + 1) rest with
      | .ok ts => .ok (.tcons (closeG .false gs d A) ts)
      | e => e
-- the index type of a signature `I → Type` (or `(i : I) → Type`); `none` for `Type`
inductive Sig where
  | plain
  | indexed (I : Syntax)
  | bad
def sigOf (stx : Syntax) : Sig := match kids (kid stx 4) with
  | .cons _ (.cons ty _) => match strEq (kindOf ty) "term.type" with
    | .true => .plain
    | .false => match strEq (kindOf ty) "term.arrow" with
      | .true => match strEq (kindOf (kid ty 2)) "term.type" with
        | .true => .indexed (kid ty 0)
        | .false => .bad
      | .false => match strEq (kindOf ty) "term.depArrow" with
        | .true => match binderType (kid ty 0) with
          | .some I => match strEq (kindOf (kid ty 2)) "term.type" with
            | .true => .indexed I
            | .false => .bad
          | .none => .bad
        | .false => .bad
  | _ => .plain
-- in an indexed family `T : I → Type`, an index `.c` (the last argument of `T …` in the
-- constructors) is `I.c`: the constructors are scope-checked, not typed (stage 19d)
def takeS : Nat → List Syntax → List Syntax
  | .zero, _ => .nil
  | .succ n, xs => match xs with
    | .nil => .nil
    | .cons x rest => .cons x (takeS n rest)
def lastS' : List Syntax → Syntax
  | .nil => .missing
  | .cons x rest => match rest with
    | .nil => x
    | .cons _ _ => lastS' rest
def lastIdx : List Syntax → Nat → Nat
  | .nil, _ => 0
  | .cons _ rest, i => match rest with
    | .nil => i
    | .cons _ _ => lastIdx rest (i + 1)
-- (stage 21m, 21x) A constructor field's quantity is its description's (`darg q S D`,
-- `Desc.arg q S D` in the Lean kernel): written, or by default ω for an explicit field
-- and 0 for an implicit one (`{n : Nat}`), as `elabQuantity` gives it. A bad quantity
-- (`2`, `%t`) on a field or a parameter is an error.
def fieldQtyErr : List Syntax → Option String
  | .nil => .none
  | .cons b bs => match binderW b with
    | .bad => .some qtyErr
    | _ => fieldQtyErr bs
def ctorsQtyErr : List Syntax → Option String
  | .nil => .none
  | .cons c cs => match fieldQtyErr (kids (kid c 3)) with
    | .some m => .some m
    | .none => ctorsQtyErr cs
def ctorQtyErr (params ctors : List Syntax) : Option String := match binderQs params with
  | .none => .some qtyErr
  | .some _ => ctorsQtyErr ctors
mutual
def fixDots (T I : String) (s : Syntax) : Syntax := match s with
  | .node k args =>
    let s' : Syntax := .node k (fixDotsArgs T I args);
    match Bool.and (strEq k "term.app") (strEq (identOf (kid s' 0)) T) with
    | .true =>
      let as := kids (kid s' 1);
      let n := lastIdx as 0;
      let a := lastS' as;
      match strEq (kindOf a) "term.dotIdent" with
      | .true => match kid a 1 with
        | .ident c => mkNode "term.app" (.cons (kid s' 0) (one (mkNull (List.append (takeS n as)
            (one (mkNode "term.ident" (one (.ident (String.append (String.append I ".") c)))))))))
        | _ => s'
      | .false => s'
    | .false => s'
  | s => s
def fixDotsArgs (T I : String) : SyntaxF .false → SyntaxF .false
  | .nil => .nil
  | .cons s rest => .cons (fixDots T I s) (fixDotsArgs T I rest)
end
-- (21x) the inductive command a `structure` makes is marked (`structCmd`)
def isStructCmd (stx : Syntax) : Bool := match kid stx 7 with
  | .atom _ => .true
  | _ => .false
-- (`seal`: the seal axiom of a `sealed inductive`, 22k, the first domain of the index tail)
def inductiveCmdS0 (gs : Globals) (stx0 : Syntax) (seal : Option Tm) : Step := match ctorQtyErr (kids (kid stx0 3)) (kids (kid stx0 6)) with
  | .some m => errStep gs m
  | .none => match kid stx0 1 with
  | .ident T =>
    let stx := match sigOf stx0 with
      | .indexed I => match strEq (kindOf I) "term.ident" with
        | .true => fixDots T (identOf I) stx0
        | .false => stx0
      | _ => stx0;
    let params := fieldsOf (kids (kid stx 3));
    let ps := fieldNames params;
    let np := List.length ps;
    let ctors := kids (kid stx 6);
    let k := List.length ctors;
    let sig := sigOf stx;
    let nidx := match sig with
      | .indexed _ => 1
      | _ => 0;
    match elabTele gs (Globals.scope gs) 0 params with
    | .err m => errStep gs m
    | .ok pts =>
      -- the index type, over the parameters
      let Ir : Elab := match sig with
        | .indexed I => match elab (bindAll (Globals.scope gs) ps) I with
          | .ok t => .ok (closeG .false gs np t)
          | e => e
        | .plain => .ok (.unit 0)
        | .bad => .err "an inductive type's signature must be Type or I → Type";
      match Ir with
      | .err m => errStep gs m
      | .ok I0 =>
        match ctorDescs .false gs T ps nidx ctors with
        | .err m => errStep gs m
        | .ok ds0 => match ctorDescs .true gs T ps nidx ctors with
          | .err m => errStep gs m
          | .ok dsI0 =>
            -- phantom parameters: those that neither a constructor nor the index type
            -- mentions (in the descriptions, under `t✝`, the parameter `k` is `np - k`)
            let cP := paramCtx empty pts;
            let doms0 := phantomDoms cP np (fun (j : Nat) => Bool.or (occursTms (np - j) ds0) (occurs (np - 1 - j) I0)) 0 pts;
            let doms : Tms := match seal with
              | .some K => .tcons K doms0
              | .none => doms0;
            let I : Tm := match doms with
              | .tnil => I0
              | .tcons _ _ => STm.tm (sortSpine cP (phantomTy 0 doms));
            let tl := phantomVal I;
            let ds := match doms with
              | .tnil => ds0
              | .tcons _ _ => retailTms tl ds0;
            let dsI := match doms with
              | .tnil => dsI0
              | .tcons _ _ => retailTms tl dsI0;
            -- (the motive is under the tag's binder and its own)
            let mkD := fun (ds : Tms) => (.darg (.qlit .qw) (.enum k) (.lam (.ecase (.descr 0 (shiftTm 2 0 I)) (.var 0) ds)) : Tm);
            match Bool.and (Nat.beq nidx 1) (Bool.not (Nat.beq (tmsLenF doms) 0)) with
            | .true => errStep gs "a parameter that no constructor mentions (a phantom parameter) of an indexed family is not supported by the self-hosted frontend"
            | .false =>
              -- `fun ps => μ D tt`, or `fun ps i => μ D i`
              let body := fun (D : Tm) => (match sig with
                | .indexed _ => .lam (.mu 0 (shiftTm 1 0 I) (nfAt (np + 1) (tApps (tLams np D) (pvars np (np + 1)))) (.var 0))
                | _ => .mu 0 I D tl : Tm);
              let ty := sortTy (piTeleQ (match binderQs (kids (kid stx 3)) with
                | .some qs => qs
                | .none => .nil) pts (match sig with
                | .indexed _ => piH I (.univ 0)
                | _ => .univ 0));
              let val := markClosed (tLams np (body (mkD ds))) ty;
              match check empty val (eval .nil ty) with
              | .err m => errStep gs m
              | .ok _ _ =>
                let valI := markClosed (tLams np (body (mkD dsI))) ty;
                -- (stage 21n: a private declaration's kernel name, in the terms it is
                -- built into)
                let Tn := Globals.declName gs T;
                let gs1 := Globals.add gs (.mk T .nil ty val valI .nil .nil);
                match addCtors T ps pts nidx I (.const Tn .nil .nil val ty) valI k (isStructCmd stx0) gs1 0 ctors with
                | .err => errStep gs "ill-typed constructor"
                | .ok gs2 cs => .mk (String.append T (String.append " : " (show .nil 0 ty)))
                    (Globals.addInd gs2 T (.mk np I (mkD ds) (mkD dsI) cs .none (.const Tn .nil .nil val ty) (kids (kid stx 3))))
                | .err => errStep gs "ill-typed constructor"
                | .ok gs2 cs => .mk (String.append T (String.append " : " (show .nil 0 ty)))
                    (Globals.addInd gs2 T (.mk np I (mkD ds) (mkD dsI) cs .none (.const Tn .nil .nil val ty) (kids (kid stx 3))))
  | _ => errStep gs "an inductive type needs a name"

-- (U1) a data type's universe lives in its description (`descr l` takes a number), so
-- level-polymorphic data types wait for U2 (symbolic levels in descriptions)
def inductiveCmdS (gs : Globals) (stx0 : Syntax) (seal : Option Tm) : Step :=
  match hasUnivParams (univParamsOf stx0) with
  | .true => errStep gs "a universe-polymorphic data type needs symbolic levels in its description (U2)"
  | .false => inductiveCmdS0 gs stx0 seal

def sndN : Nat → Tm → Tm
  | .zero, t => t
  | .succ n, t => sndN n (.snd t)

def takeL {A : Type} : Nat → List A → List A
  | .zero, _ => .nil
  | .succ k, xs => match xs with
    | .nil => .nil
    | .cons x rest => .cons x (takeL k rest)
def dropL {A : Type} : Nat → List A → List A
  | .zero, xs => xs
  | .succ k, xs => match xs with
    | .nil => .nil
    | .cons _ rest => dropL k rest

-- Typed elaboration (stage 17): implicit arguments. A metavariable `?mN` is an opaque
-- constant (the kernel's `axiomC`) of type `Π Γ. A`, applied to the variables of the
-- context `Γ` where it was made, so a solution is a term over `Γ`. Unification solves
-- `?mN Γ =?= t` when `t` lives in `Γ`; elaborated terms are zonked (the solutions put
-- in) before the kernel checks them.

-- an elaboration context: the kernel's (values, types) and the names
-- (and the binders' types quoted, latest first, each when first needed: a new
-- metavariable's type is a Π over the whole context, and quoting every type again for
-- each one made big definitions run out of memory: stage 20b)
inductive Cx where
  | mk (c : TCtx) (sc : Scope) (tele : List (Unit → Tm))
def Cx.c : Cx → TCtx
  | .mk c _ _ => c
def Cx.sc : Cx → Scope
  | .mk _ sc _ => sc
def Cx.tele : Cx → List (Unit → Tm)
  | .mk _ _ t => t
def Cx.lvl (cx : Cx) : Nat := TCtx.lvl (Cx.c cx)
def Cx.bind (cx : Cx) (x : String) (ty : Val) : Cx := match cx with
  | .mk c sc t =>
    let d := TCtx.lvl c;
    .mk (TCtx.bind c ty) (Scope.bind sc x) (.cons (memo (fun _ => quote d ty)) t)
-- (a `let`'s variable is glued to its value: it quotes back as the variable, so the
-- metavariables applied to the context don't carry every `let`'s value along)
def Cx.define (cx : Cx) (x : String) (v ty : Val) : Cx := match cx with
  | .mk c sc t =>
    let d := TCtx.lvl c;
    .mk (TCtx.define c (.vglued (.hvar d) .snil (memo (fun _ => v))) ty) (Scope.bind sc x) (.cons (memo (fun _ => quote d ty)) t)
-- the metavariables: the depth each was made at, its solution (a term at that depth),
-- and, for an implicit argument that is a type (`{A : Type u}`), the sort its solution
-- must be in (`noteImplicitType` in `Elab/Term.lean`: the level constraint that solves
-- `?u` once the argument is known, as in `id 5`)
inductive MetaInfo where
  | mk (depth : Nat) (sol : Option Tm) (sconstr : Option Lvl)
-- a postponed argument: its syntax, type and context, and the metavariable standing for it
inductive Pend where
  | mk (s : Syntax) (dom : Val) (m : Tm) (cx : Cx)
-- (A10) a class problem: the metavariable standing for the instance, the class type
-- `C a…` it must have (at the context `cx`), and that context (for local instances and
-- error messages). Resolution (`resolveInstances`) solves them before a command ends.
inductive PInst where
  | mk (hole : Tm) (ty : Val) (cx : Cx)
-- the elaborator's state: the term metavariables, the postponed arguments, the level
-- metavariables (U1: their solution, `none` while unsolved), the current
-- declaration's universe parameters (`._ {u}` on it), and (A10) the class problems
inductive ES where
  | mk (metas : Array MetaInfo) (pending : List Pend) (lmetas : Array (Option Lvl)) (lparams : List String) (insts : List PInst)
def ES.empty : ES := .mk Array.empty .nil Array.empty .nil .nil
def ES.get (es : ES) (i : Nat) : MetaInfo := match es with
  | .mk ms _ _ _ _ => Array.getD ms i (.mk 0 .none .none)
-- an implicit type argument's sort constraint (see `MetaInfo`)
def metaSconstr (es : ES) (i : Nat) : Option Lvl := match ES.get es i with
  | .mk _ _ sc => sc
def ES.pend (es : ES) (p : Pend) : ES := match es with
  | .mk ms ps ls lps ins => .mk ms (.cons p ps) ls lps ins
-- (A10) a new class problem
def ES.pinst (es : ES) (p : PInst) : ES := match es with
  | .mk ms ps ls lps ins => .mk ms ps ls lps (.cons p ins)
def ES.insts : ES → List PInst
  | .mk _ _ _ _ ins => ins
def ES.noInst : ES → ES
  | .mk ms ps ls lps _ => .mk ms ps ls lps .nil
-- a level metavariable's solution (`none` while unsolved)
def ES.getLvl (es : ES) (i : Nat) : Option Lvl := match es with
  | .mk _ _ ls _ _ => Array.getD ls i .none
def ES.setLvl (es : ES) (i : Nat) (l : Lvl) : ES := match es with
  | .mk ms ps ls lps ins => .mk ms ps (Array.set ls i (.some l)) lps ins
-- solving a level metavariable (a later `zonk` puts its solution in)
def ES.solveLvl (es : ES) (i : Nat) (l : Lvl) : ES := ES.setLvl es i l
-- the universe parameters of the declaration being elaborated (`.{u, v}`)
def ES.params (es : ES) : List String := match es with
  | .mk _ _ _ lps _ => lps
def ES.withParams (es : ES) (ps : List String) : ES := match es with
  | .mk ms pend ls _ ins => .mk ms pend ls ps ins
-- a fresh level metavariable
inductive LvlR where
  | mk (l : Lvl) (es : ES)
def newLvl (es : ES) : LvlR := match es with
  | .mk ms ps ls lps ins =>
    let id := Array.size ls;
    .mk (.lmvar id) (.mk ms ps (Array.push ls .none) lps ins)
-- `n` fresh level metavariables
inductive LvlsR where
  | mk (ls : List Lvl) (es : ES)
def freshLvls : ES → Nat → LvlsR
  | es, .zero => .mk .nil es
  | es, .succ n => match newLvl es with
    | .mk l es1 => match freshLvls es1 n with
      | .mk rest es2 => .mk (.cons l rest) es2
-- the solutions of the level metavariables put in (a solved one is replaced by its
-- solution; an unsolved one stays, for `zonk` to report)
partial def instLvl (es : ES) : Lvl → Lvl
  | .lmvar i => match ES.getLvl es i with
    | .some l => instLvl es l
    | .none => .lmvar i
  | .lsucc l => .lsucc (instLvl es l)
  | .lmax a b => .lmax (instLvl es a) (instLvl es b)
  | .limax a b => .limax (instLvl es a) (instLvl es b)
  | l => l
def instLvls (es : ES) : List Lvl → List Lvl
  | .nil => .nil
  | .cons l rest => .cons (instLvl es l) (instLvls es rest)
-- does the level mention metavariable `i`?
def lvlOccurs (i : Nat) : Lvl → Bool
  | .lmvar j => Nat.beq i j
  | .lsucc l => lvlOccurs i l
  | .lmax a b => Bool.or (lvlOccurs i a) (lvlOccurs i b)
  | .limax a b => Bool.or (lvlOccurs i a) (lvlOccurs i b)
  | _ => .false
-- `l` as `l' + 1` (`1` is `succ 0`: numerals are not `succ` chains)
def lvlSucc : Lvl → Option Lvl
  | .lnum n => match n with
    | .zero => .none
    | .succ m => .some (.lnum m)
  | .lsucc l => .some l
  | _ => .none
-- unify two levels (`unifyLevel` in `Elab/Unify.lean`): equivalent levels succeed, a lone
-- metavariable is assigned, `a+1 =?= b+1` recurses, and anything else is a mismatch. (A
-- metavariable is never split: `max ?u ?v =?= 1` fails, as in the self-hosted port's
-- documented subset.)
partial def unifyLevel (es : ES) (a b : Lvl) : Option ES :=
  let a' := instLvl es a;
  let b' := instLvl es b;
  match lvlEquiv a' b' with
  | .true => .some es
  | .false => match a' with
    | .lmvar m => match lvlOccurs m b' with
      | .true => .none
      | .false => .some (ES.solveLvl es m b')
    | _ => match b' with
      | .lmvar m => match lvlOccurs m a' with
        | .true => .none
        | .false => .some (ES.solveLvl es m a')
      | _ => match lvlSucc a' with
        | .some x => match lvlSucc b' with
          | .some y => unifyLevel es x y
          | .none => .none
        | .none => .none
-- `l + n`
def addLvl : Lvl → Nat → Lvl
  | l, .zero => l
  | l, .succ n => .lsucc (addLvl l n)
def metaName (i : Nat) : String := String.append "?m" (Nat.toString i)
-- the number of a metavariable's name
def metaId (n : String) : Option Nat := match n with
  | .mk cs => match cs with
    | .cons a (.cons b rest) => match Bool.and (Nat.beq (Char.code a) 63) (Nat.beq (Char.code b) 109) with
      | .true => .some (digits rest 0)
      | .false => .none
    | _ => .none
-- the types of the context's variables as a telescope, from level `l` on
def teleOf : List (Unit → Tm) → Tms → Tms
  | .nil, acc => acc
  | .cons t rest, acc => teleOf rest (.tcons (t ()) acc)
-- a new metavariable of type `A`, as a term: `?mN x₀ … xₙ₋₁`
inductive MetaR where
  | mk (t : Tm) (es : ES)
def newMetaS (es : ES) (cx : Cx) (A : Val) (sc : Option Lvl) : MetaR := match es with
  | .mk ms ps ls lps ins =>
    let d := Cx.lvl cx;
    let id := Array.size ms;
    let ty := piTele (teleOf (Cx.tele cx) .tnil) (quote d A);
    .mk (tApps (.axiomC (metaName id) ty) (pvars d d)) (.mk (Array.push ms (.mk d .none sc)) ps ls lps ins)
def newMeta (es : ES) (cx : Cx) (A : Val) : MetaR := newMetaS es cx A .none

-- a spine's arguments, first first (`none` if it isn't only applications)
def spineArgs : Spine → Option (List Val)
  | .snil => .some .nil
  | .sapp sp a => match spineArgs sp with
    | .some as => .some (List.append as (.cons a .nil))
    | .none => .none
  | _ => .none
def envOf : List Val → Env → Env
  | .nil, acc => acc
  | .cons a rest, acc => envOf rest (.cons a acc)
def applyAll : Val → List Val → Val
  | f, .nil => f
  | f, .cons a rest => applyAll (vapp f a) rest
-- a solved metavariable's application, replaced by its solution. Level metavariables are
-- solved after the values that mention them were built, so a forced value is rebuilt
-- with their solutions in every level it carries (the frontend's `instLevel`).
partial def force (es : ES) (v : Val) : Val := match whnf v with
  | .vne (.haxiom n _) sp => match metaId n with
    | .some i => match ES.get es i with
      | .mk k (.some sol) _ => match spineArgs sp with
        | .some as => force es (applyAll (eval (envOf (takeL k as) .nil) sol) (dropL k as))
        | .none => v
      | _ => v
    | .none => v
  | .vsort l => .vsort (instLvl es l)
  | .vglued (.hconst n ps ls val ty) sp _ =>
    let ls' := instLvls es ls;
    match lvlsEq ls ls' with
    | .true => v
    | .false => .vglued (.hconst n ps ls' val ty) sp (memo (fun _ => eval .nil (substIfAny ps ls' val)))
  | .vpi q i j dom env cod => .vpi q (instLvl es i) (instLvl es j) dom env cod
  | .vsigma q i j fst env snd => .vsigma q (instLvl es i) (instLvl es j) fst env snd
  | _ => v
-- an unsolved metavariable applied to its context: its number and depth
inductive MetaApp where
  | mk (i k : Nat)
  | none
def metaApp (es : ES) (v : Val) : MetaApp := match v with
  | .vne (.haxiom n _) sp => match metaId n with
    | .some i => match ES.get es i with
      | .mk k .none _ => match spineArgs sp with
        | .some as => match Nat.beq (List.length as) k with
          | .true => .mk i k
          | .false => .none
        | .none => .none
      | _ => .none
    | .none => .none
  | _ => .none
-- a term at depth `d` moved to depth `d - k`, if it doesn't use the `k` variables in
-- between (only for the forms solutions take)
def lowerTm (k : Nat) : Nat → Tm → Option Tm
  | c, .var i => match Nat.lt i c with
    | .true => .some (.var i)
    | .false => match Nat.lt (i - c) k with
      | .true => .none
      | .false => .some (.var (i - k))
  | c, .pi q i j a b => match lowerTm k c a with
    | .some a' => match lowerTm k (c + 1) b with
      | .some b' => .some (.pi q i j a' b')
      | .none => .none
    | .none => .none
  | c, .lam b => match lowerTm k (c + 1) b with
    | .some b' => .some (.lam b')
    | .none => .none
  | c, .app f a => match lowerTm k c f with
    | .some f' => match lowerTm k c a with
      | .some a' => .some (.app f' a')
      | .none => .none
    | .none => .none
  -- (projections and pairs: the fields of a pattern are projections of its payload)
  | c, .fst t => match lowerTm k c t with
    | .some t' => .some (.fst t')
    | .none => .none
  | c, .snd t => match lowerTm k c t with
    | .some t' => .some (.snd t')
    | .none => .none
  | c, .con t => match lowerTm k c t with
    | .some t' => .some (.con t')
    | .none => .none
  | c, .pair a b => match lowerTm k c a with
    | .some a' => match lowerTm k c b with
      | .some b' => .some (.pair a' b')
      | .none => .none
    | .none => .none
  | _, .const n ps ls v ty => .some (.const n ps ls v ty)
  | _, .axiomC n ty => .some (.axiomC n ty)
  | _, .univ n => .some (.univ n)
  | _, .prop => .some .prop
  | _, .sortL l => .some (.sortL l)
  | _, .unit n => .some (.unit n)
  | _, .star => .some .star
  | _, .enum k => .some (.enum k)
  | _, .tag k i => .some (.tag k i)
  | _, _ => .none
-- does the term mention metavariable `i`?
def mentions (i : Nat) : Tm → Bool
  | .axiomC n _ => match metaId n with
    | .some j => Nat.beq i j
    | .none => .false
  | .pi _ _ _ a b => Bool.or (mentions i a) (mentions i b)
  | .lam b => mentions i b
  | .app f a => Bool.or (mentions i f) (mentions i a)
  | .fst t => mentions i t
  | .snd t => mentions i t
  | .con t => mentions i t
  | .pair a b => Bool.or (mentions i a) (mentions i b)
  | _ => .false
-- Pruning (stage 20a): a solution at depth `k` that mentions a metavariable of a deeper
-- context (`?m := List ?n` with `?n` made under more `let`s) can't be lowered; when that
-- metavariable's type doesn't depend on the deeper variables, it is solved by a new one
-- at depth `k`, applied to the first `k` variables, and the solution is lowered again
def piCod : Nat → Tm → Option Tm
  | .zero, t => .some t
  | .succ n, t => match t with
    | .pi .qw _ _ _ b => piCod n b
    | _ => .none
def piPrefix : Nat → Tm → Tm → Option Tm
  | .zero, _, B => .some B
  | .succ n, t, B => match t with
    | .pi .qw i j a b => match piPrefix n b B with
      | .some r => .some (.pi .qw i j a r)
      | .none => .none
    | _ => .none
def spineHead : Tm → Tm
  | .app f _ => spineHead f
  | t => t
def spineArgsTm : Tm → List Tm → List Tm
  | .app f a, acc => spineArgsTm f (.cons a acc)
  | _, acc => acc
def appsL : Tm → List Tm → Tm
  | f, .nil => f
  | f, .cons a rest => appsL (.app f a) rest
inductive Pruned where
  | mk (es : ES) (t : Tm)
-- prune the deeper metavariables in `t` (applications, Π types and the like)
partial def pruneTm (k d : Nat) (es : ES) (t : Tm) : Pruned := match spineHead t with
  | .axiomC n ty => match metaId n with
    | .some j => match ES.get es j with
      -- (a solved one is replaced by its solution first)
      | .mk _ (.some _) _ => pruneTm k d es (quote d (force es (eval (freshEnv d) t)))
      | .mk kj .none sc => match Nat.lt k kj with
        | .true => match piCod kj ty with
          | .some A => match lowerTm (kj - k) 0 A with
            | .some Ak => match piPrefix k ty Ak with
              | .some nty => match es with
                | .mk ms ps ls lps ins =>
                  let id := Array.size ms;
                  let fresh : Tm := .axiomC (metaName id) nty;
                  let ms1 := Array.push ms (.mk k .none .none);
                  .mk (.mk (Array.set ms1 j (.mk kj (.some (tApps fresh (pvars k kj))) sc)) ps ls lps ins)
                    (appsL fresh (takeL k (spineArgsTm t .nil)))
              | .none => .mk es t
            | .none => .mk es t
          | .none => .mk es t
        | .false => .mk es t
      | _ => .mk es t
    | .none => .mk es t
  | _ => match t with
    | .app f a => match pruneTm k d es f with
      | .mk es1 f' => match pruneTm k d es1 a with
        | .mk es2 a' => .mk es2 (.app f' a')
    | .pi q i j a b => match pruneTm k d es a with
      | .mk es1 a' => match pruneTm k (d + 1) es1 b with
        | .mk es2 b' => .mk es2 (.pi q i j a' b')
    | .lam b => match pruneTm k (d + 1) es b with
      | .mk es1 b' => .mk es1 (.lam b')
    | t' => .mk es t'
def solve (es0 : ES) (cx : Cx) (i k : Nat) (t : Val) : Option ES :=
  let d := Cx.lvl cx;
  let tm0 := quote d t;
  let pr := match lowerTm (d - k) 0 tm0 with
    | .some _ => Pruned.mk es0 tm0
    | .none => pruneTm k d es0 tm0;
  match pr with
  | .mk es tm =>
  match mentions i tm with
  | .true => .none
  -- (at the metavariable's own depth nothing is lowered: any term will do, like a
  -- postponed `match` argument's: stage 20a)
  | .false => match (match Nat.beq d k with
      | .true => Option.some tm
      | .false => lowerTm (d - k) 0 tm) with
    | .some sol => match es with
      | .mk ms ps ls lps ins =>
        let sc := metaSconstr es i;
        let es1 : ES := .mk (Array.set ms i (.mk k (.some sol) sc)) ps ls lps ins;
        -- (an implicit type argument's sort: the solution must be in it, which solves
        -- the universe level it mentions)
        match sc with
        | .none => .some es1
        | .some l => match sortOf (Cx.c cx) t with
          | .none => .none
          | .some sl => unifyLevel es1 sl l
    | .none => .none
mutual
-- unify two values (types, mostly) at depth `cx`, solving metavariables
def unify (es : ES) (cx : Cx) (a b : Val) : Option ES :=
  let a' := force es a;
  let b' := force es b;
  match metaApp es a' with
  | .mk i k => match metaApp es b' with
    | .mk j _ => match Nat.beq i j with
      | .true => .some es
      | .false => solve es cx i k b'
    | .none => solve es cx i k b'
  | .none => match metaApp es b' with
    | .mk j k => solve es cx j k a'
    | .none => unifyW es cx a' b'
def unifyW (es : ES) (cx : Cx) (a b : Val) : Option ES := match a with
  | .vglued h sp va => match b with
    | .vglued h' sp' vb => match convHead (Cx.c cx) h h' with
      | .true => match unifySpine es cx sp sp' with
        | .some es' => .some es'
        | .none => unifyS es cx (whnf a) (whnf b)
      -- different definitions: unfold one step while one side unfolds to another
      -- definition (`Syntax` is `SyntaxF .true`: stage 19d)
      | .false => match va () with
        | .vglued _ _ _ => unifyW es cx (va ()) b
        | _ => match vb () with
          | .vglued _ _ _ => unifyW es cx a (vb ())
          | _ => unifyS es cx (whnf a) (whnf b)
    | _ => unifyS es cx (whnf a) (whnf b)
  | _ => unifyS es cx (whnf a) (whnf b)
def unifyS (es : ES) (cx : Cx) (a b : Val) : Option ES := match a with
  | .vsort l => match b with
    | .vsort l' => unifyLevel es l l'
    | _ => unifyConv es cx a b
  | .vpi q _ _ A e B => match b with
    | .vpi q' _ _ A' e' B' => match qEq q q' with
      | .true => match unify es cx A A' with
        | .some es1 =>
          let x := fresh (Cx.lvl cx);
          unify es1 (Cx.bind cx "_" A) (eval (.cons x e) B) (eval (.cons x e') B')
        | .none => .none
      | .false => .none
    | _ => unifyConv es cx a b
  | .vne h sp => match b with
    | .vne h' sp' => match convHead (Cx.c cx) h h' with
      | .true => unifySpine es cx sp sp'
      | .false => .none
    | _ => unifyConv es cx a b
  | _ => unifyConv es cx a b
-- (no metavariables left to solve: the kernel's conversion)
def unifyConv (es : ES) (cx : Cx) (a b : Val) : Option ES := match convTy (Cx.c cx) a b with
  | .true => .some es
  | .false => .none
def unifySpine (es : ES) (cx : Cx) (sp sp' : Spine) : Option ES := match sp with
  | .snil => match sp' with
    | .snil => .some es
    | _ => .none
  | .sapp r a => match sp' with
    | .sapp r' a' => match unifySpine es cx r r' with
      | .some es1 => unify es1 cx a a'
      | .none => .none
    | _ => .none
  | _ => .none
end

-- put the solutions into a term (at depth `d`): `none` if a metavariable is unsolved
inductive MH where
  | mk (i n : Nat)
  | none
def metaHead : Tm → Nat → MH
  | .axiomC n _, k => match metaId n with
    | .some i => .mk i k
    | .none => .none
  | .app f _, k => metaHead f (k + 1)
  | _, _ => .none
def appArgs : Tm → List Tm → List Tm
  | .app f a, acc => appArgs f (.cons a acc)
  | _, acc => acc
def tAppsL : Tm → List Tm → Tm
  | f, .nil => f
  | f, .cons a rest => tAppsL (.app f a) rest
def tms6 (a b c e f g : Tm) : Tms := .tcons a (.tcons b (.tcons c (.tcons e (.tcons f (.tcons g .tnil)))))
mutual
def zonk (es : ES) (d : Nat) (t : Tm) : Option Tm := match metaHead t 0 with
  | .mk i _ => match ES.get es i with
    | .mk k (.some sol) _ => match zonk es k sol with
      | .some sol' =>
        let extra := dropL k (appArgs t .nil);
        match extra with
        | .nil => .some (shiftTm (d - k) 0 sol')
        | _ => match zonkAll es d extra with
          | .some extra' => .some (nfAt d (tAppsL (shiftTm (d - k) 0 sol') extra'))
          | .none => .none
      | .none => .none
    | _ => .none
  | .none => match t with
    | .pi q i j a b => match zonk es d a with
      | .some a' => match zonk es (d + 1) b with
        | .some b' => .some (.pi q (instLvl es i) (instLvl es j) a' b')
        | .none => .none
      | .none => .none
    | .lam b => match zonk es (d + 1) b with
      | .some b' => .some (.lam b')
      | .none => .none
    | .app f a => match zonk es d f with
      | .some f' => match zonk es d a with
        | .some a' => .some (.app f' a')
        | .none => .none
      | .none => .none
    | .letE ty v b => match zonk es d ty with
      | .some ty' => match zonk es d v with
        | .some v' => match zonk es (d + 1) b with
          | .some b' => .some (.letE ty' v' b')
          | .none => .none
        | .none => .none
      | .none => .none
    | .ann x ty => match zonk es d x with
      | .some x' => match zonk es d ty with
        | .some ty' => .some (.ann x' ty')
        | .none => .none
      | .none => .none
    -- (the other forms a match or a postponed argument leaves: stage 20a)
    | .sigma q i j a b => match zonk es d a with
      | .some a' => match zonk es (d + 1) b with
        | .some b' => .some (.sigma q (instLvl es i) (instLvl es j) a' b')
        | .none => .none
      | .none => .none
    | .letq q ty v b => match zonk es d ty with
      | .some ty' => match zonk es d v with
        | .some v' => match zonk es (d + 1) b with
          | .some b' => .some (.letq q ty' v' b')
          | .none => .none
        | .none => .none
      | .none => .none
    | .ecase m sc bs => match zonk es (d + 1) m with
      | .some m' => match zonk es d sc with
        | .some sc' => match zonkTms es d bs with
          | .some bs' => .some (.ecase m' sc' bs')
          | .none => .none
        | .none => .none
      | .none => .none
    | .ind l I D v P m i x => match zonkTms es d (tms6 I D P m i x) with
      | .some ts => match ts with
        | .tcons I' (.tcons D' (.tcons P' (.tcons m' (.tcons i' (.tcons x' _))))) => .some (.ind l I' D' v P' m' i' x')
        | _ => .none
      | .none => .none
    | .scase l q I D v P m sz i x => match zonkTms es d (.tcons sz (tms6 I D P m i x)) with
      | .some ts => match ts with
        | .tcons sz' (.tcons I' (.tcons D' (.tcons P' (.tcons m' (.tcons i' (.tcons x' _)))))) => .some (.scase l q I' D' v P' m' sz' i' x')
        | _ => .none
      | .none => .none
    | t' => match zonkSub es d t' with
      | .some t'' => .some t''
      | .none => .none
-- the forms whose parts are all at the same depth
def zonkSub (es : ES) (d : Nat) (t : Tm) : Option Tm := match t with
  | .fst x => zonk1 es d x (fun x' => .fst x')
  | .snd x => zonk1 es d x (fun x' => .snd x')
  | .con x => zonk1 es d x (fun x' => .con x')
  | .dret i => zonk1 es d i (fun i' => .dret i')
  | .tyRefl X => zonk1 es d X (fun X' => .tyRefl X')
  | .pair a b => zonk2 es d a b (fun a' b' => .pair a' b')
  | .darg q S D => zonk2 es d S D (fun S' D' => .darg q S' D')
  | .sigmaQ q i j a b => match zonkTms es d (.tcons q (.tcons a (.tcons b .tnil))) with
    | .some (.tcons q' (.tcons a' (.tcons b' _))) => .some (.sigmaQ q' (instLvl es i) (instLvl es j) a' b')
    | _ => .none
  | .sortL l => .some (.sortL (instLvl es l))
  | .const n ps ls v ty => .some (.const n ps (instLvls es ls) v ty)
  | .prf l x => zonk1 es d x (fun x' => .prf (instLvl es l) x')
  | .drec q j D => zonk2 es d j D (fun j' D' => .drec q j' D')
  | .eqTy A B => zonk2 es d A B (fun A' B' => .eqTy A' B')
  | .eqRefl A a => zonk2 es d A a (fun A' a' => .eqRefl A' a')
  | .exfalso m x => zonk2 es d m x (fun m' x' => .exfalso m' x')
  | .letUnit u b => zonk2 es d u b (fun u' b' => .letUnit u' b')
  | .eq A a b => match zonkTms es d (.tcons A (.tcons a (.tcons b .tnil))) with
    | .some (.tcons A' (.tcons a' (.tcons b' _))) => .some (.eq A' a' b')
    | _ => .none
  | .mu l I D i => match zonkTms es d (.tcons I (.tcons D (.tcons i .tnil))) with
    | .some (.tcons I' (.tcons D' (.tcons i' _))) => .some (.mu l I' D' i')
    | _ => .none
  | .coe A B e x => match zonkTms es d (.tcons A (.tcons B (.tcons e (.tcons x .tnil)))) with
    | .some (.tcons A' (.tcons B' (.tcons e' (.tcons x' _)))) => .some (.coe A' B' e' x')
    | _ => .none
  | .out x => zonk1 es d x (fun x' => .out x')
  | .cocon x => zonk1 es d x (fun x' => .cocon x')
  | .delim v P mr ma mc mh D => match zonkTms es d (tms6 P mr ma mc mh D) with
    | .some (.tcons P' (.tcons mr' (.tcons ma' (.tcons mc' (.tcons mh' (.tcons D' _)))))) => .some (.delim v P' mr' ma' mc' mh' D')
    | _ => .none
  | .nu l I D i sz => match zonkTms es d (.tcons I (.tcons D (.tcons i (.tcons sz .tnil)))) with
    | .some (.tcons I' (.tcons D' (.tcons i' (.tcons sz' _)))) => .some (.nu l I' D' i' sz')
    | _ => .none
  | .szSuc x => zonk1 es d x (fun x' => .szSuc x')
  | .sizeLt x => zonk1 es d x (fun x' => .sizeLt x')
  | .descr l I => zonk1 es d I (fun I' => .descr l I')
  | .dhrec q H j D => match zonkTms es d (.tcons H (.tcons j (.tcons D .tnil))) with
    | .some (.tcons H' (.tcons j' (.tcons D' _))) => .some (.dhrec q H' j' D')
    | _ => .none
  | .mus l I D i sz => match zonkTms es d (.tcons I (.tcons D (.tcons i (.tcons sz .tnil)))) with
    | .some (.tcons I' (.tcons D' (.tcons i' (.tcons sz' _)))) => .some (.mus l I' D' i' sz')
    | _ => .none
  | .subst A a P p b e => match zonkTms es d (tms6 A a P p b e) with
    | .some (.tcons A' (.tcons a' (.tcons P' (.tcons p' (.tcons b' (.tcons e' _)))))) => .some (.subst A' a' P' p' b' e')
    | _ => .none
  | t' => .some t'
def zonk1 (es : ES) (d : Nat) (x : Tm) (k : Tm → Tm) : Option Tm := match zonk es d x with
  | .some x' => .some (k x')
  | .none => .none
def zonk2 (es : ES) (d : Nat) (x y : Tm) (k : Tm → Tm → Tm) : Option Tm := match zonk es d x with
  | .some x' => match zonk es d y with
    | .some y' => .some (k x' y')
    | .none => .none
  | .none => .none
def zonkTms (es : ES) (d : Nat) : Tms → Option Tms
  | .tnil => .some .tnil
  | .tcons t rest => match zonk es d t with
    | .some t' => match zonkTms es d rest with
      | .some r => .some (.tcons t' r)
      | .none => .none
    | .none => .none
def zonkAll (es : ES) (d : Nat) : List Tm → Option (List Tm)
  | .nil => .some .nil
  | .cons t rest => match zonk es d t with
    | .some t' => match zonkAll es d rest with
      | .some r => .some (.cons t' r)
      | .none => .none
    | .none => .none
end

inductive HE where
  | ok (t : Tm) (ty : Val) (es : ES) (mask : List BKind)
  | err (msg : String)
-- the arguments of `if`: before `then`, between `then` and `else`, after `else`
inductive IfParts where
  | mk (c a b : List Syntax)
def isNilS : List Syntax → Bool
  | .nil => .true
  | .cons _ _ => .false
inductive Two where
  | mk (a b : List Syntax)
-- the `else` of the `if` whose `then` has just been read. A nested unparenthesised
-- `if … then … else …` in the then branch owns its `else` (the dangling else), so skip
-- it: the flat application spine has no other nesting information.
partial def splitElse (depth : Nat) : List Syntax → List Syntax → Option Two
  | .nil, _ => .none
  | .cons x rest, acc => match strEq (identOf x) "if" with
    | .true => splitElse (depth + 1) rest (.cons x acc)
    | .false => match strEq (identOf x) "else" with
      | .true => match Nat.beq depth 0 with
        | .true => .some (.mk (List.reverseOf acc .nil) rest)
        | .false => splitElse (depth - 1) rest (.cons x acc)
      | .false => splitElse depth rest (.cons x acc)
-- the `then` of the `if` whose condition is being read: a nested `if … then … else …`
-- in the condition is skipped whole
partial def findThen (depth : Nat) : List Syntax → List Syntax → Option Two
  | .nil, _ => .none
  | .cons x rest, acc => match strEq (identOf x) "then" with
    | .true => match Nat.beq depth 0 with
      | .true => .some (.mk (List.reverseOf acc .nil) rest)
      | .false => findThen depth rest (.cons x acc)
    | .false => match strEq (identOf x) "if" with
      | .true => findThen (depth + 1) rest (.cons x acc)
      | .false => match strEq (identOf x) "else" with
        | .true => match Nat.beq depth 0 with
          | .true => .none
          | .false => findThen (depth - 1) rest (.cons x acc)
        | .false => findThen depth rest (.cons x acc)
def splitIf (tokens : List Syntax) : Option IfParts :=
  match findThen 0 tokens .nil with
  | .some (.mk cs rest) => match splitElse 0 rest .nil with
    | .some (.mk a b) => .some (.mk cs a b)
    | .none => .none
  | .none => .none
-- one term, or the application of the first to the rest
def appOf : List Syntax → Syntax
  | .nil => .missing
  | .cons f rest => match rest with
    | .nil => f
    | .cons _ _ => mkNode "term.app" (.cons f (one (mkNull rest)))
-- `if c then a else b` is `match c with | .true => a | .false => b` (stage 19a)
def iteMatch (c a b : Syntax) : Syntax :=
  let alt := fun (ctor : String) (rhs : Syntax) => mkNode "match.alt" (.cons (.atom "|")
    (.cons (mkNull (one (mkNode "term.dotIdent" (.cons (.atom ".") (one (.ident ctor)))))) (.cons (.atom "=>") (one rhs))));
  mkNode "term.match" (.cons (.atom "match") (.cons (mkNull (one c)) (.cons (.atom "with")
    (one (mkNull (.cons (alt "true" a) (one (alt "false" b))))))))
-- The grammar's `if` (`term.ite`: `"if" term "then" term "else" term`), and the older
-- application form (when the surface rule is not in the tables), are both accepted.
def ifMatch (s : Syntax) : Option Syntax := match strEq (kindOf s) "term.ite" with
  | .true => .some (iteMatch (kid s 1) (kid s 3) (kid s 5))
  | .false => match Bool.and (strEq (kindOf s) "term.app") (strEq (identOf (kid s 0)) "if") with
    | .false => .none
    | .true => match splitIf (kids (kid s 1)) with
      | .some (.mk cs as bs) => match Bool.and (Bool.not (isNilS cs)) (Bool.and (Bool.not (isNilS as)) (Bool.not (isNilS bs))) with
        | .true => .some (iteMatch (appOf cs) (appOf as) (appOf bs))
        | .false => .none
      | _ => .none
-- a string literal's text (the first atom inside)
partial def strValue (s : Syntax) : String := match s with
  | .atom v => v
  | .node _ _ => strValue (kid s 0)
  | _ => ""
-- a numeral's value (its digits are the first atom inside)
partial def numValue (s : Syntax) : Nat := match s with
  | .atom d => match d with
    | .mk cs => digits cs 0
  | .node _ _ => numValue (kid s 0)
  | _ => 0
-- A numeral from 2^63 is an error: the numbers of a program this compiler compiles (and
-- of the compiler itself, once it has compiled itself) are 63-bit words, so the numeral
-- would silently be its value modulo 2^63. Decided on the digits, not on the value, which
-- has wrapped already when the compiler's own numbers are words (stage 15g).
partial def numDigits (s : Syntax) : List Char := match s with
  | .atom d => match d with
    | .mk cs => cs
  | .node _ _ => numDigits (kid s 0)
  | _ => .nil
def dropZeros : List Char → List Char
  | .nil => .nil
  | .cons c cs => match Nat.beq (Char.code c) 48 with
    | .true => dropZeros cs
    | .false => .cons c cs
-- `xs > ys`, for digits of the same length
def digitsGt : List Char → List Char → Bool
  | .cons x xs, .cons y ys => match Nat.lt (Char.code y) (Char.code x) with
    | .true => .true
    | .false => match Nat.lt (Char.code x) (Char.code y) with
      | .true => .false
      | .false => digitsGt xs ys
  | _, _ => .false
def numTooBig (s : Syntax) : Bool :=
  let ds := dropZeros (numDigits s);
  let n := List.length ds;
  match Nat.lt 19 n with
  | .true => .true
  | .false => match Nat.beq n 19 with
    | .true => match "9223372036854775807" with
      | .mk m => digitsGt ds m
    | .false => .false
def iterApp (f : Tm) : Nat → Tm → Tm
  | .zero, t => t
  | .succ k, t => iterApp f k (.app f t)
-- (a big numeral is built in binary when `Nat.mul` is there: `2 * (n / 2)`, plus one if
-- `n` is odd; `succ` applied 100000 times would be a term of that depth: stage 19f.
-- The half is `Nat.div`, a native operation in both compilers: halving by recursion on
-- `succ (succ j)` was `n / 2` frames deep, and a numeral like 1000000000 overflowed the
-- stack of the compiler compiling it: stage 15g)
partial def binNat (sc z mul : Tm) (n : Nat) : Tm := match Nat.lt n 16 with
  | .true => iterApp sc n z
  | .false =>
    let h := Nat.div n 2;
    let t : Tm := .app (.app mul (iterApp sc 2 z)) (binNat sc z mul h);
    match Nat.beq (h + h) n with
    | .true => t
    | .false => .app sc t
-- `a.b.c` as `a.b` and `c`
inductive Split where
  | mk (base field : String)
def lastDot : List Char → Nat → Option Nat → Option Nat
  | .nil, _, best => best
  | .cons c rest, i, best => lastDot rest (i + 1) (match Nat.beq (Char.code c) 46 with
    | .true => .some i
    | .false => best)
def splitLast (n : String) : Option Split := match n with
  | .mk cs => match lastDot cs 0 .none with
    | .some i => match Nat.lt 0 i with
      | .true => .some (.mk (.mk (takeL i cs)) (.mk (dropL (i + 1) cs)))
      | .false => .none
    | .none => .none
-- the arguments still waiting, while some can be done
inductive DR where
  | ok (es : ES) (progress : Bool)
  | err
-- a postponed argument: its syntax, type, and the metavariable standing for it
inductive Post where
  | mk (s : Syntax) (dom : Val) (m : Tm)
partial def unparen (s : Syntax) : Syntax := match strEq (kindOf s) "term.paren" with
  | .true => unparen (kid s 1)
  | .false => s
partial def isDotStx (s : Syntax) : Bool := match strEq (kindOf s) "term.paren" with
  | .true => isDotStx (kid s 1)
  | .false => match strEq (kindOf s) "term.dotIdent" with
    | .true => .true
    | .false => Bool.and (strEq (kindOf s) "term.app") (strEq (kindOf (kid s 0)) "term.dotIdent")
-- an argument that needs its expected type: `.c …`, and (stage 20a) a `match` or a `fun`
def postponable (a : Syntax) : Bool := Bool.or (isDotStx a) (Bool.or (strEq (kindOf (unparen a)) "term.match")
  (strEq (kindOf (unparen a)) "term.fun"))
def isMetaApp (es : ES) (ty : Val) : Bool := match metaApp es (force es ty) with
  | .mk _ _ => .true
  | .none => .false
-- a `fun` against a function type whose domain isn't known yet waits too: the other
-- arguments may fix it (`zipWith3 (fun b x y => …) c t e`; elab-postpone-lambdas)
def funDomMeta (es : ES) (a : Syntax) (ty : Val) : Bool := match strEq (kindOf (unparen a)) "term.fun" with
  | .true => match whnf (force es ty) with
    | .vpi _ _ _ d _ _ => isMetaApp es d
    | _ => .false
  | .false => .false
-- `.c` (or `.c a …`) against a type `T …`: `T.c`
-- (a type that is a definition, like `Syntax := SyntaxF .true`, is unfolded: stage 19d)
partial def dotName (gs : Globals) (es : ES) (ty : Val) (c : String) : Option String := match force es ty with
  | .vglued (.hconst T _ _ _ _) _ v => match Globals.ind gs T with
    | .some _ => .some (String.append (String.append T ".") c)
    | .none => match v () with
      | .vglued _ _ _ => dotName gs es (v ()) c
      | _ => .some (String.append (String.append T ".") c)
  | _ => .none
def dotCtor (gs : Globals) (es : ES) (ty : Val) (s : Syntax) : Option Syntax :=
  let ident := fun (n : String) => mkNode "term.ident" (one (.ident n));
  match strEq (kindOf s) "term.dotIdent" with
  | .true => match kid s 1 with
    | .ident c => match dotName gs es ty c with
      | .some n => .some (ident n)
      | .none => .none
    | _ => .none
  | .false => match Bool.and (strEq (kindOf s) "term.app") (strEq (kindOf (kid s 0)) "term.dotIdent") with
    | .true => match kid (kid s 0) 1 with
      | .ident c => match dotName gs es ty c with
        | .some n => .some (mkNode "term.app" (.cons (ident n) (one (kid s 1))))
        | .none => .none
      | _ => .none
    | .false => .none
-- the level of a sort
def sortLvl (es : ES) (ty : Val) : Lvl := match whnf (force es ty) with
  | .vsort l => l
  | _ => .lnum 0
-- an implicit argument's metavariable; when its type is a sort (`{A : Type u}`), the
-- solution's own sort is recorded, which solves the level (`id 5` has `?u = 0`)
def newImplicit (es : ES) (cx : Cx) (dom : Val) : MetaR := match whnf (force es dom) with
  | .vsort l => newMetaS es cx dom (.some l)
  | _ => newMeta es cx dom
-- ---------------------------------------------------------------------------------------
-- Universe levels (U1; `elabLevel` in `Elab/Term.lean`): `Type [l]`, `Sort [l]`, `Prop`
-- and a constant's `.{l, …}`. A `level.param` must be one of the declaration's universe
-- parameters (`.{u}` after its name); `_` is a fresh level metavariable.
inductive LR where
  | ok (l : Lvl) (es : ES)
  | err (msg : String)
partial def elabLevel (es : ES) (s : Syntax) : LR :=
  let k := kindOf s;
  match strEq k "level.num" with
  | .true => .ok (.lnum (numValue s)) es
  | .false => match strEq k "level.param" with
    | .true => match kid s 0 with
      | .ident u => match indexOf (ES.params es) u 0 with
        | .some _ => .ok (.lparam u) es
        | .none => .err (String.append (String.append "unknown universe level '" u) "'")
      | _ => .err "a universe level must be a name"
    | .false => match strEq k "level.hole" with
      | .true => match newLvl es with
        | .mk l es' => .ok l es'
      | .false => match strEq k "level.paren" with
        | .true => elabLevel es (kid s 1)
        | .false => match strEq k "level.max" with
          | .true => match elabLevel es (kid s 1) with
            | .err m => .err m
            | .ok a es1 => match elabLevel es1 (kid s 2) with
              | .err m => .err m
              | .ok b es2 => .ok (.lmax a b) es2
          | .false => match strEq k "level.imax" with
            | .true => match elabLevel es (kid s 1) with
              | .err m => .err m
              | .ok a es1 => match elabLevel es1 (kid s 2) with
                | .err m => .err m
                | .ok b es2 => .ok (.limax a b) es2
            | .false => match strEq k "level.add" with
              | .true => match elabLevel es (kid s 0) with
                | .err m => .err m
                | .ok a es1 => .ok (addLvl a (numValue (kid s 2))) es1
              | .false => .err (String.append "unsupported level syntax " k)
-- a list of explicit levels (`f.{l₁, …, lₙ}`)
inductive LvlsE where
  | ok (ls : List Lvl) (es : ES)
  | err (msg : String)
partial def elabLvls (es : ES) : List Syntax → LvlsE
  | .nil => .ok .nil es
  | .cons s rest => match elabLevel es s with
    | .err m => .err m
    | .ok l es1 => match elabLvls es1 rest with
      | .err m => .err m
      | .ok ls es2 => .ok (.cons l ls) es2
-- the level argument of `Type l`/`Sort l` (absent: `dflt`)
def levelArg (es : ES) (s : Syntax) (dflt : Lvl) : LR := match kids (kid s 1) with
  | .nil => .ok dflt es
  | .cons l _ => elabLevel es l
-- `(x : a) → b` with its components' sorts, where known (a hole for the others)
def sortOrHole (es : ES) (l : Val) : Lvl := match whnf (force es l) with
  | .vsort s => s
  | _ => .lhole
def piSortedQ (q : Q) (es : ES) (a b : Tm) (la lb : Val) : Tm := .pi q (sortOrHole es la) (sortOrHole es lb) a b
def piSorted (es : ES) (a b : Tm) (la lb : Val) : Tm := piSortedQ .qw es a b la lb
-- `(x : a) × b` with its sort, when both parts' sorts are known
def sigmaSorted (q : Q) (es : ES) (a b : Tm) (la lb : Val) : Tm := match whnf (force es la) with
  | .vsort l1 => match whnf (force es lb) with
    | .vsort l2 => .sigma q l1 l2 a b
    | _ => sigmaTm q a b
  | _ => sigmaTm q a b
def tailKinds : List BKind → List BKind
  | .nil => .nil
  | .cons _ rest => rest
def scopeNames : Scope → List String
  | .mk ls _ _ _ _ _ _ => List.reverseOf ls .nil

-- the result of elaborating a term: the term, its type, the metavariables
inductive TE where
  | ok (t : Tm) (ty : Val) (es : ES)
  | err (msg : String)
-- a global's implicit parameters (by its index from the latest)
def globalMask (gs : Globals) (i : Nat) : List BKind := match gs with
  | .mk all _ _ _ _ _ _ _ _ => match Array.getD all (Array.size all - 1 - i) (.mk "?" .nil .star .star .star .nil .nil) with
    | .mk _ _ _ _ _ m _ => m
-- a global's parameter names (A9: named arguments)
def globalNames (gs : Globals) (i : Nat) : List String := match gs with
  | .mk all _ _ _ _ _ _ _ _ => match Array.getD all (Array.size all - 1 - i) (.mk "?" .nil .star .star .star .nil .nil) with
    | .mk _ _ _ _ _ _ ns => ns
-- Pattern matching in definitions (stages 16b, 16e): `def f (ps) : R := match x, y with
-- | p₁, q₁ => rhs₁ …`, the scrutinees parameters and `R` not mentioning them, is
-- compiled column by column: split on the first column where the first clause has a
-- constructor pattern (an `ind` with the constant motive `fun i y => R`), so that in
-- the branch for constructor `c` that column is replaced by `c`'s fields; a clause with
-- a variable there names the column (a `let` at the leaf). The method of a split is
--   fun i xs ih => (ecase (fst xs) [b₁, …, bₖ] : convoy) (snd xs) ih
-- with each branch `bᵢ := fun rest ih => let fields := …; …`. The first split is the
-- structural one: its recursive fields' induction hypotheses are `let`s too, and a
-- recursive call `f … y …` on such a field (the other arguments being the parameters)
-- becomes `y`'s hypothesis.

def nthSyntax : List Syntax → Nat → Syntax
  | .nil, _ => .missing
  | .cons s rest, i => match i with
    | .zero => s
    | .succ j => nthSyntax rest j
def nthName : List String → Nat → String
  | .nil, _ => "_"
  | .cons s rest, i => match i with
    | .zero => s
    | .succ j => nthName rest j
-- the field variables before field `j`, as arguments: `var (j - 1), …, var 0`
def fvars : Nat → Tms
  | .zero => .tnil
  | .succ k => tmsAppend (.tcons (.var k) .tnil) (fvars k)
def elemNat : Nat → List Nat → Bool
  | _, .nil => .false
  | x, .cons y ys => Bool.or (Nat.beq x y) (elemNat x ys)

-- a pattern: a constructor and its sub-patterns, or a variable (or `_`)
inductive Pat where
  | ctor (c : String) (subs : List Syntax)
  | any (x : String)
-- `T.c` without the `T.`
def dropPrefix : List Char → List Char → Option (List Char)
  | .nil, rest => .some rest
  | .cons a as, .cons b bs => match Nat.beq (Char.code a) (Char.code b) with
    | .true => dropPrefix as bs
    | .false => .none
  | _, .nil => .none
-- (`T` may be a term's kernel name: compare the source name)
def ctorOfName (T n : String) : Option String := match String.append (privBase T) "." with
  | .mk ts => match n with
    | .mk ns => match dropPrefix ts ns with
      | .some c => .some (.mk c)
      | .none => .none
def headCtor (T : String) (h : Syntax) : Option String := match strEq (kindOf h) "term.dotIdent" with
  | .true => match kid h 1 with
    | .ident c => .some c
    | _ => .none
  | .false => ctorOfName T (identOf h)
partial def patOf (T : String) (p : Syntax) : Pat := match strEq (kindOf p) "term.paren" with
  | .true => patOf T (kid p 1)
  | .false => match strEq (kindOf p) "term.num" with
  -- a numeral: `0` is `.zero`, `n + 1` is `.succ n`
  | .true => match numValue p with
    | .zero => .ctor "zero" .nil
    | .succ k => .ctor "succ" (one (mkNode "term.num" (one (.atom (Nat.toString k)))))
  | .false => match strEq (kindOf p) "term.app" with
    | .true => match strEq (identOf (kid p 0)) "Nat.add" with
      -- `a + (k + 1)` (from `infixl " + " => Nat.add`) is `.succ (a + k)`
      | .true => match kids (kid p 1) with
        | .cons a (.cons b .nil) => match strEq (kindOf b) "term.num" with
          | .true => match numValue b with
            | .zero => patOf T a
            | .succ k => .ctor "succ" (one (match k with
              | .zero => a
              | _ => mkNode "term.app" (.cons (kid p 0) (one (mkNull (.cons a (one (mkNode "term.num" (one (.atom (Nat.toString k)))))))))))
          | .false => .any "_"
        | _ => .any "_"
      | .false => match headCtor T (kid p 0) with
        | .some c => .ctor c (kids (kid p 1))
        | .none => .any "_"
    | .false => match headCtor T p with
      | .some c => .ctor c .nil
      | .none => .any (identOf p)
def isVarPat (p : Syntax) : Bool := match strEq (kindOf p) "term.ident" with
  | .true => .true
  | .false => strEq (kindOf p) "term.hole"

-- a column: a variable (by level) and its type, with constants and inlined, over the
-- binders before it
inductive Col where
  | mk (lvl : Nat) (ty tyI : Tm) (q : Q)
-- a name a clause gives a column
inductive Bind where
  | mk (name : String) (col : Col)
inductive Clause where
  | mk (pats : List Syntax) (binds : List Bind) (rhs : Syntax)
def holeStx : Syntax := mkNode "term.hole" (one (.atom "_"))
def holes : Nat → List Syntax
  | .zero => .nil
  | .succ k => .cons holeStx (holes k)
def nthCol : List Col → Nat → Col
  | .nil, _ => .mk 0 .star .star .qw
  | .cons c rest, i => match i with
    | .zero => c
    | .succ j => nthCol rest j
-- `n` sub-patterns: as given, or holes if there are fewer
def padPats : Nat → List Syntax → List Syntax
  | .zero, _ => .nil
  | .succ k, ps => match ps with
    | .nil => .cons holeStx (padPats k .nil)
    | .cons p rest => .cons p (padPats k rest)

-- (21x) the sub-patterns of a constructor pattern name its explicit fields: a hole for
-- each implicit one (`impl`), as the Lean elaborator's `explicitIdx`
def explicitPats : List Bool → List Syntax → List Syntax
  | .nil, ps => ps
  | .cons b rest, ps => match b with
    | .true => .cons holeStx (explicitPats rest ps)
    | .false => match ps with
      | .nil => .nil
      | .cons p ps' => .cons p (explicitPats rest ps')

-- **Exercise 16.2.** The clauses for constructor `c` (of type `T`) after splitting
-- column `k` (`col`): a clause with `c` there gets its sub-patterns in place of that
-- column (`padPats F`), one with a variable gets `F` holes and binds the variable to
-- `col` (unless it is `_`), and one with another constructor is dropped.
def specialize (T c : String) (k F : Nat) (impl : List Bool) (col : Col) : List Clause → List Clause
  --<sol
  | .nil => .nil
  | .cons (.mk pats binds rhs) rest =>
    let before := takeL k pats;
    let after := dropL (k + 1) pats;
    match patOf T (nthSyntax pats k) with
    | .ctor c' subs => match strEq c c' with
      | .true => .cons (.mk (List.append before (List.append (padPats F (explicitPats impl subs)) after)) binds rhs) (specialize T c k F impl col rest)
      | .false => specialize T c k F impl col rest
    | .any x =>
      let binds' := match strEq x "_" with
        | .true => binds
        | .false => List.append binds (.cons (Bind.mk x col) .nil);
      .cons (.mk (List.append before (List.append (holes F) after)) binds' rhs) (specialize T c k F impl col rest)
  --|ex
  --| | _ => .nil
  --sol>

-- the names of the recursive fields' hypotheses: field name ↦ hypothesis name
inductive IHName where
  | mk (field ih : String)
def ihFor (x : String) : List IHName → Option String
  | .nil => .none
  | .cons (.mk y h) rest => match strEq x y with
    | .true => .some h
    | .false => ihFor x rest
-- the levels a name stands for (in a clause's binds)
def bindLvl (x : String) : List Bind → Option Nat
  | .nil => .none
  | .cons (.mk y (.mk l _ _ _)) rest => match strEq x y with
    | .true => .some l
    | .false => bindLvl x rest
-- is the argument the `i`th parameter (by its name, or a name for its column)?
def isParamArg (params : List String) (binds : List Bind) (i : Nat) (a : Syntax) : Bool :=
  match strEq (identOf a) (nthName params i) with
  | .true => .true
  | .false => match bindLvl (identOf a) binds with
    | .some l => Nat.beq l i
    | .none => .false
-- the arguments (the explicit parameters': implicit ones are left out, being the same)
-- before the structural one are the parameters, the structural one a field with a
-- hypothesis: that hypothesis (the later arguments are its arguments)
def nthKind : List BKind → Nat → BKind
  | .nil, _ => .dflt
  | .cons b rest, i => match i with
    | .zero => b
    | .succ j => nthKind rest j
partial def recCallIH (params : List String) (mask : List BKind) (binds : List Bind) (p : Nat) (ihs : List IHName) : List Syntax → Nat → Option String
  | args, i => match Nat.lt i (List.length params) with
    | .false => match args with
      | .nil => .some ""
      | .cons _ _ => .none
    | .true => match nthKind mask i with
      | .impl => recCallIH params mask binds p ihs args (i + 1)
      | .inst => recCallIH params mask binds p ihs args (i + 1)
      | .dflt => match args with
        | .nil => .none
        | .cons a rest => match recCallIH params mask binds p ihs rest (i + 1) with
          | .none => .none
          | .some h => match Nat.beq i p with
            | .true => ihFor (match strEq (kindOf (unparen a)) "term.app" with
                | .true => identOf (kid (unparen a) 0)
                | .false => identOf a) ihs
            | .false => match Nat.lt p i with
              | .true => .some h
              | .false => match isParamArg params binds i a with
                | .true => .some h
                | .false => .none
def nthS' : List Syntax → Nat → Syntax
  | .nil, _ => .missing
  | .cons s rest, i => match i with
    | .zero => s
    | .succ j => nthS' rest j
-- how many explicit parameters there are up to the `p`th
def explicitUpTo : List BKind → Nat → Nat
  | .nil, _ => 0
  | .cons b rest, p => (match b with
      | .dflt => 1
      | _ => 0) + (match p with
      | .zero => 0
      | .succ q => explicitUpTo rest q)
-- what a match needs: the function's name, parameters and structural position, the
-- result type `R` (over the `n` parameters), the motive's universe `v`
inductive MatchCtx where
  | mk (f : String) (params : List String) (p n v : Nat) (R RI : Tm) (pts ptsI : Tms) (mask : List BKind)
mutual
-- replace the recursive calls `f …` by hypotheses
def rewriteRec (mc : MatchCtx) (binds : List Bind) (ihs : List IHName) (stx : Syntax) : Syntax :=
  match mc with
  | .mk f params p _ _ _ _ _ _ mask => match stx with
    | .node k args => match Bool.and (strEq k "term.app") (strEq (identOf (kid stx 0)) f) with
      | .true => match recCallIH params mask binds p ihs (kids (kid stx 1)) 0 with
        | .some h => match strEq h "" with
          | .true => .node k (rewriteArgs mc binds ihs args)
          | .false =>
            -- (through a function field `y`, the structural argument `y a…` gives `ih a…`)
            let sa := unparen (nthS' (kids (kid stx 1)) (explicitUpTo mask p - 1));
            let ih := match strEq (kindOf sa) "term.app" with
              | .true => mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident h))) (one (kid sa 1)))
              | .false => mkNode "term.ident" (one (.ident h));
            match dropL (explicitUpTo mask p) (kids (kid stx 1)) with
            | .nil => ih
            | later => mkNode "term.app" (.cons ih (one (.node "null" (rewriteArgs mc binds ihs (toArgs later)))))
        | .none => .node k (rewriteArgs mc binds ihs args)
      | .false => .node k (rewriteArgs mc binds ihs args)
    | s => s
def rewriteArgs (mc : MatchCtx) (binds : List Bind) (ihs : List IHName) : SyntaxF .false → SyntaxF .false
  | .nil => .nil
  | .cons s rest => .cons (rewriteRec mc binds ihs s) (rewriteArgs mc binds ihs rest)
end

-- a type's head constant and arguments
inductive TyHead where
  | mk (name : String) (args : Tms)
  | none
def headOf : Tm → Tms → TyHead
  | .const n _ _ _ _, acc => .mk n acc
  | .app f a, acc => headOf f (.tcons a acc)
  | _, _ => .none
def headTm : Tm → Tm
  | .app f _ => headTm f
  | t => t
-- the hypotheses' names, for the binds standing for recursive fields that have one
def ihNamesOf (ihLvls : List Nat) : List Bind → List IHName
  | .nil => .nil
  | .cons (.mk x (.mk l _ _ _)) rest => match elemNat l ihLvls with
    | .true => .cons (.mk x (String.append "ih✝" (Nat.toString l))) (ihNamesOf ihLvls rest)
    | .false => ihNamesOf ihLvls rest
def ihLvlNames : List Nat → List String
  | .nil => .nil
  | .cons l rest => .cons (String.append "ih✝" (Nat.toString l)) (ihLvlNames rest)
-- `let q x : A := v; b`: a `letq` unless `q` is ω
def letTm (q : Q) (A v b : Tm) : Tm := match q with
  | .qw => .letE A v b
  | _ => .letq q A v b
-- `let x : A := var` for each bind, from depth `d`
def bindLets (inline : Bool) (body : Tm) : Nat → List Bind → Tm
  | _, .nil => body
  | d, .cons (.mk _ (.mk l ty tyI q)) rest =>
    let A := match inline with
      | .true => tyI
      | .false => ty;
    letTm q (shiftTm (d - l) 0 A) (.var (d - 1 - l)) (bindLets inline body (d + 1) rest)
def bindNames : List Bind → List String
  | .nil => .nil
  | .cons (.mk x _) rest => .cons x (bindNames rest)
-- the parameters after the structural one (`p`): their types as a telescope over the
-- binders at depth `base` (the parameters up to `p` stay where they are)
def genTys (p base : Nat) : Nat → Tms → Tms
  | _, .tnil => .tnil
  | m, .tcons t rest => .tcons (shiftTm (base - p - 1) m t) (genTys p base (m + 1) rest)
def nthTm : Tms → Nat → Tm
  | .tnil, _ => .star
  | .tcons t rest, i => match i with
    | .zero => t
    | .succ j => nthTm rest j
-- move the columns of the parameters after `p` to their new binders from depth `base`
def regen (p n base : Nat) (pts ptsI : Tms) : List Col → List Col
  | .nil => .nil
  | .cons (.mk l ty tyI q) rest => match Bool.and (Nat.lt p l) (Nat.lt l n) with
    | .true => .cons (.mk (base + (l - p - 1)) (shiftTm (base - p - 1) (l - p - 1) (nthTm pts l))
        (shiftTm (base - p - 1) (l - p - 1) (nthTm ptsI l)) q) (regen p n base pts ptsI rest)
    | .false => .cons (.mk l ty tyI q) (regen p n base pts ptsI rest)
def genVars (d : Nat) : Nat → Nat → Tms
  | .zero, _ => .tnil
  | .succ k, l => .tcons (.var (d - 1 - l)) (genVars d k (l + 1))
-- the fields as `let`s from depth `d0` (`rest` just before the first), as columns, and
-- in the context; each field type (over the type's parameters and the fields before)
-- gets the arguments `args` (at depth `L`)
inductive Lets where
  | mk (wrap : Tm → Tm) (cols : List Col) (recs : List Nat) (cx : Cx)
-- (21x) a field is bound at its quantity (`T.casesOn`'s method takes it so: `letTm`), and
-- so is a pattern variable that names it (`bindLetsT`)
def fieldCols (np L d0 : Nat) (args : Tms) : Cx → Nat → List Q → List CField → Lets
  | cx, _, _, .nil => .mk (fun b => b) .nil .nil cx
  | cx, j, qs, .cons (.mk _ isRec A _) rest =>
    let d := d0 + j;
    let ty := nfAt d (tApps (tLams np (tLams j A)) (tmsAppend (shiftTms (d - L) args) (fvars j)));
    let val : Tm := .fst (sndN j (.var (1 + j)));
    let env := TCtx.env (Cx.c cx);
    match fieldCols np L d0 args (Cx.define cx "_" (eval env val) (eval env ty)) (j + 1) (tailQ qs) rest with
    | .mk wrap cols recs cx' => .mk (fun b => letTm (headQ qs) ty val (wrap b)) (.cons (.mk d ty ty (headQ qs)) cols) (match isRec with
        | .true => .cons d recs
        | .false => recs) cx'
-- the hypotheses `let ih✝l : M := fst (snd^r ih)` (one per recursive field `l`), after
-- `F` fields, from depth `d0 + F`; `M` is the motive's body, at depth `md`
inductive IHL where
  | mk (wrap : Tm → Tm) (cx : Cx)
def ihLetsT (M : Tm) (md d0 F : Nat) : Cx → Nat → List Nat → IHL
  | cx, _, .nil => .mk (fun b => b) cx
  | cx, r, .cons l rest =>
    let ty := shiftTm (d0 + F + r - md) 0 M;
    let val : Tm := .fst (sndN r (.var (F + r)));
    let env := TCtx.env (Cx.c cx);
    match ihLetsT M md d0 F (Cx.define cx (String.append "ih✝" (Nat.toString l)) (eval env val) (eval env ty)) (r + 1) rest with
    | .mk w cx' => .mk (fun b => .letE ty val (w b)) cx'
-- `let x : A := var` for each bind
def bindLetsT (body : Tm) : Cx → List Bind → Tm
  | _, .nil => body
  | cx, .cons (.mk x (.mk l ty _ q)) rest =>
    let d := Cx.lvl cx;
    let A := shiftTm (d - l) 0 ty;
    let v : Tm := .var (d - 1 - l);
    let env := TCtx.env (Cx.c cx);
    letTm q A v (bindLetsT body (Cx.define cx x (eval env v) (eval env A)) rest)
def bindCx : Cx → List Bind → Cx
  | cx, .nil => cx
  | cx, .cons (.mk x (.mk l ty _ _)) rest =>
    let d := Cx.lvl cx;
    let A := shiftTm (d - l) 0 ty;
    let env := TCtx.env (Cx.c cx);
    bindCx (Cx.define cx x (eval env (.var (d - 1 - l))) (eval env A)) rest
-- bind the parameters after the structural one again: names from `ps`, types from the
-- Π type `ty`; the rest of `ty` is the expected type inside
inductive Gen where
  | mk (cx : Cx) (expected : Val)
def genBind (es : ES) : Cx → Val → List String → Gen
  | cx, ty, .nil => .mk cx ty
  | cx, ty, .cons x rest => match whnf ty with
    | .vpi _ _ _ dom env cod => genBind es (Cx.bind cx x dom) (eval (.cons (fresh (Cx.lvl cx)) env) cod) rest
    | t => .mk cx t
def dropEnv : Nat → Env → Env
  | .zero, e => e
  | .succ k, e => match e with
    | .nil => .nil
    | .cons _ rest => dropEnv k rest
def lenL {A : Type} (xs : List A) : Nat := List.length xs

def colTyAt : List Col → Nat → Option Tm
  | .nil, _ => .none
  | .cons (.mk l' ty _ _) rest, l => match Nat.beq l l' with
    | .true => .some ty
    | .false => colTyAt rest l
def lastTm : Tms → Tm
  | .tnil => .star
  | .tcons t rest => match rest with
    | .tnil => t
    | .tcons _ _ => lastTm rest
def isNilCl : List Clause → Bool
  | .nil => .true
  | .cons _ _ => .false
-- `False` from a proof of an equation that computes to it (or to `False × …`)
partial def toFalse (ty : Val) (t : Tm) : Option Tm := match whnf ty with
  | .vempty _ => .some t
  | .vsigma _ _ _ A _ _ => toFalse A (.fst t)
  | _ => .none
-- the field variables (from level `d0`, `F` of them) as arguments at depth `D`
def fieldVarsAt (D d0 : Nat) : Nat → Nat → Tms
  | .zero, _ => .tnil
  | .succ k, j => .tcons (.var (D - 1 - (d0 + j))) (fieldVarsAt D d0 k (j + 1))
-- a constructor ruled out by a closed index: `fun e => exfalso M (…)`, where the
-- payload's proof `p : res = i` is carried along `e : i = idx` to `res = idx`, which
-- computes to `False`; `none` if it doesn't
def absurdBranch (cx6 : Cx) (np L d d0 F : Nat) (args : Tms) (I idx res : Tm) (MBv : Val) : Option Tm :=
  let D1 := Cx.lvl cx6;
  match whnf MBv with
  | .vpi _ _ _ eTy envE codE =>
    let cxE := Cx.bind cx6 "e✝" eTy;
    let D := D1 + 1;
    let expected' := eval (.cons (fresh D1) envE) codE;
    let ID := nfAt D (tApps (tLams np I) (shiftTms (D - L) args));
    let icD := nfAt D (tApps (tLams np (tLams F res)) (tmsAppend (shiftTms (D - L) args) (fieldVarsAt D d0 F 0)));
    let idxD := shiftTm (D - L) 0 idx;
    let pTm : Tm := .fst (sndN F (.var (D - 1 - (d + 3))));
    let mot : Tm := .lam (.lam (.eq (shiftTm 2 0 ID) (shiftTm 2 0 icD) (.var 1)));
    let prf : Tm := .subst ID (.var (D - 1 - d)) mot pTm idxD (.var 0);
    match toFalse (eval (TCtx.env (Cx.c cxE)) (.eq ID icD idxD)) prf with
    | .some f => .some (.lam (.exfalso (quote D expected') f))
    | .none => .none
  | _ => .none
-- the hypotheses `let ih✝l := fst (snd^r ih)`, one per recursive field `l`; with a closed
-- index, one whose field has that index is applied to `refl` already
def ihLetsB (gs : Globals) (MB0 MB : Tm) (md d0 F np L : Nat) (args : Tms) (I idx : Tm) (modeB : Bool) (fcols : List Col) : Cx → Nat → List Nat → IHL
  | cx, _, .nil => .mk (fun b => b) cx
  | cx, r, .cons l rest =>
    let D := d0 + F + r;
    let env := TCtx.env (Cx.c cx);
    let raw : Tm := .fst (sndN r (.var (F + r)));
    -- a function field `y : (h : H) → B` (stage 19f): its hypothesis is a function too
    let fty0 : Tm := match colTyAt fcols l with
      | .some fty => fty
      | .none => .star;
    let hr : Option Tm := match fty0 with
      | .pi .qw _ _ H _ => .some (shiftTm (D - l) 0 H)
      | _ => .none;
    let fty : Tm := match fty0 with
      | .pi .qw _ _ _ B => B
      | t => t;
    -- the field's index, at depth `D` (a function field's under its binder `h`, a member's
    -- tag)
    let jD : Tm := match headOf fty .tnil with
      | .mk nm as => match Globals.ind gs nm with
        | .some (.mk _ _ _ _ _ (.some f) _ _) => f
        | _ => lastTm (shiftTms (D - l) as)
      | .none => .star;
    let ID := nfAt D (tApps (tLams np I) (shiftTms (D - L) args));
    let same := Bool.and modeB (conv (Cx.c cx) (eval env ID) (eval env jD) (eval env (shiftTm (D - L) 0 idx)));
    let val : Tm := match hr with
      | .none => match same with
        | .true => .app raw (.eqRefl ID jD)
        | .false => raw
      | .some _ => match same with
        | .true => .lam (.app (.app (shiftTm 1 0 raw) (.var 0)) (.eqRefl (shiftTm 1 0 ID) jD))
        | .false => raw;
    -- `P j y` for the field `y` (at level `l`) and its index `j`; `(h : H) → P j (y h)`
    let ty := match hr with
      | .none => match same with
        | .true => shiftTm (D - md) 0 MB0
        | .false => nfAt D (.app (.app (.lam (.lam (shiftTm (D - (md - 2)) 2 MB))) jD) (.var (D - 1 - l)))
      | .some H => match same with
        | .true => piH H (shiftTm (D + 1 - md) 0 MB0)
        | .false => piH H (nfAt (D + 1) (.app (.app (.lam (.lam (shiftTm (D + 1 - (md - 2)) 2 MB))) jD) (.app (.var (D - l)) (.var 0))));
    match ihLetsB gs MB0 MB md d0 F np L args I idx modeB fcols (Cx.define cx (String.append "ih✝" (Nat.toString l)) (eval env val) (eval env ty)) (r + 1) rest with
    | .mk w cx' => .mk (fun b => .letE ty val (w b)) cx'
-- the result of compiling a match: the term and the metavariables
def nonAtoms : List Syntax → List Syntax
  | .nil => .nil
  | .cons s rest => match s with
    | .atom _ => nonAtoms rest
    | _ => .cons s (nonAtoms rest)
-- the components of a `term.tuple` `(a, b, …)`
def tupleItems (s : Syntax) : List Syntax := .cons (kid s 1) (nonAtoms (kids (kid s 3)))
def clausesOf : List Syntax → List Clause
  | .nil => .nil
  | .cons a rest => .cons (.mk (nonAtoms (kids (kid a 1))) .nil (kid a 3)) (clausesOf rest)
inductive CE where
  | ok (t : Tm) (es : ES)
  | err (msg : String)
def lastClause : List Clause → Option Clause
  | .nil => .none
  | .cons c rest => match rest with
    | .nil => .some c
    | .cons _ _ => lastClause rest
def one' (c : Clause) : List Clause := .cons c .nil
def replaceLastRhs (r : Syntax) : List Clause → List Clause
  | .nil => .nil
  | .cons (.mk ps bs rhs) rest => match rest with
    | .nil => one' (.mk ps bs r)
    | .cons _ _ => .cons (.mk ps bs rhs) (replaceLastRhs r rest)
def allVarPatsC : List Syntax → Bool
  | .nil => .true
  | .cons p rest => Bool.and (isVarPat p) (allVarPatsC rest)
-- (worth sharing: two clauses or more, the last of variables, with more than a name)
def shareableLast (cls : List Clause) : Bool := match cls with
  | .cons _ (.cons _ _) => match lastClause cls with
    | .some (.mk ps _ rhs) => Bool.and (allVarPatsC ps) (Bool.not (strEq (kindOf rhs) "term.ident"))
    | .none => .false
  | _ => .false
-- the scrutinees of a term `match`, `let`-bound: the context, the columns, the `let`s
inductive SL where
  | ok (cx : Cx) (cols : List Col) (wrap : Tm → Tm) (es : ES)
  | err (msg : String)
inductive BE where
  | ok (bs : Tms) (es : ES)
  | err (msg : String)
def noBE : BE := .ok .tnil ES.empty
-- `fun t => ecase t [D₁, …]`, the description after its tag
-- (stage 21j) the implicit arguments' metavariables and the result type of `f a…`
-- with a placeholder for each explicit argument (`appExpected`)
inductive PreR where
  | mk (implicits : List Tm) (ty : Val) (es : ES)
partial def preArgs (es : ES) (cx : Cx) (fty : Val) (m : List BKind) (args : List Syntax) : Option PreR :=
  match m with
  | .cons .impl m' => match whnf (force es fty) with
    | .vpi _ _ _ dom env cod => match newImplicit es cx dom with
      | .mk mt es1 => match preArgs es1 cx (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) m' args with
        | .some (.mk ims rty es2) => .some (.mk (.cons mt ims) rty es2)
        | .none => .none
    | _ => .none
  | .cons .inst m' => match whnf (force es fty) with
    | .vpi _ _ _ dom env cod => match newImplicit es cx dom with
      | .mk mt es1 => match preArgs es1 cx (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) m' args with
        | .some (.mk ims rty es2) => .some (.mk (.cons mt ims) rty es2)
        | .none => .none
    | _ => .none
  | _ => match args with
    | .nil => .some (.mk .nil fty es)
    | .cons _ rest => match whnf (force es fty) with
      | .vpi _ _ _ dom env cod => match newImplicit es cx dom with
        | .mk mt es1 => preArgs es1 cx (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) (tailKinds m) rest
      | _ => .none
-- Literal patterns (13q; `compileLitTest` in the Lean elaborator). At `Nat` a numeral
-- pattern is its constructors (`patOf`), up to 256; at another type `T` with a `T.beq`
-- (the first in the chain of definitions the column's type unfolds through) a column
-- whose first row has a literal `l` is tested with `T.beq x l`, a new `Bool` column in
-- front of it: rows with `l` want `.true` there (and `_` in the column), rows with
-- another literal `.false` (keeping theirs), and catch-all rows `_`. Literals don't
-- cover a type, so the column needs a catch-all row.
def isLitPat (p : Syntax) : Bool := Bool.or (is (unparen p) "term.num") (is (unparen p) "term.str")
def isPlusPat (p : Syntax) : Bool := Bool.and (is (unparen p) "term.app") (strEq (identOf (kid (unparen p) 0)) "Nat.add")
-- `p + k` without a numeral `k`
def plusBad (p : Syntax) : Bool := match isPlusPat p with
  | .true => match kids (kid (unparen p) 1) with
    | .cons _ (.cons b .nil) => Bool.not (is b "term.num")
    | _ => .true
  | .false => .false
def patAt (k : Nat) : List Clause → Syntax
  | .nil => .missing
  | .cons (.mk pats _ _) _ => unparen (nthSyntax pats k)
def anyVarAt (k : Nat) : List Clause → Bool
  | .nil => .false
  | .cons (.mk pats _ _) rest => Bool.or (isVarPat (unparen (nthSyntax pats k))) (anyVarAt k rest)
def litMsg (T : String) : String := String.append "a literal pattern needs Nat, or a type T with literals and an equality test T.beq; "
  (String.append T " is a data type: match on its constructors")
-- the literal patterns of a column split by constructors (of the inductive type `T`)
def litSplitErr (T : String) (k : Nat) : List Clause → Option String
  | .nil => .none
  | .cons (.mk pats _ _) rest =>
    let p := unparen (nthSyntax pats k);
    match strEq T "Nat" with
    | .true => match is p "term.str" with
      | .true => .some "a string pattern needs a String, not Nat"
      | .false => match Bool.and (is p "term.num") (Nat.lt 256 (numValue p)) with
        | .true => .some (String.append (String.append (String.append "the numeral pattern " (Nat.toString (numValue p)))
            " is too large: at Nat a numeral is matched by its constructors (`succ` applied ")
            (String.append (Nat.toString (numValue p)) " times), up to 256; test with `Nat.beq` instead"))
        | .false => match plusBad p with
          | .true => .some "a pattern `p + k` needs a numeral `k` (as in `n + 2`)"
          | .false => litSplitErr T k rest
    | .false => match Bool.or (isLitPat p) (isPlusPat p) with
      | .true => match plusBad p with
        | .true => .some "a pattern `p + k` needs a numeral `k` (as in `n + 2`)"
        | .false => .some (litMsg T)
      | .false => litSplitErr T k rest
-- the patterns of a column tested by literals: literals, `_` and variables only
def litColErr (tyStr : String) (k : Nat) : List Clause → Option String
  | .nil => .none
  | .cons (.mk pats _ _) rest =>
    let p := unparen (nthSyntax pats k);
    match Bool.or (isLitPat p) (isVarPat p) with
    | .true => litColErr tyStr k rest
    | .false => match plusBad p with
      | .true => .some "a pattern `p + k` needs a numeral `k` (as in `n + 2`)"
      | .false => match isPlusPat p with
        | .true => .some (String.append "a pattern `n + k` needs a Nat, not " tyStr)
        | .false => .some (String.append (String.append "literal patterns on " tyStr)
            " can't be mixed with other patterns in one column (only literals, `_` and variables)")
def sameLit (a b : Syntax) : Bool := match Bool.and (is a "term.num") (is b "term.num") with
  | .true => Nat.beq (numValue a) (numValue b)
  | .false => match Bool.and (is a "term.str") (is b "term.str") with
    | .true => strEq (strValue a) (strValue b)
    | .false => .false
def boolPat (b : String) : Syntax := mkNode "term.dotIdent" (.cons (.atom ".") (one (.ident b)))
-- a boolean as a *term* (it infers without an expected type, as the host's macros use)
def boolVal (b : String) : Syntax := mkNode "term.ident" (one (.ident (String.append "Bool." b)))
-- the clauses with the test's column in front of column `k`, for the literal `l`
def litClauses (l : Syntax) (k : Nat) : List Clause → List Clause
  | .nil => .nil
  | .cons (.mk pats binds rhs) rest =>
    let p := unparen (nthSyntax pats k);
    let two : List Syntax := match isLitPat p with
      | .true => match sameLit p l with
        | .true => List.cons (boolPat "true") (one holeStx)
        | .false => List.cons (boolPat "false") (one p)
      | .false => List.cons holeStx (one p);
    .cons (.mk (List.append (takeL k pats) (List.append two (dropL (k + 1) pats))) binds rhs) (litClauses l k rest)
def colsInsert (k : Nat) (c : Col) (cols : List Col) : List Col := List.append (takeL k cols) (.cons c (dropL k cols))
-- the type `T` of `T.beq` for a column's type (at depth `d`)
partial def beqHead (gs : Globals) (d : Nat) (ty : Tm) : Option String := match headOf ty .tnil with
  | .mk T args => match Scope.lookup (Globals.scope gs) (String.append T ".beq") with
    | .some _ => .some T
    | .none => match Globals.ind gs T with
      | .some _ => .none
      | .none => match headTm ty with
        | .const _ _ _ v _ => beqHead gs d (nfAt d (tApps v args))
        | _ => .none
  | .none => .none
-- Structure update (13i, 13p; `elabStructUpdate` in the Lean elaborator):
-- `{ s with f := v, a.b := w }` is `let upd✝ := s; S.mk …` with field `f` the value
-- `v`, a field `a` with paths `a.b := w, …` the update `{ upd✝.a with b := w, … }`
-- (whose path so far rides along as a sixth argument of the node, for messages), and
-- every other field `upd✝.g`. A structure is marked when it is declared
-- (`Globals.markStruct`); its fields are its constructor's.
inductive Upd where
  | mk (field : String) (path : Option String) (val : Syntax)
-- `a.b.c` as `a` and `b.c`
def firstDotGo : List Char → List Char → Split
  | .nil, acc => .mk (.mk (List.reverseOf acc .nil)) ""
  | .cons c cs, acc => match Nat.beq (Char.code c) 46 with
    | .true => .mk (.mk (List.reverseOf acc .nil)) (.mk cs)
    | .false => firstDotGo cs (.cons c acc)
def updOf (u : Syntax) : Upd := match kid u 0 with
  | .ident n => match n with
    | .mk cs => match firstDotGo cs .nil with
      | .mk f rest => match strEq rest "" with
        | .true => .mk f .none (kid u 2)
        | .false => .mk f (.some rest) (kid u 2)
  | _ => .mk "_" .none (kid u 2)
def updsOf : List Syntax → List Upd
  | .nil => .nil
  | .cons u rest => match u with
    | .atom _ => updsOf rest
    | _ => .cons (updOf u) (updsOf rest)
def Globals.markStruct (gs : Globals) (T : String) : Globals := match Globals.ind gs T with
  | .some info => Globals.addInd gs (String.append "structure " T) info
  | .none => gs
-- a structure's fields (`none` if `T` isn't a structure)
def cfieldNames : List CField → List String
  | .nil => .nil
  | .cons (.mk x _ _ _) rest => .cons x (cfieldNames rest)
def structFieldsOf (info : IndInfo) : Option (List String) := match info with
  | .mk _ _ _ _ ctors _ _ _ => match ctors with
    | .cons (.mk _ fs _ _ _) _ => .some (cfieldNames fs)
    | .nil => .some .nil
-- a structure's fields; `T` is a source name, or a term's kernel name (then its module
-- is the marker's too, stage 21n)
def Globals.structFields (gs : Globals) (T : String) : Option (List String) := match privSplit T with
  | .some (.mk m base) => match gs with
    | .mk _ _ inds _ _ _ _ _ _ =>
      match StrMap.findD inds (Str.ofString (privName m ("structure " +++ base))) .none with
      | .some info => structFieldsOf info
      | .none => .none
  | .none => match Globals.ind gs (String.append "structure " T) with
    | .some info => structFieldsOf info
    | .none => .none
-- the structure a type is (a definition is unfolded, as `structHead?` does)
partial def structOf (gs : Globals) (es : ES) (ty : Val) : Option String := match force es ty with
  | .vglued (.hconst T _ _ _ _) _ v => match Globals.structFields gs T with
    | .some _ => .some T
    | .none => match Globals.ind gs T with
      | .some _ => .none
      | .none => structOf gs es (v ())
  | _ => .none
def commaJoin : List String → String
  | .nil => ""
  | .cons x rest => match rest with
    | .nil => x
    | .cons _ _ => String.append (String.append x ", ") (commaJoin rest)
def memberS (x : String) : List String → Bool
  | .nil => .false
  | .cons y ys => Bool.or (strEq x y) (memberS x ys)
def pathStr (outer f : String) : String := match strEq outer "" with
  | .true => f
  | .false => String.append (String.append outer ".") f
-- the first error among the updates, in order: an unknown field, a field updated twice
-- (`direct`: the fields given a value so far, `nested`: those updated inside)
def updErr (S : String) (fields : List String) (outer : String) : List Upd → List String → List String → Option String
  | .nil, _, _ => .none
  | .cons (.mk f p _) rest, direct, nested => match memberS f fields with
    | .false => .some (String.append (String.append (String.append S " has no field '") f)
        (String.append "' (its fields are " (String.append (commaJoin fields) ")")))
    | .true =>
      let twice := String.append (String.append "field '" (pathStr outer f)) "' is updated twice";
      match p with
      | .none => match Bool.or (memberS f direct) (memberS f nested) with
        | .true => .some twice
        | .false => updErr S fields outer rest (.cons f direct) nested
      | .some _ => match memberS f direct with
        | .true => .some twice
        | .false => updErr S fields outer rest direct (.cons f nested)
def directVal (f : String) : List Upd → Option Syntax
  | .nil => .none
  | .cons (.mk g p v) rest => match strEq f g with
    | .true => match p with
      | .none => .some v
      | .some _ => directVal f rest
    | .false => directVal f rest
def nestedUpds (f : String) : List Upd → List Syntax
  | .nil => .nil
  | .cons (.mk g p v) rest => match strEq f g with
    | .true => match p with
      | .some q => .cons (mkNode "structUpdate.field" (.cons (.ident q) (.cons (.atom ":=") (one v)))) (nestedUpds f rest)
      | .none => nestedUpds f rest
    | .false => nestedUpds f rest
-- the constructor's arguments
def updArgs (S outer : String) (ups : List Upd) : List String → List Syntax
  | .nil => .nil
  | .cons f rest =>
    -- (`S.f upd✝`, not `upd✝.f`: the type of `s` may be a definition of `S …`)
    let kept := mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident (String.append (String.append S ".") f))))
      (one (mkNull (one (mkNode "term.ident" (one (.ident "upd✝")))))));
    let arg := match directVal f ups with
      | .some v => v
      | .none => match nestedUpds f ups with
        | .nil => kept
        | .cons u us => mkNode "term.structUpdate" (.cons (.atom "{") (.cons kept (.cons (.atom "with")
            (.cons (mkNull (.cons u us)) (.cons (.atom "}") (one (.atom (pathStr outer f))))))));
    .cons arg (updArgs S outer ups rest)
-- is the head a constructor (`T.c` of an inductive type `T`, not shadowed)?
def ctorHead (gs : Globals) (cx : Cx) (h : Syntax) : Bool := match strEq (kindOf h) "term.ident" with
  | .true => match Scope.lookup (Cx.sc cx) (identOf h) with
    | .some i => match Nat.lt i (Cx.lvl cx) with
      | .true => .false
      | .false => match splitLast (identOf h) with
        | .some (.mk T _) => match Globals.ind gs T with
          | .some _ => .true
          | .none => .false
        | .none => .false
    | .none => .false
  | .false => .false
def headImplicit : List BKind → Bool
  | .cons b _ => isImplK b
  | .nil => .false
def descFn : Tm → Tm
  | .darg _ _ f => f
  | t => t
-- `(a, b, c)` is `(a, (b, c))`, as the host's pattern reader nests it
def nestTuple : List Syntax → Syntax
  | .nil => holeStx
  | .cons x .nil => x
  | .cons x rest => mkNode "term.tuple" (.cons (.atom "(") (.cons x (.cons (.atom ",")
      (one (mkNull (one (nestTuple rest)))))))
-- the clauses of a pair-pattern split: column `k`'s `(a, b)` becomes the two columns
-- `a` and `b`; a variable (or `_`) in another clause becomes two holes (a variable also
-- keeps its binding to the whole pair, which is still in the context)
def tupleClauses (col : Col) (k : Nat) : List Clause → Option (List Clause)
  | .nil => .some .nil
  | .cons (.mk pats binds rhs) rest =>
    let p := unparen (nthSyntax pats k);
    let tuple := strEq (kindOf p) "term.tuple";
    match Bool.or tuple (isVarPat p) with
    | .false => .none
    | .true =>
      let two : List Syntax := match tuple with
        | .true => match tupleItems p with
          | .cons a (.cons b more) => .cons a (.cons (nestTuple (.cons b more)) .nil)
          | _ => .cons holeStx (.cons holeStx .nil)
        | .false => .cons holeStx (.cons holeStx .nil);
      let binds' : List Bind := match Bool.and (Bool.not tuple) (Bool.not (strEq (identOf p) "_")) with
        | .true => List.append binds (.cons (Bind.mk (identOf p) col) .nil)
        | .false => binds;
      match tupleClauses col k rest with
      | .some r => .some (.cons (.mk (List.append (takeL k pats) (List.append two (dropL (k + 1) pats)))
          binds' rhs) r)
      | .none => .none
-- a global at its declaration's level parameters: fresh level metavariables (inferred by
-- unification), or the explicitly written ones. The constant carries its level
-- instantiation, and its type is evaluated with it.
inductive GL where
  | ok (t : Tm) (ty : Val) (es : ES) (m : List BKind)
  | err (msg : String)
def globalUse (gs : Globals) (es : ES) (cx : Cx) (j : Nat) (explicit : List Syntax) : GL :=
  let ps := globalParams gs j;
  let m := globalMask gs j;
  match globalTm .false gs j with
  | .const nm _ _ v ty => match explicit with
    | .nil => match freshLvls es (List.length ps) with
      | .mk ls es' => .ok (.const nm ps ls v ty) (eval .nil (substIfAny ps ls ty)) es' m
    | .cons _ _ => match Nat.beq (List.length ps) (List.length explicit) with
      | .false => .err (String.append (String.append (String.append nm " has ") (Nat.toString (List.length ps)))
          " universe parameters")
      | .true => match elabLvls es explicit with
        | .err msg => .err msg
        | .ok ls es' => .ok (.const nm ps ls v ty) (eval .nil (substIfAny ps ls ty)) es' m
  | t => .err "a global that isn't a constant"
-- (A10) Instance resolution: dictionary passing, checked. A class is a structure (a
-- `μ` with one constructor), an instance is a global whose type is a class application,
-- a method is its projection with an instance `self` binder, and a dictionary is the
-- structure value. A class problem is a metavariable of a class type, made when a
-- method's (or a class parameter's) `inst` binder is inserted; `finishElab` solves the
-- problems before a command ends.
--
-- The search is deterministic and bounded: a local hypothesis whose type is the class
-- (innermost first), then the class's instances (priority descending, latest first); the
-- first candidate whose conclusion unifies with the goal is committed to, and its own
-- `inst` parameters become further problems (a subgoal). There is no tabling, so a
-- cyclic instance (`instance [C A] : C A`) is caught by the step budget rather than
-- shared, and there is no backtracking out of a committed candidate (with duplicate
-- instances rejected, overlapping candidates cannot arise today). A problem whose class
-- arguments are not all known at the end of the command is reported as stuck.
--
-- Boundary: no `outParam`, no default instances (`attribute [default_instance]`), no
-- priorities in choosing between overlapping instances, no `binop`/`OfNat` (a numeral
-- at a non-`Nat` type is still not a class problem). See `docs/stages/30-*`.

-- a class application's head and arguments, without unfolding the class (`whnf` would
-- turn it into its `μ`)
inductive Goal where
  | mk (cls : String) (args : List Val)
  | other
-- (a solved metavariable at the head of a type, without unfolding a constant)
partial def forceHead (es : ES) (v : Val) : Val := match v with
  | .vne (.haxiom n _) sp => match metaId n with
    | .some i => match ES.get es i with
      | .mk k (.some sol) _ => match spineArgs sp with
        | .some as => forceHead es (applyAll (eval (envOf (takeL k as) .nil) sol) (dropL k as))
        | .none => v
      | _ => v
    | .none => v
  | _ => v
def goalOf (es : ES) (ty : Val) : Goal := match forceHead es ty with
  | .vglued (.hconst C _ _ _ _) sp _ => match spineArgs sp with
    | .some as => .mk C as
    | .none => .other
  | _ => .other
-- no unsolved metavariable in a type (its class arguments are known)
def closedVal (es : ES) (d : Nat) (v : Val) : Bool := match zonk es d (quote d v) with
  | .some _ => .true
  | .none => .false
def allClosed (es : ES) (d : Nat) : List Val → Bool
  | .nil => .true
  | .cons v rest => Bool.and (closedVal es d v) (allClosed es d rest)
-- a candidate: the metavariables after applying it, and its term
inductive InstCand where
  | ok (es : ES) (t : Tm)
  | no
-- a global instance applied to fresh arguments: its explicit and implicit parameters
-- become metavariables (the goal, or a later parameter, fixes them) and its instance
-- parameters become subgoals; then its conclusion is unified with the goal
partial def applyCand (gs : Globals) (es : ES) (cx : Cx) (t : Tm) (ty : Val) (m : List BKind) (goal : Val) : InstCand :=
  match m with
  | .cons .inst m' => match whnf (force es ty) with
    | .vpi _ _ _ dom env cod => match newImplicit es cx dom with
      | .mk mt es' => applyCand gs (ES.pinst es' (.mk mt dom cx)) cx (.app t mt)
          (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) m' goal
    | _ => .no
  | .cons _ m' => match whnf (force es ty) with
    | .vpi _ _ _ dom env cod => match newImplicit es cx dom with
      | .mk mt es' => applyCand gs es' cx (.app t mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) m' goal
    | _ => .no
  -- (the remaining type is the candidate's conclusion: unify it with the goal, not the
  -- candidate's value)
  | .nil => match unify es cx ty goal with
    | .some es' => .ok es' t
    | .none => .no
-- the local hypotheses, innermost first
partial def tryLocals (gs : Globals) (es : ES) (cx : Cx) (goal : Val) (i : Nat) : InstCand :=
  match Nat.lt i (Cx.lvl cx) with
  | .false => .no
  | .true => match unify es cx (lookup (TCtx.types (Cx.c cx)) i) goal with
    | .some es' => .ok es' (.var i)
    | .none => tryLocals gs es cx goal (i + 1)
def prioOf : InstInfo → Nat
  | .mk _ _ p _ => p
def nameOf : InstInfo → String
  | .mk _ n _ _ => n
-- priority descending, and (the list being latest first) latest first among equals
def insertInst (i : InstInfo) : List InstInfo → List InstInfo
  | .nil => .cons i .nil
  | .cons j rest => match Nat.lt (prioOf j) (prioOf i) with
    | .true => .cons i (.cons j rest)
    | .false => .cons j (insertInst i rest)
def sortInsts : List InstInfo → List InstInfo
  | .nil => .nil
  | .cons i rest => insertInst i (sortInsts rest)
def instanceCand (gs : Globals) (es : ES) (cx : Cx) (goal : Val) (i : InstInfo) : InstCand :=
  match Scope.lookup (Globals.scope gs) (nameOf i) with
  | .none => .no
  | .some k => match globalTm .false gs k with
    | .const _ _ _ _ ty => applyCand gs es cx (globalTm .false gs k) (eval .nil ty) (globalMask gs k) goal
    | _ => .no
partial def tryGlobals (gs : Globals) (es : ES) (cx : Cx) (goal : Val) : List InstInfo → InstCand
  | .nil => .no
  | .cons i rest => match instanceCand gs es cx goal i with
    | .ok es' t => .ok es' t
    | .no => tryGlobals gs es cx goal rest
-- the type of a problem, as the user sees it
def goalShow : PInst → String
  | .mk _ ty cx => show (scopeNames (Cx.sc cx)) (Cx.lvl cx) (quote (Cx.lvl cx) ty)
inductive InstRes where
  | ok (es : ES)
  | err (msg : String)
def stuckMsg (p : PInst) : String := String.append "type class problem is stuck: " (goalShow p)
def missingMsg (p : PInst) : String := String.append "failed to synthesize an instance of " (goalShow p)
-- one problem, with `es` already holding the other problems
def resolveOne (gs : Globals) (es : ES) (p : PInst) : InstRes := match p with
  | .mk hole ty cx =>
    let d := Cx.lvl cx;
    let env := TCtx.env (Cx.c cx);
    let commit := fun (es1 : ES) (t : Tm) => match unify es1 cx (eval env hole) (eval env t) with
      | .some es2 => InstRes.ok es2
      | .none => InstRes.err (missingMsg p);
    match goalOf es ty with
    | .other => .err (stuckMsg p)
    | .mk C args => match Globals.class gs C with
      | .none => .err (String.append (String.append C " is not a class: ") (goalShow p))
      | .some _ => match allClosed es d args with
        | .false => .err (stuckMsg p)
        | .true => match tryLocals gs es cx ty 0 with
          | .ok es1 t => commit es1 t
          | .no => match tryGlobals gs es cx ty (sortInsts (instsOf C (Globals.insts gs))) with
            | .ok es1 t => commit es1 t
            | .no => .err (missingMsg p)
-- all the problems, each after the ones it creates (the step budget catches cycles)
partial def resolveAll (gs : Globals) (es : ES) (fuel : Nat) : InstRes := match es with
  | .mk ms ps ls lps (.cons p rest) => match fuel with
    | .zero => .err (String.append "instance search did not finish in 100 steps (a cyclic instance?): " (goalShow p))
    | .succ f => match resolveOne gs (.mk ms ps ls lps rest) p with
      | .err m => .err m
      | .ok es' => resolveAll gs es' f
  | _ => .ok es

-- (A9) named arguments `f a (x := e) b`. The kernel's `Tm`/`Val` carry no binder
-- names, so a global keeps its parameters' names beside their binder kinds. A call
-- with named arguments is rewritten to the positional argument list its telescope asks
-- for, with `_` for each implicit parameter passed over; `appArgsT` elaborates that as
-- usual (so insertion, expected types and postponement behave as before). Named
-- arguments match binders by name (explicit, implicit or instance), in any order; a
-- named argument for an explicit parameter that has no argument is an error, as in Lean.
inductive NArg where
  | mk (name : String) (val : Syntax)
def rawName : Syntax → String
  | .ident n => n
  | _ => "_"
def hasNamedArgs : List Syntax → Bool
  | .nil => .false
  | .cons a rest => Bool.or (strEq (kindOf a) "term.namedArg") (hasNamedArgs rest)
def nargHas (x : String) : List NArg → Bool
  | .nil => .false
  | .cons (.mk y _) rest => Bool.or (strEq x y) (nargHas x rest)
inductive NArgs where
  | ok (named : List NArg) (pos : List Syntax)
  | err (msg : String)
-- the named and positional arguments, in source order, rejecting a name given twice
def splitNArgs : List Syntax → List NArg → List Syntax → NArgs
  | .nil, ns, ps => .ok (List.reverseOf ns .nil) (List.reverseOf ps .nil)
  | .cons a rest, ns, ps => match strEq (kindOf a) "term.namedArg" with
    | .true =>
      let x := rawName (kid a 1);
      match nargHas x ns with
      | .true => .err (String.append (String.append "argument '" x) "' was already given")
      | .false => splitNArgs rest (.cons (.mk x (kid a 3)) ns) ps
    | .false => splitNArgs rest ns (.cons a ps)
inductive TakeN where
  | ok (val : Syntax) (rest : List NArg)
  | none
def takeNamed (x : String) : List NArg → TakeN
  | .nil => .none
  | .cons (.mk y e) rest => match strEq x y with
    | .true => .ok e rest
    | .false => match takeNamed x rest with
      | .ok e' rest' => .ok e' (.cons (.mk y e) rest')
      | .none => .none
def nameIn (x : String) : List String → Bool
  | .nil => .false
  | .cons y ys => Bool.or (strEq x y) (nameIn x ys)
def firstUnknown : List NArg → List String → Option String
  | .nil, _ => .none
  | .cons (.mk y _) rest, xs => match nameIn y xs with
    | .true => firstUnknown rest xs
    | .false => .some y
-- (an implicit or instance binder is passed over when it has no named argument)
def maskHeadN : List BKind → Bool
  | .cons b _ => match b with
    | .dflt => .false
    | _ => .true
  | .nil => .false
def maskTailN : List BKind → List BKind
  | .nil => .nil
  | .cons _ rest => rest
inductive NConv where
  | ok (args : List Syntax)
  | err (msg : String)
def convNArgs (names : List String) (m : List BKind) (named : List NArg) (pos : List Syntax)
    (explicitMode : Bool) (acc : List Syntax) : NConv :=
  match names with
  | .nil => match named with
    | .cons (.mk y _) _ => .err (String.append (String.append "no parameter named '" y) "'")
    | .nil => .ok (List.reverseOf acc pos)
  | .cons x xs =>
    let implicitB := Bool.and (maskHeadN m) (Bool.not explicitMode);
    match takeNamed x named with
    | .ok e named' => convNArgs xs (maskTailN m) named' pos explicitMode (.cons e acc)
    | .none => match implicitB with
      | .true => convNArgs xs (maskTailN m) named pos explicitMode (.cons holeStx acc)
      | .false => match pos with
        | .cons p ps => convNArgs xs (maskTailN m) named ps explicitMode (.cons p acc)
        | .nil => match named with
          | .nil => .ok (List.reverseOf acc .nil)
          | .cons (.mk y _) _ => match firstUnknown named xs with
            | .some z => .err (String.append (String.append "no parameter named '" z) "'")
            | .none => .err ("named argument '" +++ y +++ "' comes after the explicit parameter '" +++ x +++ "', which has no argument")
-- the parameter names of the head of an application, when it is a global (`@f` too)
def nameNamesAt (gs : Globals) (cx : Cx) (n : String) : List String :=
  match Scope.lookup (Cx.sc cx) n with
  | .none => .nil
  | .some i => match Nat.lt i (Cx.lvl cx) with
    | .true => .nil
    | .false => globalNames gs (i - Cx.lvl cx)
def headParamNames (gs : Globals) (cx : Cx) (h : Syntax) : List String :=
  match h with
  | .ident n => nameNamesAt gs cx n
  | _ => match strEq (kindOf h) "term.ident" with
    | .true => nameNamesAt gs cx (identOf h)
    | .false => match strEq (kindOf h) "term.explicit" with
      | .true => match kid h 1 with
        | .ident n => nameNamesAt gs cx n
        | _ => .nil
      | .false => .nil

mutual
-- infer the type of `s` (an identifier's leading implicit arguments are inserted)
def inferT (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  -- a `match` (or `if`) without an expected type: against a new metavariable, a type
  -- (stage 20a)
  match Bool.or (strEq (kindOf s) "term.match") (match ifMatch s with
    | .some _ => Bool.true
    | .none => .false) with
  | .true => match newMeta es cx (.vsort (.lnum 1)) with
    | .mk mt es1 =>
      let T := eval (TCtx.env (Cx.c cx)) mt;
      match checkT gs es1 cx s T with
      | .ok t _ es2 => .ok t (force es2 T) es2
      | e => e
  | .false => match inferHead gs es cx s with
    | .ok t ty es' m => insertImplicits gs es' cx t ty m
    | .err msg => .err msg
-- an application's head: the term, its type and the implicit mask that remains
def inferHead (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : HE :=
  let k := kindOf s;
  match s with
  | .ident n => identHead gs es cx n
  | _ => match strEq k "term.ident" with
    | .true => identHead gs es cx (identOf s)
    | .false => match strEq k "term.identUniv" with
      | .true => match kid s 0 with
        | .ident n => identUnivHead gs es cx n (kids (kid s 2))
        | _ => HE.err "universe levels need a name"
      | .false => match strEq k "term.explicit" with
      -- `@f`: no implicit arguments are inserted
      | .true => match kid s 1 with
        | .ident n => match identHead gs es cx n with
          | .ok t ty es' _ => HE.ok t ty es' .nil
          | e => e
        | _ => HE.err "@ needs an identifier"
      | .false => match inferT1 gs es cx s with
        | .ok t ty es' => HE.ok t ty es' .nil
        | .err m => HE.err m
def identHead (gs : Globals) (es : ES) (cx : Cx) (n : String) : HE :=
  let d := Cx.lvl cx;
  match Scope.lookupV (Cx.sc cx) n with
  | .privTo m => .err (("'" +++ privBase n) +++ "' is private to module " +++ m)
  | .missing => match splitLast n with
    -- `x.f`: the projection `T.f x`, for `x : T …`
    | .some (.mk base f) => match identHead gs es cx base with
      | .ok bt bty es1 m => match insertImplicits gs es1 cx bt bty m with
        | .ok bt' bty' es2 => match projT gs es2 cx bt' bty' f with
          | .err _ => .err (String.append "unknown identifier " n)
          | r => r
        | .err msg => .err msg
      | e => e
    | .none => match strEq n "Unit" with
      -- (built in, like `Type`, `True` and `False`: the kernel's `unit`, `ptrue`, `pfalse`)
      | .true => .ok (.unit 0) (.vsort (.lnum 1)) es .nil
      | .false => match strEq n "True" with
        | .true => .ok .ptrue (.vsort (.lnum 0)) es .nil
        | .false => match strEq n "False" with
          | .true => .ok .pfalse (.vsort (.lnum 0)) es .nil
          | .false => .err (String.append "unknown identifier " n)
  | .ok i => match Nat.lt i d with
    | .true => .ok (.var i) (lookup (TCtx.types (Cx.c cx)) i) es .nil
    | .false => match globalUse gs es cx (i - d) .nil with
      | .ok t ty es' m => .ok t ty es' m
      | .err msg => .err msg
-- `f.{l, …}`: a global at explicitly written levels (one per declaration parameter; `_` is
-- a fresh level metavariable). A local variable has no levels.
def identUnivHead (gs : Globals) (es : ES) (cx : Cx) (n : String) (ls : List Syntax) : HE :=
  let d := Cx.lvl cx;
  match Scope.lookup (Cx.sc cx) n with
  | .some i => match Nat.lt i d with
    | .true => HE.err (String.append "a local variable has no universe levels: " n)
    | .false => match globalUse gs es cx (i - d) ls with
      | .ok t ty es' m => .ok t ty es' m
      | .err msg => .err msg
  | .none => match strEq n "Unit" with
    | .true => HE.err "Unit has no universe levels in the self-hosted frontend"
    | .false => .err (String.append "unknown identifier " n)
-- the projection `T.f t`, for `t : T …`
def projT (gs : Globals) (es : ES) (cx : Cx) (bt : Tm) (bty : Val) (f : String) : HE := match force es bty with
  | .vglued (.hconst T _ _ _ _) _ _ => match identHead gs es cx (String.append (String.append T ".") f) with
    | .ok pt pty es3 pm => match insertImplicits gs es3 cx pt pty pm with
      | .ok pt' pty' es4 => match whnf (force es4 pty') with
        | .vpi _ _ _ dom env cod => match unify es4 cx bty dom with
          | .some es5 => .ok (.app pt' bt) (eval (.cons (eval (TCtx.env (Cx.c cx)) bt) env) cod) es5 .nil
          | .none => .err (String.append "cannot apply the projection " f)
        | _ => .err (String.append "not a projection: " f)
      | .err msg => .err msg
    | e => e
  | _ => .err (String.append "no field " f)
-- a numeral `n`: `Nat.succ` applied `n` times to `Nat.zero` (stage 18f; there are no
-- number literals in the kernel)
def numeral (gs : Globals) (es : ES) (cx : Cx) (n : Nat) : TE := match identHead gs es cx "Nat.zero" with
  | .ok z zty _ _ => match identHead gs es cx "Nat.succ" with
    | .ok sc _ _ _ => match identHead gs es cx "Nat.mul" with
      | .ok mul _ _ _ => .ok (binNat sc z mul n) zty es
      | .err _ => .ok (iterApp sc n z) zty es
    | .err m => .err m
  | .err _ => .err "numerals need Nat.zero and Nat.succ"
-- a string literal: `String.mk [Char.mk c₁, …]` (stage 19a)
def charsTm (lcons lnil ch cmk : Tm) (num : Nat → Tm) : List Char → Tm
  | .nil => .app lnil ch
  | .cons c rest => .app (.app (.app lcons ch) (.app cmk (num (Char.code c)))) (charsTm lcons lnil ch cmk num rest)
def stringLit (gs : Globals) (es : ES) (cx : Cx) (v : String) : TE :=
  let get := fun (n : String) => match identHead gs es cx n with
    | .ok t _ _ _ => Option.some t
    | .err _ => .none;
  match get "String.mk" with
  | .some smk => match get "List.cons" with
    | .some lcons => match get "List.nil" with
      | .some lnil => match get "Char" with
        | .some ch => match get "Char.mk" with
          | .some cmk => match get "Nat.succ" with
            | .some sc => match get "Nat.zero" with
              | .some z => match get "String" with
                | .some st =>
                  -- (the codes in binary, like numerals: stage 20b)
                  let num : Nat → Tm := match get "Nat.mul" with
                    | .some mul => fun (n : Nat) => binNat sc z mul n
                    | .none => fun (n : Nat) => iterApp sc n z;
                  match v with
                  | .mk cs => .ok (.app smk (charsTm lcons lnil ch cmk num cs)) (eval .nil st) es
                | .none => .err "strings need the Prelude"
              | .none => .err "strings need the Prelude"
            | .none => .err "strings need the Prelude"
          | .none => .err "strings need the Prelude"
        | .none => .err "strings need the Prelude"
      | .none => .err "strings need the Prelude"
    | .none => .err "strings need the Prelude"
  | .none => .err "strings need the Prelude"
-- apply metavariables for the leading implicit parameters
def insertImplicits (gs : Globals) (es : ES) (cx : Cx) (t : Tm) (ty : Val) (m : List BKind) : TE :=
  match m with
  | .cons .impl rest => match whnf ty with
    | .vpi _ _ _ dom env cod => match newImplicit es cx dom with
      | .mk mt es' => insertImplicits gs es' cx (.app t mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) rest
    | _ => .ok t ty es
  -- (A10) an instance argument: a metavariable and a class problem, solved at the end
  -- of the command (the class's arguments may not be known yet: `get` with its type
  -- from the expected type)
  | .cons .inst rest => match whnf ty with
    | .vpi _ _ _ dom env cod => match newImplicit es cx dom with
      | .mk mt es' => insertImplicits gs (ES.pinst es' (.mk mt dom cx)) cx (.app t mt)
          (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) rest
    | _ => .ok t ty es
  | _ => .ok t ty es
-- **The proof surface (A16)**. The kernel's forms for `Prop`, `Sort`, equality, `refl`,
-- `cast` and `transp` had no handlers before; these build them (and the kernel type
-- checks the result, as for every other term).
--
-- `a = b`: `eq A a b`, with `A` the type of `a` (a proposition, `Sort 0`)
def inferEq (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  match inferT gs es cx (kid s 0) with
  | .ok a ty es1 =>
    let d := Cx.lvl cx;
    let A := force es1 ty;
    match checkT gs es1 cx (kid s 2) A with
    | .ok b _ es2 => .ok (.eq (quote d A) a b) (.vsort (.lnum 0)) es2
    | e => e
  | e => e
-- `refl a`: `reflTy a` when `a` is a type (`EqTy a a`), else `refl A a` (`a =_A a`)
def inferRefl (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  match inferT gs es cx (kid s 1) with
  | .ok a ty es1 =>
    let d := Cx.lvl cx;
    let v := eval (TCtx.env (Cx.c cx)) a;
    let A := force es1 ty;
    match whnf A with
    | .vsort _ => .ok (.tyRefl a) (vEqType v v) es1
    | _ => .ok (.eqRefl (quote d A) a) (vEq A v v) es1
  | e => e
-- `rfl` against the expected type: an equation, at a term (`refl A a`) or between types
-- (`reflTy X`), or a proposition that computed to `True` (`()`). The kernel checks it.
def checkRfl (gs : Globals) (es : ES) (cx : Cx) (ty : Val) : TE :=
  let d := Cx.lvl cx;
  match whnf ty with
  | .vne (.heq A a b) .snil => .ok (.eqRefl (quote d A) (quote d a)) ty es
  | .vne (.heqTy X Y) .snil => .ok (.tyRefl (quote d X)) ty es
  | .vunit _ => .ok .star ty es
  | v => .err (String.append "rfl: the expected type is not an equation (it may have computed further): "
      (show (scopeNames (Cx.sc cx)) d (quote d v)))
-- `cast e t` along `e : A ≡ B`: `coe A B e t : B` (`t : A`)
def inferCast (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  match inferT gs es cx (kid s 1) with
  | .ok e ety es1 => match whnf (force es1 ety) with
    | .vne (.heqTy X Y) .snil =>
      let d := Cx.lvl cx;
      match checkT gs es1 cx (kid s 2) X with
      | .ok t _ es2 => .ok (.coe (quote d X) (quote d Y) e t) Y es2
      | e => e
    | .vempty _ => .err "cannot infer the type of this cast: its proof's type is an empty equation, so it no longer shows the target type; write `(cast e t : T)`"
    | .vunit _ => .err "cannot infer the type of this cast: its proof's type computed to True, so it no longer shows the target type; write `(cast e t : T)`"
    | v => .err (String.append "cannot infer the type of this cast: its proof's type is not an equation, but "
        (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) (quote (Cx.lvl cx) v)))
  | e => e
-- `transp P p e` along `e : a = b`: `subst A a P p b e : P b e`, with
-- `P : (b : A) → a = b → Prop` and `p : P a (refl A a)`
def inferTransp (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  match inferT gs es cx (kid s 3) with
  | .ok e ety es1 => match whnf (force es1 ety) with
    | .vne (.heq A a b) .snil =>
      let d := Cx.lvl cx;
      let i : Lvl := match sortOf (Cx.c cx) A with
        | .some l => l
        | .none => .lhole;
      -- `(b :0 A) → (_ :0 a =_A b) → Prop` (the kernel's `subst` motive type)
      let motiveTy : Val := .vpi .qz i (ln 1) A (.cons a (.cons A .nil))
        (.pi .qz (ln 0) (ln 1) (.eq (.var 2) (.var 1) (.var 0)) .prop);
      match checkT gs es1 cx (kid s 1) motiveTy with
      | .ok P _ es2 =>
        let vP := eval (TCtx.env (Cx.c cx)) P;
        match checkT gs es2 cx (kid s 2) (vapp (vapp vP a) (.vne (.hrefl A a) .snil)) with
        | .ok p _ es3 => .ok (.subst (quote d A) (quote d a) P p (quote d b) e)
            (vapp (vapp vP b) (suspend (TCtx.env (Cx.c cx)) e)) es3
        | e => e
      | e => e
    | v => .err (String.append "transp: expected a proof of an equation, got "
        (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) (quote (Cx.lvl cx) v)))
  | e => e
-- the other forms
def inferT1 (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  let k := kindOf s;
  match strEq k "term.paren" with
  | .true => inferT gs es cx (kid s 1)
  | .false => match strEq k "term.num" with
    | .true => match numTooBig s with
      | .true => .err "the numeral does not fit in 63 bits (numbers are 63-bit words here)"
      | .false => numeral gs es cx (numValue s)
    | .false => match strEq k "term.str" with
    | .true => stringLit gs es cx (strValue s)
    | .false => match strEq k "term.unitVal" with
    | .true => .ok .star (.vunit 1) es
    | .false => match strEq k "term.type" with
    | .true => match levelArg es s (.lnum 0) with
      | .err m => .err m
      | .ok l es1 => .ok (lvlTypeTm l) (lvlTypeSort l) es1
    | .false => match strEq k "term.sort" with
    | .true => match levelArg es s (.lnum 0) with
      | .err m => .err m
      | .ok l es1 => .ok (lvlSortTm l) (lvlSortSort l) es1
    | .false => match strEq k "term.prop" with
    | .true => .ok .prop (.vsort (.lnum 1)) es
    | .false => match strEq k "term.eq" with
    | .true => inferEq gs es cx s
    | .false => match strEq k "term.refl" with
    | .true => inferRefl gs es cx s
    | .false => match strEq k "term.cast" with
    | .true => inferCast gs es cx s
    | .false => match strEq k "term.transp" with
    | .true => inferTransp gs es cx s
    | .false => match strEq k "term.rfl" with
    | .true => .err "cannot infer the type of rfl; add a type ascription"
    | .false => match strEq k "term.app" with
      | .true => match inferHead gs es cx (kid s 0) with
        | .ok f fty es' m => appArgsNamed gs es' cx (kid s 0) f fty m (kids (kid s 1)) .nil .none .nil
        | .err msg => .err msg
      | .false => match strEq k "term.arrow" with
        | .true => match inferType gs es cx (kid s 0) with
          | .ok a la es1 => match inferType gs es1 (Cx.bind cx "_" (eval (TCtx.env (Cx.c cx)) a)) (kid s 2) with
            | .ok b lb es2 => .ok (piSorted es2 a b la lb) (.vsort (.limax (sortLvl es2 la) (sortLvl es2 lb))) es2
            | e => e
          | e => e
        | .false => match strEq k "term.depArrow" with
          | .true => match binderType (kid s 0) with
            | .some aStx => match binderQ (kid s 0) with
              | .some q => depPis gs es cx q (binderNames (kid s 0)) aStx (kid s 2)
              | .none => .err qtyErr
            | .none => .err "a Π needs a binder type"
          | .false => match strEq k "term.ascription" with
            | .true => match inferType gs es cx (kid s 3) with
              | .ok T _ es1 =>
                let Tv := eval (TCtx.env (Cx.c cx)) T;
                match checkT gs es1 cx (kid s 1) Tv with
                | .ok t _ es2 => .ok (.ann t T) Tv es2
                | e => e
              | e => e
            | .false => match strEq k "term.let" with
              | .true => letT gs es cx s .none
              | .false => match strEq k "term.field" with
              | .true => match inferT gs es cx (kid s 0) with
                | .ok t ty es1 => match projT gs es1 cx t ty (match kid s 2 with
                    | .ident f => f
                    | _ => "_") with
                  | .ok t' ty' es2 _ => .ok t' ty' es2
                  | .err m => .err m
                | e => e
              | .false => match strEq k "term.fun" with
                | .true => match Nat.beq (lenL (binders (kids (kid s 1)))) (lenL (fieldsOf (kids (kid s 1)))) with
                  | .true => match binderQs (kids (kid s 1)) with
                    | .some qs => inferLams gs es cx qs (fieldsOf (kids (kid s 1))) (kid s 3)
                    | .none => .err qtyErr
                  | .false => .err "cannot infer the type of a λ; add a type ascription"
                | .false => match strEq k "term.structUpdate" with
                  | .true => structUpdT gs es cx s
                  | .false => inferT2 gs es cx s
-- `{ s with … }` (13i, 13p): `let upd✝ := s; S.mk …` (`updArgs`), checked against the
-- type of `s`
def structUpdT (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  let outer := match kid s 5 with
    | .atom o => o
    | _ => "";
  match inferT gs es cx (kid s 1) with
  | .err m => .err m
  | .ok t sty es1 =>
    let d := Cx.lvl cx;
    let A := quote d (force es1 sty);
    let tyStr := show (scopeNames (Cx.sc cx)) d A;
    match structOf gs es1 sty with
    | .none => .err (match strEq outer "" with
      | .true => String.append "structure update needs a value of a structure type, not one of type " tyStr
      | .false => String.append (String.append (String.append "field '" outer) "' is not a structure (its type is ")
          (String.append tyStr "), so its fields can't be updated"))
    | .some S => match Globals.structFields gs S with
      | .none => .err "internal error: a structure without fields"
      | .some fields =>
        let ups := updsOf (kids (kid s 3));
        match updErr S fields outer ups .nil .nil with
        | .some m => .err m
        | .none =>
          let cx' := Cx.define cx "upd✝" (eval (TCtx.env (Cx.c cx)) t) sty;
          let mk := mkNode "term.ident" (one (.ident (String.append S ".mk")));
          let app := match updArgs S outer ups fields with
            | .nil => mk
            | .cons a as => mkNode "term.app" (.cons mk (one (mkNull (.cons a as))));
          match checkT gs es1 cx' app sty with
          | .ok b _ es2 => .ok (.letE A t b) sty es2
          | e => e
-- Σ types, pairs and `∀` (as the Lean frontend's `term.prod`, `term.depSigma`,
-- `term.tuple`, `term.proj` and `term.forall`), and a hole as a type (stage 21u)
def inferT2 (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  let k := kindOf s;
  match strEq k "term.prod" with
  | .true => match inferType gs es cx (kid s 0) with
    | .ok a la es1 => match inferType gs es1 (Cx.bind cx "_" (eval (TCtx.env (Cx.c cx)) a)) (kid s 2) with
      | .ok b lb es2 => .ok (sigmaSorted .qw es2 a b la lb) (.vsort (.lmax (sortLvl es2 la) (sortLvl es2 lb))) es2
      | e => e
    | e => e
  | .false => match strEq k "term.depSigma" with
    | .true => match binderType (kid s 0) with
      | .some aStx => match binderQ (kid s 0) with
        | .some q => depSigmas gs es cx q (binderNames (kid s 0)) aStx (kid s 2)
        | .none => .err qtyErr
      | .none => .err "a Σ needs a binder type"
    | .false => match strEq k "term.forall" with
      | .true => forallPis gs es cx (kids (kid s 1)) (kid s 3)
      | .false => match strEq k "term.proj" with
        | .true => match inferT gs es cx (kid s 0) with
          | .ok t ty es1 => match whnf (force es1 ty) with
            | .vsigma _ _ _ A env B => match Nat.beq (numValue (kid s 2)) 1 with
              | .true => .ok (.fst t) A es1
              | .false => match Nat.beq (numValue (kid s 2)) 2 with
                | .true => .ok (.snd t) (eval (.cons (vfst (eval (TCtx.env (Cx.c cx)) t)) env) B) es1
                | .false => .err "a projection is .1 or .2"
            | _ => .err (String.append "cannot project from a value of type " (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) (quote (Cx.lvl cx) (force es1 ty))))
          | e => e
        | .false => match strEq k "term.tuple" with
          | .true => inferTuple gs es cx (tupleItems s)
          | .false => match strEq k "term.hole" with
            | .true => match newMeta es cx (.vsort (.lnum 1)) with
              | .mk mt es1 => .ok mt (.vsort (.lnum 1)) es1
            | .false => match strEq k "term.namedArg" with
              | .true => .err "a named argument `(x := e)` is only allowed as an argument of an application"
              | .false => .err (String.append "unsupported syntax " k)
-- `(x y : A) × B`
def depSigmas (gs : Globals) (es : ES) (cx : Cx) (q : Q) (xs : List String) (aStx body : Syntax) : TE := match xs with
  | .nil => inferType gs es cx body
  | .cons x rest => match inferType gs es cx aStx with
    | .ok a la es1 => match depSigmas gs es1 (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) a)) q rest aStx body with
      | .ok b lb es2 => .ok (sigmaSorted q es2 a b la lb) (.vsort (.lmax (sortLvl es2 la) (sortLvl es2 lb))) es2
      | e => e
    | e => e
-- `∀ x (y z : A) {w : B}, C`: one Π per name; a binder without a type gets a hole
def forallPis (gs : Globals) (es : ES) (cx : Cx) (bs : List Syntax) (body : Syntax) : TE := match bs with
  | .nil => inferType gs es cx body
  | .cons b rest => match binderQ b with
    | .none => .err qtyErr
    | .some q => forallNames gs es cx q (binderNames b) (match binderType b with
        | .some t => t
        | .none => holeStx) rest body
def forallNames (gs : Globals) (es : ES) (cx : Cx) (q : Q) (xs : List String) (aStx : Syntax) (bs : List Syntax) (body : Syntax) : TE := match xs with
  | .nil => forallPis gs es cx bs body
  | .cons x xs' => match inferType gs es cx aStx with
    | .ok a la es1 => match forallNames gs es1 (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) a)) q xs' aStx bs body with
      | .ok b lb es2 => .ok (piSortedQ q es2 a b la lb) (.vsort (.limax (sortLvl es2 la) (sortLvl es2 lb))) es2
      | e => e
    | e => e
-- `(a, b, c)` without an expected type: `A × (B × C)`
def inferTuple (gs : Globals) (es : ES) (cx : Cx) (items : List Syntax) : TE := match items with
  | .nil => .ok .star (.vunit 1) es
  | .cons a .nil => inferT gs es cx a
  | .cons a rest => match inferT gs es cx a with
    | .ok ta A es1 => match inferTuple gs es1 cx rest with
      | .ok tb B es2 =>
        -- (annotated: the kernel can't infer the type of a pair)
        let d := Cx.lvl cx;
        let S : Tm := sigmaTm .qw (quote d (force es2 A)) (shiftTm 1 0 (quote d (force es2 B)));
        .ok (.ann (.pair ta tb) S) (eval (TCtx.env (Cx.c cx)) S) es2
      | e => e
    | e => e
-- `(a, b, c)` against a Σ type
def checkTuple (gs : Globals) (es : ES) (cx : Cx) (items : List Syntax) (ty : Val) : TE := match items with
  | .nil => .err "an empty tuple"
  | .cons a .nil => checkT gs es cx a ty
  | .cons a rest => match whnf (force es ty) with
    | .vsigma _ _ _ A env B => match checkT gs es cx a A with
      | .ok ta _ es1 => match checkTuple gs es1 cx rest (eval (.cons (eval (TCtx.env (Cx.c cx)) ta) env) B) with
        | .ok tb _ es2 => .ok (.pair ta tb) ty es2
        | e => e
      | e => e
    | _ => .err (String.append "a tuple against a type that isn't a Σ type: " (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) (quote (Cx.lvl cx) (force es ty))))
-- `fun (x : A) … => b` with every binder typed: `(x : A) → B` (stage 20a)
def inferLams (gs : Globals) (es : ES) (cx : Cx) (qs : List Q) : List Field → Syntax → TE
  | .nil, body => inferT gs es cx body
  | .cons (.mk x _ _ aS) rest, body => match strEq (kindOf aS) "" with
    | .true => .err "cannot infer the type of a λ; add a type ascription"
    | .false => match inferType gs es cx aS with
      | .ok A _ es1 =>
        let cx' := Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A);
        match inferLams gs es1 cx' (tailQ qs) rest body with
        | .ok b bty es2 => .ok (.lam b) (eval (TCtx.env (Cx.c cx)) (piTm (headQ qs) A (quote (Cx.lvl cx') (force es2 bty)))) es2
        | e => e
      | e => e
-- a type: its sort is computed again by the kernel later, so any sort is fine here
def inferType (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE := match inferT gs es cx s with
  | .ok t ty es' => match whnf (force es' ty) with
    | .vsort _ => .ok t ty es'
    | _ => .err (String.append "not a type: " (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) t))
  | e => e
-- `(x y : A) → B`
def depPis (gs : Globals) (es : ES) (cx : Cx) (q : Q) (xs : List String) (aStx body : Syntax) : TE := match xs with
  | .nil => inferType gs es cx body
  | .cons x rest => match inferType gs es cx aStx with
    | .ok a la es1 => match depPis gs es1 (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) a)) q rest aStx body with
      | .ok b lb es2 => .ok (piSortedQ q es2 a b la lb) (.vsort (.limax (sortLvl es2 la) (sortLvl es2 lb))) es2
      | e => e
    | e => e
-- the arguments of an application, inserting implicit ones by the mask. A `.c`
-- argument whose type isn't known yet is postponed: a metavariable stands for it until
-- the other arguments are done
def appArgsT (gs : Globals) (es : ES) (cx : Cx) (f : Tm) (fty : Val) (m : List BKind) (args : List Syntax) (post : List Post)
    (expected : Option Val) (pre : List Tm) : TE :=
  match args with
  | .nil => match insertImplicits gs es cx f fty m with
    | .ok f' fty' es1 =>
      -- the expected type first: it may fix what the postponed arguments need
      let es2 := match expected with
        | .some T => match unify es1 cx fty' T with
          | .some e => e
          | .none => es1
        | .none => es1;
      match resolvePosts gs es2 cx post with
      | .some es3 => .ok f' fty' es3
      | .none => .err "could not elaborate a constructor argument"
    | e => e
  | .cons a rest => match m with
    | .cons .inst m' => match whnf fty with
      -- (A10) the instance argument's metavariable, and its class problem
      | .vpi _ _ _ dom env cod => match pre with
        | .cons mt0 pre' =>
          let mt := match zonk es (Cx.lvl cx) mt0 with
            | .some z => z
            | .none => mt0;
          appArgsT gs (ES.pinst es (.mk mt dom cx)) cx (.app f mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) m' args post expected pre'
        | .nil => match newMeta es cx dom with
          | .mk mt es' => appArgsT gs (ES.pinst es' (.mk mt dom cx)) cx (.app f mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) m' args post expected .nil
      | _ => .err "too many instance arguments"
    | .cons .impl m' => match whnf fty with
      | .vpi _ _ _ dom env cod => match pre with
        -- (an implicit argument's metavariable made by `preArgs`, as its solution: a
        -- solved metavariable in a later argument's type would not compute there)
        | .cons mt0 pre' =>
          let mt := match zonk es (Cx.lvl cx) mt0 with
            | .some z => z
            | .none => mt0;
          appArgsT gs es cx (.app f mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) m' args post expected pre'
        | .nil => match newImplicit es cx dom with
          | .mk mt es' => appArgsT gs es' cx (.app f mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) m' args post expected .nil
      | _ => .err "too many implicit arguments"
    | _ => match whnf (force es fty) with
      | .vpi _ _ _ dom env cod => match Bool.and (postponable a) (Bool.or (isMetaApp es dom) (funDomMeta es a dom)) with
        | .true => match newMeta es cx dom with
          | .mk mt es1 => appArgsT gs es1 cx (.app f mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) (tailKinds m) rest
              (.cons (.mk a dom mt) post) expected pre
        | .false => match checkT gs es cx a dom with
          | .ok ta _ es1 => appArgsT gs es1 cx (.app f ta) (eval (.cons (eval (TCtx.env (Cx.c cx)) ta) env) cod) (tailKinds m) rest post expected pre
          | e => e
      | ty => .err (String.append "not a function: its type is " (show .nil (Cx.lvl cx) (quote (Cx.lvl cx) ty)))
-- the arguments of an application; with named ones, rewritten to positional first
def appArgsNamed (gs : Globals) (es : ES) (cx : Cx) (h : Syntax) (f : Tm) (fty : Val) (m : List BKind)
    (args : List Syntax) (post : List Post) (expected : Option Val) (pre : List Tm) : TE :=
  match hasNamedArgs args with
  | .false => appArgsT gs es cx f fty m args post expected pre
  | .true => match splitNArgs args .nil .nil with
    | .err msg => .err msg
    | .ok named pos => match convNArgs (headParamNames gs cx h) m named pos (strEq (kindOf h) "term.explicit") .nil with
      | .err msg => .err msg
      | .ok args' => appArgsT gs es cx f fty .nil args' post expected .nil
-- (stage 21j) An application of a constructor with implicit parameters, checked
-- against `ty`: the expected type first (`checkApp` in the Lean elaborator). `preArgs`
-- makes the implicit arguments' metavariables and a placeholder for each explicit
-- argument, and the result type is unified with `ty`, which solves the parameters the
-- arguments' types mention (`Fin.mk 3 rfl : Fin 5`: `rfl` is then checked against
-- `Nat.lt 3 5 = .true`). The placeholders are dropped: `appArgsT` checks the
-- arguments, with the implicit metavariables made here. Without a solution, the
-- arguments come first, as before.
def appExpected (gs : Globals) (es : ES) (cx : Cx) (h : Syntax) (f : Tm) (fty : Val) (m : List BKind) (args : List Syntax) (ty : Val) : TE :=
  -- (A9) named arguments are rewritten first; the constructor-parameter optimization
  -- below takes positional arguments only
  match hasNamedArgs args with
  | .true => appArgsNamed gs es cx h f fty m args .nil (.some ty) .nil
  | .false => match Bool.and (ctorHead gs cx h) (headImplicit m) with
    | .false => appArgsT gs es cx f fty m args .nil (.some ty) .nil
    | .true => match preArgs es cx fty m args with
      | .some (.mk ims rty es1) => match unify es1 cx rty ty with
        | .some es2 => appArgsT gs es2 cx f fty m args .nil (.some ty) ims
        | .none => appArgsT gs es cx f fty m args .nil (.some ty) .nil
      | .none => appArgsT gs es cx f fty m args .nil (.some ty) .nil
-- the postponed arguments, each unified with its metavariable (one whose type is
-- still unknown waits longer: `drain`)
def resolvePosts (gs : Globals) (es : ES) (cx : Cx) : List Post → Option ES
  | .nil => .some es
  | .cons (.mk a dom mt) rest => match resolvePosts gs es cx rest with
    | .some es1 => match isMetaApp es1 dom with
      | .true => .some (ES.pend es1 (.mk a dom mt cx))
      | .false => match checkT gs es1 cx a dom with
        | .ok t _ es2 =>
          let env := TCtx.env (Cx.c cx);
          unify es2 cx (eval env mt) (eval env t)
        | .err _ => .none
    | .none => .none
-- the arguments still waiting, while some can be done
def drainList (gs : Globals) : ES → Bool → List Pend → DR
  | es, pr, .nil => .ok es pr
  | es, pr, .cons (.mk a dom mt cx) rest => match isMetaApp es dom with
    | .true => drainList gs (ES.pend es (.mk a dom mt cx)) pr rest
    | .false => match checkT gs es cx a dom with
      | .ok t _ es2 =>
        let env := TCtx.env (Cx.c cx);
        match unify es2 cx (eval env mt) (eval env t) with
        | .some es3 => drainList gs es3 .true rest
        | .none => .err
      | .err _ => .err
def drain (gs : Globals) (es : ES) : Option ES := match es with
  | .mk ms ps ls lps ins => match ps with
    | .nil => .some es
    | .cons _ _ => match drainList gs (.mk ms .nil ls lps ins) .false ps with
      | .ok es' pr => match pr with
        | .true => drain gs es'
        | .false => .none
      | .err => .none

-- `let x : A := v; b`, inferred or checked
-- (`let q x := v; b`, stage 21m: a `letq` unless `q` is ω: `letTm`)
def letT (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) (expected : Option Val) : TE :=
  let q := match writtenQ (kid s 1) with
    | .is q => q
    | _ => Q.qw;
  let body := fun (A : Tm) (Av : Val) (v : Tm) (es2 : ES) => (match kid s 2 with
    | .ident x =>
      let cx' := Cx.define cx x (eval (TCtx.env (Cx.c cx)) v) Av;
      match expected with
      | .some T => match checkT gs es2 cx' (kid s 7) T with
        | .ok b _ es3 => TE.ok (letTm q A v b) T es3
        | e => e
      | .none => match inferT gs es2 cx' (kid s 7) with
        | .ok b bty es3 => .ok (letTm q A v b) bty es3
        | e => e
    | _ => TE.err "let needs a name" : TE);
  match (match writtenQ (kid s 1) with
    | .bad => Bool.true
    | _ => Bool.false) with
  | .true => .err qtyErr
  | .false => match binderType s with
  -- (without a type, the value's inferred type: stage 19c)
  | .none => match inferT gs es cx (kid s 5) with
    | .ok v Av es2 => body (quote (Cx.lvl cx) (force es2 Av)) Av v es2
    | e => e
  | .some tyS => match inferType gs es cx tyS with
    | .ok A _ es1 =>
      let Av := eval (TCtx.env (Cx.c cx)) A;
      match checkT gs es1 cx (kid s 5) Av with
      | .ok v _ es2 => body A Av v es2
      | e => e
    | e => e
-- check `s` against `ty`
def checkT (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) (ty : Val) : TE :=
  let k := kindOf s;
  match strEq k "term.paren" with
  | .true => checkT gs es cx (kid s 1) ty
  | .false => match dotCtor gs es ty s with
    | .some s' => checkT gs es cx s' ty
    | .none => match ifMatch s with
    | .some s' => checkT gs es cx s' ty
    | .none => match strEq k "term.match" with
    | .true => termMatch gs es cx s (force es ty)
    | .false => match strEq k "term.hole" with
    | .true => match newMeta es cx ty with
      | .mk mt es' => .ok mt ty es'
    | .false => match strEq k "term.tuple" with
    | .true => checkTuple gs es cx (tupleItems s) ty
    | .false => match strEq k "term.fun" with
      | .true => checkLams gs es cx (binders (kids (kid s 1))) (binderWs (kids (kid s 1))) (kid s 3) ty
      | .false => match strEq k "term.let" with
        | .true => letT gs es cx s (.some ty)
        | .false => match strEq k "term.rfl" with
        | .true => checkRfl gs es cx (force es ty)
        | .false => match (match strEq k "term.app" with
          | .true => match inferHead gs es cx (kid s 0) with
            | .ok f fty es1 m => appExpected gs es1 cx (kid s 0) f fty m (kids (kid s 1)) ty
            | .err msg => TE.err msg
          | .false => inferT gs es cx s) with
          | .ok t ty' es' => match unify es' cx ty' ty with
            | .some es2 => .ok t ty es2
            | .none => .err (String.append (String.append "type mismatch: expected " (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) (quote (Cx.lvl cx) (force es' ty))))
                (String.append ", got " (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) (quote (Cx.lvl cx) (force es' ty')))))
          | e => e
-- a `match` as a term (stage 18g): its scrutinees are `let`-bound, then the clauses are
-- compiled against the expected type (no recursion: that is a definition's)
def termMatch (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) (ty : Val) : TE :=
  match scrutLets gs es cx (nonAtoms (kids (kid s 1))) with
  | .err m => .err m
  | .ok cx' cols wrap es1 =>
    let d := Cx.lvl cx';
    match sortOf (Cx.c cx') ty with
    | .none => .err "the type of a match must be a type"
    | .some l => match lvlClosed l with
      | .none => .err "the universe of a match's type must be a number"
      | .some v =>
        let R := quote d ty;
        let mc := MatchCtx.mk "" .nil 0 d v R R .tnil .tnil .nil;
        match compileM gs mc es1 cx' ty cols .false .nil (clausesOf (kids (kid s 3))) with
        | .ok t es2 => .ok (wrap t) ty es2
        | .err m => .err m
def scrutLets (gs : Globals) (es : ES) (cx : Cx) : List Syntax → SL
  | .nil => .ok cx .nil (fun b => b) es
  | .cons x rest => match inferT gs es cx x with
    | .err m => .err m
    | .ok t xty es1 =>
      let d := Cx.lvl cx;
      let A := quote d (force es1 xty);
      match scrutLets gs es1 (Cx.define cx "x✝" (eval (TCtx.env (Cx.c cx)) t) xty) rest with
      | .ok cx' cols wrap es2 => .ok cx' (.cons (.mk d A A .qw) cols) (fun b => .letE A t (wrap b)) es2
      | e => e
-- `fun x y => b` against a Π type
-- (a binder's written quantity must be the Π's, as in Lean's `checkFun`)
def checkLams (gs : Globals) (es : ES) (cx : Cx) (xs : List String) (ws : List QW) (body : Syntax) (ty : Val) : TE := match xs with
  | .nil => checkT gs es cx body ty
  | .cons x rest => match whnf (force es ty) with
    | .vpi q _ _ dom env cod =>
      let cx' := Cx.bind cx x dom;
      let go := fun (u : Unit) => (match checkLams gs es cx' rest (match ws with
          | .nil => .nil
          | .cons _ ws' => ws') body (eval (.cons (fresh (Cx.lvl cx)) env) cod) with
        | .ok b _ es' => TE.ok (.lam b) ty es'
        | e => e : TE);
      match ws with
      | .cons (.is q') _ => match qEq q q' with
        | .true => go ()
        | .false => .err (String.append (String.append "binder quantity " (qName q')) (String.append " does not match the expected " (qName q)))
      | .cons .bad _ => .err qtyErr
      | _ => go ()
    | _ => .err "a λ against a type that isn't a function type"
-- compile the clauses over the columns in the context `cx`, against `expected`;
-- `top`: the next split is the structural one; `ihLvls`: the fields with hypotheses
def compileM (gs : Globals) (mc : MatchCtx) (es : ES) (cx : Cx) (expected : Val) (cols : List Col)
    (top : Bool) (ihLvls : List Nat) (cls : List Clause) : CE :=
  match cls with
  | .nil => .err "missing case"
  | .cons (.mk pats binds rhs) _ => match firstCtorCol pats 0 with
    | .none =>
      -- a leaf: bind the variables, rewrite the recursive calls, elaborate against the
      -- expected type
      let binds' := List.append binds (varBinds pats cols);
      let rhs' := rewriteRec mc binds' (ihNamesOf ihLvls binds') rhs;
      let cx' := bindCx cx binds';
      match checkT gs es cx' rhs' expected with
      | .err m => .err m
      | .ok b _ es0 => match drain gs es0 with
      | .none => .err "could not elaborate a constructor argument"
      | .some es1 => match resolveAll gs es1 100 with
      | .err m => .err m
      | .ok es' => match zonk es' (Cx.lvl cx') b with
        | .none => .err "could not infer an implicit argument"
        | .some b' => .ok (bindLetsT b' cx binds') es'
    | .some k => match Bool.and (Bool.not top) (shareableLast cls) with
      -- a last clause of variables, in case analysis: its body is the same in every
      -- branch it reaches (a variable on the split column stands for the scrutinee), so
      -- it is elaborated once, `let dflt✝ := …`, and the clause refers to it (stage 20b;
      -- a match on a type of 70 constructors copied it 70 times)
      | .true => match lastClause cls with
        | .some (.mk lpats lbinds lrhs) =>
          let binds' := List.append lbinds (varBinds lpats cols);
          let rhs' := rewriteRec mc binds' (ihNamesOf ihLvls binds') lrhs;
          let cx' := bindCx cx binds';
          match checkT gs es cx' rhs' expected with
          | .err m => .err m
          | .ok b _ es0 => match drain gs es0 with
            | .none => .err "could not elaborate a constructor argument"
            | .some es0' => match resolveAll gs es0' 100 with
            | .err m => .err m
            | .ok es1 => match zonk es1 (Cx.lvl cx') b with
              | .none => .err "could not infer an implicit argument"
              | .some b' =>
                let dv := bindLetsT b' cx binds';
                let d := Cx.lvl cx;
                let nm := String.append "dflt✝" (Nat.toString d);
                let cxD := Cx.define cx nm (eval (TCtx.env (Cx.c cx)) dv) expected;
                match splitCol gs mc es1 cxD expected cols top ihLvls
                    (replaceLastRhs (mkNode "term.ident" (one (.ident nm))) cls) k with
                | .ok body es2 => .ok (.letE (quote d expected) dv body) es2
                | e => e
        | .none => splitCol gs mc es cx expected cols top ihLvls cls k
      | .false =>
        -- the first split is on the structural column
        let k' := match top with
          | .true => match mc with
            | .mk _ _ p _ _ _ _ _ _ _ => colIndex p cols 0 k
          | .false => k;
        splitCol gs mc es cx expected cols top ihLvls cls k'
-- the index of the column at level `l` (else `dflt`)
def colIndex (l : Nat) : List Col → Nat → Nat → Nat
  | .nil, _, dflt => dflt
  | .cons (.mk l' _ _ _) rest, i, dflt => match Nat.beq l l' with
    | .true => i
    | .false => colIndex l rest (i + 1) dflt
-- a type whose head is a definition, unfolded (at depth `d`) until it is an inductive
-- type's (stage 19d)
def unfoldTy (gs : Globals) (d : Nat) (ty : Tm) : Tm := match headOf ty .tnil with
  | .mk T args => match Globals.ind gs T with
    | .some _ => ty
    | .none => match headTm ty with
      | .const _ _ _ v _ => unfoldTy gs d (nfAt d (tApps v args))
      | _ => ty
  | .none => ty
-- the first column with a constructor pattern
def firstCtorCol : List Syntax → Nat → Option Nat
  | .nil, _ => .none
  | .cons p rest, i => match isVarPat p with
    | .true => firstCtorCol rest (i + 1)
    | .false => .some i
def varBinds : List Syntax → List Col → List Bind
  | .cons p ps, .cons c cs => match strEq (identOf p) "_" with
    | .true => varBinds ps cs
    | .false => .cons (.mk (identOf p) c) (varBinds ps cs)
  | _, _ => .nil
-- (13q) split column `k`: by a literal test (`litTest`), or by constructors
def splitCol (gs : Globals) (mc : MatchCtx) (es : ES) (cx : Cx) (expected : Val) (cols : List Col)
    (top : Bool) (ihLvls : List Nat) (cls : List Clause) (k : Nat) : CE :=
  let p0 := patAt k cls;
  let lit := Bool.or (isLitPat p0) (isPlusPat p0);
  match strEq (kindOf p0) "term.tuple" with
  | .true => splitTuple gs mc es cx expected cols top ihLvls cls k
  | .false => match nthCol cols k with
    | .mk L ty0 _ _ => match headOf (unfoldTy gs L ty0) .tnil with
      | .mk T _ => match Bool.and lit (Bool.not (strEq T "Nat")) with
        | .true => litTest gs mc es cx expected cols top ihLvls cls k
        | .false => match Globals.ind gs T with
          | .some _ => match litSplitErr T k cls with
            | .some m => .err m
            | .none => splitCtors gs mc es cx expected cols top ihLvls cls k
          | .none => splitCtors gs mc es cx expected cols top ihLvls cls k
      | .none => match lit with
        | .true => litTest gs mc es cx expected cols top ihLvls cls k
        | .false => splitCtors gs mc es cx expected cols top ihLvls cls k
-- a pair pattern `(a, b)` in column `k`: project the pair into two `let`-bound columns
-- (`fst✝`, `snd✝`) and compile the clauses with `a` and `b` there; a pair is a Σ, so this
-- is not a constructor split and never the structural one
def splitTuple (gs : Globals) (mc : MatchCtx) (es : ES) (cx : Cx) (expected : Val)
    (cols : List Col) (top : Bool) (ihLvls : List Nat) (cls : List Clause) (k : Nat) : CE :=
  let d := Cx.lvl cx;
  let env := TCtx.env (Cx.c cx);
  match nthCol cols k with
  | .mk L ty0 tyI q =>
    let x : Tm := .var (d - 1 - L);
    let xA := shiftTm (d - L) 0 ty0;
    match whnf (force es (eval env xA)) with
    | .vsigma _ _ _ A envB B =>
      let v1 := vfst (eval env x);
      let v2 := vsnd (eval env x);
      let ty2 := eval (.cons v1 envB) B;
      let AQ := quote d A;
      let BQ := quote (d + 1) ty2;
      let cx1 := Cx.define cx "fst✝" v1 A;
      let cx2 := Cx.define cx1 "snd✝" v2 ty2;
      let col1 : Col := .mk d AQ AQ q;
      let col2 : Col := .mk (d + 1) BQ BQ q;
      let cols' := List.append (takeL k cols) (.cons col1 (.cons col2 (dropL (k + 1) cols)));
      match tupleClauses (.mk L ty0 tyI q) k cls with
      | .none => .err "a tuple pattern needs a pair: every clause in the column must be a tuple, a variable or _"
      | .some cls' => match compileM gs mc es cx2 expected cols' .false ihLvls cls' with
        | .ok body es' => .ok (.letE AQ (.fst (.var (d - 1 - L)))
            (.letE BQ (.snd (.var (d - L))) body)) es'
        | e => e
    | _ => .err "a tuple pattern needs a pair"
-- (13q) the test `T.beq x l` for the literal `l` in the first row of column `k`, `let`
-- bound (`lit✝` for `x`, `test✝`), and the clauses with the test's column (`litClauses`)
def litTest (gs : Globals) (mc : MatchCtx) (es : ES) (cx : Cx) (expected : Val) (cols : List Col)
    (top : Bool) (ihLvls : List Nat) (cls : List Clause) (k : Nat) : CE :=
  match nthCol cols k with
  | .mk L ty0 _ _ =>
    let d := Cx.lvl cx;
    let env := TCtx.env (Cx.c cx);
    let xA := shiftTm (d - L) 0 ty0;
    let xty := eval env xA;
    let tyStr := show (scopeNames (Cx.sc cx)) d xA;
    let p0 := patAt k cls;
    match Bool.and (Bool.not (isLitPat p0)) (plusBad p0) with
    | .true => .err "a pattern `p + k` needs a numeral `k` (as in `n + 2`)"
    | .false => match Bool.not (isLitPat p0) with
    | .true => .err (String.append "a pattern `n + k` needs a Nat, not " tyStr)
    | .false => match top with
      | .true => .err (String.append (String.append "structural recursion: the first argument must be matched by its constructors, and a literal pattern on " tyStr)
          " is an equality test")
      | .false => match beqHead gs d xA with
        | .none => .err (String.append (String.append "a literal pattern needs Nat, or a type T with literals and an equality test T.beq : T → T → Bool; " tyStr) " has none")
        | .some T => match anyVarAt k cls with
          | .false => .err (String.append (String.append "a match on literals of type " tyStr)
              " needs a catch-all case (`_` or a variable) after them: literals don't cover the type")
          | .true => match litColErr tyStr k cls with
            | .some m => .err m
            | .none =>
              let x : Tm := .var (d - 1 - L);
              let cx1 := Cx.define cx "lit✝" (eval env x) xty;
              let ident := fun (n : String) => mkNode "term.ident" (one (.ident n));
              let testS := mkNode "term.app" (.cons (ident (String.append T ".beq")) (one (mkNull (.cons (ident "lit✝") (one p0)))));
              match inferT gs es cx1 testS with
              | .err m => .err m
              | .ok tt bty es1 => match drain gs es1 with
                | .none => .err "could not elaborate a constructor argument"
                | .some es1' => match resolveAll gs es1' 100 with
                | .err m => .err m
                | .ok es2 => match zonk es2 (d + 1) tt with
                  | .none => .err "could not infer an implicit argument"
                  | .some tt' =>
                    let B := quote (d + 1) (force es2 bty);
                    let cx2 := Cx.define cx1 "test✝" (eval (TCtx.env (Cx.c cx1)) tt') bty;
                    match compileM gs mc es2 cx2 expected (colsInsert k (.mk (d + 1) B B .qw) cols) top ihLvls (litClauses p0 k cls) with
                    | .ok body es3 => .ok (.letE xA x (.letE B tt' body)) es3
                    | e => e
def splitCtors (gs : Globals) (mc : MatchCtx) (es : ES) (cx : Cx) (expected : Val) (cols : List Col)
    (top : Bool) (ihLvls : List Nat) (cls : List Clause) (k : Nat) : CE :=
  let d := Cx.lvl cx;
  match nthCol cols k with
  | .mk L ty0 tyI _ =>
    let ty := unfoldTy gs L ty0;
    match headOf ty .tnil with
    | .none => .err "a pattern on a value that isn't of an inductive type"
    | .mk T args => match Globals.ind gs T with
      | .none => .err (String.append "not an inductive type: " T)
      | .some (.mk np I D _ ctors fixed fam _) => match mc with
        | .mk _ params p n v R _ pts _ _ =>
          -- the parameters and the index (`tt` without one) of the scrutinee's type
          let pargs := tmsTake np args;
          let idx := match fixed with
            | .some f => f
            | .none => match tmsDrop np args with
              | .tcons j _ => j
              -- (`tt`, or a phantom tail's value)
              | .tnil => phantomVal I;
          let nidxE := match fixed with
            | .some _ => 1
            | .none => tmsLenF (tmsDrop np args);
          -- the description and index type with the parameters, at depth `dd`
          let DAt := fun (dd : Nat) => nfAt dd (tApps (tLams np D) (shiftTms (dd - L) pargs));
          let IAt := fun (dd : Nat) => nfAt dd (tApps (tLams np I) (shiftTms (dd - L) pargs));
          let XAt := fun (dd : Nat) => (.lam (.mu 0 (IAt (dd + 1)) (DAt (dd + 1)) (.var 0)) : Tm);
          -- the family at a size `s` (a term at depth `dd`)
          let XsAt := fun (dd : Nat) (s : Tm) => (.lam (.mus 0 (IAt (dd + 1)) (DAt (dd + 1)) (.var 0) (shiftTm 1 0 s)) : Tm);
          let DtAt := fun (dd t : Nat) => nfAt dd (.app (descFn (DAt dd)) (.var t));
          -- the motive's body (at depth `d + 2`): `R`, or at the structural split
          -- `(q : …) → R` over the parameters after the structural one
          let G := match top with
            | .true => n - 1 - p
            | .false => 0;
          let MB : Tm := match top with
            | .true => piTele (genTys p (d + 2) 0 (tmsDrop (p + 1) pts)) (shiftTm (d + 1 - p) G R)
            | .false => shiftTm (d + 2 - n) 0 R;
          -- a closed index (a tag, say): the motive also takes `e :0 i = idx`, so that the
          -- constructors whose index differs can be ruled out
          let modeB := Bool.and (Nat.beq nidxE 1) (match lowerTm L 0 idx with
            | .some _ => .true
            | .none => .false);
          let MB0 := MB;
          let MB : Tm := match modeB with
            | .true => piTm .qz (.eq (IAt (d + 2)) (.var 1) (shiftTm (d + 2 - L) 0 idx)) (shiftTm 1 0 MB0)
            | .false => MB0;
          -- (the motive's own binders `i`, `y` stay: only the context moves)
          let PAt := fun (dd : Nat) => (.lam (.lam (shiftTm (dd - d) 2 MB)) : Tm);
          -- Only the structural split needs induction (its method runs for the hypotheses
          -- too); the others are case analysis (`scase` at size ∞), whose method has no
          -- hypotheses but a size `j` first: there the method's binders start at `e = d + 1`
          -- and `ih` is `tt` (computing hypotheses nobody uses made nested matches
          -- exponential)
          let b := match top with
            | .true => 0
            | .false => 1;
          let e := d + b;
          -- (in case analysis the payload is at `μ^j`, and the motive is applied to
          -- `y := con (tag, rest) : μ^{↑j} D i`, below `μ D i`)
          let MT : Tm := match top with
            | .true => piH (nfAt (d + 4) (interpApp 0 (IAt (d + 4)) (DtAt (d + 4) 0) (XAt (d + 4)) (.var 3)))
                (piH (nfAt (d + 5) (tApps (allTm 0 v) (args6 (IAt (d + 5)) (DtAt (d + 5) 1) (XAt (d + 5)) (PAt (d + 5)) (.var 4) (.var 0))))
                  (shiftTm 4 0 MB))
            | .false => piH (nfAt (e + 4) (interpApp 0 (IAt (e + 4)) (DtAt (e + 4) 0) (XsAt (e + 4) (.var 4)) (.var 3)))
                (piH (.unit 0) (.letE (.mus 0 (IAt (e + 6)) (DAt (e + 6)) (.var 5) (.szSuc (.var 6))) (.con (.pair (.var 2) (.var 1)))
                  (nfAt (e + 7) (.app (.app (PAt (e + 7)) (.var 6)) (.var 0)))));
          -- the method's binders (`j`), `i`, `xs`, `ih`, in the context
          let env := TCtx.env (Cx.c cx);
          let cxJ := match top with
            | .true => cx
            | .false => Cx.bind cx "j✝" (.vsizeLt .vszInf);
          let cx1 := Cx.bind cxJ "i✝" (eval (TCtx.env (Cx.c cxJ)) (IAt e));
          let Xm := match top with
            | .true => XAt (e + 1)
            | .false => XsAt (e + 1) (.var 1);
          let cx2 := Cx.bind cx1 "xs✝" (eval (TCtx.env (Cx.c cx1)) (interpApp 0 (IAt (e + 1)) (DAt (e + 1)) Xm (.var 0)));
          let cx3 := match top with
            | .true => Cx.bind cx2 "ih✝" (eval (TCtx.env (Cx.c cx2))
                (tApps (allTm 0 v) (args6 (IAt (d + 2)) (DAt (d + 2)) (XAt (d + 2)) (PAt (d + 2)) (.var 1) (.var 0))))
            | .false => Cx.define cx2 "ih✝" .vtt (.vunit 1);
          -- the motive's body as a value (it doesn't use `i` and `y`)
          let MBv := eval (.cons .vtt (.cons .vtt env)) MB;
          match branches gs mc es cx3 expected cols top ihLvls cls k (.mk L ty tyI .qw) T np pargs nidxE I idx fam modeB MB0 MB MBv MT G b (lenL ctors) 0 ctors with
          | .err m => .err m
          | .ok bs es' =>
            let convoy : Tm := .app (.app (.ecase MT (.fst (.var 1)) bs) (.snd (.var 1))) (.var 0);
            let indT : Tm := match top with
              | .true => .ind 0 (IAt d) (DAt d) v (PAt d) (.lam (.lam (.lam convoy))) (shiftTm (d - L) 0 idx) (.var (d - 1 - L))
              | .false => .scase 0 .qw (IAt d) (DAt d) v (PAt d) (.lam (.lam (.lam (.letE (.unit 0) .star convoy)))) .szInf
                  (shiftTm (d - L) 0 idx) (.var (d - 1 - L));
            let withE : Tm := match modeB with
              | .true => .app indT (.eqRefl (IAt d) (shiftTm (d - L) 0 idx))
              | .false => indT;
            .ok (tApps withE (genVars d G (p + 1))) es'
-- a constructor of another member of a mutual family (its index `res`, the tag of its
-- member) at a member's closed index `idx`: ruled out whatever the clauses say (two
-- members may have constructors of the same name, `.s`)
def otherMember (idx res : Tm) : Bool := match idx with
  | .tag _ i => match res with
    | .tag _ j => Bool.not (Nat.beq i j)
    | _ => .false
  | _ => .false
-- one branch per constructor, in the context of the method's binders (`cx3`, at depth
-- `d + 3`): `fun rest ih => let fields; (let hyps; let cur✝; fun q =>) …`
def branches (gs : Globals) (mc : MatchCtx) (es : ES) (cx3 : Cx) (expected : Val) (cols : List Col)
    (top : Bool) (ihLvls : List Nat) (cls : List Clause) (k : Nat) (col : Col) (T : String) (np : Nat)
    (args : Tms) (nidx : Nat) (I idx fam : Tm) (modeB : Bool) (MB0 MB : Tm) (MBv : Val) (MT : Tm) (G b : Nat) (nc i : Nat) : List Ctor → BE
  | .nil => .ok .tnil es
  | .cons (.mk c fs res qs impl) rest =>
    let F := lenL fs;
    let d := Cx.lvl cx3 - 3;
    let d0 := d + 5;
    -- `rest` and `ih`: the convoy's motive at this constructor's tag
    let bt := whnf (eval (.cons (.vtag nc i) (TCtx.env (Cx.c cx3))) MT);
    let cx5 := match bt with
      | .vpi _ _ _ restTy e1 c1 =>
        let cx4 := Cx.bind cx3 "rest✝" restTy;
        match whnf (eval (.cons (fresh (d + 3)) e1) c1) with
        | .vpi _ _ _ ihTy _ _ => Cx.bind cx4 "ihs✝" ihTy
        | _ => Cx.bind cx4 "ihs✝" .vtt
      | _ => Cx.bind (Cx.bind cx3 "rest✝" .vtt) "ihs✝" .vtt;
    let next := fun (es1 : ES) => branches gs mc es1 cx3 expected cols top ihLvls cls k col T np args nidx I idx fam modeB MB0 MB MBv MT G b nc (i + 1) rest;
    -- the motive's body at the method's `i` (level `d`; the motive itself is over the
    -- context before the method's binders, and `j`)
    let MBi := eval (.cons .vtt (.cons (fresh d) (dropEnv (3 + b) (TCtx.env (Cx.c cx3))))) MB;
    match col with
    | .mk L _ _ _ => match fieldCols np L d0 args cx5 0 qs fs with
      | .mk wrap fcols recs cx6 =>
        let cls' := specialize T c k F impl col cls;
        match Bool.and modeB (Bool.or (isNilCl cls') (otherMember idx res)) with
        | .true =>
          -- no clause (or another member's constructor): ruled out by the index (else a
          -- missing case)
          match absurdBranch cx6 np L d d0 F args I idx res MBi with
          | .some body => match next es with
            | .ok bs es'' => .ok (.tcons (.lam (.lam (wrap body))) bs) es''
            | e => e
          | .none => .err (String.append "missing case " c)
        | .false =>
          let recsT : List Nat := match top with
            | .true => recs
            | .false => .nil;
          let Rc := lenL recsT;
          let ihLvls' := List.append ihLvls recsT;
          match ihLetsB gs MB0 MB (d + 2) d0 F np L args I idx modeB fcols cx6 0 recsT with
          | .mk wrapIH cx7 => match mc with
            | .mk _ params p n _ _ _ pts ptsI _ =>
              let base := d0 + F + Rc;
              let cols' := List.append (takeL k cols) (List.append fcols (dropL (k + 1) cols));
              -- at the structural split, the method also runs for the hypotheses: a
              -- variable for the column is the value at hand, `cur✝ := con (tag, rest)`
              -- (its index is the method's `i✝`, at level `d`); then `e` (with a
              -- closed index) and the later parameters are bound again (`fun q => …`)
              let curTy := match col with
                | .mk L' _ _ _ => tApps fam (tmsAppend (shiftTms (base - L') args) (match nidx with
                  | .zero => .tnil
                  | .succ _ => .tcons (.var (base - 1 - d)) .tnil));
              let curVal : Tm := .con (.pair (.tag nc i) (.var (F + Rc + 1)));
              let env7 := TCtx.env (Cx.c cx7);
              let top1 := match top with
                | .true => 1
                | .false => 0;
              let eB := match modeB with
                | .true => 1
                | .false => 0;
              let cx8 := match top with
                | .true => Cx.define cx7 "cur✝" (eval env7 curVal) (eval env7 curTy)
                | .false => cx7;
              -- with a closed index at the structural split, `cur✝` (at the method's index)
              -- is moved along `e` to the scrutinee's index: `cur'✝ := coe … cur✝`
              let De := base + 2;
              let tyAt := fun (dd : Nat) (ix : Tm) => match col with
                | .mk L' _ _ _ => tApps fam (tmsAppend (shiftTms (dd - L') args) (.tcons ix .tnil));
              let idxE := shiftTm (De - L) 0 idx;
              let curTyB := tyAt De idxE;
              -- (`subst` moves propositions: `coe` along `F i = F idx`, from `tyRefl (F i)`)
              let FiE := tyAt De (.var (De - 1 - d));
              let tyEq : Tm := .subst (nfAt De (tApps (tLams np I) (shiftTms (De - L) args))) (.var (De - 1 - d))
                (.lam (.lam (.eqTy (tyAt (De + 2) (.var (De + 1 - d))) (tyAt (De + 2) (.var 1))))) (.tyRefl FiE) idxE (.var 0);
              let curValB : Tm := .coe FiE curTyB tyEq (.var (De - 1 - base));
              let afterE := match modeB with
                | .true => match whnf MBi with
                  | .vpi _ _ _ eTy envE codE =>
                    let cxe := Cx.bind cx8 "e✝" eTy;
                    let rem := eval (.cons (fresh (Cx.lvl cx8)) envE) codE;
                    match top with
                    | .true =>
                      let enve := TCtx.env (Cx.c cxe);
                      Gen.mk (Cx.define cxe "cur'✝" (eval enve curValB) (eval enve curTyB)) rem
                    | .false => Gen.mk cxe rem
                  | t => Gen.mk cx8 t
                | .false => Gen.mk cx8 (match top with
                  | .true => MBi
                  | .false => expected);
              match afterE with
              | .mk cxE rem =>
                let gen := match top with
                  | .true => genBind es cxE rem (dropL (p + 1) params)
                  | .false => Gen.mk cxE rem;
                match gen with
                | .mk cx9 expected' =>
                  let curCol := match top with
                    | .true => match modeB with
                      | .true => Col.mk (base + 2) curTyB curTyB .qw
                      | .false => Col.mk base curTy curTy .qw
                    | .false => col;
                  let cols'' := match top with
                    | .true => regen p n (base + 1 + eB + eB) pts pts cols'
                    | .false => cols';
                  match compileM gs mc es cx9 expected' cols'' .false ihLvls' (specialize T c k F impl curCol cls) with
                  | .err m => .err (match strEq m "missing case" with
                    | .true => String.append "missing case " c
                    | .false => m)
                  | .ok body es' =>
                    let inE : Tm := match modeB with
                      | .true => .lam (match top with
                        | .true => .letE curTyB curValB (tLams G body)
                        | .false => tLams G body)
                      | .false => tLams G body;
                    let inner : Tm := match top with
                      | .true => .letE curTy curVal inE
                      | .false => inE;
                    match next es' with
                    | .ok bs es'' => .ok (.tcons (.lam (.lam (wrap (wrapIH inner)))) bs) es''
                    | e => e
end

-- `drain` and instance resolution alternate: solving a problem can solve a postponed
-- argument's type, and checking a postponed argument can make a problem ready
partial def finishRounds (gs : Globals) (es : ES) : Nat → InstRes
  | .zero => .err "could not finish the instance problems of a command"
  | .succ k => match drain gs es with
    | .none => .err "could not elaborate a constructor argument"
    | .some es1 => match es1 with
      | .mk _ _ _ _ .nil => .ok es1
      | _ => match resolveAll gs es1 100 with
        | .err m => .err m
        | .ok es2 => finishRounds gs es2 k
def finishElab (gs : Globals) (es : ES) : InstRes := finishRounds gs es 8

-- a definition `(binders) : T := v`: its type and value (zonked later)
inductive DefR where
  | ok (ty v : Tm) (es : ES)
  | err (msg : String)
mutual
def defT (gs : Globals) (es : ES) (cx : Cx) (bs : List Syntax) (tyS vS : Syntax) : DefR := match bs with
  | .nil => match inferType gs es cx tyS with
    | .ok R _ es1 => match checkT gs es1 cx vS (eval (TCtx.env (Cx.c cx)) R) with
      | .ok v _ es2 => .ok R v es2
      | .err m => .err m
    | .err m => .err m
  | .cons b rest => match binderType b with
    | .none => .err "the binders of a definition need types"
    | .some aS => match binderQ b with
      | .some q => defNames gs es cx q (binderNames b) aS rest tyS vS
      | .none => .err qtyErr
def defNames (gs : Globals) (es : ES) (cx : Cx) (q : Q) (xs : List String) (aS : Syntax) (rest : List Syntax) (tyS vS : Syntax) : DefR :=
  match xs with
  | .nil => defT gs es cx rest tyS vS
  | .cons x xs' => match inferType gs es cx aS with
    | .ok A _ es1 => match defNames gs es1 (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A)) q xs' aS rest tyS vS with
      | .ok ty v es2 => .ok (piTm q A ty) (.lam v) es2
      | e => e
    | .err m => .err m
end
-- the constants of a term replaced by the globals' inlined values (for `#reduce`, as
-- `quote` doesn't unfold constants)
mutual
def inlineTm (gs : Globals) : Tm → Tm
  | .const n ps ls _ _ => match Scope.find (Globals.scope gs) n with
    -- (`substIfAny`: a monomorphic global's inlined value is shared, not copied at every
    -- use; `tmSubst` rebuilt it, so a large definition's inlined form grew exponentially)
    | .some i => substIfAny ps ls (globalTm .true gs i)
    | .none => .var 0
  | .pi q i j a b => .pi q i j (inlineTm gs a) (inlineTm gs b)
  | .lam b => .lam (inlineTm gs b)
  | .app f a => .app (inlineTm gs f) (inlineTm gs a)
  | .letE ty v b => .letE (inlineTm gs ty) (inlineTm gs v) (inlineTm gs b)
  | .letq q ty v b => .letq q (inlineTm gs ty) (inlineTm gs v) (inlineTm gs b)
  | .ann t ty => .ann (inlineTm gs t) (inlineTm gs ty)
  | .pair a b => .pair (inlineTm gs a) (inlineTm gs b)
  | .fst t => .fst (inlineTm gs t)
  | .snd t => .snd (inlineTm gs t)
  | .con t => .con (inlineTm gs t)
  | .ecase m sc bs => .ecase m (inlineTm gs sc) (inlineTms gs bs)
  | .ind l I D v P m i x => .ind l I D v P (inlineTm gs m) i (inlineTm gs x)
  | .scase l q I D v P m sz i x => .scase l q I D v P (inlineTm gs m) sz i (inlineTm gs x)
  | .prf l t => .prf l (inlineTm gs t)
  | t => t
def inlineTms (gs : Globals) : Tms → Tms
  | .tnil => .tnil
  | .tcons t rest => .tcons (inlineTm gs t) (inlineTms gs rest)
end

-- bind `n` parameter types (a Π type's), then the rest
inductive Peeled where
  | mk (c : TCtx) (rest : Val)
def peelCtx : Nat → TCtx → Val → Peeled
  | .zero, c, v => .mk c v
  | .succ k, c, v => match whnf v with
    | .vpi _ _ _ dom env cod => peelCtx k (TCtx.bind c dom) (eval (.cons (fresh (TCtx.lvl c)) env) cod)
    | v' => .mk c v'
def indexIn : List String → String → Nat → Option Nat
  | .nil, _, _ => .none
  | .cons y ys, x, i => match strEq x y with
    | .true => .some i
    | .false => indexIn ys x (i + 1)
def elabTeleI (gs : Globals) : Scope → Nat → List Field → TmsR
  | _, _, .nil => .ok .tnil
  | sc, d, .cons (.mk x _ _ ty) rest => match elab sc ty with
    | .err m => .err m
    | .ok A => match elabTeleI gs (Scope.bind sc x) (d + 1) rest with
      | .ok ts => .ok (.tcons (closeG .true gs d A) ts)
      | e => e
-- the columns for the scrutinees (parameters, by name)
inductive ColsR where
  | ok (cols : List Col)
  | err (msg : String)
def scrutCols (params : List String) (pts ptsI : Tms) : List Syntax → ColsR
  | .nil => .ok .nil
  | .cons s rest => match indexIn params (identOf s) 0 with
    | .none => .err "a match must be on parameters"
    | .some i => match scrutCols params pts ptsI rest with
      | .ok cs => .ok (.cons (.mk i (nthTm pts i) (nthTm ptsI i) .qw) cs)
      | e => e
-- the structural column: the leftmost one any clause has a constructor pattern in
def anyCtorAt (k : Nat) : List Clause → Bool
  | .nil => .false
  | .cons (.mk pats _ _) rest => Bool.or (Bool.not (isVarPat (nthSyntax pats k))) (anyCtorAt k rest)
def structuralCol (cls : List Clause) : Nat → Nat → Option Nat
  | .zero, _ => .none
  | .succ m, k => match anyCtorAt k cls with
    | .true => .some k
    | .false => structuralCol cls m (k + 1)
def colLvl : Col → Nat
  | .mk l _ _ _ => l
-- bind the parameters (their types a telescope `pts`)
def bindParams : Cx → Nat → List String → Tms → Cx
  | cx, _, .cons x xs, .tcons A rest => bindParams (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A)) 0 xs rest
  | cx, _, _, _ => cx
-- the parameters' types (typed, each over the ones before), and the context with them
inductive PR where
  | ok (tys : Tms) (cx : Cx)
  | err (msg : String)
def elabParams (gs : Globals) (us : List String) : Cx → List Field → PR
  | cx, .nil => .ok .tnil cx
  | cx, .cons (.mk x _ _ ty) rest => match inferType gs (ES.withParams ES.empty us) cx ty with
    | .err m => .err m
    | .ok A0 _ es => match finishElab gs es with
      | .err m => .err m
      | .ok es' => match zonk es' (Cx.lvl cx) A0 with
        | .none => .err "could not infer an implicit argument"
        | .some A => match elabParams gs us (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A)) rest with
          | .ok tys cx' => .ok (.tcons A tys) cx'
          | e => e
-- does a clause's right-hand side mention `f`?
mutual
def mentionsIdent (f : String) (s : Syntax) : Bool := match s with
  | .ident n => strEq n f
  | .node _ args => mentionsArgs f args
  | _ => .false
def mentionsArgs (f : String) : SyntaxF .false → Bool
  | .nil => .false
  | .cons s rest => Bool.or (mentionsIdent f s) (mentionsArgs f rest)
end
def clausesMention (f : String) : List Clause → Bool
  | .nil => .false
  | .cons (.mk _ _ rhs) rest => Bool.or (mentionsIdent f rhs) (clausesMention f rest)
def matchDefCmd (gs : Globals) (stx : Syntax) : Step := match kid stx 1 with
  | .ident f => match kids (kid stx 4) with
    | .cons _ (.cons rStx _) =>
      let ps := fieldsOf (kids (kid stx 3));
      let params := fieldNames ps;
      let n := lenL params;
      let body := kid stx 6;
      let us := univParamsOf stx;
      match elabParams gs us (Cx.mk empty (Globals.scope gs) .nil) ps with
      | .err m => errStep gs m
      | .ok pts cxP0 => match scrutCols params pts pts (nonAtoms (kids (kid body 1))) with
        | .err m => errStep gs m
        | .ok cols => match inferType gs (ES.withParams ES.empty us) cxP0 rStx with
          | .err m => errStep gs m
          | .ok RE0 _ esR => match zonk esR n RE0 with
          | .none => errStep gs "could not infer an implicit argument"
          | .some RE =>
            let tyT := sortTy (piTeleQ (match binderQs (kids (kid stx 3)) with
              | .some qs => qs
              | .none => .nil) pts RE);
            let sc := bindAll (Globals.scope gs) params;
            match peelCtx n empty (eval .nil tyT) with
              | .mk c Rv => match sortOf c Rv with
                | .none => errStep gs "the result is not a type"
                | .some l => match lvlClosed l with
                  | .none => errStep gs "the result's universe must be a number"
                  | .some v =>
                    let cls := clausesOf (kids (kid body 3));
                    -- the structural parameter: the leftmost one a clause splits
                    let p := match structuralCol cls (lenL cols) 0 with
                      | .some k => colLvl (nthCol cols k)
                      | .none => 0;
                    let R := RE;
                    let mc := MatchCtx.mk f params p n v R R pts pts (paramMask (kids (kid stx 3)));
                    let cxP := bindParams (Cx.mk empty (Globals.scope gs) .nil) 0 params pts;
                    -- induction only for a definition that calls itself (a partial one calls
                    -- its axiom); else every split is case analysis (stage 19e)
                    let useInd := match Scope.lookup (Globals.scope gs) f with
                      | .some _ => Bool.false
                      | .none => clausesMention f cls;
                    match compileM gs mc ES.empty cxP (eval (TCtx.env (Cx.c cxP)) R) cols useInd .nil cls with
                    | .err m => errStep gs m
                    | .ok t _ =>
                      -- (with its proof markers, if the kernel asks for them)
                      match checkMarkingParams us (tLams n t) tyT with
                      | .bad m => errStep gs m
                      | .good fn => .mk (String.append f (String.append " : " (show .nil 0 tyT)))
                          (Globals.add gs (.mk f us tyT fn (inlineTm gs fn) (paramMask (kids (kid stx 3)))
                            (declParamNames stx)))
    | _ => errStep gs "a definition needs a type"
  | _ => errStep gs "a definition needs a name"

-- **Exercise 14.5.** One command: elaborate it (`defT`, `inferT`), put the solutions of
-- the metavariables in (`zonk`), and check the result with the kernel, in the empty
-- context (the globals are constants).
def command (gs : Globals) (stx : Syntax) : Step :=
  --<sol
  let cx0 := Cx.mk empty (Globals.scope gs) .nil;
  match strEq (kindOf stx) "command.def" with
  | .true => match kid stx 1 with
    | .ident x => match kids (kid stx 4) with
      | .cons _ (.cons tyStx _) =>
        let us := univParamsOf stx;
        match defT gs (ES.withParams ES.empty us) cx0 (kids (kid stx 3)) tyStx (kid stx 6) with
        | .err m => errStep gs m
        | .ok ty0 v0 es0 => match finishElab gs es0 with
        | .err m => errStep gs m
        | .ok es => match zonk es 0 ty0 with
          | .none => errStep gs "could not infer an implicit argument"
          | .some tyZ => let tyT := sortTy tyZ; match zonk es 0 v0 with
            | .none => errStep gs "could not infer an implicit argument"
            | .some v0z =>
              -- (P2) with the proof markers the kernel requires, if it asks for them
              match checkMarkingParams us v0z tyT with
              | .bad m => errStep gs m
              | .good v => .mk (String.append x (String.append " : " (show .nil 0 tyT)))
                  (Globals.add gs (.mk x us tyT v (inlineTm gs v) (paramMask (kids (kid stx 3)))
                    (declParamNames stx)))
      | _ => errStep gs "a definition needs a type"
    | _ => errStep gs "a definition needs a name"
  | .false =>
    -- (`#check c` shows `c`'s type, without inserting its implicit arguments)
    let r := match inferHead gs ES.empty cx0 (kid stx 1) with
      | .ok t ty es _ => match strEq (kindOf stx) "command.check" with
        | .true => TE.ok t ty es
        | .false => inferT gs ES.empty cx0 (kid stx 1)
      | .err m => TE.err m;
    match r with
    | .err m => errStep gs m
    | .ok t0 _ es0 => match finishElab gs es0 with
    | .err m => errStep gs m
    | .ok es => match zonk es 0 t0 with
      | .none => errStep gs "could not infer an implicit argument"
      | .some t0z => let t := MR.tm (markInfer empty t0z); match infer empty t with
        | .err m => errStep gs m
        | .ok ty _ => match strEq (kindOf stx) "command.check" with
          | .true => .mk (show .nil 0 (quote 0 ty)) gs
          | .false => match Bool.or (strEq (kindOf stx) "command.reduce") (strEq (kindOf stx) "command.eval") with
            | .true => .mk (show .nil 0 (quote 0 (eval .nil (inlineTm gs t)))) gs
            | .false => errStep gs (String.append "unsupported command " (kindOf stx))
  --|ex
  --| errStep gs "not implemented"
  --sol>

-- Mutual inductive types (stages 18c–d): `mutual inductive A (ps) … inductive B (ps) …
-- end` (the members share the parameters `ps`; no indices) is one family
-- `A_B : (ps) → Enum m → Type` indexed by a tag, with every member's constructors; a
-- field whose type is a member applied to the parameters is recursive at that member's
-- tag, and member `j`'s constructors end at tag `j`. Each member is the constant
-- `A := fun ps => A_B ps (tag 0)`, so a match on an `A ps` runs at a closed index: the
-- other members' constructors are ruled out (18b). Constructors take the parameters
-- implicitly.
def indexOfName : List String → String → Nat → Option Nat
  | .nil, _, _ => .none
  | .cons y ys, x, i => match strEq x y with
    | .true => .some i
    | .false => indexOfName ys x (i + 1)
-- the member a field's type is (applied to the parameters), if any
def memberOf (members : List String) (ps : List String) (ty : Syntax) : Option Nat :=
  let head := match strEq (kindOf ty) "term.app" with
    | .true => identOf (kid ty 0)
    | .false => identOf ty;
  match indexOfName members head 0 with
  | .some j => match recField head ps 0 ty with
    | .yes _ => .some j
    | .no => .none
  | .none => .none
-- a field `H → B` with `B` a member: higher-order recursive (stage 19e)
inductive HRec where
  | yes (H : Syntax) (j : Nat)
  | no
def hrecMember (members ps : List String) (ty : Syntax) : HRec := match strEq (kindOf ty) "term.arrow" with
  | .true => match memberOf members ps (kid ty 2) with
    | .some j => .yes (kid ty 0) j
    | .none => .no
  | .false => .no
-- a member constructor's fields: as a description (`m` members, this one `j`)
def mctorDesc (inline : Bool) (gs : Globals) (members ps : List String) (m j : Nat) : Scope → Nat → List Field → Elab
  | _, _, .nil => .ok (.dret (.tag m j))
  | sc, d, .cons (.mk x q _ ty) rest => match memberOf members ps ty with
    | .some j' => match mctorDesc inline gs members ps m j sc d rest with
      | .ok D => .ok (.drec (.qlit q) (.tag m j') D)
      | e => e
    | .none => match hrecMember members ps ty with
    | .yes H j' => match elab sc H with
      | .err m' => .err m'
      | .ok Ht => match mctorDesc inline gs members ps m j sc d rest with
        | .ok D => .ok (.dhrec (.qlit q) (closeG inline gs d Ht) (.lam (.tag m j')) D)
        | e => e
    | .no => match elab sc ty with
      | .err m' => .err m'
      | .ok A => match mctorDesc inline gs members ps m j (Scope.bind sc x) (d + 1) rest with
        | .ok D => .ok (.darg (.qlit q) (closeG inline gs d A) (.lam D))
        | e => e
-- a member constructor: the member's index and the syntax
inductive MCtor where
  | mk (j : Nat) (c : Syntax)
def mctorsOf (j : Nat) : List Syntax → List MCtor
  | .nil => .nil
  | .cons c rest => .cons (.mk j c) (mctorsOf j rest)
def memberCtors : List Syntax → Nat → List MCtor
  | .nil, _ => .nil
  | .cons d rest, j => List.append (mctorsOf j (kids (kid d 6))) (memberCtors rest (j + 1))
def mdescs (inline : Bool) (gs : Globals) (members ps : List String) (m : Nat) : List MCtor → Descs
  | .nil => .ok .tnil
  | .cons (.mk j c) rest => match mctorDesc inline gs members ps m j (Scope.bind (bindAll (Globals.scope gs) ps) "t✝") (List.length ps + 1) (ctorFields c) with
    | .err e => .err e
    | .ok D => match mdescs inline gs members ps m rest with
      | .ok ds => .ok (.tcons D ds)
      | e => e
def identOf' (s : Syntax) : String := match s with
  | .ident n => n
  | _ => "_"
def memberNames : List Syntax → List String
  | .nil => .nil
  | .cons d rest => .cons (identOf' (kid d 1)) (memberNames rest)
def joinUnder : List String → String
  | .nil => ""
  | .cons n rest => match rest with
    | .nil => n
    | .cons _ _ => String.append (String.append n "_") (joinUnder rest)
-- the member types `A := fun ps => F ps (tag j)`
def addMembers (F FI : Tm) (np : Nat) (pts : Tms) (m : Nat) : Globals → Nat → List String → Globals
  | gs, _, .nil => gs
  | gs, j, .cons n rest =>
    let at := fun (f : Tm) => tLams np (.app (tApps f (pvars np np)) (.tag m j));
    addMembers F FI np pts m (Globals.add gs (.mk n .nil (sortTy (piTele pts (.univ 0))) (at F) (at FI) .nil .nil)) (j + 1) rest
-- the member constructors `A.c := fun ps fields => con (tag, fields…, refl, tt)`
inductive MAdded where
  | ok (gs : Globals) (ctors : List Ctor)
  | err (msg : String)
def markRec (members ps : List String) : List Field → List CField → List CField
  | .cons (.mk _ _ _ ty) fs, .cons (.mk x _ A AI) cs => .cons (.mk x (match memberOf members ps ty with
      | .some _ => .true
      | .none => match hrecMember members ps ty with
        | .yes _ _ => .true
        | .no => .false) A AI) (markRec members ps fs cs)
  | _, _ => .nil
def addMCtors (members ps : List String) (pts : Tms) (m k : Nat) : Globals → Nat → List MCtor → MAdded
  | gs, _, .nil => .ok gs .nil
  | gs, ci, .cons (.mk j c) rest =>
    let fs0 := ctorFields c;
    let n := List.length fs0;
    let np := List.length ps;
    let T := nthName members j;
    match Scope.lookup (Globals.scope gs) T with
    | .none => .err T
    | .some ti =>
      let Tc := globalTm .false gs ti;
      match ctorFieldTys gs "" .nil 0 Tc Tc (bindAll (Globals.scope gs) ps) np fs0 with
      | .err e => .err e
      | .ok fs1 =>
        -- (a field typed by a member is recursive)
        let fs := markRec members ps fs0 fs1;
        let ty := sortTy (piTeleZ pts (ctorType (tApps Tc (pvars np (np + n))) (fieldQs fs0) fs));
        let v := markClosed (tLams (np + n) (.con (.pair (.tag k ci) (payloadP (.eqRefl (.enum m) (.tag m j)) n (n - 1))))) ty;
        match check empty v (eval .nil ty) with
        | .err e => .err e
        | .ok _ _ => match addMCtors members ps pts m k (Globals.add gs (.mk (String.append (String.append T ".") (ctorName c)) .nil ty v v
            (List.append (impls np) (fieldKinds (fieldImpl fs0))) .nil)) (ci + 1) rest with
          | .ok gs' cs => .ok gs' (.cons (.mk (ctorName c) fs (.tag m j) (fieldQs fs0) (fieldImpl fs0)) cs)
          | e => e
def addMemberInds (np : Nat) (I D DI : Tm) (cs : List Ctor) (fam : Tm) (params : List Syntax) (m : Nat) : Globals → Nat → List String → Globals
  | gs, _, .nil => gs
  | gs, j, .cons n rest => addMemberInds np I D DI cs fam params m (Globals.addInd gs n (.mk np I D DI cs (.some (.tag m j)) fam params)) (j + 1) rest
def memberLines (ty : String) : List String → String
  | .nil => ""
  | .cons n rest => match rest with
    | .nil => String.append n ty
    | .cons _ _ => String.append (String.append n ty) (String.append "\n" (memberLines ty rest))
def mutualQtyErr : List Syntax → Option String
  | .nil => .none
  | .cons d ds => match ctorQtyErr (kids (kid d 3)) (kids (kid d 6)) with
    | .some m => .some m
    | .none => mutualQtyErr ds
def mutualInductiveCmd0 (gs : Globals) (defs : List Syntax) : Step := match mutualQtyErr defs with
  | .some m => errStep gs m
  | .none =>
  let members := memberNames defs;
  let m := List.length members;
  let F := joinUnder members;
  let mcs := memberCtors defs 0;
  let k := List.length mcs;
  let params := fieldsOf (kids (kid (nthSyntax defs 0) 3));
  let ps := fieldNames params;
  let np := List.length ps;
  let I : Tm := .enum m;
  let mkD := fun (ds : Tms) => (.darg (.qlit .qw) (.enum k) (.lam (.ecase (.descr 0 I) (.var 0) ds)) : Tm);
  match elabTele gs (Globals.scope gs) 0 params with
  | .err e => errStep gs e
  | .ok pts => match mdescs .false gs members ps m mcs with
    | .err e => errStep gs e
    | .ok ds => match mdescs .true gs members ps m mcs with
      | .err e => errStep gs e
      | .ok dsI =>
        -- `fun ps i => μ D i` (the description moved under `i`)
        let body := fun (D : Tm) => tLams np (.lam (.mu 0 I (nfAt (np + 1) (tApps (tLams np D) (pvars np (np + 1)))) (.var 0)));
        let fty := sortTy (piTele pts (piH I (.univ 0)));
        let fval := markClosed (body (mkD ds)) fty;
        match check empty fval (eval .nil fty) with
        | .err e => errStep gs e
        | .ok _ _ =>
          let fvalI := markClosed (body (mkD dsI)) fty;
          let Fn := Globals.declName gs F;
          let gs1 := Globals.add gs (.mk F .nil fty fval fvalI .nil .nil);
          let Fc : Tm := .const Fn .nil .nil fval fty;
          let gs2 := addMembers Fc fvalI np pts m gs1 0 members;
          match addMCtors members ps pts m k gs2 0 mcs with
          | .err e => errStep gs e
          | .ok gs3 cs => .mk (memberLines (String.append " : " (show .nil 0 (piTele pts (.univ 0)))) members)
              (addMemberInds np I (mkD ds) (mkD dsI) cs Fc (kids (kid (nthSyntax defs 0) 3)) m gs3 0 members)
def anyUnivParams : List Syntax → Bool
  | .nil => .false
  | .cons d rest => Bool.or (hasUnivParams (univParamsOf d)) (anyUnivParams rest)
def mutualInductiveCmd (gs : Globals) (defs : List Syntax) : Step :=
  match anyUnivParams defs with
  | .true => errStep gs "a universe-polymorphic data type needs symbolic levels in its description (U2)"
  | .false => mutualInductiveCmd0 gs defs

-- Equations (stages 16d–e): `def f (ps) : A₁ → … → Aₘ → R | p₁, …, pₘ => rhs …` is
-- `def f (ps) (x✝₁ : A₁) … : R := match x✝₁, … with | p₁, …, pₘ => rhs …`
-- (`(x : A) → B` names its parameter)
inductive Peel where
  | mk (binders scruts : List Syntax) (res : Syntax)
  | fail
def peelArrows : Nat → Nat → Syntax → Peel
  | .zero, _, ty => .mk .nil .nil ty
  | .succ k, i, ty =>
    let arrow := strEq (kindOf ty) "term.arrow";
    let dep := strEq (kindOf ty) "term.depArrow";
    match Bool.or arrow dep with
    | .false => .fail
    | .true =>
      let x := match dep with
        | .true => nthName (binderNames (kid ty 0)) 0
        | .false => String.append "x✝" (Nat.toString i);
      let A : Syntax := match dep with
        | .true => match binderType (kid ty 0) with
          | .some a => a
          | .none => .missing
        | .false => kid ty 0;
      let binder := mkNode "binder.explicit" (.cons (.atom "(") (.cons (mkNull .nil)
        (.cons (mkNull (one (.ident x))) (.cons (mkNull (.cons (.atom ":") (one A))) (one (.atom ")"))))));
      match peelArrows k (i + 1) (kid ty 2) with
      | .mk bs xs res => .mk (.cons binder bs) (.cons (mkNode "term.ident" (one (.ident x))) xs) res
      | .fail => .fail
def eqnsToMatch (stx : Syntax) : Option Syntax := match kids (kid stx 4) with
  | .cons colon (.cons ty _) =>
    let m := match kids (kid stx 5) with
      | .cons a _ => lenL (nonAtoms (kids (kid a 1)))
      | .nil => 1;
    match peelArrows m 0 ty with
    | .fail => .none
    | .mk bs xs res =>
      let body := mkNode "term.match" (.cons (.atom "match") (.cons (mkNull xs)
        (.cons (.atom "with") (one (kid stx 5)))));
      .some (mkNode "command.def" (.cons (.atom "def") (.cons (kid stx 1) (.cons (kid stx 2)
        (.cons (mkNull (List.append (kids (kid stx 3)) bs))
          (.cons (mkNull (.cons colon (one res))) (.cons (.atom ":=") (one body))))))))
  | _ => .none

-- (a definition's `match` on its parameters is compiled with recursion; on anything else
-- it is a term)
def scrutsAreParams (ps : List String) : List Syntax → Bool
  | .nil => .true
  | .cons s rest => match strEq (kindOf s) "term.ident" with
    | .true => match indexOfName ps (identOf s) 0 with
      | .some _ => scrutsAreParams ps rest
      | .none => .false
    | .false => .false
-- A shared catch-all (stage 19f, like the Lean side's `dflt✝`): a big last clause of
-- variables would be copied into every leaf of the splits before it (two columns of a
-- type with 70 constructors: 4900 copies). When the match does case analysis only, it
-- becomes a definition `f✝d (params) : R := let x := param; …; rhs`, checked once,
-- and the clause calls it.
mutual
def synSize (s : Syntax) : Nat := match s with
  | .node _ args => synSizeArgs args + 1
  | _ => 1
def synSizeArgs : SyntaxF .false → Nat
  | .nil => 0
  | .cons s rest => synSize s + synSizeArgs rest
end
def allVarPats : List Syntax → Bool
  | .nil => .true
  | .cons p rest => Bool.and (isVarPat p) (allVarPats rest)
def lastSyn : List Syntax → Option Syntax
  | .nil => .none
  | .cons s rest => match rest with
    | .nil => .some s
    | .cons _ _ => lastSyn rest
def replaceLastSyn (v : Syntax) : List Syntax → List Syntax
  | .nil => .nil
  | .cons s rest => match rest with
    | .nil => one v
    | .cons _ _ => .cons s (replaceLastSyn v rest)
def setNthSyn (v : Syntax) : List Syntax → Nat → List Syntax
  | .nil, _ => .nil
  | .cons s rest, i => match i with
    | .zero => .cons v rest
    | .succ j => .cons s (setNthSyn v rest j)
def setKid (s : Syntax) (i : Nat) (v : Syntax) : Syntax := mkNode (kindOf s) (setNthSyn v (kids s) i)
-- (an implicit binder keeps its quantity: its default 0 is written out, stage 21m)
def zeroQtyStx : Syntax := mkNull (one (mkNode "quantity" (one (mkNode "num" (one (.atom "0"))))))
def explicitBinders : List Syntax → List Syntax
  | .nil => .nil
  | .cons b rest => .cons (mkNode "binder.explicit" (.cons (.atom "(") (.cons (match Bool.and (isImplicitB b) (isNilS (kids (kid b 1))) with
      | .true => zeroQtyStx
      | .false => kid b 1) (.cons (kid b 2)
      (.cons (kid b 3) (one (.atom ")"))))))) (explicitBinders rest)
-- `let x := scrutinee; …` for the clause's variables
def letsFor (body : Syntax) : List Syntax → List Syntax → Syntax
  | .cons p ps, .cons sc scs => match strEq (identOf p) "_" with
    | .true => letsFor body ps scs
    | .false => mkNode "term.let" (.cons (.atom "let") (.cons (mkNull .nil) (.cons (.ident (identOf p))
        (.cons (mkNull .nil) (.cons (.atom ":=") (.cons sc (.cons (mkNull .nil) (one (letsFor body ps scs)))))))))
  | _, _ => body
def identsOf : List String → List Syntax
  | .nil => .nil
  | .cons x rest => .cons (mkNode "term.ident" (one (.ident x))) (identsOf rest)
def withDefault' (gs : Globals) (stx : Syntax) : Step := match kid stx 1 with
  | .ident f =>
    let body := kid stx 6;
    let alts := kids (kid body 3);
    let scruts := nonAtoms (kids (kid body 1));
    let params := fieldNames (fieldsOf (kids (kid stx 3)));
    let useInd := match Scope.lookup (Globals.scope gs) f with
      | .some _ => Bool.false
      | .none => clausesMention f (clausesOf alts);
    match lastSyn alts with
    | .some a =>
      let pats := nonAtoms (kids (kid a 1));
      match Bool.and (Bool.and (Bool.not useInd) (Nat.lt 1 (lenL scruts)))
          (Bool.and (Nat.lt 2 (lenL alts)) (Bool.and (allVarPats pats) (Nat.lt 24 (synSize (kid a 3))))) with
      | .true =>
        let g := String.append f "✝d";
        let dstx := mkNode "command.def" (.cons (.atom "def") (.cons (.ident g) (.cons (kid stx 2)
          (.cons (mkNull (explicitBinders (kids (kid stx 3)))) (.cons (kid stx 4) (.cons (.atom ":=")
            (one (letsFor (kid a 3) pats scruts))))))));
        match command gs dstx with
        | .mk line gs1 => match strEq (String.mk (takeL 6 (match line with
            | .mk cs => cs))) "error:" with
          | .true => .mk line gs
          | .false =>
            let call := mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident g))) (one (mkNull (identsOf params))));
            let body' := setKid body 3 (mkNull (replaceLastSyn (setKid a 3 call) alts));
            matchDefCmd gs1 (setKid stx 6 body')
      | .false => matchDefCmd gs stx
    | .none => matchDefCmd gs stx
  | _ => matchDefCmd gs stx
-- The structural parameter first (stage 19f): a recursive call may change only the
-- parameters after the structural one (they are generalised in the motive), so when
-- the structural parameter's type doesn't mention the earlier ones (and all are
-- explicit, one per binder), `f` is defined by `f✝s` with that parameter moved to the
-- front (the recursive calls permuted too), and `f (ps) := f✝s (ps')`.
def nthSyn : List Syntax → Nat → Syntax
  | .nil, _ => .missing
  | .cons s rest, i => match i with
    | .zero => s
    | .succ j => nthSyn rest j
def dropNthSyn : List Syntax → Nat → List Syntax
  | .nil, _ => .nil
  | .cons s rest, i => match i with
    | .zero => rest
    | .succ j => .cons s (dropNthSyn rest j)
def moveFront (xs : List Syntax) (i : Nat) : List Syntax := .cons (nthSyn xs i) (dropNthSyn xs i)
def singleExplicit : List Syntax → Bool
  | .nil => .true
  | .cons b rest => Bool.and (Bool.and (strEq (kindOf b) "binder.explicit") (Nat.beq (lenL (binderNames b)) 1))
      (singleExplicit rest)
def mentionsAny : List String → Syntax → Bool
  | .nil, _ => .false
  | .cons x rest, s => Bool.or (mentionsIdent x s) (mentionsAny rest s)
mutual
-- `f a₀ … aₙ₋₁` (all `n` arguments) as `g` with the `i`th argument first
def permCalls (f g : String) (n i : Nat) (s : Syntax) : Syntax := match s with
  | .node k args =>
    let s' : Syntax := .node k (permCallsArgs f g n i args);
    match Bool.and (strEq k "term.app") (strEq (identOf (kid s' 0)) f) with
    | .true => match Nat.beq (lenL (kids (kid s' 1))) n with
      | .true => mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident g))) (one (mkNull (moveFront (kids (kid s' 1)) i))))
      | .false => s'
    | .false => s'
  | s => s
def permCallsArgs (f g : String) (n i : Nat) : SyntaxF .false → SyntaxF .false
  | .nil => .nil
  | .cons s rest => .cons (permCalls f g n i s) (permCallsArgs f g n i rest)
end
def permAlts (f g : String) (n i : Nat) : List Syntax → List Syntax
  | .nil => .nil
  | .cons a rest => .cons (setKid a 3 (permCalls f g n i (kid a 3))) (permAlts f g n i rest)
inductive Reorder where
  | yes (helper main : Syntax)
  | no
-- `(x y : A)` as `(x : A) (y : A)`
def splitNames (b : Syntax) : List String → List Syntax
  | .nil => .nil
  | .cons x rest => .cons (setKid b 2 (mkNull (one (.ident x)))) (splitNames b rest)
def splitBinders : List Syntax → List Syntax
  | .nil => .nil
  | .cons b rest => match strEq (kindOf b) "binder.explicit" with
    | .true => List.append (splitNames b (binderNames b)) (splitBinders rest)
    | .false => .cons b (splitBinders rest)
def reorderStructural (gs : Globals) (stx0 : Syntax) : Reorder := match kid stx0 1 with
  | .ident f =>
    let stx := setKid stx0 3 (mkNull (splitBinders (kids (kid stx0 3))));
    let bs := kids (kid stx 3);
    let params := fieldNames (fieldsOf bs);
    let n := lenL params;
    let body := kid stx 6;
    let alts := kids (kid body 3);
    let scruts := nonAtoms (kids (kid body 1));
    let useInd := match Scope.lookup (Globals.scope gs) f with
      | .some _ => Bool.false
      | .none => clausesMention f (clausesOf alts);
    match Bool.and useInd (singleExplicit bs) with
    | .false => .no
    | .true => match structuralCol (clausesOf alts) (lenL scruts) 0 with
      | .none => .no
      | .some k => match indexOfName params (identOf (nthSyn scruts k)) 0 with
        | .none => .no
        | .some i => match i with
          | .zero => .no
          | .succ _ => match mentionsAny (takeL i params) (match binderType (nthSyn bs i) with
              | .some t => t
              | .none => .missing) with
            | .true => .no
            | .false =>
              let g := String.append f "✝s";
              let alts' := permAlts f g n i alts;
              match clausesMention f (clausesOf alts') with
              | .true => .no
              | .false =>
                let helper := setKid (setKid (setKid stx 1 (.ident g)) 3 (mkNull (moveFront bs i)))
                  6 (setKid body 3 (mkNull alts'));
                let call := mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident g)))
                  (one (mkNull (moveFront (identsOf params) i))));
                .yes helper (setKid stx 6 call)
  | _ => .no
def withDefault (gs : Globals) (stx : Syntax) : Step := match reorderStructural gs stx with
  | .yes helper main => match matchDefCmd gs helper with
    | .mk line gs1 => match strEq (String.mk (takeL 6 (match line with
        | .mk cs => cs))) "error:" with
      | .true => .mk line gs
      | .false => command gs1 main
  | .no => withDefault' gs stx
def inductiveCmd (gs : Globals) (stx : Syntax) : Step := inductiveCmdS gs stx .none
-- **`sealed inductive T …`** (22k; `command.sealed` in `Elab/Command.lean`): the axiom
-- `T.seal✝ : Type`, then `T` with the seal as the first domain of its index tail (a
-- constant is compared by name, so no declaration that can't write the name is `T`)
def sealedCmd (gs : Globals) (stx : Syntax) : Step :=
  let inner := kid stx 1;
  match strEq (kindOf inner) "command.inductive" with
  | .false => errStep gs "`sealed` applies to an `inductive` declaration"
  | .true => match kid inner 1 with
    | .ident T =>
      let K := String.append T ".seal✝";
      let Kn := Globals.declName gs K;
      let ax : Tm := .axiomC Kn (.univ 0);
      inductiveCmdS (Globals.add gs (.mk K .nil (.univ 0) ax ax .nil .nil)) inner (.some ax)
    | _ => errStep gs "an inductive type needs a name"
-- one definition (or inductive type), by its form
def defStep (gs : Globals) (stx : Syntax) : Step := match strEq (kindOf stx) "command.inductive" with
  | .true => inductiveCmd gs stx
  | .false => match (match binderQs (kids (kid stx 3)) with
      | .none => Bool.true
      | .some _ => Bool.false) with
  | .true => errStep gs qtyErr
  | .false => match strEq (kindOf stx) "command.inductive" with
  | .true => inductiveCmd gs stx
  | .false => match Bool.and (strEq (kindOf stx) "command.def") (Bool.and (strEq (kindOf (kid stx 6)) "term.match")
      (scrutsAreParams (fieldNames (fieldsOf (kids (kid stx 3)))) (nonAtoms (kids (kid (kid stx 6) 1))))) with
    | .true => withDefault gs stx
    | .false => match strEq (kindOf stx) "command.defEqns" with
      | .true => match eqnsToMatch stx with
        | .some d => withDefault gs d
        | .none => errStep gs "equations need a function type"
      | .false => command gs stx

-- Partial definitions and mutual blocks (stage 17d): each function is first an axiom of
-- its type, so that the bodies may call any of them (the kernel sees them so: there is
-- no termination check); then each body is checked as usual.
mutual
def teleT (gs : Globals) (es : ES) (cx : Cx) (bs : List Syntax) (tyS : Syntax) : TE := match bs with
  | .nil => inferType gs es cx tyS
  | .cons b rest => match binderType b with
    | .none => .err "the binders of a definition need types"
    | .some aS => match binderQ b with
      | .some q => teleNames gs es cx q (binderNames b) aS rest tyS
      | .none => .err qtyErr
def teleNames (gs : Globals) (es : ES) (cx : Cx) (q : Q) (xs : List String) (aS : Syntax) (rest : List Syntax) (tyS : Syntax) : TE :=
  match xs with
  | .nil => teleT gs es cx rest tyS
  | .cons x xs' => match inferType gs es cx aS with
    | .ok A _ es1 => match teleNames gs es1 (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A)) q xs' aS rest tyS with
      | .ok B _ es2 => .ok (piTm q A B) (.vsort (.lnum 0)) es2
      | e => e
    | e => e
end
inductive AxR where
  | ok (gs : Globals)
  | err (msg : String)

-- Witnesses for partial definitions (`Witness.lean`): the kernel takes a partial
-- definition `f : T` only with a term of `T` it checks (`checkPartial`), found here by a
-- search over the shape of `T`: a variable of the type's `Π`s, `fun x => w`, a pair,
-- `tt`, a tag, `∞`, `Unit` for a sort, or a global whose type ends in `T`'s head (a
-- constructor, `StrMap.empty`), with the arguments its conclusion fixes taken from `T`
-- and the others found again, to a bounded depth. Each candidate is checked: so `T.mk :
-- T .t` is no witness of `T .f`.
inductive WPeel where
  | bind (dom cod : Tm)
  | done
partial def wPeel : Tm → WPeel
  | .pi _ _ _ a b => .bind a b
  | _ => .done
-- a global type's conclusion and its number of binders
inductive Concl where
  | mk (t : Tm) (k : Nat)
partial def tmConcl (t : Tm) (k : Nat) : Concl := match wPeel t with
  | .bind _ b => tmConcl b (k + 1)
  | .done => .mk t k
partial def tmHeadName : Tm → Option String
  | .app f _ => tmHeadName f
  | .const n _ _ _ _ => .some n
  | .axiomC n _ => .some n
  | _ => .none
partial def tmArgs : Tm → List Tm → List Tm
  | .app f a, acc => tmArgs f (.cons a acc)
  | _, acc => acc
-- the names a type is known by, each with its arguments: the definitions it unfolds
-- through, then its head
inductive HeadArgs where
  | mk (name : String) (args : List Val)
partial def wSpineArgs : Spine → List Val → List Val
  | .sapp sp a, acc => wSpineArgs sp (.cons a acc)
  | _, acc => acc
partial def headsOf (v : Val) : List HeadArgs := match v with
  | .vglued h sp u => match h with
    | .hconst n _ _ _ _ => .cons (.mk n (wSpineArgs sp .nil)) (headsOf (u ()))
    | _ => headsOf (u ())
  | .vne h sp => match h with
    | .haxiom n _ => .cons (.mk n (wSpineArgs sp .nil)) .nil
    | _ => .nil
  | _ => .nil
partial def headArgs (n : String) : List HeadArgs → Option (List Val)
  | .nil => .none
  | .cons h rest => match h with
    | .mk m as => match strEq n m with
      | .true => .some as
      | .false => headArgs n rest
partial def noneList : Nat → List (Option Val)
  | .zero => .nil
  | .succ k => .cons .none (noneList k)
partial def setNth : List (Option Val) → Nat → Val → List (Option Val)
  | .nil, _, _ => .nil
  | .cons x rest, i, v => match i with
    | .zero => .cons (.some v) rest
    | .succ j => .cons x (setNth rest j v)
-- the binders a global's conclusion fixes: an argument that is one of its own binders
partial def matchArgs (k : Nat) (as : List Tm) (vs : List Val) (asg : List (Option Val)) : List (Option Val) :=
  match as with
  | .nil => asg
  | .cons a as' => match vs with
    | .nil => asg
    | .cons v vs' => matchArgs k as' vs' (match a with
      | .var j => match Nat.lt j k with
        | .true => setNth asg (k - 1 - j) v
        | .false => asg
      | _ => asg)
-- a variable of the context of this type
partial def hypWit (c : TCtx) (ty : Val) (tys : Env) (i : Nat) : Option Tm := match tys with
  | .nil => .none
  | .cons t rest => match convTy c t ty with
    | .true => .some (.var i)
    | .false => hypWit c ty rest (i + 1)
def sortWit (l : Lvl) : Option Tm := match l with
  | .lnum n => match n with
    | .zero => .some .ptrue
    | .succ m => .some (.unit m)
  | _ => .none
-- the witness search's view of the globals: all of them, and by the head of their
-- conclusion (built once per partial definition, so the search doesn't scan every
-- global for every type it looks for)
inductive WEnv where
  | mk (all : Array Global) (ix : StrMap (List Nat))
def globalHead (g : Global) : Option String := match g with
  | .mk _ _ gty _ _ _ _ => match tmConcl gty 0 with
    | .mk concl _ => tmHeadName concl
-- (from the latest global down, so each list is in declaration order)
partial def headIndex (all : Array Global) (i : Nat) (m : StrMap (List Nat)) : StrMap (List Nat) := match i with
  | .zero => m
  | .succ j => headIndex all j (match globalHead (Array.getD all j (.mk "?" .nil .star .star .star .nil .nil)) with
    | .none => m
    | .some h => StrMap.insert m (Str.ofString h) (.cons j (StrMap.findD m (Str.ofString h) .nil)))
def WEnv.of (gs : Globals) : WEnv := match gs with
  | .mk all _ _ _ _ _ _ _ _ => .mk all (headIndex all (Array.size all) StrMap.empty)
def WEnv.global (we : WEnv) (i : Nat) : Global := match we with
  | .mk all _ => Array.getD all i (.mk "?" .nil .star .star .star .nil .nil)
def WEnv.cands (we : WEnv) (h : HeadArgs) : List Nat := match we with
  | .mk _ ix => match h with
    | .mk n _ => StrMap.findD ix (Str.ofString n) .nil
mutual
def wit (we : WEnv) (c : TCtx) (ty : Val) (fuel : Nat) : Option Tm := match fuel with
  | .zero => .none
  | .succ f => match hypWit c ty (TCtx.types c) 0 with
    | .some t => .some t
    | .none => witShape we c ty (whnf ty) fuel f
def witShape (we : WEnv) (c : TCtx) (ty w : Val) (fuel f : Nat) : Option Tm := match w with
  | .vpi _ _ _ dom env cod => match wit we (TCtx.bind c dom) (eval (.cons (fresh (TCtx.lvl c)) env) cod) fuel with
    | .some b => .some (.lam b)
    | .none => .none
  | .vsort l => sortWit l
  | .vunit _ => .some .star
  | .venum k => match k with
    | .zero => .none
    | .succ _ => .some (.tag k 0)
  | .vsize => .some .szInf
  | .vulift _ _ A => match wit we c A fuel with
    | .some x => .some (.up x)
    | .none => .none
  | .vsigma _ _ _ a env b => match wit we c a fuel with
    | .none => .none
    | .some x => match wit we c (eval (.cons (eval (TCtx.env c) x) env) b) fuel with
      | .none => .none
      | .some y => .some (.pair x y)
  | _ => let hs := headsOf ty; byHeads we c ty hs f hs
-- the globals whose conclusion has one of the type's names as its head (`WEnv.ix`)
def byHeads (we : WEnv) (c : TCtx) (ty : Val) (hs : List HeadArgs) (f : Nat) : List HeadArgs → Option Tm
  | .nil => .none
  | .cons h rest => match byGlobals we c ty hs f (WEnv.cands we h) with
    | .some t => .some t
    | .none => byHeads we c ty hs f rest
def byGlobals (we : WEnv) (c : TCtx) (ty : Val) (hs : List HeadArgs) (f : Nat) : List Nat → Option Tm
  | .nil => .none
  | .cons i rest => match tryGlobal we c ty hs f (WEnv.global we i) with
    | .some t => .some t
    | .none => byGlobals we c ty hs f rest
def tryGlobal (we : WEnv) (c : TCtx) (ty : Val) (hs : List HeadArgs) (f : Nat) (g : Global) : Option Tm :=
  match g with
  | .mk n _ gty v _ _ _ => match tmConcl gty 0 with
    | .mk concl k => match tmHeadName concl with
      | .none => .none
      | .some h => match headArgs h hs with
        | .none => .none
        | .some vs => applyGlobal we c ty f (matchArgs k (tmArgs concl .nil) vs (noneList k)) gty .nil (.const n .nil .nil v gty)
def applyGlobal (we : WEnv) (c : TCtx) (ty : Val) (f : Nat) (asg : List (Option Val)) (gty : Tm) (env : Env) (acc : Tm) : Option Tm :=
  match wPeel gty with
  | .bind dom cod => match asg with
    | .cons a rest => match a with
      | .some v => applyGlobal we c ty f rest cod (.cons v env) (.app acc (quote (TCtx.lvl c) v))
      | .none => applyFound we c ty f rest dom cod env acc
    | .nil => applyFound we c ty f .nil dom cod env acc
  | .done => match check (TCtx.erase c) (markCheck c acc ty) ty with
    | .ok _ _ => .some acc
    | .err _ => .none
-- an argument the conclusion doesn't fix: found by the search
def applyFound (we : WEnv) (c : TCtx) (ty : Val) (f : Nat) (asg : List (Option Val)) (dom cod : Tm) (env : Env) (acc : Tm) : Option Tm :=
  match wit we c (eval env dom) f with
  | .none => .none
  | .some w => applyGlobal we c ty f asg cod (.cons (eval (TCtx.env c) w) env) (.app acc w)
end
inductive PSigR where
  | ok (f : String) (ty : Tm)
  | err (msg : String)
-- the type of `axiom f (bs) : T` or of a partial `def f (bs) : T`
def sigType (gs : Globals) (d : Syntax) : PSigR := match kid d 1 with
  | .ident f => match kids (kid d 4) with
    | .cons _ (.cons tyS _) =>
      let us := univParamsOf d;
      match teleT gs (ES.withParams ES.empty us) (Cx.mk empty (Globals.scope gs) .nil) (kids (kid d 3)) tyS with
      | .err m => .err m
      | .ok ty0 _ es => match zonk es 0 ty0 with
        | .none => .err "could not infer an implicit argument"
        | .some tyZ => let ty := sortTy tyZ; match tmHasLvlMVar ty with
          | .true => .err "could not infer a universe level; add a universe parameter or annotation"
          | .false => match checkDeclParams us ty .none with
            | .err m => .err m
            | .ok _ _ => .ok f ty
    | _ => .err "a partial definition needs a type"
  | _ => .err "a definition needs a name"
def addAxioms : Globals → List Syntax → AxR
  | gs, .nil => .ok gs
  | gs, .cons d rest => match sigType gs d with
    | .err m => .err m
    | .ok f ty =>
      let fn := Globals.declName gs f;
      addAxioms (Globals.add gs (.mk f (univParamsOf d) ty (.axiomC fn ty) (.axiomC fn ty)
        (paramMask (kids (kid d 3))) (declParamNames d))) rest
-- a member of a partial group: `def …`, or `partial (default := w) def …`
def unwrapDef (d : Syntax) : Syntax := match strEq (kindOf d) "command.partial" with
  | .true => kid d 2
  | .false => d
def unwrapDefs : List Syntax → List Syntax
  | .nil => .nil
  | .cons d rest => .cons (unwrapDef d) (unwrapDefs rest)
-- the witness of a partial definition's type: the one written, or one found
def findWit (gs : Globals) (f : String) (ty : Tm) : PSigR := match wit (WEnv.of gs) empty (eval .nil ty) 4 with
  | .some w => .ok f w
  | .none => .err (String.append (String.append "partial definition " f)
      ": no witness found for its type; give one with `partial (default := w) def`")
def witnessOf (gs : Globals) (d : Syntax) (f : String) (ty : Tm) : PSigR := match strEq (kindOf d) "command.partial" with
  | .true => match kids (kid d 1) with
    | .nil => findWit gs f ty
    | .cons _ _ => match checkT gs (ES.withParams ES.empty (univParamsOf (unwrapDef d))) (Cx.mk empty (Globals.scope gs) .nil) (kid (kid d 1) 3) (eval .nil ty) with
      | .err m => .err m
      | .ok w0 _ es0 => match finishElab gs es0 with
        | .err m => .err m
        | .ok es => match zonk es 0 w0 with
          | .none => .err "could not infer an implicit argument of the witness"
          | .some w => .ok f w
  | .false => findWit gs f ty
-- the signatures of a partial group, each with its witness checked by the kernel
def addPartials : Globals → List Syntax → AxR
  | gs, .nil => .ok gs
  | gs, .cons d rest => match sigType gs (unwrapDef d) with
    | .err m => .err m
    | .ok f ty => match witnessOf gs d f ty with
      | .err m => .err m
      | .ok _ w => match checkPartialParams (univParamsOf (unwrapDef d)) ty (markClosed w ty) with
        | .err m => .err (String.append (String.append "the witness of " f) (String.append ": " m))
        | .ok _ _ =>
          let fn := Globals.declName gs f;
          addPartials (Globals.add gs (.mk f (univParamsOf (unwrapDef d)) ty (.axiomC fn ty) (.axiomC fn ty)
            (paramMask (kids (kid (unwrapDef d) 3))) (declParamNames (unwrapDef d)))) rest
-- `axiom f (bs) : T` (stage 19c), printed like a definition
def axiomCmd (gs : Globals) (stx : Syntax) : Step := match addAxioms gs (one stx) with
  | .err m => errStep gs m
  | .ok gs' => match kid stx 1 with
    | .ident f => match identHead gs' ES.empty (Cx.mk empty (Globals.scope gs') .nil) f with
      | .ok _ ty _ _ => .mk (String.append (String.append f " : ") (show .nil 0 (quote 0 ty))) gs'
      | .err m => errStep gs m
    | _ => errStep gs "an axiom needs a name"
-- **Foreign functions and types** (stage 21l; `command.extern` and `command.foreignType`
-- in `Elab/Command.lean`). To the checker a foreign function is an axiom; the backend
-- calls the C function, marshalling by the Wiz type as the Lean backends do: `Nat` and
-- `UInt64` a `uint64_t`, `Float64` a `double`, `String` a UTF-8 `char *`, `Bool` an
-- `int`, `Unit` nothing (`void`), a foreign type a pointer, a type variable or a Wiz data
-- type the value as it is (for runtime helpers); a parameter that is a type (or of
-- quantity 0) is not passed. A result in `IO` takes and gives back the world.
def tmHead : Tm → Tm
  | .app f _ => tmHead f
  | .ann t _ => tmHead t
  | t => t
def foreignFin : List Foreign → String → Option String
  | .nil, _ => .none
  | .cons f rest, n => match f with
    | .ty m fin _ => match strEq m n with
      | .true => .some fin
      | .false => foreignFin rest n
    | _ => foreignFin rest n
-- the kind of a named type (an axiom's or a definition's)
def namedKind (ffi : List Foreign) (n : String) (isAxiom : Bool) : Option String :=
  match strEq n "Nat" with
  | .true => .some "n"
  | .false => match strEq n "String" with
  | .true => .some "s"
  | .false => match strEq n "Bool" with
  | .true => .some "b"
  | .false => match strEq n "UInt64" with
  | .true => .some "u"
  | .false => match strEq n "Float64" with
  | .true => .some "f"
  | .false => match foreignFin ffi n with
  | .some _ => .some "p"
  | .none => match Bool.or (Bool.or (strEq n "Bytes") (strEq n "Array")) (Bool.or (strEq n "Str") (strEq n "StrMap")) with
  | .true => .some "w"
  -- a Wiz data type: the value as it is (an opaque axiom can't be marshalled)
  | .false => match isAxiom with
    | .true => .none
    | .false => .some "w"
-- (the catch-all rows below are calls: `Tm` has many constructors, and a catch-all's
-- right-hand side is compiled once for each)
def ffiKindHead (ffi : List Foreign) (h : Tm) : Option String := match h with
  | .var _ => .some "w"
  | .const n _ _ v _ => namedKind ffi n (isAxiomTm v)
  | .axiomC n _ => namedKind ffi n .true
  | _ => .none
def ffiKind (ffi : List Foreign) (t : Tm) : Option String := match t with
  | .unit _ => .some "v"
  | _ => ffiKindHead ffi (tmHead t)
def isSortTm : Tm → Bool
  | .univ _ => .true
  | .prop => .true
  | .sortL _ => .true
  | _ => .false
-- (stage 21r) the `c_struct` declared as the structure `n`
def cstructOf : List Foreign → String → Option Foreign
  | .nil, _ => .none
  | .cons f rest, n => match f with
    | .cstruct m _ _ _ _ => match strEq m n with
      | .true => .some f
      | .false => cstructOf rest n
    | _ => cstructOf rest n
-- (a `c_struct`'s kind is `S:T`)
def cstructKind (ffi : List Foreign) (n : String) : Option String := match cstructOf ffi n with
  | .some _ => .some (String.append "S:" n)
  | .none => .none
def extKindHead (ffi : List Foreign) (h : Tm) : Option String := match h with
  | .const n _ _ _ _ => cstructKind ffi n
  | _ => .none
-- an extern's kind of a type: a `c_struct` by value, else as above; a runtime native
-- (`wiz_…`) takes any other value as it is (as `command.extern`)
def extKind (ffi : List Foreign) (native : Bool) (t : Tm) : Option String := match extKindHead ffi (tmHead t) with
  | .some k => .some k
  | .none => match ffiKind ffi t with
    | .some k => .some k
    | .none => match native with
      | .true => .some "w"
      | .false => .none
-- (stage 21q) The signature of a function C calls, a callback or an export, as
-- `ffiCallSig` in `Elab/Command.lean`: the kinds of its parameters (none erased, none
-- `Unit`), of its result (not a foreign pointer), and whether the result is in `IO`.
inductive CallSig where
  | mk (params : List String) (res : String) (io : Bool)
  | bad
-- `A` if the type is `IO A`
def ioArgHead (h a : Tm) : Option Tm := match h with
  | .const n _ _ _ _ => match strEq n "IO" with
    | .true => .some a
    | .false => .none
  | _ => .none
def ioArgOf (t : Tm) : Option Tm := match t with
  | .app f a => ioArgHead (tmHead f) a
  | _ => .none
def callSigRes (ffi : List Foreign) (t : Tm) : CallSig :=
  let ioArg := ioArgOf t;
  let res : Tm := match ioArg with
    | .some a => a
    | .none => t;
  match ffiKind ffi res with
  | .none => .bad
  | .some k => match strEq k "p" with
    | .true => .bad
    | .false => .mk .nil k (match ioArg with
      | .some _ => .true
      | .none => .false)
mutual
def callSig (ffi : List Foreign) (t : Tm) : CallSig := match t with
  | .pi q _ _ a b => callSigPi ffi q a b
  | _ => callSigRes ffi t
def callSigPi (ffi : List Foreign) (q : Q) (a b : Tm) : CallSig := match qEq q .qz with
  | .true => .bad
  | .false => match ffiKind ffi a with
    | .none => .bad
    | .some k => match strEq k "v" with
      | .true => .bad
      | .false => match callSig ffi b with
        | .mk ks r io => .mk (.cons k ks) r io
        | .bad => .bad
end
def joinStrs : List String → String
  | .nil => ""
  | .cons s rest => String.append s (joinStrs rest)
-- a callback's kind: `k[<params>/<result>]` (borrowed for the call) or `K[…]` (owned by
-- C), `!` before a result in `IO`: the Lean frontend's key
def callbackKey (owned : Bool) (c : CallSig) : Option String := match c with
  | .bad => .none
  | .mk ks r io => .some (String.append (match owned with
      | .true => "K["
      | .false => "k[") (String.append (joinStrs ks) (String.append "/" (String.append (match io with
      | .true => "!"
      | .false => "") (String.append r "]")))))
def ioArgHeadN (n : String) (h a : Tm) : Option Tm := match h with
  | .const m _ _ _ _ => match strEq m n with
    | .true => .some a
    | .false => .none
  | _ => .none
-- `T` if the type is `n T`
partial def appArgOf (n : String) (t : Tm) : Option Tm := match t with
  | .app f a => ioArgHeadN n (tmHead f) a
  | _ => .none
partial def isPiTm : Tm → Bool
  | .pi _ _ _ _ _ => .true
  | _ => .false
-- a parameter of function type is a callback, `Callback T` an owned one (`none`: not a
-- function)
def callbackKind (ffi : List Foreign) (dom : Tm) : Option (Option String) := match isPiTm dom with
  | .true => .some (callbackKey .false (callSig ffi dom))
  | .false => match appArgOf "Callback" dom with
    | .some T => .some (callbackKey .true (callSig ffi T))
    | .none => .none
-- a parameter's kind: `e` (not passed) for a type or a quantity 0 binder; a function is
-- a callback (but a runtime native takes closures as they are)
def ffiParamKind (ffi : List Foreign) (native : Bool) (q : Q) (dom : Tm) : Option String := match Bool.or (qEq q .qz) (isSortTm dom) with
  | .true => .some "e"
  | .false => match native with
    | .true => extKind ffi .true dom
    | .false => match callbackKind ffi dom with
      | .some k => k
      | .none => extKind ffi .false dom
inductive FfiSig where
  | mk (params : List String) (res : String) (io : Bool) (fin : String)
  | bad
-- the finalizer of a foreign type
def finOfHead (ffi : List Foreign) (h : Tm) : String := match h with
  | .const n _ _ _ _ => match foreignFin ffi n with
    | .some f => f
    | .none => ""
  | _ => ""
def ffiSigRes (ffi : List Foreign) (native : Bool) (t : Tm) : FfiSig :=
  let ioArg := ioArgOf t;
  let res : Tm := match ioArg with
    | .some a => a
    | .none => t;
  match extKind ffi native res with
  | .none => .bad
  | .some k => .mk .nil k (match ioArg with
    | .some _ => .true
    | .none => .false) (finOfHead ffi (tmHead res))
mutual
def ffiSig (ffi : List Foreign) (native : Bool) (t : Tm) : FfiSig := match t with
  | .pi q _ _ a b => ffiSigPi ffi native q a b
  | _ => ffiSigRes ffi native t
def ffiSigPi (ffi : List Foreign) (native : Bool) (q : Q) (a b : Tm) : FfiSig := match ffiParamKind ffi native q a with
  | .none => .bad
  | .some k => match ffiSig ffi native b with
    | .mk ks r io fin => .mk (.cons k ks) r io fin
    | .bad => .bad
end
def hasBang : List Char → Bool
  | .nil => .false
  | .cons c cs => Bool.or (Nat.beq (Char.code c) 33) (hasBang cs)
-- a callback whose result is in `IO` (`k[…/!…]`)
def ioCallback : List String → Bool
  | .nil => .false
  | .cons k rest => Bool.or (match k with
    | .mk cs => hasBang cs) (ioCallback rest)
def isNativeC (cname : String) : Bool := match "wiz_" with
  | .mk ps => match cname with
    | .mk cs => match dropPrefix ps cs with
      | .some _ => .true
      | .none => .false
def externCmd (gs : Globals) (stx : Syntax) : Step :=
  let name := match kid stx 3 with
    | .ident n => n
    | _ => "_";
  let cname := strValue (kid stx 1);
  let header := strValue (kid (kid stx 2) 3);
  match axiomCmd gs (mkNode "command.axiom" (.cons (.atom "axiom") (.cons (kid stx 3)
      (.cons (mkNull .nil) (.cons (mkNull .nil) (one (mkNull (.cons (.atom ":") (one (kid stx 5)))))))))) with
  | .mk line gs' => match gs' with
    | .mk all _ _ _ _ _ _ _ _ => match Nat.beq (Array.size all) (match gs with
      | .mk all0 _ _ _ _ _ _ _ _ => Array.size all0) with
      | .true => .mk line gs'
      | .false => match Array.getD all (Array.size all - 1) (.mk "?" .nil .star .star .star .nil .nil) with
        | .mk _ _ ty _ _ _ _ => match ffiSig (Globals.ffi gs) (isNativeC cname) ty with
          | .bad => errStep gs "a foreign function's arguments and result must be Nat, UInt64, Float64, String, Bool, Unit, a c_struct, a Wiz data type or a function of those (a callback; the result may be in IO)"
          | .mk ks r io fin => match Bool.and (Bool.not io) (ioCallback ks) with
            | .true => errStep gs "a foreign function that takes a callback in IO must be in IO itself"
            | .false => .mk line (Globals.addFFI gs' (.fn (globalKeyOf gs' name) cname header ks r io fin))
-- `foreign_type T (finalizer := "f")`: an opaque type (an axiom `T : Type`) of C pointers,
-- released with `f`
def foreignTypeCmd (gs : Globals) (stx : Syntax) : Step := match kid stx 1 with
  | .ident T => match Scope.lookup (Globals.scope gs) T with
    | .some _ => errStep gs (String.append (String.append "'" T) "' has already been declared")
    | .none =>
      let Tn := Globals.declName gs T;
      let gs' := Globals.add gs (.mk T .nil (.univ 0) (.axiomC Tn (.univ 0)) (.axiomC Tn (.univ 0)) .nil .nil);
      .mk (String.append T " : U0") (Globals.addFFI gs' (.ty Tn (strValue (kid (kid stx 2) 3)) (strValue (kid (kid stx 3) 3))))
  | _ => errStep gs "a foreign type needs a name"
-- (stage 21o) `link_c` and `link_lib`, as `command.linkC`/`linkLib` in the Lean
-- frontend: recorded once each, for the backend, which names them in the C it prints
-- (`// wiz-link-c: f.c`, `// wiz-link-lib: m`); the path is the one written, relative to
-- the input file's directory. (The frontend is pure: whether the file exists is up to
-- the C compiler.)
inductive LinkR where
  | mk (line : Option String) (gs : Globals)
def linkKnown (path : String) (lib : Bool) : List Foreign → Bool
  | .nil => .false
  | .cons f rest => match f with
    | .link p l => match Bool.and (strEq p path) (match l with
        | .true => lib
        | .false => Bool.not lib) with
      | .true => .true
      | .false => linkKnown path lib rest
    | _ => linkKnown path lib rest
def hasDashOrSpace : List Char → Bool
  | .nil => .false
  | .cons c cs => Bool.or (Nat.beq (Char.code c) 32) (hasDashOrSpace cs)
def badLib (lib : String) : Bool := match lib with
  | .mk cs => match cs with
    | .nil => .true
    | .cons c _ => Bool.or (Nat.beq (Char.code c) 45) (hasDashOrSpace cs)
def linkCmd (gs : Globals) (stx : Syntax) (lib : Bool) : LinkR :=
  let path := strValue (kid stx 1);
  match Bool.and lib (badLib path) with
  | .true => LinkR.mk (.some "error: link_lib: give the library's name, as in link_lib \"m\" for -lm") gs
  | .false => match linkKnown path lib (Globals.ffi gs) with
    | .true => LinkR.mk .none gs
    | .false => LinkR.mk .none (Globals.addFFI gs (.link path lib))
-- a C identifier: letters, digits and `_`, not starting with a digit
def isDigitC (c : Nat) : Bool := Bool.and (Nat.lt 47 c) (Nat.lt c 58)
def isIdentC (c : Nat) : Bool := Bool.or (Bool.or (isDigitC c) (Nat.beq c 95))
  (Bool.or (Bool.and (Nat.lt 64 c) (Nat.lt c 91)) (Bool.and (Nat.lt 96 c) (Nat.lt c 123)))
def allIdentC : List Char → Bool
  | .nil => .true
  | .cons c cs => Bool.and (isIdentC (Char.code c)) (allIdentC cs)
def isCIdent (n : String) : Bool := match n with
  | .mk cs => match cs with
    | .nil => .false
    | .cons c _ => Bool.and (Bool.not (isDigitC (Char.code c))) (allIdentC cs)
def exportedAs (cname : String) : List Foreign → Bool
  | .nil => .false
  | .cons f rest => match f with
    | .exported _ c _ _ _ => Bool.or (strEq c cname) (exportedAs cname rest)
    | _ => exportedAs cname rest
def globalTyOf (gs : Globals) (f : String) : Option Tm := match Scope.lookup (Globals.scope gs) f with
  | .none => .none
  | .some i => match gs with
    | .mk all _ _ _ _ _ _ _ _ => match Array.getD all (Array.size all - 1 - i) (.mk "?" .nil .star .star .star .nil .nil) with
      | .mk _ _ ty _ _ _ _ => .some ty
-- `export "c_name" f (: T)?` (stage 21o, as `command.export` in the Lean frontend)
def exportCmd (gs : Globals) (stx : Syntax) : LinkR :=
  let cname := strValue (kid stx 1);
  let f := identOf' (kid stx 2);
  let err := fun (m : String) => (LinkR.mk (Option.some (String.append "error: " m)) gs : LinkR);
  match globalTyOf gs f with
  | .none => err (String.append "unknown declaration " f)
  | .some ty =>
    let tyOk : Option String := match kids (kid stx 3) with
      | .cons _ (.cons tS _) => match inferType gs ES.empty (Cx.mk empty (Globals.scope gs) .nil) tS with
        | .err m => .some m
        | .ok T0 _ es => match zonk es 0 T0 with
          | .none => .some "could not infer an implicit argument"
          | .some T => match convTy empty (eval .nil ty) (eval .nil T) with
            | .true => .none
            | .false => .some (String.append (String.append (String.append f " has type ") (show .nil 0 ty))
                (String.append ", not " (show .nil 0 T)))
      | _ => .none;
    match tyOk with
    | .some m => err m
    | .none => match isCIdent cname with
      | .false => err (String.append cname " is not a C identifier")
      | .true => match exportedAs cname (Globals.ffi gs) with
        | .true => err (String.append cname " is exported already")
        -- (the kinds of a function C calls: as a callback's, `callSig`)
        | .false => match callSig (Globals.ffi gs) ty with
          | .mk ks r io => LinkR.mk .none (Globals.addFFI gs (.exported (globalKeyOf gs f) cname ks r io))
          | .bad => err "an exported function's arguments must be Nat, UInt64, Float64, String, Bool, a foreign pointer or a Wiz data type, and its result one of those (not a foreign pointer) or Unit, maybe in IO"
-- (stage 21t) `attribute [implemented_by g] f` (`command.attrImplementedBy`): compiled
-- code runs `g` wherever it would run `f`; the kernel keeps `f`'s definition. The Lean
-- frontend's checks and messages; a native representation (`implemented_by mk get` on
-- a constructor, 22d) is not supported here.
-- the globals the runtime provides (the backend's natives; moved here for
-- `implemented_by`, stage 21t)
def nativeNames : List String :=
  .cons "Nat.zero" (.cons "Nat.succ" (.cons "Nat.add" (.cons "Nat.sub" (.cons "Nat.mul" (.cons "Nat.pred"
  (.cons "Nat.beq" (.cons "Nat.blt" (.cons "Nat.lt" (.cons "Nat.le" (.cons "Nat.toString"
  (.cons "IO.ePrintln" (.cons "Process.exit" (.cons "IO.println" (.cons "IO.print" (.cons "IO.readFile" (.cons "IO.argCount" (.cons "IO.arg" (.cons "Str.ofString"
  (.cons "Array.empty" (.cons "Array.push" (.cons "Array.size" (.cons "Array.getD" (.cons "Array.set"
  (.cons "StrMap.empty" (.cons "StrMap.insert" (.cons "StrMap.findD" (.cons "StrMap.size" (.cons "memo"
  (.cons "Nat.div" (.cons "Nat.mod" (.cons "Nat.pow" (.cons "Nat.land" (.cons "Nat.lor" (.cons "Nat.xor"
  (.cons "Nat.shiftLeft" (.cons "Nat.shiftRight" (.cons "Nat.log2" .nil)))))))))))))))))))))))))))))))))))))
def externNamed (n : String) : List Foreign → Bool
  | .nil => .false
  | .cons f rest => match f with
    | .fn m _ _ _ _ _ _ => Bool.or (strEq m n) (externNamed n rest)
    | _ => externNamed n rest
def reprExists (ffi : List Foreign) (T : String) : Bool := match ffi with
  | .nil => .false
  | .cons f rest => match f with
    | .repr t _ _ => Bool.or (strEq t T) (reprExists rest T)
    | _ => reprExists rest T
def implementedByCmd (gs : Globals) (stx : Syntax) : LinkR :=
  let g := identOf' (kid stx 3);
  let f := identOf' (kid stx 6);
  let err := fun (m : String) => (LinkR.mk (Option.some (String.append "error: " m)) gs : LinkR);
  match globalTyOf gs f with
  | .none => err (String.append "unknown declaration " f)
  | .some tyF => match globalTyOf gs g with
    | .none => err (String.append "unknown declaration " g)
    | .some tyG => match kids (kid stx 4) with
      | .cons getStx _ =>
        -- `attribute [implemented_by mk get] T.mk` (stage 22d): values of `T` are native.
        -- The self-hosted backend records the constructor's implementation (`mk`) and the
        -- representation; a program that only uses the type through its `implemented_by`
        -- operations (as `U32Array`/`U64Map` do) compiles to those natives.
        let get := identOf' getStx;
        match globalTyOf gs get with
        | .none => err (String.append "unknown declaration " get)
        | .some tyGet =>
          let T := match splitLast f with
            | .some (.mk base _) => base
            | .none => f;
          match reprExists (Globals.ffi gs) T with
          | .true => err (String.append T " already has a native representation")
          | .false => match Scope.lookup (Globals.scope gs) (String.append T ".seal✝") with
            | .none => err (String.append "a native representation needs `sealed inductive " (String.append T "`: a look-alike of an unsealed type is the same type"))
            | .some _ =>
              -- `mk` must have the constructor's type, and `get` must end in `T`
              if Bool.not (convTy empty (eval .nil tyG) (eval .nil tyF)) then
                err (g +++ " can't implement " +++ f +++ ": its type " +++ show .nil 0 tyG +++ " is not " +++ f +++ "'s type")
              else (
                let gs1 := Globals.addFFI gs (.impl f g);
                LinkR.mk .none (Globals.addFFI gs1 (.repr T g get)))
      | .nil => match Bool.or (externNamed f (Globals.ffi gs)) (elemStr f nativeNames) with
        | .true => err (String.append f " is a builtin or foreign function: it already has an implementation")
        | .false => match strEq f g with
          | .true => err (String.append f " can't be implemented by itself")
          | .false => match convTy empty (eval .nil tyF) (eval .nil tyG) with
            | .false => err (String.append (String.append (String.append g " can't implement ") f)
                (String.append (String.append ": its type " (show .nil 0 tyG)) (String.append (String.append " is not " f)
                (String.append "'s type " (show .nil 0 tyF)))))
            | .true => LinkR.mk .none (Globals.addFFI gs (.impl (globalKeyOf gs f) (globalKeyOf gs g)))
def joinLines : List String → String
  | .nil => ""
  | .cons l rest => match rest with
    | .nil => l
    | .cons _ _ => String.append (String.append l "\n") (joinLines rest)
-- the bodies, in order, each line for its definition
def defsSteps : Globals → List Syntax → Step
  | gs, .nil => .mk "" gs
  | gs, .cons d rest => match defStep gs d with
    | .mk line gs' => match defsSteps gs' rest with
      | .mk lines gs'' => .mk (match rest with
          | .nil => line
          | .cons _ _ => String.append (String.append line "\n") lines) gs''
def partialCmd (gs : Globals) (defs : List Syntax) : Step := match addPartials gs defs with
  | .err m => errStep gs m
  | .ok gs1 => defsSteps gs1 (unwrapDefs defs)

-- Structures (stage 18e): `structure T (ps) where f₁ : A₁ …` is the inductive type
-- `T (ps) where | mk (f₁ : A₁) …` and a projection `T.fᵢ {ps} (s : T ps) : Aᵢ` for each
-- field, by `match s with | .mk f₁ … => fᵢ` (all built as syntax, then checked as
-- usual; a field's type may not mention an earlier field yet).
def identStx (n : String) : Syntax := mkNode "term.ident" (one (.ident n))
-- (an instance binder is `[x : A]`, without the quantity slot the other binders have)
def binderStx (ob cb x : String) (A : Syntax) : Syntax := match strEq ob "[" with
  | .true => mkNode "binder.inst" (.cons (.atom "[")
    (.cons (mkNull (.cons (.ident x) (.cons (.atom ":") .nil))) (.cons A (one (.atom "]")))))
  | .false => mkNode (match strEq ob "{" with
    | .true => "binder.implicit"
    | .false => "binder.explicit") (.cons (.atom ob) (.cons (mkNull .nil)
    (.cons (mkNull (one (.ident x))) (.cons (mkNull (.cons (.atom ":") (one A))) (one (.atom cb))))))
-- the parameter binders, made implicit
def implicitBinders : List Syntax → List Syntax
  | .nil => .nil
  | .cons b rest => .cons (mkNode "binder.implicit" (.cons (.atom "{") (.cons (kid b 1) (.cons (kid b 2)
      (.cons (kid b 3) (one (.atom "}"))))))) (implicitBinders rest)
-- (a field is ["private"] [quantity] ident ":" T)
def fieldName (f : Syntax) : String := identOf' (kid f 2)
def fieldBinders : List Syntax → List Syntax
  | .nil => .nil
  | .cons f rest => .cons (setKid (binderStx "(" ")" (fieldName f) (kid f 4)) 1 (kid f 1)) (fieldBinders rest)
def fieldIdents : List Syntax → List Syntax
  | .nil => .nil
  | .cons f rest => .cons (identStx (fieldName f)) (fieldIdents rest)
-- (21x) a field at 0 has no projection (`classMethods` in the Lean elaborator)
def erasedField (f : Syntax) : Bool := match writtenQ (kid f 1) with
  | .is q => qEq q .qz
  | _ => .false
def projections (T : String) (bs : List Syntax) (sTy pat : Syntax) : List Syntax → List Syntax
  | .nil => .nil
  | .cons f rest => match erasedField f with
  | .true => projections T bs sTy pat rest
  | .false =>
    let alt := mkNode "match.alt" (.cons (.atom "|") (.cons (mkNull (one pat)) (.cons (.atom "=>") (one (identStx (fieldName f))))));
    let body := mkNode "term.match" (.cons (.atom "match") (.cons (mkNull (one (identStx "s✝")))
      (.cons (.atom "with") (one (mkNull (one alt))))));
    let d := mkNode "command.def" (.cons (.atom "def") (.cons (.ident (String.append (String.append T ".") (fieldName f)))
      (.cons (mkNull .nil) (.cons (mkNull (List.append (implicitBinders bs) (one (binderStx "(" ")" "s✝" sTy))))
        (.cons (mkNull (.cons (.atom ":") (one (kid f 4)))) (.cons (.atom ":=") (one body)))))));
    .cons d (projections T bs sTy pat rest)
def strIdents : List String → List Syntax
  | .nil => .nil
  | .cons x rest => .cons (identStx x) (strIdents rest)
def structCmd (gs : Globals) (stx : Syntax) : Step :=
  let T := identOf' (kid stx 1);
  let bs := kids (kid stx 3);
  let fs := kids (kid stx 6);
  let ps := fieldNames (fieldsOf bs);
  let sTy := match ps with
    | .nil => identStx T
    | .cons _ _ => mkNode "term.app" (.cons (identStx T) (one (mkNull (strIdents ps))));
  let ctor := mkNode "inductive.ctor" (.cons (.atom "|") (.cons (mkNull .nil) (.cons (.ident "mk") (.cons (mkNull (fieldBinders fs)) (one (mkNull .nil))))));
  let ind := mkNode "command.inductive" (.cons (.atom "inductive") (.cons (kid stx 1) (.cons (kid stx 2) (.cons (kid stx 3)
    (.cons (kid stx 4) (.cons (.atom "where") (.cons (mkNull (one ctor)) (one (.atom "structure")))))))));
  let pat := mkNode "term.app" (.cons (mkNode "term.dotIdent" (.cons (.atom ".") (one (.ident "mk")))) (one (mkNull (fieldIdents fs))));
  match defsSteps gs (.cons ind (projections T bs sTy pat fs)) with
  | .mk out gs' => .mk out (Globals.markStruct gs' T)

-- (A10) Type classes. `class C (ps) where f₁ : A₁ …` is the structure `C (ps) where
-- | mk (f₁ : A₁) …` (so a class value is a dictionary, `C.mk …`, and it compiles with no
-- backend change), plus a method `C.fᵢ {ps} [self : C ps] : Aᵢ` for each field: the
-- structure's projection with `self` an *instance* binder, so a use `C.fᵢ` inserts its
-- class problem automatically (`insertImplicits`).
--
-- The class's parameters keep their written kinds in the type former `C` (a class with
-- an instance parameter, `class Commute (e₁ e₂) (m) [i : Monad m] where …`, re-inserts
-- that problem at each use of `C e₁ e₂ m`); the methods' parameters are implicit.
--
-- Not supported (errors): private fields, `outParam` (no rewrite of an output
-- parameter's type), `attribute [default_instance]`/`[binop]`, universe-polymorphic
-- classes, and `deriving` on a class.
def classFieldNames : List Syntax → List String
  | .nil => .nil
  | .cons f rest => .cons (fieldName f) (classFieldNames rest)
-- the parameter binders of a class's methods: implicit, except instance binders
def classMethBinders : List Syntax → List Syntax
  | .nil => .nil
  | .cons b rest => List.append (match isInstB b with
      | .true => List.cons b .nil
      | .false => implicitBinders (List.cons b .nil)) (classMethBinders rest)
-- the projections with an instance `self` (a class's methods)
def instProjections (T : String) (bs : List Syntax) (sTy pat : Syntax) : List Syntax → List Syntax
  | .nil => .nil
  | .cons f rest => match erasedField f with
  | .true => instProjections T bs sTy pat rest
  | .false =>
    let alt := mkNode "match.alt" (.cons (.atom "|") (.cons (mkNull (one pat)) (.cons (.atom "=>") (one (identStx (fieldName f))))));
    let body := mkNode "term.match" (.cons (.atom "match") (.cons (mkNull (one (identStx "self✝")))
      (.cons (.atom "with") (one (mkNull (one alt))))));
    let d := mkNode "command.def" (.cons (.atom "def") (.cons (.ident (String.append (String.append T ".") (fieldName f)))
      (.cons (mkNull .nil) (.cons (mkNull (List.append (classMethBinders bs) (one (binderStx "[" "]" "self✝" sTy))))
        (.cons (mkNull (.cons (.atom ":") (one (kid f 4)))) (.cons (.atom ":=") (one body)))))));
    .cons d (instProjections T bs sTy pat rest)
-- (an optional wraps its item in a `null` node: `["private"]` is `null [atom "private"]`)
partial def hasPrivate (s : Syntax) : Bool := match s with
  | .atom a => strEq a "private"
  | .node _ _ => match kids s with
    | .cons x _ => hasPrivate x
    | .nil => .false
  | _ => .false
def classFieldErr : List Syntax → Option String
  | .nil => .none
  | .cons f rest => match hasPrivate (kid f 0) with
    | .true => .some (String.append (String.append "class field " (fieldName f))
        " cannot be private: a class's fields are its methods, visible wherever the class is")
    | .false => classFieldErr rest
def classCmd (gs : Globals) (stx : Syntax) : Step :=
  let T := identOf' (kid stx 1);
  let bs := kids (kid stx 3);
  let fs := kids (kid stx 6);
  match classFieldErr fs with
  | .some m => errStep gs m
  | .none =>
    let ps := fieldNames (fieldsOf bs);
    let sTy := match ps with
      | .nil => identStx T
      | .cons _ _ => mkNode "term.app" (.cons (identStx T) (one (mkNull (strIdents ps))));
    let ctor := mkNode "inductive.ctor" (.cons (.atom "|") (.cons (mkNull .nil) (.cons (.ident "mk") (.cons (mkNull (fieldBinders fs)) (one (mkNull .nil))))));
    let ind := mkNode "command.inductive" (.cons (.atom "inductive") (.cons (kid stx 1) (.cons (kid stx 2) (.cons (kid stx 3)
      (.cons (kid stx 4) (.cons (.atom "where") (.cons (mkNull (one ctor)) (one (.atom "structure")))))))));
    let pat := mkNode "term.app" (.cons (mkNode "term.dotIdent" (.cons (.atom ".") (one (.ident "mk")))) (one (mkNull (fieldIdents fs))));
    match defsSteps gs (.cons ind (instProjections T bs sTy pat fs)) with
    -- (the class type former keeps its binders' kinds: an instance parameter of the
    -- class is a class problem at every use, `MyCommute e₁ e₂ m`)
    | .mk out gs' => .mk out (Globals.addClass (Globals.setMask (Globals.markStruct gs' T) T (paramMask bs))
        T (.mk (classFieldNames fs)))

-- (A10) Instances. `instance [priority] [name] {bs} : C a… := v` (or `where f := v …`) is
-- an ordinary definition of the class type `C a…`: the dictionary. It is checked to be a
-- class application, added as a global with its binders' kinds, and registered in
-- `Globals.insts` for `resolveInstances`. A second instance of a definitionally equal
-- class type is an error (there is no priority choice between overlapping instances).
-- `where` builds `C.mk f₁ … fₙ` in the class's field order; a missing, duplicated or
-- unknown field is an error.
inductive Fld where
  | mk (n : String) (v : Syntax)
def fldCount : List Fld → String → Nat
  | .nil, _ => 0
  | .cons (.mk n _) rest, x => match strEq n x with
    | .true => Nat.succ (fldCount rest x)
    | .false => fldCount rest x
def findFld : List Fld → String → Option Syntax
  | .nil, _ => .none
  | .cons (.mk n v) rest, x => match strEq n x with
    | .true => .some v
    | .false => findFld rest x
def instFlds : List Syntax → List Fld
  | .nil => .nil
  | .cons f rest => .cons (.mk (identOf' (kid f 0)) (kid f 2)) (instFlds rest)
inductive ArgsR where
  | ok (args : List Syntax)
  | err (msg : String)
def fldErr (m : String) : ArgsR := .err m
def fldIn : List String → String → Bool
  | .nil, _ => .false
  | .cons x xs, y => Bool.or (strEq x y) (fldIn xs y)
def unknownFld (order : List String) : List Fld → Option String
  | .nil => .none
  | .cons (.mk n _) rest => match fldIn order n with
    | .true => unknownFld order rest
    | .false => .some n
def instArgs (C : String) (given : List Fld) : List String → ArgsR
  | .nil => .ok .nil
  | .cons f rest => match fldCount given f with
    | .zero => fldErr (String.append (String.append (String.append "missing field '" f) "' in the instance for class ") C)
    | .succ (.succ _) => fldErr (String.append (String.append (String.append "field '" f) "' is given twice in the instance for class ") C)
    | .succ _ => match findFld given f with
      | .none => fldErr (String.append (String.append (String.append "missing field '" f) "' in the instance for class ") C)
      | .some v => match instArgs C given rest with
        | .ok vs => .ok (.cons v vs)
        | .err m => .err m
def mkAppS (C : String) (args : List Syntax) : Syntax := match args with
  | .nil => identStx (String.append C ".mk")
  | .cons _ _ => mkNode "term.app" (.cons (identStx (String.append C ".mk")) (one (mkNull args)))
-- the head identifier of an application (the class of an instance's type)
partial def headIdent (s : Syntax) : Option String :=
  let k := kindOf s;
  match strEq k "term.ident" with
    | .true => .some (identOf s)
    | .false => match strEq k "term.app" with
      | .true => headIdent (kid s 0)
      | .false => match strEq k "term.paren" with
        | .true => headIdent (kid s 1)
        | .false => .none
partial def freshName (gs : Globals) (base : String) (k : Nat) : String :=
  let nm := match k with
    | .zero => base
    | _ => String.append base (Nat.toString k);
  match Scope.lookup (Globals.scope gs) nm with
  | .none => nm
  | .some _ => freshName gs base (k + 1)
-- the priority in `instance (priority := n) …` (1000 by default)
def numIn : List Syntax → Nat
  | .nil => 1000
  | .cons s rest => match s with
    | .node k _ => match strEq k "num" with
      | .true => numValue s
      | .false => numIn rest
    | _ => numIn rest
def instPrio (s : Syntax) : Nat := numIn (kids s)
-- an optional identifier (the parser's `optional` wraps its result in a `null` node,
-- when the frontends' parsers differ about a single item it may be bare)
def optIdent (s : Syntax) : Option String := match s with
  | .ident n => .some n
  | .node k _ => match strEq k "null" with
    | .true => match kids s with
      | .cons (.ident n) _ => .some n
      | _ => .none
    | .false => .none
  | _ => .none
-- an existing instance of `C` with the same type (a duplicate)
def dupAmong (gs : Globals) (ty : Tm) : List InstInfo → Option InstInfo
  | .nil => .none
  | .cons i rest => match globalTyOf gs (nameOf i) with
    | .none => dupAmong gs ty rest
    | .some tyOld => match convTy empty (eval .nil ty) (eval .nil tyOld) with
      | .true => .some i
      | .false => dupAmong gs ty rest
def instDuplicate (gs : Globals) (C : String) (ty : Tm) : Option InstInfo :=
  dupAmong gs ty (instsOf C (Globals.insts gs))
inductive SynR where
  | ok (s : Syntax)
  | err (msg : String)
def instanceCmd (gs : Globals) (stx : Syntax) : Step :=
  let bs := kids (kid stx 3);
  let tyS := kid stx 5;
  let prio := instPrio (kid stx 1);
  match headIdent tyS with
  | .none => errStep gs "an instance's type must be a class application (C a…)"
  | .some C => match Globals.class gs C with
    | .none => errStep gs (String.append C " is not a class: an instance needs a class declared with `class`")
    | .some _ =>
      let isWhere := match kid stx 6 with
        | .atom w => strEq w "where"
        | _ => Bool.false;
      let vR : SynR := match isWhere with
        | .true => match Globals.structFields gs C with
          | .none => .err (String.append "internal error: no fields for class " C)
          | .some fs => match unknownFld fs (instFlds (kids (kid stx 7))) with
            | .some n => .err (String.append (String.append (String.append "unknown field '" n) "' for class ") C)
            | .none => match instArgs C (instFlds (kids (kid stx 7))) fs with
              | .err m => .err (String.append (String.append "instance for class " C) (String.append ": " m))
              | .ok args => .ok (mkAppS C args)
        | .false => .ok (kid stx 7);
      match vR with
      | .err m => errStep gs m
      | .ok vS =>
        let name := match optIdent (kid stx 2) with
          | .some n => n
          | .none => freshName gs (String.append "inst" C) 0;
        match defT gs ES.empty (Cx.mk empty (Globals.scope gs) .nil) bs tyS vS with
        | .err m => errStep gs m
        | .ok ty0 v0 es0 => match finishElab gs es0 with
          | .err m => errStep gs m
          | .ok es => match zonk es 0 ty0 with
            | .none => errStep gs "could not infer an implicit argument"
            | .some tyZ => let tyT := sortTy tyZ; match zonk es 0 v0 with
              | .none => errStep gs "could not infer an implicit argument"
              | .some v0z => match inferUniv empty tyT with
                | .err m => errStep gs m
                | .ok _ _ => match instDuplicate gs C tyT with
                  | .some i => errStep gs (String.append (String.append (String.append "duplicate instance: " (nameOf i))
                      " already has the type of this one (") (String.append (show .nil 0 tyT) ")"))
                  | .none => match checkMarking v0z tyT with
                    | .bad m => errStep gs m
                    | .good v => .mk (String.append name (String.append " : " (show .nil 0 tyT)))
                        (Globals.addInst (Globals.add gs (.mk name .nil tyT v (inlineTm gs v) (paramMask bs) (binderParamNames bs)))
                          (.mk C name prio (List.length (Globals.insts gs))))

-- (stage 21r) `c_struct ["ctype"] [(header := "h")] T where fields` (`command.cStruct`):
-- the structure `T` (`structCmd`), standing for the C struct `ctype` (by default
-- `wiz_s_T`, mangled as the Lean backend mangles), passed to and from foreign functions
-- by value. A field is `Nat`, `UInt64`, `Float64`, `String`, `Bool`, a foreign type or
-- another `c_struct`, checked on its own (fields may not depend on each other); the
-- Lean frontend's checks and messages. (No `Bytes` here: the self-hosted runtime has
-- none.)
def hexDigit (d : Nat) : Char := Char.mk (match Nat.lt d 10 with
  | .true => d + 48
  | .false => d + 87)
def hexGo : Nat → Nat → List Char → List Char
  | .zero, _, acc => acc
  | .succ fuel, n, acc => match Nat.lt n 16 with
    | .true => .cons (hexDigit n) acc
    | .false => hexGo fuel (Nat.div n 16) (.cons (hexDigit (Nat.mod n 16)) acc)
def isAlnumC (k : Nat) : Bool := Bool.or (isDigitC k) (Bool.or (Bool.and (Nat.lt 64 k) (Nat.lt k 91)) (Bool.and (Nat.lt 96 k) (Nat.lt k 123)))
def hexMangle : List Char → List Char
  | .nil => .nil
  | .cons c rest => match isAlnumC (Char.code c) with
    | .true => .cons c (hexMangle rest)
    | .false => .cons (Char.mk 95) (List.append (hexGo 8 (Char.code c) .nil) (.cons (Char.mk 95) (hexMangle rest)))
-- `:`, `|` or `<`, which the Lean frontend's struct keys can't hold
def badCChar : List Char → Bool
  | .nil => .false
  | .cons c cs => Bool.or (Bool.or (Nat.beq (Char.code c) 58) (Nat.beq (Char.code c) 124))
      (Bool.or (Nat.beq (Char.code c) 60) (badCChar cs))
def strChars (s : String) : List Char := match s with
  | .mk cs => cs
def tmName (t : Tm) : String := match t with
  | .const n _ _ _ _ => n
  | .axiomC n _ => n
  | _ => ""
def fieldKindNamed (ffi : List Foreign) (n : String) : Option String := match strEq n "Nat" with
  | .true => .some "n"
  | .false => match strEq n "UInt64" with
  | .true => .some "u"
  | .false => match strEq n "Float64" with
  | .true => .some "f"
  | .false => match strEq n "String" with
  | .true => .some "s"
  | .false => match strEq n "Bool" with
  | .true => .some "b"
  | .false => match foreignFin ffi n with
  | .some _ => .some "p"
  | .none => cstructKind ffi n
inductive FieldKs where
  | ok (names kinds : List String)
  | err (msg : String)
def fieldKindErr (fname m : String) : FieldKs := .err (String.append (String.append "c_struct field " fname) (String.append ": " m))
def cFieldKinds (gs : Globals) : List Syntax → FieldKs
  | .nil => .ok .nil .nil
  | .cons f rest =>
    let fname := fieldName f;
    match inferType gs ES.empty (Cx.mk empty (Globals.scope gs) .nil) (kid f 4) with
    | .err m => fieldKindErr fname (String.append m " (fields may not depend on other fields)")
    | .ok T0 _ es => match zonk es 0 T0 with
      | .none => fieldKindErr fname "could not infer an implicit argument (fields may not depend on other fields)"
      | .some T => match fieldKindNamed (Globals.ffi gs) (tmName (tmHead T)) with
        | .none => fieldKindErr fname "a field must be Nat, UInt64, Float64, String, Bool, a foreign type, another c_struct or (with a header) Bytes"
        | .some k => match cFieldKinds gs rest with
          | .ok ns ks => .ok (.cons fname ns) (.cons k ks)
          | .err m => .err m
-- an output line with an error (the structure's lines, one per declaration)
def errStart (cs : List Char) : Bool := match dropPrefix (strChars "error") cs with
  | .some _ => .true
  | .none => .false
def errLineAt : List Char → Bool
  | .nil => .false
  | .cons c cs => match Nat.beq (Char.code c) 10 with
    | .true => Bool.or (errStart cs) (errLineAt cs)
    | .false => errLineAt cs
def hasErrLine (s : String) : Bool := Bool.or (errStart (strChars s)) (errLineAt (strChars s))
def cStructCmd (gs : Globals) (stx : Syntax) : Step :=
  let T := identOf' (kid stx 3);
  let header := strValue (kid (kid stx 2) 3);
  let ctype := match kids (kid stx 1) with
    | .cons c _ => strValue c
    | .nil => String.append "wiz_s_" (String.mk (hexMangle (strChars T)));
  let fs := kids (kid stx 5);
  match Scope.lookup (Globals.scope gs) T with
  | .some _ => errStep gs (String.append (String.append "'" T) "' has already been declared")
  | .none => match fs with
    | .nil => errStep gs "a c_struct needs at least one field"
    | .cons _ _ => match Bool.or (badCChar (strChars ctype)) (badCChar (strChars header)) with
      | .true => errStep gs "c_struct: unexpected characters in the C type or header"
      | .false => match cFieldKinds gs fs with
        | .err m => errStep gs m
        | .ok names ks =>
          let st := mkNode "command.structure" (.cons (.atom "structure") (.cons (kid stx 3) (.cons (mkNull .nil)
            (.cons (mkNull .nil) (.cons (mkNull .nil) (.cons (.atom "where") (.cons (kid stx 5) (one (kid stx 6)))))))));
          match structCmd gs st with
          | .mk line gs' => match hasErrLine line with
            | .true => .mk line gs'
            | .false => .mk line (Globals.addFFI gs' (.cstruct (globalKeyOf gs' T) ctype header names ks))

-- **`import_c` and `glue`** (stage 30; `command.importC` and `command.glue` in
-- `Elab/Command.lean`). The self-hosted frontend is pure, so the driver reads the header
-- texts (`Globals.headers`) and the frontend parses them with `CParse.wiz`. The subset
-- here is scalar C (integers, floats, `char *`, `Bool`, `void`, foreign pointers and
-- `c_struct`s that were declared explicitly); a header must be self-contained (the
-- self-hosted compiler does not run the C preprocessor), and structs by value are not
-- mapped automatically from a header yet (declare a `c_struct` for them).
def namedConst (gs : Globals) (n : String) : Tm :=
  match Scope.lookup (Globals.scope gs) n with
  | .some i => globalTm .false gs i
  | .none => .const n .nil .nil (.axiomC n (.univ 0)) (.univ 0)
def kindTy2 (gs : Globals) (k n : String) : Tm :=
  if strEq k "b" then namedConst gs "Bool"
  else if strEq k "v" then .unit 0
  else namedConst gs n

def kindTy (gs : Globals) (k n : String) : Tm :=
  if strEq k "n" then namedConst gs "Nat"
  else if strEq k "u" then namedConst gs "UInt64"
  else if strEq k "f" then namedConst gs "Float64"
  else if strEq k "s" then namedConst gs "String"
  else kindTy2 gs k n
def ioKindTy (t : Tm) : Tm := .app (.const "IO" .nil .nil (.axiomC "IO" (.univ 0)) (.univ 0)) t
structure KN where
  kind : String
  name : String
partial def piKinds (gs : Globals) : List KN → Tm → Tm
  | .nil, t => t
  | .cons e rest, t => .pi .qw .lhole .lhole (kindTy gs e.kind e.name) (piKinds gs rest t)
def tyOfKinds (gs : Globals) (ks : List KN) (rk rn : String) (isPure : Bool) : Tm :=
  let r := kindTy gs rk rn;
  piKinds gs ks (match isPure with
    | .true => r
    | .false => ioKindTy r)
def cstructNameless (ffi : List Foreign) (sp : String) : Option String := match ffi with
  | .nil => .none
  | .cons f rest => match f with
    | .cstruct n c _ _ _ => match strEq c sp with
      | .true => .some n
      | .false => cstructNameless rest sp
    | _ => cstructNameless rest sp
def cstructCType (ffi : List Foreign) (n : String) : String := match ffi with
  | .nil => "void *"
  | .cons f rest => match f with
    | .cstruct m c _ _ _ => match strEq m n with
      | .true => c
      | .false => cstructCType rest n
    | _ => cstructCType rest n
def foreignTypeFor (ffi : List Foreign) (sp : String) : Option String := match ffi with
  | .nil => .none
  | .cons f rest => match f with
    | .ty n _ c => match strEq c sp with
      | .true => .some n
      | .false => foreignTypeFor rest sp
    | _ => foreignTypeFor rest sp
def hasForeignTypeName (ffi : List Foreign) (n : String) : Bool := match ffi with
  | .nil => .false
  | .cons f rest => match f with
    | .ty m _ _ => Bool.or (strEq m n) (hasForeignTypeName rest n)
    | _ => hasForeignTypeName rest n
def addForeignType (gs : Globals) (name cname : String) : Option Globals :=
  match Scope.lookup (Globals.scope gs) name with
  | .some _ => .none
  | .none =>
    let gs1 := Globals.add gs (.mk name .nil (.univ 0) (.axiomC name (.univ 0)) (.axiomC name (.univ 0)) .nil .nil);
    .some (Globals.addFFI gs1 (.ty name "" cname))
-- the kind of a C type: scalar C, a `char *`, a foreign pointer, or a declared c_struct
inductive KR where
  | kok (kind name : String) (gs : Globals)
  | kerr
def cDropStructPrefix (s : String) : String := match s with
  | .mk cs => match cs with
    | .cons a (.cons b (.cons c (.cons d (.cons e (.cons f (.cons g rest)))))) =>
      match strEq (String.mk (.cons a (.cons b (.cons c (.cons d (.cons e (.cons f (.cons g .nil)))))))) "struct " with
      | .true => String.mk rest
      | .false => s
    | _ => s
def hdrWizPtrName (sp : String) : String := String.append "C." (cDropStructPrefix sp)
def kindPtr (sp : String) (gs : Globals) (noAuto : Bool) (skips : List String) : KR := match foreignTypeFor (Globals.ffi gs) sp with
  | .some n => .kok "p" n gs
  | .none =>
    let name := hdrWizPtrName sp
    match hasForeignTypeName (Globals.ffi gs) name with
    | .true => .kok "p" name gs
    | .false =>
      if Bool.or noAuto (elemStr sp skips) then .kerr else (match addForeignType gs name sp with
      | .some gs1 => .kok "p" name gs1
      | .none => .kerr)
mutual

partial def kindOfCTy2 (isResult : Bool) (ct : CTy) (gs : Globals) (noAuto : Bool) (skips : List String) (fuel : Nat) : KR := match ct with
    | .cptr t => match t with
      | .cint n => if strEq n "char" then .kok "s" "" gs else .kerr
      | .cconst u => match u with
        | .cint n => if strEq n "char" then .kok "s" "" gs else .kerr
        | .cstruct sp => kindPtr sp gs noAuto skips
        | _ => .kerr
      | .cstruct sp => kindPtr sp gs noAuto skips
      | _ => .kerr
    | .cstruct sp => match cstructNameless (Globals.ffi gs) sp with
      | .some n => .kok ("S:" +++ n) n gs
      | .none => .kerr
    | .carray t _ => kindOfCTy isResult (.cptr t) gs noAuto skips fuel
    | _ => .kerr

partial def kindOfCTy (isResult : Bool) (ct : CTy) (gs : Globals) (noAuto : Bool) (skips : List String) (fuel : Nat) : KR := match fuel with
  | .zero => .kerr
  | .succ f => match ct with
    | .cconst t => kindOfCTy isResult t gs noAuto skips f
    | .cvoid => match isResult with
      | .true => .kok "v" "" gs
      | .false => .kerr
    | .cint n => if strEq n "_Bool" then .kok "b" "" gs else .kok "n" "" gs
    | .cfloat _ => .kok "f" "" gs
    | _ => kindOfCTy2 isResult ct gs noAuto skips f

end

partial def splitSpaces : List Char → List String
  | .nil => .nil
  | .cons c cs => match Nat.beq (Char.code c) 32 with
    | .true => splitSpaces cs
    | .false =>
      let r := cTakeWhile (fun d => Bool.not (Nat.beq (Char.code d) 32)) (.cons c cs)
      .cons (String.mk r.1) (splitSpaces r.2)
def importSkips : List Syntax → List String
  | .nil => .nil
  | .cons o rest => match kid o 3 with
    | .node _ _ => List.append (splitSpaces (match strValue (kid o 3) with | .mk cs => cs)) (importSkips rest)
    | _ => importSkips rest
def importNoAuto : List Syntax → Bool
  | .nil => .false
  | .cons o rest => Bool.or (match kids o with
    | .cons _ (.cons _ (.cons _ .nil)) => .true
    | _ => .false) (importNoAuto rest)
partial def padNames : List String → Nat → List String
  | .nil, .zero => .nil
  | .nil, .succ k => .cons "_" (padNames .nil k)
  | .cons n ns, .succ k => .cons n (padNames ns k)
  | .cons n ns, .zero => .nil
def zipKinds : List String → List String → List KN
  | .cons k ks, .cons n ns => .cons (KN.mk k n) (zipKinds ks ns)
  | _, _ => .nil
inductive KList where
  | kok (ks : List String) (gs : Globals)
  | kerr
partial def kindList (gs : Globals) (noAuto : Bool) (skips : List String) : List CTy → KList
  | .nil => .kok .nil gs
  | .cons t ts => match kindOfCTy .false t gs noAuto skips 8 with
    | .kerr => .kerr
    | .kok k _ gs1 => match kindList gs1 noAuto skips ts with
      | .kerr => .kerr
      | .kok ks gs2 => .kok (.cons k ks) gs2
partial def importFuncs (gs : Globals) (header : String) (noAuto : Bool) (skips : List String) (isPure : Bool) : List CFn → Globals
  | .nil => gs
  | .cons (.mk name ret ps variadic pnames) rest =>
    let gs1 := match variadic with
      | .true => gs
      | .false => match elemStr name skips with
        | .true => gs
        | .false => match kindList gs noAuto skips ps with
          | .kerr => gs
          | .kok ks gsA => match kindOfCTy .true ret gsA noAuto skips 8 with
            | .kerr => gsA
            | .kok rk rn gsB =>
              let gname := "C." +++ name;
              match Scope.lookup (Globals.scope gsB) gname with
              | .some _ => gsB
              | .none =>
                let ty := tyOfKinds gsB (zipKinds ks (padNames pnames (lenL ks))) rk rn isPure;
                let fin := match strEq rk "p" with
                  | .true => match foreignFin (Globals.ffi gsB) rn with
                    | .some x => x
                    | .none => ""
                  | .false => ""
                let gsC := Globals.add gsB (.mk gname .nil ty (.axiomC gname ty) (.axiomC gname ty) (dfltKinds (lenL ks)) .nil);
                Globals.addFFI gsC (.fn gname name header ks rk (Bool.not isPure) fin)
    importFuncs gs1 header noAuto skips isPure rest
def addImportedFuncs (gs : Globals) (header : String) (fs : List CFn) (noAuto : Bool) (skips : List String) (isPure : Bool) : Globals :=
  importFuncs gs header noAuto skips isPure fs
partial def addCfuncs (gs : Globals) (noAuto : Bool) (skips : List String) : List CFn → Globals
  | .nil => gs
  | .cons (.mk name ret ps variadic pnames) rest =>
    let gs1 := match variadic with
      | .true => gs
      | .false => match kindList gs noAuto skips ps with
        | .kerr => gs
        | .kok ks gA => Globals.addFFI gA (.cfunc name ks (match kindOfCTy .true ret gA noAuto skips 8 with | .kok k _ _ => k | .kerr => ""))
    addCfuncs gs1 noAuto skips rest
def importCCmd (gs : Globals) (stx : Syntax) : Step :=
  let header := strValue (kid stx 1);
  let isPure : Bool := match kids (kid stx 2) with
    | .cons _ _ => .true
    | .nil => .false;
  let opts := kids (kid stx 3);
  let noAuto := importNoAuto opts;
  let skips := importSkips opts;
  match Globals.header gs header with
  | .none => errStep gs (String.append "no header " (String.append header " (the self-hosted compiler reads import_c headers from the file system; use a self-contained header)"))
  | .some text => match cParseHeader text with
    | .mk fs sts =>
      let gs2 := addImportedFuncs gs header fs noAuto skips isPure;
      .mk "" (addCfuncs gs2 noAuto skips fs)
-- `glue`: a checked C body. As in `Elab/Command.lean`, the Wiz type gives the signature;
-- the body may call the functions `import_c` bound.
def glueGtyOfKind (k : String) : GTy := match strEq k "f" with
  | .true => .gdbl
  | .false => match strEq k "s" with
  | .true => .gstr
  | .false => match strEq k "v" with
  | .true => .gvoid
  | .false => match strEq k "p" with
  | .true => .gptr
  | .false => .gint
def kindCType (gs : Globals) (k : String) : String := match strEq k "f" with
  | .true => "double"
  | .false => match strEq k "s" with
  | .true => "const char *"
  | .false => match strEq k "b" with
  | .true => "int"
  | .false => match strEq k "p" with
  | .true => "void *"
  | .false => match strEq k "w" with
  | .true => "wiz_val"
  | .false => match strEq k "v" with
  | .true => "void"
  | .false => match dropPrefix (strChars "S:") (strChars k) with
    | .some r => cstructCType (Globals.ffi gs) (String.mk r)
    | .none => "uint64_t"
def glueName (n : String) : String := "wiz_glue_" +++ String.mk (hexMangle (strChars n))
def filterGlue : List KN → List KN
  | .nil => .nil
  | .cons e rest => match Bool.or (strEq e.kind "e") (strEq e.kind "v") with
    | .true => filterGlue rest
    | .false => .cons e (filterGlue rest)
def pairNames : List KN → List String
  | .nil => .nil
  | .cons e rest => .cons e.name (pairNames rest)
def pairKinds : List KN → List String
  | .nil => .nil
  | .cons e rest => .cons e.kind (pairKinds rest)
def mapGlueParams : List KN → List NamedGTy
  | .nil => .nil
  | .cons e rest => .cons (NamedGTy.mk e.name (glueGtyOfKind e.kind)) (mapGlueParams rest)
def glueParamDecls (gs : Globals) (names : List String) (ks : List String) : String := match names, ks with
  | .cons n ns, .cons k ks1 =>
    let more := glueParamDecls gs ns ks1; if strEq more "" then (kindCType gs k +++ " " +++ n)
    else kindCType gs k +++ " " +++ n +++ ", " +++ more
  | _, _ => ""
def mapGlueKinds : List String → List GTy
  | .nil => .nil
  | .cons k rest => .cons (glueGtyOfKind k) (mapGlueKinds rest)
def glueFuncs (ffi : List Foreign) : List Callable := match ffi with
  | .nil => .nil
  | .cons f rest => match f with
    | .cfunc n ps r => .cons (Callable.mk n (mapGlueKinds ps) (glueGtyOfKind r)) (glueFuncs rest)
    | _ => glueFuncs rest
def glueDeclFields : List String → List String → List NamedGTy
  | .cons n ns, .cons k ks => .cons (NamedGTy.mk n (glueGtyOfKind k)) (glueDeclFields ns ks)
  | _, _ => .nil
def glueStructDecls (ffi : List Foreign) : List StructDef := match ffi with
  | .nil => .nil
  | .cons f rest => match f with
    | .cstruct n c _ fns ks => .cons (StructDef.mk n (glueDeclFields fns ks)) (.cons (StructDef.mk c (glueDeclFields fns ks)) (glueStructDecls rest))
    | _ => glueStructDecls rest
def glueCmd (gs : Globals) (stx : Syntax) : Step :=
  let name := match kid stx 1 with
    | .ident n => n
    | _ => "_";
  let body := strValue (kid stx 6);
  let ax := mkNode "command.axiom" (.cons (.atom "axiom") (.cons (kid stx 1)
    (.cons (mkNull .nil) (.cons (kid stx 2) (one (mkNull (.cons (.atom ":") (one (kid stx 4)))))))));
  match sigType gs ax with
  | .err m => errStep gs m
  | .ok _ ty => match ffiSig (Globals.ffi gs) .false ty with
    | .bad => errStep gs "a glue function's arguments and result must be Nat, UInt64, Float64, String, Bool, Unit, a foreign type or a c_struct (the result may be in IO)"
    | .mk ks rk io fin =>
      let names := binders (kids (kid stx 2));
      let pairs := filterGlue (zipKinds ks (padNames names (lenL ks)));
      match gCheckGlue body (mapGlueParams pairs) (glueFuncs (Globals.ffi gs)) (glueGtyOfKind rk) (glueStructDecls (Globals.ffi gs)) with
      | .some m => errStep gs (String.append "glue: " m)
      | .none =>
        let cname := glueName name;
        let cparams := glueParamDecls gs (pairNames pairs) (pairKinds pairs);
        match Scope.lookup (Globals.scope gs) name with
        | .some _ => errStep gs (String.append "error: '" (String.append name "' has already been declared"))
        | .none =>
          let gs1 := Globals.add gs (.mk name .nil ty (.axiomC name ty) (.axiomC name ty) (dfltKinds (lenL ks)) .nil);
          let gs2 := Globals.addFFI gs1 (.code ("static " +++ kindCType gs rk +++ " " +++ cname +++ "(" +++
            (if strEq cparams "" then "void" else cparams) +++ ") {\n" +++ body +++ "\n}"));
          .mk "" (Globals.addFFI gs2 (.fn name cname "" ks rk io ""))
def preludeText : String := "inductive Nat where\n  | zero\n  | succ (n : Nat)\ninductive Bool where\n  | false\n  | true\ninductive List (A : Type) where\n  | nil\n  | cons (head : A) (tail : List A)\ninductive Option (A : Type) where\n  | none\n  | some (val : A)\nstructure Prod (A B : Type) where\n  fst : A\n  snd : B\nstructure Char where\n  code : Nat\nstructure String where\n  data : List Char\ndef Nat.add : Nat → Nat → Nat\n  | .zero, n => n\n  | .succ m, n => .succ (Nat.add m n)\ndef Nat.mul : Nat → Nat → Nat\n  | .zero, _ => .zero\n  | .succ m, n => Nat.add n (Nat.mul m n)\ndef Nat.pred : Nat → Nat\n  | .zero => .zero\n  | .succ n => n\ndef Nat.sub : Nat → Nat → Nat\n  | m, .zero => m\n  | m, .succ n => Nat.pred (Nat.sub m n)\ninfixl:65 \" + \" => Nat.add\ninfixl:65 \" - \" => Nat.sub\ninfixl:70 \" * \" => Nat.mul\ndef Nat.beq : Nat → Nat → Bool\n  | .zero, .zero => .true\n  | .succ m, .succ n => Nat.beq m n\n  | _, _ => .false\ndef Nat.blt : Nat → Nat → Bool\n  | _, .zero => .false\n  | .zero, .succ _ => .true\n  | .succ m, .succ n => Nat.blt m n\ndef Nat.lt : Nat → Nat → Bool\n  | _, .zero => .false\n  | .zero, .succ _ => .true\n  | .succ m, .succ n => Nat.lt m n\ndef Nat.le (m n : Nat) : Bool := Nat.lt m (.succ n)\ndef Nat.max (m n : Nat) : Nat := if Nat.lt m n then n else m\ndef Bool.not : Bool → Bool\n  | .true => .false\n  | .false => .true\ndef Bool.and : Bool → Bool → Bool\n  | .true, b => b\n  | .false, _ => .false\ndef Bool.or : Bool → Bool → Bool\n  | .true, _ => .true\n  | .false, b => b\ndef Nat.divGo : Nat → Nat → Nat → Nat\n  | .zero, _, _ => .zero\n  | .succ fuel, n, m => if Nat.lt n m then .zero else .succ (Nat.divGo fuel (Nat.sub n m) m)\ndef Nat.div (n m : Nat) : Nat := match m with\n  | .zero => .zero\n  | .succ _ => Nat.divGo n n m\ndef Nat.mod (n m : Nat) : Nat := Nat.sub n (Nat.mul m (Nat.div n m))\ninfixl:70 \" / \" => Nat.div\ndef Nat.pow : Nat → Nat → Nat\n  | _, .zero => .succ .zero\n  | b, .succ e => Nat.mul b (Nat.pow b e)\ndef Bool.xor : Bool → Bool → Bool\n  | .true, b => Bool.not b\n  | .false, b => b\ndef Nat.isOdd (n : Nat) : Bool := Nat.beq (Nat.mod n 2) 1\ndef Nat.bitwise (f : Bool → Bool → Bool) : Nat → Nat → Nat → Nat\n  | .zero, _, _ => .zero\n  | .succ fuel, a, b =>\n    let rest := Nat.mul 2 (Nat.bitwise f fuel (Nat.div a 2) (Nat.div b 2));\n    if f (Nat.isOdd a) (Nat.isOdd b) then .succ rest else rest\ndef Nat.land (a b : Nat) : Nat := Nat.bitwise Bool.and (Nat.add a b) a b\ndef Nat.lor (a b : Nat) : Nat := Nat.bitwise Bool.or (Nat.add a b) a b\ndef Nat.xor (a b : Nat) : Nat := Nat.bitwise Bool.xor (Nat.add a b) a b\ndef Nat.shiftLeft (a n : Nat) : Nat := Nat.mul a (Nat.pow 2 n)\ndef Nat.shiftRight (a n : Nat) : Nat := Nat.div a (Nat.pow 2 n)\ndef Nat.log2Go : Nat → Nat → Nat\n  | .zero, _ => .zero\n  | .succ fuel, n => if Nat.lt n 2 then .zero else .succ (Nat.log2Go fuel (Nat.div n 2))\ndef Nat.log2 (n : Nat) : Nat := Nat.log2Go n n\ndef Nat.testBit (n i : Nat) : Bool := Nat.isOdd (Nat.shiftRight n i)\ndef List.length {A : Type} : List A → Nat\n  | .nil => .zero\n  | .cons _ t => .succ (List.length t)\ndef List.append {A : Type} : List A → List A → List A\n  | .nil, ys => ys\n  | .cons x xs, ys => .cons x (List.append xs ys)\ninfixr:67 \" ++ \" => List.append\ndef List.map {A B : Type} (f : A → B) : List A → List B\n  | .nil => .nil\n  | .cons x xs => .cons (f x) (List.map f xs)\ndef String.append (a b : String) : String := .mk (List.append a.data b.data)\ndef String.length (s : String) : Nat := List.length s.data\ndef memo {A : Type} (f : Unit → A) : Unit → A := f\naxiom Array : Type → Type\naxiom Array.empty {A : Type} : Array A\naxiom Array.push {A : Type} (a : Array A) (x : A) : Array A\naxiom Array.size {A : Type} (a : Array A) : Nat\naxiom Array.getD {A : Type} (a : Array A) (i : Nat) (d : A) : A\naxiom Array.set {A : Type} (a : Array A) (i : Nat) (x : A) : Array A\naxiom World : Type\ndef IO (A : Type) : Type := World → Prod A World\ndef IO.pure {A : Type} (a : A) : IO A := fun w => .mk a w\ndef IO.bind {A B : Type} (x : IO A) (f : A → IO B) : IO B := fun w =>\n  let r := x w;\n  f r.fst r.snd\naxiom IO.println : String → IO Unit\naxiom IO.print : String → IO Unit\naxiom IO.ePrintln : String → IO Unit\naxiom Process.exit : Nat → IO Unit\naxiom IO.readFile : String → IO String\naxiom IO.argCount : IO Nat\naxiom IO.arg : Nat → IO String\ndef IO.argsFrom : Nat → Nat → IO (List String)\n  | .zero, _ => IO.pure .nil\n  | .succ k, i => IO.bind (IO.arg i) (fun a => IO.bind (IO.argsFrom k (Nat.succ i)) (fun rest => IO.pure (List.cons a rest)))\ndef IO.args : IO (List String) := IO.bind IO.argCount (fun n => IO.argsFrom n 0)\ndef Callback (T : Type) : Type := T\naxiom Nat.toString : Nat → String\naxiom UInt64 : Type\nextern \"wiz_u64_id\" UInt64.ofNat : Nat → UInt64\nextern \"wiz_u64_id\" UInt64.toNat : UInt64 → Nat\nextern \"wiz_u64_add\" UInt64.add : UInt64 → UInt64 → UInt64\nextern \"wiz_u64_sub\" UInt64.sub : UInt64 → UInt64 → UInt64\nextern \"wiz_u64_mul\" UInt64.mul : UInt64 → UInt64 → UInt64\nextern \"wiz_u64_div\" UInt64.div : UInt64 → UInt64 → UInt64\nextern \"wiz_u64_mod\" UInt64.mod : UInt64 → UInt64 → UInt64\nextern \"wiz_u64_lt\" UInt64.lt : UInt64 → UInt64 → Bool\nextern \"wiz_u64_eq\" UInt64.eq : UInt64 → UInt64 → Bool\naxiom Float64 : Type\nextern \"wiz_f64_of_nat\" Float64.ofNat : Nat → Float64\nextern \"wiz_f64_add\" Float64.add : Float64 → Float64 → Float64\nextern \"wiz_f64_sub\" Float64.sub : Float64 → Float64 → Float64\nextern \"wiz_f64_mul\" Float64.mul : Float64 → Float64 → Float64\nextern \"wiz_f64_div\" Float64.div : Float64 → Float64 → Float64\nextern \"wiz_f64_lt\" Float64.lt : Float64 → Float64 → Bool\nextern \"wiz_f64_show\" Float64.toString : Float64 → String\naxiom Str : Type\naxiom Str.ofString : String → Str\naxiom StrMap : Type → Type\naxiom StrMap.empty {V : Type} : StrMap V\naxiom StrMap.insert {V : Type} (m : StrMap V) (k : Str) (v : V) : StrMap V\naxiom StrMap.findD {V : Type} (m : StrMap V) (k : Str) (d : V) : V\naxiom StrMap.size {V : Type} (m : StrMap V) : Nat\ninductive SyntaxF : Bool → Type where\n  | missing : SyntaxF .true\n  | atom (val : String) : SyntaxF .true\n  | ident (val : String) : SyntaxF .true\n  | node (kind : String) (args : SyntaxF .false) : SyntaxF .true\n  | nil : SyntaxF .false\n  | cons (head : SyntaxF .true) (tail : SyntaxF .false) : SyntaxF .false\ndef Syntax : Type := SyntaxF .true\ndef SyntaxF.nth {b : Bool} : SyntaxF b → Nat → Syntax\n  | .cons x t, n => match n with\n    | .zero => x\n    | .succ m => SyntaxF.nth t m\n  | _, _ => .missing\ndef Syntax.getArg (stx : Syntax) (i : Nat) : Syntax := match stx with\n  | .node _ args => SyntaxF.nth args i\n  | _ => .missing\n"

-- Notation and macros (stage 19b; A12). `notation`, `infixl`/`infixr`/`infix`, `syntax`
-- and `macro_rules` all become parser-table changes and *macro rules*: a pattern tree, a
-- template, and the argument names `notation` binds. A rule rewrites a node of its kind
-- before the node is elaborated: the pattern's children bind `$x` antiquotations (and a
-- `notation`'s arguments), and the template is instantiated with them. This is the Lean
-- host's `notationRule`/`expandMacroRule?` (`Wiz/Elab/{Command,Macro}.lean`) applied to
-- the same node kinds, so both frontends produce the same terms.
--
-- Hygiene: an identifier the template introduces gets a fresh scope, `x✝N`. A local
-- variable only matches the same spelling, so a template's binders can't capture the
-- user's; globals are found with the scope stripped (`stripScope`), so a template can
-- still refer to `Nat.add`. (The host suffixes every plain identifier of a template;
-- `Scope.lookupV` here falls back to the stripped name for the same effect.)
inductive Note where
  | mk (kind : String) (pat : Syntax) (tmpl : Syntax) (vars : List String)
def noteKind : Note → String
  | .mk k _ _ _ => k
-- a pattern variable's binding
inductive MBind where
  | mk (name : String) (s : Syntax)
def containsStr : List String → String → Bool
  | .nil, _ => .false
  | .cons y ys, x => match strEq x y with
    | .true => .true
    | .false => containsStr ys x
def lookupBind : List MBind → String → Option Syntax
  | .nil, _ => .none
  | .cons (.mk y v) rest, x => match strEq x y with
    | .true => .some v
    | .false => lookupBind rest x
-- `$x` (the quotation parser's `antiquot` node)
def antiquotName (s : Syntax) : Option String := match s with
  | .node k _ => match strEq k "antiquot" with
    | .true => match kid s 1 with
      | .ident n => .some n
      | _ => .none
    | .false => .none
  | _ => .none
-- the pattern matches a node structurally; `$x` binds a whole subtree
mutual
partial def matchPat (pat stx : Syntax) (acc : List MBind) : Option (List MBind) :=
  match antiquotName pat with
  | .some x => .some (.cons (.mk x stx) acc)
  | .none => match pat with
    | .node k as => match stx with
      | .node k2 bs => match Bool.and (strEq k k2) (Nat.beq (List.length (argsOf as)) (List.length (argsOf bs))) with
        | .true => matchPatArgs (argsOf as) (argsOf bs) acc
        | .false => .none
      | _ => .none
    | .atom v => match stx with
      | .atom v2 => match strEq v v2 with
        | .true => .some acc
        | .false => .none
      | _ => .none
    | .ident n => match stx with
      | .ident n2 => match strEq n n2 with
        | .true => .some acc
        | .false => .none
      | _ => .none
    | .missing => match stx with
      | .missing => .some acc
      | _ => .none
    | _ => .none
partial def matchPatArgs : List Syntax → List Syntax → List MBind → Option (List MBind)
  | .nil, .nil, acc => .some acc
  | .cons p ps, .cons s ss, acc => match matchPat p s acc with
    | .some acc1 => matchPatArgs ps ss acc1
    | .none => .none
  | _, _, _ => .none
end
def scopeName (n : String) (scope : Nat) : String := n +++ "✝" +++ Nat.toString scope
def hasDotChar : List Char → Bool
  | .nil => .false
  | .cons c cs => match Nat.beq (Char.code c) 46 with
    | .true => .true
    | .false => hasDotChar cs
def hasDot (s : String) : Bool := match s with
  | .mk cs => hasDotChar cs
-- node kinds whose identifiers are not references (the host's `unscopedParents`)
def unscopedParent (k : String) : Bool := Bool.or (Bool.or (strEq k "term.dotIdent") (strEq k "term.field"))
  (Bool.or (strEq k "level.param") (strEq k "term.syntheticHole"))
mutual
partial def instTmpl (binds : List MBind) (vars : List String) (scope : Nat) (parent : String) (t : Syntax) : Syntax :=
  match antiquotName t with
  | .some x => match lookupBind binds x with
    | .some v => v
    | .none => t
  | .none => match t with
    | .node k as => match strEq k "term.ident" with
      | .true => match kid t 0 with
        | .ident n => match containsStr vars n with
          | .true => match lookupBind binds n with
            | .some v => v
            | .none => t
          | .false => .node k (toArgs (one (instTmpl binds vars scope "term.ident" (kid t 0))))
        | _ => .node k (instTmplArgs binds vars scope k as)
      | .false => .node k (instTmplArgs binds vars scope k as)
    | .ident n => match containsStr vars n with
      | .true => match lookupBind binds n with
        | .some v => v
        | .none => t
      | .false => match Bool.or (unscopedParent parent) (hasDot n) with
        | .true => t
        | .false => .ident (scopeName n scope)
    | s => s
partial def instTmplArgs (binds : List MBind) (vars : List String) (scope : Nat) (parent : String) : SyntaxF .false → SyntaxF .false
  | .nil => .nil
  | .cons s rest => .cons (instTmpl binds vars scope parent s) (instTmplArgs binds vars scope parent rest)
end
-- the latest rule of `notes` whose kind and pattern match, and its expansion
inductive ERule where
  | mk (s : Syntax) (n : Note)
def expandRule (notes : List Note) (stx : Syntax) (scope : Nat) : Option ERule :=
  match notes with
  | .nil => .none
  | .cons n rest => match strEq (noteKind n) (kindOf stx) with
    | .false => expandRule rest stx scope
    | .true => match n with
      | .mk _ pat tmpl vars => match matchPat pat stx .nil with
        | .some binds => .some (ERule.mk (instTmpl binds vars scope "" tmpl) n)
        | .none => expandRule rest stx scope
-- `do` (stage 19c, for `IO` only: there are no type classes): `do x ← e; rest` is
-- `IO.bind e (fun x => do rest)`, `do e; rest` is `IO.bind e (fun _ => do rest)`,
-- `do let x := v; rest` is `IO.bind (IO.pure v) (fun x => do rest)`, `do e` is `e`
def identOf'' (s : Syntax) : String := match s with
  | .ident n => n
  | _ => "_"
def ioBind (e : Syntax) (x : String) (rest : Syntax) : Syntax :=
  mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident "IO.bind"))) (one (mkNull (.cons e
    (one (mkNode "term.fun" (.cons (.atom "fun") (.cons (mkNull (one (.ident x))) (.cons (.atom "=>") (one rest))))))))))
partial def expandDo (s : Syntax) : Syntax :=
  let k := kindOf s;
  match strEq k "doSeq.bind" with
  | .true => ioBind (kid s 2) (identOf'' (kid s 0)) (expandDo (kid s 4))
  | .false => match strEq k "doSeq.seq" with
    | .true => ioBind (kid s 0) "_" (expandDo (kid s 2))
    | .false => match strEq k "doSeq.let" with
      | .true => ioBind (mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident "IO.pure"))) (one (mkNull (one (kid s 3))))))
          (identOf'' (kid s 1)) (expandDo (kid s 5))
      | .false => kid s 0
-- rewrite `s` while a rule matches it (a template may introduce a rule head); `fuel`
-- only bounds a rewrite loop at one position, so restructuring a subtree never runs out
partial def expandTop (notes : List Note) (fuel : Nat) (scope : Nat) (s : Syntax) : Syntax :=
  match fuel with
  | .zero => s
  | .succ f => match expandRule notes s scope with
    | .some (.mk s' _) => expandTop notes f (scope + 1) s'
    | .none => s
-- expand every node, outermost first; each node is rewritten to a fixed point, then its
-- children are expanded (so a spliced argument is expanded like any other node)
mutual
partial def expandNotes (notes : List Note) (scope : Nat) (s : Syntax) : Syntax :=
  match s with
  | .node k args => match expandTop notes 64 scope s with
    | .node k2 args2 =>
      let s' : Syntax := .node k2 (expandNotesArgs notes (scope + 1) args2);
      match strEq k2 "term.do" with
      | .true => expandDo (kid s' 1)
      | .false => match strEq k2 "term.boolAnd" with
        -- `a && b` and `a || b` are the short-circuiting `if`s the host's macros make
        | .true => iteMatch (kid s' 0) (kid s' 2) (boolVal "false")
        | .false => match strEq k2 "term.boolOr" with
          | .true => iteMatch (kid s' 0) (boolVal "true") (kid s' 2)
          | .false => match strEq k2 "term.!" with
            | .true => mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident "Bool.not")))
                (one (mkNull (one (kid s' 1)))))
            | .false => s'
    | other => other
  | _ => s
partial def expandNotesArgs (notes : List Note) (scope : Nat) : SyntaxF .false → SyntaxF .false
  | .nil => .nil
  | .cons s rest => .cons (expandNotes notes scope s) (expandNotesArgs notes scope rest)
end
def dropSp : List Char → List Char
  | .nil => .nil
  | .cons c rest => match Nat.beq (Char.code c) 32 with
    | .true => dropSp rest
    | .false => .cons c rest
def trimStr (s : String) : String := match s with
  | .mk cs => .mk (List.reverseOf (dropSp (List.reverseOf (dropSp cs) .nil)) .nil)
def declareCat (c : String) : List Cat → List Cat
  | .nil => .cons (.mk c .nil .nil) .nil
  | .cons (.mk n ls ts) rest => match strEq n c with
    | .true => .cons (.mk n ls ts) rest
    | .false => .cons (.mk n ls ts) (declareCat c rest)
def leadingKinds : List Leading → List String
  | .nil => .nil
  | .cons (.mk k _ _ _) rest => .cons k (leadingKinds rest)
def trailingKinds : List Trailing → List String
  | .nil => .nil
  | .cons (.mk k _ _ _ _) rest => .cons k (trailingKinds rest)
def catKinds : List Cat → List String
  | .nil => .nil
  | .cons (.mk _ ls ts) rest => List.append (leadingKinds ls) (List.append (trailingKinds ts) (catKinds rest))
-- the host's `mkKindName`: a fresh kind from the category and the rule's atoms
partial def freshKind (cats : List Cat) (base : String) (i : Nat) (fuel : Nat) : String :=
  let n := base +++ "_" +++ Nat.toString i;
  match fuel with
  | .zero => n
  | .succ f => match containsStr (catKinds cats) n with
    | .true => freshKind cats base (i + 1) f
    | .false => n
def pdTokens : PD → List String
  | .atom t => .cons t .nil
  -- (the host's `ParserDescr.tokens`: a non-reserved keyword is an identifier, so it is
  -- not added to the token table)
  | .nonReserved _ => .nil
  | .ident => .nil
  | .num => .nil
  | .str => .nil
  | .cat _ _ => .nil
  | .empty => .nil
  | .seq p q => List.append (pdTokens p) (pdTokens q)
  | .many p => pdTokens p
  | .many1 p => pdTokens p
  | .optional p => pdTokens p
  | .sepBy p s _ => .cons s (pdTokens p)
  | .sepBy1 p s _ => .cons s (pdTokens p)
  | .orelse p q => List.append (pdTokens p) (pdTokens q)
  | .node _ p => pdTokens p
  | .withPosition p => pdTokens p
  | .withoutPosition p => pdTokens p
  | .colGt => .nil
  | .colGe => .nil
  | .noWs => .nil
  | .checkPrec _ => .nil
def mkKindName (cats : List Cat) (cat : String) (p : PD) : String :=
  let toks := pdTokens p;
  let base := cat +++ "." +++ (match toks with
    | .nil => "syntax"
    | .cons _ _ => joinUnder toks);
  match containsStr (catKinds cats) base with
  | .false => base
  | .true => freshKind cats base 1 (List.length (catKinds cats) + 1)
def isWordStart (c : Nat) : Bool := Bool.or (Bool.and (Nat.le 65 c) (Nat.le c 90))
  (Bool.or (Bool.and (Nat.le 97 c) (Nat.le c 122)) (Nat.beq c 95))
def isWordChar (c : Nat) : Bool := Bool.or (isWordStart c) (Bool.and (Nat.le 48 c) (Nat.le c 57))
def allWordChars : List Char → Bool
  | .nil => .true
  | .cons c cs => match isWordChar (Char.code c) with
    | .true => allWordChars cs
    | .false => .false
-- a keyword spelled like an identifier is not reserved outside `term`/`command`
def identLike (t : String) : Bool := match t with
  | .mk cs => match cs with
    | .nil => .false
    | .cons c rest => match isWordStart (Char.code c) with
      | .true => allWordChars rest
      | .false => .false
def pdUnreserve : PD → PD
  | .atom t => match identLike t with
    | .true => .nonReserved t
    | .false => .atom t
  | .nonReserved t => .nonReserved t
  | .ident => .ident
  | .num => .num
  | .str => .str
  | .cat c p => .cat c p
  | .empty => .empty
  | .seq p q => .seq (pdUnreserve p) (pdUnreserve q)
  | .many p => .many (pdUnreserve p)
  | .many1 p => .many1 (pdUnreserve p)
  | .optional p => .optional (pdUnreserve p)
  | .sepBy p s tr => .sepBy (pdUnreserve p) s tr
  | .sepBy1 p s tr => .sepBy1 (pdUnreserve p) s tr
  | .orelse p q => .orelse (pdUnreserve p) (pdUnreserve q)
  | .node k p => .node k (pdUnreserve p)
  | .withPosition p => .withPosition (pdUnreserve p)
  | .withoutPosition p => .withoutPosition (pdUnreserve p)
  | .colGt => .colGt
  | .colGe => .colGe
  | .noWs => .noWs
  | .checkPrec p => .checkPrec p
def reservesKeywords (c : String) : Bool := Bool.or (strEq c "term") (strEq c "command")
def addTokenL (tokens : List String) (t : String) : List String := match containsStr tokens t with
  | .true => tokens
  | .false => List.append tokens (.cons t .nil)
partial def addTokensL (tokens : List String) : List String → List String
  | .nil => tokens
  | .cons t ts => addTokensL (addTokenL tokens t) ts
-- the tokens of a rule, unreserved outside `term`/`command`
def addTokensPD (tokens : List String) (cat : String) (p : PD) : List String :=
  addTokensL tokens (pdTokens (match reservesKeywords cat with
    | .true => p
    | .false => pdUnreserve p))
def addLeadingU (cat : String) (l : Leading) : List Cat → List Cat :=
  match l with
  | .mk k pr prio p => addLeadingTo cat (.mk k pr prio (match reservesKeywords cat with
      | .true => p
      | .false => pdUnreserve p))
def addTrailingU (cat : String) (t : Trailing) : List Cat → List Cat :=
  match t with
  | .mk k pr lp prio p => addTrailingTo cat (.mk k pr lp prio (match reservesKeywords cat with
      | .true => p
      | .false => pdUnreserve p))
-- `$x` inside a category (an antiquotation), and the quotation `` `(c| …) ``
def addMetaParsers (c : String) (cats : List Cat) : List Cat :=
  let plain : PD := .seq (.atom "$") (.seq .noWs .ident);
  let annotated : PD := .seq (.atom "$") (.seq .noWs (.seq .ident (.seq .noWs (.seq (.atom ":") (.seq .noWs (.nonReserved c))))));
  let cats := addLeadingU c (.mk "antiquot" 1024 1000 plain) cats;
  let cats := addLeadingU c (.mk "antiquot" 1024 1000 annotated) cats;
  addLeadingU "term" (.mk ("quote." +++ c) 1024 0
    (.seq (.atom "`(") (.seq (.nonReserved c) (.seq (.atom "|") (.seq (.withoutPosition (.cat c 0)) (.atom ")")))))) cats
-- `prec := num | max | arg | lead | min`
def precName (n : String) : Option Nat := match strEq n "max" with
  | .true => .some 1024
  | .false => match strEq n "arg" with
    | .true => .some 1023
    | .false => match strEq n "lead" with
      | .true => .some 1022
      | .false => match strEq n "min" with
        | .true => .some 10
        | .false => .none
def precValue (s : Syntax) : Option Nat := match kid s 0 with
  | .ident n => precName n
  | _ => .some (numValue s)
def seqOf : List PD → PD
  | .nil => .empty
  | .cons p rest => match rest with
    | .nil => p
    | .cons _ _ => .seq p (seqOf rest)
-- the `stx` item grammar (`Wiz/Parser/SyntaxCmd.lean`'s `stxToDescr`)
inductive SR where
  | ok (p : PD)
  | err (msg : String)
inductive SRs where
  | ok (ps : List PD)
  | err (msg : String)
mutual
partial def stxToDescr (cats : List Cat) (s : Syntax) : SR :=
  let k := kindOf s;
  match strEq k "stx.atom" with
  | .true => .ok (.atom (trimStr (strValue (kid s 0))))
  | .false => match strEq k "stx.cat" with
    | .true => match kid s 0 with
      | .ident c => let pr := match isNilS (kids (kid s 1)) with
          | .true => 0
          | .false => match precValue (kid (kid s 1) 1) with
            | .some q => q
            | .none => 0;
        match strEq c "ident" with
          | .true => .ok .ident
          | .false => match strEq c "num" with
            | .true => .ok .num
            | .false => match strEq c "str" with
              | .true => .ok .str
              | .false => match strEq c "colGt" with
                | .true => .ok .colGt
                | .false => match strEq c "colGe" with
                  | .true => .ok .colGe
                  | .false => match strEq c "noWs" with
                    | .true => .ok .noWs
                    | .false => match findCat cats c with
                      | .none => .err ("unknown syntax category " +++ c)
                      | .some _ => .ok (.cat c pr)
      | _ => .err "malformed stx.cat"
    | .false => match strEq k "stx.group" with
      | .true => match stxItems cats (kids (kid s 1)) with
        | .err e => .err e
        | .ok ps => .ok (seqOf ps)
      | .false => match strEq k "stx.sepBy" with
        | .true => stxSep cats s .false
        | .false => match strEq k "stx.sepBy1" with
          | .true => stxSep cats s .true
          | .false => match strEq k "stx.withPosition" with
            | .true => match stxItems cats (kids (kid s 2)) with
              | .err e => .err e
              | .ok ps => .ok (.withPosition (seqOf ps))
            | .false => match strEq k "stx.many" with
              | .true => match stxToDescr cats (kid s 0) with
                | .ok p => .ok (.many p)
                | .err e => .err e
              | .false => match strEq k "stx.many1" with
                | .true => match stxToDescr cats (kid s 0) with
                  | .ok p => .ok (.many1 p)
                  | .err e => .err e
                | .false => match strEq k "stx.optional" with
                  | .true => match stxToDescr cats (kid s 0) with
                    | .ok p => .ok (.optional p)
                    | .err e => .err e
                  | .false => .err ("unexpected syntax item of kind " +++ k)
partial def stxItems (cats : List Cat) : List Syntax → SRs
  | .nil => .ok .nil
  | .cons s rest => match stxToDescr cats s with
    | .err e => .err e
    | .ok p => match stxItems cats rest with
      | .err e => .err e
      | .ok ps => .ok (.cons p ps)
partial def stxSep (cats : List Cat) (s : Syntax) (one1 : Bool) : SR :=
  match stxItems cats (kids (kid s 2)) with
  | .err e => .err e
  | .ok ps => match one1 with
    | .true => .ok (.sepBy1 (seqOf ps) (trimStr (strValue (kid s 4))) (Bool.not (isNilS (kids (kid s 5)))))
    | .false => .ok (.sepBy (seqOf ps) (trimStr (strValue (kid s 4))) (Bool.not (isNilS (kids (kid s 5)))))
end
-- a `notation` item: an atom, or an argument with an optional precedence
inductive NItem where
  | atom (s : String)
  | arg (v : String) (p : Option Nat)
inductive NRes where
  | ok (items : List NItem)
  | err (msg : String)
def nItemDescr : NItem → PD
  | .atom s => .atom (trimStr s)
  | .arg _ p => .cat "term" (match p with
    | .none => 0
    | .some q => q)
def nItemPat : NItem → Syntax
  | .atom s => .atom (trimStr s)
  | .arg v _ => mkNode "antiquot" (.cons (.atom "$") (one (.ident v)))
def nItemVars : List NItem → List String
  | .nil => .nil
  | .cons (.atom _) rest => nItemVars rest
  | .cons (.arg v _) rest => .cons v (nItemVars rest)
def nItemDescrAll : List NItem → List PD
  | .nil => .nil
  | .cons it rest => .cons (nItemDescr it) (nItemDescrAll rest)
def nItemPatAll : List NItem → List Syntax
  | .nil => .nil
  | .cons it rest => .cons (nItemPat it) (nItemPatAll rest)
partial def notationItems : List Syntax → NRes
  | .nil => .ok .nil
  | .cons it rest => match kid it 0 with
    | .ident n => match isNilS (kids (kid it 1)) with
      | .true => match notationItems rest with
        | .err e => .err e
        | .ok its => .ok (.cons (.arg n .none) its)
      | .false => match precValue (kid (kid it 1) 1) with
        | .none => .err "invalid precedence"
        | .some q => match notationItems rest with
          | .err e => .err e
          | .ok its => .ok (.cons (.arg n (.some q)) its)
    | .node sk _ => match strEq sk "str" with
      | .true => match notationItems rest with
        | .err e => .err e
        | .ok its => .ok (.cons (.atom (strValue it)) its)
      | .false => match notationItems rest with
        | .err e => .err e
        | .ok its => .ok (.cons (.arg "_" .none) its)
    | _ => match notationItems rest with
      | .err e => .err e
      | .ok its => .ok (.cons (.arg "_" .none) its)
-- a table-changing command's result (`tabStep`): the tables, the rules it adds, and an
-- error (which drops its changes, as the host does)
inductive Tab0 where
  | mk (cats : List Cat) (tokens : List String) (notes : List Note) (err : Option String)
-- the `notation` command (`Wiz/Elab/Command.lean`'s `notationRule`)
def notationCmd (cats : List Cat) (tokens : List String) (cmd : Syntax) : Tab0 :=
  match (match isNilS (kids (kid cmd 1)) with
      | .true => .some 1024
      | .false => precValue (kid (kid cmd 1) 1)) with
  | .none => .mk cats tokens .nil (.some "invalid precedence")
  | .some pr => match notationItems (kids (kid cmd 2)) with
    | .err e => .mk cats tokens .nil (.some e)
    | .ok items => match items with
      | .nil => .mk cats tokens .nil (.some "empty notation")
      | .cons first rest => match first with
        -- (the host's `notationRule`: a *first item that is an argument* is the rule's
        -- left-hand side, so the rule is trailing; its precedence is the item's, else
        -- the notation's. `notation:max P:max " !" => fac P` is postfix `P !`.)
        | .arg _ lpOpt =>
          let lhsPrec := match lpOpt with
            | .none => pr
            | .some q => q;
          let pdesc := seqOf (nItemDescrAll rest);
          let kind := mkKindName cats "term" pdesc;
          let note := Note.mk kind (mkNode kind (nItemPatAll items)) (kid cmd 4) (nItemVars items);
          .mk (addTrailingU "term" (.mk kind pr lhsPrec 0 pdesc) cats) (addTokensPD tokens "term" pdesc) (.cons note .nil) .none
        | _ =>
          let pdesc := seqOf (nItemDescrAll items);
          let kind := mkKindName cats "term" pdesc;
          let note := Note.mk kind (mkNode kind (nItemPatAll items)) (kid cmd 4) (nItemVars items);
          .mk (addLeadingU "term" (.mk kind pr 0 pdesc) cats) (addTokensPD tokens "term" pdesc) (.cons note .nil) .none
-- the `syntax` command (`Wiz/Parser/SyntaxCmd.lean`'s `addSyntax`)
def addSyntaxCmd (cats : List Cat) (tokens : List String) (cmd : Syntax) : Tab0 :=
  match kid cmd 6 with
  | .ident cat => match findCat cats cat with
    | .none => .mk cats tokens .nil (.some ("unknown syntax category " +++ cat))
    | .some _ => match (match isNilS (kids (kid cmd 1)) with
        | .true => .some 1024
        | .false => precValue (kid (kid cmd 1) 1)) with
      | .none => .mk cats tokens .nil (.some "invalid precedence")
      | .some pr => match kids (kid cmd 4) with
        | .nil => .mk cats tokens .nil (.some "empty syntax rule")
        | .cons first rawRest =>
          let isTrailing : Bool := match kid first 0 with
            | .ident c => strEq c cat
            | _ => .false;
          let rawItems : List Syntax := match isTrailing with
            | .true => rawRest
            | .false => kids (kid cmd 4);
          match stxItems cats rawItems with
          | .err e => .mk cats tokens .nil (.some e)
          | .ok ps =>
            let p := seqOf ps;
            let nameOpt : Syntax := match kid cmd 2 with
              | .node _ _ => kid (kid cmd 2) 3
              | _ => .missing;
            let prio := match kid cmd 3 with
              | .node _ _ => numValue (kid (kid cmd 3) 3)
              | _ => 0;
            let kind := match nameOpt with
              | .ident n => cat +++ "." +++ n
              | _ => mkKindName cats cat p;
            match isTrailing with
            | .true => let lp := match isNilS (kids (kid first 1)) with
                | .true => 0
                | .false => match precValue (kid (kid first 1) 1) with
                  | .some q => q
                  | .none => 0;
              .mk (addTrailingU cat (.mk kind pr lp prio p) cats) (addTokensPD tokens cat p) .nil .none
            | .false => .mk (addLeadingU cat (.mk kind pr prio p) cats) (addTokensPD tokens cat p) .nil .none
  | _ => .mk cats tokens .nil (.some "malformed syntax command")
-- `macro_rules | `(c| pattern) => `(c| template)` (the host's `command.macroRules`): one
-- rule per alternative, the latest first
inductive QP where
  | mk (pat tmpl : Syntax)
inductive QPRes where
  | ok (q : QP)
  | err (msg : String)
def strPrefix (p s : String) : Bool := match p with
  | .mk pc => match s with
    | .mk sc => match matchPrefix pc sc with
      | .some _ => .true
      | .none => .false
def quoteIs (s : Syntax) : Bool := strPrefix "quote." (kindOf s)
def quoteBody (lhs rhs : Syntax) : QPRes := match quoteIs lhs with
  | .false => .err "a macro rule is `| `(cat| pattern) => `(cat| template)`"
  | .true => match quoteIs rhs with
    | .false => .err "a macro rule is `| `(cat| pattern) => `(cat| template)`"
    | .true => .ok (.mk (kid lhs 3) (kid rhs 3))
inductive NRes0 where
  | ok (notes : List Note)
  | err (msg : String)
def macroRuleNotes : List Syntax → List Note → NRes0
  | .nil, acc => .ok acc
  | .cons alt rest, acc => match kids (kid alt 1) with
    | .cons lhs .nil => match quoteBody lhs (kid alt 3) with
      | .err e => .err e
      | .ok (.mk pat tmpl) => macroRuleNotes rest (.cons (Note.mk (kindOf pat) pat tmpl .nil) acc)
    | _ => .err "a macro rule is `| `(cat| pattern) => `(cat| template)`"
def macroRulesCmd (cats : List Cat) (tokens : List String) (stx : Syntax) : Tab0 :=
  match macroRuleNotes (kids (kid stx 1)) .nil with
  | .err e => .mk cats tokens .nil (.some e)
  | .ok notes => .mk cats tokens notes .none
-- the `infixl:p " op " => f` command (also `infixr`, `infix`): a trailing `a op b` whose
-- operands are at `p`/`p + 1` (`infixl`), `p + 1`/`p` (`infixr`), or both `p + 1`
def infixCmd (cats : List Cat) (tokens : List String) (stx : Syntax) : Tab0 :=
  let kw := match kid stx 0 with
    | .atom v => v
    | _ => "infix";
  let p := numValue (kid stx 2);
  let op := trimStr (strValue (kid stx 3));
  let lp := match strEq kw "infixl" with
    | .true => p
    | .false => p + 1;
  let rp := match strEq kw "infixr" with
    | .true => p
    | .false => p + 1;
  let kind := mkKindName cats "term" (.seq (.atom op) (.cat "term" rp));
  let pat := mkNode kind (.cons (mkNode "antiquot" (.cons (.atom "$") (one (.ident "a"))))
    (.cons (.atom op) (one (mkNode "antiquot" (.cons (.atom "$") (one (.ident "b")))))));
  let tmpl := mkNode "term.app" (.cons (kid stx 5) (one (mkNull (.cons (mkNode "term.ident" (one (.ident "a")))
    (one (mkNode "term.ident" (one (.ident "b"))))))));
  .mk (addTrailingU "term" (.mk kind p lp 0 (.seq (.atom op) (.cat "term" rp))) cats) (addTokenL tokens op)
    (.cons (Note.mk kind pat tmpl (.cons "a" (.cons "b" .nil))) .nil) .none
-- a declaration name exists (the `[macro]`/`[tactic]` registrations check their function;
-- its body is not run: see the A12 note in docs/stages/21-bootstrap.md)
def declExists (gs : Globals) (f : String) : Bool := match Scope.lookup (Globals.scope gs) f with
  | .some _ => .true
  | .none => .false
def declareSyntaxCmd (cats : List Cat) (tokens : List String) (stx : Syntax) : Tab0 := match kid stx 1 with
  | .ident c => match findCat cats c with
    | .some _ => .mk cats tokens .nil .none
    | .none => .mk (addMetaParsers c (declareCat c cats)) tokens .nil .none
  | _ => .mk cats tokens .nil (.some "malformed declare_syntax_cat")
def attrRegCmd (gs : Globals) (cats : List Cat) (tokens : List String) (stx : Syntax) : Tab0 :=
  match kid stx 5 with
  | .ident f => match declExists gs f with
    | .true => .mk cats tokens .nil .none
    | .false => .mk cats tokens .nil (.some ("unknown declaration " +++ f))
  | _ => .mk cats tokens .nil (.some "an attribute needs a name")
def setOptionCmd (cats : List Cat) (tokens : List String) (stx : Syntax) : Tab0 :=
  match kid stx 1 with
  | .ident o => match Bool.or (strEq o "pp.notation") (strEq o "pp.all") with
    | .true => .mk cats tokens .nil .none
    | .false => .mk cats tokens .nil (.some ("unknown option " +++ o))
  | _ => .mk cats tokens .nil (.some "a set_option needs an option name")
def unwrapLocal (s : Syntax) : Syntax := match strEq (kindOf s) "command.local" with
  | .true => kid s 1
  | .false => s
-- the grammar-changing commands (`Wiz/Frontend/Parse.lean`'s `updateTables`) plus the
-- registrations, whose expansion functions the self-hosted frontend checks but cannot run
def tabStep (gs : Globals) (cats : List Cat) (tokens : List String) (stx : Syntax) : Option Tab0 :=
  let k := kindOf stx;
  match strEq k "command.infix" with
  | .true => .some (infixCmd cats tokens stx)
  | .false => match strEq k "command.notation" with
    | .true => .some (notationCmd cats tokens stx)
    | .false => match strEq k "command.syntax" with
      | .true => .some (addSyntaxCmd cats tokens stx)
      | .false => match strEq k "command.declareSyntaxCat" with
        | .true => .some (declareSyntaxCmd cats tokens stx)
        | .false => match strEq k "command.macroRules" with
          | .true => .some (macroRulesCmd cats tokens stx)
          | .false => match strEq k "command.attrMacro" with
            | .true => .some (attrRegCmd gs cats tokens stx)
            | .false => match strEq k "command.attrTactic" with
              | .true => .some (attrRegCmd gs cats tokens stx)
              | .false => match strEq k "command.appUnexpander" with
                | .true => .some (.mk cats tokens .nil .none)
                | .false => match strEq k "command.attrUnexpander" with
                  | .true => .some (.mk cats tokens .nil .none)
                  | .false => match strEq k "command.setOption" with
                    | .true => .some (setOptionCmd cats tokens stx)
                    | .false => .none
-- the `do` grammar: a category `doSeq`, and `do doSeq` a term
def thenRest (p : PD) : PD := .seq p (.seq (.atom ";") (.cat "doSeq" 0))
def doCats (cats : List Cat) : List Cat :=
  addLeadingTo "term" (.mk "term.do" 1024 0 (.seq (.atom "do") (.cat "doSeq" 0)))
    (List.append cats (.cons (.mk "doSeq" (.cons (.mk "doSeq.last" 1024 0 (.cat "term" 0))
      (.cons (.mk "doSeq.bind" 1024 0 (.seq .ident (.seq (.atom "←") (thenRest (.cat "term" 0)))))
      (.cons (.mk "doSeq.seq" 1024 0 (thenRest (.cat "term" 0)))
      (.cons (.mk "doSeq.let" 1024 0 (.seq (.atom "let") (.seq .ident (.seq (.atom ":=") (thenRest (.cat "term" 0)))))) .nil)))) .nil) .nil))
-- (stage 21n) a `private` command is the command (one module: see `stepCommand`)
def unwrapPrivate (s : Syntax) : Syntax := match strEq (kindOf s) "command.private" with
  | .true => kid s 1
  | .false => s
-- (A11) the deriver table. `attribute [deriver C] f` records `f` as `C`'s deriver
-- (`CommandState.derivers` in the host); `deriving C` runs the one the table names.
-- (`strPrefix`, `p` a prefix of `s`, is defined with the macro rules above)
-- a deriver's name without the `Derive.` namespace (the derivers may be imported under
-- it): `Derive.deriveBEq` and `deriveBEq` are the same deriver
def deriverBase (f : String) : String := match f with
  | .mk cs => match strPrefix "Derive." f with
    | .true => String.mk (dropL 7 cs)
    | .false => f
-- the deriver a name stands for: 1 `Inhabited`, 2 `BEq`, 3 `Repr`, 4 `DecidableEq`,
-- 5 `Compare` (the names `lib/Deriving.wiz` gives its derivers), 0 a deriver this
-- frontend cannot run
def deriverKind (f : String) : Nat := match strEq (deriverBase f) "deriveInhabited" with
  | .true => 1
  | .false => match strEq (deriverBase f) "deriveBEq" with
    | .true => 2
    | .false => match strEq (deriverBase f) "deriveRepr" with
      | .true => 3
      | .false => match strEq (deriverBase f) "deriveDecidableEq" with
        | .true => 4
        | .false => match strEq (deriverBase f) "deriveCompare" with
          | .true => 5
          | .false => 0
def isBuiltinDeriver (f : String) : Bool := match deriverKind f with
  | .zero => .false
  | _ => .true
-- a type's leading Πs (its parameters, and an index)
partial def piArity : Tm → Nat
  | .pi _ _ _ _ b => Nat.succ (piArity b)
  | _ => 0
-- a class's arity: the parameters of its type former
def classArity (gs : Globals) (C : String) : Nat := match globalTyOf gs C with
  | .some ty => piArity ty
  | .none => 0
-- (A11) `attribute [deriver C] f`: register `f` as `C`'s deriver, as the host's
-- `command.attrDeriver` does. A built-in deriver's name (`deriveBEq`, …) is the
-- frontend's own and needs no declaration; another `f` must be declared with one
-- argument (`String → MacroM (List Syntax)`), the arity the host checks by unifying its
-- type with `Deriver`. A declared `f` is recorded even though this frontend cannot run
-- it: `deriving C` reports that, with the command's position.
def deriverCmd (gs : Globals) (stx : Syntax) : LinkR :=
  let C := identOf' (kid stx 3);
  let f := identOf' (kid stx 5);
  match Scope.lookup (Globals.scope gs) f with
  | .none => match isBuiltinDeriver f with
    | .true => LinkR.mk .none (Globals.addDeriver gs C (deriverBase f))
    | .false => LinkR.mk (.some ("error: " +++ f +++ " is not a deriver: unknown declaration " +++ f)) gs
  | .some i => match globalTyOf gs f with
    | .none => LinkR.mk (.some ("error: " +++ f +++ " is not a deriver: unknown declaration " +++ f)) gs
    | .some ty => match piArity ty with
      | .succ (.zero) => LinkR.mk .none (Globals.addDeriver gs C f)
      | n => LinkR.mk (.some ("error: " +++ f +++ " is not a deriver: it takes " +++ Nat.toString n
          +++ " arguments, expected one (String → MacroM (List Syntax))")) gs
-- (stage 21u) `attribute [inline] f`: a hint to the Lean compiler, checked as the Lean
-- frontend does (`f` must have a definition); it changes nothing here
def attrStep (gs : Globals) (stx : Syntax) : Option LinkR := match strEq (kindOf stx) "command.attrInline" with
  | .true => .some (match kid stx 4 with
    | .ident f => match Scope.lookup (Globals.scope gs) f with
      | .none => LinkR.mk (.some (String.append "error: unknown declaration " f)) gs
      | .some i => match globalTm .false gs i with
        | .const _ _ _ v _ => match isAxiomTm v with
          | .false => LinkR.mk .none gs
          | .true => LinkR.mk (.some (String.append "error: " (String.append f " has no definition to inline"))) gs
        | _ => LinkR.mk (.some (String.append "error: " (String.append f " has no definition to inline"))) gs
    | _ => LinkR.mk (.some "error: attribute [inline] needs a name") gs)
  | .false => match strEq (kindOf stx) "command.attrDeriver" with
    | .true => .some (deriverCmd gs stx)
    | .false => .none
-- `link_c`, `link_lib`, `export` (stage 21o) and `implemented_by` (21t): no output line
-- unless an error
def linkStep (gs : Globals) (stx : Syntax) : Option LinkR := match strEq (kindOf stx) "command.linkC" with
  | .true => .some (linkCmd gs stx .false)
  | .false => match strEq (kindOf stx) "command.linkLib" with
    | .true => .some (linkCmd gs stx .true)
    | .false => match strEq (kindOf stx) "command.export" with
      | .true => .some (exportCmd gs stx)
      | .false => match strEq (kindOf stx) "command.attrImplementedBy" with
        | .true => .some (implementedByCmd gs stx)
        | .false => attrStep gs stx
-- (A11) `deriving`. `inductive T … deriving C₁, C₂` (and `structure`),
-- `deriving instance C₁, C₂ for T₁, T₂` run a **deriver** for each (class, type) pair:
-- the class's deriver is looked up in a table (as the host's `CommandState.derivers`
-- is), the type's shape comes from its `IndInfo` (parameters, constructors, fields,
-- recursion -- the reflection a Lean macro gets from `MacroM.getInductive`), and the
-- deriver emits ordinary `def`/`instance` commands, which this elaborator and the
-- kernel check exactly like a hand-written instance (so no axioms, no new trust).
--
-- The table is keyed by the class **name**: `attribute [deriver C] f` registers `f`,
-- and the dispatcher picks the deriver by `f`'s name (`deriveInhabited`, `deriveBEq`,
-- `deriveRepr`, `deriveDecidableEq`, `deriveCompare` -- the names `lib/Deriving.wiz`
-- gives them). The five are pre-registered under the canonical class names, because
-- the self-hosted prelude has no `import Deriving`. A registered deriver of another
-- name is recorded and reported as unrunnable when it is used: there is no
-- elaboration-time evaluation of Wiz code here (no `MacroM`, no quotations), so a
-- user's `Deriver := String → MacroM (List Syntax)` cannot be run (a pinned
-- difference; see docs/stages/30-selfhost-typeclasses.md, 30b).

inductive DerivedR where
  | ok (gs : Globals) (line : String)
  | err (msg : String)
-- the classes written in a `deriving` clause (its optional wraps `deriving` and the
-- `sepBy1` of names in a `null`), or none
def derivingNames (stx : Syntax) : List String := match kids (kid stx 7) with
  | .cons _ (.cons ids _) => sepIdentNames (kids ids)
  | _ => .nil
-- the error a deriver reports, in the host's shape (`deriving C for T: reason`, the
-- reason being the deriver's message): `report` in `Elab/Command.lean`'s expansion
def deriveErr (C T reason : String) : DerivedR :=
  .err ("error: deriving " +++ C +++ " for " +++ T +++ ": " +++ reason)
-- the checks every deriver makes first: the type has no index (an indexed family's
-- equations would have to generalise it, as `lib/Deriving.wiz` says; a `mutual` member
-- *is* one -- its `fixed` tag is the index), and its parameters are its Π binders
def deriveShape (gs : Globals) (T : String) (np : Nat) (fixed : Option Tm) : Option String :=
  match fixed with
  -- (a `mutual` member: the host's `getInductive` has no view of it, only of the family)
  | .some _ => .some ("not an inductive type or structure: " +++ T)
  | .none => match globalTyOf gs T with
    | .none => .some ("not an inductive type or structure: " +++ T)
    | .some tyT => match Nat.beq (piArity tyT) np with
      | .false => .some "indexed families are not supported"
      | .true => .none
-- the parameters and instance arguments of a derived instance, as binders plus their
-- names in order (a type parameter gets `[b✝i : C p]`, as lib/Deriving.wiz's
-- `Derive.instBinder`): the parameter itself is implicit, and an instance parameter is
-- kept as one. `i` numbers the instance binders so each name is fresh.
inductive DBuild where
  | mk (bs : List Syntax) (names : List String) (i : Nat)
def deriveInstName (i : Nat) : String := "b✝" +++ Nat.toString i
def deriveBinder1 (C x : String) (b : Syntax) (i : Nat) : DBuild :=
  let ty : Syntax := match binderType b with
    | .some t => t
    | .none => .missing;
  let main := match isInstB b with
    | .true => binderStx "[" "]" x ty
    | .false => binderStx "{" "}" x ty;
  let extra : List Syntax := match isInstB b with
    | .true => .nil
    -- (`isType` in lib/Deriving.wiz: a `Type`/`Type u` parameter gets an instance)
    | .false => match strEq (kindOf ty) "term.type" with
      | .true => .cons (binderStx "[" "]" (deriveInstName i)
          (mkNode "term.app" (.cons (identStx C) (one (mkNull (one (identStx x))))))) .nil
      | .false => .nil;
  let ns : List String := match extra with
    | .nil => .cons x .nil
    | .cons _ _ => .cons x (.cons (deriveInstName i) .nil);
  .mk (.cons main extra) ns (i + 1)
def deriveBinderGroup (C : String) (b : Syntax) : Nat → List String → DBuild
  | i, .nil => .mk .nil .nil i
  | i, .cons x xs => match deriveBinder1 C x b i with
    | .mk bs ns i1 => match deriveBinderGroup C b i1 xs with
      | .mk bs' ns' i2 => .mk (List.append bs bs') (List.append ns ns') i2
def deriveBindersGo (C : String) : Nat → List Syntax → DBuild
  | i, .nil => .mk .nil .nil i
  | i, .cons b rest => match deriveBinderGroup C b i (binderNames b) with
    | .mk bs ns i1 => match deriveBindersGo C i1 rest with
      | .mk bs' ns' i2 => .mk (List.append bs bs') (List.append ns ns') i2
def deriveBinders (C : String) (params : List Syntax) : DBuild := deriveBindersGo C 0 params
-- `h a₁ … aₙ`
def appStx (h : Syntax) (args : List Syntax) : Syntax := match args with
  | .nil => h
  | _ => mkNode "term.app" (.cons h (one (mkNull args)))
def appIdents (n : String) (args : List String) : Syntax := appStx (identStx n) (strIdents args)
def arrowStx (a b : Syntax) : Syntax := mkNode "term.arrow" (.cons a (.cons (.atom "→") (one b)))
-- `.c`: a constructor pattern (the dot keeps it a constructor rather than a variable)
-- or a constructor's value, by where it is used
def dotStx (c : String) : Syntax := mkNode "term.dotIdent" (.cons (.atom ".") (one (.ident c)))
-- the constructor pattern `.c p₁ … pₙ` (no arguments: `.c`)
def ctorPatStx (c : String) (subs : List Syntax) : Syntax := match subs with
  | .nil => dotStx c
  | _ => mkNode "term.app" (.cons (dotStx c) (one (mkNull subs)))
-- `match s₁, …, sₙ with alts`
def matchStx (scruts alts : List Syntax) : Syntax :=
  mkNode "term.match" (.cons (.atom "match") (.cons (mkNull scruts) (.cons (.atom "with") (one (mkNull alts)))))
def alt1 (p : Syntax) (rhs : Syntax) : Syntax :=
  mkNode "match.alt" (.cons (.atom "|") (.cons (mkNull (one p)) (.cons (.atom "=>") (one rhs))))
def alt2 (p q : Syntax) (rhs : Syntax) : Syntax :=
  mkNode "match.alt" (.cons (.atom "|") (.cons (mkNull (.cons p (one q))) (.cons (.atom "=>") (one rhs))))
-- a dummy value for each of the `d` binders a field's type is over: the sorts are what
-- a proof test reads (`isProp`), and a stuck value of the right shape does for that
def dummyEnv : Nat → Env
  | .zero => .nil
  | .succ k => .cons .vtt (dummyEnv k)
def fieldIsProof (np i : Nat) (f : CField) : Bool := match f with
  | .mk _ _ ty _ => isProp empty (eval (dummyEnv (np + i)) ty)
def nthQ : List Q → Nat → Q
  | .nil, _ => .qw
  | .cons q _, .zero => q
  | .cons _ rest, .succ k => nthQ rest k
def nthBool : List Bool → Nat → Bool
  | .nil, _ => .false
  | .cons b _, .zero => b
  | .cons _ rest, .succ k => nthBool rest k
def fieldIsRec (f : CField) : Bool := match f with
  | .mk _ r _ _ => r
-- the variable of field `i` in the equations' x/y patterns (`a✝i`, `b✝i`), for each
-- explicit field; an implicit field has no subpattern (the compiler fills its hole)
def patVars (base : String) : Nat → List Bool → List Syntax
  | _, .nil => .nil
  | i, .cons b bs => match b with
    | .true => patVars base (i + 1) bs
    | .false => .cons (identStx (base +++ Nat.toString i)) (patVars base (i + 1) bs)
-- `_` for each explicit field (a pattern that binds nothing)
def holeVars : Nat → List Bool → List Syntax
  | _, .nil => .nil
  | i, .cons b bs => match b with
    | .true => holeVars (i + 1) bs
    | .false => .cons holeStx (holeVars (i + 1) bs)
def explicitCount : List Bool → Nat
  | .nil => 0
  | .cons b bs => match b with
    | .true => explicitCount bs
    | .false => Nat.succ (explicitCount bs)
-- `Bool.and c₁ (Bool.and c₂ … Bool.true)`
def andAll : List Syntax → Syntax
  | .nil => identStx "Bool.true"
  | .cons c rest => appStx (identStx "Bool.and") (.cons c (one (andAll rest)))
-- the data fields compared: the explicit ones, except proofs (all proofs of a
-- proposition are equal) and fields at quantity 0 (erased); `C.m a✝i b✝i`, or the
-- helper for a recursive field (a recursive call the equation compiler turns into the
-- recursor's induction hypothesis)
def eqCmps (C m helper : String) (np : Nat) : Nat → List CField → List Q → List Bool → List Syntax
  | _, .nil, _, _ => .nil
  | i, .cons f fs, qs, impl => match nthBool impl i with
    | .true => eqCmps C m helper np (i + 1) fs qs impl
    | .false =>
      let here : Option Syntax := match qEq (nthQ qs i) .qz with
        | .true => .none
        | .false => match fieldIsProof np i f with
          | .true => .none
          | .false =>
            let x := identStx ("a✝" +++ Nat.toString i);
            let y := identStx ("b✝" +++ Nat.toString i);
            match fieldIsRec f with
            | .true => .some (appStx (identStx helper) (.cons x (one y)))
            | .false => .some (appStx (identStx (C +++ "." +++ m)) (.cons x (one y)));
      match here with
      | .none => eqCmps C m helper np (i + 1) fs qs impl
      | .some c => .cons c (eqCmps C m helper np (i + 1) fs qs impl)
-- one constructor's equation: `| c a✝… , c b✝… => Bool.and …`
def eqAlt (C m helper : String) (np : Nat) (c : Ctor) : Syntax := match c with
  | .mk cn fs res qs impl =>
    let px := ctorPatStx cn (patVars "a✝" 0 impl);
    let py := ctorPatStx cn (patVars "b✝" 0 impl);
    alt2 px py (andAll (eqCmps C m helper np 0 fs qs impl))
def eqAlts (C m helper : String) (np : Nat) : List Ctor → List Syntax
  | .nil => .nil
  | .cons c cs => .cons (eqAlt C m helper np c) (eqAlts C m helper np cs)
def fallbackAlt : Syntax := mkNode "match.alt" (.cons (.atom "|")
  (.cons (mkNull (.cons holeStx (one holeStx))) (.cons (.atom "=>") (one (identStx "Bool.false")))))
-- `def f bs : ty` followed by equations
def defEqnsStx (f : String) (bs : List Syntax) (ty : Syntax) (alts : List Syntax) : Syntax :=
  mkNode "command.defEqns" (.cons (.atom "def") (.cons (.ident f) (.cons (mkNull .nil) (.cons (mkNull bs)
    (.cons (mkNull (.cons (.atom ":") (one ty))) (one (mkNull alts)))))))
-- `instance bs : ty where field := v`
def instanceStx (bs : List Syntax) (ty : Syntax) (field : String) (v : Syntax) : Syntax :=
  let fld := mkNode "instance.field" (.cons (.ident field) (.cons (.atom ":=") (one v)));
  mkNode "command.instance" (.cons (.atom "instance") (.cons (mkNull .nil) (.cons (mkNull .nil) (.cons (mkNull bs)
    (.cons (.atom ":") (.cons ty (.cons (.atom "where") (one (mkNull (.cons fld .nil))))))))))
def stepFailed : String → Bool
  | line => match line with
    | .mk cs => strEq (String.mk (takeL 6 cs)) "error:"
-- the instance whose method `m` is the helper: `instance bs : C (T p…) where m := @helper p… b✝…`
def deriveInstance (gs : Globals) (C m : String) (tapp : Syntax) (bs : List Syntax)
    (allNames : List String) (helper : String) : DerivedR :=
  let instTy := appStx (identStx C) (.cons tapp .nil);
  let val := appStx (mkNode "term.explicit" (.cons (.atom "@") (one (.ident helper)))) (strIdents allNames);
  match instanceCmd gs (instanceStx bs instTy m val) with
  | .mk line gs1 => match stepFailed line with
    | .true => .err line
    | .false => .ok gs1 line
-- `BEq`: compare the same constructor's explicit data fields, `Bool.false` otherwise.
-- A definition by structural recursion, then an instance whose method is that
-- definition. The definition's name contains `✝`, so no source can capture it.
def deriveBEq (gs : Globals) (C m T : String) (info : IndInfo) : DerivedR := match info with
  | .mk np I D DI ctors fixed fam params =>
    match deriveShape gs T np fixed with
    | .some r => deriveErr C T r
    | .none => match ctors with
      | .nil => deriveErr C T "it has no constructors"
      | _ => match deriveBinders C params with
        | .mk bs allNames _ =>
          let helper := T +++ ".beq✝";
          let ps := binderParamNames params;
          let tapp := appIdents T ps;
          let ty := arrowStx tapp (arrowStx tapp (identStx "Bool"));
          let fb : List Syntax := match ctors with
            | .cons _ (.cons _ _) => .cons fallbackAlt .nil
            | _ => .nil;
          let alts := List.append (eqAlts C m helper np ctors) fb;
          match defStep gs (defEqnsStx helper bs ty alts) with
          | .mk line gs1 => match stepFailed line with
            | .true => .err line
            | .false => deriveInstance gs1 C m tapp bs allNames helper
-- `Inhabited`: the first constructor without recursive or proof fields (there is no
-- `default` proof), at `default` for each explicit field.
def plainFields (np : Nat) : Nat → List CField → List Q → List Bool → Bool
  | i, .nil, _, _ => .true
  | i, .cons f fs, qs, impl => match Bool.or (fieldIsRec f) (fieldIsProof np i f) with
    | .true => .false
    | .false => plainFields np (i + 1) fs qs impl
def ctorPlain (np : Nat) (c : Ctor) : Bool := match c with
  | .mk _ fs _ qs impl => plainFields np 0 fs qs impl
def firstPlain (np : Nat) : List Ctor → Option Ctor
  | .nil => .none
  | .cons c cs => match ctorPlain np c with
    | .true => .some c
    | .false => firstPlain np cs
def defaultArgs (dv : String) : Nat → List Syntax
  | .zero => .nil
  | .succ k => .cons (identStx dv) (defaultArgs dv k)
def deriveInhabited (gs : Globals) (C m T : String) (info : IndInfo) : DerivedR := match info with
  | .mk np I D DI ctors fixed fam params =>
    match deriveShape gs T np fixed with
    | .some r => deriveErr C T r
    | .none => match firstPlain np ctors with
      | .none => deriveErr C T ("every constructor of " +++ T +++ " is recursive or has a proof field")
      | .some (.mk cn fs res qs impl) =>
        match deriveBinders C params with
        | .mk bs _ _ =>
          let ps := binderParamNames params;
          let tapp := appIdents T ps;
          let val := appStx (identStx (T +++ "." +++ cn)) (defaultArgs (C +++ "." +++ m) (explicitCount impl));
          match instanceCmd gs (instanceStx bs (appStx (identStx C) (.cons tapp .nil)) m val) with
          | .mk line gs1 => match stepFailed line with
            | .true => .err line
            | .false => .ok gs1 line
-- `DecidableEq`: an enumeration (every constructor is a constant) or a
-- single-constructor record with no recursive field -- a recursive field's comparison
-- would need the instance being defined (as in `lib/Deriving.wiz`)
def noFields : List CField → Bool
  | .nil => .true
  | .cons _ _ => .false
def allNoFields : List Ctor → Bool
  | .nil => .true
  | .cons (.mk _ fs _ _ _) cs => match noFields fs with
    | .true => allNoFields cs
    | .false => .false
def noRecFields : List CField → Bool
  | .nil => .true
  | .cons f fs => match fieldIsRec f with
    | .true => .false
    | .false => noRecFields fs
def isRecordType : List Ctor → Bool
  | .cons (.mk _ fs _ _ _) .nil => noRecFields fs
  | _ => .false
def deriveDecidableEq (gs : Globals) (C m T : String) (info : IndInfo) : DerivedR := match info with
  | .mk np I D DI ctors fixed fam params =>
    match deriveShape gs T np fixed with
    | .some r => deriveErr C T r
    | .none => match Bool.or (allNoFields ctors) (isRecordType ctors) with
      | .false => deriveErr C T (C +++ " is derived for an enumeration or a single-constructor record only, and " +++ T)
      | .true => match deriveBinders C params with
        | .mk bs allNames _ =>
          let helper := T +++ ".dec✝";
          let ps := binderParamNames params;
          let tapp := appIdents T ps;
          let ty := arrowStx tapp (arrowStx tapp (identStx "Bool"));
          let fb : List Syntax := match ctors with
            | .cons _ (.cons _ _) => .cons fallbackAlt .nil
            | _ => .nil;
          let alts := List.append (eqAlts C m helper np ctors) fb;
          match defStep gs (defEqnsStx helper bs ty alts) with
          | .mk line gs1 => match stepFailed line with
            | .true => .err line
            | .false => deriveInstance gs1 C m tapp bs allNames helper
-- `Compare`: lexicographic on the fields of the same constructor, and `.lt`/`.gt` by
-- the constructors' declaration order (the first is least). A recursive field compares
-- through the helper, as `BEq` does.
def cmpFields (C m helper : String) (np : Nat) : Nat → List CField → List Q → List Bool → List Syntax
  | _, .nil, _, _ => .nil
  | i, .cons f fs, qs, impl => match nthBool impl i with
    | .true => cmpFields C m helper np (i + 1) fs qs impl
    | .false =>
      let here : Option Syntax := match qEq (nthQ qs i) .qz with
        | .true => .none
        | .false => match fieldIsProof np i f with
          | .true => .none
          | .false =>
            let x := identStx ("a✝" +++ Nat.toString i);
            let y := identStx ("b✝" +++ Nat.toString i);
            match fieldIsRec f with
            | .true => .some (appStx (identStx helper) (.cons x (one y)))
            | .false => .some (appStx (identStx (C +++ "." +++ m)) (.cons x (one y)));
      match here with
      | .none => cmpFields C m helper np (i + 1) fs qs impl
      | .some c => .cons c (cmpFields C m helper np (i + 1) fs qs impl)
-- `match c with | .lt => Ordering.lt | .eq => rest | .gt => Ordering.gt`
def ordStx (c : String) : Syntax := identStx ("Ordering." +++ c)
def cmpAfter (c rest : Syntax) : Syntax := matchStx (one c)
  (.cons (alt1 (dotStx "lt") (ordStx "lt")) (.cons (alt1 (dotStx "eq") rest)
    (.cons (alt1 (dotStx "gt") (ordStx "gt")) .nil)))
def cmpLex : List Syntax → Syntax
  | .nil => ordStx "eq"
  | .cons c .nil => c
  | .cons c rest => cmpAfter c (cmpLex rest)
def cmpAlt (C m helper : String) (np : Nat) (c : Ctor) : Syntax := match c with
  | .mk cn fs res qs impl =>
    let px := ctorPatStx cn (patVars "a✝" 0 impl);
    let py := ctorPatStx cn (patVars "b✝" 0 impl);
    alt2 px py (cmpLex (cmpFields C m helper np 0 fs qs impl))
def cmpAlts (C m helper : String) (np : Nat) : List Ctor → List Syntax
  | .nil => .nil
  | .cons c cs => .cons (cmpAlt C m helper np c) (cmpAlts C m helper np cs)
-- two different constructors, in declaration order
def ctorNameOf (c : Ctor) : String := match c with
  | .mk cn _ _ _ _ => cn
def ctorHoles (c : Ctor) : List Syntax := match c with
  | .mk _ _ _ _ impl => holeVars 0 impl
def crossAlt (c d : Ctor) (less : Bool) : Syntax :=
  let rhs := match less with
    | .true => ordStx "lt"
    | .false => ordStx "gt";
  alt2 (ctorPatStx (ctorNameOf c) (ctorHoles c)) (ctorPatStx (ctorNameOf d) (ctorHoles d)) rhs
def crossRow (i : Nat) (c : Ctor) : Nat → List Ctor → List Syntax
  | j, .nil => .nil
  | j, .cons d ds => match Nat.beq i j with
    | .true => crossRow i c (j + 1) ds
    | .false => .cons (crossAlt c d (Nat.lt i j)) (crossRow i c (j + 1) ds)
def crossAltsGo (all : List Ctor) : Nat → List Ctor → List Syntax
  | i, .nil => .nil
  | i, .cons c cs => List.append (crossRow i c 0 all) (crossAltsGo all (i + 1) cs)
def crossAlts (ctors : List Ctor) : List Syntax := crossAltsGo ctors 0 ctors
def deriveCompare (gs : Globals) (C m T : String) (info : IndInfo) : DerivedR := match info with
  | .mk np I D DI ctors fixed fam params =>
    match deriveShape gs T np fixed with
    | .some r => deriveErr C T r
    | .none => match ctors with
      | .nil => deriveErr C T "it has no constructors"
      | _ => match deriveBinders C params with
        | .mk bs allNames _ =>
          let helper := T +++ ".cmp✝";
          let ps := binderParamNames params;
          let tapp := appIdents T ps;
          let ty := arrowStx tapp (arrowStx tapp (identStx "Ordering"));
          let alts := List.append (cmpAlts C m helper np ctors) (crossAlts ctors);
          match defStep gs (defEqnsStx helper bs ty alts) with
          | .mk line gs1 => match stepFailed line with
            | .true => .err line
            | .false => deriveInstance gs1 C m tapp bs allNames helper
-- `Repr`: `T.c a b` at the top level, `(T.c a b)` at argument position (p ≥ 1024),
-- every data field through `C.m`/the deriver at 1024, an explicit proof field as `_`.
def strStx (s : String) : Syntax := mkNode "term.str" (one (.atom s))
def numStx (n : Nat) : Syntax := mkNode "term.num" (one (.atom (Nat.toString n)))
def reprConcat : List Syntax → Syntax
  | .nil => strStx ""
  | .cons x rest => appStx (identStx "String.append") (.cons x (one (reprConcat rest)))
def reprSpaced : List Syntax → List Syntax
  | .nil => .nil
  | .cons x rest => .cons (strStx " ") (.cons x (reprSpaced rest))
def reprBody (name : String) (fields : List Syntax) : Syntax :=
  reprConcat (.cons (strStx name) (reprSpaced fields))
-- `if c then a else b` (the grammar has no `if`: `ifMatch` reads the spine)
def ifStx (c a b : Syntax) : Syntax :=
  appStx (identStx "if") (.cons c (.cons (identStx "then") (.cons a (.cons (identStx "else") (one b)))))
def parenStx (s : Syntax) : Syntax :=
  appStx (identStx "String.append") (.cons (strStx "(")
    (.cons (appStx (identStx "String.append") (.cons s (one (strStx ")")))) .nil))
def reprFields (C m helper : String) (np : Nat) : Nat → List CField → List Q → List Bool → List Syntax
  | _, .nil, _, _ => .nil
  | i, .cons f fs, qs, impl => match nthBool impl i with
    | .true => reprFields C m helper np (i + 1) fs qs impl
    | .false =>
      let here : Option Syntax := match qEq (nthQ qs i) .qz with
        | .true => .none
        | .false => match fieldIsProof np i f with
          | .true => .some (strStx "_")
          | .false =>
            let x := identStx ("a✝" +++ Nat.toString i);
            let at := numStx 1024;
            match fieldIsRec f with
            | .true => .some (appStx (identStx helper) (.cons x (one at)))
            | .false => .some (appStx (identStx (C +++ "." +++ m)) (.cons x (one at)));
      match here with
      | .none => reprFields C m helper np (i + 1) fs qs impl
      | .some c => .cons c (reprFields C m helper np (i + 1) fs qs impl)
def reprAlt (C m T helper : String) (np : Nat) (c : Ctor) : Syntax := match c with
  | .mk cn fs res qs impl =>
    let parts := reprFields C m helper np 0 fs qs impl;
    let body := reprBody (T +++ "." +++ cn) parts;
    let rhs := match parts with
      | .nil => body
      | _ => ifStx (appStx (identStx "Nat.lt") (.cons (identStx "p✝") (one (numStx 1024))))
          body (parenStx body);
    let pat := ctorPatStx cn (patVars "a✝" 0 impl);
    mkNode "match.alt" (.cons (.atom "|") (.cons (mkNull (.cons pat (one (identStx "p✝")))) (.cons (.atom "=>") (one rhs))))
def reprAlts (C m T helper : String) (np : Nat) : List Ctor → List Syntax
  | .nil => .nil
  | .cons c cs => .cons (reprAlt C m T helper np c) (reprAlts C m T helper np cs)
def deriveRepr (gs : Globals) (C m T : String) (info : IndInfo) : DerivedR := match info with
  | .mk np I D DI ctors fixed fam params =>
    match deriveShape gs T np fixed with
    | .some r => deriveErr C T r
    | .none => match ctors with
      | .nil => deriveErr C T "it has no constructors"
      | _ => match deriveBinders C params with
        | .mk bs allNames _ =>
          let helper := T +++ ".repr✝";
          let ps := binderParamNames params;
          let tapp := appIdents T ps;
          let ty := arrowStx tapp (arrowStx (identStx "Nat") (identStx "String"));
          let alts := reprAlts C m T helper np ctors;
          match defStep gs (defEqnsStx helper bs ty alts) with
          | .mk line gs1 => match stepFailed line with
            | .true => .err line
            | .false => deriveInstance gs1 C m tapp bs allNames helper
-- (30b) the dispatch: the deriver the class's entry names, run for `T`
def deriveClassOn (gs : Globals) (C T : String) : DerivedR := match Globals.deriver gs C with
  | .none => .err ("error: no deriver for " +++ C +++ " (register one with `attribute [deriver " +++ C +++ "] f`)")
  | .some f => match deriverKind f with
    | .zero => .err ("error: deriving " +++ C +++ " for " +++ T +++ ": the deriver " +++ f
        +++ " cannot be run (this frontend has no elaboration-time evaluator; the derivers it runs are deriveInhabited, deriveBEq, deriveRepr, deriveDecidableEq and deriveCompare)")
    | _ => match Globals.class gs C with
      | .none => deriveErr C T (C +++ " is not a class (declare it with `class`)")
      | .some (.mk methods) => match Nat.beq (classArity gs C) 1 with
        | .false => deriveErr C T ("the class takes " +++ Nat.toString (classArity gs C)
            +++ " parameters; a derived instance is for a class of one type parameter")
        | .true => match Globals.ind gs T with
          | .none => deriveErr C T ("not an inductive type or structure: " +++ T)
          | .some info => match methods with
            | .nil => deriveErr C T "the class has no methods"
            | .cons m _ => match deriverKind f with
              | .succ (.zero) => deriveInhabited gs C m T info
              | .succ (.succ (.zero)) => deriveBEq gs C m T info
              | .succ (.succ (.succ (.zero))) => deriveRepr gs C m T info
              | .succ (.succ (.succ (.succ (.zero)))) => deriveDecidableEq gs C m T info
              | .succ (.succ (.succ (.succ (.succ (.zero))))) => deriveCompare gs C m T info
              | _ => deriveErr C T ("no deriver for " +++ C)
def deriveEach (T : String) : List String → Globals → DerivedR
  | .nil, gs => .ok gs ""
  | .cons C cs, gs => match deriveClassOn gs C T with
    | .err m => .err m
    | .ok gs1 line => match deriveEach T cs gs1 with
      | .err m => .err m
      | .ok gs2 line2 =>
        let out := match strEq line2 "" with
          | .true => line
          | .false => line2;
        .ok gs2 out
def deriveForTypes (classes : List String) : List String → Globals → DerivedR
  | .nil, gs => .ok gs ""
  | .cons T ts, gs => match deriveEach T classes gs with
    | .err m => .err m
    | .ok gs1 line => match deriveForTypes classes ts gs1 with
      | .err m => .err m
      | .ok gs2 line2 =>
        let out := match strEq line2 "" with
          | .true => line
          | .false => line2;
        .ok gs2 out
-- the deriving clause of an `inductive`/`structure` command, after its own step: the
-- derived instances add no output line (as in the Lean toolchain)
def withDeriving (gs : Globals) (stx : Syntax) (step : Step) : Step := match step with
  | .mk line gs1 => match stepFailed line with
    | .true => .mk line gs1
    | .false => match derivingNames stx with
      | .nil => .mk line gs1
      | classes => match kid stx 1 with
        | .ident T => match deriveEach T classes gs1 with
          | .ok gs2 _ => .mk line gs2
          | .err m => .mk m gs1
        | _ => .mk line gs1
-- `deriving instance C₁, C₂ for T₁, T₂`: the cross product, in source order
def derivingCmd (gs : Globals) (stx : Syntax) : Step :=
  let classes := sepIdentNames (kids (kid stx 2));
  let types := sepIdentNames (kids (kid stx 4));
  match deriveForTypes classes types gs with
  | .ok gs1 _ => .mk "" gs1
  | .err m => .mk m gs
-- (A11) `deriving C` on a `mutual` inductive block: the host derives for the joint
-- family (`A_B t`, an indexed family) so that one instance covers every member; this
-- frontend's derivers reject indexed families, and a member's recursive fields point at
-- its siblings, so the form is rejected here rather than half-derived
def mutualDeriving : List Syntax → Option String
  | .nil => .none
  | .cons d rest => match derivingNames d with
    | .nil => mutualDeriving rest
    | .cons C _ => .some ("deriving " +++ C +++ " for " +++ identOf' (kid d 1)
        +++ ": a mutual inductive is not supported (the host derives for the joint family, an indexed family); derive each member's instances by hand")

-- the commands `defStep` elaborates (`#eval` is `#reduce` here, stage 21u)
def knownCommand (k : String) : Bool := Bool.or (Bool.or (strEq k "command.def") (strEq k "command.defEqns"))
  (Bool.or (strEq k "command.inductive") (Bool.or (strEq k "command.check")
    (Bool.or (strEq k "command.reduce") (strEq k "command.eval"))))
-- the output so far, the globals, and the parser's tables and notations
inductive Run where
  | mk (out : List String) (gs : Globals) (cats : List Cat) (tokens : List String) (notes : List Note)
def Run.out : Run → List String
  | .mk o _ _ _ _ => o
def Run.gs : Run → Globals
  | .mk _ g _ _ _ => g
def Run.catsOf : Run → List Cat
  | .mk _ _ c _ _ => c
def Run.tokensOf : Run → List String
  | .mk _ _ _ t _ => t
def Run.notesOf : Run → List Note
  | .mk _ _ _ _ n => n
def Run.addLine (r : Run) (l : String) : Run := match r with
  | .mk out gs cats tokens notes => .mk (.cons l out) gs cats tokens notes
-- all the commands of a file, one output line each
-- one command: its output line (none for an import or a notation), and the state after
-- it; `done` at the end of the input
inductive StepR where
  | done
  | next (line : Option String) (stop : Nat) (gs : Globals) (cats : List Cat) (tokens : List String) (notes : List Note)
-- (D6) every output line names the offset of the command that produced it, as
-- `@OFFSET text`; the driver (`selfhost/Cli.wiz`) turns that into `file:line:col`, and
-- `checkFile` strips it again, so `checkFile`'s output is unchanged. (The one place a
-- line leaves `stepCommand`: the driver entry.)
def atLine (start : Nat) (l : Option String) : Option String := match l with
  | .none => .none
  | .some s => .some (String.append (String.append "@" (Nat.toString start)) (String.append " " s))
mutual
def stepCommand (inlineImports : Bool) (cats : List Cat) (tokens : List String) (notes : List Note)
    (input : Array Nat) (pos : Nat) (gs : Globals) : StepR :=
  let start := skipWs input pos;
  match Nat.lt start (Array.size input) with
  | .false => .done
  | .true => match parseCommandAt cats tokens input pos with
    | .err m => .next (atLine start (.some (String.append "parse " m))) (Array.size input) gs cats tokens notes
    | .ok stx0 stop => match strEq (kindOf stx0) "command.import" with
    -- (A14) with the module loader (`inlineImports = false`) the import was loaded
    -- before the file: skip it (only the Prelude, when checking one file, is inline)
    | .true => match inlineImports with
      | .false => .next .none stop gs cats tokens notes
      | .true => match runCommands .true (doCats cats) (.cons "←" (.cons "do" tokens)) notes (String.codes preludeText) 0 gs .nil with
        | .mk _ gs' cats' tokens' notes' => .next .none stop gs' cats' tokens' notes'
    | .false =>
      -- (A12) the grammar-changing commands: `syntax`, `notation`, `infixl`/`infixr`/
      -- `infix`, `macro_rules`, `declare_syntax_cat`, and the macro/tactic registrations
      -- (which this frontend checks but does not run). They change the tables the next
      -- command is parsed with, and add macro rules.
      let stx0a := unwrapLocal stx0;
      match tabStep gs cats tokens stx0a with
      | .some (.mk cats' tokens' notes' err) => match err with
        | .some e => .next (atLine start (.some (String.append "error: " e))) stop gs cats tokens notes
        | .none => .next .none stop gs cats' tokens' (List.append notes' notes)
      | .none =>
      -- (A12) expand the command's macro rules (term and command rules) before it is
      -- elaborated; 64 expansions are plenty for a rule that rewrites into another
      let stx1 := expandNotes notes 0 stx0a;
      -- (stage 21n) `private def …` declares the same names in the current module, and
      -- they are private to it: `Globals.add` gives them the module's kernel names
      -- (`privName`), and `stepCommand` clears the flag again after this command
      let stx := unwrapPrivate stx1;
      let gs0 := Globals.setPrivate gs (strEq (kindOf stx1) "command.private");
      match linkStep gs0 stx with
      | .some r => (match r with
        | LinkR.mk line gs' => StepR.next (atLine start line) stop (Globals.setPrivate gs' .false) cats tokens notes)
      | .none =>
      let step := match strEq (kindOf stx) "command.partial" with
        | .true => partialCmd gs0 (one stx)
        | .false => match strEq (kindOf stx) "command.mutual" with
          | .true => match strEq (kindOf (nthSyntax (nonAtoms (kids (kid stx 1))) 0)) "command.inductive" with
            | .true => match mutualDeriving (nonAtoms (kids (kid stx 1))) with
              | .some m => errStep gs0 m
              | .none => mutualInductiveCmd gs0 (nonAtoms (kids (kid stx 1)))
            | .false => partialCmd gs0 (nonAtoms (kids (kid stx 1)))
          | .false => match strEq (kindOf stx) "command.structure" with
            | .true => withDeriving gs0 stx (structCmd gs0 stx)
            | .false => match strEq (kindOf stx) "command.class" with
              | .true => classCmd gs0 stx
              | .false => match strEq (kindOf stx) "command.instance" with
                | .true => instanceCmd gs0 stx
                | .false => match strEq (kindOf stx) "command.axiom" with
              | .true => axiomCmd gs0 stx
              | .false => match strEq (kindOf stx) "command.extern" with
                -- (to the checker, a foreign function is an axiom)
                | .true => externCmd gs0 stx
                | .false => match strEq (kindOf stx) "command.foreignType" with
                  | .true => foreignTypeCmd gs0 stx
                  | .false => match strEq (kindOf stx) "command.importC" with
                  | .true => importCCmd gs0 stx
                  | .false => match strEq (kindOf stx) "command.glue" with
                  | .true => glueCmd gs0 stx
                  | .false => match strEq (kindOf stx) "command.cStruct" with
                  | .true => cStructCmd gs0 stx
                  | .false => match strEq (kindOf stx) "command.sealed" with
                    | .true => sealedCmd gs0 stx
                    | .false => match strEq (kindOf stx) "command.deriving" with
                      | .true => derivingCmd gs0 stx
                      | .false => match knownCommand (kindOf stx) with
                      | .true => match strEq (kindOf stx) "command.inductive" with
                        | .true => withDeriving gs0 stx (defStep gs0 stx)
                        | .false => defStep gs0 stx
                      -- (an unknown command, or a modifier this frontend doesn't know, is
                      -- an error naming it, never ignored)
                      | .false => errStep gs0 (String.append "unsupported command " (kindOf stx));
      match step with
      | .mk line gs' => match newDuplicate gs gs' with
        | .some x => .next (atLine start (.some (String.append (String.append "error: '" x) "' has already been declared"))) stop gs cats tokens notes
        -- (A11) `deriving instance` prints no line, as in the Lean toolchain
        | .none => .next (atLine start (match Bool.and (strEq (kindOf stx) "command.deriving") (strEq line "") with
            | .true => .none
            | .false => .some line)) stop (Globals.setPrivate gs' .false) cats tokens notes
def runCommands (inlineImports : Bool) (cats : List Cat) (tokens : List String) (notes : List Note)
    (input : Array Nat) (pos : Nat) (gs : Globals) (out : List String) : Run :=
  match stepCommand inlineImports cats tokens notes input pos gs with
  | .done => .mk out gs cats tokens notes
  | .next line stop gs' cats' tokens' notes' => runCommands inlineImports cats' tokens' notes' input stop gs' (match line with
    | .some l => .cons l out
    | .none => out)
end

-- (D6) a line's tag: `@NAME:OFFSET text` for a module of the loader's graph, `@OFFSET
-- text` for the one-file path; `stripAt` drops it, `tagLine` adds the name. The driver
-- (`selfhost/Cli.wiz`) turns the tag into `file:line:col`; `stripAt` keeps the checker's
-- own output as it was.
def stripAtDigits : List Char → Option (List Char)
  | .nil => .none
  | .cons c cs => match Nat.beq (Char.code c) 32 with
    | .true => .some cs
    | .false => match isDigitC (Char.code c) with
      | .true => stripAtDigits cs
      | .false => .none

-- after `NAME:` (a module name), the same digits and space
def skipModName : List Char → Option (List Char)
  | .nil => .none
  | .cons c cs => match Nat.beq (Char.code c) 58 with
    | .true => .some cs
    | .false => match Nat.beq (Char.code c) 32 with
      | .true => .none
      | .false => skipModName cs

def stripAfterAt : List Char → Option (List Char)
  | .nil => .none
  | .cons c cs => match isDigitC (Char.code c) with
    | .true => stripAtDigits (.cons c cs)
    | .false => match skipModName cs with
      | .none => .none
      | .some rest => stripAtDigits rest

def stripAt : String → String
  | .mk cs => .mk (match cs with
    | .nil => .nil
    | .cons c rest => match Nat.beq (Char.code c) 64 with
      | .false => cs
      | .true => match stripAfterAt rest with
        | .some out => out
        | .none => cs)

def stripAts : List String → List String
  | .nil => .nil
  | .cons l rest => .cons (stripAt l) (stripAts rest)

-- `@NAME:OFFSET text`, the loader's tag for a module's line (a line without an offset —
-- a loader error — is `@NAME:0 text`)
def tagLine (name : String) (s : String) : String := match s with
  | .mk cs => match cs with
    | .cons c rest => match Nat.beq (Char.code c) 64 with
      | .true => String.append "@" (String.append name (String.append ":" (String.mk rest)))
      | .false => String.append "@" (String.append name (String.append ":0 " s))
    | .nil => s

-- tag the first `k` lines of `out` (the ones a module just added: `Run.out` is consed)
def tagFirst (name : String) : Nat → List String → List String
  | .zero, out => out
  | .succ j, .nil => .nil
  | .succ j, .cons l rest => .cons (tagLine name l) (tagFirst name j rest)

def tagOne (name : String) (off : Nat) (s : String) : String :=
  String.append "@" (String.append name (String.append ":" (String.append (Nat.toString off) (String.append " " s))))

-- (A14) one file, with each `import` loading the embedded Prelude inline (the compiler
-- driver and `checkFile` keep this path; the module loader is `moduleCheck` below).
-- (21n) the one-shot file is one module, `input`: a `private` name is private to it (and
-- so visible throughout the file, as in the Lean frontend's single-file mode).
def checkFile (cats : List Cat) (tokens : List String) (text : String) : List String :=
  match runCommands .true (surfaceCats cats) (List.append surfaceTokens tokens) .nil
      (String.codes text) 0 (Globals.setModule Globals.empty "input") .nil with
  | .mk out _ _ _ _ => stripAts (List.reverseOf out .nil)

-- (A14) Modules. `import M` loads the module `M`: the file `M.wiz` under the first `-I`
-- root that has it, else in the working directory (`A.B` is `A/B.wiz`). Each module is
-- elaborated once, before the modules that import it, into the same globals (`Globals`)
-- and parser tables, so an importer sees the declarations of the modules it imports.
-- `Prelude` is always the embedded prelude (`preludeText`): the self-hosted prelude is
-- what this frontend can check, not `lib/Prelude.wiz` (A9-A23). A module's imports are
-- hoisted: they are loaded (and the modules checked) before any other command of the
-- module, in source order; the module's own declarations keep their source order.
--
-- The loader is pure: the driver reads the files (moduleRootSources) and `moduleCheck`
-- builds the dependency graph from the sources. A cycle is an error naming the cycle, and
-- a module that cannot be found is an error naming it. (stage 21n) `private` is
-- module-scoped: `modRunBody` sets the module being checked (`Globals.setModule`), a
-- private declaration's kernel name carries its module (`privName`), and a lookup from
-- another module is `'x' is private to module M` (`Scope.lookupV`); a module's exported
-- set is every public name it declares, so a private name is not re-exported through a
-- module that imports it. The one-shot path (`checkFile`, `--oneshot`) is one module,
-- `input` (docs/stages/21-bootstrap.md, 21n).

-- a module's source: its name (`B`), the path it was read from ("" when missing), its
-- text, and the modules it imports (in source order)
inductive ModSrc where
  | mk (name : String) (path : String) (text : String) (imports : List String)
def modName : ModSrc → String
  | .mk n _ _ _ => n
def modPath : ModSrc → String
  | .mk _ p _ _ => p
def modText : ModSrc → String
  | .mk _ _ t _ => t
def modImports : ModSrc → List String
  | .mk _ _ _ is => is
-- the module `m` among `tab`, if present
def modFind : List ModSrc → String → Option ModSrc
  | .nil, _ => .none
  | .cons (.mk n p t is) rest, m => match strEq n m with
    | .true => .some (.mk n p t is)
    | .false => modFind rest m

-- a module name as a file path: `A.B` is `A/B.wiz` (`.` becomes `/`)
def modRelChars : List Char → List Char
  | .nil => .nil
  | .cons c cs => .cons (match Nat.beq (Char.code c) 46 with
      | .true => Char.mk 47
      | .false => c) (modRelChars cs)
def modRelPath (name : String) : String :=
  String.append (String.mk (modRelChars (match name with | .mk cs => cs))) ".wiz"
-- whether a string is empty (the Prelude has no `String.length`; `Text.wiz` does)
def modEmpty (s : String) : Bool := match s with
  | .mk cs => match cs with
    | .nil => .true
    | .cons _ _ => .false
-- `root/rel` (just `rel` when the root is "", the working directory)
def modJoin (root rel : String) : String := match modEmpty root with
  | .true => rel
  | .false => String.append root (String.append "/" rel)
-- the paths a module may be at: the `-I` roots in order, then the working directory
def modPaths : List String → String → List String
  | .nil, rel => .cons rel .nil
  | .cons r rs, rel => .cons (modJoin r rel) (modPaths rs rel)
def modCandidates (roots : List String) (name : String) : List String :=
  modPaths roots (modRelPath name)

-- the top-level `import`s of a text, in source order (a parse error here is reported when
-- the module is elaborated: its imports are then what was read before the error)
--
-- The names the self-hosted toolchain's own drivers use (`IO`, `Std`, `Sys`) all mean the
-- embedded prelude until `lib/` can be checked by this frontend: the prelude declares the
-- `IO` names, and a real `IO.wiz` cannot be checked today (A9-A23). This is the one place
-- module names are canonicalised, so a program importing `IO` and `Prelude` loads one
-- prelude.
def modCanonical (name : String) : String :=
  match strEq name "IO" with
  | .true => "Prelude"
  | .false => match strEq name "Std" with
    | .true => "Prelude"
    | .false => match strEq name "Sys" with
      | .true => "Prelude"
      | .false => name
partial def modImportsAt (cats : List Cat) (tokens : List String) (input : Array Nat) (pos : Nat) : List String :=
  match Nat.lt (skipWs input pos) (Array.size input) with
  | .false => .nil
  | .true => match parseCommandAt cats tokens input pos with
    | .err _ => .nil
    | .ok stx stop => match strEq (kindOf stx) "command.import" with
      | .true => .cons (modCanonical (identOf'' (kid stx 1))) (modImportsAt cats tokens input stop)
      | .false => modImportsAt cats tokens input stop

def moduleImports (cats : List Cat) (tokens : List String) (text : String) : List String :=
  modImportsAt cats tokens (String.codes text) 0

-- the module an import is written in (the head of the loader's stack; `Main` at the top)
def modImporting : List String → String
  | .nil => "Main"
  | .cons x _ => x

-- the offset of the `import M` command that named `name` (0 when it is not found: the
-- loader's own errors — a missing module, a cycle — are reported at that import, D6)
partial def modImportAt (cats : List Cat) (tokens : List String) (input : Array Nat) (pos : Nat)
    (name : String) : Nat :=
  match Nat.lt (skipWs input pos) (Array.size input) with
  | .false => 0
  | .true => match parseCommandAt cats tokens input pos with
    | .err _ => 0
    | .ok stx stop => match strEq (kindOf stx) "command.import" with
      | .true => match strEq (modCanonical (identOf'' (kid stx 1))) name with
        | .true => skipWs input pos
        | .false => modImportAt cats tokens input stop name
      | .false => modImportAt cats tokens input stop name

-- the offset of the import of `name` in the module at the head of the loader's stack
def modImportOffset (tab : List ModSrc) (run : Run) (stack : List String) (name : String) : Nat :=
  match modFind tab (modImporting stack) with
  | .none => 0
  | .some (.mk _ _ t _) =>
    modImportAt (Run.catsOf run) (Run.tokensOf run) (String.codes t) 0 name

-- (the cache key) the modules in load order: each module's name and text, mixed into a
-- number (a rolling hash; the real cache, D5, also keys on the frontend's version)
def modOrder : List String → List ModSrc → List ModSrc
  | .nil, _ => .nil
  | .cons n ns, tab => match modFind tab n with
    | .some m => .cons m (modOrder ns tab)
    | .none => modOrder ns tab
def modHashChars : List Char → Nat → Nat
  | .nil, h => h
  | .cons c cs, h => modHashChars cs (Nat.mod (Nat.add (Nat.mul h 33) (Char.code c)) 2147483647)
def modHash (h : Nat) (s : String) : Nat :=
  modHashChars (match s with | .mk cs => cs) h
def modGraphHash : Nat → List ModSrc → Nat
  | h, .nil => h
  | h, .cons (.mk n _ t _) rest => modGraphHash (modHash (modHash (Nat.add h 1) n) t) rest
def moduleGraphKey (order : List String) (tab : List ModSrc) : Nat :=
  modGraphHash 17 (modOrder order tab)

-- a module's state in the graph: not visited, on the current import path, or loaded
inductive ModState where
  | unseen
  | loading
  | loaded
def modStateOf (vis : StrMap Nat) (name : String) : ModState :=
  match StrMap.findD vis (Str.ofString name) 0 with
  | .zero => .unseen
  | .succ k => match k with
    | .zero => .loading
    | _ => .loaded
def modMark (vis : StrMap Nat) (name : String) (v : Nat) : StrMap Nat :=
  StrMap.insert vis (Str.ofString name) v

def modJoinArrows : List String → String
  | .nil => ""
  | .cons x rest => match rest with
    | .nil => x
    | .cons _ _ => String.append x (String.append " -> " (modJoinArrows rest))
-- the import path from `name` (re-entered) to the current module: the head of the stack is
-- the current module, so `B -> C -> B` when C imports B while B is loading
def modTakeTo : List String → String → List String
  | .nil, _ => .nil
  | .cons x rest, n => match strEq x n with
    | .true => .cons x .nil
    | .false => .cons x (modTakeTo rest n)
def modCycleMsg (stack : List String) (name : String) : String :=
  String.append "error: import cycle: "
    (modJoinArrows (List.append (List.reverseOf (modTakeTo stack name) .nil) (.cons name .nil)))

-- the loader's state: the output, globals and tables (`Run`), each module's state, the
-- current import path, and the modules loaded so far (in load order)
inductive ModLoad where
  | mk (run : Run) (vis : StrMap Nat) (stack : List String) (order : List String)

-- one module's commands, its imports already loaded (skipped); the Prelude needs the `do`
-- grammar and the `←` token, as the inline import did, and its output is silent (it
-- declares the ambient names, it is not part of the program's output). A module's lines
-- are tagged with its name (`tagFirst`, D6), so a driver can put each diagnostic in the
-- file it came from; `stripAt` removes the tag for the checker's own output.
def modRunBody (r : Run) (name : String) (text : String) : Run :=
  -- (21n) the module's commands run with `name` as the current module: its `private`
  -- declarations are private to it, and every name it declares is marked in its name
  let gs0 := Globals.setModule (Run.gs r) name;
  let r' := match strEq name "Prelude" with
    | .true => match runCommands .false (doCats (Run.catsOf r)) (.cons "←" (.cons "do" (Run.tokensOf r)))
        (Run.notesOf r) (String.codes text) 0 gs0 .nil with
      | .mk _ gs' cats' tokens' notes' => .mk (Run.out r) gs' cats' tokens' notes'
    | .false => runCommands .false (Run.catsOf r) (Run.tokensOf r) (Run.notesOf r)
        (String.codes text) 0 gs0 (Run.out r);
  match r' with
  | .mk out gs' cats' tokens' notes' =>
    .mk (tagFirst name (Nat.sub (List.length out) (List.length (Run.out r))) out) gs' cats' tokens' notes'

mutual
def modLoadOne (tab : List ModSrc) (l : ModLoad) (name : String) : ModLoad :=
  match l with
  | .mk run vis stack order => match modStateOf vis name with
    | .loaded => l
    | .loading => .mk (Run.addLine run (tagOne (modImporting stack) (modImportOffset tab run stack name)
          (modCycleMsg stack name))) vis stack order
    | .unseen => match modFind tab name with
      | .none => .mk (Run.addLine run (tagOne (modImporting stack) (modImportOffset tab run stack name)
            (String.append "error: cannot find module " name)))
          (modMark vis name 2) stack order
      | .some (.mk n p t is) => match modEmpty p with
        -- the driver found no file: a `ModSrc` with path "" (or the caller had no entry)
        | .true => .mk (Run.addLine run (tagOne (modImporting stack) (modImportOffset tab run stack name)
              (String.append "error: cannot find module " n)))
            (modMark vis name 2) stack order
        | .false =>
          let l1 : ModLoad := .mk run (modMark vis name 1) (.cons name stack) order;
          match modLoadAll tab l1 is with
          | .mk run2 vis2 _ order2 =>
            .mk (modRunBody run2 name t) (modMark vis2 name 2) stack (.cons name order2)
def modLoadAll (tab : List ModSrc) (l : ModLoad) : List String → ModLoad
  | .nil => l
  | .cons n ns => modLoadAll tab (modLoadOne tab l n) ns
end

-- the whole graph from `roots`, in order: dependencies first, each module once; its
-- output lines, globals and tables (the load order is in `order`)
def modCheckRunH (cats : List Cat) (tokens : List String) (headers : List Header)
    (tab : List ModSrc) (roots : List String) : ModLoad :=
  modLoadAll tab (.mk (Run.mk .nil (Globals.withHeaders Globals.empty headers)
    (surfaceCats cats) (List.append surfaceTokens tokens) .nil) StrMap.empty .nil .nil) roots
def modCheckRun (cats : List Cat) (tokens : List String) (tab : List ModSrc) (roots : List String) : ModLoad :=
  modLoadAll tab (.mk (Run.mk .nil Globals.empty cats tokens .nil) StrMap.empty .nil .nil) roots
-- the `import_c "…"` header names of a source text, in order (no preprocessor)
partial def modHeaderNamesAt : List Char → List String
  | .nil => .nil
  | .cons c rest =>
    let cs : List Char := .cons c rest; if cStarts (toChars "import_c \"") cs then (
      let after := cDrop 10 cs
      let r := cTakeWhile (fun d => Bool.not (Nat.beq (Char.code d) 34)) after
      .cons (String.mk r.1) (modHeaderNamesAt (cDrop 1 r.2)))
    else modHeaderNamesAt rest
def modHeaderNames (text : String) : List String := match text with
  | .mk cs => modHeaderNamesAt cs
mutual
partial def modHeaderTexts (names : List String) : IO (List Header) := match names with
  | .nil => IO.pure .nil
  | .cons n rest => IO.bind (IO.readFile n) (fun t => modHeaderTextsGo n t rest)
partial def modHeaderTextsGo (n t : String) (rest : List String) : IO (List Header) :=
  if modEmpty t then modHeaderTexts rest
  else IO.bind (modHeaderTexts rest) (fun more => IO.pure (.cons (Header.mk n t) more))
end
def moduleHeaderTexts (text : String) : IO (List Header) :=
  modHeaderTexts (modHeaderNames text)
-- the output lines of the graph (each module's `#check`s and errors, in load order),
def moduleCheck (cats : List Cat) (tokens : List String) (tab : List ModSrc) (roots : List String) : List String :=
  match modCheckRun cats tokens tab roots with
  | .mk run _ _ _ => stripAts (List.reverseOf (Run.out run) .nil)

-- the driver: the `-I` roots and `--key` among the command-line arguments
partial def modRoots : List String → List String
  | .nil => .nil
  | .cons a rest => match strEq a "-I" with
    | .true => match rest with
      | .nil => .nil
      | .cons d ds => .cons d (modRoots ds)
    | .false => modRoots rest
def modHasFlag : List String → String → Bool
  | .nil, _ => .false
  | .cons a rest, f => match strEq a f with
    | .true => .true
    | .false => modHasFlag rest f

-- the first candidate path of `name` with text ("" when none: with `IO.readFile` an empty
-- file and a missing one look alike)
mutual
partial def modProbeAt (cats : List Cat) (tokens : List String) (name : String) : List String → IO ModSrc
  | .nil => IO.pure (ModSrc.mk name "" "" .nil)
  | .cons p ps => IO.bind (IO.readFile p) (fun t => modProbeGo cats tokens name p t ps)
partial def modProbeGo (cats : List Cat) (tokens : List String) (name p t : String) (ps : List String) : IO ModSrc :=
  if modEmpty t then modProbeAt cats tokens name ps
  else IO.pure (ModSrc.mk name p t (moduleImports cats tokens t))
end
-- read `name`, and then (breadth first) the modules it imports, once each
mutual
partial def modDiscover (cats : List Cat) (tokens : List String) (roots : List String)
    (tab : List ModSrc) (queue : List String) : IO (List ModSrc) :=
  match queue with
  | .nil => IO.pure tab
  | .cons name rest => match modFind tab name with
    | .some _ => modDiscover cats tokens roots tab rest
    | .none => IO.bind (modProbeAt cats tokens name (modCandidates roots name)) (fun m =>
      modDiscoverGo cats tokens roots tab m rest)
partial def modDiscoverGo (cats : List Cat) (tokens : List String) (roots : List String)
    (tab : List ModSrc) (m : ModSrc) (rest : List String) : IO (List ModSrc) :=
  if modEmpty (modText m) then modDiscover cats tokens roots (.cons m tab) rest
  else modDiscover cats tokens roots (.cons m tab) (List.append rest (modImports m))
end

-- the root module and, from it, the modules it imports: its name and the path its
-- diagnostics are reported at (the driver's FILE; the checker's `input.wiz`)
def moduleRootSourcesAs (cats : List Cat) (tokens : List String) (roots : List String)
    (name path text : String) : IO (List ModSrc) := do
  let root : ModSrc := ModSrc.mk name path text (moduleImports cats tokens text);
  let tab0 : List ModSrc := .cons (ModSrc.mk "Prelude" "prelude" preludeText .nil) (.cons root .nil);
  modDiscover cats tokens roots tab0 (modImports root)

-- the root module (`Main` is the file `input.wiz`) and, from it, the modules it imports
def moduleRootSources (cats : List Cat) (tokens : List String) (roots : List String)
    (text : String) : IO (List ModSrc) :=
  moduleRootSourcesAs cats tokens roots "Main" "input.wiz" text

partial def modPrint : List String → IO Unit
  | .nil => IO.pure ()
  | .cons s ss => do
    IO.println (stripAt s);
    modPrint ss

-- (A14) the checker's driver: read `input.wiz` and its modules (with `-I` roots), check
-- the graph and print the output lines; `--key` prints the graph's cache key instead
def moduleMain (cats : List Cat) (tokens : List String) : IO Unit := do
  args ← IO.args;
  text ← IO.readFile "input.wiz";
  hs ← moduleHeaderTexts text;
  tab ← moduleRootSources cats tokens (modRoots args) text;
  match modHasFlag args "--oneshot" with
  -- (21n) the one-shot path (`checkFile`: the embedded Prelude inline, one module
  -- `input`), kept reachable for the checker's own tests; the loader is the default
  | .true => modPrint (checkFile cats tokens text)
  | .false => match modCheckRunH cats tokens hs tab (.cons "Main" .nil) with
    | .mk run _ _ order => match modHasFlag args "--key" with
      | .true => IO.println (Nat.toString (moduleGraphKey order tab))
      | .false => modPrint (List.reverseOf (Run.out run) .nil)
