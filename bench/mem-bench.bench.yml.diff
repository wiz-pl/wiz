--- a/.github/workflows/bench.yml
+++ b/.github/workflows/bench.yml
@@ -370,3 +370,66 @@
             echo "bench: nothing to gate in this revision (both harnesses are absent)"
           fi
           exit "$failed"
+
+  # --- memory gate (scripts/mem-bench.py; docs/building.md, "Memory budget") -------
+  # Peak RSS, not wall time: the nightly timing job cannot see a build that would be
+  # killed by a 4 GiB cgroup. The baseline is checked in, so there is no cache to roll.
+  mem:
+    name: mem (self-hosted)
+    needs: preflight
+    if: needs.preflight.outputs.run == 'true'
+    runs-on: ${{ vars.WIZ_RUNNER_HEAVY }}
+    timeout-minutes: 120
+    steps:
+      - uses: actions/checkout@v5
+      - uses: ./.github/actions/setup
+        with:
+          cachix-name: ${{ env.CACHIX_NAME }}
+          cachix-token: ${{ secrets.CACHIX_AUTH_TOKEN }}
+          lean: false
+
+      - name: Check the memory requirement
+        shell: bash
+        run: |
+          # The corpus itself is small; building the self-hosted checker (preparation)
+          # is the peak, and the nix build may compile on a Cachix miss.
+          need_kib=$((WIZ_BENCH_MEM_GIB * 1024 * 1024))
+          avail_kib=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
+          echo "MemAvailable: $((avail_kib / 1024)) MiB; the memory bench declares ${WIZ_BENCH_MEM_GIB} GiB"
+          if [ "$avail_kib" -lt "$need_kib" ]; then
+            echo "::error title=not enough memory::the memory bench declares ${WIZ_BENCH_MEM_GIB} GiB and this runner has $((avail_kib / 1024)) MiB available"
+            exit 1
+          fi
+
+      - name: Build wiz and grail
+        id: toolchain
+        shell: bash
+        run: |
+          wiz_path=$(nix build .#wiz --print-out-paths --no-link)
+          echo "WIZ=$wiz_path/bin/wiz" >> "$GITHUB_ENV"
+          echo "$wiz_path/bin" >> "$GITHUB_PATH"
+          "$wiz_path/bin/wiz" --version 2>/dev/null || "$wiz_path/bin/wiz" --help | head -1 || true
+
+      - name: Test the thresholds (synthetic series, one real sample)
+        shell: bash
+        run: python3 scripts/mem-bench.py --self-test
+
+      - name: Peak RSS against the baseline
+        shell: bash
+        run: |
+          if [ ! -f bench/mem-baseline.json ]; then
+            echo "::error title=mem bench: no baseline::bench/mem-baseline.json is missing; record it with scripts/mem-bench.py --update"
+            exit 2
+          fi
+          mkdir -p bench-out
+          python3 scripts/mem-bench.py --wiz "${WIZ:-wiz}" --check \
+            --json bench-out/mem-bench.json --markdown "$GITHUB_STEP_SUMMARY"
+
+      - name: Upload the run
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: mem-bench-${{ github.run_id }}-${{ github.run_attempt }}
+          path: bench-out/mem-bench.json
+          if-no-files-found: ignore
+          retention-days: 90
