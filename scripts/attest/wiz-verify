#!/usr/bin/env python3
"""Verify a DSSE-signed build statement, its manifest, artifacts, quote and E2.

Takes the envelope from `wiz build --attest` + `wiz-attest sign` (or the
producer) and checks the signature, the artifacts, the TPM quote and, with
--snp-*, the SEV-SNP evidence.  See `docs/attestation.md`.
Exit codes: 0 verified, 1 failed, 2 usage, 3 incomplete (missing trust root,
nonce, pin, tpm2_checkquote, or --skip-crypto).
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from wiz_attest import main_verify  # noqa: E402

if __name__ == "__main__":
    sys.exit(main_verify(sys.argv[1:]))
