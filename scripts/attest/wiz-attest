#!/usr/bin/env python3
"""Generate keys, sign statements, quote PCRs and produce an attestation bundle.

The flow is: `wiz build --attest` (the statement and its manifest), then
`wiz-attest sign`, then `wiz-attest quote`; `wiz-attest SRC` does all three.
Subcommands: keygen, sign, quote, ak-info.  See `docs/attestation.md`.
Exit codes: 0 produced, 1 failed, 2 usage, 3 a required tool is missing.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from wiz_attest import main_attest  # noqa: E402

if __name__ == "__main__":
    sys.exit(main_attest(sys.argv[1:]))
