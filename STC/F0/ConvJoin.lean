import STC.F0.Sorting
import STC.F0.Sanity
/-!
# `ConvJoin`, corrected: the stub is false, and the reduction-shaped part under `SN`

`F0/Sorting.lean:465` states the canonical-head obligation as

    ConvJoin sg := ∀ Γ t u A, Γ ⊢ t ≡ u ∶ A → ∃ v, RedStar t v ∧ RedStar u v,

"conversion is generated by reduction with a common reduct", and `convInjSort_of_join`
reads `ConvInjSort` off it. **This file refutes that statement** and replaces it with the
two statements the metatheory can actually use today.

## 1. `ConvJoin` is false

`Core.irrel` makes any two *proofs* of a proposition convertible, and `Pi.eta` makes any
two pointwise-convertible functions convertible; neither rule has a reduction premise for
either end. Take the proposition

    propPi = (x : Unit prop) → Unit prop        -- `imax prop prop = prop`, so it is a Prop

and its two proofs `λ_. tt` and `λx. x`. Both are values — no reduction rule has a `λ` at
its left endpoint (`red_not_lam`) — so every `RedStar` chain from either is constant
(`redStar_of_lam`). `irrel` makes them convertible at `propPi`, so `ConvJoin` would give a
common reduct `v` that is both `λ_. tt` and `λx. x`. Hence `convJoin_false`.

The counterexample is *strongly normalising*: both endpoints are normal forms. So no
well-foundedness or confluence hypothesis can repair `ConvJoin`: the missing ingredient is
not termination, it is that `≡` has rules (`irrel`, the `η`s, the congruences) that `⟶`
does not. This is the same kind of checked refutation as `TyUnique` at the top universe
(`F0/TopSort.lean`).

## 2. The conditional form that is true: the reduction fragment under `SN`

The precise true statement is that the *reduction-generated* fragment `RedConv` (closed
under `refl`, `symm`, `trans`, `redEq`, `eqConv`, `redConv` — no congruence, `η` or
irrelevance) is joinable, and that this follows from **strong normalisation** (`SN`: every
term is accessible under its one-step reducts) together with **local confluence**. `SN` is
the well-foundedness hypothesis the spec can state today; the proof of
`confluent_of_sn_local` is Newman's lemma (local confluence + `SN` ⇒ confluence), done by
the standard "strip" argument on `Acc`, and `redConv_join` then joins the fragment:

    convJoin_of_sn_local : SN sg → LocalConfluence sg →
      (∀ Γ t u A, Γ ⊢ t ≡ u ∶ A → RedConv sg (.eq Γ t u A)) → ConvJoin sg

Both hypotheses are **hypotheses, never axioms**; the last one is refuted for the full
relation by §1 (`irrel`/`η`), and is exactly what the algorithmic conversion of M1
(`DecConv`, `Obligations.lean`) certifies for the fragment it compares by reduction.

## 3. The repaired obligation: `ConvHead`, and the exact gap

What the sorting lemma's `trans` case needs is not a common reduct of *every* conversion
but the **sort-endpoint** statement

    ConvHead sg := ∀ Γ t u C, Γ ⊢ t ≡ .sort u ∶ C → RedStar t (.sort u)

— a term convertible to a sort reduces to it. `convHead_of_convJoin` shows that the
refuted stub implies it, and `convInjSort_of_convHead` shows that it closes
`ConvInjSort` (no reduction starts at a sort, `redStar_of_sort`). It is *not* refuted by
§1, because `irrel`/`η` have no sort endpoint. In the intended model it is proved by the
algorithmic checker's canonical-head analysis (`DecConv`, M1): `convHead_of_canonConv` is
that composition once the algorithm is available, and `ConvInjSort`/`SortUniqueAt`/
`WhRed.empty_at_prop` follow from it by the reductions at the end of this file.

`ConvJoinSort` (the sort/sort instance of the stub) is also recorded: it is **equivalent**
to `ConvInjSort` (`convJoinSort_iff_convInjSort`), which is why a common-reduct theorem
about `⟶` alone cannot prove the sorting lemma — the instance *is* the goal.
-/


namespace STC
namespace F0
namespace Spec
/-- No reduction step starts at a `λ`: `lam` is a value, and the left endpoint of a
reducible term is always an application, projection, `let`, `ann`, `eq`, `eqTy`, `cast`,
`down` or `const`. -/
theorem red_not_lam {sg : Sig} : ∀ (j : Jdg), Derivable (F0 sg) j →
    ∀ (Γ : Ctx) (t u A : Tm) (b : Tm), j = .red Γ t u A → t = .lam b → False := by
  intro j d
  induction d with
  | intro r hr hp ih =>
    intro Γ t u A b heq hs
    rcases hr with hbase | hstruct
    · rcases hbase with hrest | hulift
      · rcases hrest with hrest | heqty
        · rcases hrest with hrest | heq
          · rcases hrest with hrest | hglobal
            · rcases hrest with hrest | hlet
              · rcases hrest with hrest | henum
                · rcases hrest with hrest | hempty
                  · rcases hrest with hrest | hunit
                    · rcases hrest with hrest | hsigma
                      · rcases hrest with hcore | hpi
                        · cases hcore with
                          | wfNil => cases heq
                          | wfCons => cases heq
                          | var => cases heq
                          | sort => cases heq
                          | conv => cases heq
                          | eqConv => cases heq
                          | @redConv Γ₀ t₀ u₀ A₀ B₀ s₀ =>
                            cases heq
                            exact ih (.red Γ t u A₀) (by simp) Γ t u A₀ b rfl hs
                          | refl => cases heq
                          | symm => cases heq
                          | trans => cases heq
                          | redEq => cases heq
                          | irrel => cases heq
                          | eqProp => cases heq; cases hs
                          | eqType => cases heq; cases hs
                          | eqTySort => cases heq; cases hs
                          | eqTySortApart => cases heq; cases hs
                          | castSort => cases heq; cases hs
                        · cases hpi with
                          | form => cases heq
                          | lam => cases heq
                          | app => cases heq
                          | beta => cases heq; cases hs
                          | appRed => cases heq; cases hs
                          | eta => cases heq
                          | cong => cases heq
                          | appCong => cases heq
                          | eq => cases heq; cases hs
                          | eqTyApart => cases heq; cases hs
                          | cast => cases heq; cases hs
                      · cases hsigma with
                        | form => cases heq
                        | pair => cases heq
                        | fst => cases heq
                        | snd => cases heq
                        | fstBeta => cases heq; cases hs
                        | sndBeta => cases heq; cases hs
                        | fstRed => cases heq; cases hs
                        | sndRed => cases heq; cases hs
                        | eta => cases heq
                        | cong => cases heq
                        | fstCong => cases heq
                        | sndCong => cases heq
                        | eq => cases heq; cases hs
                        | eqProof => cases heq; cases hs
                        | eqTyApart => cases heq; cases hs
                        | cast => cases heq; cases hs
                    · cases hunit with
                      | form => cases heq
                      | tt => cases heq
                      | eta => cases heq
                      | cong => cases heq
                      | eq => cases heq; cases hs
                      | eqTy => cases heq; cases hs
                      | eqTyApart => cases heq; cases hs
                      | cast => cases heq; cases hs
                  · cases hempty with
                    | form => cases heq
                    | absurd => cases heq
                    | cong => cases heq
                    | absurdCong => cases heq
                    | eq => cases heq; cases hs
                    | eqTy => cases heq; cases hs
                    | eqTyApart => cases heq; cases hs
                    | cast => cases heq; cases hs
                · cases henum with
                  | form => cases heq
                  | tag => cases heq
                  | ecase => cases heq
                  | iota => cases heq; cases hs
                  | ecaseRed => cases heq; cases hs
                  | ecaseCong => cases heq
                  | eqSame => cases heq; cases hs
                  | eqDiff => cases heq; cases hs
                  | eqRedL => cases heq; cases hs
                  | eqRedR => cases heq; cases hs
                  | eqTySame => cases heq; cases hs
                  | eqTyDiff => cases heq; cases hs
                  | cast => cases heq; cases hs
              · cases hlet with
                | letE => cases heq
                | zeta => cases heq; cases hs
                | letUnit => cases heq
                | letUnitRed => cases heq; cases hs
                | ann => cases heq
                | annRed => cases heq; cases hs
            · cases hglobal with
              | const => cases heq
              | delta => cases heq; cases hs
          · cases heq with
            | eq => cases heq
            | refl => cases heq
            | reflTy => cases heq
            | transp => cases heq
            | cast => cases heq
            | eqCong => cases heq
            | eqTyCong => cases heq
            | castCong => cases heq
            | eqRed => cases heq; cases hs
            | eqTyRedL => cases heq; cases hs
            | eqTyRedR => cases heq; cases hs
            | castRedL => cases heq; cases hs
            | castRedR => cases heq; cases hs
            | eqAtProp => cases heq; cases hs
            | eqTyProps => cases heq; cases hs
            | eqTyFormers => cases heq; cases hs
        · change EqTyLevelled r at heqty
          cases heqty with
          | form => cases heq
          | pi => cases heq; cases hs
          | sigma => cases heq; cases hs
      · cases hulift with
        | form => cases heq
        | up => cases heq
        | down => cases heq
        | beta => cases heq; cases hs
        | downRed => cases heq; cases hs
        | eta => cases heq
        | cong => cases heq
        | downCong => cases heq
        | eqProp => cases heq; cases hs
        | eq => cases heq; cases hs
        | eqTy => cases heq; cases hs
        | eqTyApart => cases heq; cases hs
        | cast => cases heq; cases hs
    · cases hstruct with
      | eqTyped => cases heq
      | @ctxConv hsg₀ Γ₀ A₀ A₀' s₀ j₀ hctx =>
        cases j₀ with
        | wf Γ' => cases heq
        | ty Γ' t' A' => cases heq
        | eq Γ' t' u' A' => cases heq
        | red Γ' t' u' A' =>
          cases heq
          exact ih (.red Γ' t u A) (by simp) Γ' t u A b rfl hs

/-- **A `RedStar` chain from a `λ` never moves**: no reduction starts at a `lam`. -/
theorem redStar_of_lam {sg : Sig} {Γ : Ctx} {A : Tm} {b v : Tm}
    (h : RedStar sg Γ A (.lam b) v) : v = .lam b := by
  rcases h with rfl | h
  · rfl
  · induction h with
    | single step =>
      exact (red_not_lam (.red Γ _ _ A) step Γ _ _ A b rfl rfl).elim
    | tail _ step ih =>
      subst ih
      exact (red_not_lam (.red Γ _ _ A) step Γ _ _ A b rfl rfl).elim

/-! ## 1. `ConvJoin` is false: `irrel` and `η` are conversions, not reductions -/

/-- The proposition `(x : Unit prop) → Unit prop`: `imax prop prop = prop`, so it is a
proposition and `irrel` applies to its proofs. -/
def propPi : Tm := .pi .prop (.unit .prop) (.unit .prop)

theorem propPi_ty {sg : Sig} : Derivable (F0 sg) (([] : Ctx) ⊢ propPi ∶ .sort .prop) := by
  have hctx : Derivable (F0 sg) (.wf ([.unit .prop] : Ctx)) := wf_cons wf_nil (unit_form wf_nil)
  exact ofRule (pi_in_F0 (Pi.form (i := .prop) (j := .prop) (s := .prop) rfl)) (by
    simp only [List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp, forall_eq]
    exact ⟨unit_form wf_nil, unit_form hctx⟩)

/-- `λ_. tt ∶ (x : Unit prop) → Unit prop`. -/
theorem lam_tt_propPi {sg : Sig} :
    Derivable (F0 sg) (([] : Ctx) ⊢ .lam .tt ∶ propPi) := by
  have hctx : Derivable (F0 sg) (.wf ([.unit .prop] : Ctx)) := wf_cons wf_nil (unit_form wf_nil)
  have htt : Derivable (F0 sg) (([.unit .prop] : Ctx) ⊢ .tt ∶ .unit .prop) :=
    ofRule (unit_in_F0 (Unit.tt (s := .prop))) (by
      simp only [List.mem_cons, List.mem_nil_iff, or_false, forall_eq]
      exact hctx)
  exact ofRule (pi_in_F0 (Pi.lam (s := .prop) (i := .prop))) (by
    simp only [List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp, forall_eq]
    exact ⟨propPi_ty, unit_form wf_nil, htt⟩)

/-- `λx. x ∶ (x : Unit prop) → Unit prop`. -/
theorem lam_id_propPi {sg : Sig} :
    Derivable (F0 sg) (([] : Ctx) ⊢ .lam (.var 0) ∶ propPi) :=
  lam_id_unit

/-- **Two proofs of `propPi` are convertible by `irrel`**, and neither `λ` reduces. -/
theorem lam_tt_equiv_lam_id :
    Derivable (F0 ([] : Sig))
      (([] : Ctx) ⊢ .lam .tt ≡ .lam (.var 0) ∶ propPi) :=
  ofRule (core_in_F0 (Core.irrel (s := .prop) (A := propPi) (t := .lam .tt)
    (u := .lam (.var 0)) rfl)) (by
      simp only [List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp, forall_eq]
      exact ⟨propPi_ty, lam_tt_propPi, lam_id_propPi⟩)

/-- **`ConvJoin` is false.** `irrel` relates the two distinct `λ`-proofs of the proposition
`(x : Unit prop) → Unit prop`; a `λ` has no reduct, so there is no common reduct. The
counterexample is strongly normalising (both ends are normal forms), so it also refutes
every "`ConvJoin` from `SN`/confluence" reading: no well-foundedness hypothesis repairs a
conversion rule that is not a reduction. -/
theorem convJoin_false : ¬ ConvJoin ([] : Sig) := by
  intro hj
  obtain ⟨v, h1, h2⟩ := hj ([] : Ctx) (Tm.lam Tm.tt) (Tm.lam (Tm.var 0)) propPi
    lam_tt_equiv_lam_id
  have e1 : v = Tm.lam Tm.tt := redStar_of_lam h1
  have e2 : v = Tm.lam (Tm.var 0) := redStar_of_lam h2
  have h : Tm.lam Tm.tt = Tm.lam (Tm.var 0) := e1.symm.trans e2
  have hh : Tm.tt = Tm.var 0 := by injection h
  exact absurd hh (by intro hh; cases hh)

/-! ## 2. `RedStar` algebra and the reduction fragment -/

/-- One step of typed reduction, as a relation. -/
def RedStep (sg : Sig) (Γ : Ctx) (A : Tm) (t u : Tm) : Prop :=
  Derivable (F0 sg) (Γ ⊢ t ⟶ u ∶ A)

/-- **Strong normalisation** of typed reduction: every term is accessible under its
one-step reducts, at every type. This is the well-foundedness hypothesis M1 owns; it is a
`Prop` hypothesis here and never an axiom (`WHN` in `Obligations.lean` is the strategy
form of the same fact). -/
def SN (sg : Sig) : Prop :=
  ∀ (Γ : Ctx) (A t : Tm), Acc (fun u v => RedStep sg Γ A v u) t

/-- **Local confluence** (weak confluence) of typed reduction: a one-step peak has a
common reduct. This is the rule-level half of Church–Rosser that M1's logical relation
proves; a hypothesis here, never an axiom. -/
def LocalConfluence (sg : Sig) : Prop :=
  ∀ Γ A t u v, RedStep sg Γ A t u → RedStep sg Γ A t v →
    ∃ w, RedStar sg Γ A u w ∧ RedStar sg Γ A v w

/-- **Confluence** of typed reduction: any two reducts of a term have a common reduct. -/
def Confluence (sg : Sig) : Prop :=
  ∀ Γ A t u v, RedStar sg Γ A t u → RedStar sg Γ A t v →
    ∃ w, RedStar sg Γ A u w ∧ RedStar sg Γ A v w

theorem redStar_refl {sg : Sig} {Γ : Ctx} {A : Tm} {t : Tm} :
    RedStar sg Γ A t t :=
  Or.inl rfl

theorem redStar_of_step {sg : Sig} {Γ : Ctx} {A : Tm} {t u : Tm}
    (h : RedStep sg Γ A t u) : RedStar sg Γ A t u :=
  Or.inr (Relation.TransGen.single h)

theorem redStar_tail {sg : Sig} {Γ : Ctx} {A : Tm} {t u v : Tm}
    (h : RedStar sg Γ A t u) (h2 : RedStep sg Γ A u v) : RedStar sg Γ A t v := by
  rcases h with rfl | h
  · exact redStar_of_step h2
  · exact Or.inr (Relation.TransGen.tail h h2)

theorem redStar_trans {sg : Sig} {Γ : Ctx} {A : Tm} {t u v : Tm}
    (h1 : RedStar sg Γ A t u) (h2 : RedStar sg Γ A u v) : RedStar sg Γ A t v := by
  rcases h1 with rfl | h1
  · exact h2
  · rcases h2 with rfl | h2
    · exact Or.inr h1
    · exact Or.inr (Relation.TransGen.trans h1 h2)

/-- Reduction closure as a **head-first inductive**: same relation as `RedStar`
(`redStar_of_rstar`), but with a structural induction principle and the head
decomposition built into `step`, which is what the confluence proof needs. -/
inductive RStar (sg : Sig) (Γ : Ctx) (A : Tm) : Tm → Tm → Prop where
  | refl (t : Tm) : RStar sg Γ A t t
  | step {t u v : Tm} : RedStep sg Γ A t u → RStar sg Γ A u v → RStar sg Γ A t v

theorem rstar_snoc {sg : Sig} {Γ : Ctx} {A : Tm} :
    ∀ {t u v : Tm}, RStar sg Γ A t u → RedStep sg Γ A u v → RStar sg Γ A t v
  | _, _, _, .refl _, hs => .step hs .refl
  | _, _, _, .step h1 h2, hs => .step h1 (rstar_snoc h2 hs)

theorem rstar_trans {sg : Sig} {Γ : Ctx} {A : Tm} :
    ∀ {t u v : Tm}, RStar sg Γ A t u → RStar sg Γ A u v → RStar sg Γ A t v
  | _, _, _, .refl _, h2 => h2
  | _, _, _, .step h1 h2, h2' => .step h1 (rstar_trans h2 h2')

theorem redStar_head {sg : Sig} {Γ : Ctx} {A : Tm} {t u v : Tm}
    (hs : RedStep sg Γ A t u) (h : RedStar sg Γ A u v) : RedStar sg Γ A t v := by
  rcases h with hEq | h
  · rw [← hEq]
    exact redStar_of_step hs
  · exact Or.inr (Relation.TransGen.tail (Relation.TransGen.single hs) h)

theorem rstar_of_redStar {sg : Sig} {Γ : Ctx} {A : Tm} {t u : Tm}
    (h : RedStar sg Γ A t u) : RStar sg Γ A t u := by
  rcases h with hEq | h
  · rw [hEq]
    exact RStar.refl u
  · induction h with
    | single hs => exact RStar.step hs (RStar.refl _)
    | tail _ hs ih => exact rstar_snoc ih hs

theorem redStar_of_rstar {sg : Sig} {Γ : Ctx} {A : Tm} {t u : Tm}
    (h : RStar sg Γ A t u) : RedStar sg Γ A t u := by
  induction h with
  | refl t => exact redStar_refl
  | step hs _ ih => exact redStar_head hs ih

/-- **Newman's lemma**, strip form, on `RStar`: if `t` is strongly normalising, any two
reducts of `t` have a common reduct. The induction is on `Acc`; the tail of a chain is
joined by applying the induction hypothesis twice at the *one-step* head reduct, so no
transitive closure of the accessibility relation is needed. -/
theorem confluence_aux {sg : Sig} {Γ : Ctx} {A : Tm} (hLC : LocalConfluence sg) :
    ∀ (t : Tm), Acc (fun u v => RedStep sg Γ A v u) t →
      ∀ u v, RStar sg Γ A t u → RStar sg Γ A t v →
        ∃ w, RStar sg Γ A u w ∧ RStar sg Γ A v w := by
  intro t hacc
  induction hacc with
  | intro t hstep ih =>
    intro u v htu htv
    cases htu with
    | refl _ => exact ⟨v, htv, RStar.refl v⟩
    | step hta hau =>
      cases htv with
      | refl _ => exact ⟨u, RStar.refl u, RStar.step hta hau⟩
      | step htb hbv =>
        obtain ⟨c, hac, hbc⟩ := hLC Γ A t _ _ hta htb
        have hac' : RStar sg Γ A _ c := rstar_of_redStar hac
        have hbc' : RStar sg Γ A _ c := rstar_of_redStar hbc
        obtain ⟨d, hud, hcd⟩ := ih _ hta u hau c hac'
        obtain ⟨e, hve, hce⟩ := ih _ htb v hbv c hbc'
        obtain ⟨z, hdz, hez⟩ :=
          ih _ hta d (rstar_trans hac' hcd) e (rstar_trans hac' hce)
        exact ⟨z, rstar_trans hud hdz, rstar_trans hve hez⟩

/-- **Local confluence plus strong normalisation gives confluence** (Newman's lemma). -/
theorem confluent_of_sn_local {sg : Sig} (hSN : SN sg) (hLC : LocalConfluence sg) :
    Confluence sg := by
  intro Γ A t u v htu htv
  obtain ⟨w, h1, h2⟩ :=
    confluence_aux (Γ := Γ) (A := A) hLC t (hSN Γ A t) u v
      (rstar_of_redStar htu) (rstar_of_redStar htv)
  exact ⟨w, redStar_of_rstar h1, redStar_of_rstar h2⟩

/-- **Reduction-generated conversion**: the fragment of `≡` closed under `refl`, `symm`,
`trans`, `redEq`, `eqConv` and `redConv` — exactly the rules whose content is a reduction
(or the algebra of reductions). The congruence, `η` and irrelevance rules are deliberately
absent: they are the rules that make `ConvJoin` false. -/
inductive RedConv (sg : Sig) : Jdg → Prop where
  | refl {Γ : Ctx} {t A : Tm} : Derivable (F0 sg) (Γ ⊢ t ∶ A) → RedConv sg (.eq Γ t t A)
  | symm {Γ : Ctx} {t u A : Tm} : RedConv sg (.eq Γ t u A) → RedConv sg (.eq Γ u t A)
  | trans {Γ : Ctx} {t u w A : Tm} :
      RedConv sg (.eq Γ t u A) → RedConv sg (.eq Γ u w A) → RedConv sg (.eq Γ t w A)
  | redEq {Γ : Ctx} {t u A : Tm} :
      Derivable (F0 sg) (Γ ⊢ t ⟶ u ∶ A) → RedConv sg (.eq Γ t u A)
  | eqConv {Γ : Ctx} {t u A B : Tm} {s : Srt} :
      RedConv sg (.eq Γ t u A) → Derivable (F0 sg) (Γ ⊢ A ≡ B ∶ .sort s) →
      RedConv sg (.eq Γ t u B)
  | redConv {Γ : Ctx} {t u A B : Tm} {s : Srt} :
      Derivable (F0 sg) (Γ ⊢ t ⟶ u ∶ A) → Derivable (F0 sg) (Γ ⊢ A ≡ B ∶ .sort s) →
      RedConv sg (.eq Γ t u B)

/-- A `RedStar` chain can be re-typed along a conversion of its type (`redConv`). -/
theorem redStar_eqConv {sg : Sig} {Γ : Ctx} {A B : Tm} {s : Srt} {t u : Tm}
    (h : RedStar sg Γ A t u) (hc : Derivable (F0 sg) (Γ ⊢ A ≡ B ∶ .sort s)) :
    RedStar sg Γ B t u := by
  rcases h with hEq | h
  · exact Or.inl hEq
  · right
    induction h with
    | single hstep =>
      exact .single (ofRule (core_in_F0 (Core.redConv (s := s))) (by
        simp only [List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp, forall_eq]
        exact ⟨hstep, hc⟩))
    | tail _ hstep ih =>
      exact .tail ih (ofRule (core_in_F0 (Core.redConv (s := s))) (by
        simp only [List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp, forall_eq]
        exact ⟨hstep, hc⟩))

/-- **`ConvJoin` for the reduction fragment**, from confluence: every `RedConv`
conversion has a common `RedStar` reduct. -/
theorem redConv_join {sg : Sig} (hC : Confluence sg) :
    ∀ (j : Jdg), RedConv sg j → ∀ (Γ : Ctx) (t u A : Tm), j = .eq Γ t u A →
      ∃ v, RedStar sg Γ A t v ∧ RedStar sg Γ A u v := by
  intro j h
  induction h with
  | @refl Γ₀ t₀ A₀ hty =>
    intro Γ t u A heq
    cases heq
    exact ⟨t₀, redStar_refl, redStar_refl⟩
  | @symm Γ₀ t₀ u₀ A₀ hd ih =>
    intro Γ t u A heq
    cases heq
    obtain ⟨v, h1, h2⟩ := ih Γ₀ t₀ u₀ A₀ rfl
    exact ⟨v, h2, h1⟩
  | @trans Γ₀ t₀ u₀ w₀ A₀ hd1 hd2 ih1 ih2 =>
    intro Γ t u A heq
    cases heq
    obtain ⟨v1, h1a, h1b⟩ := ih1 Γ₀ t₀ u₀ A₀ rfl
    obtain ⟨v2, h2a, h2b⟩ := ih2 Γ₀ u₀ w₀ A₀ rfl
    obtain ⟨z, hz1, hz2⟩ := hC Γ₀ A₀ u₀ v1 v2 h1b h2a
    exact ⟨z, redStar_trans h1a hz1, redStar_trans h2b hz2⟩
  | @redEq Γ₀ t₀ u₀ A₀ hstep =>
    intro Γ t u A heq
    cases heq
    exact ⟨u₀, redStar_of_step hstep, redStar_refl⟩
  | @eqConv Γ₀ t₀ u₀ A₀ B₀ s₀ hd hc ih =>
    intro Γ t u A heq
    cases heq
    obtain ⟨v, h1, h2⟩ := ih Γ₀ t₀ u₀ A₀ rfl
    exact ⟨v, redStar_eqConv h1 hc, redStar_eqConv h2 hc⟩
  | @redConv Γ₀ t₀ u₀ A₀ B₀ s₀ hstep hc =>
    intro Γ t u A heq
    cases heq
    refine ⟨u₀, redStar_of_step ?_, redStar_refl⟩
    exact ofRule (core_in_F0 (Core.redConv (s := s₀))) (by
      simp only [List.mem_cons, List.mem_nil_iff, or_false, forall_eq_or_imp, forall_eq]
      exact ⟨hstep, hc⟩)

/-- **The conditional form of `ConvJoin`**: strong normalisation + local confluence, and
the hypothesis that the conversion in question is reduction-generated. The last hypothesis
is *not* a consequence of the first two, and is false for the full `≡` (`convJoin_false`);
it is the fragment the M1 algorithmic conversion certifies. -/
theorem convJoin_of_sn_local {sg : Sig} (hSN : SN sg) (hLC : LocalConfluence sg)
    (hred : ∀ Γ t u A, Derivable (F0 sg) (Γ ⊢ t ≡ u ∶ A) → RedConv sg (.eq Γ t u A)) :
    ConvJoin sg :=
  fun Γ t u A d =>
    redConv_join (confluent_of_sn_local hSN hLC) (.eq Γ t u A) (hred Γ t u A d) Γ t u A rfl

/-! ## 3. The repaired obligation: `ConvHead`, and the sort instance -/

/-- **The sort-endpoint repair of `ConvJoin`**: a term convertible to a sort reduces to
that sort. This is what the `trans` case of the sorting lemma actually needs, it is implied
by the (false) `ConvJoin` (`convHead_of_convJoin`), and it closes `ConvInjSort`
(`convInjSort_of_convHead`). It is not refuted by `irrel`/`η`, which have no sort endpoint;
M1 proves it from the canonical-head analysis of the algorithmic conversion. -/
def ConvHead (sg : Sig) : Prop :=
  ∀ Γ (t : Tm) (u : Srt) (C : Tm), Derivable (F0 sg) (Γ ⊢ t ≡ .sort u ∶ C) →
    RedStar sg Γ C t (.sort u)

/-- The (refuted) common-reduct statement implies the sort-endpoint form: a common reduct
of `t` and `Sort u` is `Sort u` (`redStar_of_sort`). -/
theorem convHead_of_convJoin {sg : Sig} (hj : ConvJoin sg) : ConvHead sg := by
  intro Γ t u C d
  obtain ⟨w, h1, h2⟩ := hj Γ t (.sort u) C d
  have hw : w = .sort u := redStar_of_sort h2
  subst hw
  exact h1

/-- **`ConvHead` closes `ConvInjSort`**: symmetrise the conversion, reduce the sort to the
other sort (`redStar_of_sort`), and read off the equality. -/
theorem convInjSort_of_convHead {sg : Sig} (hh : ConvHead sg) : ConvInjSort sg := by
  intro Γ u v C d
  have hsym : Derivable (F0 sg) (Γ ⊢ .sort v ≡ .sort u ∶ C) :=
    ofRule (core_in_F0 Core.symm) (by
      simp only [List.mem_cons, List.mem_nil_iff, or_false, forall_eq]
      exact d)
  have h : Tm.sort u = Tm.sort v := redStar_of_sort (hh Γ (.sort v) u C hsym)
  simpa using h

/-- The sort/sort instance of `ConvJoin`: the only case the sorting lemma needs. -/
def ConvJoinSort (sg : Sig) : Prop :=
  ∀ Γ (u v : Srt) (C : Tm), Derivable (F0 sg) (Γ ⊢ .sort u ≡ .sort v ∶ C) →
    ∃ w, RedStar sg Γ C (.sort u) w ∧ RedStar sg Γ C (.sort v) w

/-- The sort/sort instance of the stub already gives `ConvInjSort`. -/
theorem convInjSort_of_convJoinSort {sg : Sig} (h : ConvJoinSort sg) : ConvInjSort sg := by
  intro Γ u v C d
  obtain ⟨w, h1, h2⟩ := h Γ u v C d
  have e1 : w = .sort u := redStar_of_sort h1
  subst e1
  have e2 : Tm.sort u = Tm.sort v := redStar_of_sort h2
  simpa using e2

/-- Conversely `ConvInjSort` gives the sort instance (reflexive chains), so the instance is
*exactly* the goal: no common-reduct statement weaker than `ConvInjSort` can be the
missing ingredient at sorts. -/
theorem convJoinSort_of_convInjSort {sg : Sig} (h : ConvInjSort sg) : ConvJoinSort sg := by
  intro Γ u v C d
  have huv : u = v := h Γ u v C d
  subst huv
  exact ⟨Tm.sort _, redStar_refl, redStar_refl⟩

theorem convJoinSort_iff_convInjSort {sg : Sig} :
    ConvJoinSort sg ↔ ConvInjSort sg :=
  ⟨convInjSort_of_convJoinSort, convJoinSort_of_convInjSort⟩

/-! ### Downstream: the sorting lemma from `ConvHead` -/

/-- The global sorting lemma, from `TyUnique` and the repaired obligation. -/
theorem sortUnique_of_convHead {sg : Sig} (hty : TyUnique sg) (hh : ConvHead sg) :
    SortUnique sg :=
  sortUnique_of hty (convInjSort_of_convHead hh)

/-- The corrected reduction (`TyUniqueTyped` + `TopSortUnique`), from `ConvHead`. -/
theorem sortUniqueAt_of_typed_convHead {sg : Sig} (hty : TyUniqueTyped sg) (hh : ConvHead sg)
    (htop : TopSortUnique sg) {Γ : Ctx} (hΓ : Derivable (F0 sg) (.wf Γ)) (A : Tm) :
    SortUniqueAt sg Γ A :=
  sortUniqueAt_of_typed hty (convInjSort_of_convHead hh) htop hΓ A

/-- **`WhRed` is empty at propositions**, unconditionally in the term, from `TyUnique` and
the repaired obligation. -/
theorem WhRed.empty_at_prop_convHead {sg : Sig} (hty : TyUnique sg) (hh : ConvHead sg)
    {Γ : Ctx} {t u A : Tm} (h : WhRed (F0 sg) Γ t u A)
    (hp : Derivable (F0 sg) (Γ ⊢ A ∶ .sort .prop)) : False :=
  WhRed.empty_at_prop' (sortUnique_of_convHead hty hh) h hp

end Spec
end F0
end STC
