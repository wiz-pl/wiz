-- (playground, ?ui=react) The UI module's two exports. `web/build-playground.sh`
-- concatenates `web/ui-framework.wiz`, `web/playground-ui.wiz` and this file, then
-- `wiz build --no-main` turns it into `wiz-playground-ui.mjs`.
--
-- Both return a malloc'ed UTF-8 string, as `wiz_playground_eval` does: the page frees
-- it (web/playground-react.js, through web/framework/driver.js).
--
--   wiz_ui_html  : String → String          the model's HTML (first paint)
--   wiz_ui_patch : String → String → String the patches between two models

def uiHtml (model : String) : String := Ui.renderHtml model

export "wiz_ui_html" uiHtml

def uiPatch (old new : String) : String := Ui.renderPatches old new

export "wiz_ui_patch" uiPatch
