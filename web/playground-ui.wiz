import IO
import Web.Loom
import Web.Playground

/-!
# The playground page's entry points

The page itself is `Web.Playground.pageApp` (a `Loom.LiveApp Page PageMsg`): the header
and its examples menu and `#status`, the editor pane, the goals pane's container, the
output pane and the footer with `#engine`. This file is only the C ABI: every exported
function takes the state **by ownership** and returns the next one (stage 9g's rule, so
the page passes its one reference and keeps the result), and a call that only reads the
state (`wiz_loom_html` for the first paint) needs an extra `wiz_retain`, which
`web/framework/driver.js` takes.

The page (`web/playground.js`) does the effects, because a step is pure: it runs the
engine and reports through

  * `wiz_loom_show` / `wiz_loom_fail` — a run's text, or a failure's text and count;
  * `wiz_loom_status` / `wiz_loom_enable` / `wiz_loom_engine` — the status pair, Run's
    disabled state and the footer;
  * `wiz_loom_text` — the editor's text replaced.

Everything else (the menu, the layout, the state, the patches) is the runtime's.
-/

link_c "js.c"
extern "js_patch" Js.patch : String → IO Unit

/-- Patch the page from `s` to `s'` and give `s'` back (the page holds the state). -/
def patched (s s' : Page) : IO Page := do
  Js.patch (Loom.LiveApp.patches pageApp s s');
  IO.pure s'

def loomInit : Page := Page.initial
def loomHtml (s : Page) : String := Loom.LiveApp.html pageApp s
def loomStep (s : Page) (ev : String) : IO Page :=
  patched s (Loom.LiveApp.step pageApp s ev)
def loomShow (s : Page) (text : String) : IO Page := patched s (Page.show s text)
def loomFail (s : Page) (text count : String) : IO Page := patched s (Page.fail s text count)
def loomStatus (s : Page) (text kind : String) : IO Page := patched s (Page.status s text kind)
def loomEnable (s : Page) (on : Nat) : IO Page :=
  patched s (Page.enable s (match Nat.beq on 0 with | .true => .false | .false => .true))
def loomEngine (s : Page) (text : String) : IO Page := patched s (Page.setEngine s text)
def loomText (s : Page) (text : String) : IO Page := patched s (Page.setText s text)

export "wiz_loom_init" loomInit
export "wiz_loom_html" loomHtml
export "wiz_loom_step" loomStep
export "wiz_loom_show" loomShow
export "wiz_loom_fail" loomFail
export "wiz_loom_status" loomStatus
export "wiz_loom_enable" loomEnable
export "wiz_loom_engine" loomEngine
export "wiz_loom_text" loomText
