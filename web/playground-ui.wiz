import IO
import Json
import Web.EditorModel
import Web.Loom
import Web.Playground

/-!
# The playground page's entry points

The page itself is `Web.Playground.pageApp` (a `Loom.LiveApp Page PageMsg`): the header
and its toolbar (the examples menu and Share/Save/Reset/Clear), `#status`/`#note`, the
editor pane, the goals pane's container, the output pane and the footer with `#engine`.
This file is only the C ABI: every exported function takes the state **by ownership**
and returns the next one (stage 9g's rule, so the page passes its one reference and
keeps the result), and a call that only reads the state (`wiz_loom_html` for the first
paint, `wiz_loom_requests` for the pending requests) needs an extra `wiz_retain`, which
`web/framework/driver.js` takes.

There are two runtime interfaces, not one per effect:

  * `wiz_loom_effect (state) kind a b` — the page's results coming back in: a finished
    run, a failure, a status pair, Run's state, the footer, the editor's text, the
    initial fragment/draft, a note, an edited text, and `"ack" a` for a serviced request;
  * `wiz_loom_requests (state)` — the effects the page must do, as JSON
    (`[{"kind":"run","payload":""}, …]`), read by `web/framework/mount.js` and handed to
    the page's `onRequest`.

The editor's rules are **reads**, not effects, and take no state: `wiz_loom_editor_*`
are string-to-string queries (`mount`'s `ask`) over `lib/Web/EditorModel.wiz`, so the
page can ask "which spans does this diagnostic underline?" without a step.

Everything else (the menu, the layout, the state, the patches, the fragment/draft
format) is the runtime's.
-/

link_c "js.c"
extern "js_patch" Js.patch : String → IO Unit

/-- Patch the page from `s` to `s'` and give `s'` back (the page holds the state). -/
def patched (s s' : Page) : IO Page := do
  Js.patch (Loom.LiveApp.patches pageApp s s');
  IO.pure s'

def loomInit : Page := Page.initial
def loomHtml (s : Page) : String := Loom.LiveApp.html pageApp s
def loomStep (s : Page) (ev : String) : IO Page :=
  patched s (Loom.LiveApp.step pageApp s ev)
def loomEffect (s : Page) (kind a b : String) : IO Page :=
  patched s (Page.effect s kind a b)

/-- The pending effect requests, as JSON (a read-only call: the driver retains first). -/
def loomRequests (s : Page) : String := Page.requests s

/-- Whether the runtime consumed a handled `Loom.onPrevent` event's default action
(`web/framework/driver.js` calls this after the step; `1` means prevent). -/
def loomConsume (s : Page) (ev : String) : Nat :=
  match Page.consume (Loom.splitEvent ev) s with
  | .true => 1
  | .false => 0

-- The editor's pure rules (`lib/Web/EditorModel.wiz`). The page asks one question at a
-- time and paints the answer; these take no runtime state, so they are reads, not
-- effects. Strings in, strings out, so the browser marshals no objects.

/-- The versioned line table the page caches (`EditorModel.indexJson`). -/
def loomEditorIndex (version text : String) : String :=
  EditorModel.indexJson (EditorModel.natOf version) text

/-- The spans a diagnostics array underlines, as JSON. -/
def loomEditorSegments (text diags maxSegments : String) : String :=
  EditorModel.segmentsJsonText text diags (EditorModel.natOf maxSegments)

/-- The spans, taking the cached line table (`wiz_loom_editor_index`). -/
def loomEditorSegmentsIndex (index text diags maxSegments : String) : String :=
  EditorModel.segmentsJson (EditorModel.indexFromJson text index) diags
    (EditorModel.natOf maxSegments)

/-- A `textDocument/completion` result's items, as JSON. -/
def loomEditorItems (result : String) : String :=
  Json.render (Json.mkArr (EditorModel.completionItems result))

/-- The popup's filtered items, selection and prefix, as JSON. -/
def loomEditorPopup (text items index offset : String) : String :=
  EditorModel.popupJson text items index (EditorModel.natOf offset)

/-- The selected index after moving `delta` in `count` items. -/
def loomEditorMove (index delta count : String) : String :=
  EditorModel.intString
    (EditorModel.moveSelection (EditorModel.intOf index) (EditorModel.intOf delta)
      (EditorModel.intOf count))

/-- What an accepted item inserts and where, as JSON. -/
def loomEditorAccept (text item offset : String) : String :=
  EditorModel.acceptJson text item (EditorModel.natOf offset)

/-- Whether typing `c` at `offset` should ask for completions (`1` or `0`). -/
def loomEditorTrigger (text c offset : String) : String :=
  match EditorModel.completionTrigger (EditorModel.index text) c
    (EditorModel.natOf offset) with
  | .true => "1"
  | .false => "0"

/-- The LSP position of a UTF-16 offset, as JSON. -/
def loomEditorPosition (text offset : String) : String :=
  EditorModel.positionJsonText text (EditorModel.natOf offset)

/-- The LSP position, taking the cached line table. -/
def loomEditorPositionIndex (index offset : String) : String :=
  EditorModel.positionJson (EditorModel.indexFromJson "" index)
    (EditorModel.natOf offset)

/-- The UTF-16 offset of an LSP position. -/
def loomEditorOffset (text line character : String) : String :=
  EditorModel.natString
    (EditorModel.offsetFromPosition (EditorModel.index text)
      (EditorModel.Position.mk (EditorModel.natOf line) (EditorModel.natOf character)))

/-- The UTF-16 offset, taking the cached line table. -/
def loomEditorOffsetIndex (index line character : String) : String :=
  EditorModel.natString
    (EditorModel.offsetFromPosition (EditorModel.indexFromJson "" index)
      (EditorModel.Position.mk (EditorModel.natOf line) (EditorModel.natOf character)))

/-- The UTF-16 offset of a code-point offset (the self-hosted engine counts code points). -/
def loomEditorUtf16 (text codePoints : String) : String :=
  EditorModel.natString
    (EditorModel.utf16OffsetFromCodePoints (EditorModel.index text)
      (EditorModel.natOf codePoints))

/-- A code-point offset into `prefix ++ text` as a UTF-16 offset into `text`. -/
def loomEditorEditorOffset (text prefix codePoints : String) : String :=
  let source := EditorModel.index (String.append prefix text);
  let at := EditorModel.utf16OffsetFromCodePoints source (EditorModel.natOf codePoints);
  let cut := EditorModel.length prefix;
  EditorModel.natString (if Nat.lt at cut then 0 else at - cut)

/-- The UTF-16 offset of the end of the line containing `offset`. -/
def loomEditorLineEnd (text offset : String) : String :=
  let i := EditorModel.index text;
  EditorModel.natString
    (EditorModel.lineEndAt i (EditorModel.lineOfOffset i (EditorModel.natOf offset)))

/-- The line end, taking the cached line table. -/
def loomEditorLineEndIndex (index offset : String) : String :=
  let i := EditorModel.indexFromJson "" index;
  EditorModel.natString
    (EditorModel.lineEndAt i (EditorModel.lineOfOffset i (EditorModel.natOf offset)))

/-- The edit an accepted Tab makes at `from`..`to`, as JSON (`host.edit` applies it). -/
def loomEditorIndent (text from to : String) : String :=
  EditorModel.indentJson text from to

-- The self-hosted server's declaration/position index (`wiz_playground_check`'s `index`).

/-- Build the LSP index from the check's entries (code-point offsets into `prefix ++ text`). -/
def loomIndexBuild (text prefix entries : String) : String :=
  EditorModel.lspIndexJson text prefix entries

/-- The number of entries in the index. -/
def loomIndexSize (index : String) : String :=
  EditorModel.natString (EditorModel.lspIndexSize index)

/-- `wiz/plainTermGoal` at an offset. -/
def loomIndexTerm (text index offset : String) : String :=
  EditorModel.lspTermGoalJson text index (EditorModel.natOf offset)

/-- `wiz/plainGoal` at an offset. -/
def loomIndexGoal (text index offset : String) : String :=
  EditorModel.lspGoalJson text index (EditorModel.natOf offset)

/-- The declarations, in source order. -/
def loomIndexDeclarations (text index : String) : String :=
  EditorModel.lspDeclarationsJson text index

/-- The declaration a source name denotes. -/
def loomIndexDeclaration (text index name : String) : String :=
  EditorModel.lspDeclarationJson text index name

export "wiz_loom_init" loomInit
export "wiz_loom_html" loomHtml
export "wiz_loom_step" loomStep
export "wiz_loom_effect" loomEffect
export "wiz_loom_requests" loomRequests
export "wiz_loom_consume" loomConsume
export "wiz_loom_editor_index" loomEditorIndex
export "wiz_loom_editor_segments" loomEditorSegments
export "wiz_loom_editor_segments_index" loomEditorSegmentsIndex
export "wiz_loom_editor_items" loomEditorItems
export "wiz_loom_editor_popup" loomEditorPopup
export "wiz_loom_editor_move" loomEditorMove
export "wiz_loom_editor_accept" loomEditorAccept
export "wiz_loom_editor_trigger" loomEditorTrigger
export "wiz_loom_editor_position" loomEditorPosition
export "wiz_loom_editor_position_index" loomEditorPositionIndex
export "wiz_loom_editor_offset" loomEditorOffset
export "wiz_loom_editor_offset_index" loomEditorOffsetIndex
export "wiz_loom_editor_utf16" loomEditorUtf16
export "wiz_loom_editor_editor_offset" loomEditorEditorOffset
export "wiz_loom_editor_line_end" loomEditorLineEnd
export "wiz_loom_editor_line_end_index" loomEditorLineEndIndex
export "wiz_loom_editor_indent" loomEditorIndent
export "wiz_loom_index_build" loomIndexBuild
export "wiz_loom_index_size" loomIndexSize
export "wiz_loom_index_term" loomIndexTerm
export "wiz_loom_index_goal" loomIndexGoal
export "wiz_loom_index_declarations" loomIndexDeclarations
export "wiz_loom_index_declaration" loomIndexDeclaration
