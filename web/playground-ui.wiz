import IO
import Text
import Web.Editor
import Web.Loom
import Web.Playground

/-!
# The playground page

`web/playground.html` as one Loom app: the header and its `#status`, the editor pane,
the goals pane's container, the output pane (`Web.Playground`) and the footer with
`#engine`. The page (`web/playground.js`) mounts it with `web/framework/driver.js`, which
sends DOM events; the effects stay on the page's side (loading the engine, running it,
the goals pane's language client), and report their results through the `wiz_loom_*`
entry points at the bottom:

  * `wiz_loom_init  : S` and `wiz_loom_html : S -> String` — the first paint;
  * `wiz_loom_step  : S -> String -> IO S` — a DOM event (the driver's `event\nindex\n
    payload`; the editor's `input` is a `Loom.LiveApp` message), patched with `js_patch`;
  * `wiz_loom_show  : S -> String -> IO S` — a run's output text (classify, count);
  * `wiz_loom_fail  : S -> String -> String -> IO S` — an engine failure's text and the
    `#count` text the page uses instead (`exit code 3`);
  * `wiz_loom_status`, `wiz_loom_enable`, `wiz_loom_engine`, `wiz_loom_text` — the page's
    `setStatus(text, kind)`, the Run button's disabled state, the footer and the text.

Every entry point takes the state **by ownership** and returns the next one: the C ABI's
exported function consumes its argument (stage 9g), so the page passes its one reference
and keeps the result. A call that only reads the state (the driver's SSR, `wiz_loom_html`)
takes an extra `wiz_retain` first — `web/framework/driver.js` does.

The `#goals` element is an island: the language client writes into it (`web/goals.js`),
and the app only renders its empty container, so a re-render never clobbers the pane.
-/

/-- The page's program, as `web/playground.html` has always carried it. -/
def program : String :=
  "import Prelude\n\n-- Everything here runs in the page: the self-hosted Wiz frontend and kernel\n-- (selfhost/*.wiz, stage 11ab), compiled to WebAssembly by web/build-playground.sh.\n-- With ?lsp=ws://127.0.0.1:8765 the goals pane shows a language server's state\n-- (for example: def k : Nat → Bool → Nat := by / intro n / intro b / exact n).\ndef twice (n : Nat) : Nat := n + n\n\n#check twice\n#eval twice 21\n"

/-- The page's state: the editor, the output pane's model (which owns `#status`'s text
and kind and `#count`), and the footer's engine line. -/
structure Page where
  editor : WebEditor
  output : Model
  engine : String

/-- The first paint: the page's static markup (`loading the engine…`, Run disabled, an
empty count). -/
def Page.initial : Page :=
  Page.mk (WebEditor.initial program)
    (Model.mk List.nil 0 "loading the engine…" "running" "") "engine: loading"

def Page.setEditor (s : Page) (e : WebEditor) : Page := Page.mk e s.output s.engine
/-- The output pane's model, and the editor's `#count` text (the pane owns the count;
the editor shows it). -/
def Page.setOutput (s : Page) (o : Model) : Page :=
  Page.mk (WebEditor.withCount s.editor o.count) o s.engine
def Page.setEngine (s : Page) (engine : String) : Page := Page.mk s.editor s.output engine

/-- `setStatus(text, kind)`, the page's status line. -/
def Page.status (s : Page) (text kind : String) : Page :=
  let o := s.output;
  Page.setOutput s (Model.mk o.lines o.failures text kind o.count)

/-- Run on or off (the page while the engine loads and while a run is in flight). -/
def Page.enable (s : Page) (on : Bool) : Page :=
  Page.setEditor s (WebEditor.withDisabled s.editor (match on with | .true => .false | .false => .true))

-- ## The view

def header (s : Page) : Loom.VNode WebEditor.Msg :=
  Loom.el "header" List.nil
    [ Loom.el "a" [Loom.class "home", Loom.attr "href" "../"] [Loom.text "← Wiz"]
    , Loom.el "strong" List.nil [Loom.text "Playground"]
    , Loom.el "span" [Loom.class "dim"]
        [Loom.text "the self-hosted checker, compiled to WebAssembly — goals from an optional language server"]
    , Loom.el "nav" [Loom.class "pagenav", Loom.attr "aria-label" "Site"]
        [Loom.el "a" [Loom.attr "href" "../docs/"] [Loom.text "Docs"]]
    , Loom.el "span" [Loom.id "status", Loom.class (String.append "status " s.output.statusKind),
        Loom.attr "role" "status"] [Loom.text s.output.status]
    ]

/-- The goals pane's heading and hint (the text is the pane's, unchanged). -/
def goalsHead : Loom.VNode WebEditor.Msg :=
  Loom.el "div" [Loom.class "pane-head"]
    [ Loom.el "span" List.nil [Loom.text "Goals"]
    , Loom.el "span" [Loom.class "hint"]
        [Loom.text "from ", Loom.el "code" List.nil [Loom.text "?lsp=ws://host:port"]] ]

def outputHead : Loom.VNode WebEditor.Msg :=
  Loom.el "div" [Loom.class "pane-head"]
    [ Loom.el "span" List.nil [Loom.text "Output"]
    , Loom.el "span" [Loom.class "hint"]
        [Loom.text "one line per command; ", Loom.el "code" List.nil [Loom.text "#eval"],
         Loom.text " is the kernel's normal form"] ]

def pageMain (s : Page) : Loom.VNode WebEditor.Msg :=
  Loom.el "main" List.nil
    [ WebEditor.view s.editor
    , Loom.el "section" [Loom.class "pane side"]
        [ goalsHead
        , Loom.el "div" [Loom.id "goals", Loom.class "goals", Loom.attr "tabindex" "0",
            Loom.attr "aria-live" "polite"] List.nil
        , outputHead
        , Model.view s.output ]
    ]

def footer (s : Page) : Loom.VNode WebEditor.Msg :=
  Loom.el "footer" List.nil
    [ Loom.el "span" [Loom.id "engine", Loom.class "dim"] [Loom.text s.engine]
    , Loom.el "span" [Loom.class "dim"]
        [Loom.text "A definition prints its signature, ",
         Loom.el "code" List.nil [Loom.text "#check"],
         Loom.text " a type, ", Loom.el "code" List.nil [Loom.text "#eval"],
         Loom.text " a value (shown raw if it is not a Nat, Bool or list)."] ]

/-- The whole page: one app, three top-level siblings (a body's children). -/
def view (s : Page) : Loom.VNode WebEditor.Msg :=
  Loom.seq [header s, pageMain s, footer s]

/-- The page's messages are the editor's (`input` carries the textarea's text, `run` a
Run request); the update routes them to the editor. -/
def update (m : WebEditor.Msg) (payload : String) (s : Page) : Page :=
  Page.setEditor s (WebEditor.update m payload s.editor)

def pageApp : Loom.LiveApp Page WebEditor.Msg := Loom.LiveApp.mk Page.initial update view

-- ## The entry points the page calls

link_c "js.c"
extern "js_patch" Js.patch : String → IO Unit

/-- Patch the page from `s` to `s'` and give `s'` back (the page holds the state). -/
def patched (s s' : Page) : IO Page := do
  Js.patch (Loom.LiveApp.patches pageApp s s');
  IO.pure s'

def loomInit : Page := Page.initial
def loomHtml (s : Page) : String := Loom.LiveApp.html pageApp s
def loomStep (s : Page) (ev : String) : IO Page :=
  patched s (Loom.LiveApp.step pageApp s ev)
def loomShow (s : Page) (text : String) : IO Page :=
  patched s (Page.setOutput s (Model.ofText text s.output.status s.output.statusKind))
def loomFail (s : Page) (text count : String) : IO Page :=
  patched s (Page.setOutput s (Model.ofFailure text s.output.status count s.output.statusKind))
def loomStatus (s : Page) (text kind : String) : IO Page := patched s (Page.status s text kind)
def loomEnable (s : Page) (on : Nat) : IO Page :=
  patched s (Page.enable s (match Nat.beq on 0 with | .true => .false | .false => .true))
def loomEngine (s : Page) (text : String) : IO Page := patched s (Page.setEngine s text)
def loomText (s : Page) (text : String) : IO Page :=
  patched s (Page.setEditor s (WebEditor.withText s.editor text))

export "wiz_loom_init" loomInit
export "wiz_loom_html" loomHtml
export "wiz_loom_step" loomStep
export "wiz_loom_show" loomShow
export "wiz_loom_fail" loomFail
export "wiz_loom_status" loomStatus
export "wiz_loom_enable" loomEnable
export "wiz_loom_engine" loomEngine
export "wiz_loom_text" loomText
