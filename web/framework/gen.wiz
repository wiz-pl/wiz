-- A fixture for web/framework/test.mjs: the same component tree the Lean tests use
-- (Tests/Groups/Loom.lean), rendered and diffed, printed as JSON. The Node test parses
-- `old` with web/framework/minidom.mjs, applies `patches` with runtime.js and checks
-- that the serialization is exactly `new` -- SSR, diff and the browser half together.
--
--   .lake/build/bin/wiz run web/framework/gen.wiz
import IO
import Json
import Optic
import Web.Loom

inductive Msg where
  | inc
  | dec
  | toggle (id : Nat)

structure Item where
  id : Nat
  name : String
  done : Bool

structure Model where
  count : Nat
  items : List Item
  show : Bool

def Model.countL : Lens Model Nat := fun s => (s.count, fun n => Model.mk n s.items s.show)
def Model.itemsL : Lens Model (List Item) := fun s => (s.items, fun xs => Model.mk s.count xs s.show)
def Model.showL : Lens Model Bool := fun s => (s.show, fun b => Model.mk s.count s.items b)
def Item.doneL (i : Item) : Lens Item Bool := fun x => (x.done, fun b => Item.mk x.id x.name b)

def Item.view (i : Item) : Loom.VNode Msg :=
  Loom.keyed (Nat.toString i.id)
    (Loom.el "li" [Loom.attr "data-done" (match i.done with | .true => "yes" | .false => "no")]
      [Loom.on "click" (Msg.toggle i.id)
        (Loom.el "span" List.nil [Loom.text i.name])])

def view (s : Model) : Loom.VNode Msg :=
  Loom.el "div" [Loom.class "app"]
    [ Loom.el "p" List.nil
        [Loom.text "count ", Loom.text (Nat.toString s.count)]
    , Loom.on "click" Msg.inc
        (Loom.el "button" List.nil [Loom.text "+"])
    , match s.show with
      | .true => Loom.el "ul" List.nil (Loom.map Item.view s.items)
      | .false => Loom.text "hidden"
    ]

def app : Loom.App Model Msg := Loom.App.mk
  (Model.mk 0 [Item.mk 1 "a" .false, Item.mk 2 "b" .false] .true)
  (fun m s => match m with
    | .inc => Loom.setState Model.countL Nat.succ s
    | .dec => Loom.setState Model.countL (fun n => Nat.sub n 1) s
    | .toggle id => Loom.setState Model.itemsL
        (Loom.map (fun (i : Item) => match Nat.beq id i.id with
          | .true => Lens.over (Item.doneL i) (fun b => match b with | .true => .false | .false => .true) i
          | .false => i)) s)
  view

def item (n : Nat) (name : String) : Item := Item.mk n name .false

def m0 : Model := app.init
def m1 : Model := Loom.App.dispatch app m0 0
def reordered : Model := Model.mk 0 [item 2 "b", item 1 "a"] .true
def e0 : Model := Model.mk 0 [item 1 "a", item 2 "b", item 3 "c"] .true
def rotated : Model := Model.mk 0 [item 2 "b", item 3 "c", item 1 "a"] .true
def edited : Model := Model.mk 0 [item 1 "a", item 3 "c", item 4 "d"] .true
def hidden : Model := Model.mk 0 m0.items .false

structure TagModel where
  n : Nat

def tagApp : Loom.App TagModel Msg := Loom.App.mk (TagModel.mk 0) (fun _ s => s)
  (fun s => match s.n with
    | .zero => Loom.el "div" List.nil [Loom.text "same"]
    | _ => Loom.el "section" List.nil [Loom.text "same"])

def t0 : TagModel := TagModel.mk 0
def t1 : TagModel := TagModel.mk 1

def escaping : Loom.VNode Msg :=
  Loom.el "p" [Loom.attr "title" "a\"b<c>d&e'f"]
    [Loom.text "<script>alert('x')</script>"]

/-- A handler that decides its own default action (`Loom.onPrevent`): the rendered
element carries both the handler attribute and the marker the driver reads. -/
def guarded : Loom.VNode Msg :=
  Loom.onPrevent "keydown" Msg.inc (Loom.el "input" [Loom.attr "id" "guarded"] List.nil)

def jstr (s : String) : Json := Json.mkStr s
def jbool (b : Bool) : Json := Json.mkBool b

def fields : List (String × Json) :=
  [ Json.field "old" (jstr (Loom.App.html app m0))
  , Json.field "new" (jstr (Loom.App.html app m1))
  , Json.field "patches" (jstr (Loom.App.patches app m0 m1))
  , Json.field "reorderOld" (jstr (Loom.App.html app m0))
  , Json.field "reorderNew" (jstr (Loom.App.html app reordered))
  , Json.field "reorderPatches" (jstr (Loom.App.patches app m0 reordered))
  , Json.field "rotateOld" (jstr (Loom.App.html app e0))
  , Json.field "rotateNew" (jstr (Loom.App.html app rotated))
  , Json.field "rotatePatches" (jstr (Loom.App.patches app e0 rotated))
  , Json.field "editOld" (jstr (Loom.App.html app e0))
  , Json.field "editNew" (jstr (Loom.App.html app edited))
  , Json.field "editPatches" (jstr (Loom.App.patches app e0 edited))
  , Json.field "tagOld" (jstr (Loom.App.html tagApp t0))
  , Json.field "tagNew" (jstr (Loom.App.html tagApp t1))
  , Json.field "tagPatches" (jstr (Loom.App.patches tagApp t0 t1))
  , Json.field "hidden" (jstr (Loom.App.html app hidden))
  , Json.field "escape" (jstr (Loom.toHtml escaping))
  , Json.field "guard" (jstr (Loom.toHtml guarded))
  , Json.field "handlers" (Json.ofNat (List.length (Loom.App.render app m0).handlers))
  , Json.field "deterministic" (jbool (String.eq (Loom.App.html app m0) (Loom.App.html app m0)))
  ]

def main : IO Unit := do
  IO.println (Json.render (Json.mkObj fields))
