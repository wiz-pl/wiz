import IO
import Json
import Web.DocLive
import Web.Loom
import Web.Wire

/-!
# The live documentation panel's runtime

`web/doc-live.js` creates the `<aside id="doc-live">` mount point and keeps the fetch
and the socket; `DocLive` renders the panel and asks for a reconnect.

The page's state is a `Loom.Session`: the panel's model *and the last tree it rendered*.
A step or an effect diffs against that tree, so one effect is one render, not a render
of the old state and a render of the new one. An `"batch"` effect carries a JSON array
of `{kind,a,b}` and applies them all before that one render (a hover answers seven
fields at once; `web/doc-live.js` sends them together).
-/
link_c "js.c"
extern "js_patch" Js.patch : String → IO Unit

def applyEffects (s : DocLive) (payload : String) : DocLive :=
  match Json.parse payload with
  | .error _ => s
  | .ok j => List.foldl (fun acc e =>
      DocLive.effect acc (Json.getStr e "kind") (Json.getStr e "a") (Json.getStr e "b"))
      s (Json.asList j)

def init : Loom.Session DocLive DocLiveMsg := Loom.LiveApp.session docLiveApp

def html (s : Loom.Session DocLive DocLiveMsg) : String := Loom.Session.html s

/-- The panel's first-render hash, the client half of adopt-and-listen: a page that
server-renders `#doc-live` writes `data-wiz-ssr` with the same `Wire.ssrHash` of the
same HTML, and `mount` then adopts the existing nodes instead of replacing them
(`web/framework/adopt.js`). -/
def ssrHash (s : Loom.Session DocLive DocLiveMsg) : String :=
  Wire.ssrHash (Loom.Session.html s)

def patched (s : Loom.Session DocLive DocLiveMsg) (next : DocLive) : IO (Loom.Session DocLive DocLiveMsg) := do
  let r := Loom.LiveApp.effectSessionJson docLiveApp s next;
  Js.patch r.2;
  IO.pure r.1

def step (s : Loom.Session DocLive DocLiveMsg) (ev : String) : IO (Loom.Session DocLive DocLiveMsg) := do
  let r := Loom.LiveApp.stepSessionJson docLiveApp s ev;
  Js.patch r.2;
  IO.pure r.1

def effect (s : Loom.Session DocLive DocLiveMsg) (kind a b : String) :
    IO (Loom.Session DocLive DocLiveMsg) :=
  patched s (if String.eq kind "batch" then applyEffects s.state a
    else DocLive.effect s.state kind a b)

def requests (s : Loom.Session DocLive DocLiveMsg) : String := DocLive.requests s.state

export "wiz_loom_init" init
export "wiz_loom_html" html
export "wiz_loom_ssr_hash" ssrHash
export "wiz_loom_step" step
export "wiz_loom_effect" effect
export "wiz_loom_requests" requests
