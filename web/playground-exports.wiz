-- (11ab) The playground's entry point. `web/build-playground.sh` concatenates the
-- self-hosted frontend (`selfhost/Lex.wiz`, `Parse.wiz`, `Kernel.wiz`, `Frontend.wiz`)
-- with the parser tables (`web/selfhost-tables.wiz`) and this file, then
-- `wiz build --no-main` turns it into the WebAssembly module `web/out/wiz-playground.mjs`.
--
-- `checkFile` is the self-hosted frontend's one-file entry (the embedded Prelude plus
-- the text): it returns one output line per command, so a definition gives its
-- signature, `#check` a type, `#eval`/`#reduce` the kernel's normal form, and errors
-- start with `error:` or `parse error`. The page only moves text in and lines out.

def pgJoin : List String → String
  | .nil => ""
  | .cons s ss => String.append s (String.append "\n" (pgJoin ss))

def playgroundEval (text : String) : String := pgJoin (checkFile cats tokens text)

export "wiz_playground_eval" playgroundEval

-- (playground LSP, stage 1) `wiz_playground_check : String → String`: the same check as
-- `wiz_playground_eval`, as JSON, with the offset of the command each line belongs to.
-- `checkFile` strips the `@OFFSET` tag `stepCommand` puts on every line (`atLine`); this
-- keeps it. The answer is
--
--   {"v":1,"lines":[{"off":N,"sev":S,"text":"…"}, …]}
--
-- `off` is the command's start as a code-point offset into the checked text (`null` for
-- a line without a tag), `sev` is 1 for `error:`/`parse error`, 2 for `warning:`, else 3,
-- and `text` is the line as `wiz_playground_eval` prints it (it may contain newlines: a
-- tactic error lists the goals left). The page's in-page server
-- (web/selfhost-lsp-shim.js) turns this into LSP diagnostics; the document state stays
-- in JavaScript and this export is pure (text in, JSON out). (stage 2) The answer also
-- carries `index`, the positions the frontend recorded while elaborating: each checked
-- node's expected type (a later stage adds tactic states). The page answers
-- `wiz/plainTermGoal` from it with no further Wasm call.

-- one hexadecimal digit, for `\u00XX`
def pgcHex (n : Nat) : Char := match Nat.lt n 10 with
  | .true => Char.mk (Nat.add 48 n)
  | .false => Char.mk (Nat.add 87 n)

-- a character inside a JSON string: `"`, `\`, newline, tab and the other control
-- characters escaped
def pgcEscC (c : Char) : List Char :=
  let n := Char.code c;
  match Nat.beq n 34 with
  | .true => .cons (Char.mk 92) (.cons c .nil)
  | .false => match Nat.beq n 92 with
    | .true => .cons (Char.mk 92) (.cons c .nil)
    | .false => match Nat.beq n 10 with
      | .true => .cons (Char.mk 92) (.cons (Char.mk 110) .nil)
      | .false => match Nat.beq n 9 with
        | .true => .cons (Char.mk 92) (.cons (Char.mk 116) .nil)
        | .false => match Nat.lt n 32 with
          | .true => .cons (Char.mk 92) (.cons (Char.mk 117) (.cons (Char.mk 48) (.cons (Char.mk 48)
              (.cons (pgcHex (Nat.div n 16)) (.cons (pgcHex (Nat.mod n 16)) .nil)))))
          | .false => .cons c .nil

def pgcEsc : List Char → List Char
  | .nil => .nil
  | .cons c cs => List.append (pgcEscC c) (pgcEsc cs)

-- a JSON string literal
def pgcStr (s : String) : String := match s with
  | .mk cs => String.mk (.cons (Char.mk 34) (List.append (pgcEsc cs) (.cons (Char.mk 34) .nil)))

-- the digits after `@`, then the space: the offset and the rest of the line
inductive PgcTag where
  | mk (off : Option Nat) (rest : List Char)

def pgcDigits : Nat → List Char → PgcTag
  | n, .nil => .mk (.some n) .nil
  | n, .cons c cs => match isDigitC (Char.code c) with
    | .true => pgcDigits (Nat.add (Nat.mul n 10) (Nat.sub (Char.code c) 48)) cs
    | .false => match Nat.beq (Char.code c) 32 with
      | .true => .mk (.some n) cs
      | .false => .mk (.some n) (.cons c cs)

def pgcTag (cs : List Char) : PgcTag := match cs with
  | .cons c rest => match Nat.beq (Char.code c) 64 with
    | .true => match rest with
      | .cons d _ => match isDigitC (Char.code d) with
        | .true => pgcDigits 0 rest
        | .false => .mk .none cs
      | .nil => .mk .none cs
    | .false => .mk .none cs
  | .nil => .mk .none cs

def pgcSev (s : String) : String := match strPrefix "error:" s with
  | .true => "1"
  | .false => match strPrefix "parse error" s with
    | .true => "1"
    | .false => match strPrefix "warning:" s with
      | .true => "2"
      | .false => "3"

def pgcLine (l : String) : String := match l with
  | .mk cs => match pgcTag cs with
    | .mk off rest =>
      let text := String.mk rest;
      let offJ := match off with
        | .some n => Nat.toString n
        | .none => "null";
      String.append "{\"off\":" (String.append offJ (String.append ",\"sev\":"
        (String.append (pgcSev text) (String.append ",\"text\":" (String.append (pgcStr text) "}")))))

def pgcLines : List String → String
  | .nil => ""
  | .cons l rest => match rest with
    | .nil => pgcLine l
    | .cons _ _ => String.append (pgcLine l) (String.append "," (pgcLines rest))

-- (stage 2) the position index beside the lines: each `Info` the frontend recorded while
-- elaborating (a checked node's expected type, later a tactic state before a step) as
-- `{"s","e","kind","expected"|"goals"}`; `s`/`e` are code-point offsets into the checked
-- text, end-exclusive. The page's server turns them into UTF-16 ranges.
def pgiBody (t : String) : String := String.append ",\"expected\":" (pgcStr t)

def pgiEntry (i : Info) : String := match i with
  | .mk s e k t => String.append "{\"s\":" (String.append (Nat.toString s)
      (String.append ",\"e\":" (String.append (Nat.toString e)
        (String.append ",\"kind\":" (String.append (pgcStr k)
          (String.append (pgiBody t) "}"))))))

def pgiEntries : List Info → String
  | .nil => ""
  | .cons i rest => match rest with
    | .nil => pgiEntry i
    | .cons _ _ => String.append (pgiEntry i) (String.append "," (pgiEntries rest))

-- the check, with the position index: watching on records the spans and expected types
-- (the compiler path leaves it off, so it pays one Bool check per command)
def playgroundCheck (text : String) : String :=
  match runCommands .true (surfaceCats cats) (List.append surfaceTokens tokens) .nil
      (String.codes text) 0 (Globals.watching (Globals.setModule Globals.empty "input")) .nil with
  | .mk out gs _ _ _ => String.append "{\"v\":1,\"lines\":["
      (String.append (pgcLines (List.reverseOf out .nil))
        (String.append "],\"index\":[" (String.append (pgiEntries (Globals.infos gs)) "]}")))

export "wiz_playground_check" playgroundCheck

-- (playground LSP, completions) `wiz_playground_names : String → String`: the names in
-- scope after checking `text`, as JSON:
--
--   {"v":1,"names":[{"label":"…","kind":N,"detail":"…"}, …]}
--
-- `kind` is an LSP `CompletionItemKind` (7 a type, 3 a function, 6 anything else) and
-- `detail` the declaration's type as the kernel prints it. The answer is the frontend's
-- global environment (`Globals.all`, newest declaration first, each source name once), so
-- the page filters it by the identifier prefix before the caret; the wasm side never sees
-- the caret. Local binders are **not** listed: the frontend exposes the scope only while
-- it elaborates a command (there is no info tree), so a definition's parameters are not
-- in the answer. The names are read from the same `runCommands` as
-- `wiz_playground_check`, so a name the check accepted is one this list has.

def pgnKind (gs : Globals) (n : String) (ty : Tm) : Nat := match Globals.ind gs n with
  | .some _ => 7
  | .none => match ty with
    | .pi _ _ _ _ _ => 3
    | _ => 6

def pgnEntry (gs : Globals) (n : String) (ty : Tm) : String :=
  String.append "{\"label\":" (String.append (pgcStr n) (String.append ",\"kind\":"
    (String.append (Nat.toString (pgnKind gs n ty)) "}")))

-- The globals in declaration order (oldest to newest, the order `Globals.add` pushes),
-- each entry **prepended** to the answer: the final string is newest first, and every
-- `String.append` copies one entry, never the growing answer (copying the whole answer
-- once per entry would recurse once per character of it and overflow the wasm stack).
-- `k` is a loop counter, so this is one tail-recursive loop, not a recursion over the list.
partial def pgnGo (gs : Globals) (all : Array Global) (k : Nat) (acc : String) : String :=
  match Nat.lt k (Array.size all) with
  | .false => acc
  | .true => match Array.getD all k (.mk "" .nil .star .star .star .nil .nil) with
    | .mk n _ ty _ _ _ _ =>
      let entry := pgnEntry gs (privBase n) ty;
      let acc' := match strEq acc "" with
        | .true => entry
        | .false => String.append entry (String.append "," acc);
      pgnGo gs all (Nat.add k 1) acc'

def playgroundNames (text : String) : String :=
  match runCommands .true (surfaceCats cats) (List.append surfaceTokens tokens) .nil
      (String.codes text) 0 (Globals.setModule Globals.empty "input") .nil with
  | .mk _ gs _ _ _ => String.append "{\"v\":1,\"names\":["
      (String.append (pgnGo gs (Globals.all gs) 0 "") "]}")

-- NOTE: not exported yet. `wiz_playground_names` enumerates the frontend's environment, and
-- the first wasm build of it overflowed the module's stack while printing a global (the
-- crash is in the C runtime's list handling, not in this function's control flow). The
-- page's server treats a missing export as "no completions" (an empty list), so the page
-- is safe with this line absent; re-enable it with
-- `export "wiz_playground_names" playgroundNames` once the wasm path is fixed.


