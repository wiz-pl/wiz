-- The fixture `web/playground_ui_test.mjs` checks: three models of the playground's right
-- pane, their SSR HTML, and the patches between two of them. `web/test-playground-ui.sh`
-- concatenates `web/ui-framework.wiz`, `web/playground-ui.wiz` and this file, then runs
-- it with `wiz run` (no Emscripten, no browser).
--
--   .lake/build/bin/wiz run <the concatenated file>
--
-- The models are built as `Json` values and rendered to text, so the decode path the page
-- takes (`Json.parse` on the browser's JSON) is exercised too. `IO`/`Json` come from
-- web/ui-framework.wiz, which precedes this file in the concatenation.

def lineJ (kind text : String) : Json :=
  Json.mkObj [Json.field "kind" (Json.mkStr kind), Json.field "text" (Json.mkStr text)]

def modelOf (count : String) (lines : List Json) (goals : String) : String :=
  Json.render (Json.mkObj [
    Json.field "count" (Json.mkStr count),
    Json.field "lines" (Json.mkArr lines),
    Json.field "goals" (Json.mkStr goals)])

def model0 : String := modelOf "2 lines" [
  lineJ "val" "42",
  lineJ "val" "twice : (x0 : Nat) → Nat"
] "<div class=\"nothing\">nothing at the cursor</div>"

def model1 : String := modelOf "3 lines · 1 error" [
  lineJ "val" "42",
  lineJ "val" "twice : (x0 : Nat) → Nat",
  lineJ "err" "error: unknown identifier nope"
] "<div class=\"lsp-view\" data-state=\"open\"><div class=\"goal\"><span class=\"names\">n</span> : Nat</div></div>"

-- A line that looks like markup must be escaped by the renderer, not inserted.
def modelEscaped : String := modelOf "1 line" [
  lineJ "err" "<script>alert('x')</script>"
] "<div class=\"nothing\">nothing</div>"

-- A model the page could send when nothing has run yet: an empty pane.
def modelEmpty : String := modelOf "" List.nil ""

def jstr (s : String) : Json := Json.mkStr s

def main : IO Unit := do
  IO.println (Json.render (Json.mkObj [
    Json.field "model0" (jstr model0),
    Json.field "html0" (jstr (Ui.renderHtml model0)),
    Json.field "model1" (jstr model1),
    Json.field "html1" (jstr (Ui.renderHtml model1)),
    Json.field "patches" (jstr (Ui.renderPatches model0 model1)),
    Json.field "escaped" (jstr (Ui.renderHtml modelEscaped)),
    Json.field "empty" (jstr (Ui.renderHtml modelEmpty))
  ]))
