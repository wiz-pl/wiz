import Storage
import Optic
/-!
# The index bucket as a profunctor traversal

The engine's `Traversal` (`drafts/optics/Traversal.wiz`) is the store encoding: its
`overAll : (A → A) → S → S` records a patch inside each place's backward function.
The profunctor form (`TraversalP`) is the general one: the same optic runs at `Hom`
(update), `ForgetList` (the bucket's contents) and `Writer Δ` (update + write-set in one
pass). This module re-expresses the engine's `indexTraversal` as a `TraversalP` and
checks that the three interpretations agree with the store traversal.

The focus is `U64 × Node` rather than `Node`: the key must be in the focus for the
`Writer` interpretation to name the patch it records. The store encoding hides the key
in the lens closure; a polymorphic optic cannot, because its `P A B` is the only place
the interpretation can see.
-/

def u64 (n : Nat) : U64 := U64.ofNat n

def node1 : Node := Node.mk (U32.ofNat 1) (U64.ofNat 0) (U32.ofNat 7)
def node2 : Node := Node.mk (U32.ofNat 2) (U64.ofNat 0) (U32.ofNat 8)
def node3 : Node := Node.mk (U32.ofNat 1) (U64.ofNat 0) (U32.ofNat 9)
def root0 : Root :=
  Root.mk (U64Map.ofList [(u64 1, node1), (u64 2, node2), (u64 3, node3)])
    (U64Map.empty : U64Map U64)
    (U64Map.empty : U64Map (U64Map (List U64)))
    (u64 0)
def indexDefs : List IndexDef := [kindIndex]
def db0 : Db := Db.mk (u64 0) (Root.rebuildIndex root0 indexDefs) indexDefs
def s0 : Snapshot := Db.snapshot db0

/-- Walk the bucket's keys, running `f` on each `(key, node)` and putting the result
back through the snapshot's recording store. The applicative sequences the deltas (at
`Writer`) or the reads (at `ForgetList`). -/
def indexWanderGo (d : IndexDef) (v : U64) {F : Type → Type} [i : Applicative F]
    (f : U64 × Node → F (U64 × Node)) : List U64 → Snapshot → F Snapshot
  | .nil, s => @Applicative.pure F i Snapshot s
  | .cons id ids, s =>
    match Snapshot.getNode s id with
    | .none => indexWanderGo d v f ids s
    | .some n =>
      @Applicative.seq F i Snapshot Snapshot
        (@Applicative.seq F i (U64 × Node) (Snapshot → Snapshot)
          (@Applicative.pure F i (U64 × Node → Snapshot → Snapshot)
            (fun p => fun s' => Snapshot.record s' id (Patch.ofChange n p.2)))
          (f (id, n)))
        (indexWanderGo d v f ids s)

/-- The bucket's traversal function, named so it can be passed to `traversalOf`. -/
def indexTrav (d : IndexDef) (v : U64) :
    {F : Type → Type} → [i : Applicative F] →
      (U64 × Node → F (U64 × Node)) → Snapshot → F Snapshot :=
  fun {F : Type → Type} [i : Applicative F] f s =>
    indexWanderGo d v f (Root.lookupIndex s.root (IndexDef.uid d) v) s

/-- Every node in the bucket of index `d` at key `v`, as a profunctor traversal. -/
def indexTraversalP (d : IndexDef) (v : U64) :
    TraversalP Snapshot Snapshot (U64 × Node) (U64 × Node) :=
  traversalOf (indexTrav d v)

/-- The read interpretation: the bucket's `(key, node)` entries. -/
def indexViewP (d : IndexDef) (v : U64) (s : Snapshot) : List (U64 × Node) :=
  toListOf (indexTraversalP d v) s

/-- The store encoding's read, for comparison. -/
def indexViewStore (d : IndexDef) (v : U64) (s : Snapshot) : List Node :=
  Traversal.view (indexTraversal d v) s

/-- The write-set the `Writer` interpretation records, folded into a `WriteSet`. -/
def writeSetOf (d : List (U64 × Patch)) : WriteSet :=
  List.foldl (fun ws e => WriteSet.combine ws e.1 e.2) U64Map.empty d

/-- Bump every node in the bucket with the profunctor traversal, recording the write-set
in the same pass. -/
def bumpKindP (v : U64) (s : Snapshot) : Snapshot × WriteSet :=
  let r := overWrite (indexTraversalP kindIndex v)
    (fun p => let n := p.2;
      let n' := { n with count := n.count + 1 };
      match Patch.ofChange n n' with
      | .none => (p, List.nil)
      | .some q => ((p.1, n'), List.cons (p.1, q) List.nil))
    s;
  (r.1, writeSetOf r.2)

/-- The store encoding's update, for comparison. -/
def bumpKindStore (v : U64) (s : Snapshot) : Snapshot :=
  Traversal.overAll (indexTraversal kindIndex v) (fun n => { n with count := n.count + 1 }) s

-- The bucket at `kind = 1` has nodes 1 and 3; `kind = 9` is empty.
#eval List.length (indexViewP kindIndex (u64 1) s0)      -- 2
#eval List.length (indexViewP kindIndex (u64 9) s0)      -- 0
#eval List.length (indexViewStore kindIndex (u64 1) s0)  -- 2

-- The update and the write-set, in one pass.
#eval WriteSet.size (bumpKindP (u64 1) s0).2             -- 2
#eval WriteSet.size (bumpKindStore (u64 1) s0).ws        -- 2

/-- The recorded patch for `id` is `addCount 1` (the delta `Patch.ofChange` inferred). -/
def addOneAt (ws : WriteSet) (id : U64) : Bool :=
  match U64Map.find ws id with
  | .some p => Patch.beq p (.addCount (u64 1))
  | .none => .false

#eval addOneAt (bumpKindP (u64 1) s0).2 (u64 1)          -- .true
#eval addOneAt (bumpKindP (u64 1) s0).2 (u64 3)          -- .true
#eval addOneAt (bumpKindP (u64 1) s0).2 (u64 2)          -- .false
#eval addOneAt (bumpKindStore (u64 1) s0).ws (u64 1)     -- .true
#eval addOneAt (bumpKindStore (u64 1) s0).ws (u64 3)     -- .true

-- The two updates agree on the nodes they touched (counts 1 and 1, node 2 unchanged).
def countAt (s : Snapshot) (id : U64) : Nat :=
  match Snapshot.getNode s id with
  | .none => 0
  | .some n => n.count.toNat

#eval countAt (bumpKindP (u64 1) s0).1 (u64 1)           -- 1
#eval countAt (bumpKindP (u64 1) s0).1 (u64 3)           -- 1
#eval countAt (bumpKindP (u64 1) s0).1 (u64 2)           -- 0
#eval countAt (bumpKindStore (u64 1) s0) (u64 1)         -- 1
#eval countAt (bumpKindStore (u64 1) s0) (u64 3)         -- 1
#eval countAt (bumpKindStore (u64 1) s0) (u64 2)         -- 0
