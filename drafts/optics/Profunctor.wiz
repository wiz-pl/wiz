import Prelude
import Functor
import Logic
/-!
# Profunctor optics (draft)

The van Laarhoven/profunctor encoding of optics, `P : Type → Type → Type`:

    Iso       S T A B := {P} → [Profunctor P]                → P A B → P S T
    Lens      S T A B := {P} → [Profunctor P] → [Strong P]    → P A B → P S T
    Prism     S T A B := {P} → [Profunctor P] → [Choice P]    → P A B → P S T
    Traversal S T A B := {P} → [Profunctor P] → [Wandering P] → P A B → P S T

`P` is an ordinary parameter (a `Π` over `Type → Type → Type`), so no rank-2
`∀` is needed: the caller of an optic picks `P` and its instances. The engine's
`over` is the `Hom` interpretation; `view` is `Forget`; `toListOf` is `ForgetList`; and
recording an update (the engine's write-set) is the `Writer Δ` interpretation.

In Wiz a superclass is an instance-implicit parameter of the class (`[super :
Profunctor P]`), not `extends`; every signature that forms `Strong P` therefore also
carries `[Profunctor P]`. At a variable `P` a class method is applied with `@`
(`@Strong.first' P d i …`), because instance search does not run on a variable head.

Names ending in `P` are the profunctor optics (`LensP`, `PrismP`, `TraversalP`,
`IsoP`) so that they can coexist with the store encoding's `Lens`/`PLens`/`Traversal`
in `lib/Optic.wiz` and `drafts/optics/Traversal.wiz` (Wiz has no namespaces).
-/

-- ## Sums (the `Choice` side)

/-- A disjoint sum, the type `Choice` acts on. (lib/Eff.wiz's `Sum` carries the effect
row vocabulary; this one is only the optic's coproduct.) -/
inductive Coprod (A B : Type) where
  | inl (a : A)
  | inr (b : B)

-- ## The classes

/-- A profunctor: `dimap` maps both ends, contravariantly in the source. -/
class Profunctor (P : Type → Type → Type) where
  dimap : {A B C D : Type} → (A → B) → (C → D) → P B C → P A D

/-- `Strong`: the profunctor can carry a context `C` alongside (`first'`). -/
class Strong (P : Type → Type → Type) [super : Profunctor P] where
  first' : {A B C : Type} → P A B → P (A × C) (B × C)

/-- `Choice`: the profunctor can carry a sum (`left'`). -/
class Choice (P : Type → Type → Type) [super : Profunctor P] where
  left' : {A B C : Type} → P A B → P (Coprod A C) (Coprod B C)

/-- `Wandering`: the profunctor can visit any number of foci (the traversal power). The
argument is the traversal itself, polymorphic in an applicative `F`. -/
class Wandering (P : Type → Type → Type) [super : Profunctor P] where
  wander : {A B S T : Type} →
    ({F : Type → Type} → [i : Applicative F] → (A → F B) → S → F T) → P A B → P S T

/-- `lmap`: map the source. -/
def Profunctor.lmap {P : Type → Type → Type} [d : Profunctor P] {A B C : Type}
    (f : A → B) (x : P B C) : P A C :=
  @Profunctor.dimap P d A B C C f (fun c => c) x
/-- `rmap`: map the target. -/
def Profunctor.rmap {P : Type → Type → Type} [d : Profunctor P] {A B C : Type}
    (g : B → C) (x : P A B) : P A C :=
  @Profunctor.dimap P d A A B C (fun a => a) g x

/-- The second component of a pair, from `first'` and a swap. -/
def Strong.second' {P : Type → Type → Type} [d : Profunctor P] [i : Strong P]
    {A B C : Type} (x : P A B) : P (C × A) (C × B) :=
  @Profunctor.dimap P d (C × A) (A × C) (B × C) (C × B)
    (fun ca => (ca.2, ca.1)) (fun bc => (bc.2, bc.1))
    (@Strong.first' P d i A B C x)

/-- The right injection of a sum, from `left'` and a swap. -/
def Choice.right' {P : Type → Type → Type} [d : Profunctor P] [c : Choice P]
    {A B C : Type} (x : P A B) : P (Coprod C A) (Coprod C B) :=
  @Profunctor.dimap P d (Coprod C A) (Coprod A C) (Coprod B C) (Coprod C B)
    (fun ca => match ca with | .inl c => .inr c | .inr a => .inl a)
    (fun cb => match cb with | .inl b => .inr b | .inr c => .inl c)
    (@Choice.left' P d c A B C x)

-- ## The optics

/-- An iso: a profunctor transformer for any `Profunctor`. -/
def Iso (S T A B : Type) : Type 1 :=
  {P : Type → Type → Type} → [pf : Profunctor P] → (P A B → P S T)
/-- A lens: `Strong` (a focus in a product context). -/
def LensP (S T A B : Type) : Type 1 :=
  {P : Type → Type → Type} → [pf : Profunctor P] → [st : Strong P] → (P A B → P S T)
/-- A prism: `Choice` (a focus in a sum context). -/
def PrismP (S T A B : Type) : Type 1 :=
  {P : Type → Type → Type} → [pf : Profunctor P] → [ch : Choice P] → (P A B → P S T)
/-- A traversal: `Wandering` (any number of foci). -/
def TraversalP (S T A B : Type) : Type 1 :=
  {P : Type → Type → Type} → [pf : Profunctor P] → [wd : Wandering P] →
    (P A B → P S T)

/-- An iso from `to : S → A` and `from : B → T`. -/
def iso {S T A B : Type} (to : S → A) (from : B → T) : Iso S T A B :=
  fun {P : Type → Type → Type} [d : Profunctor P] =>
    @Profunctor.dimap P d S A B T to from

/-- A lens from `get` and `put`: `s ↦ (get s, s)` through `first'`. -/
def lens {S T A B : Type} (get : S → A) (put : S → B → T) : LensP S T A B :=
  fun {P : Type → Type → Type} [d : Profunctor P] [i : Strong P] (x : P A B) =>
    @Profunctor.dimap P d S (A × S) (B × S) T
      (fun s => (get s, s))
      (fun bs => put bs.2 bs.1)
      (@Strong.first' P d i A B S x)

/-- A prism from a matcher `S → A ⊕ T` (`.inl` is a focus; `.inr` is the rebuilt
non-match) and a builder `B → T`. -/
def prism {S T A B : Type} (matchS : S → Coprod A T) (build : B → T) :
    PrismP S T A B :=
  fun {P : Type → Type → Type} [d : Profunctor P] [c : Choice P] (x : P A B) =>
    @Profunctor.dimap P d S (Coprod A T) (Coprod B T) T
      matchS
      (fun cb => match cb with | .inl b => build b | .inr t => t)
      (@Choice.left' P d c A B T x)

/-- A traversal from a `traverse`-shaped function. -/
def traversalOf {S T A B : Type}
    (trav : {F : Type → Type} → [i : Applicative F] → (A → F B) → S → F T) :
    TraversalP S T A B :=
  fun {P : Type → Type → Type} [d : Profunctor P] [w : Wandering P] (x : P A B) =>
    @Wandering.wander P d w A B S T trav x

-- ## Interpretations

/-- `Hom`: the update interpretation (`P A B = A → B`). -/
def Hom (A B : Type) : Type := A → B
/-- `Id`: the identity applicative, used to run a traversal at `Hom`. -/
def Id (A : Type) : Type := A
/-- `Forget R`: the read-one interpretation (`P S T = S → R`). -/
def Forget (R S T : Type) : Type := S → R
/-- `ForgetList R`: the read-many interpretation (`P S T = S → List R`). -/
def ForgetList (R S T : Type) : Type := S → List R
/-- `ForgetOpt R`: the read-at-most-one interpretation (`P S T = S → Option R`). -/
def ForgetOpt (R S T : Type) : Type := S → Option R
/-- `ConstList R`: the constant applicative used by `ForgetList`'s `wander`. -/
def ConstList (R X : Type) : Type := List R

/-- `Writer Δ`: an update that also records a delta (`P S T = S → T × Δ`). -/
def Writer (M S T : Type) : Type := S → T × M
/-- The writer applicative `X ↦ X × Δ`. -/
def WriterF (M X : Type) : Type := X × M

instance : Profunctor Hom where
  dimap := fun f g h => fun a => g (h (f a))
instance : Strong Hom where
  first' := fun h ac => (h ac.1, ac.2)
instance : Choice Hom where
  left' := fun h x => match x with
    | .inl a => .inl (h a)
    | .inr c => .inr c
instance : Applicative Id where
  pure := fun a => a
  seq := fun f a => f a
instance : Wandering Hom where
  wander := fun (trav : {F : Type → Type} → [i : Applicative F] → (A → F B) → S → F T)
      (h : A → B) (s : S) => trav (F := Id) (fun a => h a) s

instance {R : Type} : Profunctor (Forget R) where
  dimap := fun f g h => fun a => h (f a)
instance {R : Type} : Strong (Forget R) where
  first' := fun h ac => h ac.1

instance {R : Type} : Profunctor (ForgetList R) where
  dimap := fun f g h => fun a => h (f a)
instance {R : Type} : Strong (ForgetList R) where
  first' := fun h ac => h ac.1
instance {R : Type} : Choice (ForgetList R) where
  left' := fun h x => match x with
    | .inl a => h a
    | .inr c => List.nil
instance {R : Type} : Applicative (ConstList R) where
  pure := fun x => List.nil
  seq := fun xs ys => List.append xs ys
instance {ω R : Type} : Wandering (ForgetList R) where
  wander := fun (trav : {F : Type → Type} → [i : Applicative F] → (A → F B) → S → F T)
      (h : A → List R) (s : S) => trav (F := ConstList R) h s

instance {R : Type} : Profunctor (ForgetOpt R) where
  dimap := fun f g h => fun a => h (f a)
instance {R : Type} : Strong (ForgetOpt R) where
  first' := fun h ac => h ac.1
instance {R : Type} : Choice (ForgetOpt R) where
  left' := fun h x => match x with
    | .inl a => h a
    | .inr c => Option.none

/-- The monoid of deltas a `Writer` interpretation accumulates. -/
class Delta (M : Type) where
  empty : M
  append : M → M → M
/-- Lists are the delta monoid of independent records. -/
instance {A : Type} : Delta (List A) where
  empty := List.nil
  append := List.append

instance {M : Type} [m : Delta M] : Applicative (WriterF M) where
  pure := fun x => (x, Delta.empty)
  seq := fun gd xd => (gd.1 xd.1, Delta.append gd.2 xd.2)
instance {M : Type} : Profunctor (Writer M) where
  dimap := fun f g h => fun a => let r := h (f a); (g r.1, r.2)
instance {M : Type} : Strong (Writer M) where
  first' := fun h ac => let r := h ac.1; ((r.1, ac.2), r.2)
instance {M : Type} [m : Delta M] : Choice (Writer M) where
  left' := fun h x => match x with
    | .inl a => let r := h a; (.inl r.1, r.2)
    | .inr c => (.inr c, Delta.empty)
instance {ω M : Type} [m : Delta M] : Wandering (Writer M) where
  wander := fun (trav : {F : Type → Type} → [i : Applicative F] → (A → F B) → S → F T)
      (h : A → B × M) (s : S) => trav (F := WriterF M) h s

-- ## Reading and writing

/-- `view`: run a lens at `Forget`. -/
def view {S : Type} {ω A : Type} (l : LensP S S A A) (s : S) : A :=
  l (P := Forget A) (fun a => a) s
/-- `over`: run a lens at `Hom`. -/
def over {S T A B : Type} (l : LensP S T A B) (f : A → B) (s : S) : T :=
  l (P := Hom) f s
/-- `set`: `over` with a constant. -/
def set {S T A B : Type} (l : LensP S T A B) (b : B) (s : S) : T :=
  over l (fun a => b) s
/-- `toListOf` for a traversal: run it at `ForgetList`. -/
def toListOf {S T B : Type} {ω A : Type} (tr : TraversalP S T A B) (s : S) : List A :=
  tr (P := ForgetList A) (fun a => List.cons a List.nil) s
/-- `toListOf` for a prism: the same `ForgetList` interpretation, typed at `PrismP`. -/
def toListOfP {S T B : Type} {ω A : Type} (pr : PrismP S T A B) (s : S) : List A :=
  pr (P := ForgetList A) (fun a => List.cons a List.nil) s
/-- `preview`: run a prism at `ForgetOpt`. -/
def preview {S : Type} {ω A : Type} (pr : PrismP S S A A) (s : S) : Option A :=
  pr (P := ForgetOpt A) (fun a => Option.some a) s
/-- `over` for a traversal. -/
def overT {S T A B : Type} (tr : TraversalP S T A B) (f : A → B) (s : S) : T :=
  tr (P := Hom) f s
/-- `over` for a prism. -/
def overP {S T A B : Type} (pr : PrismP S T A B) (f : A → B) (s : S) : T :=
  pr (P := Hom) f s
/-- `over` for an iso. -/
def overI {S T A B : Type} (i : Iso S T A B) (f : A → B) (s : S) : T :=
  i (P := Hom) f s
/-- `view` for an iso (the `Forget` interpretation is a profunctor). -/
def viewI {S : Type} {ω A : Type} (i : Iso S S A A) (s : S) : A :=
  i (P := Forget A) (fun a => a) s
/-- `over` that records a delta: the write-set interpretation. `f` returns the new focus
and the delta for it; the optic composes the deltas with `Delta.append`. -/
def overWrite {S T A B : Type} {ω M : Type} [m : Delta M] (tr : TraversalP S T A B)
    (f : A → B × M) (s : S) : T × M :=
  tr (P := Writer M) f s
/-- The lens version of `overWrite`. -/
def overWriteL {S T A B : Type} {ω M : Type} [m : Delta M] (l : LensP S T A B)
    (f : A → B × M) (s : S) : T × M :=
  l (P := Writer M) f s
/-- The prism version of `overWrite`. -/
def overWriteP {S T A B : Type} {ω M : Type} [m : Delta M] (pr : PrismP S T A B)
    (f : A → B × M) (s : S) : T × M :=
  pr (P := Writer M) f s

-- ## Composition

/-- Compose two lenses (`s.f.g`). -/
def LensP.comp {S T A B C D : Type} (l : LensP S T A B) (m : LensP A B C D) :
    LensP S T C D :=
  fun {P : Type → Type → Type} [pf : Profunctor P] [st : Strong P] (x : P C D) =>
    l (P := P) (m (P := P) x)
/-- Compose two traversals (every focus of the inner under every focus of the outer). -/
def TraversalP.comp {S T A B C D : Type} (l : TraversalP S T A B)
    (m : TraversalP A B C D) : TraversalP S T C D :=
  fun {P : Type → Type → Type} [pf : Profunctor P] [wd : Wandering P] (x : P C D) =>
    l (P := P) (m (P := P) x)
/-- Compose two prisms. -/
def PrismP.comp {S T A B C D : Type} (l : PrismP S T A B) (m : PrismP A B C D) :
    PrismP S T C D :=
  fun {P : Type → Type → Type} [pf : Profunctor P] [ch : Choice P] (x : P C D) =>
    l (P := P) (m (P := P) x)
/-- Compose two isos. -/
def IsoP.comp {S T A B C D : Type} (l : Iso S T A B) (m : Iso A B C D) :
    Iso S T C D :=
  fun {P : Type → Type → Type} [pf : Profunctor P] (x : P C D) =>
    l (P := P) (m (P := P) x)

-- ## Common optics

/-- The first component of a pair, as a profunctor lens. -/
def fstL {A C : Type} : LensP (A × C) (A × C) A A :=
  fun {P : Type → Type → Type} [d : Profunctor P] [i : Strong P] =>
    @Strong.first' P d i A A C
/-- The second component of a pair. -/
def sndL {A C : Type} : LensP (C × A) (C × A) A A :=
  fun {P : Type → Type → Type} [d : Profunctor P] [i : Strong P] =>
    @Strong.second' P d i A A C

/-- Every element of a list, as a traversal. -/
def listWander {A B : Type} {F : Type → Type} [i : Applicative F] (f : A → F B) :
    List A → F (List B)
  | .nil => @Applicative.pure F i (List B) (List.nil)
  | .cons x xs =>
    @Applicative.seq F i (List B) (List B)
      (@Applicative.seq F i B (List B → List B)
        (@Applicative.pure F i (B → List B → List B) (fun b bs => List.cons b bs))
        (f x))
      (listWander f xs)
/-- The list traversal function, named so it can be passed to `traversalOf`. -/
def listTrav {A : Type} : {F : Type → Type} → [i : Applicative F] →
    (A → F A) → List A → F (List A) :=
  fun {F : Type → Type} [i : Applicative F] f xs => listWander (A := A) (B := A) f xs
/-- The list traversal. -/
def listT {A : Type} : TraversalP (List A) (List A) A A := traversalOf listTrav
/-- The head of a list, as a prism (0 or 1 focus). -/
def headP {A : Type} : PrismP (List A) (List A) A A :=
  prism
    (fun s => match s with
      | .nil => .inr List.nil
      | .cons x xs => .inl x)
    (fun a => List.cons a List.nil)

-- ## Laws

/-- `dimap id id = id`. -/
def Profunctor.Lawful (P : Type → Type → Type) [d : Profunctor P] : Prop :=
  {A B : Type} → (x : P A B) →
    @Profunctor.dimap P d A A B B (fun a => a) (fun b => b) x = x

/-- `first'` is natural in both ends. -/
def Strong.Lawful (P : Type → Type → Type) [d : Profunctor P] [i : Strong P] : Prop :=
  {A A' B B' C : Type} → (f : A' → A) → (g : B → B') → (x : P A B) →
    @Strong.first' P d i A' B' C (@Profunctor.dimap P d A' A B B' f g x) =
    @Profunctor.dimap P d (A' × C) (A × C) (B × C) (B' × C)
      (fun ac => (f ac.1, ac.2)) (fun bc => (g bc.1, bc.2))
      (@Strong.first' P d i A B C x)

/-- `left'` is natural in both ends. -/
def Choice.Lawful (P : Type → Type → Type) [d : Profunctor P] [c : Choice P] : Prop :=
  {A A' B B' C : Type} → (f : A' → A) → (g : B → B') → (x : P A B) →
    @Choice.left' P d c A' B' C (@Profunctor.dimap P d A' A B B' f g x) =
    @Profunctor.dimap P d (Coprod A' C) (Coprod A C) (Coprod B C) (Coprod B' C)
      (fun ac => match ac with | .inl a => .inl (f a) | .inr c => .inr c)
      (fun bc => match bc with | .inl b => .inl (g b) | .inr c => .inr c)
      (@Choice.left' P d c A B C x)

/-- The identity traversal, as a named function. -/
def idTrav {A : Type} : {F : Type → Type} → [i : Applicative F] →
    (A → F A) → A → F A :=
  fun {F : Type → Type} [i : Applicative F] f a => f a
/-- The identity traversal wanders to the identity. -/
def Wandering.Lawful (P : Type → Type → Type) [d : Profunctor P] [w : Wandering P] : Prop :=
  {A : Type} → (x : P A A) →
    @Wandering.wander P d w A A A A (idTrav (A := A)) x = x

-- The laws hold for the interpretations used here (all by computation; the equations
-- are of functions, so `funext` is available if a pointwise proof is needed).
/-- `Hom` is a lawful profunctor (by `rfl`). -/
def Hom.profunctorLawful : Profunctor.Lawful Hom :=
  fun {A B} x => rfl
/-- `Hom` is a lawful strong profunctor (by `rfl`). -/
def Hom.strongLawful : Strong.Lawful Hom :=
  fun {A A' B B' C} f g x => rfl
/-- `Hom` is a lawful choice profunctor (by `rfl`). -/
def Hom.choiceLawful : Choice.Lawful Hom :=
  fun {A A' B B' C} f g x =>
    funext (fun y => match y with
      | .inl a => rfl
      | .inr c => rfl)
/-- `Hom` is a lawful wandering profunctor (by `rfl`). -/
def Hom.wanderingLawful : Wandering.Lawful Hom :=
  fun {A} x => rfl
/-- `ForgetList R` is a lawful profunctor (by `rfl`). -/
def ForgetList.profunctorLawful {R : Type} : Profunctor.Lawful (ForgetList R) :=
  fun {A B} x => rfl
/-- `ForgetList R` is a lawful strong profunctor (by `rfl`). -/
def ForgetList.strongLawful {R : Type} : Strong.Lawful (ForgetList R) :=
  fun {A A' B B' C} f g x => rfl
/-- `ForgetList R` is a lawful choice profunctor (by `rfl`). -/
def ForgetList.choiceLawful {R : Type} : Choice.Lawful (ForgetList R) :=
  fun {A A' B B' C} f g x =>
    funext (fun y => match y with
      | .inl a => rfl
      | .inr c => rfl)
/-- `ForgetList R` is a lawful wandering profunctor (by `rfl`). -/
def ForgetList.wanderingLawful {ω R : Type} : Wandering.Lawful (ForgetList R) :=
  fun {A} x => rfl

-- ## Lens laws, on the interpretations

/-- GetPut: reading and writing back the same value is the identity. -/
def LensP.GetPut {S A : Type} (l : LensP S S A A) : Prop :=
  (s : S) → over l (fun a => a) s = s
/-- PutGet: a write is what a subsequent read sees. -/
def LensP.PutGet {S A : Type} (l : LensP S S A A) : Prop :=
  (s : S) → (a : A) → view l (over l (fun b => a) s) = a
/-- PutPut: the last write wins. -/
def LensP.PutPut {S A : Type} (l : LensP S S A A) : Prop :=
  (s : S) → (a b : A) → over l (fun c => b) (over l (fun c => a) s) =
    over l (fun c => b) s

-- `fstL`'s three laws are checked on values in `drafts/optics/Tests.wiz` (pair eta is
-- not definitional in Wiz; `lib/Optic.wiz`'s `Optic.pairEq` is the componentwise proof).
