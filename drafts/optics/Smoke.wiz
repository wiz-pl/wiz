import IO
import Optic
import Logic

/-!
# Compiled smoke test

`wiz check` elaborates the optics; this file runs them through the native backend
(`wiz run -I drafts/optics drafts/optics/Smoke.wiz`), so the class dictionaries, the
higher-kinded `P` and the `Writer` interpretation also erase/compile.

Expected output: `3`, `2`, `1`.
-/

def main : IO Unit := do
  let x := viewP fstLP ((3 : Nat), Bool.true);
  let l := toListOfT (listTP (A := Nat)) (List.cons 1 (List.cons 2 List.nil));
  let w := overWriteL fstLP (fun n => (n + 1, List.cons n List.nil)) ((1 : Nat), Bool.true);
  IO.println (Nat.repr x);
  IO.println (Nat.repr (List.length l));
  IO.println (Nat.repr (List.length w.2))
