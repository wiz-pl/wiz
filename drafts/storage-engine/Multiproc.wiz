import Sys
import Word
import Text
import WordMap
import Functor
import MVar
import Scry.QuireStorage
import Scry.QuireRegistry
import Scry.QuireDurable
/-!
# Slice 3b: one writer, many readers, across processes

`Durable.wiz` (with `Registry.wiz`'s retention) makes a process's commits durable.
This module adds the multi-process contract on top of the *same* file format; it does
not change a byte of it:

* a **writer** takes `flock(LOCK_EX)` for the commit section only (`DurableHandle.putDb`), not
  for the transaction. Between `getDb` and `putDb` the transaction is pure and holds no
  lock at all; another process may commit, and the validation at `putDb` decides whether
  this transaction still applies.
* a **reader** takes `flock(LOCK_SH)` for the *handshake* — the two meta slots, a few
  hundred bytes — and then holds a **snapshot lease** (generation, root page, and a
  read-only descriptor) for the life of its cursor. The lease, not a held lock, is what
  makes the cursor stable: pages reachable from a root are never overwritten. A commit
  writes fresh pages and only then publishes a root that names them
  (`Durable.commit`), so the old chain is still there and still verifies under its old
  `txid` while the writer appends and switches slots. This choice is forced by the
  design's "readers never block the writer" (§2.1): a share held for the whole cursor
  would make the writer's exclusive section wait, and the mid-scan-commit test below
  impossible. Compaction replaces the whole file by `rename`; the reader's descriptor
  keeps the old inode, so the same lease survives that too. When a later policy reuses
  pages in one file, the lease becomes a held share or a counted lease, and a commit
  then waits for old readers.
* **validation is inside the exclusive section.** `DurableHandle.putDb` re-reads the meta after
  taking the lock and runs the pure `Db.commit` on that fresh state, plus the retention
  test (`Registry.retained`). The delete epoch, the per-key versions and the retention
  horizon therefore cannot race a commit between the test and the slot switch. A
  transaction that loses the race comes back `rejected` (`stale`, `conflict`, `expired`,
  …); nothing retries it behind the caller's back.
* **abandonment.** A writer that dies mid-commit leaves no lock: `flock` belongs to the
  open file description and the kernel drops it when the process dies. It cannot leave a
  half-switched slot either: the meta slot is written once, at the end, and recovery
  takes the valid slot with the larger `txid` (a torn slot fails its checksum; a valid
  slot whose pages are short fails the chain check and the previous slot is used). The
  pages it had written are unreachable; the generation floor moves past the abandoned
  attempt, and `openDb` trims a tail past the last valid slot.

Limits, stated rather than hidden:

* `flock` is advisory. A process that writes the file without taking the lock is outside
  the contract, exactly as the design note says (§4.2, case 12).
* **compaction is an offline, single-writer operation.** `Compact.compactStore` writes a
  new file and `rename`s it over the path. Readers are fine (their descriptor keeps the
  old inode, and a mapped snapshot keeps its mapping). A writer handle in another
  process still holds the *old* inode and would keep committing there, to a file no
  name points at; such a handle must be reopened after a compaction. Making the swap
  safe against a concurrent committer needs an inode check after the lock is taken
  (and the lock itself on the inode the path names), which the slice-3 format does not
  provide; this slice therefore keeps compaction out of the concurrent contract.
* the writer handle's `MVar` is still the *in-process* single-writer cell. `flock` locks
  an open file description, and two threads sharing one `DurableHandle` share its descriptor,
  so `flock` alone would not separate them (a `LOCK_SH` on a descriptor that holds
  `LOCK_EX` converts it); the `MVar` does. Two handles in one process (two `Fd.open`s)
  have two descriptions, so `flock` does separate them, which is what the two-handle
  test exercises.
-/

-- ## The lock boundary

/-- Run `body` holding `fd`'s `mode` lock, releasing it on every path: success,
rejection, and an I/O error. A process that dies inside the section leaves the release to
the kernel. -/
def EIO.withLock {A : Type} (fd : Fd) (mode : LockMode) (body : EIO A) : EIO A :=
  IO.bind (Fd.lock fd mode) (fun l =>
    match l with
    | .error e => IO.pure (.error e)
    | .ok _ =>
      IO.bind body (fun r =>
        IO.bind (Fd.unlock fd) (fun u =>
          match u with
          | .error e => IO.pure (.error e)
          | .ok _ => IO.pure r)))

-- ## Reading the meta

/-- The on-disk meta slots that pass magic/format/checksum, newest first. -/
def readSlots (fd : Fd) : EIO (List Meta) := do
  a ← readAt fd 0 metaSize;
  b ← readAt fd pageSize metaSize;
  let ma : Option Meta := match a with
    | .none => .none
    | .some x => Meta.decode x;
  let mb : Option Meta := match b with
    | .none => .none
    | .some x => Meta.decode x;
  EIO.pure (validMetas ma mb)

/-- The snapshot handshake: both meta slots under the shared lock, so a commit's slot
switch is either entirely before or entirely after the read. Only the two 96-byte slots
are covered; the page chain is immutable and is read after the lock is dropped, which is
why a commit does not wait for a scan. -/
def readSlotsLocked (fd : Fd) : EIO (List Meta) :=
  EIO.withLock fd .shared (readSlots fd)

/-- The newest slot whose whole chain verifies, with the database it names. The chain is
read without the lock: a checksum-valid slot only names pages that were durable before it
was published, and no later commit writes them. -/
def chooseMetaDb (fd : Fd) (indices : List IndexDef) :
    List Meta → EIO (Option (Meta × Db))
  | .nil => EIO.pure .none
  | .cons m rest => do
    r ← loadChain fd m;
    match r with
    | .some recs => EIO.pure (.some (m, dbOf m recs indices))
    | .none => chooseMetaDb fd indices rest

/-- The meta of an empty (never committed) store, so a reader can still be a lease. -/
def zeroMeta (pages : U64) : Meta :=
  Meta.mk (U64.ofNat 0) (U64.ofNat 0) (U64.ofNat 0) (U64.ofNat 0) (U64.ofNat 0)
    (U64.ofNat 0) (U64.ofNat 0) (U64.ofNat 0) pages

-- ## Readers: a snapshot lease for the life of the cursor

/-- A read-only handle holding a snapshot lease. `db` is the materialised snapshot the
process reads values from; `meta` is the same snapshot's root and generation, which
`scan` follows page by page on disk. The lease is the frozen root plus the never-reuse
rule and the open descriptor (which keeps the inode alive across a compaction), not a
held lock; `open` takes the share only for the meta handshake. -/
structure Reader where
  fd : Fd
  meta : Meta
  db : Db

/-- A page-at-a-time scan of the snapshot's leaf chain. The page numbers and the `txid`
are frozen when the scan starts; a page that does not carry that `txid` is an error, not
a torn read. -/
structure Scan where
  fd : Fd
  txid : U64
  pages : U64
  page : U64

/-- Open a snapshot: a read-only descriptor, the meta handshake under the shared lock,
then the newest chain that verifies (read without the lock: those pages cannot change).
The lease lasts until `Reader.close`. -/
def Reader.open (path : String) (indices : List IndexDef) : EIO Reader := do
  fd ← Fd.open path .read OpenFlags.none;
  ms ← readSlotsLocked fd;
  let pages := maxPages ms;
  r ← chooseMetaDb fd indices ms;
  match r with
  | .some e => EIO.pure (Reader.mk fd e.1 e.2)
  | .none => EIO.pure (Reader.mk fd (zeroMeta pages) (emptyDb indices))

/-- The snapshot's value view (the same immutable `Snapshot` the note's `getDb` returns). -/
def Reader.snapshot (r : Reader) : Snapshot := Db.snapshot r.db

/-- Start a scan of the snapshot's leaf chain. -/
def Reader.scan (r : Reader) : Scan :=
  Scan.mk r.fd r.meta.txid r.meta.pageCount r.meta.root

/-- The next leaf page of the scan, and the scan positioned after it. `none` at the end.
The page is read through the snapshot's descriptor: it must still carry the snapshot's
`txid` and checksum, which is what "reachable pages are never overwritten" buys. -/
def Scan.step (s : Scan) : EIO (Option (List Rec × Scan)) :=
  match Nat.beq s.page.toNat 0 with
  | .true => EIO.pure .none
  | .false =>
    match UIntN.lt s.page s.pages with
    | .false => EIO.fail "scan: page outside the snapshot"
    | .true => do
      r ← readPage s.fd s.txid s.page;
      match r with
      | .none => EIO.fail "scan: a page of the snapshot was overwritten or truncated"
      | .some p => EIO.pure (.some (p.recs, Scan.mk s.fd s.txid s.pages p.right))

/-- Close the reader's descriptor (releasing anything it still holds, though the share is
only taken for the handshake). -/
def Reader.close (r : Reader) : EIO Unit := do
  Fd.unlock r.fd;
  Fd.close r.fd

-- ## The public engine: the same API, now safe across processes

/-- Add roots this process already knows to a freshly recovered registry, keeping each
one whose chain still verifies in *this* file. A root the file no longer holds was
compacted away and drops out, which is what makes its snapshot `expired` at the next
commit. `Registry.add` keeps the newest-first order and the lease counts. -/
def mergeKnown (fd : Fd) (pages : U64) : List RootRef → Registry → EIO Registry
  | .nil, reg => EIO.pure reg
  | .cons r rest, reg =>
    match Registry.find reg r.gen with
    | .some _ => mergeKnown fd pages rest reg
    | .none => do
      c ← loadChainCount fd
        (Meta.mk r.gen r.root (U64.ofNat 0) (U64.ofNat 0) (U64.ofNat 0)
          r.delEpoch (U64.ofNat 0) (U64.ofNat 0) pages);
      match c with
      | .none => mergeKnown fd pages rest reg
      | .some _ => mergeKnown fd pages rest (Registry.add reg r)

/-- The state the file behind `st.fd` holds, with the retention history this process
still remembers. The page chain is read outside any lock (a valid slot names durable,
immutable pages); the caller holds the handle's cell, which is what makes the publish
atomic. -/
def refresh (h : DurableHandle) (st : StoreState) : EIO StoreState := do
  p ← recoverWith st.fd h.indices st.registry.keep;
  reg ← mergeKnown st.fd p.2 (Registry.roots st.registry) p.1.registry;
  EIO.pure { p.1 with registry := Registry.trim reg }

/-- The state behind the meta slots `ms`. If their `txid` is the one this handle already
holds, the in-memory state is returned; otherwise the chain is read (another process
committed). -/
def stateOfSlots (h : DurableHandle) (st : StoreState) (ms : List Meta) : EIO StoreState :=
  match ms with
  -- No checksum-valid slot: the disk is the truth and it holds no commit.
  | .nil => refresh h st
  | .cons _ _ =>
    match UIntN.beq (maxTxid ms) st.db.gen with
    | .true => EIO.pure st
    | .false => refresh h st

/-- The latest snapshot, as the note's `getDb`: the meta slots are read under the shared
lock, so a commit in another process is seen whole or not at all (its slot switch is one
96-byte write, and either the old or the new slot wins the `txid` pick).

The handle's cell is taken for the read as well as for the commit: `flock` belongs to the
open file description, and two threads that share one `DurableHandle` share its descriptor, so a
share taken on a descriptor that already holds the exclusive lock would convert it. One
lock acquisition per descriptor at a time. Concurrent readers in one process use `Reader`
(a descriptor and a share of their own). -/
def refreshAndRead (h : DurableHandle) (st : StoreState) (ms : List Meta) :
    IO (StoreState × Except String Snapshot) :=
  IO.bind (stateOfSlots h st ms) (fun r =>
    match r with
    | .error e => IO.pure (st, .error e)
    | .ok st' => IO.pure (st', .ok (Db.snapshot st'.db)))

def DurableHandle.getDb (h : DurableHandle) : EIO Snapshot :=
  MVar.borrow h.state (fun st hole =>
    IO.bind (readSlotsLocked st.fd) (fun r =>
      match r with
      | .error e => MVar.fill h.state hole st (EIO.fail e : EIO Snapshot)
      | .ok ms =>
        IO.bind (refreshAndRead h st ms) (fun r2 =>
          MVar.fill h.state hole r2.1 (IO.pure r2.2))))

/-- Re-read the meta *inside* the exclusive lock and commit against it, with the
retention test first (exactly `Durable.putDb`, moved under the lock). This is the whole
point of the slice: the state the version/epoch/horizon checks see cannot change before
the slot switch, because no other cooperating writer can be in the section. -/
def commitSection (h : DurableHandle) (st : StoreState) (tx : Snapshot) :
    EIO (StoreState × Except String Outcome) := do
  fresh ← refresh h st;
  match Registry.retained fresh.registry tx.gen with
  | .false =>
    EIO.pure (fresh, .ok (.rejected (.expired tx.gen (Registry.minGen fresh.registry))))
  | .true => EIO.lift (commit fresh.fd fresh tx)

/-- The section without the locking, for callers that already hold the exclusive lock. -/
def commitUnlocked (h : DurableHandle) (st : StoreState) (tx : Snapshot) :
    IO (StoreState × Except String Outcome) := do
  r ← commitSection h st tx;
  match r with
  | .error e => IO.pure (st, .error e)
  | .ok (st', out) => IO.pure (st', out)

/-- Commit with the lock already held, then unlock; the result carries the state to
publish whether the commit committed, rejected, or failed. -/
def commitAndUnlock (h : DurableHandle) (st : StoreState) (tx : Snapshot) :
    IO (StoreState × Except String Outcome) :=
  IO.bind (commitUnlocked h st tx) (fun r =>
    IO.bind (Fd.unlock st.fd) (fun u =>
      match u with
      | .error e => IO.pure (r.1, .error e)
      | .ok _ => IO.pure r))

/-- Commit a transaction, waiting for the writer lock. The transaction's pure part is
already done; the exclusive section is validation plus the page/fsync/meta/fsync
sequence. A transaction that lost a race is `Outcome.rejected` — it is not retried. -/
def DurableHandle.putDb (h : DurableHandle) (tx : Snapshot) : EIO Outcome :=
  MVar.borrow h.state (fun st hole =>
    IO.bind (Fd.lock st.fd .exclusive) (fun l =>
      match l with
      | .error e => MVar.fill h.state hole st (EIO.fail e : EIO Outcome)
      | .ok _ =>
        IO.bind (commitAndUnlock h st tx) (fun r =>
          MVar.fill h.state hole r.1 (IO.pure r.2))))

/-- The result of a commit section, as `DurableHandle.tryPutDb` reports it (`none` is `busy`). -/
def tryPutResult (r : Except String Outcome) : EIO (Option Outcome) :=
  match r with
  | .ok o => EIO.pure (.some o)
  | .error e => EIO.fail e
/-- The non-committed result of `DurableHandle.tryPutDb`: another description held the lock. -/
def tryPutBusy : EIO (Option Outcome) := EIO.pure .none

/-- A non-blocking commit: `none` when another open file description holds the exclusive
lock (the caller decides whether to wait or to report `busy`), `some out` when the
section ran. The typed `busy` of `Fd.tryLock` is surfaced here as `none`. -/
def DurableHandle.tryPutDb (h : DurableHandle) (tx : Snapshot) : EIO (Option Outcome) :=
  MVar.borrow h.state (fun st hole =>
    IO.bind (Fd.tryLock st.fd .exclusive) (fun l =>
      match l with
      | .error e => MVar.fill h.state hole st (EIO.fail e : EIO (Option Outcome))
      | .ok .busy => MVar.fill h.state hole st tryPutBusy
      | .ok .acquired =>
        IO.bind (commitAndUnlock h st tx) (fun r =>
          MVar.fill h.state hole r.1 (tryPutResult r.2))))
