import Sys
import Word
import Text
import Scry.Quire.Storage
import Scry.Quire.Durable
/-!
# The slice-2 file store, exercised end to end

`wiz run drafts/storage-engine/DurableTest.wiz` (compiled: the file natives do not run
under `#eval`). It runs the prototype's `#eval` scenarios against a real file and a
crash-ish case:

* seed, then two `+1`s from the **same** base snapshot: both commit and sum;
* a stale `set` and a unique-index duplicate are rejected;
* a transaction begun before a delete is rejected by the delete epoch;
* close and reopen: the committed state is there;
* a copy truncated by one page (the last commit's root) opens at the previous commit,
  ignores the torn slot, and commits again;
* the reopened truncated file sees that new commit.
-/

def expect (what : String) (b : Bool) : EIO Unit :=
  match b with
  | .true => EIO.pure ()
  | .false => EIO.fail (String.append "check failed: " what)

def succeeded (o : Outcome) : Bool :=
  match o with
  | .committed _ => .true
  | .rejected _ => .false

def snapCount (s : Snapshot) (id : U64) : Nat :=
  match Snapshot.getNode s id with
  | .none => 0
  | .some n => n.count.toNat

def snapHas (s : Snapshot) (id : U64) : Bool :=
  match Snapshot.getNode s id with
  | .some _ => .true
  | .none => .false

def indices : List IndexDef := [kindIndex, uniqueLabel]

/-- The prototype's scenarios, against a file. -/
def cleanTest (path : String) : EIO Unit := do
  h ← openDb path indices;
  s0 ← getDb h;
  oSeed ← putDb h (seedNodes s0);
  expect "seed commits" (succeeded oSeed);
  s1 ← getDb h;
  expect "seed is generation 1" (Nat.beq s1.gen.toNat 1);
  expect "node 1 starts at 0" (Nat.beq (snapCount s1 1) 0);
  expect "node 2 exists" (snapHas s1 2);

  -- one +1 from s1
  oA ← putDb h (bumpCount (U64.ofNat 1) s1);
  expect "first +1 commits" (succeeded oA);
  s2 ← getDb h;
  expect "count is 1" (Nat.beq (snapCount s2 1) 1);

  -- a second +1 from the *same* base s1: it rebases and commits
  oB ← putDb h (bumpCount (U64.ofNat 1) s1);
  expect "second +1 from the same base commits" (succeeded oB);
  s3 ← getDb h;
  expect "the +1s commute: count is 2" (Nat.beq (snapCount s3 1) 2);
  expect "the second +1 is generation 3" (Nat.beq s3.gen.toNat 3);

  -- a `set` computed from s1 is stale
  oSet ← putDb h (setLabel (U64.ofNat 1) (U32.ofNat 9) s1);
  expect "a stale set is rejected" (Bool.not (succeeded oSet));

  -- a unique-index duplicate: node 2 taking node 1's label 7
  oDup ← putDb h (setLabel (U64.ofNat 2) (U32.ofNat 7) s1);
  expect "a unique duplicate is rejected" (Bool.not (succeeded oDup));

  -- delete node 2 from s1 (its version is still the seed's)
  oDel ← putDb h (delNode (U64.ofNat 2) s1);
  expect "the delete commits" (succeeded oDel);
  sDel ← getDb h;
  expect "the delete is generation 4" (Nat.beq sDel.gen.toNat 4);

  -- a transaction that began before the delete is stale, whatever it touches
  oOld ← putDb h (bumpCount (U64.ofNat 1) s1);
  expect "a transaction begun before the delete is rejected"
    (Bool.not (succeeded oOld));
  closeDb h;

  -- restart after a clean close
  h2 ← openDb path indices;
  s4 ← getDb h2;
  expect "reopen keeps generation 4" (Nat.beq s4.gen.toNat 4);
  expect "reopen keeps count 2" (Nat.beq (snapCount s4 1) 2);
  expect "reopen keeps the delete" (Bool.not (snapHas s4 2));

  -- and the recovered store still commits
  oAfter ← putDb h2 (bumpCount (U64.ofNat 1) s4);
  expect "a commit after reopen succeeds" (succeeded oAfter);
  s5 ← getDb h2;
  expect "and it is generation 5" (Nat.beq s5.gen.toNat 5);
  closeDb h2;

  h3 ← openDb path indices;
  s6 ← getDb h3;
  expect "the post-reopen commit is durable" (Nat.beq s6.gen.toNat 5);
  expect "and count is 3" (Nat.beq (snapCount s6 1) 3);
  closeDb h3

/-- Truncate a copy by one page: the last commit's root page is gone while its meta
slot (page 1) still checksum-validates. Recovery must use the previous slot. -/
def tornTest (dir : String) : EIO Unit := do
  let path := Path.join dir "torn.db";
  h ← openDb path indices;
  s0 ← getDb h;
  oSeed ← putDb h (seedNodes s0);
  expect "torn seed commits" (succeeded oSeed);
  s1 ← getDb h;
  oA ← putDb h (bumpCount (U64.ofNat 1) s1);
  expect "torn first commit" (succeeded oA);
  s2 ← getDb h;
  oB ← putDb h (bumpCount (U64.ofNat 1) s2);
  expect "torn second commit" (succeeded oB);
  s3 ← getDb h;
  expect "torn store is at generation 3" (Nat.beq s3.gen.toNat 3);
  expect "torn store count is 2" (Nat.beq (snapCount s3 1) 2);
  closeDb h;

  -- The by-hand truncation: cut a copy at the previous commit's page count, so the
  -- last commit's data page(s) *and* its registry page are gone (the registry is part
  -- of the commit, not an extra page after the root).
  bytes ← FS.readBytes path;
  oldFd ← Fd.open path .read OpenFlags.none;
  raw ← readAt oldFd (slotOffset (U64.ofNat 2)) metaSize;
  Fd.close oldFd;
  let cut := match raw with
    | .none => Nat.sub (Bytes.size bytes) pageSize
    | .some b => match Meta.decode b with
      | .none => Nat.sub (Bytes.size bytes) pageSize
      | .some m => Nat.mul m.pageCount.toNat pageSize;
  let truncated := Bytes.slice bytes 0 cut;
  let tpath := Path.join dir "torn-cut.db";
  FS.writeBytes tpath truncated;

  ht ← openDb tpath indices;
  st ← getDb ht;
  expect "a torn last commit is ignored: generation 2" (Nat.beq st.gen.toNat 2);
  expect "a torn last commit is ignored: count 1" (Nat.beq (snapCount st 1) 1);

  -- The generation floor is above the torn slot, so the next commit is generation 4.
  oAgain ← putDb ht (bumpCount (U64.ofNat 1) st);
  expect "a commit after torn recovery succeeds" (succeeded oAgain);
  s4 ← getDb ht;
  expect "the recovery commit is generation 4" (Nat.beq s4.gen.toNat 4);
  closeDb ht;

  ht2 ← openDb tpath indices;
  st2 ← getDb ht2;
  expect "the recovered file reopens at generation 4" (Nat.beq st2.gen.toNat 4);
  expect "and its count is 2" (Nat.beq (snapCount st2 1) 2);
  closeDb ht2

def main : IO Unit := EIO.toIO (do
  dir ← FS.createTempDir;
  EIO.lift (IO.println (String.append "durable: in " dir));
  cleanTest (Path.join dir "clean.db");
  EIO.lift (IO.println "durable: clean reopen ok");
  tornTest dir;
  EIO.lift (IO.println "durable: truncated tail ignored");
  FS.removeAll dir;
  EIO.lift (IO.println "durable: all checks passed"))
