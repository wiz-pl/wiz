import Compact
/-!
# The pure half: live-page marking, the retention policy, the plan

`wiz check -I drafts/storage-engine drafts/storage-engine/CompactPure.wiz` runs the
`#eval` lines below. It needs no native and no file: a `StoreView` is the two facts the
walk uses (the page count and each page's `right` link), so a hand-built view tests the
marking and the plan exactly as a mapped file would.

The view: page 2 → 3 → 4 → 0 (a three-page chain), page 5 → 6 → 0 (a two-page chain),
12 pages in the file. Two retained generations: 2 at page 2 and 1 at page 5.
-/

/-- One retained root. -/
def mkRef (gen root pages pins : Nat) : RootRef :=
  RootRef.mk (U64.ofNat gen) (U64.ofNat root) pages (U64.ofNat 0) pins

def view : StoreView :=
  StoreView.mk 12 [
    (U64.ofNat 2, U64.ofNat 3),
    (U64.ofNat 3, U64.ofNat 4),
    (U64.ofNat 4, U64.ofNat 0),
    (U64.ofNat 5, U64.ofNat 6),
    (U64.ofNat 6, U64.ofNat 0)]

/-- Keep one: only the newest root is live. -/
def regK1 : Registry := Registry.mk [mkRef 2 2 3 0, mkRef 1 5 2 0] 1
/-- Keep two: both roots are live. -/
def regK2 : Registry := Registry.mk [mkRef 2 2 3 0, mkRef 1 5 2 0] 2
/-- Keep one, but generation 1 has a reader: the lease outranks the count. -/
def regPinned : Registry := Registry.mk [mkRef 2 2 3 0, mkRef 1 5 2 1] 1
/-- Root 3's chain is a suffix of root 2's: the union must count each page once. -/
def regShared : Registry := Registry.mk [mkRef 2 2 3 0, mkRef 1 3 2 0] 2

def pK1 := compact view (Registry.roots regK1)
def pK2 := compact view (Registry.roots regK2)
def pPinned := compact view (Registry.roots regPinned)
def pShared := compact view (Registry.roots regShared)

def okb (b : Bool) : Nat := match b with
  | .true => 1
  | .false => 0

/-- Five live pages, seven wasted, before the rewrite. -/
#eval List.length pK2.live                                   -- 5
#eval (Plan.stats pK2 0).wastedPages                           -- 5 (12 - 5 - 2)
#eval (Plan.stats pK2 0).wastedBytes                           -- 20480
/-- After the rewrite the two chains are the whole file: nothing wasted. -/
#eval (Plan.after pK2 0).totalPages                            -- 7
#eval (Plan.after pK2 0).wastedPages                           -- 0
/-- The newest K alone: three live pages. -/
#eval List.length pK1.live                                   -- 3
#eval (Plan.stats pK1 0).wastedPages                           -- 7
/-- A lease keeps the old root live under K = 1. -/
#eval List.length pPinned.live                               -- 5
/-- Overlapping chains are marked once. -/
#eval List.length pShared.live                               -- 3
/-- Numbering is dense from page 2 and follows the sorted page order. -/
#eval (mappedPage pK2.newOf (U64.ofNat 2)).toNat             -- 2
#eval (mappedPage pK2.newOf (U64.ofNat 5)).toNat             -- 5
#eval (mappedPage pK2.newOf (U64.ofNat 6)).toNat             -- 6
/-- The policy: K = 1 drops generation 1; a lease retains it; `retained` is exact. -/
#eval okb (Registry.retained regK1 (U64.ofNat 1))            -- 0
#eval okb (Registry.retained regK1 (U64.ofNat 2))            -- 1
#eval okb (Registry.retained regPinned (U64.ofNat 1))        -- 1
#eval (Registry.minGen regK2).toNat                          -- 1
#eval (Registry.minGen regPinned).toNat                      -- 1
/-- Lease/release move the counter; release at zero is a no-op. -/
def regLeased := Registry.release (Registry.lease regK1 (U64.ofNat 1)) (U64.ofNat 1)
#eval okb (Registry.retained regLeased (U64.ofNat 1))        -- 0
#eval okb (Registry.retained (Registry.release regPinned (U64.ofNat 1)) (U64.ofNat 1)) -- 0
/-- The remap table is `gen → newRoot`: the plan's after-state keeps both live roots. -/
#eval List.length (Registry.remapFrom pK2.rootMap (Registry.roots regK2)) -- 2
#eval List.length (Registry.remapFrom pK1.rootMap (Registry.roots regK2)) -- 1 (only the live set is mapped)
/-- The other meta slot: the newest root with the opposite parity. -/
#eval match Plan.otherRoot pK2 0 with
  | .none => 0
  | .some r => r.gen.toNat                                 -- 1
/-- Stats move from wasted to reclaimed. -/
#eval (Plan.stats pK2 0).totalPages                            -- 12
#eval (Plan.after pK2 0).totalPages                            -- 7
