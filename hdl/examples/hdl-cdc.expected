examples/hdl-cdc.wiz:162:1: info: "module cross(input clk, input clk2, input [0:0] go, output [0:0] q);\n  reg [0:0] tx_r; initial tx_r = 1'd0;\n  reg [0:0] rx_r; initial rx_r = 1'd0;\n  wire [0:0] n4;\n  wire [0:0] n6;\n  BUFG u3 (.I(clk2), .O(n4));\n  wiz_sync2 u5 (.clk(n4), .d(tx_r), .q(n6));\n  always @(posedge clk) tx_r <= go;\n  always @(posedge clk2) rx_r <= n6;\n  assign q = rx_r;\nendmodule\n"
