examples/hdl-cdc.wiz:89:1: info: "module cross(input clk, input clk2, output [0:0] y);\n  reg [0:0] r; initial r = 1'd0;\n  reg [0:0] s; initial s = 1'd0;\n  wire [0:0] n3;\n  wiz_sync2 u2 (.clk(clk2), .d(r), .q(n3));\n  always @(posedge clk) r <= r;\n  always @(posedge clk2) s <= n3;\n  assign y = s;\nendmodule\n"
