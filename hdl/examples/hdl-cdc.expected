examples/hdl-cdc.wiz:129:1: info: "module cross(input clk, input clk2, input [0:0] go, output [0:0] q);\n  reg [0:0] tx_r; initial tx_r = 1'd0;\n  reg [0:0] rx_r; initial rx_r = 1'd0;\n  wire [0:0] n4;\n  wiz_sync2 u3 (.clk(clk2), .d(tx_r), .q(n4));\n  always @(posedge clk) tx_r <= go;\n  always @(posedge clk2) rx_r <= n4;\n  assign q = rx_r;\nendmodule\n"
examples/hdl-cdc.wiz:132:1: info: "module cross_core(input clk, input clk2, input [0:0] go, output [0:0] q);\n  reg [0:0] tx_r; initial tx_r = 1'd0;\n  reg [0:0] rx_r; initial rx_r = 1'd0;\n  wire [0:0] n4;\n  wiz_sync2 u3 (.clk(clk2), .d(tx_r), .q(n4));\n  always @(posedge clk) tx_r <= go;\n  always @(posedge clk2) rx_r <= n4;\n  assign q = rx_r;\nendmodule\nmodule cross(input clk, input [0:0] go, output [0:0] q);\n  wire ck_CLKFBOUT;\n  wire ck_CLKOUT0;\n  wire ck_CLKOUT1;\n  PLLE2_BASE #(.CLKIN1_PERIOD(10.0), .CLKFBOUT_MULT(8), .DIVCLK_DIVIDE(1), .CLKOUT0_DIVIDE(8), .CLKOUT0_PHASE(0.0), .CLKOUT1_DIVIDE(2), .CLKOUT1_PHASE(0.0)) clocking (.CLKIN1(clk), .RST(1'b0), .PWRDWN(1'b0), .CLKFBOUT(ck_CLKFBOUT), .CLKFBIN(ck_CLKFBOUT), .CLKOUT0(ck_CLKOUT0), .CLKOUT1(ck_CLKOUT1));\n  wire ck_CLKOUT0_g;\n  BUFG bufg_CLKOUT0 (.I(ck_CLKOUT0), .O(ck_CLKOUT0_g));\n  wire ck_CLKOUT1_g;\n  BUFG bufg_CLKOUT1 (.I(ck_CLKOUT1), .O(ck_CLKOUT1_g));\n  cross_core core (.clk(ck_CLKOUT0_g), .clk2(ck_CLKOUT1_g), .go(go), .q(q));\nendmodule\n"
examples/hdl-cdc.wiz:137:1: info: "module cross_core(input clk, input clk2, input [0:0] go, output [0:0] q);\n  reg [0:0] tx_r; initial tx_r = 1'd0;\n  reg [0:0] rx_r; initial rx_r = 1'd0;\n  wire [0:0] n4;\n  wiz_sync2 u3 (.clk(clk2), .d(tx_r), .q(n4));\n  always @(posedge clk) tx_r <= go;\n  always @(posedge clk2) rx_r <= n4;\n  assign q = rx_r;\nendmodule\nmodule cross(input clk, input [0:0] go, input clk2, output [0:0] q);\n  wire ck_CLKFBOUT;\n  wire ck_CLKOUT0;\n  PLLE2_BASE clocking (.CLKIN1(clk), .CLKFBOUT(ck_CLKFBOUT), .CLKFBIN(ck_CLKFBOUT), .CLKOUT0(ck_CLKOUT0));\n  wire ck_CLKOUT0_g;\n  BUFG bufg_CLKOUT0 (.I(ck_CLKOUT0), .O(ck_CLKOUT0_g));\n  cross_core core (.clk(ck_CLKOUT0_g), .clk2(clk2), .go(go), .q(q));\nendmodule\n"
examples/hdl-cdc.wiz:143:1: info: "set_property -dict { PACKAGE_PIN E3 IOSTANDARD LVCMOS33 } [get_ports {clk}]\ncreate_clock -period 10.000 [get_ports {clk}]\ncreate_clock -period 2.500 [get_ports {clk2}]\nset_property -dict { PACKAGE_PIN F3 IOSTANDARD LVCMOS33 } [get_ports {clk2}]\nset_property -dict { PACKAGE_PIN D9 IOSTANDARD LVCMOS33 } [get_ports {go}]\nset_property -dict { PACKAGE_PIN D10 IOSTANDARD LVCMOS33 } [get_ports {q}]\n"
