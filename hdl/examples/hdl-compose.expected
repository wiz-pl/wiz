examples/hdl-compose.wiz:111:1: info: "module counter(input clk, input [0:0] rst, input [0:0] en, input [0:0] go, output [3:0] leds, output [0:0] top);\n  reg [3:0] count; initial count = 4'd0;\n  reg [0:0] up; initial up = 1'd1;\n  wire [3:0] n6 = count + 4'd1;\n  wire [3:0] n7 = count - 4'd1;\n  wire [3:0] n8 = up ? n6 : n7;\n  wire [3:0] next = go ? n8 : count;\n  wire [0:0] n11 = next == 4'd9;\n  wire [0:0] n13 = next == 4'd0;\n  wire [0:0] n16 = n13 ? 1'd1 : up;\n  wire [0:0] n17 = n11 ? 1'd0 : n16;\n  wire [0:0] n18 = count == 4'd9;\n  always @(posedge clk) if (rst) count <= 4'd0; else if (en) count <= next;\n  always @(posedge clk) if (rst) up <= 1'd1; else if (en) up <= n17;\n  assign leds = count;\n  assign top = n18;\nendmodule\n"
examples/hdl-compose.wiz:122:1: info: "set_io clk 21\nset_io rst 1\nset_io en 2\nset_io go 3\nset_io leds[0] 99\nset_io leds[1] 98\nset_io leds[2] 97\nset_io leds[3] 96\nset_io top 95\nset_frequency clk 100\n"
examples/hdl-compose.wiz:123:1: info: ["no pin for port rst", "no pin for port en", "port leds has 4 bits, one pin given", "no pin for port top", "pin for no port: led"]
examples/hdl-compose.wiz:126:1: info: "$timescale 1ns $end\n$scope module counter $end\n$var wire 1 ! clk $end\n$var wire 1 \" go $end\n$var wire 4 # leds $end\n$var wire 1 $ top $end\n$var wire 4 % count $end\n$var wire 1 & up $end\n$upscope $end\n$enddefinitions $end\n#0\n0!\n0\"\nb0000 #\n0$\nb0000 %\n1&\n#1\n1!\n#2\n0!\n#3\n1!\n#4\n0!\n#5\n1!\n#6\n0!\n1\"\n#7\n1!\n#8\n"
