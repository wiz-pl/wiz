examples/hdl-gaps.wiz:140:1: info: "module phase(input clk, input [0:0] x, output [1:0] y);\n  reg [1:0] r; initial r = 2'd0;\n  wire [0:0] n3 = r == 2'd3;\n  wire [1:0] n6 = r + 2'd1;\n  wire [1:0] n7 = n3 ? 2'd0 : n6;\n  wire [1:0] n8 = x ? n7 : r;\n  always @(posedge clk) r <= n8;\n  assign y = r;\nendmodule\n"
