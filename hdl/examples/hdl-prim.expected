examples/hdl-prim.wiz:52:1: info: "module blink(input clk, input [0:0] x, output [0:0] led, inout [0:0] pin, output [0:0] seen);\n  reg [0:0] r; initial r = 1'd0;\n  wire [0:0] n2 = ~x;\n  wire [0:0] n4;\n  wire [0:0] n6 = ~r;\n  IOBUF u3 (.I(r), .T(n2), .O(n4), .IO(pin));\n  OBUF u7 (.I(r), .O(led));\n  always @(posedge clk) r <= n6;\n  assign seen = n4;\nendmodule\n"
