examples/hdl-prim.wiz:48:1: info: "module serial_core(input clk, input [0:0] sys4x, input [7:0] d, output [0:0] ck, output [0:0] q, inout [0:0] dq, output [0:0] back);\n  reg [0:0] r; initial r = 1'd0;\n  wire [0:0] n4 = d[0:0];\n  wire [0:0] n5 = d[1:1];\n  wire [0:0] n6 = d[2:2];\n  wire [0:0] n7 = d[3:3];\n  wire [0:0] n8 = d[4:4];\n  wire [0:0] n9 = d[5:5];\n  wire [0:0] n10 = d[6:6];\n  wire [0:0] n11 = d[7:7];\n  wire [0:0] n15;\n  wire [0:0] n16;\n  wire [0:0] n18;\n  wire [0:0] n20 = ~r;\n  wire [0:0] n22;\n  OSERDESE2 #(.DATA_RATE_OQ(\"DDR\"), .DATA_RATE_TQ(\"BUF\"), .DATA_WIDTH(8), .TRISTATE_WIDTH(1), .SERDES_MODE(\"MASTER\")) u14 (.CLK(sys4x), .CLKDIV(clk), .D1(n4), .D2(n5), .D3(n6), .D4(n7), .D5(n8), .D6(n9), .D7(n10), .D8(n11), .OCE(1'd1), .RST(1'd0), .T1(r), .TCE(1'd1), .OQ(n15), .TQ(n16));\n  IOBUF u17 (.I(n15), .T(n16), .O(n18), .IO(dq));\n  ODDR #(.DDR_CLK_EDGE(\"SAME_EDGE\"), .INIT(1'b0), .SRTYPE(\"SYNC\")) u21 (.C(clk), .CE(1'd1), .D1(1'd1), .D2(1'd0), .R(1'd0), .S(1'd0), .Q(n22));\n  OBUF u23 (.I(n22), .O(ck));\n  OBUF u25 (.I(r), .O(q));\n  always @(posedge clk) r <= n20;\n  assign back = n18;\nendmodule\nmodule serial(input clk, input [7:0] d, output [0:0] ck, output [0:0] q, inout [0:0] dq, output [0:0] back);\n  wire ck_CLKFBOUT;\n  wire ck_CLKOUT0;\n  wire ck_CLKOUT1;\n  PLLE2_BASE #(.CLKIN1_PERIOD(10.0), .CLKFBOUT_MULT(8), .DIVCLK_DIVIDE(1), .CLKOUT0_DIVIDE(8), .CLKOUT0_PHASE(0.0), .CLKOUT1_DIVIDE(2), .CLKOUT1_PHASE(0.0)) clocking (.CLKIN1(clk), .RST(1'b0), .PWRDWN(1'b0), .CLKFBOUT(ck_CLKFBOUT), .CLKFBIN(ck_CLKFBOUT), .CLKOUT0(ck_CLKOUT0), .CLKOUT1(ck_CLKOUT1));\n  wire ck_CLKOUT0_g;\n  BUFG bufg_CLKOUT0 (.I(ck_CLKOUT0), .O(ck_CLKOUT0_g));\n  wire ck_CLKOUT1_g;\n  BUFG bufg_CLKOUT1 (.I(ck_CLKOUT1), .O(ck_CLKOUT1_g));\n  serial_core core (.clk(ck_CLKOUT0_g), .sys4x(ck_CLKOUT1_g), .d(d), .ck(ck), .q(q), .dq(dq), .back(back));\nendmodule\n"
