import Hdl.Core
import OpticDerive
/-!
# Hdl.Optic

Optics for HDL bundles (`import Hdl.Optic`). Design:
wiz-notes/cohesion-hardware.md, 2.2; the optics are lib/Optic.wiz's.

A bundle `structure Tx (r : HwTy → Type) where …` derives `Lens` as any structure
does (`deriving Bundle, Lens`): `Tx.lineL : Lens (Tx r) (r Bit)`, one lens at every
representation, so a step can update one field (`Lens.over Tx.leftL dec s`) and a proof
that the other fields are unchanged is `Lens.Indep` (derived, by `rfl`) or `rfl` itself.
The step combinator is `Hdl.zoomP` (a `LensP`); `Hdl.zoom` is its store-lens shim
(`LensP.ofLens`), so derived lenses and `examples/hdl-optic.wiz` keep their types. The
data lenses (`Bundle.lens`, `HwTy.fstL`/`sndL`) stay the store form — that is the data
`deriving Bundle` gives — with a `LensP` lift (`Bundle.lensP`, `HwTy.fstLP`/`sndLP`).
This module adds what is specific to hardware:

* `Hdl.zoomP l g` (`Hdl.zoom` for a store lens): run a sub-step `g` on the part of the
  state that `l` selects; with `Hdl.zoomP_frame` (or `Hdl.zoom_frame`), every place
  independent of `l` is unchanged (the frame rule; `LensP.Indep` is the hypothesis).
* `Bundle.lensP b` (`Bundle.lens b`): a bundle's packed code and its structure, as an
  optic at values, and `Bundle.Lawful b` (derived bundles: by `rfl`).
* `HwTy.fstLP`/`sndLP` (`HwTy.fstL`/`sndL`): the components of a product code at values.
-/

/-- `g` on the place `l` of `s`: its next value is put back, the output passed on. The
profunctor form: one optic, run at `Forget` for the read and `Hom` for the write. -/
def Hdl.zoomP {S : Type} {ω T : Type} {I O : Type} (l : LensP S S T T) (g : T → I → T × O) (s : S) (x : I) : S × O :=
  let r := g (view l s) x;
  (over l (fun (_ : T) => r.1) s, r.2)

/-- `g` on the place `l` of `s`: `Hdl.zoomP` with a store lens lifted by
`LensP.ofLens`. The signature `Lens S T` is what derived field lenses have. -/
def Hdl.zoom {S : Type} {ω T : Type} {I O : Type} (l : Lens S T) (g : T → I → T × O) (s : S) (x : I) : S × O :=
  let lp : LensP S S T T := LensP.ofLens l;
  Hdl.zoomP lp g s x

/-- What the zoomed step does to the place itself. -/
def Hdl.zoom_get {S : Type} {ω T : Type} {I O : Type} (l : Lens S T) (hl : Lens.Lawful l) (g : T → I → T × O) (s : S) (x : I) :
    Lens.get l (Hdl.zoom l g s x).1 = (g (Lens.get l s) x).1 :=
  hl.2.1 s (g (Lens.get l s) x).1

/-- The same, on the profunctor lens (`LensP.PutGet`). -/
def Hdl.zoomP_get {S : Type} {ω T : Type} {I O : Type} (l : LensP S S T T) (hl : LensP.Lawful l) (g : T → I → T × O)
    (s : S) (x : I) :
    view l (Hdl.zoomP l g s x).1 = (g (view l s) x).1 :=
  hl.2.1 s (g (view l s) x).1

/-- Independence the other way round (derived lenses state it for fields in order). -/
def Hdl.indep_symm {S A B : Type} (l : Lens S A) (m : Lens S B) (h : Lens.Indep l m) : Lens.Indep m l :=
  (h.2.1, h.1, fun (s : S) (b : B) (a : A) => Eq.symm (h.2.2 s a b))

/-- The profunctor form of `Hdl.indep_symm`. -/
def Hdl.indep_symmP {S A B : Type} (l : LensP S S A A) (m : LensP S S B B)
    (h : LensP.Indep l m) : LensP.Indep m l :=
  LensP.indep_symm l m h

/-- The frame rule: a place `m` independent of `l` is unchanged by a step zoomed into
`l`. -/
def Hdl.zoom_frame {S : Type} {ω T : Type} {ω U : Type} {I O : Type} (l : Lens S T) (m : Lens S U) (h : Lens.Indep l m) (g : T → I → T × O) (s : S) (x : I) :
    Lens.get m (Hdl.zoom l g s x).1 = Lens.get m s :=
  h.1 s (g (Lens.get l s) x).1

/-- The frame rule on profunctor lenses: `LensP.Indep` is the hypothesis, and a derived
`S.f_g_indep` supplies it through `LensP.ofLens_indep`. -/
def Hdl.zoomP_frame {S : Type} {ω T : Type} {ω U : Type} {I O : Type} (l : LensP S S T T) (m : LensP S S U U)
    (h : LensP.Indep l m) (g : T → I → T × O) (s : S) (x : I) :
    view m (Hdl.zoomP l g s x).1 = view m s :=
  h.1 s (g (view l s) x).1


------------------------------------------------------------------------------------
-- Bundles as lenses at values

-- the structure inside the packed value
/-- The structure inside a bundle's packed value, as a lens at values. -/
def Bundle.lens {F : (HwTy → Type) → Type} (b : Bundle F) : Lens (HwTy.El b.code) (F HwTy.El) :=
  fun (v : HwTy.El b.code) => (Bundle.ofEl b v, fun (s : F HwTy.El) => Bundle.toEl b s)

/-- The same, as a profunctor lens (the `LensP.ofLens` lift; the store form is the data,
since `deriving Bundle` gives the packing). -/
def Bundle.lensP {F : (HwTy → Type) → Type} (b : Bundle F) :
    LensP (HwTy.El b.code) (HwTy.El b.code) (F HwTy.El) (F HwTy.El) :=
  LensP.ofLens (Bundle.lens b)

-- packing and unpacking are inverse (`deriving Bundle` gives such bundles: `rfl`)
/-- Packing and unpacking are inverse (`deriving Bundle` gives such bundles: by `rfl`). -/
def Bundle.Lawful {F : (HwTy → Type) → Type} (b : Bundle F) : Prop :=
  ((v : HwTy.El b.code) → Bundle.toEl b (Bundle.ofEl b v) = v) × ((s : F HwTy.El) → Bundle.ofEl b (Bundle.toEl b s) = s)

/-- `Bundle.lens b` is lawful when the bundle's packing is. -/
def Bundle.lens_lawful {F : (HwTy → Type) → Type} (b : Bundle F) (h : Bundle.Lawful b) : Lens.Lawful (Bundle.lens b) :=
  (h.1, fun (v : HwTy.El b.code) (s : F HwTy.El) => h.2 s, fun (v : HwTy.El b.code) (s t : F HwTy.El) => rfl)

------------------------------------------------------------------------------------
-- Product codes

/-- The first component of a product code, at values. -/
def HwTy.fstL {0 a b : HwTy} : Lens (HwTy.El (HwTy.prod a b)) (HwTy.El a) :=
  fun (p : HwTy.El (HwTy.prod a b)) => (p.1, fun (x : HwTy.El a) => (x, p.2))
/-- The second component of a product code, at values. -/
def HwTy.sndL {0 a b : HwTy} : Lens (HwTy.El (HwTy.prod a b)) (HwTy.El b) :=
  fun (p : HwTy.El (HwTy.prod a b)) => (p.2, fun (y : HwTy.El b) => (p.1, y))
/-- The first component of a product code, at values, as a profunctor lens. -/
def HwTy.fstLP {0 a b : HwTy} :
    LensP (HwTy.El (HwTy.prod a b)) (HwTy.El (HwTy.prod a b)) (HwTy.El a) (HwTy.El a) :=
  LensP.ofLens (@HwTy.fstL a b)
/-- The second component of a product code, at values, as a profunctor lens. -/
def HwTy.sndLP {0 a b : HwTy} :
    LensP (HwTy.El (HwTy.prod a b)) (HwTy.El (HwTy.prod a b)) (HwTy.El b) (HwTy.El b) :=
  LensP.ofLens (@HwTy.sndL a b)

/-- `HwTy.fstL` is lawful (every law by `rfl`). -/
def HwTy.fstL_lawful {0 a b : HwTy} : Lens.Lawful (@HwTy.fstL a b) := (fun s => rfl, fun s x => rfl, fun s x y => rfl)
/-- `HwTy.sndL` is lawful (every law by `rfl`). -/
def HwTy.sndL_lawful {0 a b : HwTy} : Lens.Lawful (@HwTy.sndL a b) := (fun s => rfl, fun s x => rfl, fun s x y => rfl)
/-- The two components of a product code are independent. -/
def HwTy.fst_snd_indep {0 a b : HwTy} : Lens.Indep (@HwTy.fstL a b) (@HwTy.sndL a b) :=
  (fun s x => rfl, fun s y => rfl, fun s x y => rfl)
