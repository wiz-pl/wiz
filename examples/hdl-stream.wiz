-- The AXI4-Stream subset (`import Hdl.AxiStream`, `Hdl.AxiStreamLaw`): source/sink,
-- one-beat register slice, up/down width conversion, a stalling sink, and the two
-- checks `AxiStream.Law.Stable` and `AxiStream.Law.Order` (no beat lost, duplicated or
-- reordered at the sink). Run by the `bus-protocol` test group; yosys runs on the
-- emitted Verilog when it is on PATH.
import Hdl.Core
import Hdl.Sim
import Hdl.AxiStream
import Hdl.AxiStreamLaw
import IO

def yes (b : Bool) : String := match b with
  | .true => "yes"
  | .false => "NO"

def n01 (b : Bool) : Nat := match b with
  | .true => 1
  | .false => 0

def units (n : Nat) : List Nat := Hdl.upto n 0

def allTrue : List Bool → Bool
  | .nil => .true
  | .cons b bs => Bool.and b (allTrue bs)

def leavesEq : List (List Nat) → List (List Nat) → Bool
  | .nil, .nil => .true
  | .cons a as, .cons b bs => Bool.and (Hdl.natsEq a b) (leavesEq as bs)
  | _, _ => .false

def agree {ω i o : HwTy} (c : Circuit i o) (ins : List (HwTy.El i)) : Bool :=
  let ω v := Circuit.runLeaves c ins;
  Bool.and (leavesEq v (Circuit.simFast c ins))
    (Bool.and (leavesEq v (Circuit.simLeaves .true c ins)) (leavesEq v (Circuit.simLeaves .false c ins)))

def beatE (dw : Nat) (data valid last keep user ready : Nat) : HwTy.El (AxiStream.Beat.code dw) :=
  Bundle.toEl (AxiStream.Beat.bundle dw)
    (AxiStream.Beat.mk (BitVec.ofNat dw data) (BitVec.ofNat 1 valid) (BitVec.ofNat 1 last)
      (BitVec.ofNat (AxiStream.keepW dw) keep) (BitVec.ofNat 1 user) (BitVec.ofNat 1 ready))

def txPayload (dw data valid last keep user : Nat) : Nat :=
  HwTy.pack (AxiStream.Tx.code dw)
    (AxiStream.Tx.pack dw (AxiStream.Tx.mk (dw := dw) (r := HwTy.El)
      (BitVec.ofNat dw data) (BitVec.ofNat 1 valid) (BitVec.ofNat 1 last)
      (BitVec.ofNat (AxiStream.keepW dw) keep) (BitVec.ofNat 1 user)))

-- The stalling sink's ready: one cycle in `period` (period = 1 is always ready).
def stallReady (period k : Nat) : Nat :=
  if Nat.beq period 1 then 1 else n01 (Nat.beq (Nat.mod k period) (Nat.sub period 1))

def natsEq (xs ys : List Nat) : Bool := Hdl.natsEq xs ys

------------------------------------------------------------------------------------
-- 1. Source and stalling sink: the sink must count exactly `n` beats and see `tlast`
-- on the last one.

def pairOk (n period fuel : Nat) : Bool :=
  let ins := Hdl.map (fun (_ : Nat) => HwTy.unpack (HwTy.bits 0) 0) (units fuel);
  let outs := Circuit.run (AxiStream.pairC 8 n period) ins;
  let x := AxiStream.PairOut.unpack 8 (Hdl.nthD (HwTy.unpack (AxiStream.PairOut.code 8) 0) outs (Nat.sub fuel 1));
  Bool.and (Nat.beq (BitVec.toNat x.count) n)
    (Bool.and (BitVec.isTrue x.sawLast)
      (Bool.and (Nat.beq (BitVec.toNat x.lastData) (Nat.sub n 1))
        (Nat.beq (BitVec.toNat x.left) 0)))

def pairAgree (n period fuel : Nat) : Bool :=
  let ins := Hdl.map (fun (_ : Nat) => HwTy.unpack (HwTy.bits 0) 0) (units fuel);
  agree (AxiStream.pairC 8 n period) ins

-- The source's own obligation: build the source beat trace with a stalling `tready`,
-- and check that a beat offered while stalled is the same beat next cycle.
def readies (period fuel : Nat) : List Nat :=
  Hdl.map (fun (k : Nat) => stallReady period k) (units fuel)

def sourceBeatTrace (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 8)) :=
  let rs := readies period fuel;
  let txs := Circuit.run (AxiStream.sourceC 8 n) (Hdl.map (fun (r : Nat) => BitVec.ofNat 1 r) rs);
  Hdl.map (fun (k : Nat) =>
    let t := AxiStream.Tx.unpack 8 (Hdl.nthD (HwTy.unpack (AxiStream.Tx.code 8) 0) txs k);
    let r := Hdl.nthD 0 rs k;
    beatE 8 (BitVec.toNat t.tdata) (BitVec.toNat t.tvalid) (BitVec.toNat t.tlast)
      (BitVec.toNat t.tkeep) (BitVec.toNat t.tuser) r) (units fuel)

def sourceStable (n period fuel : Nat) : Bool :=
  AxiStream.Law.Stable (sourceBeatTrace n period fuel)

------------------------------------------------------------------------------------
-- 2. The register slice with a stalling sink. The generator holds a beat until the
-- slice's input-ready (the actual handshake), so a lost or duplicated beat is visible in
-- the accepted sequences.

def sliceGen (fuel k idx n period : Nat) (st : AxiStream.SliceSt 8 HwTy.El) :
    List (HwTy.El (AxiStream.Beat.code 8) × HwTy.El (AxiStream.Beat.code 8)) :=
  match fuel with
  | .zero => .nil
  | .succ f =>
    let ready := stallReady period k;
    let valid := n01 (Nat.lt idx n);
    let last := n01 (Nat.beq idx (Nat.sub n 1));
    let x := beatE 8 idx valid last 1 0 ready;
    let ux := AxiStream.Beat.unpack 8 x;
    let inReady := BitVec.isTrue (AxiStream.sliceInReady st ux.tready);
    let step := AxiStream.sliceStep 8 st ux;
    let st' := AxiStream.SliceSt.unpack 8 (Hw.fst step);
    let accepted := Bool.and (Nat.beq valid 1) inReady;
    .cons (x, Hw.snd step)
      (sliceGen f (Nat.succ k) (if accepted then Nat.succ idx else idx) n period st')

def slicePairs (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 8) × HwTy.El (AxiStream.Beat.code 8)) :=
  sliceGen fuel 0 0 n period (AxiStream.sliceInit 8)

def sliceIns (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 8)) :=
  Hdl.fsts (slicePairs n period fuel)

def sliceRef (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 8)) :=
  Hdl.snds (slicePairs n period fuel)

-- The slice's accepted input payloads: the generator advances only after the slice's
-- input-ready, so every one of the `n` beats is accepted once, in order.
def sliceExpected (n : Nat) : List Nat :=
  Hdl.map (fun (k : Nat) =>
    txPayload 8 k 1 (n01 (Nat.beq k (Nat.sub n 1))) 1 0) (units n)

def sliceLawOk (n period fuel : Nat) : Bool :=
  let ins := sliceIns n period fuel;
  let outs := Circuit.run (AxiStream.sliceC 8) ins;
  Bool.and (natsEq (Hdl.map (HwTy.pack (AxiStream.Beat.code 8)) outs)
      (Hdl.map (HwTy.pack (AxiStream.Beat.code 8)) (sliceRef n period fuel)))
    (AxiStream.Law.Order (sliceExpected n) outs)

def sliceAgree (n period fuel : Nat) : Bool :=
  agree (AxiStream.sliceC 8) (sliceIns n period fuel)

------------------------------------------------------------------------------------
-- 3. Upsize 8 -> 16 with a stalling sink. `ratio = 2`; the first narrow beat is the high
-- byte of the wide beat, and the two keeps are the two bits of the wide keep.

def upGen (fuel k idx n period : Nat) (st : AxiStream.UpSt 8 2 HwTy.El) :
    List (HwTy.El (AxiStream.Beat.code 8) × HwTy.El (AxiStream.Beat.code 16)) :=
  match fuel with
  | .zero => .nil
  | .succ f =>
    let ready := stallReady period k;
    let valid := n01 (Nat.lt idx n);
    let last := n01 (Nat.beq idx (Nat.sub n 1));
    let x := beatE 8 idx valid last 1 0 ready;
    let ux := AxiStream.Beat.unpack 8 x;
    let inReady := BitVec.isTrue (AxiStream.upInReady st);
    let step := AxiStream.upStep 8 2 st ux;
    let st' := AxiStream.UpSt.unpack 8 2 (Hw.fst step);
    let accepted := Bool.and (Nat.beq valid 1) inReady;
    .cons (x, Hw.snd step)
      (upGen f (Nat.succ k) (if accepted then Nat.succ idx else idx) n period st')

def upPairs (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 8) × HwTy.El (AxiStream.Beat.code 16)) :=
  upGen fuel 0 0 n period (AxiStream.upInit 8 2)

def upIns (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 8)) :=
  Hdl.fsts (upPairs n period fuel)

def upRef (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 16)) :=
  Hdl.snds (upPairs n period fuel)

-- The accepted wide beats expected from narrow beats `0 … n-1`, all keeps set, `tlast` on
-- the last narrow beat (n even in the tests).
def upExpected (n : Nat) : List Nat :=
  Hdl.map (fun (k : Nat) =>
    let a := Nat.mul 2 k;
    let b := Nat.add a 1;
    let last := n01 (Nat.beq b (Nat.sub n 1));
    txPayload 16 (Nat.add (Nat.mul a 256) b) 1 last 3 0) (units (Nat.div n 2))

def upLawOk (n period fuel : Nat) : Bool :=
  let ins := upIns n period fuel;
  let outs := Circuit.run (AxiStream.upC 8 2) ins;
  Bool.and (natsEq (Hdl.map (HwTy.pack (AxiStream.Beat.code 16)) outs)
      (Hdl.map (HwTy.pack (AxiStream.Beat.code 16)) (upRef n period fuel)))
    (AxiStream.Law.Order (upExpected n) outs)

def upAgree (n period fuel : Nat) : Bool :=
  agree (AxiStream.upC 8 2) (upIns n period fuel)

------------------------------------------------------------------------------------
-- 4. Downsize 16 -> 8 with a stalling sink: each wide beat becomes two narrow beats
-- (low half first), `tlast` only on the second, `tkeep` split into its two bits.

def wideE (data last keep : Nat) : HwTy.El (AxiStream.Beat.code 16) :=
  beatE 16 data 1 last keep 0 1

def downGen (fuel k idx n period : Nat) (st : AxiStream.DownSt 8 2 HwTy.El) :
    List (HwTy.El (AxiStream.Beat.code 16) × HwTy.El (AxiStream.Beat.code 8)) :=
  match fuel with
  | .zero => .nil
  | .succ f =>
    let ready := stallReady period k;
    let valid := n01 (Nat.lt idx n);
    let last := n01 (Nat.beq idx (Nat.sub n 1));
    let data := Nat.add (Nat.mul (Nat.succ idx) 256) (Nat.add (Nat.mul idx 17) 34);
    let x := beatE 16 data valid last 3 0 ready;
    let ux := AxiStream.Beat.unpack 16 x;
    let inReady := BitVec.isTrue (AxiStream.downInReady st);
    let step := AxiStream.downStep 8 2 st ux;
    let st' := AxiStream.DownSt.unpack 8 2 (Hw.fst step);
    let accepted := Bool.and (Nat.beq valid 1) inReady;
    .cons (x, Hw.snd step)
      (downGen f (Nat.succ k) (if accepted then Nat.succ idx else idx) n period st')

def downPairs (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 16) × HwTy.El (AxiStream.Beat.code 8)) :=
  downGen fuel 0 0 n period (AxiStream.downInit 8 2)

def downIns (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 16)) :=
  Hdl.fsts (downPairs n period fuel)

def downRef (n period fuel : Nat) : List (HwTy.El (AxiStream.Beat.code 8)) :=
  Hdl.snds (downPairs n period fuel)

-- The narrow payloads expected from wide beat `k`: low byte then high byte, `tlast` on
-- the second and keep bits 1 then 2 (the low and high keep bits).
def downExpected (n : Nat) : List (Nat × Nat) :=
  Hdl.map (fun (k : Nat) =>
    let data := Nat.add (Nat.mul (Nat.succ k) 256) (Nat.add (Nat.mul k 17) 34);
    let lo := Nat.mod data 256;
    let hi := Nat.div data 256;
    let last := n01 (Nat.beq k (Nat.sub n 1));
    (txPayload 8 lo 1 0 1 0, txPayload 8 hi 1 last 1 0)) (units n)

def downExpectedFlat (n : Nat) : List Nat :=
  Hdl.concatLists (Hdl.map (fun (p : Nat × Nat) => List.cons p.1 (List.cons p.2 List.nil))
    (downExpected n))

def downLawOk (n period fuel : Nat) : Bool :=
  let ins := downIns n period fuel;
  let outs := Circuit.run (AxiStream.downC 8 2) ins;
  Bool.and (natsEq (Hdl.map (HwTy.pack (AxiStream.Beat.code 8)) outs)
      (Hdl.map (HwTy.pack (AxiStream.Beat.code 8)) (downRef n period fuel)))
    (AxiStream.Law.Order (downExpectedFlat n) outs)

def downAgree (n period fuel : Nat) : Bool :=
  agree (AxiStream.downC 8 2) (downIns n period fuel)

------------------------------------------------------------------------------------
-- 5. Bundles and netlists.

def beatBundleRoundTrip (dw : Nat) (x : HwTy.El (AxiStream.Beat.code dw)) : Bool :=
  Nat.beq (HwTy.pack (AxiStream.Beat.code dw)
      (Bundle.toEl (AxiStream.Beat.bundle dw) (Bundle.ofEl (AxiStream.Beat.bundle dw) x)))
    (HwTy.pack (AxiStream.Beat.code dw) x)

def streamBundlesOk : Bool :=
  Bool.and (beatBundleRoundTrip 8 (beatE 8 165 1 1 1 0 1))
    (beatBundleRoundTrip 16 (beatE 16 47806 1 0 3 0 1))

def netWellFormed : Bool :=
  Bool.and (Netlist.wellFormed (Circuit.netlist "stream_slice" (AxiStream.sliceC 8)))
    (Bool.and (Netlist.wellFormed (Circuit.netlist "stream_up" (AxiStream.upC 8 2)))
      (Bool.and (Netlist.wellFormed (Circuit.netlist "stream_down" (AxiStream.downC 8 2)))
        (Netlist.wellFormed (Circuit.netlist "stream_pair" (AxiStream.pairC 8 6 3)))))

------------------------------------------------------------------------------------

def main : IO Unit := do
  IO.println ("stream pair: 8 beats period 1 " <+> yes (pairOk 8 1 16)
    <+> ", period 3 " <+> yes (pairOk 8 3 32)
    <+> ", period 2 " <+> yes (pairOk 8 2 24)
    <+> ", stable " <+> yes (sourceStable 8 3 40)
    <+> ", value = simulate = simFast " <+> yes (pairAgree 8 3 32));
  IO.println ("stream slice: Order period 3 " <+> yes (sliceLawOk 10 3 40)
    <+> ", period 2 " <+> yes (sliceLawOk 9 2 32)
    <+> ", value = simulate = simFast " <+> yes (sliceAgree 10 3 40));
  IO.println ("stream upsize 8->16: Order/grouping/keep/last " <+> yes (upLawOk 8 3 48)
    <+> ", period 1 " <+> yes (upLawOk 8 1 24)
    <+> ", value = simulate = simFast " <+> yes (upAgree 8 3 48));
  IO.println ("stream downsize 16->8: Order/grouping/keep/last " <+> yes (downLawOk 4 2 32)
    <+> ", period 1 " <+> yes (downLawOk 4 1 16)
    <+> ", value = simulate = simFast " <+> yes (downAgree 4 2 32));
  IO.println ("stream bundles " <+> yes streamBundlesOk <+> ", well formed " <+> yes netWellFormed)
