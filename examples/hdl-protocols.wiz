-- The protocol bridges (`import Hdl.Apb`, `Hdl.Wishbone`, `Hdl.AxiLite`): APB in both
-- directions, classic Wishbone in both directions, and the AXI4-Lite channel bundles.
-- The bus under test is the existing `Bus.ReqW` (valid/ready with byte strobes); no new
-- bus protocol is introduced. The laws of `Hdl.ProtocolLaw` (source stability, APB/WB
-- transfer stability, response/request matching and no lost strobes) are evaluated on
-- generated traces, and the value simulation, `Netlist.simulate` and `Circuit.simFast`
-- are compared cycle for cycle. Run by the `bus-protocol` test group.
import Hdl.Core
import Hdl.Sim
import Hdl.Bus
import Hdl.BusLaw
import Hdl.Apb
import Hdl.Wishbone
import Hdl.AxiLite
import Hdl.ProtocolLaw
import IO

def Bit : HwTy := HwTy.bits 1
def B8 : HwTy := HwTy.bits 8
def B16 : HwTy := HwTy.bits 16

def yes (b : Bool) : String := match b with
  | .true => "yes"
  | .false => "NO"

def shows : List Nat → String
  | .nil => ""
  | .cons x xs => match xs with
    | .nil => Hdl.show x
    | .cons _ _ => Hdl.show x <+> " " <+> shows xs

def agree {ω i o : HwTy} (c : Circuit i o) (ins : List (HwTy.El i)) : Bool :=
  let ω v := Circuit.runLeaves c ins;
  Bool.and (BEq.beq v (Circuit.simFast c ins))
    (Bool.and (BEq.beq v (Circuit.simLeaves .true c ins)) (BEq.beq v (Circuit.simLeaves .false c ins)))

def allTrue : List Bool → Bool
  | .nil => .true
  | .cons b bs => Bool.and b (allTrue bs)

def bind {A B : Type} (f : A → List B) : List A → List B
  | .nil => .nil
  | .cons x xs => List.append (f x) (bind f xs)

def units (n : Nat) : List Nat := Hdl.upto n 0

def zipWith {A B C : Type} (f : A → B → C) : List A → List B → List C
  | .cons a as, .cons b bs => .cons (f a b) (zipWith f as bs)
  | _, _ => .nil

def n01 (b : Bool) : Nat := match b with
  | .true => 1
  | .false => 0

def eqNatList (xs ys : List Nat) : Bool := BEq.beq xs ys

def countTrue : List Bool → Nat
  | .nil => 0
  | .cons b bs => if b then Nat.succ (countTrue bs) else countTrue bs

def outPacks {ω t : HwTy} (xs : List (HwTy.El t)) : List Nat := Hdl.map (HwTy.pack t) xs

------------------------------------------------------------------------------------
-- Bundles as values

def reqWE (aw dw : Nat) (valid we addr wdata strb : Nat) : HwTy.El (Bus.ReqW.code aw dw) :=
  Bundle.toEl (Bus.ReqW.bundle aw dw)
    (Bus.ReqW.mk (BitVec.ofNat 1 valid) (BitVec.ofNat 1 we)
      (BitVec.ofNat aw addr) (BitVec.ofNat dw wdata)
      (BitVec.ofNat (Nat.div dw 8) strb))

def respE (dw : Nat) (ready rvalid err rdata : Nat) : HwTy.El (Bus.Resp.code dw) :=
  Bundle.toEl (Bus.Resp.bundle dw)
    (Bus.Resp.mk (BitVec.ofNat 1 ready) (BitVec.ofNat 1 rvalid)
      (BitVec.ofNat dw rdata) (BitVec.ofNat 1 err))

def apbReqE (aw dw : Nat) (psel penable pwrite paddr pwdata pstrb : Nat) :
    HwTy.El (Apb.Req.code aw dw) :=
  Bundle.toEl (Apb.Req.bundle aw dw)
    (Apb.Req.mk (BitVec.ofNat 1 psel) (BitVec.ofNat 1 penable) (BitVec.ofNat 1 pwrite)
      (BitVec.ofNat aw paddr) (BitVec.ofNat dw pwdata)
      (BitVec.ofNat (Nat.div dw 8) pstrb))

def apbRespE (dw : Nat) (pready prdata pslverr : Nat) : HwTy.El (Apb.Resp.code dw) :=
  Bundle.toEl (Apb.Resp.bundle dw)
    (Apb.Resp.mk (BitVec.ofNat 1 pready) (BitVec.ofNat dw prdata) (BitVec.ofNat 1 pslverr))

def wbReqE (aw dw : Nat) (cyc stb we adr dat sel : Nat) : HwTy.El (Wishbone.Req.code aw dw) :=
  Bundle.toEl (Wishbone.Req.bundle aw dw)
    (Wishbone.Req.mk (BitVec.ofNat 1 cyc) (BitVec.ofNat 1 stb) (BitVec.ofNat 1 we)
      (BitVec.ofNat aw adr) (BitVec.ofNat dw dat)
      (BitVec.ofNat (Nat.div dw 8) sel))

def wbRespE (dw : Nat) (ack err rty stall dat : Nat) : HwTy.El (Wishbone.Resp.code dw) :=
  Bundle.toEl (Wishbone.Resp.bundle dw)
    (Wishbone.Resp.mk (BitVec.ofNat 1 ack) (BitVec.ofNat 1 err) (BitVec.ofNat 1 rty)
      (BitVec.ofNat 1 stall) (BitVec.ofNat dw dat))

def byteOf (w k : Nat) : Nat := Nat.mod (Nat.div w (Nat.pow 2 (Nat.mul 8 k))) 256

def merge16 (old new mask : Nat) : Nat :=
  let b0 := if Nat.beq (Nat.mod mask 2) 1 then byteOf new 0 else byteOf old 0;
  let b1 := if Nat.beq (Nat.div mask 2) 1 then byteOf new 1 else byteOf old 1;
  Nat.add b0 (Nat.mul 256 b1)

------------------------------------------------------------------------------------
-- 1. Bus master -> APB slave: the two-phase bridge.
--
-- The bus source offers one request at a time and advances only when the bridge answers
-- (the valid/ready source obligation); the APB slave stalls every third cycle. The
-- generated `Apb.In` trace drives `Apb.busToApbC`, and the checks use the circuit's
-- actual outputs, not the generator's reference step.

def apbInE (valid we addr wdata strb pready prdata pslverr : Nat) :
    HwTy.El (Apb.In.code 8 16) :=
  Bundle.toEl (Apb.In.bundle 8 16)
    (Apb.In.mk (Bus.ReqW.unpack 8 16 (reqWE 8 16 valid we addr wdata strb))
      (Apb.Resp.unpack 16 (apbRespE 16 pready prdata pslverr)))

def genApbAux : Nat → Apb.St 8 16 HwTy.El → Nat → Nat → Nat → Nat → Nat →
    List (HwTy.El (Apb.In.code 8 16) × HwTy.El (Apb.Out.code 8 16))
  | .zero, _, _, _, _, _, _ => .nil
  | .succ f, s, addr, wdata, mask, we, k =>
    let pready := n01 (Nat.beq (Nat.mod k 3) 2);
    let prdata := Nat.mod (Nat.mul (Nat.succ k) 37) 65536;
    let i := Apb.In.unpack 8 16 (apbInE 1 we addr wdata mask pready prdata 0);
    let r := Apb.step s i;
    let s' := Apb.St.unpack 8 16 (Hw.fst r);
    let o := Apb.Out.unpack 8 16 (Hw.snd r);
    let ack := Bus.Law.ackS o.resp;
    let addr' := if ack then Nat.mod (Nat.succ addr) 8 else addr;
    let we' := if ack then n01 (Bool.not (Nat.beq (Nat.mod addr 4) 3)) else we;
    let wdata' := if ack then Nat.mod (Nat.add (Nat.mul wdata 37) 11) 65536 else wdata;
    let mask' := if ack then Nat.mod (Nat.succ mask) 4 else mask;
    .cons (apbInE 1 we addr wdata mask pready prdata 0, Hw.snd r)
      (genApbAux f s' addr' wdata' mask' we' (Nat.succ k))

def apbPairs := genApbAux 96 (Apb.stInit 8 16) 0 4660 3 1 0
def apbIns : List (HwTy.El (Apb.In.code 8 16)) := Hdl.fsts apbPairs
def apbOuts : List (HwTy.El (Apb.Out.code 8 16)) := Hdl.snds apbPairs
def apbRun : List (HwTy.El (Apb.Out.code 8 16)) := Circuit.run (Apb.busToApbC 8 16) apbIns

def apbReqOf (o : HwTy.El (Apb.Out.code 8 16)) : HwTy.El (Apb.Req.code 8 16) :=
  Apb.Req.pack 8 16 (Apb.Out.unpack 8 16 o).req
def apbSlaveOf (i : HwTy.El (Apb.In.code 8 16)) : HwTy.El (Apb.Resp.code 16) :=
  Apb.Resp.pack 16 (Apb.In.unpack 8 16 i).slave
def busReqOfIn (i : HwTy.El (Apb.In.code 8 16)) : HwTy.El (Bus.ReqW.code 8 16) :=
  Bus.ReqW.pack 8 16 (Apb.In.unpack 8 16 i).req
def busRespOfOut (o : HwTy.El (Apb.Out.code 8 16)) : HwTy.El (Bus.Resp.code 16) :=
  Bus.Resp.pack 16 (Apb.Out.unpack 8 16 o).resp

def apbRunMatches : Bool :=
  eqNatList (outPacks apbRun) (outPacks apbOuts)

-- APB stability while a transfer is in flight (output request vs the APB slave answer)
def apbZip : List (HwTy.El (Apb.In.code 8 16) × HwTy.El (Apb.Out.code 8 16)) :=
  zipWith (fun (i : HwTy.El (Apb.In.code 8 16)) (o : HwTy.El (Apb.Out.code 8 16)) => (i, o))
    apbIns apbRun

def apbStablePairs : List (HwTy.El (Apb.In.code 8 16) × HwTy.El (Apb.Out.code 8 16)) → Bool
  | .cons (i, o) rest =>
    match rest with
    | .cons (i', o') _ =>
      Bool.and (Apb.Law.StableStep (apbReqOf o) (apbSlaveOf i) (apbReqOf o'))
        (apbStablePairs rest)
    | .nil => .true
  | .nil => .true

def apbStableCheck : Bool := apbStablePairs apbZip

-- The bus source's own obligation: q is held while the bridge has not answered
def apbSourcePairs : List (HwTy.El (Apb.In.code 8 16) × HwTy.El (Apb.Out.code 8 16)) → Bool
  | .cons (i, o) rest =>
    match rest with
    | .cons (i', o') _ =>
      Bool.and
        (Bus.Law.ReqWStableStep (busReqOfIn i) (busRespOfOut o) (busReqOfIn i'))
        (Bool.and
          (Bus.Law.ReqWPayloadStableStep (busReqOfIn i) (busRespOfOut o) (busReqOfIn i'))
          (Bool.and
            (Bus.Law.ReqWAddressStableStep (busReqOfIn i) (busRespOfOut o) (busReqOfIn i'))
            (Bool.and
              (Bus.Law.ReqWStrobeStableStep (busReqOfIn i) (busRespOfOut o) (busReqOfIn i'))
              (apbSourcePairs rest))))
    | .nil => .true
  | .nil => .true

def apbSourceStableCheck : Bool := apbSourcePairs apbZip

def apbRespMatchesAll : List Bool :=
  zipWith (fun (i : HwTy.El (Apb.In.code 8 16)) (o : HwTy.El (Apb.Out.code 8 16)) =>
    Bool.and
      (Apb.Law.ResponseMatchesStep (busReqOfIn i) (busRespOfOut o) (apbReqOf o))
      (Apb.Law.StrobeToApbStep (busReqOfIn i) (apbReqOf o))) apbIns apbRun

def apbSetups : Nat :=
  countTrue (Hdl.map (fun (o : HwTy.El (Apb.Out.code 8 16)) =>
    let p := Apb.Out.unpack 8 16 o;
    Bool.and (Bus.Law.bit p.req.psel) (Bool.not (Bus.Law.bit p.req.penable))) apbRun)

def apbAcks : Nat :=
  countTrue (Hdl.map (fun (o : HwTy.El (Apb.Out.code 8 16)) =>
    Bus.Law.ack (busRespOfOut o)) apbRun)

def apbOneAckPerTransfer : Bool := Nat.beq apbAcks apbSetups

def collectApbAckAddrs : List (HwTy.El (Apb.Out.code 8 16)) → List Nat
  | .nil => .nil
  | .cons o rest =>
    let p := Apb.Out.unpack 8 16 o;
    if Bus.Law.ackS p.resp then
      .cons (BitVec.toNat p.req.paddr) (collectApbAckAddrs rest)
    else collectApbAckAddrs rest

def ackSeq (n : Nat) : List Nat := Hdl.map (fun (k : Nat) => Nat.mod k 8) (units n)

def apbOrderOk : Bool := eqNatList (collectApbAckAddrs apbRun) (ackSeq apbAcks)

def apbAgree : Bool := agree (Apb.busToApbC 8 16) apbIns

-- The APB request seen by the slave, for the record: PSEL/PENABLE/PADDR/PWDATA/PSTRB.
def apbTrace : List Nat :=
  Hdl.map (fun (o : HwTy.El (Apb.Out.code 8 16)) =>
    let p := Apb.Out.unpack 8 16 o;
    Nat.add (n01 (Bus.Law.bit p.req.psel))
      (Nat.add (Nat.mul 2 (n01 (Bus.Law.bit p.req.penable)))
        (Nat.add (Nat.mul 4 (n01 (Bus.Law.bit p.req.pwrite)))
          (Nat.add (Nat.mul 8 (BitVec.toNat p.req.paddr))
            (Nat.add (Nat.mul 128 (BitVec.toNat p.req.pstrb))
              (Nat.mul 512 (BitVec.toNat p.req.pwdata))))))) apbRun

------------------------------------------------------------------------------------
-- 2. APB master -> Bus slave: the combinational direction, with the bus RAM model as
-- the slave. The APB master writes each 16-bit address twice (all bytes, then a mask)
-- and reads it back; the read data is the byte merge the strobes ask for.

def apbScript : List (Nat × Nat × Nat × Nat) :=
  bind (fun (mask : Nat) =>
    .cons (1, (mask, (43690, 3)))
      (.cons (1, (mask, (Nat.add 21845 (Nat.mul 11 mask), mask)))
        (.cons (0, (mask, (0, 0))) .nil))) (units 4)

def apbToBusInE (psel penable pwrite paddr pwdata pstrb sready srvalid serr srdata : Nat) :
    HwTy.El (Apb.ToBusIn.code 8 16) :=
  Bundle.toEl (Apb.ToBusIn.bundle 8 16)
    (Apb.ToBusIn.mk
      (Apb.Req.unpack 8 16 (apbReqE 8 16 psel penable pwrite paddr pwdata pstrb))
      (Bus.Resp.unpack 16 (respE 16 sready srvalid serr srdata)))

def genApbToBusAux (fuel : Nat) (phase : Nat) (ram : Bus.Ram 6 16 HwTy.El)
    (script : List (Nat × Nat × Nat × Nat)) :
    List (HwTy.El (Apb.ToBusIn.code 8 16) × HwTy.El (Apb.ToBusOut.code 8 16)) :=
  match fuel with
  | .zero => .nil
  | .succ f =>
    let head := match script with
      | .cons x _ => x
      | .nil => (0, (0, (0, 0)));
    let we := head.1;
    let addr := head.2.1;
    let data := head.2.2.1;
    let mask := head.2.2.2;
    let psel := n01 (Bool.not (Nat.beq phase 0));
    let penable := n01 (Nat.beq phase 2);
    let p : Apb.Req 8 16 HwTy.El :=
      Apb.Req.mk (BitVec.ofNat 1 psel) (BitVec.ofNat 1 penable) (BitVec.ofNat 1 we)
        (BitVec.ofNat 8 addr) (BitVec.ofNat 16 data) (BitVec.ofNat 2 mask);
    let q := Apb.toBusReq p;
    let step := Bus.ramWStep 0 6 16 ram q;
    let ram' := Bus.Ram.unpack 6 16 (Hw.fst step);
    let b := Bus.Resp.unpack 16 (Hw.snd step);
    let ar := Apb.respOfBus p b;
    let pready := BitVec.isTrue ar.pready;
    let phase' := match phase with
      | .zero => match script with
        | .cons _ _ => 1
        | .nil => 0
      | .succ k => match k with
        | .zero => 2
        | .succ _ => if pready then 0 else 2;
    let script' := match phase with
      | .succ k => match k with
        | .succ _ => if pready then (match script with | .cons _ rest => rest | .nil => .nil) else script
        | .zero => script
      | .zero => script;
    let x := Bundle.toEl (Apb.ToBusIn.bundle 8 16) (Apb.ToBusIn.mk p b);
    let y := Bundle.toEl (Apb.ToBusOut.bundle 8 16) (Apb.ToBusOut.mk q ar);
    .cons (x, y) (genApbToBusAux f phase' ram' script')

def apbToBusPairs := genApbToBusAux 100 0 (Bus.ramInit 6 16) apbScript
def apbToBusIns : List (HwTy.El (Apb.ToBusIn.code 8 16)) := Hdl.fsts apbToBusPairs
def apbToBusOuts : List (HwTy.El (Apb.ToBusOut.code 8 16)) := Hdl.snds apbToBusPairs
def apbToBusRun : List (HwTy.El (Apb.ToBusOut.code 8 16)) :=
  Circuit.run (Apb.apbToBusC 8 16) apbToBusIns

def toBusApbOf (i : HwTy.El (Apb.ToBusIn.code 8 16)) : HwTy.El (Apb.Req.code 8 16) :=
  Apb.Req.pack 8 16 (Apb.ToBusIn.unpack 8 16 i).apb
def toBusSlaveOf (i : HwTy.El (Apb.ToBusIn.code 8 16)) : HwTy.El (Bus.Resp.code 16) :=
  Bus.Resp.pack 16 (Apb.ToBusIn.unpack 8 16 i).slave
def toBusReqOf (o : HwTy.El (Apb.ToBusOut.code 8 16)) : HwTy.El (Bus.ReqW.code 8 16) :=
  Bus.ReqW.pack 8 16 (Apb.ToBusOut.unpack 8 16 o).req
def toBusApbRespOf (o : HwTy.El (Apb.ToBusOut.code 8 16)) : HwTy.El (Apb.Resp.code 16) :=
  Apb.Resp.pack 16 (Apb.ToBusOut.unpack 8 16 o).apb

def apbToBusRunMatches : Bool := eqNatList (outPacks apbToBusRun) (outPacks apbToBusOuts)
def apbToBusAgree : Bool := agree (Apb.apbToBusC 8 16) apbToBusIns

def apbToBusZip : List (HwTy.El (Apb.ToBusIn.code 8 16) × HwTy.El (Apb.ToBusOut.code 8 16)) :=
  zipWith (fun (i : HwTy.El (Apb.ToBusIn.code 8 16)) (o : HwTy.El (Apb.ToBusOut.code 8 16)) => (i, o))
    apbToBusIns apbToBusRun

-- APB master stability (APB response is the bridge's output)
def apbToBusStablePairs :
    List (HwTy.El (Apb.ToBusIn.code 8 16) × HwTy.El (Apb.ToBusOut.code 8 16)) → Bool
  | .cons (i, o) rest =>
    match rest with
    | .cons (i', _) _ =>
      Bool.and (Apb.Law.StableStep (toBusApbOf i) (toBusApbRespOf o) (toBusApbOf i'))
        (apbToBusStablePairs rest)
    | .nil => .true
  | .nil => .true

def apbToBusStable : Bool := apbToBusStablePairs apbToBusZip

-- Bus request stability (the bridge's request is held while the RAM is not ready)
def apbToBusReqStablePairs :
    List (HwTy.El (Apb.ToBusIn.code 8 16) × HwTy.El (Apb.ToBusOut.code 8 16)) → Bool
  | .cons (i, o) rest =>
    match rest with
    | .cons (i', o') _ =>
      Bool.and
        (Bus.Law.ReqWStableStep (toBusReqOf o) (toBusSlaveOf i) (toBusReqOf o'))
        (Bool.and
          (Bus.Law.ReqWPayloadStableStep (toBusReqOf o) (toBusSlaveOf i) (toBusReqOf o'))
          (Bool.and
            (Bus.Law.ReqWAddressStableStep (toBusReqOf o) (toBusSlaveOf i) (toBusReqOf o'))
            (Bool.and
              (Bus.Law.ReqWStrobeStableStep (toBusReqOf o) (toBusSlaveOf i) (toBusReqOf o'))
              (apbToBusReqStablePairs rest))))
    | .nil => .true
  | .nil => .true

def apbToBusReqStable : Bool := apbToBusReqStablePairs apbToBusZip

def apbToBusRespMatchesAll : List Bool :=
  zipWith (fun (i : HwTy.El (Apb.ToBusIn.code 8 16)) (o : HwTy.El (Apb.ToBusOut.code 8 16)) =>
    Bool.and
      (Apb.Law.PreadyOnlyAccessStep (toBusApbOf i) (toBusApbRespOf o))
      (Bool.and
        (Apb.Law.StrobeToBusStep (toBusApbOf i) (toBusReqOf o))
        (Apb.Law.ResponseMatchesStep (toBusReqOf o) (toBusSlaveOf i) (toBusApbOf i)))) apbToBusIns apbToBusRun

def collectApbReads :
    List (HwTy.El (Apb.ToBusIn.code 8 16) × HwTy.El (Apb.ToBusOut.code 8 16)) → List Nat
  | .nil => .nil
  | .cons (i, o) rest =>
    let p := Apb.ToBusIn.unpack 8 16 i;
    let a := Apb.ToBusOut.unpack 8 16 o;
    if Bool.and (BitVec.isTrue a.apb.pready) (Bool.not (BitVec.isTrue p.apb.pwrite))
    then .cons (BitVec.toNat a.apb.prdata) (collectApbReads rest)
    else collectApbReads rest

def apbD1 (mask : Nat) : Nat := Nat.add 21845 (Nat.mul 11 mask)

def apbReadsExpected : List Nat :=
  Hdl.map (fun (mask : Nat) => merge16 43690 (apbD1 mask) mask) (units 4)

def apbToBusReadOk : Bool := eqNatList (collectApbReads apbToBusZip) apbReadsExpected

def apbToBusAcks : Nat :=
  countTrue (Hdl.map (fun (o : HwTy.El (Apb.ToBusOut.code 8 16)) =>
    Apb.Law.pready (toBusApbRespOf o)) apbToBusRun)

------------------------------------------------------------------------------------
-- 3. Bus master -> classic Wishbone slave: a combinational field mapping.
--
-- The Wishbone slave acknowledges every second cycle. The bus source advances on the
-- bridge's answer, so the trace is a legal valid/ready stream.

def wbInE (valid we addr wdata strb ack err rty stall dat : Nat) :
    HwTy.El (Wishbone.In.code 8 16) :=
  Bundle.toEl (Wishbone.In.bundle 8 16)
    (Wishbone.In.mk
      (Bus.ReqW.unpack 8 16 (reqWE 8 16 valid we addr wdata strb))
      (Wishbone.Resp.unpack 16 (wbRespE 16 ack err rty stall dat)))

def genWbAux (fuel : Nat) (addr data mask we k : Nat) :
    List (HwTy.El (Wishbone.In.code 8 16) × HwTy.El (Wishbone.Out.code 8 16)) :=
  match fuel with
  | .zero => .nil
  | .succ f =>
    let ack := n01 (Nat.beq (Nat.mod k 2) 1);
    let dat := Nat.mod (Nat.mul k 13) 65536;
    let i := wbInE 1 we addr data mask ack 0 0 0 dat;
    let o := Wishbone.busToWbComb 8 16 i;
    let r := Wishbone.Out.unpack 8 16 o;
    let done := Bus.Law.ackS r.resp;
    let addr' := if done then Nat.mod (Nat.succ addr) 8 else addr;
    let we' := if done then n01 (Bool.not (Nat.beq (Nat.mod addr 4) 3)) else we;
    let data' := if done then Nat.mod (Nat.add (Nat.mul data 41) 7) 65536 else data;
    let mask' := if done then Nat.mod (Nat.succ mask) 4 else mask;
    .cons (i, o) (genWbAux f addr' data' mask' we' (Nat.succ k))

def wbPairs := genWbAux 64 0 4660 3 1 0
def wbIns : List (HwTy.El (Wishbone.In.code 8 16)) := Hdl.fsts wbPairs
def wbOuts : List (HwTy.El (Wishbone.Out.code 8 16)) := Hdl.snds wbPairs
def wbRun : List (HwTy.El (Wishbone.Out.code 8 16)) :=
  Circuit.run (Wishbone.busToWbC 8 16) wbIns

def wbReqOf (o : HwTy.El (Wishbone.Out.code 8 16)) : HwTy.El (Wishbone.Req.code 8 16) :=
  Wishbone.Req.pack 8 16 (Wishbone.Out.unpack 8 16 o).req
def wbBusRespOf (o : HwTy.El (Wishbone.Out.code 8 16)) : HwTy.El (Bus.Resp.code 16) :=
  Bus.Resp.pack 16 (Wishbone.Out.unpack 8 16 o).resp
def wbSlaveOf (i : HwTy.El (Wishbone.In.code 8 16)) : HwTy.El (Wishbone.Resp.code 16) :=
  Wishbone.Resp.pack 16 (Wishbone.In.unpack 8 16 i).slave
def wbBusReqOf (i : HwTy.El (Wishbone.In.code 8 16)) : HwTy.El (Bus.ReqW.code 8 16) :=
  Bus.ReqW.pack 8 16 (Wishbone.In.unpack 8 16 i).req

def wbRunMatches : Bool := eqNatList (outPacks wbRun) (outPacks wbOuts)
def wbAgree : Bool := agree (Wishbone.busToWbC 8 16) wbIns

def wbZip : List (HwTy.El (Wishbone.In.code 8 16) × HwTy.El (Wishbone.Out.code 8 16)) :=
  zipWith (fun (i : HwTy.El (Wishbone.In.code 8 16)) (o : HwTy.El (Wishbone.Out.code 8 16)) => (i, o))
    wbIns wbRun

def wbRespMatchesAll : List Bool :=
  zipWith (fun (i : HwTy.El (Wishbone.In.code 8 16)) (o : HwTy.El (Wishbone.Out.code 8 16)) =>
    Bool.and
      (Wishbone.Law.ResponseMatchesStep (wbBusReqOf i) (wbBusRespOf o) (wbReqOf o))
      (Wishbone.Law.StrobeToWbStep (wbBusReqOf i) (wbReqOf o))) wbIns wbRun

def wbStablePairs : List (HwTy.El (Wishbone.In.code 8 16) × HwTy.El (Wishbone.Out.code 8 16)) → Bool
  | .cons (i, o) rest =>
    match rest with
    | .cons (i', o') _ =>
      Bool.and
        (Wishbone.Law.StableStep (wbReqOf o) (wbSlaveOf i) (wbReqOf o'))
        (Bool.and
          (Bus.Law.ReqWStableStep (wbBusReqOf i) (wbBusRespOf o) (wbBusReqOf i'))
          (Bool.and
            (Bus.Law.ReqWPayloadStableStep (wbBusReqOf i) (wbBusRespOf o) (wbBusReqOf i'))
            (Bus.Law.ReqWStrobeStableStep (wbBusReqOf i) (wbBusRespOf o) (wbBusReqOf i'))))
    | .nil => .true
  | .nil => .true

def wbStable : Bool := wbStablePairs wbZip

def collectWbAckAddrs : List (HwTy.El (Wishbone.Out.code 8 16)) → List Nat
  | .nil => .nil
  | .cons o rest =>
    let p := Wishbone.Out.unpack 8 16 o;
    if Bus.Law.ackS p.resp then
      .cons (BitVec.toNat p.req.adr) (collectWbAckAddrs rest)
    else collectWbAckAddrs rest

def wbAcks : Nat :=
  countTrue (Hdl.map (fun (o : HwTy.El (Wishbone.Out.code 8 16)) =>
    Bus.Law.ack (wbBusRespOf o)) wbRun)

def wbOrderOk : Bool := eqNatList (collectWbAckAddrs wbRun) (ackSeq wbAcks)

-- The error/retry mapping: a slave ERR or RTY ends the bus request as an error (the
-- wiz bus has no retry), and neither response is invented without a request.
def wbErrOk : Bool :=
  let i := wbInE 1 1 7 0 0 0 1 0 0 0;
  let o := Wishbone.Out.unpack 8 16 (Wishbone.busToWbComb 8 16 i);
  Bool.and (Bus.Law.bit o.resp.ready) (Bool.and (Bus.Law.bit o.resp.err)
    (Bool.not (Bus.Law.bit o.resp.rvalid)))

def wbRtyOk : Bool :=
  let i := wbInE 1 1 7 0 0 0 0 1 0 0;
  let o := Wishbone.Out.unpack 8 16 (Wishbone.busToWbComb 8 16 i);
  Bool.and (Bus.Law.bit o.resp.ready) (Bool.and (Bus.Law.bit o.resp.err)
    (Bool.not (Bus.Law.bit o.resp.rvalid)))

def wbNoRequestOk : Bool :=
  let i := wbInE 0 0 7 0 0 1 1 1 0 0;
  let o := Wishbone.Out.unpack 8 16 (Wishbone.busToWbComb 8 16 i);
  Bool.and (Bool.not (Bus.Law.bit o.resp.ready)) (Bool.not (Bus.Law.bit o.resp.rvalid))

------------------------------------------------------------------------------------
-- 4. Wishbone master -> Bus slave, with the bus RAM model and the same write/read
-- script as the APB direction: every mask's bytes are read back.

def wbToBusInE (cyc stb we adr dat sel ack err rty stall rdat : Nat) :
    HwTy.El (Wishbone.ToBusIn.code 8 16) :=
  Bundle.toEl (Wishbone.ToBusIn.bundle 8 16)
    (Wishbone.ToBusIn.mk
      (Wishbone.Req.unpack 8 16 (wbReqE 8 16 cyc stb we adr dat sel))
      (Bus.Resp.unpack 16 (respE 16 ack ack err rdat)))

def genWbToBusAux (fuel : Nat) (phase : Nat) (ram : Bus.Ram 6 16 HwTy.El)
    (script : List (Nat × Nat × Nat × Nat)) :
    List (HwTy.El (Wishbone.ToBusIn.code 8 16) × HwTy.El (Wishbone.ToBusOut.code 8 16)) :=
  match fuel with
  | .zero => .nil
  | .succ f =>
    let head := match script with
      | .cons x _ => x
      | .nil => (0, (0, (0, 0)));
    let we := head.1;
    let addr := head.2.1;
    let data := head.2.2.1;
    let mask := head.2.2.2;
    let active := n01 (Bool.not (Nat.beq phase 0));
    let p : Wishbone.Req 8 16 HwTy.El :=
      Wishbone.Req.mk (BitVec.ofNat 1 active) (BitVec.ofNat 1 active) (BitVec.ofNat 1 we)
        (BitVec.ofNat 8 addr) (BitVec.ofNat 16 data) (BitVec.ofNat 2 mask);
    let q := Wishbone.toBusReq p;
    let step := Bus.ramWStep 0 6 16 ram q;
    let ram' := Bus.Ram.unpack 6 16 (Hw.fst step);
    let b := Bus.Resp.unpack 16 (Hw.snd step);
    let wr := Wishbone.respOfBus p b;
    let ack := BitVec.isTrue wr.ack;
    let phase' := match phase with
      | .zero => match script with
        | .cons _ _ => 1
        | .nil => 0
      | .succ _ => if ack then 0 else 1;
    let script' := if Bool.and (Bool.not (Nat.beq phase 0)) ack
      then (match script with | .cons _ rest => rest | .nil => .nil) else script;
    let x := Bundle.toEl (Wishbone.ToBusIn.bundle 8 16) (Wishbone.ToBusIn.mk p b);
    let y := Bundle.toEl (Wishbone.ToBusOut.bundle 8 16) (Wishbone.ToBusOut.mk q wr);
    .cons (x, y) (genWbToBusAux f phase' ram' script')

def wbToBusPairs := genWbToBusAux 100 0 (Bus.ramInit 6 16) apbScript
def wbToBusIns : List (HwTy.El (Wishbone.ToBusIn.code 8 16)) := Hdl.fsts wbToBusPairs
def wbToBusOuts : List (HwTy.El (Wishbone.ToBusOut.code 8 16)) := Hdl.snds wbToBusPairs
def wbToBusRun : List (HwTy.El (Wishbone.ToBusOut.code 8 16)) :=
  Circuit.run (Wishbone.wbToBusC 8 16) wbToBusIns

def wbToBusWbOf (i : HwTy.El (Wishbone.ToBusIn.code 8 16)) : HwTy.El (Wishbone.Req.code 8 16) :=
  Wishbone.Req.pack 8 16 (Wishbone.ToBusIn.unpack 8 16 i).wb
def wbToBusSlaveOf (i : HwTy.El (Wishbone.ToBusIn.code 8 16)) : HwTy.El (Bus.Resp.code 16) :=
  Bus.Resp.pack 16 (Wishbone.ToBusIn.unpack 8 16 i).slave
def wbToBusReqOf (o : HwTy.El (Wishbone.ToBusOut.code 8 16)) : HwTy.El (Bus.ReqW.code 8 16) :=
  Bus.ReqW.pack 8 16 (Wishbone.ToBusOut.unpack 8 16 o).req
def wbToBusRespOf (o : HwTy.El (Wishbone.ToBusOut.code 8 16)) : HwTy.El (Wishbone.Resp.code 16) :=
  Wishbone.Resp.pack 16 (Wishbone.ToBusOut.unpack 8 16 o).wb

def wbToBusRunMatches : Bool := eqNatList (outPacks wbToBusRun) (outPacks wbToBusOuts)
def wbToBusAgree : Bool := agree (Wishbone.wbToBusC 8 16) wbToBusIns

def wbToBusZip : List (HwTy.El (Wishbone.ToBusIn.code 8 16) × HwTy.El (Wishbone.ToBusOut.code 8 16)) :=
  zipWith (fun (i : HwTy.El (Wishbone.ToBusIn.code 8 16)) (o : HwTy.El (Wishbone.ToBusOut.code 8 16)) => (i, o))
    wbToBusIns wbToBusRun

def wbToBusRespMatchesAll : List Bool :=
  zipWith (fun (i : HwTy.El (Wishbone.ToBusIn.code 8 16)) (o : HwTy.El (Wishbone.ToBusOut.code 8 16)) =>
    Bool.and
      (Wishbone.Law.AckOnlyReqStep (wbToBusWbOf i) (wbToBusRespOf o))
      (Bool.and
        (Wishbone.Law.StrobeToBusStep (wbToBusWbOf i) (wbToBusReqOf o))
        (Wishbone.Law.ResponseMatchesStep (wbToBusReqOf o) (wbToBusSlaveOf i) (wbToBusWbOf i))))
    wbToBusIns wbToBusRun

def wbToBusStablePairs :
    List (HwTy.El (Wishbone.ToBusIn.code 8 16) × HwTy.El (Wishbone.ToBusOut.code 8 16)) → Bool
  | .cons (i, o) rest =>
    match rest with
    | .cons (i', o') _ =>
      Bool.and
        (Wishbone.Law.StableStep (wbToBusWbOf i) (wbToBusRespOf o) (wbToBusWbOf i'))
        (Bool.and
          (Bus.Law.ReqWStableStep (wbToBusReqOf o) (wbToBusSlaveOf i) (wbToBusReqOf o'))
          (Bool.and
            (Bus.Law.ReqWPayloadStableStep (wbToBusReqOf o) (wbToBusSlaveOf i) (wbToBusReqOf o'))
            (Bus.Law.ReqWStrobeStableStep (wbToBusReqOf o) (wbToBusSlaveOf i) (wbToBusReqOf o'))))
    | .nil => .true
  | .nil => .true

def wbToBusStable : Bool := wbToBusStablePairs wbToBusZip

def collectWbReads :
    List (HwTy.El (Wishbone.ToBusIn.code 8 16) × HwTy.El (Wishbone.ToBusOut.code 8 16)) → List Nat
  | .nil => .nil
  | .cons (i, o) rest =>
    let p := Wishbone.ToBusIn.unpack 8 16 i;
    let a := Wishbone.ToBusOut.unpack 8 16 o;
    if Bool.and (BitVec.isTrue a.wb.ack) (Bool.not (BitVec.isTrue p.wb.we))
    then .cons (BitVec.toNat a.wb.dat) (collectWbReads rest)
    else collectWbReads rest

def wbToBusReadOk : Bool := eqNatList (collectWbReads wbToBusZip) apbReadsExpected

def wbToBusAcks : Nat :=
  countTrue (Hdl.map (fun (o : HwTy.El (Wishbone.ToBusOut.code 8 16)) =>
    Wishbone.Law.ack (wbToBusRespOf o)) wbToBusRun)

------------------------------------------------------------------------------------
-- 5. AXI4-Lite bundles: round trips and the Bus.ReqW views.

def axSlaveInV : AxiLite.SlaveIn 8 16 HwTy.El :=
  AxiLite.SlaveIn.mk
    (AxiLite.Aw.mk (BitVec.ofNat 8 42) (BitVec.ofNat 1 1))
    (AxiLite.W.mk (BitVec.ofNat 16 47806) (BitVec.ofNat 2 2) (BitVec.ofNat 1 1))
    (AxiLite.Ar.mk (BitVec.ofNat 8 7) (BitVec.ofNat 1 0))
    (BitVec.ofNat 1 1) (BitVec.ofNat 1 0)

def axSlaveOutV : AxiLite.SlaveOut 8 16 HwTy.El :=
  AxiLite.SlaveOut.mk (BitVec.ofNat 1 1) (BitVec.ofNat 1 1)
    (AxiLite.B.mk (BitVec.ofNat 2 0) (BitVec.ofNat 1 0))
    (BitVec.ofNat 1 0)
    (AxiLite.R.mk (BitVec.ofNat 16 47806) (BitVec.ofNat 2 0) (BitVec.ofNat 1 0))

def axRoundTrip {F : (HwTy → Type) → Type} (b : Bundle F) (x : F HwTy.El) : Bool :=
  Nat.beq (HwTy.pack b.code (Bundle.toEl b (Bundle.ofEl b (Bundle.toEl b x))))
    (HwTy.pack b.code (Bundle.toEl b x))

def axSlaveInOk : Bool :=
  axRoundTrip (AxiLite.SlaveIn.bundle 8 16) axSlaveInV
def axSlaveOutOk : Bool :=
  axRoundTrip (AxiLite.SlaveOut.bundle 8 16) axSlaveOutV

def axWriteOk : Bool :=
  AxiLite.Law.WriteReqOk (Bundle.toEl (AxiLite.Aw.bundle 8)
      (AxiLite.Aw.mk (BitVec.ofNat 8 42) (BitVec.ofNat 1 1)))
    (Bundle.toEl (AxiLite.W.bundle 16)
      (AxiLite.W.mk (BitVec.ofNat 16 47806) (BitVec.ofNat 2 2) (BitVec.ofNat 1 1)))

def axReadOk : Bool :=
  AxiLite.Law.ReadReqOk (aw := 8) (dw := 16)
    (Bundle.toEl (AxiLite.Ar.bundle 8) (AxiLite.Ar.mk (BitVec.ofNat 8 7) (BitVec.ofNat 1 1)))

def axErrOk : Bool :=
  Bool.and (AxiLite.Law.ErrOk (BitVec.ofNat 2 0))
    (Bool.and (AxiLite.Law.ErrOk (BitVec.ofNat 2 1))
      (Bool.and (AxiLite.Law.ErrOk (BitVec.ofNat 2 2))
        (AxiLite.Law.ErrOk (BitVec.ofNat 2 3))))

def protocolWellFormed : Bool :=
  Bool.and (Netlist.wellFormed (Circuit.netlist "apb" (Apb.busToApbC 8 16)))
    (Bool.and (Netlist.wellFormed (Circuit.netlist "apb_to_bus" (Apb.apbToBusC 8 16)))
      (Bool.and (Netlist.wellFormed (Circuit.netlist "wb" (Wishbone.busToWbC 8 16)))
        (Netlist.wellFormed (Circuit.netlist "wb_to_bus" (Wishbone.wbToBusC 8 16)))))

------------------------------------------------------------------------------------

def main : IO Unit := do
  IO.println ("apb bus->slave: generated matches " <+> yes apbRunMatches
    <+> ", value = simulate = simFast " <+> yes apbAgree
    <+> ", " <+> Hdl.show (List.length apbIns) <+> " cycles");
  IO.println ("apb bus->slave: stable " <+> yes apbStableCheck
    <+> ", source stable " <+> yes apbSourceStableCheck
    <+> ", responses match " <+> yes (allTrue apbRespMatchesAll)
    <+> ", one ack per transfer " <+> yes apbOneAckPerTransfer
    <+> " (" <+> Hdl.show apbAcks <+> " acks, " <+> Hdl.show apbSetups <+> " setups)"
    <+> ", order " <+> yes apbOrderOk);
  IO.println ("apb master->bus: generated matches " <+> yes apbToBusRunMatches
    <+> ", value = simulate = simFast " <+> yes apbToBusAgree
    <+> ", apb stable " <+> yes apbToBusStable
    <+> ", bus stable " <+> yes apbToBusReqStable
    <+> ", responses match " <+> yes (allTrue apbToBusRespMatchesAll));
  IO.println ("apb master->bus: reads " <+> shows (collectApbReads apbToBusZip)
    <+> " = " <+> shows apbReadsExpected <+> " " <+> yes apbToBusReadOk
    <+> ", " <+> Hdl.show apbToBusAcks <+> " transfers");
  IO.println ("wishbone bus->slave: generated matches " <+> yes wbRunMatches
    <+> ", value = simulate = simFast " <+> yes wbAgree
    <+> ", stable " <+> yes wbStable
    <+> ", responses match " <+> yes (allTrue wbRespMatchesAll)
    <+> ", order " <+> yes wbOrderOk
    <+> ", err/rty/no-request " <+> yes wbErrOk <+> " " <+> yes wbRtyOk <+> " " <+> yes wbNoRequestOk);
  IO.println ("wishbone master->bus: generated matches " <+> yes wbToBusRunMatches
    <+> ", value = simulate = simFast " <+> yes wbToBusAgree
    <+> ", stable " <+> yes wbToBusStable
    <+> ", responses match " <+> yes (allTrue wbToBusRespMatchesAll)
    <+> ", reads " <+> shows (collectWbReads wbToBusZip) <+> " " <+> yes wbToBusReadOk
    <+> ", " <+> Hdl.show wbToBusAcks <+> " transfers");
  IO.println ("axi-lite bundles: slave-in " <+> yes axSlaveInOk <+> ", slave-out " <+> yes axSlaveOutOk
    <+> ", write view " <+> yes axWriteOk <+> ", read view " <+> yes axReadOk
    <+> ", resp " <+> yes axErrOk);
  IO.println ("well formed " <+> yes protocolWellFormed)
