-- The tour, section 6: `calc` chains (docs/tour.md).
import Nat

-- Adjacent steps compose through the `Trans` class; the last relation is the result.
def lt_of_chain (a b c d : Nat) (h1 : a ≤ b) (h2 : b < c) (h3 : c ≤ d) : a < d :=
  calc a ≤ b := h1
       _ < c := h2
       _ ≤ d := h3

#print axioms lt_of_chain
