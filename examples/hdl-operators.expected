examples/hdl-operators.wiz:52:1: info: "module count(input clk, input [0:0] x, output [3:0] y);\n  reg [3:0] r; initial r = 4'd0;\n  wire [0:0] n3 = r == 4'd9;\n  wire [3:0] n6 = r + 4'd1;\n  wire [3:0] n7 = n3 ? 4'd0 : n6;\n  always @(posedge clk) r <= n7;\n  assign y = r;\nendmodule\n"
