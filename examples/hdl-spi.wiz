-- The SPI master in all four CPOL/CPHA modes (`import Hdl.Spi`, `Hdl.SpiLaw`): a
-- divider sweep, the byte round-trip through a mock slave, the mosi/sclk timing law, the
-- loopback, and the byte-level transfer model. Run by the `bus-protocol` test group;
-- yosys runs on the emitted Verilog when it is on PATH.
import Hdl.Core
import Hdl.Sim
import Hdl.Spi
import Hdl.SpiLaw
import IO

def yes (b : Bool) : String := match b with
  | .true => "yes"
  | .false => "NO"

def n01 (b : Bool) : Nat := match b with
  | .true => 1
  | .false => 0

def units (n : Nat) : List Nat := Hdl.upto n 0

def allTrue : List Bool → Bool
  | .nil => .true
  | .cons b bs => Bool.and b (allTrue bs)

def agree {ω i o : HwTy} (c : Circuit i o) (ins : List (HwTy.El i)) : Bool :=
  let ω v := Circuit.runLeaves c ins;
  Bool.and (BEq.beq v (Circuit.simFast c ins))
    (Bool.and (BEq.beq v (Circuit.simLeaves .true c ins)) (BEq.beq v (Circuit.simLeaves .false c ins)))

------------------------------------------------------------------------------------
-- The link trace: start with `sent`, then quiet cycles long enough for `done` (the
-- divider is `div`, so the transfer is 16 * div cycles; the trace has four spare cycles).

def linkInE (start data reply : Nat) : HwTy.El (Spi.LinkInW.code 8) :=
  Bundle.toEl (Spi.LinkInW.bundle 8)
    (Spi.LinkInW.mk (BitVec.ofNat 1 start) (BitVec.ofNat 8 data) (BitVec.ofNat 8 reply))

def linkIns (sent reply div : Nat) : List (HwTy.El (Spi.LinkInW.code 8)) :=
  List.cons (linkInE 1 sent reply)
    (Hdl.map (fun (_ : Nat) => linkInE 0 0 reply) (units (Nat.add (Nat.mul 16 div) 4)))

def runLink (mode div sent reply : Nat) : List (HwTy.El (Spi.LinkOutW.code 8)) :=
  Circuit.run (Spi.linkC mode div) (linkIns sent reply div)

------------------------------------------------------------------------------------
-- The loopback trace: the master's `mosi` is its `miso`, so the byte received is the
-- byte sent.

def loopInE (start data sel : Nat) : HwTy.El (Spi.CmdW.code 8 1) :=
  Bundle.toEl (Spi.CmdW.bundle 8 1)
    (Spi.CmdW.mk (BitVec.ofNat 1 start) (BitVec.ofNat 8 data) (BitVec.ofNat 1 sel))

def loopIns (sent div : Nat) : List (HwTy.El (Spi.CmdW.code 8 1)) :=
  List.cons (loopInE 1 sent 0)
    (Hdl.map (fun (_ : Nat) => loopInE 0 0 0) (units (Nat.add (Nat.mul 16 div) 4)))

def runLoop (mode div sent : Nat) : List (HwTy.El (Spi.OutW.code 8 1)) :=
  Circuit.run (Spi.loopModeC mode div) (loopIns sent div)

def outDone (x : HwTy.El (Spi.OutW.code 8 1)) : Bool :=
  BitVec.isTrue (Spi.OutW.unpack 8 1 x).done

def firstDoneOut : Nat → List (HwTy.El (Spi.OutW.code 8 1)) → Nat
  | _, .nil => 99
  | k, .cons x xs => if outDone x then k else firstDoneOut (Nat.succ k) xs

def loopDoneAt (mode div sent : Nat) : Nat :=
  firstDoneOut 0 (runLoop mode div sent)

def loopData (mode div sent : Nat) : Nat :=
  let outs := runLoop mode div sent;
  let x := Hdl.nthD (HwTy.unpack (Spi.OutW.code 8 1) 0) outs (Nat.mul 16 div);
  BitVec.toNat (Spi.OutW.unpack 8 1 x).data

------------------------------------------------------------------------------------
-- The checks.

def linkDivider (mode div sent reply : Nat) : Bool :=
  Nat.beq (Spi.Law.firstDone 0 (runLink mode div sent reply)) (Nat.mul 16 div)

def linkByte (mode div sent reply : Nat) : Bool :=
  let xs := runLink mode div sent reply;
  let k := Spi.Law.firstDone 0 xs;
  Spi.Law.byteOk reply sent (Hdl.nthD (HwTy.unpack (Spi.LinkOutW.code 8) 0) xs k)

def linkTiming (mode div sent reply : Nat) : Bool :=
  let xs := runLink mode div sent reply;
  let cpol := Spi.modeCpol mode;
  let cpha := Spi.modeCpha mode;
  Bool.and (Spi.Law.sampleStableTrace cpol cpha xs)
    (Bool.and (Spi.Law.mosiOnShiftTrace cpol cpha xs)
      (Nat.beq (Spi.Law.SampleCountN cpol cpha xs) 8))

def linkOk (mode div sent reply : Nat) : Bool :=
  Bool.and (linkDivider mode div sent reply)
    (Bool.and (linkByte mode div sent reply)
      (Bool.and (Spi.Law.slaveDoneSeen (runLink mode div sent reply))
        (linkTiming mode div sent reply)))

def loopOk (mode div sent : Nat) : Bool :=
  Bool.and (Nat.beq (loopDoneAt mode div sent) (Nat.mul 16 div))
    (Nat.beq (loopData mode div sent) sent)

-- A divider sweep over all four modes: `div = 1 … 8`.
def dividerSweep : Bool :=
  allTrue (Hdl.map (fun (mode : Nat) =>
    allTrue (Hdl.map (fun (div : Nat) => linkOk mode div 165 60) (Hdl.upto 9 1)))
    (units 4))

def loopSweep : Bool :=
  allTrue (Hdl.map (fun (mode : Nat) =>
    allTrue (Hdl.map (fun (div : Nat) => loopOk mode div 165) (Hdl.upto 9 1)))
    (units 4))

-- The byte-level model: loopback is the identity on all 256 bytes, in every mode.
def transferBytes : Bool :=
  allTrue (Hdl.map (fun (mode : Nat) =>
    allTrue (Hdl.map (fun (n : Nat) =>
      Nat.beq (BitVec.toNat (Spi.transferLoop mode (U8.ofNat n))) n) (units 256)))
    (units 4))

------------------------------------------------------------------------------------
-- Mode 0 is the original mode-0 master: the generic mode-0 circuit and the original
-- `Spi.masterCW` agree cycle for cycle, and so do the two loopbacks.

def masterInE (start data sel : Nat) : HwTy.El (Spi.InW.code 8 1) :=
  let x : Spi.InW 8 1 HwTy.El :=
    Spi.InW.mk (w := 8) (ncs := 1) (r := HwTy.El) (BitVec.ofNat 1 0)
      (BitVec.ofNat 1 start) (BitVec.ofNat 8 data) (BitVec.ofNat (Spi.selW 1) sel);
  Bundle.toEl (Spi.InW.bundle 8 1) x

def masterIns (div : Nat) : List (HwTy.El (Spi.InW.code 8 1)) :=
  List.cons (masterInE 1 165 0)
    (Hdl.map (fun (_ : Nat) => masterInE 0 0 0) (units (Nat.add (Nat.mul 16 div) 4)))

def legacyMaster (div : Nat) : Bool :=
  let ins := masterIns div;
  BEq.beq
    (Hdl.map (HwTy.pack (Spi.OutW.code 8 1)) (Circuit.run (Spi.masterCW 8 Spi.cntW 1 div) ins))
    (Hdl.map (HwTy.pack (Spi.OutW.code 8 1)) (Circuit.run (Spi.masterModeCW 8 Spi.cntW 1 0 div) ins))

def netWellFormed : Bool :=
  Bool.and (Netlist.wellFormed (Circuit.netlist "spi_mode0" (Spi.masterModeCW 8 Spi.cntW 1 0 2)))
    (Bool.and (Netlist.wellFormed (Circuit.netlist "spi_mode3" (Spi.masterModeCW 8 Spi.cntW 1 3 2)))
      (Bool.and (Netlist.wellFormed (Circuit.netlist "spi_slave" (Spi.slaveC 2)))
        (Netlist.wellFormed (Circuit.netlist "spi_link" (Spi.linkC 2 2)))))

------------------------------------------------------------------------------------

def main : IO Unit := do
  IO.println ("spi modes: names " <+> Spi.modeName 0 <+> " | " <+> Spi.modeName 1 <+> " | "
    <+> Spi.modeName 2 <+> " | " <+> Spi.modeName 3);
  IO.println ("spi round-trip: mode 0 " <+> yes (linkOk 0 2 165 60)
    <+> ", mode 1 " <+> yes (linkOk 1 2 165 60)
    <+> ", mode 2 " <+> yes (linkOk 2 2 165 60)
    <+> ", mode 3 " <+> yes (linkOk 3 2 165 60));
  IO.println ("spi divider sweep div 1..8, all modes " <+> yes dividerSweep);
  IO.println ("spi loopback sweep div 1..8, all modes " <+> yes loopSweep
    <+> ", byte model " <+> yes transferBytes);
  IO.println ("spi mode 0 = original master " <+> yes (allTrue (Hdl.map legacyMaster (Hdl.upto 6 1)))
    <+> ", value = simulate = simFast "
    <+> yes (agree (Spi.linkC 3 2) (linkIns 165 60 2)));
  IO.println ("spi well formed " <+> yes netWellFormed)
