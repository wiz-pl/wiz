--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -194,9 +194,8 @@
           # `packages.wiz` is the default package; `packages.tests` is the test driver,
           # from the same build.
           nix build .#wiz .#tests --no-link -L
-          # the reference manual (wiz doc --lib --reference, with this wiz): a Cachix hit
-          # when the compiler and lib/ are unchanged; the docs job substitutes it
-          nix build .#reference --no-link -L
+          # No .#reference here: only the docs job reads it (and only on a push), and no
+          # shard waits on it. That job builds it from this cached wiz, off this path.
           wiz=$(nix path-info .#wiz)
           tests=$(nix path-info .#tests)
           echo "wiz=$wiz" >> "$GITHUB_OUTPUT"
@@ -228,7 +227,7 @@
             exit 0
           fi
           nix develop .#ci --command env CACHIX_AUTH_TOKEN="$CACHIX_AUTH_TOKEN" cachix push "$CACHIX_NAME" \
-            $(nix path-info .#wiz .#tests .#reference)
+            $(nix path-info .#wiz .#tests)
       - name: Publish the store paths to the PR cache
         # A pull request writes only its own untrusted cache, with its own token. If the
         # repository variable or secret is absent (or this is a fork), nothing is
@@ -243,7 +242,7 @@
             exit 0
           fi
           nix develop .#ci --command env CACHIX_AUTH_TOKEN="$CACHIX_PR_AUTH_TOKEN" cachix push "$CACHIX_PR_NAME" \
-            $(nix path-info .#wiz .#tests .#reference)
+            $(nix path-info .#wiz .#tests)
       - name: Every test case is in exactly one shard
         run: python3 scripts/ci.py check-shards "${{ steps.nix.outputs.tests }}/bin/tests"
       - name: Shards
@@ -446,7 +445,10 @@
           "${{ steps.nix.outputs.wiz }}/bin/wiz" doc --lib -o doc-site/docs --web web/out \
             --source-url "https://github.com/${{ github.repository }}/blob/${{ github.sha }}/lib/"
           ls doc-site/docs | head -50
-      - name: The reference manual's Markdown (nix build .#reference, from Cachix)
+      - name: The reference manual's Markdown (nix build .#reference)
+        # Built here, not in the `build` job: this is the only consumer, and only a push
+        # runs this job, so it is off the shards' critical path. It is generated from the
+        # `wiz` the build job published (a substitute), so it needs no rebuild of wiz.
         run: |
           ref=$(nix build .#reference --no-link --print-out-paths)
           cp "$ref/index.md" doc-site/docs/reference.md
