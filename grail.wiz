import Grail
-- The Wiz repository's build file (stage 23d): `grail build`, or `grail build std`.
-- Machine settings (where GMP lives) go in grail.local.wiz, which isn't committed.
-- Every example is a test (`grail test`): its messages against examples/NAME.expected.
def package : Package := Package.new "wiz"
  |> Package.set "libs" "-lm"
  |> Package.lib "std" "lib"
  -- Feral's runtime stand-ins (FeralCore), which examples/resources.wiz imports
  |> Package.lib "feral-core" "drafts/feral/lib"
  -- Scry is a package (`scry/src`), not part of `lib/` (separate-repos.md P0.1);
  -- examples/scry-*.wiz still import Scry.* during co-development. This is a module
  -- root, not a check target: `grail build std` and the `std` lib target stay `lib/`.
  |> Package.set "root" "scry/src"
  -- Hdl is its own package too (`hdl/src/Hdl`, separate-repos.md §1.2). The remaining
  -- examples and benches here that import Hdl.* (rune-*, hardware-tour, stdlib-bench)
  -- still resolve it during co-development; `grail build std` stays `lib/` alone and
  -- hdl's own examples are tested by `cd hdl && grail test`.
  |> Package.set "root" "hdl/src"
  |> Package.tests "examples" "examples"
  |> Package.exe "io" "examples/io.wiz"
  |> Package.exe "std-demo" "examples/std.wiz"
  |> Package.exe "effects" "examples/effects.wiz"
  |> Package.exe "foreign" "examples/foreign.wiz"
  |> Package.exe "glue" "examples/glue.wiz"
  |> Package.exe "import-c" "examples/import_c.wiz"
  -- the self-hosted toolchain; `grail build bootstrap` is the fixpoint check (minutes)
  |> Package.selfhost "selfhost-checker" "checker"
  |> Package.selfhost "selfhost-compiler" "compiler"
  |> Package.selfhost "bootstrap" "bootstrap"
