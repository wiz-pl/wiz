import Word
import Std

/-- The per-element operation. This is the definition the WGSL `fn addScalar` is emitted
from, and the one the interpreter evaluates for the reference numbers (`#eval` cannot run
the `Array` externs, so the buffers are the only part that is not interpreted). -/
def addScalar (x y : U32) : U32 := UIntN.add x y

/-- A second scalar kernel that exercises `match` on `Bool` and a multiply. -/
def maxMulScalar (x y : U32) : U32 :=
  match UIntN.lt x y with
  | .true => UIntN.mul y (U32.ofNat 3)
  | .false => x

/-- The entry kernel: a map over the buffers. `i` is the index the host supplies (the
dispatch's global invocation id); `a` and `b` are read-only buffers. -/
def add (i : Nat) (a b : Array U32) : U32 :=
  addScalar (Array.getD a i (U32.ofNat 0)) (Array.getD b i (U32.ofNat 0))

/-- The same map with the second scalar operation. -/
def maxMul (i : Nat) (a b : Array U32) : U32 :=
  maxMulScalar (Array.getD a i (U32.ofNat 0)) (Array.getD b i (U32.ofNat 0))
