import NormNum

def a : 2 + 2 = 4 := by norm_num
def b : (3 : Int) * 4 - 5 = 7 := by norm_num
def c : Q.mk 1 2 rfl + Q.mk 1 3 rfl ≈ Q.mk 5 6 rfl := by norm_num
def d (x : Nat) : x + (2 + 3) = x + 5 := by norm_num
def e : (2 : Nat) < 5 := by norm_num
def f : ¬ (2 : Nat) = 5 := by norm_num
def bad : (2 : Nat) + 2 = 5 := by norm_num
