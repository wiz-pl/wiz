/-
# `Bpf.C`: the flat-C emitter

The eBPF path is **not** `Wiz/Compiler/C.lean`. That emitter is the RC runtime: `uint64_t`
values, a heap, GMP, libc. This file prints the typed, first-order `BpfCore` to the flat,
freestanding C that `clang -target bpf` turns into an object (§3.2).

The shape is the one the verifier accepts (§2.3, §5.4), not a convenient one:

* the only pointers are the context, `data`/`data_end` and a helper's return; each packet
  accessor loads both bounds and does its check **in the same inline function** as the
  load, so an optimiser cannot separate them;
* a map lookup copies the value out and returns an `Option`; the map-value pointer is
  live for one `if` and never stored or returned;
* the surface has no pointer, so no Wiz value can be one;
* every function is `static __always_inline`, so the object has one frame and no call
  graph for the verifier to reject;
* `#line` points at the `.wiz` source, so a verifier log names a line a programmer knows.

P0 emits straight-line C plus `if`/`switch` for `Bool`, `Option` and enums. `Bpf.repeat`
(loops) and enums' default returns are P1; the emitter rejects anything else rather than
guessing. `bpf_rt.h` is emitted beside the C file; the post-`clang` checks (stack, symbols,
relocations, instruction budget) are the missing half of this phase and need a build slot
(§4.4's last two diagnostics are *post-emission*).
-/
import Init.Control.State
import Wiz.Compiler.Bpf.Check

namespace Wiz.Compiler.Bpf

/-! ## `bpf_rt.h` -/

/-- The freestanding header. In BPF mode the helper pointers are the standard
`(void *)N` idiom and the packet accessors do the `data`/`data_end` check in one block;
`BPF_HOSTED` is the shape the native oracle needs (maps as tables, the packet as a byte
buffer) — its implementation is P0's hosted-build item, not part of this skeleton. -/
def header : String := r##"/* bpf_rt.h — generated by wiz --target bpf (P0 skeleton); do not edit. */
#ifndef BPF_RT_H
#define BPF_RT_H

typedef unsigned char      __u8;
typedef unsigned short     __u16;
typedef unsigned int       __u32;
typedef unsigned long long __u64;
typedef signed char        __s8;
typedef short              __s16;
typedef int                __s32;
typedef long long          __s64;

#define __always_inline inline __attribute__((always_inline))
#define SEC(name) __attribute__((section(name), used))
#define __uint(name, val) int (*name)[val]
#define __type(name, val) typeof(val) *name

#define BPF_MAP_TYPE_HASH        1
#define BPF_MAP_TYPE_ARRAY       2
#define BPF_MAP_TYPE_PERCPU_ARRAY 6
#define BPF_MAP_TYPE_LRU_HASH    9
#define BPF_ANY     0
#define BPF_NOEXIST 1

/* XDP actions (bpf_attr.prog_type BPF_PROG_TYPE_XDP) */
#define XDP_ABORTED  0
#define XDP_DROP     1
#define XDP_PASS     2
#define XDP_TX       3
#define XDP_REDIRECT 4

/* TC actions */
#define TC_ACT_OK   0
#define TC_ACT_SHOT 2

#ifdef BPF_TC
/* struct __sk_buff is stable UAPI; only these fields are used, at their real offsets
   (data = 76, data_end = 80). There is no CO-RE and no vmlinux.h (§3.2). */
struct __sk_buff {
  __u32 len; __u32 pkt_type; __u32 mark; __u32 queue_mapping;
  __u32 protocol; __u32 vlan_present; __u32 vlan_tci; __u32 vlan_proto;
  __u32 priority; __u32 ingress_ifindex; __u32 ifindex; __u32 tc_index;
  __u32 cb[5]; __u32 hash; __u32 tc_classid; __u32 data; __u32 data_end;
};
typedef struct __sk_buff bpf_ctx;
#define BPF_DATA(ctx)     ((void *)(long)(ctx)->data)
#define BPF_DATA_END(ctx) ((void *)(long)(ctx)->data_end)
#define BPF_IFINDEX(ctx)  ((ctx)->ifindex)
#define BPF_RX_QUEUE(ctx) ((ctx)->queue_mapping)
#else
struct xdp_md {
  __u32 data; __u32 data_end; __u32 data_meta;
  __u32 ingress_ifindex; __u32 rx_queue_index; __u32 egress_ifindex;
};
typedef struct xdp_md bpf_ctx;
#define BPF_DATA(ctx)     ((void *)(long)(ctx)->data)
#define BPF_DATA_END(ctx) ((void *)(long)(ctx)->data_end)
#define BPF_IFINDEX(ctx)  ((ctx)->ingress_ifindex)
#define BPF_RX_QUEUE(ctx) ((ctx)->rx_queue_index)
#endif

static __always_inline __u32 ctx_ifindex(bpf_ctx *ctx) { return BPF_IFINDEX(ctx); }
static __always_inline __u32 ctx_rx_queue(bpf_ctx *ctx) { return BPF_RX_QUEUE(ctx); }

/* One block per load: both bounds are read here, the check is here, and the bytes are
   read here. Byte assembly avoids unaligned access and the endianness builtins. */
static __always_inline int pkt_load8(bpf_ctx *ctx, __u32 off, __u8 *out) {
  void *data = BPF_DATA(ctx);
  void *data_end = BPF_DATA_END(ctx);
  if ((void *)((__u8 *)data + off + 1) > data_end) return 0;
  *out = *((__u8 *)data + off);
  return 1;
}
static __always_inline int pkt_load16be(bpf_ctx *ctx, __u32 off, __u16 *out) {
  void *data = BPF_DATA(ctx);
  void *data_end = BPF_DATA_END(ctx);
  if ((void *)((__u8 *)data + off + 2) > data_end) return 0;
  __u8 *p = (__u8 *)data + off;
  *out = ((__u16)p[0] << 8) | (__u16)p[1];
  return 1;
}
static __always_inline int pkt_load16le(bpf_ctx *ctx, __u32 off, __u16 *out) {
  void *data = BPF_DATA(ctx);
  void *data_end = BPF_DATA_END(ctx);
  if ((void *)((__u8 *)data + off + 2) > data_end) return 0;
  __u8 *p = (__u8 *)data + off;
  *out = ((__u16)p[1] << 8) | (__u16)p[0];
  return 1;
}
static __always_inline int pkt_load32be(bpf_ctx *ctx, __u32 off, __u32 *out) {
  void *data = BPF_DATA(ctx);
  void *data_end = BPF_DATA_END(ctx);
  if ((void *)((__u8 *)data + off + 4) > data_end) return 0;
  __u8 *p = (__u8 *)data + off;
  *out = ((__u32)p[0] << 24) | ((__u32)p[1] << 16) | ((__u32)p[2] << 8) | (__u32)p[3];
  return 1;
}
static __always_inline int pkt_load32le(bpf_ctx *ctx, __u32 off, __u32 *out) {
  void *data = BPF_DATA(ctx);
  void *data_end = BPF_DATA_END(ctx);
  if ((void *)((__u8 *)data + off + 4) > data_end) return 0;
  __u8 *p = (__u8 *)data + off;
  *out = ((__u32)p[3] << 24) | ((__u32)p[2] << 16) | ((__u32)p[1] << 8) | (__u32)p[0];
  return 1;
}
static __always_inline int pkt_load64be(bpf_ctx *ctx, __u32 off, __u64 *out) {
  void *data = BPF_DATA(ctx);
  void *data_end = BPF_DATA_END(ctx);
  if ((void *)((__u8 *)data + off + 8) > data_end) return 0;
  __u8 *p = (__u8 *)data + off;
  *out = ((__u64)p[0] << 56) | ((__u64)p[1] << 48) | ((__u64)p[2] << 40) | ((__u64)p[3] << 32)
       | ((__u64)p[4] << 24) | ((__u64)p[5] << 16) | ((__u64)p[6] << 8)  | (__u64)p[7];
  return 1;
}
static __always_inline int pkt_load64le(bpf_ctx *ctx, __u32 off, __u64 *out) {
  void *data = BPF_DATA(ctx);
  void *data_end = BPF_DATA_END(ctx);
  if ((void *)((__u8 *)data + off + 8) > data_end) return 0;
  __u8 *p = (__u8 *)data + off;
  *out = ((__u64)p[7] << 56) | ((__u64)p[6] << 48) | ((__u64)p[5] << 40) | ((__u64)p[4] << 32)
       | ((__u64)p[3] << 24) | ((__u64)p[2] << 16) | ((__u64)p[1] << 8)  | (__u64)p[0];
  return 1;
}

/* Division by zero: the ISA gives 0 for BPF_DIV and leaves the destination for BPF_MOD;
   Wiz gives n / 0 = 0 and n % 0 = n (§1.4). The hosted oracle must agree, and C's `/`
   undefined at zero, so the macro is the definition in both modes. */
#ifdef BPF_HOSTED
static __always_inline __u64 bpf_udiv(__u64 a, __u64 b) { return b ? a / b : (__u64)0; }
static __always_inline __u64 bpf_umod(__u64 a, __u64 b) { return b ? a % b : a; }
#else
#define bpf_udiv(a, b) ((a) / (b))
#define bpf_umod(a, b) ((a) % (b))
#endif

#ifndef BPF_HOSTED
static void *(*bpf_map_lookup_elem)(void *map, const void *key) __attribute__((unused)) = (void *)1;
static long (*bpf_map_update_elem)(void *map, const void *key, const void *value,
                                   __u64 flags) __attribute__((unused)) = (void *)2;
static long (*bpf_map_delete_elem)(void *map, const void *key) __attribute__((unused)) = (void *)3;
static __u64 (*bpf_ktime_get_ns)(void) __attribute__((unused)) = (void *)5;
static __u32 (*bpf_get_prandom_u32)(void) __attribute__((unused)) = (void *)7;
#else
/* The hosted build (BPF_HOSTED) supplies these: maps as small tables and the packet as a
   byte buffer. Defined by the driver, not by this header (P0's hosted-build item). */
void *bpf_map_lookup_elem(void *map, const void *key);
long bpf_map_update_elem(void *map, const void *key, const void *value, __u64 flags);
long bpf_map_delete_elem(void *map, const void *key);
__u64 bpf_ktime_get_ns(void);
__u32 bpf_get_prandom_u32(void);
#endif

#endif /* BPF_RT_H */
"##

/-! ## Type names -/

/-- The C typedef names for the structured types used by a program. A Wiz structure is a
flat C struct (field order, natural alignment), and `Option t` is `{ tag; pad; value }`;
neither is the C backend's erased Σ. -/
structure Names where
  structs : Array (Ty × String) := #[]
  options : Array (Ty × String) := #[]

/-- Depth in the by-value dependency graph: a composite's fields must be declared before
it, so types are emitted shallowest first. -/
partial def Ty.depth : Ty → Nat
  | .struct fs => 1 + fs.foldl (fun n f => max n f.depth) 0
  | .option t => 1 + t.depth
  | _ => 0

partial def collectTy (acc : Names) (t : Ty) : Names :=
  match t with
  | .struct fs =>
    let acc :=
      if acc.structs.any fun (x, _) => x == t then acc
      else { acc with structs := acc.structs.push (t, s!"bpf_struct_{acc.structs.size}") }
    fs.foldl collectTy acc
  | .option inner =>
    let acc :=
      if acc.options.any fun (x, _) => x == t then acc
      else { acc with options := acc.options.push (t, s!"bpf_option_{acc.options.size}") }
    collectTy acc inner
  | _ => acc

partial def collectTm (acc : Names) (t : Tm) : Names :=
  let acc := collectTy acc t.ty
  let acc := match t.node with
    | .letE ty _ _ _ => collectTy acc ty
    | _ => acc
  t.node.children.foldl collectTm acc

def Names.ofProgram (p : Program) : Names :=
  let acc := p.maps.foldl (fun a m => collectTy (collectTy a m.key) m.value) {}
  p.decls.foldl (fun a d =>
    let a := d.params.foldl collectTy a
    collectTm (collectTy a d.ret) d.body) acc

def Names.structName (n : Names) (t : Ty) : Option String :=
  (n.structs.find? fun (x, _) => x == t).map fun (_, s) => s

def Names.optionName (n : Names) (t : Ty) : Option String :=
  (n.options.find? fun (x, _) => x == t).map fun (_, s) => s

structure Env where
  names : Names

/-- The C spelling of a type. `void` is a return type only; a `Unit` field is emitted as
one byte by the composite printers. -/
partial def cTy (env : Env) (t : Ty) : String :=
  match t with
  | .unit => "void"
  | .bool => "__u8"
  | .u8 => "__u8"
  | .u16 => "__u16"
  | .u32 => "__u32"
  | .u64 => "__u64"
  | .i8 => "__s8"
  | .i16 => "__s16"
  | .i32 => "__s32"
  | .i64 => "__s64"
  | .enum _ => "__u8"
  | .struct _ => (env.names.structName t).getD "bpf_missing_struct"
  | .option _ => (env.names.optionName t).getD "bpf_missing_option"
  | .packet => "bpf_ctx *"
  | .ctx _ => "bpf_ctx *"
  | .map _ _ _ => "void *"

def cFieldTy (env : Env) (t : Ty) : String :=
  if t == .unit then "__u8" else cTy env t

/-- A C identifier from a Wiz name (which may contain dots and Unicode). -/
def cName (s : String) : String :=
  let t := s.map fun c => if c.isAlphanum || c == '_' then c else '_'
  if t.isEmpty then "bpf_unnamed" else t

def cLit (ty : Ty) (v : Nat) : String :=
  match ty with
  | .u64 => s!"{v}ULL"
  | .i64 => s!"((__s64)(__u64){v}ULL)"
  | .u32 => s!"{v}U"
  | .i32 => s!"((__s32)(__u32){v}U)"
  | .i8 => s!"((__s8)(__u8){v})"
  | .i16 => s!"((__s16)(__u16){v})"
  | .bool | .u8 | .enum _ | .unit => s!"{v}"
  | _ => "0"

/-! ## C expressions and operations -/

def cBin (env : Env) (ty : Ty) (op : BinOp) (a b : String) (k : Option Nat) : String :=
  let cty := cTy env ty
  let uty := if (ty.width.getD 64) == 64 then "__u64" else "__u32"
  let wrap (e : String) : String := s!"(({cty})({e}))"
  match op with
  | .add => wrap s!"(({uty})({a}) + ({uty})({b}))"
  | .sub => wrap s!"(({uty})({a}) - ({uty})({b}))"
  | .mul => wrap s!"(({uty})({a}) * ({uty})({b}))"
  | .land => wrap s!"(({uty})({a}) & ({uty})({b}))"
  | .lor => wrap s!"(({uty})({a}) | ({uty})({b}))"
  | .xor => wrap s!"(({uty})({a}) ^ ({uty})({b}))"
  | .div => wrap s!"bpf_udiv(({uty})({a}), ({uty})({b}))"
  | .mod => wrap s!"bpf_umod(({uty})({a}), ({uty})({b}))"
  -- The amount is checked to be a literal below the width, so this is not a bare `<<`
  -- with the ISA's 63/31 mask.
  | .shl => wrap s!"(({uty})({a}) << {k.getD 0})"
  | .shr =>
    if ty.isSigned then wrap s!"(({cty})({a}) >> {k.getD 0})"
    else wrap s!"(({uty})({a}) >> {k.getD 0})"

def cCmp (ty : Ty) (op : CmpOp) (a b : String) : String :=
  let sym := match op with
    | .eq => "==" | .ne => "!=" | .lt => "<" | .le => "<="
  s!"(({a}) {sym} ({b}))"

def helperCall (h : Helper) (args : List String) : Except String String :=
  match h.name with
  | "Bpf.now" => pure "bpf_ktime_get_ns()"
  | "Bpf.random" => pure "bpf_get_prandom_u32()"
  | _ => .error s!"bpf: the helper `{h.name}` has no C spelling (P0's table is \
`Bpf.now` and `Bpf.random`)"

/-- Terms the C expression printer can handle. Anything with an effect or a control-flow
arm is emitted into a temporary by `operand` instead. -/
partial def simple : Tm → Bool
  | t =>
    match t.node with
    | .var _ _ | .lit _ _ | .mkNone _ => true
    | .bin _ _ a b => simple a && simple b
    | .cmp _ a b => simple a && simple b
    | .proj _ _ s => simple s
    | .mkStruct _ fs => fs.toList.all simple
    | .mkSome _ v => simple v
    | .cast _ _ v => simple v
    | .ctxPacket c | .ctxIfindex c | .ctxRxQueue c => simple c
    | .call _ _ args => args.toList.all simple
    | _ => false

partial def expr (env : Env) (t : Tm) : Except String String := do
  let pos := t.span.describe
  match t.node with
  | .var _ x => pure s!"x{x}"
  | .lit ty v => pure (cLit ty v)
  | .bin ty op a b =>
    let as ← expr env a
    let bs ← expr env b
    match op with
    | .shl | .shr =>
      match b.node with
      | .lit _ k => pure (cBin env ty op as bs (some k))
      | _ => throw s!"bpf: internal: a shift amount is not a literal (at {pos})"
    | _ => pure (cBin env ty op as bs none)
  | .cmp op a b =>
    let as ← expr env a
    let bs ← expr env b
    pure (cCmp a.ty op as bs)
  | .proj _ i s =>
    let ss ← expr env s
    pure s!"(({ss}).f{i})"
  | .mkStruct ty fs =>
    let parts ← fs.toList.mapM fun f => do
      let e ← expr env f
      pure e
    if parts.isEmpty then pure s!"(({cTy env ty})\{0})"
    else
      let fields := (List.range parts.length).map fun i =>
        s!".f{i} = {parts[i]!}"
      pure s!"(({cTy env ty})\{ {commaSep fields} })"
  | .mkSome ty v =>
    let e ← expr env v
    pure s!"(({cTy env ty})\{ .tag = 1, .value = {e} })"
  | .mkNone ty => pure s!"(({cTy env ty})\{ .tag = 0 })"
  | .cast ty _ v =>
    let e ← expr env v
    pure s!"(({cTy env ty})({e}))"
  | .helper _ h args =>
    let es ← args.toList.mapM (expr env)
    helperCall h es
  | .call _ f args =>
    let es ← args.toList.mapM (expr env)
    pure s!"{cName f}({commaSep es})"
  | .ctxPacket c => expr env c
  | .ctxIfindex c =>
    let e ← expr env c
    pure s!"ctx_ifindex({e})"
  | .ctxRxQueue c =>
    let e ← expr env c
    pure s!"ctx_rx_queue({e})"
  | _ => throw s!"bpf: internal: a control-flow or effectful term is in a value \
position (at {pos}); `Bpf.C` emits it with `operand`"

/-! ## Lines and temporaries -/

structure Est where
  next : Nat := 0
  out : Array String := #[]

abbrev EmitM := StateT Est (Except String)

def line (s : String) : EmitM Unit :=
  modify fun st => { st with out := st.out.push s }

def fresh (base : String) : EmitM String := do
  let st ← get
  set { st with next := st.next + 1 }
  pure s!"{base}{st.next}"

def runEmit (m : EmitM Unit) : Except String (Array String) := do
  let (_, st) ← m.run {}
  pure st.out

/-! ## Statements -/

mutual

/-- Emit `t` into the existing variable `dst`. A `let` opens a block; a branch assigns
`dst` in both arms. -/
partial def emitTm (env : Env) (prog : Program) (ind : String) (dst : String) (t : Tm) :
    EmitM Unit := do
  match t.node with
  | .var _ x => line s!"{ind}{dst} = x{x};"
  | .lit ty v => line s!"{ind}{dst} = {cLit ty v};"
  | .bin ty op a b =>
    let as ← operand env prog ind a
    let bs ← operand env prog ind b
    match op with
    | .shl | .shr =>
      match b.node with
      | .lit _ k => line s!"{ind}{dst} = {cBin env ty op as bs (some k)};"
      | _ => throw s!"bpf: internal: a shift amount is not a literal (at {t.span.describe})"
    | _ => line s!"{ind}{dst} = {cBin env ty op as bs none};"
  | .cmp op a b =>
    let as ← operand env prog ind a
    let bs ← operand env prog ind b
    line s!"{ind}{dst} = {cCmp a.ty op as bs};"
  | .ite _ c a b =>
    let cv ← fresh "c"
    line s!"{ind}__u8 {cv} = 0;"
    emitTm env prog ind cv c
    line s!"{ind}if ({cv}) \{"
    emitTm env prog (ind ++ "  ") dst a
    line s!"{ind}} else \{"
    emitTm env prog (ind ++ "  ") dst b
    line s!"{ind}}"
  | .letE ty x v body =>
    line s!"{ind}\{"
    line s!"{ind}  {cTy env ty} x{x} = \{0};"
    emitTm env prog (ind ++ "  ") s!"x{x}" v
    emitTm env prog (ind ++ "  ") dst body
    line s!"{ind}}"
  | .proj _ i s =>
    let ss ← operand env prog ind s
    line s!"{ind}{dst} = (({ss}).f{i});"
  | .mkStruct ty fs =>
    let es ← fs.toList.mapM (operand env prog ind)
    if es.isEmpty then line s!"{ind}{dst} = (({cTy env ty})\{0});"
    else
      let fields := (List.range es.length).map fun i => s!".f{i} = {es[i]!}"
      line s!"{ind}{dst} = (({cTy env ty})\{ {commaSep fields} });"
  | .mkSome ty v =>
    let e ← operand env prog ind v
    line s!"{ind}{dst} = (({cTy env ty})\{ .tag = 1, .value = {e} });"
  | .mkNone ty => line s!"{ind}{dst} = (({cTy env ty})\{ .tag = 0 });"
  | .switchOption ty s onNone x onSome =>
    match s.ty.optionInner with
    | none => throw s!"bpf: internal: `switchOption` on a non-Option (at {t.span.describe})"
    | some inner =>
      let sv ← fresh "s"
      line s!"{ind}{cTy env s.ty} {sv} = \{0};"
      emitTm env prog ind sv s
      line s!"{ind}if ({sv}.tag) \{"
      line s!"{ind}  {cTy env inner} x{x} = {sv}.value;"
      emitTm env prog (ind ++ "  ") dst onSome
      line s!"{ind}} else \{"
      emitTm env prog (ind ++ "  ") dst onNone
      line s!"{ind}}"
  | .switchTag ty s alts =>
    let sv ← fresh "s"
    line s!"{ind}{cTy env s.ty} {sv} = 0;"
    emitTm env prog ind sv s
    line s!"{ind}{dst} = (({cTy env ty})\{0});"
    line s!"{ind}switch ({sv}) \{"
    for i in [0:alts.size] do
      line s!"{ind}case {i}:"
      emitTm env prog (ind ++ "  ") dst alts[i]!
      line s!"{ind}  break;"
    line s!"{ind}default: break;"
    line s!"{ind}}"
  | .pktLoad ty w be p off =>
    match ty.optionInner with
    | none => throw s!"bpf: internal: a packet load is not an Option (at {t.span.describe})"
    | some word =>
      let pe ← operand env prog ind p
      let oe ← operand env prog ind off
      let scratch ← fresh "pkt"
      let load := match w with
        | 8 => "pkt_load8"
        | 16 => if be then "pkt_load16be" else "pkt_load16le"
        | 32 => if be then "pkt_load32be" else "pkt_load32le"
        | 64 => if be then "pkt_load64be" else "pkt_load64le"
        | _ => "pkt_load32be"
      line s!"{ind}{cTy env word} {scratch} = 0;"
      line s!"{ind}{dst} = (({cTy env ty})\{0});"
      line s!"{ind}if ({load}({pe}, {oe}, &{scratch})) \{"
      line s!"{ind}  {dst}.tag = 1;"
      line s!"{ind}  {dst}.value = {scratch};"
      line s!"{ind}}"
  | .ctxPacket c =>
    let ce ← operand env prog ind c
    line s!"{ind}{dst} = {ce};"
  | .ctxIfindex c =>
    let ce ← operand env prog ind c
    line s!"{ind}{dst} = ctx_ifindex({ce});"
  | .ctxRxQueue c =>
    let ce ← operand env prog ind c
    line s!"{ind}{dst} = ctx_rx_queue({ce});"
  | .mapLookup ty m k =>
    match prog.map? m with
    | none => throw s!"bpf: internal: the map `{m}` is not declared"
    | some d =>
      let ke ← operand env prog ind k
      let kt ← fresh "k"
      let vp ← fresh "v"
      line s!"{ind}{cTy env d.key} {kt} = {ke};"
      line s!"{ind}{dst} = (({cTy env ty})\{0});"
      line s!"{ind}\{ {cTy env d.value} *{vp} = ({cTy env d.value} *)bpf_map_lookup_elem(&{cName m}, &{kt});"
      line s!"{ind}  if ({vp}) \{ {dst}.tag = 1; {dst}.value = *{vp}; } }"
  | .mapUpdate ty m k v =>
    match prog.map? m with
    | none => throw s!"bpf: internal: the map `{m}` is not declared"
    | some d =>
      let ke ← operand env prog ind k
      let ve ← operand env prog ind v
      let kt ← fresh "k"
      let vt ← fresh "v"
      line s!"{ind}{cTy env d.key} {kt} = {ke};"
      line s!"{ind}{cTy env d.value} {vt} = {ve};"
      line s!"{ind}{dst} = (bpf_map_update_elem(&{cName m}, &{kt}, &{vt}, BPF_ANY) == 0);"
  | .mapDelete _ m k =>
    match prog.map? m with
    | none => throw s!"bpf: internal: the map `{m}` is not declared"
    | some d =>
      let ke ← operand env prog ind k
      let kt ← fresh "k"
      line s!"{ind}{cTy env d.key} {kt} = {ke};"
      line s!"{ind}{dst} = (bpf_map_delete_elem(&{cName m}, &{kt}) == 0);"
  | .mapAdd _ m k n =>
    match prog.map? m with
    | none => throw s!"bpf: internal: the map `{m}` is not declared"
    | some d =>
      let ke ← operand env prog ind k
      let ne ← operand env prog ind n
      let kt ← fresh "k"
      let vp ← fresh "v"
      line s!"{ind}{cTy env d.key} {kt} = {ke};"
      line s!"{ind}{cTy env d.value} *{vp} = ({cTy env d.value} *)bpf_map_lookup_elem(&{cName m}, &{kt});"
      line s!"{ind}{dst} = 0;"
      line s!"{ind}if ({vp}) {dst} = __sync_fetch_and_add({vp}, {ne});"
  | .cast ty _ v =>
    let ve ← operand env prog ind v
    line s!"{ind}{dst} = (({cTy env ty})({ve}));"
  | .call _ f args =>
    let es ← args.toList.mapM (operand env prog ind)
    line s!"{ind}{dst} = {cName f}({commaSep es});"
  | .helper _ h args =>
    let es ← args.toList.mapM (operand env prog ind)
    let e ← match helperCall h es with
      | .ok e => pure e
      | .error e => throw e
    line s!"{ind}{dst} = {e};"
  | .repeat _ _ _ _ =>
    throw s!"bpf: `Bpf.repeat` is P1: the P0 emitter has no loop (at {t.span.describe})"
  | .ret _ =>
    throw s!"bpf: internal: a `return` in a value position (at {t.span.describe})"

/-- The C expression for `t`, or a temporary holding it when it needs statements. -/
partial def operand (env : Env) (prog : Program) (ind : String) (t : Tm) :
    EmitM String := do
  if simple t then
    match expr env t with
    | .ok s => pure s
    | .error e => throw e
  else
    let tmp ← fresh "v"
    let ty := t.ty
    if ty == .unit then
      emitTm env prog ind tmp t
      pure "0"
    else
      line s!"{ind}{cTy env ty} {tmp} = \{0};"
      emitTm env prog ind tmp t
      pure tmp

end

/-- Emit a return in tail position. `ret` and the arms of a tail `if`/`match` are
continuations, so they become `return`s rather than assignments. -/
partial def emitRet (env : Env) (prog : Program) (ind : String) (ret : Ty) (t : Tm) :
    EmitM Unit := do
  match t.node with
  | .ret v =>
    if ret == .unit then
      line s!"{ind}return;"
    else
      let e ← operand env prog ind v
      line s!"{ind}return {e};"
  | .ite _ c a b =>
    let cv ← fresh "c"
    line s!"{ind}__u8 {cv} = 0;"
    emitTm env prog ind cv c
    line s!"{ind}if ({cv}) \{"
    emitRet env prog (ind ++ "  ") ret a
    line s!"{ind}} else \{"
    emitRet env prog (ind ++ "  ") ret b
    line s!"{ind}}"
  | .letE ty x v body =>
    line s!"{ind}\{"
    line s!"{ind}  {cTy env ty} x{x} = \{0};"
    emitTm env prog (ind ++ "  ") s!"x{x}" v
    emitRet env prog (ind ++ "  ") ret body
    line s!"{ind}}"
  | .switchOption _ s onNone x onSome =>
    match s.ty.optionInner with
    | none => throw s!"bpf: internal: `match` on a non-Option (at {t.span.describe})"
    | some inner =>
      let sv ← fresh "s"
      line s!"{ind}{cTy env s.ty} {sv} = \{0};"
      emitTm env prog ind sv s
      line s!"{ind}if ({sv}.tag) \{"
      line s!"{ind}  {cTy env inner} x{x} = {sv}.value;"
      emitRet env prog (ind ++ "  ") ret onSome
      line s!"{ind}} else \{"
      emitRet env prog (ind ++ "  ") ret onNone
      line s!"{ind}}"
  | .switchTag _ s alts =>
    let sv ← fresh "s"
    line s!"{ind}{cTy env s.ty} {sv} = 0;"
    emitTm env prog ind sv s
    line s!"{ind}switch ({sv}) \{"
    for i in [0:alts.size] do
      line s!"{ind}case {i}:"
      emitRet env prog (ind ++ "  ") ret alts[i]!
    if ret == .unit then
      line s!"{ind}default: return;"
    else
      line s!"{ind}default: return (({cTy env ret})\{0});"
    line s!"{ind}}"
  | _ =>
    if ret == .unit then
      throw s!"bpf: P0 requires an explicit `ret` (a unit-typed body would drop its \
effect); at {t.span.describe}"
    else
      let e ← operand env prog ind t
      line s!"{ind}return {e};"

/-! ## Declarations and the program -/

def lineDirective (span : Span) : EmitM Unit := do
  if span.line != 0 then
    line s!"#line {span.line} \"{span.file}\""

def emitDecl (env : Env) (prog : Program) (d : Decl) : EmitM Unit := do
  let params := (List.range d.params.size).map fun i => s!"{cTy env d.params[i]!} x{i}"
  let retTy := if d.ret == .unit then "void" else cTy env d.ret
  lineDirective d.body.span
  line s!"static __always_inline {retTy} {cName d.name}({commaSep params}) \{"
  emitRet env prog "  " d.ret d.body
  line "}"

def emitEntry (env : Env) (prog : Program) : EmitM Unit := do
  let some d := prog.entryDecl? | throw s!"bpf: internal: the entry `{prog.entry}` is missing"
  lineDirective d.body.span
  line s!"SEC(\"{prog.kind.elfSection}\") int {cName prog.entry}(bpf_ctx *x0) \{"
  emitRet env prog "  " prog.ret d.body
  line "}"

def emitTypes (env : Env) : EmitM Unit := do
  let decls :=
    (env.names.structs.map fun (t, n) => (t, n, true)) ++
    (env.names.options.map fun (t, n) => (t, n, false))
  let sorted := decls.qsort fun a b => a.1.depth < b.1.depth
  for item in sorted.toList do
    let (t, n, _) := item
    match t with
    | .struct fs =>
      line s!"typedef struct {n} \{"
      for i in [0:fs.size] do
        line s!"  {cFieldTy env fs[i]!} f{i};"
      line ("} " ++ n ++ ";")
    | .option inner =>
      line s!"typedef struct {n} \{"
      line "  __u8 tag;"
      line s!"  {cFieldTy env inner} value;"
      line ("} " ++ n ++ ";")
    | _ => pure ()

def emitMaps (env : Env) (prog : Program) : EmitM Unit := do
  for m in prog.maps.toList do
    line "struct {"
    line s!"  __uint(type, {m.kind.cName});"
    line s!"  __uint(max_entries, {m.maxEntries});"
    line s!"  __type(key, {cTy env m.key});"
    line s!"  __type(value, {cTy env m.value});"
    line ("} " ++ cName m.name ++ " SEC(\".maps\");")

/-- Print the whole program. The checker runs first; the emitter is not a second gate. -/
def emitProgram (prog : Program) : Except String String := do
  checkProgram prog
  let env : Env := { names := Names.ofProgram prog }
  let lines ← runEmit do
    line "/* generated by wiz --target bpf (bpf-core/1); do not edit */"
    if prog.kind == .tc then line "#define BPF_TC 1"
    line "#include \"bpf_rt.h\""
    line ""
    line "/* map key/value and value types: flat structs, natural alignment */"
    emitTypes env
    line ""
    line "/* maps: declared statically, created by libbpf from BTF */"
    emitMaps env prog
    line ""
    for d in prog.decls.toList do
      if d.name != prog.entry then
        emitDecl env prog d
        line ""
    emitEntry env prog
  pure (String.intercalate "\n" lines.toList ++ "\n")

end Wiz.Compiler.Bpf
