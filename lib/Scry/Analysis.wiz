import Scry.Wil
import Text
import Word
import WordMap
/-!
# Scry.Analysis

The **intraprocedural graph layer** over `Scry.Wil` (`import Scry.Analysis`): the CFG,
dominators, reaching definitions, and the PDG's data-dependence (def-use) edges. There
is no parser and no C lowering here; the input is a hand-built or lowered `Wil.Func`.

## Program points

A Wil function is a list of basic blocks. Analysis needs a *program point* for every
statement **and** every terminator, so an empty block still has a place in the CFG:

* block `b` with `n` statements owns points `base(b) … base(b)+n`; points `0 … n-1`
  are its statements and point `n` (the terminator point) executes `blk.term`;
* `base(b+1) = base(b) + n + 1`, so the points of a function are a contiguous range
  `0 … count-1`;
* a statement point steps to the next point; a terminator point steps to the first
  point of each target block (`goto` one, `br` two, `ret`/`unreachable` none).

This is the smallest encoding that keeps `br`/`goto` edges honest without inventing
extra nodes per block.

## What is computed

* `Scry.cfgEdges` — the CFG as `(from, to)` pairs over program points.
* `Scry.dominators` — the classic iterative dominator sets over the CFG. Unreachable
  points get `{self}` by convention.
* `Scry.rdIn` — **reaching definitions**: for each point, the set of definition points
  that may reach it. A definition is a statement point that writes a register
  (`assign` or a call's result variable). The transfer is `gen ∪ (in − kill)`, where
  `kill` removes the other definitions of the variables this point writes.
* `Scry.dataDeps` — flow-dependence edges `(defPoint, usePoint, var)`: a definition
  point `d` reaches a use of `var` at `u`. These are the PDG data edges taint consumes.
* `Scry.fnInfoWith` — the same analysis with caller-supplied extra definitions
  (`(point, var)` pairs): a tainted parameter at a function's entry, or an argument a
  call writes in place. `Scry.fnInfo` is the no-extra case. A parameter used by the
  entry statement needs a self edge, which `Scry.RuleTaint.prepareFunc` adds.
* Terminators are CFG points and their uses (`ret x`, `br` conditions) are data-edge
  uses too, so a return value is connected to the definitions that reach it.

The fixpoints are ordinary `partial def` loops (the design's engine is deliberately
executable, not proved here); the inputs are tiny per-function graphs. Anti-dependence,
output-dependence and control-dependence edges are not computed: taint needs flow
dependence only, and the rest belongs to the S4 remainder (`wiz-notes/scry-taint.md`).

Every set is a `List Nat` with membership-based dedup, and every map is an association
list, so the representation is the same as the rest of scry's pure list model.
-/

-- ## Set and map helpers

/-- `n, n+1, …, n+k-1`. -/
def Scry.rangeFrom : Nat → Nat → List Nat
  | .zero, _ => .nil
  | .succ k, n => .cons n (Scry.rangeFrom k (Nat.succ n))

/-- `0, 1, …, n-1`. -/
def Scry.range (n : Nat) : List Nat := Scry.rangeFrom n 0

def Scry.memNat (x : Nat) (xs : List Nat) : Bool := List.any (Nat.beq x) xs

def Scry.insertNat (x : Nat) (xs : List Nat) : List Nat :=
  match Scry.memNat x xs with
  | .true => xs
  | .false => .cons x xs

def Scry.unionNat (xs ys : List Nat) : List Nat :=
  List.foldr (fun x acc => Scry.insertNat x acc) .nil (List.append xs ys)

def Scry.interNat : List Nat → List Nat → List Nat
  | .nil, _ => .nil
  | .cons x xs, ys => match Scry.memNat x ys with
    | .true => .cons x (Scry.interNat xs ys)
    | .false => Scry.interNat xs ys

def Scry.diffNat (xs ys : List Nat) : List Nat :=
  List.filter (fun x => Bool.not (Scry.memNat x ys)) xs

/-- Set equality: same members, ignoring order and multiplicity. -/
def Scry.setEq (xs ys : List Nat) : Bool :=
  Bool.and (List.all (fun x => Scry.memNat x ys) xs)
           (List.all (fun y => Scry.memNat y xs) ys)

def Scry.concatLists {A B : Type} (f : A → List B) : List A → List B
  | .nil => .nil
  | .cons x xs => List.append (f x) (Scry.concatLists f xs)

def Scry.nthD {A : Type} (d : A) : List A → Nat → A
  | .nil, _ => d
  | .cons x _, .zero => x
  | .cons _ xs, .succ n => Scry.nthD d xs n

def Scry.lookupSet (m : List (Nat × List Nat)) (n : Nat) : List Nat :=
  match List.find (fun p => Nat.beq p.1 n) m with
  | .none => .nil
  | .some p => p.2

def Scry.lookupNatD (d : Nat) (m : List (Nat × Nat)) (n : Nat) : Nat :=
  match List.find (fun p => Nat.beq p.1 n) m with
  | .none => d
  | .some p => p.2

-- ## Flattening a function into program points

/-- A function flattened to program points. The point → statement/terminator and
point → successor/predecessor tables are built **once** by `Scry.flatten`; before this
they were derived by walking the block list for every query (`locate` was O(blocks) and
`stmtAt` was `List.nth` into a block's statement list), which made every analysis pass
quadratic in a large function. The tables use `U64Map`, whose model is a sorted list
(the interpreter and the kernel) and whose compiled representation is a hash table.

The block-level `blockSuccs`/`blockPreds` tables are what the reaching-definitions
worklist uses: it is a block-level dataflow, so a straight-line function is one block
and one pass, not one point per round. -/
structure Scry.Fn where
  fn : Wil.Func
  /-- `(block index, base point)` for every block. -/
  bases : List (Nat × Nat)
  /-- Number of program points (statements plus one terminator point per block). -/
  count : Nat
  /-- Block index → its base point. -/
  baseMap : U64Map Nat
  /-- Block index → the block itself. -/
  blockMap : U64Map Wil.Block
  /-- Block index → successor block indexes (CFG edges between terminators). -/
  blockSuccs : U64Map (List Nat)
  /-- Block index → predecessor block indexes. -/
  blockPreds : U64Map (List Nat)
  /-- Point → the statement at that point (absent at a terminator point). -/
  stmtMap : U64Map Wil.Stmt
  /-- Point → the terminator at that point (absent at a statement point). -/
  termMap : U64Map Wil.Term
  /-- Point → successor points. -/
  pointSuccs : U64Map (List Nat)
  /-- Point → predecessor points. -/
  pointPreds : U64Map (List Nat)

def Scry.u64 (n : Nat) : U64 := U64.ofNat n

/-- The list stored at `k`, or `[]`. -/
def Scry.mapListGet (m : U64Map (List Nat)) (k : Nat) : List Nat :=
  U64Map.findD m (Scry.u64 k) List.nil

/-- `m` with `v` added at `k` (a set-like list; the caller adds each value once). -/
def Scry.mapListPush (m : U64Map (List Nat)) (k v : Nat) : U64Map (List Nat) :=
  U64Map.insert m (Scry.u64 k) (List.cons v (Scry.mapListGet m k))

/-- The base of every block, and the total point count, in one pass. -/
def Scry.blockBases : Nat → Nat → List Wil.Block → List (Nat × Nat) × Nat
  | _, base, .nil => (.nil, base)
  | i, base, .cons b bs =>
    match Scry.blockBases (Nat.succ i) (Nat.add base (Nat.succ (List.length b.stmts))) bs with
    | (rest, total) => (.cons (i, base) rest, total)

/-- First block pass: the block, its base, and its block-level CFG neighbours. -/
def Scry.blockMapsGo : Nat → List Wil.Block → List (Nat × Nat) →
    U64Map Nat → U64Map Wil.Block → U64Map (List Nat) → U64Map (List Nat) →
    U64Map Nat × U64Map Wil.Block × U64Map (List Nat) × U64Map (List Nat)
  | _, .nil, _, baseMap, blockMap, succs, preds => (baseMap, blockMap, succs, preds)
  | i, .cons b bs, .cons (_, base) rest, baseMap, blockMap, succs, preds =>
    let baseMap' := U64Map.insert baseMap (Scry.u64 i) base;
    let blockMap' := U64Map.insert blockMap (Scry.u64 i) b;
    let targets := match b.term with
      | .goto t _ => List.cons t.index List.nil
      | .br _ t f _ => List.cons t.index (List.cons f.index List.nil)
      | .ret _ _ => List.nil
      | .unreachable _ => List.nil;
    let succs' := U64Map.insert succs (Scry.u64 i) targets;
    let preds' := List.foldl (fun m t => Scry.mapListPush m t i) preds targets;
    Scry.blockMapsGo (Nat.succ i) bs rest baseMap' blockMap' succs' preds'
  | _, _, _, baseMap, blockMap, succs, preds => (baseMap, blockMap, succs, preds)

/-- The block's target base points. -/
def Scry.termTargetBases (baseMap : U64Map Nat) (t : Wil.Term) : List Nat :=
  match t with
  | .goto b _ => List.cons (U64Map.findD baseMap (Scry.u64 b.index) 0) List.nil
  | .br _ b c _ =>
    List.cons (U64Map.findD baseMap (Scry.u64 b.index) 0)
      (List.cons (U64Map.findD baseMap (Scry.u64 c.index) 0) List.nil)
  | .ret _ _ => List.nil
  | .unreachable _ => List.nil

/-- Fill the point tables for one block's statements: each point steps to the next. -/
def Scry.pointStmtsGo : List Wil.Stmt → Nat → U64Map Wil.Stmt →
    U64Map (List Nat) → U64Map (List Nat) →
    U64Map Wil.Stmt × U64Map (List Nat) × U64Map (List Nat)
  | .nil, _, sm, sc, pr => (sm, sc, pr)
  | .cons s rest, p, sm, sc, pr =>
    let sm' := U64Map.insert sm (Scry.u64 p) s;
    let sc' := U64Map.insert sc (Scry.u64 p) (List.cons (Nat.succ p) List.nil);
    let pr' := Scry.mapListPush pr (Nat.succ p) p;
    Scry.pointStmtsGo rest (Nat.succ p) sm' sc' pr'

/-- Second block pass: fill the point tables, now that every block's base is known. -/
def Scry.pointMapsGo : List Wil.Block → List (Nat × Nat) → U64Map Nat →
    U64Map Wil.Stmt → U64Map Wil.Term → U64Map (List Nat) → U64Map (List Nat) →
    U64Map Wil.Stmt × U64Map Wil.Term × U64Map (List Nat) × U64Map (List Nat)
  | .nil, _, _, sm, tm, sc, pr => (sm, tm, sc, pr)
  | .cons b bs, .cons (_, base) rest, baseMap, sm, tm, sc, pr =>
    let (sm1, sc1, pr1) := Scry.pointStmtsGo b.stmts base sm sc pr;
    let tpoint := Nat.add base (List.length b.stmts);
    let tm' := U64Map.insert tm (Scry.u64 tpoint) b.term;
    let targets := Scry.termTargetBases baseMap b.term;
    let sc' := U64Map.insert sc1 (Scry.u64 tpoint) targets;
    let pr' := List.foldl (fun m t => Scry.mapListPush m t tpoint) pr1 targets;
    Scry.pointMapsGo bs rest baseMap sm1 tm' sc' pr'
  | _, _, _, sm, tm, sc, pr => (sm, tm, sc, pr)

def Scry.flatten (fn : Wil.Func) : Scry.Fn :=
  match Scry.blockBases 0 0 fn.blocks with
  | (bases, total) =>
    let (baseMap, blockMap, blockSuccs, blockPreds) :=
      Scry.blockMapsGo 0 fn.blocks bases U64Map.empty U64Map.empty U64Map.empty U64Map.empty;
    let (stmtMap, termMap, pointSuccs, pointPreds) :=
      Scry.pointMapsGo fn.blocks bases baseMap U64Map.empty U64Map.empty U64Map.empty U64Map.empty;
    Scry.Fn.mk fn bases total baseMap blockMap blockSuccs blockPreds
      stmtMap termMap pointSuccs pointPreds

def Scry.baseOf (g : Scry.Fn) (b : Wil.BlockId) : Nat :=
  U64Map.findD g.baseMap (Scry.u64 b.index) 0

def Scry.nodeOf (g : Scry.Fn) (b : Wil.BlockId) (pc : Nat) : Nat :=
  Nat.add (Scry.baseOf g b) pc

def Scry.entryNode (g : Scry.Fn) : Nat := Scry.nodeOf g g.fn.entry 0

def Scry.blockAt (g : Scry.Fn) (b : Wil.BlockId) : Option Wil.Block :=
  U64Map.find g.blockMap (Scry.u64 b.index)

def Scry.blockLen (g : Scry.Fn) (b : Wil.BlockId) : Nat :=
  match Scry.blockAt g b with
  | .none => 0
  | .some blk => List.length blk.stmts

def Scry.stmtAt (g : Scry.Fn) (b : Wil.BlockId) (pc : Nat) : Option Wil.Stmt :=
  match Scry.blockAt g b with
  | .none => .none
  | .some blk => Wil.listNth blk.stmts pc

/-- The block and offset of a point (`none` outside the function). -/
def Scry.locateBases : List Wil.Block → List (Nat × Nat) → Nat → Option (Wil.BlockId × Nat)
  | .nil, _, _ => .none
  | .cons blk bs, .cons (i, base) rest, n =>
    let size := Nat.succ (List.length blk.stmts);
    match Nat.le base n with
    | .true => match Nat.lt n (Nat.add base size) with
      | .true => .some (Wil.mkBlockId i, Nat.sub n base)
      | .false => Scry.locateBases bs rest n
    | .false => Scry.locateBases bs rest n
  | .cons _ _, .nil, _ => .none

/-- The block and offset of a point (`none` outside the function). Kept for callers that
want the block, not just the statement; the analysis itself goes through the tables. -/
def Scry.locate (g : Scry.Fn) (n : Nat) : Option (Wil.BlockId × Nat) :=
  Scry.locateBases g.fn.blocks g.bases n

/-- The statement at a point, or `none` at a terminator point. -/
def Scry.nodeStmt (g : Scry.Fn) (n : Nat) : Option Wil.Stmt :=
  U64Map.find g.stmtMap (Scry.u64 n)

/-- The terminator at a point, or `none` at a statement point. -/
def Scry.nodeTerm (g : Scry.Fn) (n : Nat) : Option Wil.Term :=
  U64Map.find g.termMap (Scry.u64 n)

-- ## The CFG

def Scry.succs (g : Scry.Fn) (n : Nat) : List Nat :=
  Scry.mapListGet g.pointSuccs n

def Scry.predsOf (g : Scry.Fn) (n : Nat) : List Nat :=
  Scry.mapListGet g.pointPreds n

def Scry.cfgEdges (g : Scry.Fn) : List (Nat × Nat) :=
  Scry.concatLists (fun n => List.map (fun m => (n, m)) (Scry.succs g n)) (Scry.range g.count)

-- ## Definitions and uses

def Scry.rhsUses : Wil.Rhs → List Nat
  | .use v => .cons v.index .nil
  | .cst _ => .nil
  | .bin _ a b => .cons a.index (.cons b.index .nil)
  | .un _ a => .cons a.index .nil
  | .load p => .cons p.index .nil
  | .gep p _ => .cons p.index .nil
  | .gepVar p i _ => .cons p.index (.cons i.index .nil)
  | .alloc _ => .nil
  | .slot _ => .nil
  | .globalRef _ => .nil
  | .fnptr _ => .nil
  | .havoc _ => .nil

def Scry.condUses : Wil.Cond → List Nat
  | .const _ => .nil
  | .cmp _ a b => .cons a.index (.cons b.index .nil)
  | .not c => Scry.condUses c
  | .and a b => List.append (Scry.condUses a) (Scry.condUses b)
  | .or a b => List.append (Scry.condUses a) (Scry.condUses b)

/-- The registers a terminator reads: a branch condition, or a returned value. -/
def Scry.termUses : Wil.Term → List Nat
  | .br c _ _ _ => Scry.condUses c
  | .ret (.some v) _ => .cons v.index .nil
  | .ret .none _ => .nil
  | .goto _ _ => .nil
  | .unreachable _ => .nil

/-- The registers a statement writes. -/
def Scry.stmtDefs : Wil.Stmt → List Nat
  | .assign x _ _ => .cons x.index .nil
  | .call (.some r) _ _ _ => .cons r.index .nil
  | _ => .nil

/-- The registers a statement reads. -/
def Scry.stmtUses : Wil.Stmt → List Nat
  | .assign _ e _ => Scry.rhsUses e
  | .assume c _ => Scry.condUses c
  | .store p v _ => .cons p.index (.cons v.index .nil)
  | .free p _ => .cons p.index .nil
  | .call _ callee args _ =>
    let argUses := List.map (fun v => v.index) args;
    match callee with
    | .direct _ => argUses
    | .indirect f => .cons f.index argUses
  | .nop _ => .nil

/-- Every register a point reads, statement or terminator. Terminator uses matter for
return-value summaries (`ret x`) and are part of the data-dependence layer. -/
def Scry.usesAt (g : Scry.Fn) (n : Nat) : List Nat :=
  match Scry.nodeStmt g n with
  | .some s => Scry.stmtUses s
  | .none => match Scry.nodeTerm g n with
    | .some t => Scry.termUses t
    | .none => .nil

/-- Every `(definition point, register)` in the function. -/
def Scry.defsOf (g : Scry.Fn) : List (Nat × Nat) :=
  Scry.concatLists (fun n =>
    match Scry.nodeStmt g n with
    | .none => .nil
    | .some s => List.map (fun v => (n, v)) (Scry.stmtDefs s))
    (Scry.range g.count)

def Scry.memDef (d : Nat × Nat) (ds : List (Nat × Nat)) : Bool :=
  List.any (fun p => Bool.and (Nat.beq d.1 p.1) (Nat.beq d.2 p.2)) ds

def Scry.insertDef (d : Nat × Nat) (ds : List (Nat × Nat)) : List (Nat × Nat) :=
  match Scry.memDef d ds with
  | .true => ds
  | .false => List.cons d ds

/-- The function's definitions together with caller-supplied ones (a tainted parameter
at entry, or an argument a call writes in place). The extra definitions are what makes
interprocedural flow and per-argument sources/sanitisers fit the same def-use layer. -/
def Scry.defsOfWith (g : Scry.Fn) (extra : List (Nat × Nat)) : List (Nat × Nat) :=
  List.foldr (fun d acc => Scry.insertDef d acc) (Scry.defsOf g) extra

/-- Whether `(point, var)` is a definition. -/
def Scry.defHas (defs : List (Nat × Nat)) (n v : Nat) : Bool :=
  Scry.memDef (n, v) defs

def Scry.defVarOf (defs : List (Nat × Nat)) (n : Nat) : Option Nat :=
  match List.find (fun p => Nat.beq p.1 n) defs with
  | .none => .none
  | .some p => .some p.2

/-- The registers a point writes. -/
def Scry.defsAt (g : Scry.Fn) (n : Nat) : List Nat :=
  match Scry.nodeStmt g n with
  | .none => .nil
  | .some s => Scry.stmtDefs s

/-- The registers a point defines in the *given* definition list (statement definitions
plus the extra ones). -/
def Scry.defsAtD (defs : List (Nat × Nat)) (n : Nat) : List Nat :=
  List.map (fun p => p.2) (List.filter (fun p => Nat.beq p.1 n) defs)

/-- The definitions a point kills: definitions of the registers it writes (including
extra definitions at the point). -/
def Scry.killOf (defs : List (Nat × Nat)) (g : Scry.Fn) (n : Nat) : List Nat :=
  let vs := Scry.defsAtD defs n;
  List.map (fun p => p.1) (List.filter (fun p => Scry.memNat p.2 vs) defs)

/-- The definition a point generates, if it defines any register. -/
def Scry.genOfD (defs : List (Nat × Nat)) (n : Nat) : List Nat :=
  match Scry.defsAtD defs n with
  | .nil => .nil
  | _ => .cons n .nil

def Scry.mapSets (g : Scry.Fn) (f : Nat → List Nat) : List (Nat × List Nat) :=
  List.map (fun n => (n, f n)) (Scry.range g.count)

def Scry.mapsSetEq (g : Scry.Fn) (a b : List (Nat × List Nat)) : Bool :=
  List.all (fun n => Scry.setEq (Scry.lookupSet a n) (Scry.lookupSet b n)) (Scry.range g.count)

-- ## Reaching definitions

def Scry.rdStep (defs : List (Nat × Nat)) (g : Scry.Fn) (n : Nat) (inp : List Nat) : List Nat :=
  Scry.unionNat (Scry.genOfD defs n) (Scry.diffNat inp (Scry.killOf defs g n))

def Scry.rdLoop (defs : List (Nat × Nat)) (g : Scry.Fn) (fuel : Nat)
    (ins : List (Nat × List Nat)) : List (Nat × List Nat) :=
  match fuel with
  | .zero => ins
  | .succ k =>
    let outs := Scry.mapSets g (fun n => Scry.rdStep defs g n (Scry.lookupSet ins n));
    let ins' := Scry.mapSets g (fun n =>
      match Nat.beq n (Scry.entryNode g) with
      | .true => .nil
      | .false =>
        List.foldr (fun p acc => Scry.unionNat (Scry.lookupSet outs p) acc) .nil
          (Scry.predsOf g n));
    match Scry.mapsSetEq g ins ins' with
    | .true => ins'
    | .false => Scry.rdLoop defs g k ins'

/-- The reaching definitions at every point. -/
def Scry.rdIn (g : Scry.Fn) (defs : List (Nat × Nat)) : List (Nat × List Nat) :=
  Scry.rdLoop defs g (Nat.add (Nat.mul g.count g.count) 4)
    (Scry.mapSets g (fun _ => .nil))

-- ## Dominators

def Scry.interAll : List (List Nat) → List Nat
  | .nil => .nil
  | .cons s rest => List.foldr (fun x acc => Scry.interNat x acc) s rest

def Scry.domLoop (g : Scry.Fn) (fuel : Nat) (dom : List (Nat × List Nat)) :
    List (Nat × List Nat) :=
  match fuel with
  | .zero => dom
  | .succ k =>
    let dom' := Scry.mapSets g (fun n =>
      match Nat.beq n (Scry.entryNode g) with
      | .true => .cons n .nil
      | .false =>
        let ps := Scry.predsOf g n;
        match ps with
        | .nil => .cons n .nil
        | _ => Scry.insertNat n
            (Scry.interAll (List.map (fun p => Scry.lookupSet dom p) ps)));
    match Scry.mapsSetEq g dom dom' with
    | .true => dom'
    | .false => Scry.domLoop g k dom'

/-- Dominator sets, `{n}` for unreachable points. -/
def Scry.dominators (g : Scry.Fn) : List (Nat × List Nat) :=
  let all := Scry.range g.count;
  let init := Scry.mapSets g (fun n =>
    match Nat.beq n (Scry.entryNode g) with
    | .true => .cons n .nil
    | .false => all);
  Scry.domLoop g (Nat.add (Nat.mul g.count g.count) 4) init

def Scry.dominates (g : Scry.Fn) (dom : List (Nat × List Nat)) (a b : Nat) : Bool :=
  Scry.memNat a (Scry.lookupSet dom b)

-- ## PDG data edges

structure Scry.DataDep where
  from : Nat
  to : Nat
  var : Nat

def Scry.memDep (d : Scry.DataDep) (ds : List Scry.DataDep) : Bool :=
  List.any (fun e => Bool.and (Nat.beq d.from e.from) (Nat.beq d.to e.to)) ds

def Scry.insertDep (d : Scry.DataDep) (ds : List Scry.DataDep) : List Scry.DataDep :=
  match Scry.memDep d ds with
  | .true => ds
  | .false => .cons d ds

def Scry.depsAt (defs : List (Nat × Nat)) (g : Scry.Fn) (ins : List (Nat × List Nat))
    (u : Nat) : List Scry.DataDep :=
  Scry.concatLists (fun v =>
    List.map (fun d => Scry.DataDep.mk d u v)
      (List.filter (fun d => Scry.defHas defs d v) (Scry.lookupSet ins u)))
    (Scry.usesAt g u)

/-- Flow-dependence (def-use) edges, deduplicated. -/
def Scry.dataDeps (g : Scry.Fn) (defs : List (Nat × Nat))
    (ins : List (Nat × List Nat)) : List Scry.DataDep :=
  List.foldr (fun d acc => Scry.insertDep d acc) .nil
    (Scry.concatLists (fun u => Scry.depsAt defs g ins u) (Scry.range g.count))

-- ## A block-level reaching-definitions pass (the production path)

/-- `m[v]` is the set of definition points of register `v` that reach the current point.
This is a `U64Map` (not a list of point sets): a straight-line function then carries one
entry per live register, not one set of every definition seen so far. -/
def Scry.flowEmpty : U64Map (List Nat) := U64Map.empty

/-- `dst` with every `(v, def)` of `src` unioned in. -/
def Scry.flowUnionInto (dst src : U64Map (List Nat)) : U64Map (List Nat) :=
  U64Map.foldl (fun acc k vs =>
    let old := U64Map.findD acc k List.nil;
    let merged := List.foldl (fun s v => Scry.insertNat v s) old vs;
    U64Map.insert acc k merged) dst src

/-- Set equality of two flow maps (one entry per register, sets of def points). -/
def Scry.flowMapEq (a b : U64Map (List Nat)) : Bool :=
  match Nat.beq (U64Map.size a) (U64Map.size b) with
  | .false => .false
  | .true => U64Map.foldl (fun acc k vs =>
      Bool.and acc (Scry.setEq vs (U64Map.findD b k List.nil))) .true a

/-- Add one data edge to a deduplicating map `from → [(to, var)]`. Exact: no hash is
involved, so a collision cannot drop a real def-use edge. -/
def Scry.depAdd (m : U64Map (List (Nat × Nat))) (d : Scry.DataDep) :
    U64Map (List (Nat × Nat)) :=
  let old := U64Map.findD m (Scry.u64 d.from) List.nil;
  match List.any (fun p => Bool.and (Nat.beq p.1 d.to) (Nat.beq p.2 d.var)) old with
  | .true => m
  | .false => U64Map.insert m (Scry.u64 d.from) (List.cons (d.to, d.var) old)

/-- Every edge of the deduplicating map, as `Scry.DataDep`s. -/
def Scry.depFlatten (m : U64Map (List (Nat × Nat))) : List Scry.DataDep :=
  U64Map.foldl (fun acc from edges =>
    List.foldl (fun acc2 e => List.cons (Scry.DataDep.mk (UIntN.toNat from) e.1 e.2) acc2)
      acc edges) List.nil m

/-- `(point, var)` extra definitions grouped by point (a tainted parameter at the
entry, or an argument a source/sanitiser writes at a call). -/
def Scry.extraByPoint (defs : List (Nat × Nat)) : U64Map (List Nat) :=
  List.foldl (fun m d => Scry.mapListPush m d.1 d.2) U64Map.empty defs

/-- Insert the definitions at `p` for the registers in `vs`. -/
def Scry.flowDefine (m : U64Map (List Nat)) (vs : List Nat) (p : Nat) : U64Map (List Nat) :=
  List.foldl (fun a v => U64Map.insert a (Scry.u64 v) (List.cons p List.nil)) m vs

/-- One block's transfer: starting from the reaching-definition map at the block entry,
walk its statements (uses first, then the definition kills and adds `p`), then its
terminator's uses. Returns the map at the block exit and the use edges this pass saw. -/
def Scry.blockTransferGo : List Wil.Stmt → Nat → U64Map (List Nat) →
    U64Map (List Nat) → List Scry.DataDep → U64Map (List Nat) × List Scry.DataDep
  | .nil, _, mm, _, es => (mm, es)
  | .cons s rest, p, mm, ex, es =>
    let useEdges := Scry.concatLists (fun v =>
      List.map (fun d => Scry.DataDep.mk d p v)
        (U64Map.findD mm (Scry.u64 v) List.nil)) (Scry.stmtUses s);
    let m1 := Scry.flowDefine mm (Scry.stmtDefs s) p;
    let m2 := Scry.flowDefine m1 (Scry.mapListGet ex p) p;
    Scry.blockTransferGo rest (Nat.succ p) m2 ex (List.append useEdges es)

def Scry.blockTransfer (block : Wil.Block) (base : Nat) (m : U64Map (List Nat))
    (extra : U64Map (List Nat)) : U64Map (List Nat) × List Scry.DataDep :=
  let (m1, es) := Scry.blockTransferGo block.stmts base m extra List.nil;
  let tp := Nat.add base (List.length block.stmts);
  let termEdges := Scry.concatLists (fun v =>
    List.map (fun d => Scry.DataDep.mk d tp v)
      (U64Map.findD m1 (Scry.u64 v) List.nil)) (Scry.termUses block.term);
  let m2 := Scry.flowDefine m1 (Scry.mapListGet extra tp) tp;
  (m2, List.append termEdges es)

/-- The block-level reaching-definitions worklist. `work` is the queued block set,
`queued` the same as a map (so a block is never queued twice), `outs` the exit map of
each block, and `deps` the def-use edges collected so far. A straight-line function is
one block: it is processed once, not once per point. -/
partial def Scry.flowBlocksGo (g : Scry.Fn) (extra : U64Map (List Nat)) (work : List Nat)
    (queued : U64Map Unit) (outs : U64Map (U64Map (List Nat)))
    (deps : U64Map (List (Nat × Nat))) :
    U64Map (U64Map (List Nat)) × U64Map (List (Nat × Nat)) :=
  match work with
  | .nil => (outs, deps)
  | .cons b rest =>
    let queued1 := U64Map.erase queued (Scry.u64 b);
    let inMap : U64Map (List Nat) :=
      if Nat.beq b (g.fn.entry.index) then Scry.flowEmpty
      else List.foldl (fun acc p =>
          Scry.flowUnionInto acc (U64Map.findD outs (Scry.u64 p) Scry.flowEmpty))
        Scry.flowEmpty (Scry.mapListGet g.blockPreds b);
    let block := U64Map.findD g.blockMap (Scry.u64 b)
      (Wil.Block.mk List.nil (Wil.Term.unreachable Wil.noSpan));
    let base := U64Map.findD g.baseMap (Scry.u64 b) 0;
    let (out, newDeps) := Scry.blockTransfer block base inMap extra;
    let deps1 := List.foldl Scry.depAdd deps newDeps;
    let old := U64Map.findD outs (Scry.u64 b) Scry.flowEmpty;
    match Scry.flowMapEq out old with
    | .true => Scry.flowBlocksGo g extra rest queued1 outs deps1
    | .false =>
      let outs1 := U64Map.insert outs (Scry.u64 b) out;
      let succs := Scry.mapListGet g.blockSuccs b;
      let (work2, queued2) := List.foldl (fun (acc : List Nat × U64Map Unit) s =>
          match U64Map.contains acc.2 (Scry.u64 s) with
          | .true => acc
          | .false => (List.cons s acc.1, U64Map.insert acc.2 (Scry.u64 s) ())) (rest, queued1) succs;
      Scry.flowBlocksGo g extra work2 queued2 outs1 deps1

/-- Flow-dependence edges computed by the block-level worklist (no point-level
reaching-definition table is materialised). `extra` are the same caller-supplied
definitions `Scry.defsOfWith` takes. -/
def Scry.dataDepsFlow (g : Scry.Fn) (extra : List (Nat × Nat)) : List Scry.DataDep :=
  let blocks := Scry.range (List.length g.fn.blocks);
  let queued := List.foldl (fun m b => U64Map.insert m (Scry.u64 b) ()) U64Map.empty blocks;
  let (ignored, deps) := Scry.flowBlocksGo g (Scry.extraByPoint extra) blocks queued
    U64Map.empty U64Map.empty;
  Scry.depFlatten deps

-- ## A function's analysis

structure Scry.FnInfo where
  g : Scry.Fn
  defs : List (Nat × Nat)
  rd : List (Nat × List Nat)
  deps : List Scry.DataDep
  dom : List (Nat × List Nat)
  /-- `(use point, var)` → the definition points with an edge to that use. This is the
  index `flowHasVar`/`taintAtUse` query; without it every query scanned all edges. The
  key is exact `to * 2^32 + var` (program points and registers are far below 2^32). -/
  depIdx : U64Map (List Nat)

def Scry.depKey (to var : Nat) : U64 := U64.ofNat (Nat.add (Nat.mul to 4294967296) var)

def Scry.depIdxOf (deps : List Scry.DataDep) : U64Map (List Nat) :=
  List.foldl (fun m d => Scry.mapListPush m (UIntN.toNat (Scry.depKey d.to d.var)) d.from)
    U64Map.empty deps

def Scry.fnInfoWith (fn : Wil.Func) (extraDefs : List (Nat × Nat)) : Scry.FnInfo :=
  let g := Scry.flatten fn;
  let defs := Scry.defsOfWith g extraDefs;
  let rd := Scry.rdIn g defs;
  let deps := Scry.dataDeps g defs rd;
  let dom := Scry.dominators g;
  Scry.FnInfo.mk g defs rd deps dom (Scry.depIdxOf deps)

def Scry.fnInfo (fn : Wil.Func) : Scry.FnInfo :=
  Scry.fnInfoWith fn .nil

/-- The **flow-only** form of `Scry.fnInfoWith`: the definitions and def-use edges, with
`rd`/`dom` empty. The production taint engine needs only `g` and `deps`; the point-level
reaching-definition table and the dominator sets are for the analysis tests and the
old `Scry.Taint` prototype, and computing them on a huge function is quadratic. The
edge set is the same `def-use` relation (`Scry.dataDepsFlow` is a block-level fixpoint
of the same transfer function). -/
def Scry.fnInfoFlowWithG (g : Scry.Fn) (extraDefs : List (Nat × Nat)) : Scry.FnInfo :=
  let defs := Scry.defsOfWith g extraDefs;
  let deps := Scry.dataDepsFlow g extraDefs;
  Scry.FnInfo.mk g defs List.nil deps List.nil (Scry.depIdxOf deps)

def Scry.fnInfoFlowWith (fn : Wil.Func) (extraDefs : List (Nat × Nat)) : Scry.FnInfo :=
  Scry.fnInfoFlowWithG (Scry.flatten fn) extraDefs

def Scry.flowPairs (info : Scry.FnInfo) : List (Nat × Nat) :=
  List.map (fun d => (d.from, d.to)) info.deps

/-- The reaching definitions of register `v` at point `n`. -/
def Scry.rdForVar (defs : List (Nat × Nat)) (rd : List (Nat × List Nat))
    (n v : Nat) : List Nat :=
  List.filter (fun d => Scry.defHas defs d v) (Scry.lookupSet rd n)

/-- Whether the PDG has a data edge from point `a` to point `b`. -/
def Scry.flowHas (info : Scry.FnInfo) (a b : Nat) : Bool :=
  List.any (fun d => Bool.and (Nat.beq d.from a) (Nat.beq d.to b)) info.deps
