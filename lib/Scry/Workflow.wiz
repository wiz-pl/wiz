import Json
import Text
import Scry.Rules
import Scry.Sarif
/-!
# Scry.Workflow: finding identity, triage and the local evidence store

This module is the **workflow/evidence layer** around the existing analyses. It does not
run anything: `scry taint` (or any other producer) supplies a `Scry.RuleFinding` and an
origin map, and this module gives it

* a deterministic **semantic id** (`f_<16 hex>`) built from the rule, the normalized
  path, the sink callee and argument, and the path's coarse shape. Line and column are
  deliberately excluded, so moving a sink within a function keeps the finding;
* a separate **primary-line hash** for the GitHub-compatible alert identity;
* the **triage state machine** (`new -> triaged -> confirmed -> fixed`, with
  `false-positive` and reopen edges), checked rather than free-form;
* the JSON shape of a **record** and of the **local store**
  (`scry-workflow/findings.json`).

The store and the artifact writer live in `scry/src/Scry/WorkflowCmd.wiz`; this module is
pure, so the identity and state rules are testable without C or a compiler.

## What an id is, and is not

The id is a *stable handle for triage*, not a claim that two runs found the same bug in
the sense of a proof. It excludes absolute paths, line/column, program-point numbers,
timestamps and rule-array indices. It includes the rule id, the normalized file path,
the sink function/callee/argument and the path shape. A rename of the sink or a change
from `source -> sink` to `source -> store -> load -> sink` is a new id: that is a
deliberate review event, not a silent match.
-/

-- ## Identity

/-- Normalize a path for identity: forward slashes, no leading `./`. Absolute paths are
kept (the caller should pass a repository-relative path when it has one). -/
def Scry.wfNormalizePath (p : String) : String :=
  let q := String.replace p "\\" "/";
  match String.stripPrefix q "./" with
  | .some r => r
  | .none => q

/-- Collapse runs of whitespace to one space and trim: the normalized primary line. -/
partial def Scry.wfNormLineGo (lastSpace : Bool) : List Char → List Char
  | .nil => .nil
  | .cons c cs =>
    match Char.isSpace c with
    | .true =>
      match lastSpace with
      | .true => Scry.wfNormLineGo .true cs
      | .false => List.cons (Char.mk 32) (Scry.wfNormLineGo .true cs)
    | .false => List.cons c (Scry.wfNormLineGo .false cs)

/-- The normalized primary line: whitespace runs collapsed, trimmed. -/
def Scry.wfNormLine (s : String) : String :=
  String.trim (String.ofChars (Scry.wfNormLineGo .false (String.chars s)))

/-- FNV-1a over a string's code points, modulo 2^64. Not a cryptographic hash; the
record says `fnv1a64` next to it so nothing claims otherwise. -/
def Scry.wfFnvStep (h : Nat) (c : Char) : Nat :=
  Nat.mod (Nat.add (Nat.mul h 1099511628211) (Char.code c)) (Nat.pow 2 64)

def Scry.wfFnv (s : String) : Nat :=
  List.foldl Scry.wfFnvStep 14695981039346656037 (String.chars s)

/-- 16 lower-case hex digits (64 bits). -/
partial def Scry.wfHexGo (n : Nat) (fuel : Nat) : List Char :=
  match fuel with
  | .zero => .nil
  | .succ k =>
    List.cons (Json.hexDigit (Nat.mod n 16)) (Scry.wfHexGo (Nat.div n 16) k)

/-- A stable 16-hex-digit rendering of an FNV-1a value. -/
def Scry.wfHex (n : Nat) : String :=
  String.ofChars (List.reverse (Scry.wfHexGo n 16))

/-- The coarse role path (`source>flow>sink`): roles, not program points. -/
def Scry.wfPathShape (path : List Scry.PathNode) : String :=
  String.intercalate ">" (List.map (fun p => Scry.PathKind.show p.kind) path)

def Scry.wfFirstFunc : List Scry.PathNode → String
  | .nil => ""
  | .cons p _ => p.func

def Scry.wfLastFunc : List Scry.PathNode → String
  | .nil => ""
  | .cons p .nil => p.func
  | .cons _ ps => Scry.wfLastFunc ps

/-- The identity inputs, rendered for debugging and for the record. No line, column,
program point or timestamp. The source callee is not carried by `RuleFinding` today
(`PathNode` has `func`/`point`/`var`/`kind` only); the path shape and the first function
are the available coarse source identity. -/
def Scry.wfSemanticKey (f : Scry.RuleFinding) (file : String) : String :=
  String.intercalate "|"
    [ String.append "scry/c/" f.rule
    , Scry.wfNormalizePath file
    , f.func
    , f.name
    , Nat.repr f.arg
    , Scry.wfPathShape f.path
    , Scry.wfFirstFunc f.path
    , Scry.wfLastFunc f.path ]

/-- `f_<16 hex>`: the semantic id. -/
def Scry.wfId (f : Scry.RuleFinding) (file : String) : String :=
  String.append "f_" (Scry.wfHex (Scry.wfFnv (Scry.wfSemanticKey f file)))

/-- The GitHub-compatible line identity: rule + normalized primary line + function. A
whitespace-only change keeps it; a line move keeps it (there is no line number); a
changed sink creates a new one. -/
def Scry.wfLineKey (f : Scry.RuleFinding) (lineText : String) : String :=
  String.intercalate "|"
    [ String.append "scry/c/" f.rule, f.func, Scry.wfNormLine lineText ]

def Scry.wfLineHash (f : Scry.RuleFinding) (lineText : String) : String :=
  Scry.wfHex (Scry.wfFnv (Scry.wfLineKey f lineText))

/-- The rest of a line (up to the newline) as characters. -/
partial def Scry.wfLineTakeGo : List Char → List Char
  | .nil => .nil
  | .cons c cs =>
    match Nat.beq (Char.code c) 10 with
    | .true => .nil
    | .false => List.cons c (Scry.wfLineTakeGo cs)

/-- The 1-based source line `line`, or `""` when it is out of range. Used for the
primary-line hash; the analysis itself uses byte spans. -/
partial def Scry.wfLineAtGo (want : Nat) (line : Nat) : List Char → String
  | .nil => ""
  | .cons c cs =>
    match Nat.beq line want with
    | .true =>
      match Nat.beq (Char.code c) 10 with
      | .true => ""
      | .false => String.ofChars (List.cons c (Scry.wfLineTakeGo cs))
    | .false =>
      match Nat.beq (Char.code c) 10 with
      | .true => Scry.wfLineAtGo want (Nat.succ line) cs
      | .false => Scry.wfLineAtGo want line cs

def Scry.wfLineAt (text : String) (line : Nat) : String :=
  Scry.wfLineAtGo line 1 (String.chars text)

-- ## Triage state machine

inductive Scry.WfState where
  | new
  | triaged
  | confirmed
  | falsePositive
  | fixed

/-- `new` is the initial state; `triaged` is a human label; `confirmed` is accepted as
a real finding; `falsePositive` is rejected (and may be reopened); `fixed` is the
remediation claim (and may be reopened on a regression). -/
def Scry.WfState.show : Scry.WfState → String
  | .new => "new"
  | .triaged => "triaged"
  | .confirmed => "confirmed"
  | .falsePositive => "false-positive"
  | .fixed => "fixed"

def Scry.WfState.parse (s : String) : Option Scry.WfState :=
  match s with
  | "new" => .some .new
  | "triaged" => .some .triaged
  | "confirmed" => .some .confirmed
  | "false-positive" => .some .falsePositive
  | "false_positive" => .some .falsePositive
  | "falsepositive" => .some .falsePositive
  | "fixed" => .some .fixed
  | _ => .none

/-- The allowed edges. Same-state updates are idempotent (history is still appended).
`new -> fixed` is refused: a fix claim needs a triage/confirmation first. A rejected or
fixed finding can be reopened to `triaged` when new evidence arrives. -/
def Scry.wfAllowed (from to : Scry.WfState) : Bool :=
  match from, to with
  | .new, .new => .true
  | .new, .triaged => .true
  | .new, .confirmed => .true
  | .new, .falsePositive => .true
  | .triaged, .triaged => .true
  | .triaged, .confirmed => .true
  | .triaged, .falsePositive => .true
  | .confirmed, .confirmed => .true
  | .confirmed, .fixed => .true
  | .confirmed, .falsePositive => .true
  | .falsePositive, .falsePositive => .true
  | .falsePositive, .triaged => .true
  | .fixed, .fixed => .true
  | .fixed, .triaged => .true
  | _, _ => .false

/-- A transition, or an explanation of why the edge is not in the machine. -/
def Scry.wfTransition (from to : Scry.WfState) : Except String Scry.WfState :=
  match Scry.wfAllowed from to with
  | .true => .ok to
  | .false =>
    .error (String.append "illegal triage transition "
      (String.append (Scry.WfState.show from) (String.append " -> " (Scry.WfState.show to))))

-- ## Evidence authority and kind

/-- The authority ladder of `prior-art/symbolic-execution.md` §10.5. Scry never uses L4
or L5: an absent finding is not an absence certificate. A checked derivation is L2; a
concrete recorded run is L1 (a reproducible experiment, not a solver proof); a future
concolic witness with a checked `Wil.run` trace is L3; a validated SMT model is L2. -/
inductive Scry.WfAuthority where
  | l0
  | l1
  | l2
  | l3
  | l4
  | l5

def Scry.WfAuthority.show : Scry.WfAuthority → String
  | .l0 => "L0"
  | .l1 => "L1"
  | .l2 => "L2"
  | .l3 => "L3"
  | .l4 => "L4"
  | .l5 => "L5"

def Scry.WfAuthority.parse (s : String) : Option Scry.WfAuthority :=
  match s with
  | "L0" => .some .l0
  | "L1" => .some .l1
  | "L2" => .some .l2
  | "L3" => .some .l3
  | "L4" => .some .l4
  | "L5" => .some .l5
  | _ => .none

/-- What an evidence item is. Static and dynamic evidence are never merged; a witness
is a separate item so `repro`/`verify` can prefer it without pretending a recorded
trace is a witness. -/
inductive Scry.WfEvidenceKind where
  | staticAnalysis
  | dynamicObserved
  | smtModel
  | concolicWitness
  | certificate

def Scry.WfEvidenceKind.show : Scry.WfEvidenceKind → String
  | .staticAnalysis => "static"
  | .dynamicObserved => "dynamic-observed"
  | .smtModel => "smt-model"
  | .concolicWitness => "concolic-witness"
  | .certificate => "certificate"

/-- The CWE tiers of `prior-art/symbolic-execution.md` §11.5. The pack has no CWE
metadata on this base; this maps the known rule ids and is deliberately conservative.
`N/A` means a concrete input adds nothing (the call is the bug) or the class is out of
scope; it is not a statement about severity. -/
def Scry.wfCweTier (rule : String) : String :=
  match rule with
  | "command-injection" => "T1"
  | "format-string" => "T1"
  | "path-traversal" => "T2"
  | "use-after-free" => "T2"
  | "integer-overflow" => "T3"
  | "buffer-overflow" => "T3"
  | "gets-overflow" => "N/A"
  | "strcpy-overflow" => "N/A"
  | _ => "unknown"

-- ## The candidate contract
--
-- A finding that enters the workflow is a *candidate*, and every stage extends the same
-- value instead of dropping what the previous stage learned:
--
--   scan     -> stage "scan",     verdict "unranked", path/sink known
--   refine   -> stage "refined",  rank + reasons + a PoC plan derived from the source
--   repro    -> stage "poc",      the plan's marker observed in a concrete run
--   verify   -> stage "verified", the static finding and the PoC marked side by side
--
-- `candidate.json` is the artifact; `WfRecord.candidate` is the value in the store. A
-- stage that cannot fill a field leaves it empty and says why rather than inventing one.

/-- Where the attacker-controlled value enters, as the taint path and the source line
name it. `channel` is the control a reproducer needs; `detail` is its name (an env var,
an argv slot) or `""` when the source line does not name one. -/
structure Scry.WfSource where
  /-- The source callee as written (`getenv`, `System.Console.ReadLine`, `read`). -/
  callee : String
  /-- `stdin`, `env`, `argv`, `http` or `unknown`. -/
  channel : String
  /-- An environment variable name, an argv slot, or `""`. -/
  detail : String
  /-- Where the source sits. -/
  function : String
  line : Nat
  column : Nat
  variable : Nat

/-- The reproducer plan: what the PoC must control and what it must observe. It is
derived from the path (source channel, sink callee/arg), not hand-written. -/
structure Scry.WfPlan where
  /-- `stdin`, `env`, `argv`, `http` or `none`. -/
  channel : String
  envName : String
  inputText : String
  /-- A token the PoC must make observable at the sink. -/
  marker : String
  sinkFunction : String
  sinkCallee : String
  sinkArg : Nat
  /-- What the plan was derived from (e.g. `static.json path; source line 7`). -/
  derivedFrom : String

/-- The value every stage carries. `rank`/`verdict` are the triage decision, `source`
the path's entry point, `plan` the PoC the verifier will run. -/
structure Scry.WfCandidate where
  /-- `scan`, `refined`, `poc` or `verified`. -/
  stage : String
  /-- 0..100, higher is more likely a true positive. -/
  rank : Nat
  /-- `unranked`, `pursue`, `deprioritise` or `reject`. -/
  verdict : String
  reasons : List String
  source : Option Scry.WfSource
  plan : Scry.WfPlan

def Scry.wfEmptySource : Scry.WfSource :=
  Scry.WfSource.mk "" "unknown" "" "" 0 0 0

def Scry.wfEmptyPlan : Scry.WfPlan :=
  Scry.WfPlan.mk "none" "" "" "" "" "" 0 ""

/-- The candidate a fresh scan writes: identity and sink, no rank yet. -/
def Scry.wfScanCandidate : Scry.WfCandidate :=
  Scry.WfCandidate.mk "scan" 0 "unranked"
    ["found by scry taint; not refined"] .none Scry.wfEmptyPlan

-- ## Deriving the source and the plan (pure)

def Scry.wfIdentChar (c : Char) : Bool :=
  Bool.or (Bool.or (Char.isDigit c)
    (Bool.and (Nat.le 65 (Char.code c)) (Nat.le (Char.code c) 90)))
    (Bool.or (Bool.and (Nat.le 97 (Char.code c)) (Nat.le (Char.code c) 122))
      (Bool.or (Char.eq c (Char.mk 95)) (Char.eq c (Char.mk 46))))

/-- The characters before the first `(`. -/
partial def Scry.wfBeforeParen : List Char → List Char
  | .nil => .nil
  | .cons c cs => match Char.eq c (Char.mk 40) with
    | .true => .nil
    | .false => List.cons c (Scry.wfBeforeParen cs)

/-- The leading run of identifier characters. -/
partial def Scry.wfTakeIdent : List Char → List Char
  | .nil => .nil
  | .cons x xs => match Scry.wfIdentChar x with
    | .true => List.cons x (Scry.wfTakeIdent xs)
    | .false => .nil

/-- The identifier tail of a character list (after skipping white space and a `=`). -/
partial def Scry.wfIdentTail (cs : List Char) : List Char :=
  match List.reverse cs with
  | .nil => .nil
  | .cons c rest => match Char.isSpace c with
    | .true => Scry.wfIdentTail (List.reverse rest)
    | .false => match Char.eq c (Char.mk 61) with
      | .true => .nil
      | .false => Scry.wfTakeIdent (List.cons c rest)

/-- The callee on a source/assignment line: `char *cmd = getenv(0);` -> `getenv`,
`string host = Console.ReadLine();` -> `Console.ReadLine`. -/
def Scry.wfCalleeOfLine (line : String) : String :=
  String.ofChars (List.reverse (Scry.wfIdentTail (Scry.wfBeforeParen (String.chars line))))

/-- The first double-quoted literal on a line, unescaped only for `\"`. `""` when the
line has none (e.g. `getenv(0)`), which is itself a finding about the fixture. -/
partial def Scry.wfLiteralGo : List Char → Bool → List Char → String
  | .nil, _, _ => ""
  | .cons c cs, .false, _ => match Char.eq c (Char.mk 34) with
    | .true => Scry.wfLiteralGo cs .true .nil
    | .false => Scry.wfLiteralGo cs .false .nil
  | .cons c cs, .true, acc => match Char.eq c (Char.mk 34) with
    | .true => String.ofChars (List.reverse acc)
    | .false => match Char.eq c (Char.mk 92) with
      | .true => match cs with
        | .cons d ds => Scry.wfLiteralGo ds .true (List.cons d acc)
        | .nil => String.ofChars (List.reverse acc)
      | .false => Scry.wfLiteralGo cs .true (List.cons c acc)

def Scry.wfFirstLiteral (line : String) : String :=
  Scry.wfLiteralGo (String.chars line) .false .nil

/-- The control channel a source callee needs. Conservative: an unrecognised callee is
`unknown`, and the candidate is not rejected for it (it is only ranked lower). -/
def Scry.wfChannelOfCallee (callee : String) : String :=
  match String.contains callee "GetEnvironmentVariable" with
  | .true => "env"
  | .false => match String.contains callee "getenv" with
    | .true => "env"
    | .false => match String.contains callee "GetCommandLineArgs" with
      | .true => "argv"
      | .false => match String.contains callee "ReadLine" with
        | .true => "stdin"
        | .false => match String.contains callee "ReadToEnd" with
          | .true => "stdin"
          | .false => match String.contains callee "get_Query" with
            | .true => "http"
            | .false => match String.contains callee "get_Form" with
              | .true => "http"
              | .false => match String.contains callee "get_Headers" with
                | .true => "http"
                | .false => match String.contains callee "get_Body" with
                  | .true => "http"
                  | .false => match String.contains callee "fgets" with
                    | .true => "stdin"
                    | .false => match String.contains callee "scanf" with
                      | .true => "stdin"
                      | .false => match String.contains callee "argv" with
                        | .true => "argv"
                        | .false => match String.eq callee "read" with
                          | .true => "stdin"
                          | .false => "unknown"

/-- The plan a candidate carries. The marker is unique per finding, so a run cannot
match a marker left over from another candidate. For command injection the input is a
shell command *plus* the marker, so a sink that runs a shell prints it. -/
def Scry.wfPlanFor (id rule func callee : String) (arg : Nat)
    (src : Option Scry.WfSource) : Scry.WfPlan :=
  let marker := String.append "scry-poc-" id;
  let channel := match src with | .some s => s.channel | .none => "none";
  let envName := match src with
    | .some s => match String.eq s.channel "env" with
      | .true => match String.isEmpty s.detail with
        | .true => "SCRY_INPUT"
        | .false => s.detail
      | .false => ""
    | .none => "";
  let inputText := match String.eq channel "none" with
    | .true => ""
    | .false => match String.eq rule "command-injection" with
      | .true => String.append "true; echo " marker
      | .false => match String.eq rule "path-traversal" with
        | .true => String.append "../../" marker
        | .false => marker;
  let srcText := match src with
    | .some s => "source " ++ s.callee ++ " at " ++ s.function ++ ":" ++ Nat.repr s.line
    | .none => "no source step";
  Scry.WfPlan.mk channel envName inputText marker func callee arg
    (String.append "static.json path; " srcText)

-- ## Ranking (pure, deterministic, auditable)

/-- The inputs to the rank. Every field comes from an artifact (the static evidence, the
path, the source line), not from the finding's prose. -/
structure Scry.WfRankInput where
  checked : Bool
  parseErrors : Nat
  boundaries : Nat
  pathLength : Nat
  tier : String
  channel : String
  sourceDetail : String
  duplicate : Bool

def Scry.wfRankInputOf (checked : Bool) (parseErrors boundaries pathLength : Nat)
    (tier channel sourceDetail : String) (duplicate : Bool) : Scry.WfRankInput :=
  Scry.WfRankInput.mk checked parseErrors boundaries pathLength tier channel sourceDetail
    duplicate

def Scry.wfSign (n : Nat) : String :=
  String.append " (+" (String.append (Nat.repr n) ")")

/-- A 0..100 rank and the reasons, one line per factor (including the ones that scored
0), so a triage decision can be audited and the test can assert it. -/
def Scry.wfRank (i : Scry.WfRankInput) : Nat × List String :=
  let cert : Nat := match i.checked with | .true => 15 | .false => 0;
  let chan : Nat := match i.channel with
    | "stdin" => 20 | "env" => 20 | "argv" => 15 | "http" => 5 | _ => 0;
  let tier : Nat := match i.tier with
    | "T1" => 10 | "T2" => 8 | "T3" => 4 | _ => 0;
  let path : Nat := match i.pathLength with
    | 2 => 10 | 3 => 8 | 0 => 0 | 1 => 0 | _ => 4;
  let base : Nat := 40;
  let errPen : Nat := Nat.mul i.parseErrors 15;
  let bndPen : Nat := Nat.mul i.boundaries 5;
  let detailPen : Nat := match i.channel with
    | "env" => match String.isEmpty i.sourceDetail with | .true => 10 | .false => 0
    | _ => 0;
  let dupPen : Nat := match i.duplicate with | .true => 100 | .false => 0;
  let raw : Nat := Nat.add base (Nat.add cert (Nat.add chan (Nat.add tier path)));
  let pen : Nat := Nat.add dupPen (Nat.add errPen (Nat.add bndPen detailPen));
  let r0 : Nat := match Nat.lt raw pen with | .true => 0 | .false => Nat.sub raw pen;
  let rank : Nat := match Nat.lt 100 r0 with | .true => 100 | .false => r0;
  (rank,
    [ "base 40"
    , String.append (String.append "certificate " (match i.checked with
        | .true => "checked" | .false => "unchecked")) (Scry.wfSign cert)
    , String.append (String.append "channel " i.channel) (Scry.wfSign chan)
    , String.append (String.append "tier " i.tier) (Scry.wfSign tier)
    , String.append (String.append "path " (Nat.repr i.pathLength)) (Scry.wfSign path)
    , String.append (String.append "parse errors " (Nat.repr i.parseErrors))
        (String.append " (-" (String.append (Nat.repr errPen) ")"))
    , String.append (String.append "boundary warnings " (Nat.repr i.boundaries))
        (String.append " (-" (String.append (Nat.repr bndPen) ")"))
    , String.append "source detail "
        (String.append (match String.isEmpty i.sourceDetail with
          | .true => "absent" | .false => i.sourceDetail)
          (String.append " (-" (String.append (Nat.repr detailPen) ")")))
    , String.append "duplicate of a better candidate"
        (String.append " (-" (String.append (Nat.repr dupPen) ")")) ])

def Scry.wfVerdict (rank : Nat) : String :=
  match Nat.le 60 rank with
  | .true => "pursue"
  | .false => match Nat.le 30 rank with
    | .true => "deprioritise"
    | .false => "reject"

-- ## Records

structure Scry.WfHistory where
  state : Scry.WfState
  /-- Wall clock, nanoseconds since the epoch. -/
  at : Nat
  actor : String
  reason : String

structure Scry.WfRecord where
  id : String
  /-- The semantic key the id was computed from (debugging/reproduction). -/
  key : String
  lineHash : String
  state : Scry.WfState
  history : List Scry.WfHistory
  source : String
  rules : Option String
  allowErrors : Bool
  /-- The latest finding snapshot (the `scry taint` JSON shape). -/
  finding : Json
  /-- Relative artifact directory (`scry-workflow/<id>`). -/
  artifacts : String
  staticRel : Option String
  dynamicRel : Option String
  verifyRel : Option String
  /-- The stage contract: identity at scan, rank/plan at refine, PoC and verification
  after. A store written before this field existed parses as `none` (unranked). -/
  candidate : Option Scry.WfCandidate
  /-- The relative artifact (`candidate.json`) when one was written. -/
  candidateRel : Option String
  firstSeen : Nat
  lastSeen : Nat

-- ## JSON rendering

def Scry.wfOptStrJson : Option String → Json
  | .some s => Json.mkStr s
  | .none => Json.mkNull

def Scry.wfSourceJson (s : Scry.WfSource) : Json :=
  Json.mkObj
    [ ("callee", Json.mkStr s.callee)
    , ("channel", Json.mkStr s.channel)
    , ("detail", Json.mkStr s.detail)
    , ("function", Json.mkStr s.function)
    , ("line", Json.ofNat s.line)
    , ("column", Json.ofNat s.column)
    , ("variable", Json.ofNat s.variable) ]

def Scry.wfPlanJson (p : Scry.WfPlan) : Json :=
  Json.mkObj
    [ ("channel", Json.mkStr p.channel)
    , ("envName", Json.mkStr p.envName)
    , ("inputText", Json.mkStr p.inputText)
    , ("marker", Json.mkStr p.marker)
    , ("sink", Json.mkObj
        [ ("function", Json.mkStr p.sinkFunction)
        , ("callee", Json.mkStr p.sinkCallee)
        , ("argument", Json.ofNat p.sinkArg) ])
    , ("derivedFrom", Json.mkStr p.derivedFrom) ]

def Scry.wfCandidateJson (c : Scry.WfCandidate) : Json :=
  Json.mkObj
    [ ("schema", Json.mkStr "scry-workflow-candidate/1")
    , ("stage", Json.mkStr c.stage)
    , ("rank", Json.ofNat c.rank)
    , ("verdict", Json.mkStr c.verdict)
    , ("reasons", Json.mkArr (List.map Json.mkStr c.reasons))
    , ("source", match c.source with | .some s => Scry.wfSourceJson s | .none => Json.mkNull)
    , ("plan", Scry.wfPlanJson c.plan) ]

def Scry.wfHistoryJson (h : Scry.WfHistory) : Json :=
  Json.mkObj
    [ ("state", Json.mkStr (Scry.WfState.show h.state))
    , ("at", Json.ofNat h.at)
    , ("by", Json.mkStr h.actor)
    , ("reason", Json.mkStr h.reason) ]

def Scry.wfRecordJson (r : Scry.WfRecord) : Json :=
  Json.mkObj
    [ ("schema", Json.mkStr "scry-workflow-record/1")
    , ("id", Json.mkStr r.id)
    , ("key", Json.mkStr r.key)
    , ("lineHash", Json.mkStr r.lineHash)
    , ("state", Json.mkStr (Scry.WfState.show r.state))
    , ("history", Json.mkArr (List.map Scry.wfHistoryJson r.history))
    , ("source", Json.mkStr r.source)
    , ("rules", Scry.wfOptStrJson r.rules)
    , ("allowErrors", Json.mkBool r.allowErrors)
    , ("finding", r.finding)
    , ("artifacts", Json.mkStr r.artifacts)
    , ("static", Scry.wfOptStrJson r.staticRel)
    , ("dynamic", Scry.wfOptStrJson r.dynamicRel)
    , ("verify", Scry.wfOptStrJson r.verifyRel)
    , ("candidate", match r.candidate with
        | .some c => Scry.wfCandidateJson c
        | .none => Json.mkNull)
    , ("candidateFile", Scry.wfOptStrJson r.candidateRel)
    , ("firstSeen", Json.ofNat r.firstSeen)
    , ("lastSeen", Json.ofNat r.lastSeen) ]

structure Scry.WfStore where
  findings : List Scry.WfRecord

def Scry.wfEmptyStore : Scry.WfStore := Scry.WfStore.mk .nil

def Scry.wfStoreJson (st : Scry.WfStore) : Json :=
  Json.mkObj
    [ ("schema", Json.mkStr "scry-workflow-store/1")
    , ("findings", Json.mkArr (List.map Scry.wfRecordJson st.findings)) ]

def Scry.wfStoreText (st : Scry.WfStore) : String :=
  String.append (Json.render (Scry.wfStoreJson st)) "\n"

def Scry.wfFind (st : Scry.WfStore) (id : String) : Option Scry.WfRecord :=
  List.find (fun r => String.eq r.id id) st.findings

/-- Replace the record with the same id, or append it. -/
def Scry.wfUpsert (st : Scry.WfStore) (r : Scry.WfRecord) : Scry.WfStore :=
  match Scry.wfFind st r.id with
  | .none => Scry.WfStore.mk (List.append st.findings [r])
  | .some _ =>
    Scry.WfStore.mk (List.map (fun x => match String.eq x.id r.id with
      | .true => r
      | .false => x) st.findings)

-- ## JSON parsing (lenient, but the schema and id are checked)

def Scry.wfGetOptStr (j : Json) (k : String) : Option String :=
  match Json.get j k with
  | .some (.str s) => .some s
  | _ => .none

def Scry.wfGetNatD (j : Json) (k : String) (d : Nat) : Nat :=
  match Json.get j k with
  | .some (.int _ n) => n
  | _ => d

def Scry.wfStateOfString (s : String) : Scry.WfState :=
  match s with
  | "triaged" => .triaged
  | "confirmed" => .confirmed
  | "false-positive" => .falsePositive
  | "fixed" => .fixed
  | _ => .new

def Scry.wfHistoryOfJson (j : Json) : Scry.WfHistory :=
  let state := Scry.wfStateOfString (Json.getStr j "state");
  Scry.WfHistory.mk state (Scry.wfGetNatD j "at" 0)
    (Json.getStr j "by") (Json.getStr j "reason")

def Scry.wfStrsOfJson (j : Json) (k : String) : List String :=
  List.map (fun x => match x with | .str s => s | _ => "") (Json.getList j k)

def Scry.wfSourceOfJson (j : Json) : Option Scry.WfSource :=
  match Json.get j "callee" with
  | .some (.str callee) => .some (Scry.WfSource.mk callee (Json.getStr j "channel")
      (Json.getStr j "detail") (Json.getStr j "function")
      (Scry.wfGetNatD j "line" 0) (Scry.wfGetNatD j "column" 0)
      (Scry.wfGetNatD j "variable" 0))
  | _ => .none

def Scry.wfPlanOfJson (j : Json) : Scry.WfPlan :=
  let sink := match Json.get j "sink" with
    | .some x => x
    | .none => Json.mkNull;
  Scry.WfPlan.mk (Json.getStr j "channel") (Json.getStr j "envName")
    (Json.getStr j "inputText") (Json.getStr j "marker")
    (Json.getStr sink "function") (Json.getStr sink "callee")
    (Scry.wfGetNatD sink "argument" 0) (Json.getStr j "derivedFrom")

def Scry.wfCandidateOfJson (j : Json) : Option Scry.WfCandidate :=
  match Json.get j "stage" with
  | .some (.str stage) => .some (Scry.WfCandidate.mk stage
      (Scry.wfGetNatD j "rank" 0) (Json.getStr j "verdict")
      (Scry.wfStrsOfJson j "reasons")
      (match Json.get j "source" with
        | .some s => Scry.wfSourceOfJson s
        | .none => .none)
      (match Json.get j "plan" with
        | .some p => Scry.wfPlanOfJson p
        | .none => Scry.wfEmptyPlan))
  | _ => .none

def Scry.wfRecordOfJson (j : Json) : Option Scry.WfRecord :=
  match Json.getStr j "id" with
  | "" => .none
  | id =>
    let state := match Scry.WfState.parse (Json.getStr j "state") with
      | .some s => s
      | .none => (.new : Scry.WfState);
    let histories := List.map Scry.wfHistoryOfJson (Json.getList j "history");
    .some (Scry.WfRecord.mk id (Json.getStr j "key") (Json.getStr j "lineHash") state
      histories (Json.getStr j "source") (Scry.wfGetOptStr j "rules")
      (match Json.get j "allowErrors" with | .some (.bool b) => b | _ => .false)
      (match Json.get j "finding" with | .some f => f | _ => Json.mkNull)
      (Json.getStr j "artifacts")
      (Scry.wfGetOptStr j "static") (Scry.wfGetOptStr j "dynamic")
      (Scry.wfGetOptStr j "verify")
      (match Json.get j "candidate" with
        | .some c => Scry.wfCandidateOfJson c
        | .none => .none)
      (Scry.wfGetOptStr j "candidateFile")
      (Scry.wfGetNatD j "firstSeen" 0) (Scry.wfGetNatD j "lastSeen" 0))

partial def Scry.wfFilterMap {A B : Type} (f : A → Option B) : List A → List B
  | .nil => .nil
  | .cons x xs => match f x with
    | .some y => List.cons y (Scry.wfFilterMap f xs)
    | .none => Scry.wfFilterMap f xs

def Scry.wfStoreOfText (text : String) : Except String Scry.WfStore :=
  match Json.parse text with
  | .error e => .error (String.append "findings store: " e)
  | .ok j =>
    match Json.getStr j "schema" with
    | "scry-workflow-store/1" =>
      .ok (Scry.WfStore.mk
        (Scry.wfFilterMap Scry.wfRecordOfJson (Json.getList j "findings")))
    | other => .error (String.append "findings store: unsupported schema \"" (String.append other "\""))

/-- Append a triage history entry and move the state, or return the machine's error. -/
def Scry.wfTriage (r : Scry.WfRecord) (to : Scry.WfState) (actor : String) (reason : String)
    (at : Nat) : Except String Scry.WfRecord :=
  match Scry.wfTransition r.state to with
  | .error e => .error e
  | .ok state =>
    let h := Scry.WfHistory.mk state at actor reason;
    .ok { r with state := state, history := List.append r.history [h] }

-- ## Small helpers used by the command and its tests

/-- The first line of `s` (without its newline). -/
def Scry.wfFirstLine (s : String) : String :=
  match String.splitOn s "\n" with
  | .cons l _ => l
  | .nil => ""

/-- Lines of `s` (no trailing empty line for a final newline). -/
def Scry.wfLines (s : String) : List String :=
  String.splitOn s "\n"

def Scry.wfInterestingLine (l : String) : Bool :=
  Bool.or (String.contains l "AddressSanitizer")
    (Bool.or (String.contains l "UndefinedBehaviorSanitizer")
      (Bool.or (String.contains l "runtime error:")
        (String.contains l "SUMMARY: ")))

/-- First `n` elements, without a multi-argument pattern. -/
partial def Scry.wfTakeGo (n : Nat) : List String → List String
  | .nil => .nil
  | .cons x xs =>
    match n with
    | .zero => .nil
    | .succ k => List.cons x (Scry.wfTakeGo k xs)

/-- The lines that carry a sanitizer or an error marker, in order, at most `n`. This is
the dynamic "trace" the bundle keeps; it is a pointer to the log, not the whole log. -/
def Scry.wfInteresting (n : Nat) (s : String) : List String :=
  Scry.wfTakeGo n (List.filter Scry.wfInterestingLine (Scry.wfLines s))
