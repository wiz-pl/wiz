import Scry.RuleTaint
import Scry.Analysis
import Scry.PointsTo
import Scry.Rules
import Scry.Models
import Scry.Lifetime
import Scry.Bounds
import Text
import WordMap
/-!
# Scry.Interproc

**Interprocedural taint for direct and resolved indirect calls** (`import Scry.Interproc`):
a call graph from `Wil`, argument -> parameter taint, return-value summaries, and a
summary fixpoint that handles recursion.

An indirect call (`fp(x)`, `(*fp)(x)`) is resolved by `Scry.PointsTo` to the functions its
function-pointer value may hold. Every resolved target becomes a call site (so argument
taint reaches its parameter and its return value taints the result), and a call whose
target set is empty or contains a non-function/unknown location is recorded as
**unknown**: its arguments and result are not propagated, and `Scry.RuleTaint` reports an
`unknown-indirect` warning rather than a silent false negative.

## The model

For a direct call `r = f(a0, …, an)` at point `n`:

* **argument -> parameter.** If `ai` is tainted at `n` (a tainted definition reaches the
  call), then parameter `i` of `f` is marked tainted. A tainted parameter is seeded at
  `f`'s entry as an extra definition (`Scry.Analysis.fnInfoWith`), so the intraprocedural
  rules carry it from there.
* **return value.** A function summarises to `retTainted` when a `ret x` uses a tainted
  `x`. At every call site to a function whose summary says so, the call's result
  register is seeded with `retsrc`, so the caller's def-use graph carries the taint on.
* **recursion.** Both summaries are monotone, so a round-robin fixpoint over `params`
  (sets of positions) and `retTainted` (a boolean) terminates; the number of rounds is
  bounded by the number of functions plus parameters.

The fixpoint uses `Scry.RuleTaint.evaluateFunc`, which is one Datalog evaluation per
function per round. The final results are recomputed once with the stable summaries; the
findings and paths are read from those.

## Paths

`Scry.programFindings` returns findings whose path is stitched across calls:
a tainted parameter is replaced by the caller's path to the argument, a `retsrc` seed by
the callee's path to its return. The walk is bounded (fuel) and cycle-guarded; a cycle
leaves a `recursion` node instead of looping. This path is **evidence**, not a proof:
`Scry.Certify` checks the Datalog derivation and reports its EDB axioms, which include
the parameter seeds the path walk justifies interprocedurally.
-/

-- ## The call graph

structure Scry.CallSite where
  caller : String
  node : Nat
  callee : String
  args : List Nat
  result : Option Nat

structure Scry.CallGraph where
  sites : List Scry.CallSite
  /-- `(caller, point)` of every call through a function value. -/
  indirect : List (String × Nat)

def Scry.siteOfCall (fn : Wil.Func) (pt : Scry.PtResult) (n : Nat) (r : Option Wil.Var)
    (args : List Wil.Var) (name : String) : Scry.CallSite :=
  Scry.CallSite.mk fn.name n name
    (List.map (fun v => v.index) args)
    (match r with
      | .some v => .some v.index
      | .none => .none)

/-- The direct and resolved-indirect call sites of a function. -/
def Scry.sitesOfFunc (fn : Wil.Func) (pt : Scry.PtResult) : List Scry.CallSite :=
  let g := Scry.flatten fn;
  Scry.concatLists (fun n =>
    match Scry.nodeStmt g n with
    | .none => .nil
    | .some s => match s with
      | .call r callee args _ => match callee with
        | .direct name => List.cons (Scry.siteOfCall fn pt n r args name) .nil
        | .indirect _ =>
          List.map (fun name => Scry.siteOfCall fn pt n r args name)
            (Scry.indirectAt pt fn.name n).names
      | _ => .nil) (Scry.range g.count)

def Scry.indirectOfFunc (fn : Wil.Func) : List (String × Nat) :=
  let g := Scry.flatten fn;
  Scry.concatLists (fun n =>
    match Scry.nodeStmt g n with
    | .none => .nil
    | .some s => match s with
      | .call _ (.indirect _) _ _ => List.cons (fn.name, n) .nil
      | _ => .nil) (Scry.range g.count)

/-- The direct-call graph of a program plus every resolved indirect target; the unresolved
indirect calls are listed in `indirect` (and warned about). -/
def Scry.callGraph (p : Wil.Program) (pt : Scry.PtResult) : Scry.CallGraph :=
  Scry.CallGraph.mk
    (Scry.concatLists (fun fn => Scry.sitesOfFunc fn pt) p.funcs)
    (Scry.concatLists Scry.indirectOfFunc p.funcs)

def Scry.siteAt (g : Scry.CallGraph) (caller : String) (node : Nat) : Option Scry.CallSite :=
  List.find (fun s => Bool.and (String.eq s.caller caller) (Nat.beq s.node node)) g.sites

def Scry.sitesTo (g : Scry.CallGraph) (callee : String) : List Scry.CallSite :=
  List.filter (fun s => String.eq s.callee callee) g.sites

def Scry.sitesFrom (g : Scry.CallGraph) (caller : String) : List Scry.CallSite :=
  List.filter (fun s => String.eq s.caller caller) g.sites

-- ## Exported entry parameters

/-- The function names whose address is taken as a value (`p = f`, `qsort(…, cmp)`).
Such a function is used from inside the unit as a callback, so its parameters are not an
external entry merely because no direct call resolves to it. -/
def Scry.fnptrNamesOfStmt (s : Wil.Stmt) : List String :=
  match s with
  | .assign _ (.fnptr name) _ => List.cons name .nil
  | _ => .nil

def Scry.fnptrNamesOfFunc (fn : Wil.Func) : List String :=
  Scry.rulePackConcat (fun b => Scry.rulePackConcat Scry.fnptrNamesOfStmt b.stmts)
    fn.blocks

def Scry.fnptrNames (p : Wil.Program) : List String :=
  Scry.rulePackConcat Scry.fnptrNamesOfFunc p.funcs

/-- Whether `fn` is an **exported entry** in the C-ABI sense: it has external linkage
(not lowered under the `static:` prefix), is not `main`, and no direct or resolved
indirect call in this unit targets it. Its parameters can then be supplied by an
external/Ffi caller, so they are taint sources. A function whose address is taken is a
callback, not an entry. -/
def Scry.isExportedEntry (p : Wil.Program) (graph : Scry.CallGraph) (fn : Wil.Func) :
    Bool :=
  Bool.and (Bool.not (String.startsWith fn.name "static:"))
    (Bool.and (Bool.not (String.eq fn.name "main"))
      (Bool.and (List.isEmpty (Scry.sitesTo graph fn.name))
        (Bool.not (List.any (String.eq fn.name) (Scry.fnptrNames p)))))

/-- The `(function, parameter position)` pairs that are sources because the function is an
exported entry. Positions follow the declaration order; they are only used when the
function is defined in this unit. -/
def Scry.entrySources (p : Wil.Program) (graph : Scry.CallGraph) : List (String × Nat) :=
  Scry.rulePackConcat (fun fn =>
    if Scry.isExportedEntry p graph fn then
      List.map (fun i => (fn.name, i)) (Scry.range (List.length fn.params))
    else .nil) p.funcs

/-- The entry-source positions of one function from the program-wide policy. -/
def Scry.entrySourcesFor (entries : List (String × Nat)) (name : String) : List Nat :=
  List.map (fun p => p.2) (List.filter (fun p => String.eq p.1 name) entries)

-- ## Summaries

structure Scry.Summary where
  name : String
  /-- Tainted parameter positions. -/
  params : List Nat
  retTainted : Bool
  /-- Tainted memory locations and the stores that put the taint there. Memory is
  program-wide: a store in one function must be visible to a load in another, so the
  summary carries locations, not just parameters. -/
  mems : List Scry.MemSeed

def Scry.summaryOf (sums : List Scry.Summary) (name : String) : Scry.Summary :=
  match List.find (fun s => String.eq s.name name) sums with
  | .some s => s
  | .none => Scry.Summary.mk name .nil .false .nil

def Scry.seedSetEq (a b : List Scry.MemSeed) : Bool :=
  Bool.and (List.all (fun m => List.any (fun x =>
      String.eq (Scry.memSeedKey x) (Scry.memSeedKey m)) b) a)
    (List.all (fun m => List.any (fun x =>
      String.eq (Scry.memSeedKey x) (Scry.memSeedKey m)) a) b)

def Scry.summariesEq (a b : List Scry.Summary) : Bool :=
  List.foldr (fun s acc =>
    if acc then
      let t := Scry.summaryOf b s.name;
      if Scry.setEq s.params t.params then
        if Scry.seedSetEq s.mems t.mems then
          Nat.beq (if s.retTainted then 1 else 0) (if t.retTainted then 1 else 0)
        else .false
      else .false
    else .false) .true a

def Scry.totalParams (fs : List Wil.Func) : Nat :=
  List.foldr (fun fn acc => Nat.add acc (List.length fn.params)) 0 fs

def Scry.indexedNats : Nat → List Nat → List (Nat × Nat)
  | _, .nil => .nil
  | i, .cons v vs => List.cons (i, v) (Scry.indexedNats (Nat.succ i) vs)

/-- For a callee, every argument position some caller passes a tainted value at. This
is the slow form (it re-scans every result for every callee); `growSummaries` uses
`paramContribMap`, which builds the taint indexes once. -/
def Scry.paramContributions (graph : Scry.CallGraph) (results : List Scry.FuncResult)
    (callee : String) : List Nat :=
  Scry.concatLists (fun r =>
    Scry.concatLists (fun site =>
      if Bool.and (String.eq site.caller r.fn.name) (String.eq site.callee callee) then
        Scry.concatLists (fun p =>
          if Scry.argTainted r site.node p.2 then List.cons p.1 .nil else .nil)
          (Scry.indexedNats 0 site.args)
      else .nil) graph.sites) results

/-- Add parameter positions to `callee`'s entry in a contribution map (order-preserving
and deterministic). -/
def Scry.contribAdd : List (String × List Nat) → String → List Nat → List (String × List Nat)
  | .nil, callee, ps => List.cons (callee, ps) List.nil
  | .cons p rest, callee, ps =>
    if String.eq p.1 callee then
      List.cons (p.1, List.append p.2 ps) rest
    else List.cons p (Scry.contribAdd rest callee ps)

/-- A result's taint query data: its name, def-use index, taint index, and whether a
`ret` uses a tainted value (the return summary). -/
structure Scry.TaintIdxEntry where
  name : String
  info : Scry.FnInfo
  idx : U64Map (List Nat)
  retTainted : Bool

/-- Build one taint entry per function result (one pass over its taint rows). -/
def Scry.taintEntries (results : List Scry.FuncResult) : List Scry.TaintIdxEntry :=
  List.map (fun r =>
    let idx := Scry.taintIdxOf (Scry.resultTaint r);
    Scry.TaintIdxEntry.mk r.fn.name r.plan.info idx
      (Scry.returnsTaintedIdx r.plan.info idx r.plan.rets)) results

/-- Every callee's tainted argument positions, computed in **one** pass: one taint index
per result, then each call site looks its caller up. The old path called `argTainted`
(which scanned every taint row and every data edge) for every argument of every site of
every callee. -/
def Scry.paramContribFrom (graph : Scry.CallGraph) (idxs : List Scry.TaintIdxEntry) :
    List (String × List Nat) :=
  List.foldl (fun acc site =>
    match List.find (fun e => String.eq e.name site.caller) idxs with
    | .none => acc
    | .some e =>
      let ps := Scry.concatLists (fun p =>
        if Scry.taintAtUseIdx e.info e.idx site.node p.2 then List.cons p.1 List.nil
        else List.nil) (Scry.indexedNats 0 site.args);
      match List.isEmpty ps with
      | .true => acc
      | .false => Scry.contribAdd acc site.callee ps) List.nil graph.sites

def Scry.paramContribMap (graph : Scry.CallGraph) (results : List Scry.FuncResult) :
    List (String × List Nat) :=
  Scry.paramContribFrom graph (Scry.taintEntries results)

def Scry.contribOf (m : List (String × List Nat)) (callee : String) : List Nat :=
  match List.find (fun p => String.eq p.1 callee) m with
  | .none => List.nil
  | .some p => p.2

/-- The call results a function gets from callees that return tainted values. -/
def Scry.retSeedsOf (graph : Scry.CallGraph) (sums : List Scry.Summary)
    (caller : String) : List (Nat × Nat) :=
  Scry.concatLists (fun site =>
    if Bool.and (String.eq site.caller caller)
        (Scry.summaryOf sums site.callee).retTainted then
      match site.result with
      | .some r => List.cons (site.node, r) .nil
      | .none => .nil
    else .nil) graph.sites

/-- Every location any summary knows to be tainted (deduplicated by location). -/
def Scry.allMemSeeds (sums : List Scry.Summary) : List Scry.MemSeed :=
  Scry.dedupSeeds (Scry.concatLists (fun s => s.mems) sums)

/-- The seeds one function's evaluation starts from: every summary's tainted locations
**except the ones this function produces itself** (those are re-derived by its own rules,
which keeps the provenance — a fact seeded as EDB would shadow its derivation). -/
def Scry.seedsFor (sums : List Scry.Summary) (func : String) : List Scry.MemSeed :=
  List.filter (fun m => Bool.not (String.eq m.func func)) (Scry.allMemSeeds sums)

/-- `seedsFor` with the round's deduplicated seed set computed once. -/
def Scry.seedsForAll (all : List Scry.MemSeed) (func : String) : List Scry.MemSeed :=
  List.filter (fun m => Bool.not (String.eq m.func func)) all

/-- Evaluate one function under the current summaries (the unit of the summary
fixpoint). Exposed so a driver can checkpoint between functions for `--timeout`. The
entry sources are the C-ABI policy's parameter seeds for exported entries. -/
def Scry.evalWithEntries (graph : Scry.CallGraph) (pack : Scry.RulePack)
    (pt : Scry.PtResult) (entries : List (String × Nat)) (sums : List Scry.Summary)
    (fn : Wil.Func) : Scry.FuncResult :=
  Scry.evaluateFuncWith fn pack pt (Scry.seedsFor sums fn.name)
    (Scry.summaryOf sums fn.name).params
    (Scry.retSeedsOf graph sums fn.name)
    (Scry.entrySourcesFor entries fn.name)

def Scry.evalWith (graph : Scry.CallGraph) (pack : Scry.RulePack) (pt : Scry.PtResult)
    (sums : List Scry.Summary) (fn : Wil.Func) : Scry.FuncResult :=
  Scry.evalWithEntries graph pack pt .nil sums fn

def Scry.resultsWithEntries (p : Wil.Program) (pack : Scry.RulePack)
    (graph : Scry.CallGraph) (pt : Scry.PtResult) (sums : List Scry.Summary)
    (entries : List (String × Nat)) : List Scry.FuncResult :=
  List.map (Scry.evalWithEntries graph pack pt entries sums) p.funcs

/-- `evalWith` with a precomputed plan (the summary fixpoint prepares every function's
plan once, not once per round). -/
def Scry.evalWithPrepared (graph : Scry.CallGraph) (pt : Scry.PtResult)
    (plan : Scry.FuncPlan) (sums : List Scry.Summary) (fn : Wil.Func) : Scry.FuncResult :=
  Scry.evaluateFuncWithPlan fn plan (Scry.seedsFor sums fn.name)
    (Scry.summaryOf sums fn.name).params
    (Scry.retSeedsOf graph sums fn.name)

/-- `evalWithPrepared` with the round's deduplicated memory-seed set supplied by the
driver (computed once per round instead of once per function). -/
def Scry.evalWithPreparedM (graph : Scry.CallGraph) (pt : Scry.PtResult)
    (plan : Scry.FuncPlan) (sums : List Scry.Summary) (allMems : List Scry.MemSeed)
    (fn : Wil.Func) : Scry.FuncResult :=
  Scry.evaluateFuncWithPlan fn plan (Scry.seedsForAll allMems fn.name)
    (Scry.summaryOf sums fn.name).params
    (Scry.retSeedsOf graph sums fn.name)

def Scry.resultsWith (p : Wil.Program) (pack : Scry.RulePack) (graph : Scry.CallGraph)
    (pt : Scry.PtResult) (sums : List Scry.Summary) : List Scry.FuncResult :=
  Scry.resultsWithEntries p pack graph pt sums .nil

/-- Prepare every function's plan once, aligned with `p.funcs`, with the exported-entry
parameter sources (`Scry.entrySources`) each function's `evalWithEntries` would use. -/
def Scry.prepareAllWithEntries (p : Wil.Program) (pack : Scry.RulePack) (pt : Scry.PtResult)
    (entries : List (String × Nat)) : List Scry.FuncPlan :=
  List.map (fun fn => Scry.prepareFuncWith fn pack pt (Scry.entrySourcesFor entries fn.name))
    p.funcs

/-- Prepare every function's plan once, aligned with `p.funcs`. -/
def Scry.prepareAll (p : Wil.Program) (pack : Scry.RulePack) (pt : Scry.PtResult) :
    List Scry.FuncPlan :=
  List.map (fun fn => Scry.prepareFunc fn pack pt) p.funcs

/-- Grow every summary from one round's results: the argument-taint contributions the
results expose and the return flags, plus the tainted memory locations. -/
def Scry.growSummaries (p : Wil.Program) (graph : Scry.CallGraph)
    (prev : List Scry.Summary) (results : List Scry.FuncResult) : List Scry.Summary :=
  let mems := Scry.dedupSeeds (Scry.concatLists (fun r => Scry.resultMemSeeds r) results);
  let entries := Scry.taintEntries results;
  let contribs := Scry.paramContribFrom graph entries;
  List.map (fun fn =>
    let old := Scry.summaryOf prev fn.name;
    let contrib := Scry.contribOf contribs fn.name;
    let ret := match List.find (fun e => String.eq e.name fn.name) entries with
      | .some e => e.retTainted
      | .none => (.false : Bool);
    Scry.Summary.mk fn.name (Scry.unionNat old.params contrib)
      (Bool.or old.retTainted ret) (Scry.dedupSeeds (List.append old.mems mems))) p.funcs

/-- One summary round: evaluate every function under `prev`, then grow every summary
with the argument-taint contributions the results expose and the return flags. -/
def Scry.stepSummariesWithEntries (p : Wil.Program) (pack : Scry.RulePack)
    (graph : Scry.CallGraph) (pt : Scry.PtResult) (prev : List Scry.Summary)
    (entries : List (String × Nat)) : List Scry.Summary :=
  Scry.growSummaries p graph prev (Scry.resultsWithEntries p pack graph pt prev entries)

def Scry.stepSummaries (p : Wil.Program) (pack : Scry.RulePack) (graph : Scry.CallGraph)
    (pt : Scry.PtResult) (prev : List Scry.Summary) : List Scry.Summary :=
  Scry.stepSummariesWithEntries p pack graph pt prev .nil

partial def Scry.summaryLoopWithEntries (p : Wil.Program) (pack : Scry.RulePack)
    (graph : Scry.CallGraph) (pt : Scry.PtResult) (fuel : Nat)
    (sums : List Scry.Summary) (entries : List (String × Nat)) : List Scry.Summary :=
  match fuel with
  | .zero => sums
  | .succ k =>
    let next := Scry.stepSummariesWithEntries p pack graph pt sums entries;
    match Scry.summariesEq next sums with
    | .true => next
    | .false => Scry.summaryLoopWithEntries p pack graph pt k next entries

partial def Scry.summaryLoop (p : Wil.Program) (pack : Scry.RulePack) (graph : Scry.CallGraph)
    (pt : Scry.PtResult) (fuel : Nat) (sums : List Scry.Summary) : List Scry.Summary :=
  Scry.summaryLoopWithEntries p pack graph pt fuel sums .nil

-- ## The program result

structure Scry.ProgramResult where
  results : List Scry.FuncResult
  summaries : List Scry.Summary
  graph : Scry.CallGraph
  /-- The points-to solution the memory rows came from. -/
  pointsTo : Scry.PtResult
  /-- Memory diagnostics (unknown target, use after free, unresolved indirect call). -/
  warnings : List Scry.MemWarning
  /-- Findings of `kind memory` pack rules (the CWE-416 lifetime rule). -/
  memoryFindings : List Scry.RuleFinding

def Scry.findResult (pr : Scry.ProgramResult) (name : String) : Option Scry.FuncResult :=
  List.find (fun r => String.eq r.fn.name name) pr.results

/-- Deduplicate diagnostics (a function is evaluated once per summary round only in the
final pass, but be defensive). -/
def Scry.memWarnKey (w : Scry.MemWarning) : String :=
  (Scry.MemWarnKind.show w.kind) ++ "|" ++ w.func ++ "|" ++ Nat.repr w.point ++ "|" ++ w.detail

def Scry.dedupWarnings (ws : List Scry.MemWarning) : List Scry.MemWarning :=
  List.foldl (fun acc w =>
    match List.any (fun x => String.eq (Scry.memWarnKey x) (Scry.memWarnKey w)) acc with
    | .true => acc
    | .false => List.append acc (.cons w .nil)) .nil ws

/-- One unmodelled-external diagnostic for a call: an external the unit does not define,
with no model entry, and with a pointer result or argument, so its memory effect is
genuinely unknown. The warning is attached to the call point. A call to a function the
unit defines is not external (`Wil.findFunc` is the discriminator), and a modelled call
has a known effect, so neither warns here. -/
def Scry.unmodelledWarningsOf (p : Wil.Program) (r : Scry.FuncResult) : List Scry.MemWarning :=
  let g := r.plan.info.g;
  Scry.rulePackConcat (fun n =>
    match Scry.nodeStmt g n with
    | .some (.call res (.direct name) args _) =>
      match Wil.findFunc p name with
      | .some _ => .nil
      | .none =>
        if Scry.Models.isModelled name then .nil
        else
          let pointerArg := List.any (fun v => Scry.ptrLike v.ty) args;
          let pointerRet := match res with
            | .some v => Scry.ptrLike v.ty
            | .none => (.false : Bool);
          match Bool.or pointerArg pointerRet with
          | .false => .nil
          | .true => List.cons (Scry.memWarning Scry.MemWarnKind.unmodelledExternal
              r.fn.name n ("call to unmodelled external " ++ name
                ++ ": result and memory effects are unknown")) .nil
    | _ => .nil) (Scry.range g.count)

/-- The lifetime rule supersedes the old points-to `use-after-free` warning: once a
`kind memory` rule is enabled its finding is the diagnostic, so do not print both. -/
def Scry.keepMemWarning (hasLifetime : Bool) (w : Scry.MemWarning) : Bool :=
  match w.kind with
  | .useAfterFree => Bool.not hasLifetime
  | _ => .true

/-- Analyse a program: points-to first (the memory model every later stage uses), then the
summary fixpoint, then one final evaluation per function. The pack gains the missing
model rule descriptors, so a model-only sink (`execl`, `sprintf`, `read`'s bound) has a
rule id even when the textual pack does not repeat it. `entryMode` enables the C-ABI
policy that seeds the parameters of exported entries; the library/old API passes
`false` through `Scry.analyze`. `maxRounds` bounds the points-to fixpoint (a partial
result when it is hit). -/
def Scry.analyzeEntriesBounded (p : Wil.Program) (pack0 : Scry.RulePack)
    (entryMode : Bool) (maxRounds : Option Nat) : Scry.ProgramResult :=
  let pack := Scry.RulePack.withModels pack0;
  let pt := Scry.pointsToBounded p maxRounds;
  let graph := Scry.callGraph p pt;
  let entries := match entryMode with
    | .true => Scry.entrySources p graph
    | .false => (.nil : List (String × Nat));
  let sums0 := List.map (fun fn => Scry.Summary.mk fn.name .nil .false .nil) p.funcs;
  let fuel := Nat.add 8 (Nat.add (Nat.add (List.length p.funcs) (Scry.totalParams p.funcs))
    (Scry.ptLocCount pt));
  let sums := Scry.summaryLoopWithEntries p pack graph pt fuel sums0 entries;
  let results := Scry.resultsWithEntries p pack graph pt sums entries;
  let hasLifetime : Bool := match pack.memoryRuleFor "use-after-free" with
    | .some _ => .true
    | .none => .false;
  let bounds := Scry.boundsCheck p pt pack results;
  let warnings := Scry.dedupWarnings (List.append
    (List.filter (Scry.keepMemWarning hasLifetime)
      (List.append
        (Scry.concatLists (fun r => r.plan.memWarnings) results)
        (Scry.concatLists (fun r => Scry.unmodelledWarningsOf p r) results)))
    bounds.warnings);
  let memoryFindings := List.append (Scry.useAfterFreeCheck p pt pack) bounds.findings;
  Scry.ProgramResult.mk results sums graph pt warnings memoryFindings

/-- The library analysis: no exported-entry policy, the historical round bound. -/
def Scry.analyze (p : Wil.Program) (pack : Scry.RulePack) : Scry.ProgramResult :=
  Scry.analyzeEntriesBounded p pack .false .none

/-- The C-ABI analysis: parameters of exported entry functions are sources. -/
def Scry.analyzeC (p : Wil.Program) (pack : Scry.RulePack) : Scry.ProgramResult :=
  Scry.analyzeEntriesBounded p pack .true .none

/-- The bounded analysis with the C-ABI entry policy (the `scry taint` driver uses the
staged loop in `Scry.TaintCmd`; this is the library-level equivalent). -/
def Scry.analyzeEntries (p : Wil.Program) (pack : Scry.RulePack)
    (entryMode : Bool) : Scry.ProgramResult :=
  Scry.analyzeEntriesBounded p pack entryMode .none

/-- The default analysis with an explicit points-to round bound. -/
def Scry.analyzeBounded (p : Wil.Program) (pack : Scry.RulePack)
    (maxRounds : Option Nat) : Scry.ProgramResult :=
  Scry.analyzeEntriesBounded p pack .false maxRounds

-- ## Stitching paths across calls

/-- The parameter position of a register in a plan. -/
def Scry.paramPosOf (plan : Scry.FuncPlan) (var : Nat) : Option Nat :=
  match List.find (fun p => Nat.beq p.2 var) plan.params with
  | .none => .none
  | .some p => .some p.1

/-- The tainted definition reaching a use point: a taint fact `(d, v)` with a `flow`
edge `d -> u` for `v`. (The engine's `tainted` also holds use points, so the edge is
what selects a definition.) -/
def Scry.defReaching (r : Scry.FuncResult) (u v : Nat) : Option Nat :=
  match List.find (fun p => Bool.and (Nat.beq p.2 v)
      (Scry.flowHasVar r.plan.info p.1 u v)) (Scry.resultTaint r) with
  | .none => .none
  | .some p => .some p.1

/-- A callee's path to its returned value: a tainted definition reaching a `ret x`, then
the return point. Returns `[]` when no return is tainted. -/
def Scry.returnChain (r : Scry.FuncResult) : List Scry.PathNode :=
  let st := match r.state with
    | .none => Scry.State.empty
    | .some s => s;
  match List.find (fun p => Scry.taintAtUse r.plan.info (Scry.resultTaint r) p.1 p.2)
      r.plan.rets with
  | .none => .nil
  | .some p =>
    match Scry.defReaching r p.1 p.2 with
    | .none => .nil
    | .some d =>
      List.append (Scry.chainToDef r.fn.name r.plan.seeds st d p.2)
        (List.cons (Scry.PathNode.mk r.fn.name p.1 p.2 Scry.PathKind.returnValue) .nil)

/-- A caller path to the argument at `pos` of a call site, if one is tainted. -/
def Scry.argPath (r : Scry.FuncResult) (site : Scry.CallSite) (pos : Nat) :
    Option (List Scry.PathNode) :=
  match Wil.listNth site.args pos with
  | .none => .none
  | .some v =>
    if Scry.argTainted r site.node v then
      let st := match r.state with
        | .none => Scry.State.empty
        | .some s => s;
      match Scry.defReaching r site.node v with
      | .none => .none
      | .some d =>
        .some (List.append (Scry.chainToDef r.fn.name r.plan.seeds st d v)
          (List.cons (Scry.PathNode.mk r.fn.name site.node v Scry.PathKind.call) .nil))
    else .none

/-- Find a caller that passes taint into parameter `pos` of `callee`. -/
partial def Scry.findParamSourceIn (callee : String) (pos : Nat) :
    List (Scry.FuncResult × Scry.CallSite) → Option (Scry.FuncResult × Scry.CallSite)
  | .nil => .none
  | .cons pair rest =>
    if String.eq pair.2.callee callee then
      match Wil.listNth pair.2.args pos with
      | .some v =>
        if Scry.argTainted pair.1 pair.2.node v then .some pair
        else Scry.findParamSourceIn callee pos rest
      | .none => Scry.findParamSourceIn callee pos rest
    else Scry.findParamSourceIn callee pos rest

/-- Find a caller that passes taint into parameter `pos` of `callee`. -/
def Scry.findParamSource (pr : Scry.ProgramResult) (callee : String) (pos : Nat) :
    Option (Scry.FuncResult × Scry.CallSite) :=
  Scry.findParamSourceIn callee pos
    (Scry.concatLists (fun (r : Scry.FuncResult) =>
      List.map (fun (site : Scry.CallSite) => (r, site)) (Scry.sitesFrom pr.graph r.fn.name))
      pr.results)

/-- Replace a parameter or return seed in `path` by the interprocedural evidence behind
it, recursively. `stack` is the set of `(function, point)` roots already expanded, so
recursion becomes a `recursion` node instead of a loop. -/
partial def Scry.extendPath (pr : Scry.ProgramResult) (stack : List (String × Nat))
    (fuel : Nat) (fr : Scry.FuncResult) (path : List Scry.PathNode) : List Scry.PathNode :=
  match fuel with
  | .zero => path
  | .succ k =>
    match path with
    | .nil => .nil
    | .cons root rest =>
      let seen := List.any (fun q => Bool.and (String.eq q.1 fr.fn.name) (Nat.beq q.2 root.point))
        stack;
      let stack' := List.cons (fr.fn.name, root.point) stack;
      if seen then List.cons (Scry.PathNode.mk fr.fn.name root.point root.var Scry.PathKind.recursion) rest
      else match root.kind with
        | .param =>
          match Scry.paramPosOf fr.plan root.var with
          | .none => path
          | .some pos =>
            match Scry.findParamSource pr fr.fn.name pos with
            | .none => path
            | .some pair =>
              match Scry.argPath pair.1 pair.2 pos with
              | .none => path
              | .some callerPath =>
                let callerPath := Scry.extendPath pr stack' k pair.1 callerPath;
                List.append callerPath path
        | .returnSeed =>
          match Scry.siteAt pr.graph fr.fn.name root.point with
          | .none => path
          | .some site =>
            match Scry.findResult pr site.callee with
            | .none => path
            | .some callee =>
              match Scry.returnChain callee with
              | .nil => path
              | chain =>
                let chain := Scry.extendPath pr stack' k callee chain;
                List.append chain path
        | .store =>
          /-- A memory seed produced by another function: expand it into that function's
          chain for the value stored at its store point. -/
          match Scry.findResult pr root.func with
          | .none => path
          | .some producer =>
            if String.eq producer.fn.name fr.fn.name then path
            else match List.find (fun m => Nat.beq m.node root.point) producer.plan.mstores with
              | .none => path
              | .some m =>
                match Scry.defReaching producer root.point m.var with
                | .none => path
                | .some d =>
                  let pst := match producer.state with
                    | .none => Scry.State.empty
                    | .some s2 => s2;
                  let chain := Scry.chainToDef producer.fn.name producer.plan.seeds pst d m.var;
                  let chain := Scry.extendPath pr stack' k producer chain;
                  List.append chain path
        | _ => path

-- ## Findings

def Scry.findingKeyLess (a b : Scry.RuleFinding) : Bool :=
  if String.lt a.func b.func then .true
  else if String.eq a.func b.func then
    if Nat.lt a.sink b.sink then .true
    else if Nat.beq a.sink b.sink then String.lt a.rule b.rule
    else .false
  else .false

def Scry.insertRuleFinding (f : Scry.RuleFinding) (fs : List Scry.RuleFinding) : List Scry.RuleFinding :=
  match fs with
  | .nil => List.cons f .nil
  | .cons x xs => match Scry.findingKeyLess f x with
    | .true => List.cons f fs
    | .false => List.cons x (Scry.insertRuleFinding f xs)

def Scry.sortRuleFindings (fs : List Scry.RuleFinding) : List Scry.RuleFinding :=
  List.foldr (fun f acc => Scry.insertRuleFinding f acc) .nil fs

/-- All findings of an analysed program, with interprocedural paths. -/
def Scry.programFindings (pr : Scry.ProgramResult) : List Scry.RuleFinding :=
  Scry.sortRuleFindings (List.append pr.memoryFindings
    (Scry.concatLists (fun r =>
      List.map (fun f =>
        { f with path := Scry.extendPath pr .nil 16 r f.path }) (Scry.resultFindings r))
      pr.results))

/-- The findings of one function (its intraprocedural part; the path is not stitched). -/
def Scry.funcFindings (pr : Scry.ProgramResult) (name : String) : List Scry.RuleFinding :=
  match Scry.findResult pr name with
  | .none => .nil
  | .some r => Scry.resultFindings r

/-- The rule ids that fire on this program, in pack order. -/
def Scry.ruleIds (p : Wil.Program) (pack : Scry.RulePack) : List String :=
  let pr := Scry.analyze p pack;
  List.foldr (fun rule acc =>
    if List.any (fun f => String.eq f.rule rule) (Scry.programFindings pr) then
      List.cons rule acc
    else acc) .nil (List.map Scry.PackRule.id pack.rules)
