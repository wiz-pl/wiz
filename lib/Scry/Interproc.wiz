import Scry.RuleTaint
import Scry.Analysis
import Scry.PointsTo
import Scry.Rules
import Text
/-!
# Scry.Interproc

**Interprocedural taint for direct and resolved indirect calls** (`import Scry.Interproc`):
a call graph from `Wil`, argument -> parameter taint, return-value summaries, and a
summary fixpoint that handles recursion.

An indirect call (`fp(x)`, `(*fp)(x)`) is resolved by `Scry.PointsTo` to the functions its
function-pointer value may hold. Every resolved target becomes a call site (so argument
taint reaches its parameter and its return value taints the result), and a call whose
target set is empty or contains a non-function/unknown location is recorded as
**unknown**: its arguments and result are not propagated, and `Scry.RuleTaint` reports an
`unknown-indirect` warning rather than a silent false negative.

## The model

Summaries are **1-call-site context-sensitive**: a function is evaluated once per call
site that invokes it (`Scry.siteCtx caller point`), and a function with no caller in the
unit is evaluated in the `@root` context with its pointer parameters `unknown`. So the
same callee called with a source at one site and a constant at another has a tainted
parameter/return only in the source site's summary. A recursive call at the same site
shares that site's context (the k=1 limit; a deeper call string is not modelled).

For a direct call `r = f(a0, …, an)` at point `n`:

* **argument -> parameter.** If `ai` is tainted at `n` (a tainted definition reaches the
  call), then parameter `i` of `f` is marked tainted **in the callee context for this
  site**. A tainted parameter is seeded at `f`'s entry as an extra definition
  (`Scry.Analysis.fnInfoWith`), so the intraprocedural rules carry it from there.
* **return value.** A function context summarises to `retTainted` when a `ret x` uses a
  tainted `x`. At a call site, the result register is seeded with `retsrc` only from the
  callee context of **that** site.
* **memory.** Tainted locations are summaries too. Stack/heap locations allocated inside
  a context are context-qualified, so two callers do not share the callee's locals;
  caller objects passed as arguments keep the caller's locations and stay visible to any
  callee that receives them.
* **recursion.** Both summaries are monotone, so a round-robin fixpoint over every active
  `(context, function)` pair terminates.

The fixpoint uses `Scry.RuleTaint.evaluateFunc`, which is one Datalog evaluation per
context per round. The final results are recomputed once with the stable summaries; the
findings and paths are read from those. A sink reached in several contexts is reported
once (same rule/function/sink/argument), with the first deterministic context's path.

## Paths

`Scry.programFindings` returns findings whose path is stitched across calls:
a tainted parameter is replaced by the caller's path to the argument, a `retsrc` seed by
the callee's path to its return. The walk is bounded (fuel) and cycle-guarded; a cycle
leaves a `recursion` node instead of looping. This path is **evidence**, not a proof:
`Scry.Certify` checks the Datalog derivation and reports its EDB axioms, which include
the parameter seeds the path walk justifies interprocedurally.
-/

-- ## The call graph

structure Scry.CallSite where
  /-- The caller's 1-call-site context. -/
  ctx : String
  caller : String
  node : Nat
  callee : String
  args : List Nat
  result : Option Nat

structure Scry.CallGraph where
  sites : List Scry.CallSite
  /-- `(context, caller, point)` of every call through a function value. -/
  indirect : List (String × String × Nat)

def Scry.siteOfCall (ctx : String) (fn : Wil.Func) (pt : Scry.PtResult) (n : Nat)
    (r : Option Wil.Var) (args : List Wil.Var) (name : String) : Scry.CallSite :=
  Scry.CallSite.mk ctx fn.name n name
    (List.map (fun v => v.index) args)
    (match r with
      | .some v => .some v.index
      | .none => .none)

/-- The direct and resolved-indirect call sites of a function in a context. -/
def Scry.sitesOfFunc (fn : Wil.Func) (pt : Scry.PtResult) (ctx : String) : List Scry.CallSite :=
  let g := Scry.flatten fn;
  Scry.concatLists (fun n =>
    match Scry.nodeStmt g n with
    | .none => .nil
    | .some s => match s with
      | .call r callee args _ => match callee with
        | .direct name => List.cons (Scry.siteOfCall ctx fn pt n r args name) .nil
        | .indirect _ =>
          List.map (fun name => Scry.siteOfCall ctx fn pt n r args name)
            (Scry.indirectAt pt ctx fn.name n).names
      | _ => .nil) (Scry.range g.count)

def Scry.indirectOfFunc (fn : Wil.Func) (ctx : String) : List (String × String × Nat) :=
  let g := Scry.flatten fn;
  Scry.concatLists (fun n =>
    match Scry.nodeStmt g n with
    | .none => .nil
    | .some s => match s with
      | .call _ (.indirect _) _ _ => List.cons (ctx, fn.name, n) .nil
      | _ => .nil) (Scry.range g.count)

/-- The direct-call graph of a program plus every resolved indirect target; the unresolved
indirect calls are listed in `indirect` (and warned about). Every active context is
visited, so a call site records the context its caller was analysed in. -/
def Scry.callGraph (p : Wil.Program) (pt : Scry.PtResult) : Scry.CallGraph :=
  let pairs := pt.ctxs;
  let sites := Scry.concatLists (fun (k : Scry.CtxKey) =>
    match Wil.findFunc p k.func with
    | .none => .nil
    | .some fn => Scry.sitesOfFunc fn pt k.ctx) pairs;
  let indirect := Scry.concatLists (fun (k : Scry.CtxKey) =>
    match Wil.findFunc p k.func with
    | .none => .nil
    | .some fn => Scry.indirectOfFunc fn k.ctx) pairs;
  Scry.CallGraph.mk sites indirect

def Scry.siteAt (g : Scry.CallGraph) (ctx : String) (caller : String) (node : Nat) :
    Option Scry.CallSite :=
  List.find (fun s => Bool.and (String.eq s.ctx ctx)
    (Bool.and (String.eq s.caller caller) (Nat.beq s.node node))) g.sites

/-- The sites whose **callee context** is `ctx` (`Scry.siteCtx caller point`). -/
def Scry.sitesTo (g : Scry.CallGraph) (ctx : String) (callee : String) : List Scry.CallSite :=
  List.filter (fun s => Bool.and (String.eq (Scry.siteCtx s.caller s.node) ctx)
    (String.eq s.callee callee)) g.sites

def Scry.sitesFrom (g : Scry.CallGraph) (ctx : String) (caller : String) : List Scry.CallSite :=
  List.filter (fun s => Bool.and (String.eq s.ctx ctx) (String.eq s.caller caller)) g.sites

-- ## Summaries

structure Scry.Summary where
  /-- The 1-call-site context this summary is for. -/
  ctx : String
  name : String
  /-- Tainted parameter positions. -/
  params : List Nat
  retTainted : Bool
  /-- Tainted memory locations and the stores that put the taint there. Memory is
  program-wide: a store in one function must be visible to a load in another, so the
  summary carries locations, not just parameters. Locations allocated inside a context are
  context-qualified, so two callers do not share the callee's locals. -/
  mems : List Scry.MemSeed

def Scry.summaryOf (sums : List Scry.Summary) (ctx : String) (name : String) : Scry.Summary :=
  match List.find (fun s => Bool.and (String.eq s.ctx ctx) (String.eq s.name name)) sums with
  | .some s => s
  | .none => Scry.Summary.mk ctx name .nil .false .nil

def Scry.seedSetEq (a b : List Scry.MemSeed) : Bool :=
  Bool.and (List.all (fun m => List.any (fun x =>
      String.eq (Scry.memSeedKey x) (Scry.memSeedKey m)) b) a)
    (List.all (fun m => List.any (fun x =>
      String.eq (Scry.memSeedKey x) (Scry.memSeedKey m)) a) b)

def Scry.summaryEq (a b : Scry.Summary) : Bool :=
  if String.eq a.ctx b.ctx then
    if String.eq a.name b.name then
      if Scry.setEq a.params b.params then
        if Scry.seedSetEq a.mems b.mems then
          Nat.beq (if a.retTainted then 1 else 0) (if b.retTainted then 1 else 0)
        else .false
      else .false
    else .false
  else .false

def Scry.summariesEq (a b : List Scry.Summary) : Bool :=
  Bool.and (List.all (fun s =>
      List.any (fun t => Scry.summaryEq s t) b) a)
    (List.all (fun t =>
      List.any (fun s => Scry.summaryEq s t) a) b)

def Scry.totalParams (fs : List Wil.Func) : Nat :=
  List.foldr (fun fn acc => Nat.add acc (List.length fn.params)) 0 fs

def Scry.indexedNats : Nat → List Nat → List (Nat × Nat)
  | _, .nil => .nil
  | i, .cons v vs => List.cons (i, v) (Scry.indexedNats (Nat.succ i) vs)

/-- For a callee context, every argument position a caller at that call site passes a
tainted value at. Only the caller result for that site's own context counts, so a tainted
argument at one call site does not taint the callee in another site's context. -/
def Scry.paramContributions (graph : Scry.CallGraph) (results : List Scry.FuncResult)
    (calleeCtx : String) (callee : String) : List Nat :=
  Scry.concatLists (fun r =>
    Scry.concatLists (fun site =>
      if Bool.and (String.eq site.ctx r.plan.ctx)
          (Bool.and (String.eq site.caller r.fn.name)
            (Bool.and (String.eq (Scry.siteCtx site.caller site.node) calleeCtx)
              (String.eq site.callee callee))) then
        Scry.concatLists (fun p =>
          if Scry.argTainted r site.node p.2 then List.cons p.1 .nil else .nil)
          (Scry.indexedNats 0 site.args)
      else .nil) graph.sites) results

/-- The call results a function in `ctx` gets from callees that return tainted values, in
the callee's own call-site context. -/
def Scry.retSeedsOf (graph : Scry.CallGraph) (sums : List Scry.Summary)
    (ctx : String) (caller : String) : List (Nat × Nat) :=
  Scry.concatLists (fun site =>
    if Bool.and (String.eq site.ctx ctx) (String.eq site.caller caller) then
      if (Scry.summaryOf sums (Scry.siteCtx site.caller site.node) site.callee).retTainted then
        match site.result with
        | .some r => List.cons (site.node, r) .nil
        | .none => .nil
      else .nil
    else .nil) graph.sites

/-- Every location any summary knows to be tainted (deduplicated by location). -/
def Scry.allMemSeeds (sums : List Scry.Summary) : List Scry.MemSeed :=
  Scry.dedupSeeds (Scry.concatLists (fun s => s.mems) sums)

/-- The seeds one function context's evaluation starts from: every summary's tainted
locations **except the ones this context produces itself** (those are re-derived by its
own rules, which keeps the provenance — a fact seeded as EDB would shadow its derivation).
A seed from another context of the same function is kept: its locations are different
unless the shared location really is caller-owned memory. -/
def Scry.seedsFor (sums : List Scry.Summary) (ctx : String) (func : String) :
    List Scry.MemSeed :=
  List.filter (fun m => Bool.not (Bool.and (String.eq m.ctx ctx) (String.eq m.func func)))
    (Scry.allMemSeeds sums)

def Scry.resultsWith (p : Wil.Program) (pack : Scry.RulePack) (graph : Scry.CallGraph)
    (pt : Scry.PtResult) (sums : List Scry.Summary) : List Scry.FuncResult :=
  Scry.ptFilterMap (fun (k : Scry.CtxKey) =>
    match Wil.findFunc p k.func with
    | .none => .none
    | .some fn =>
      .some (Scry.evaluateFunc fn pack pt k.ctx (Scry.seedsFor sums k.ctx fn.name)
        (Scry.summaryOf sums k.ctx fn.name).params
        (Scry.retSeedsOf graph sums k.ctx fn.name))) pt.ctxs

/-- One summary round: evaluate every context under `prev`, then grow every summary with
the argument-taint contributions its **own** call site exposes and the return flags. A
contribution at one site only grows the callee summary for that site's context. -/
def Scry.stepSummaries (p : Wil.Program) (pack : Scry.RulePack) (graph : Scry.CallGraph)
    (pt : Scry.PtResult) (prev : List Scry.Summary) : List Scry.Summary :=
  let results := Scry.resultsWith p pack graph pt prev;
  let mems := Scry.dedupSeeds (Scry.concatLists (fun r => Scry.resultMemSeeds r) results);
  Scry.ptFilterMap (fun (k : Scry.CtxKey) =>
    match Wil.findFunc p k.func with
    | .none => .none
    | .some fn =>
      let old := Scry.summaryOf prev k.ctx fn.name;
      let contrib := Scry.paramContributions graph results k.ctx fn.name;
      let ret := match List.find (fun r => Bool.and (String.eq r.plan.ctx k.ctx)
          (String.eq r.fn.name fn.name)) results with
        | .some r => Scry.returnsTainted r
        | .none => (.false : Bool);
      .some (Scry.Summary.mk k.ctx fn.name (Scry.unionNat old.params contrib)
        (Bool.or old.retTainted ret) (Scry.dedupSeeds (List.append old.mems mems)))) pt.ctxs

partial def Scry.summaryLoop (p : Wil.Program) (pack : Scry.RulePack) (graph : Scry.CallGraph)
    (pt : Scry.PtResult) (fuel : Nat) (sums : List Scry.Summary) : List Scry.Summary :=
  match fuel with
  | .zero => sums
  | .succ k =>
    let next := Scry.stepSummaries p pack graph pt sums;
    match Scry.summariesEq next sums with
    | .true => next
    | .false => Scry.summaryLoop p pack graph pt k next

-- ## The program result

structure Scry.ProgramResult where
  results : List Scry.FuncResult
  summaries : List Scry.Summary
  graph : Scry.CallGraph
  /-- The points-to solution the memory rows came from. -/
  pointsTo : Scry.PtResult
  /-- Memory diagnostics (unknown target, use after free, unresolved indirect call). -/
  warnings : List Scry.MemWarning

def Scry.findResult (pr : Scry.ProgramResult) (ctx : String) (name : String) :
    Option Scry.FuncResult :=
  List.find (fun r => Bool.and (String.eq r.plan.ctx ctx) (String.eq r.fn.name name)) pr.results

/-- Deduplicate diagnostics (a context may report the same warning at the same point). -/
def Scry.memWarnKey (w : Scry.MemWarning) : String :=
  (Scry.MemWarnKind.show w.kind) ++ "|" ++ w.func ++ "|" ++ Nat.repr w.point ++ "|" ++ w.detail

def Scry.dedupWarnings (ws : List Scry.MemWarning) : List Scry.MemWarning :=
  List.foldl (fun acc w =>
    match List.any (fun x => String.eq (Scry.memWarnKey x) (Scry.memWarnKey w)) acc with
    | .true => acc
    | .false => List.append acc (.cons w .nil)) .nil ws

/-- Analyse a program: points-to first (the memory model every later stage uses), then the
summary fixpoint over every active context, then one final evaluation per context. -/
def Scry.analyze (p : Wil.Program) (pack : Scry.RulePack) : Scry.ProgramResult :=
  let pt := Scry.pointsTo p;
  let graph := Scry.callGraph p pt;
  let sums0 := List.map (fun (k : Scry.CtxKey) => Scry.Summary.mk k.ctx k.func .nil .false .nil)
    pt.ctxs;
  let fuel := Nat.add 8 (Nat.add (Nat.add (List.length pt.ctxs) (List.length pt.ctxs))
    (Nat.mul (Scry.totalParams p.funcs) (Nat.succ (List.length pt.ctxs))));
  let sums := Scry.summaryLoop p pack graph pt fuel sums0;
  let results := Scry.resultsWith p pack graph pt sums;
  let warnings := Scry.dedupWarnings (Scry.concatLists (fun r => r.plan.memWarnings) results);
  Scry.ProgramResult.mk results sums graph pt warnings

-- ## Stitching paths across calls

/-- The parameter position of a register in a plan. -/
def Scry.paramPosOf (plan : Scry.FuncPlan) (var : Nat) : Option Nat :=
  match List.find (fun p => Nat.beq p.2 var) plan.params with
  | .none => .none
  | .some p => .some p.1

/-- The tainted definition reaching a use point: a taint fact `(d, v)` with a `flow`
edge `d -> u` for `v`. (The engine's `tainted` also holds use points, so the edge is
what selects a definition.) -/
def Scry.defReaching (r : Scry.FuncResult) (u v : Nat) : Option Nat :=
  match List.find (fun p => Bool.and (Nat.beq p.2 v)
      (Scry.flowHasVar r.plan.info p.1 u v)) (Scry.resultTaint r) with
  | .none => .none
  | .some p => .some p.1

/-- A callee's path to its returned value: a tainted definition reaching a `ret x`, then
the return point. Returns `[]` when no return is tainted. -/
def Scry.returnChain (r : Scry.FuncResult) : List Scry.PathNode :=
  let st := match r.state with
    | .none => Scry.State.empty
    | .some s => s;
  match List.find (fun p => Scry.taintAtUse r.plan.info (Scry.resultTaint r) p.1 p.2)
      r.plan.rets with
  | .none => .nil
  | .some p =>
    match Scry.defReaching r p.1 p.2 with
    | .none => .nil
    | .some d =>
      List.append (Scry.chainToDef r.fn.name r.plan.ctx r.plan.seeds st d p.2)
        (List.cons (Scry.PathNode.mk r.fn.name r.plan.ctx p.1 p.2 Scry.PathKind.returnValue) .nil)

/-- A caller path to the argument at `pos` of a call site, if one is tainted. -/
def Scry.argPath (r : Scry.FuncResult) (site : Scry.CallSite) (pos : Nat) :
    Option (List Scry.PathNode) :=
  match Wil.listNth site.args pos with
  | .none => .none
  | .some v =>
    if Scry.argTainted r site.node v then
      let st := match r.state with
        | .none => Scry.State.empty
        | .some s => s;
      match Scry.defReaching r site.node v with
      | .none => .none
      | .some d =>
        .some (List.append (Scry.chainToDef r.fn.name r.plan.ctx r.plan.seeds st d v)
          (List.cons (Scry.PathNode.mk r.fn.name r.plan.ctx site.node v Scry.PathKind.call) .nil))
    else .none

/-- Find a caller at the call site that opened `calleeCtx` passing taint into parameter
`pos`. The caller must also be the result's own context, so the evidence is the analysis
that actually produced the parameter seed. -/
partial def Scry.findParamSourceIn (calleeCtx : String) (callee : String) (pos : Nat) :
    List (Scry.FuncResult × Scry.CallSite) → Option (Scry.FuncResult × Scry.CallSite)
  | .nil => .none
  | .cons pair rest =>
    if Bool.and (String.eq pair.2.callee callee)
        (Bool.and (String.eq (Scry.siteCtx pair.2.caller pair.2.node) calleeCtx)
          (String.eq pair.2.ctx pair.1.plan.ctx)) then
      match Wil.listNth pair.2.args pos with
      | .some v =>
        if Scry.argTainted pair.1 pair.2.node v then .some pair
        else Scry.findParamSourceIn calleeCtx callee pos rest
      | .none => Scry.findParamSourceIn calleeCtx callee pos rest
    else Scry.findParamSourceIn calleeCtx callee pos rest

/-- Find a caller that passes taint into parameter `pos` of `callee` in `calleeCtx`. -/
def Scry.findParamSource (pr : Scry.ProgramResult) (calleeCtx : String) (callee : String)
    (pos : Nat) : Option (Scry.FuncResult × Scry.CallSite) :=
  Scry.findParamSourceIn calleeCtx callee pos
    (Scry.concatLists (fun (r : Scry.FuncResult) =>
      List.map (fun (site : Scry.CallSite) => (r, site))
        (Scry.sitesFrom pr.graph r.plan.ctx r.fn.name))
      pr.results)

/-- Replace a parameter or return seed in `path` by the interprocedural evidence behind
it, recursively. `stack` is the set of `(function, point)` roots already expanded, so
recursion becomes a `recursion` node instead of a loop. -/
partial def Scry.extendPath (pr : Scry.ProgramResult) (stack : List (String × Nat))
    (fuel : Nat) (fr : Scry.FuncResult) (path : List Scry.PathNode) : List Scry.PathNode :=
  match fuel with
  | .zero => path
  | .succ k =>
    match path with
    | .nil => .nil
    | .cons root rest =>
      let seen := List.any (fun q => Bool.and (String.eq q.1 fr.fn.name) (Nat.beq q.2 root.point))
        stack;
      let stack' := List.cons (fr.fn.name, root.point) stack;
      if seen then List.cons (Scry.PathNode.mk fr.fn.name fr.plan.ctx root.point root.var
          Scry.PathKind.recursion) rest
      else match root.kind with
        | .param =>
          match Scry.paramPosOf fr.plan root.var with
          | .none => path
          | .some pos =>
            match Scry.findParamSource pr fr.plan.ctx fr.fn.name pos with
            | .none => path
            | .some pair =>
              match Scry.argPath pair.1 pair.2 pos with
              | .none => path
              | .some callerPath =>
                let callerPath := Scry.extendPath pr stack' k pair.1 callerPath;
                List.append callerPath path
        | .returnSeed =>
          match Scry.siteAt pr.graph fr.plan.ctx fr.fn.name root.point with
          | .none => path
          | .some site =>
            match Scry.findResult pr (Scry.siteCtx site.caller site.node) site.callee with
            | .none => path
            | .some callee =>
              match Scry.returnChain callee with
              | .nil => path
              | chain =>
                let chain := Scry.extendPath pr stack' k callee chain;
                List.append chain path
        | .store =>
          /-- A memory seed produced by another function context: expand it into that
          context's chain for the value stored at its store point. -/
          match Scry.findResult pr root.ctx root.func with
          | .none => path
          | .some producer =>
            if Bool.and (String.eq producer.fn.name fr.fn.name)
                (String.eq producer.plan.ctx fr.plan.ctx) then path
            else match List.find (fun m => Nat.beq m.node root.point) producer.plan.mstores with
              | .none => path
              | .some m =>
                match Scry.defReaching producer root.point m.var with
                | .none => path
                | .some d =>
                  let pst := match producer.state with
                    | .none => Scry.State.empty
                    | .some s2 => s2;
                  let chain := Scry.chainToDef producer.fn.name producer.plan.ctx
                    producer.plan.seeds pst d m.var;
                  let chain := Scry.extendPath pr stack' k producer chain;
                  List.append chain path
        | _ => path

-- ## Findings

def Scry.findingKeyLess (a b : Scry.RuleFinding) : Bool :=
  if String.lt a.func b.func then .true
  else if String.eq a.func b.func then
    if Nat.lt a.sink b.sink then .true
    else if Nat.beq a.sink b.sink then String.lt a.rule b.rule
    else .false
  else .false

def Scry.insertRuleFinding (f : Scry.RuleFinding) (fs : List Scry.RuleFinding) : List Scry.RuleFinding :=
  match fs with
  | .nil => List.cons f .nil
  | .cons x xs => match Scry.findingKeyLess f x with
    | .true => List.cons f fs
    | .false => List.cons x (Scry.insertRuleFinding f xs)

def Scry.sortRuleFindings (fs : List Scry.RuleFinding) : List Scry.RuleFinding :=
  List.foldr (fun f acc => Scry.insertRuleFinding f acc) .nil fs

/-- Two findings describe the same sink when rule, function, sink point and argument
agree. Contexts are evidence, not identity: two contexts that both reach the sink produce
one result (the first in deterministic order). -/
def Scry.sameSinkFinding (a b : Scry.RuleFinding) : Bool :=
  Bool.and (String.eq a.rule b.rule)
    (Bool.and (String.eq a.func b.func)
      (Bool.and (Nat.beq a.sink b.sink) (Nat.beq a.arg b.arg)))

def Scry.dedupRuleFindings (fs : List Scry.RuleFinding) : List Scry.RuleFinding :=
  List.foldl (fun acc f =>
    match List.any (fun x => Scry.sameSinkFinding x f) acc with
    | .true => acc
    | .false => List.append acc (.cons f .nil)) .nil fs

/-- All findings of an analysed program, with interprocedural paths. A sink reached from
several contexts is reported once, with the path of the first (deterministic) context. -/
def Scry.programFindings (pr : Scry.ProgramResult) : List Scry.RuleFinding :=
  let all := Scry.concatLists (fun r =>
    List.map (fun f =>
      { f with path := Scry.extendPath pr .nil 16 r f.path }) (Scry.resultFindings r))
    pr.results;
  Scry.sortRuleFindings (Scry.dedupRuleFindings all)

/-- The findings of one function context (its intraprocedural part; the path is not
stitched). -/
def Scry.funcFindings (pr : Scry.ProgramResult) (ctx : String) (name : String) :
    List Scry.RuleFinding :=
  match Scry.findResult pr ctx name with
  | .none => .nil
  | .some r => Scry.resultFindings r

/-- The rule ids that fire on this program, in pack order. -/
def Scry.ruleIds (p : Wil.Program) (pack : Scry.RulePack) : List String :=
  let pr := Scry.analyze p pack;
  List.foldr (fun rule acc =>
    if List.any (fun f => String.eq f.rule rule) (Scry.programFindings pr) then
      List.cons rule acc
    else acc) .nil (List.map Scry.PackRule.id pack.rules)
