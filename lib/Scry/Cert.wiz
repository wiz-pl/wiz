import Prelude
import Word
import Text
import Nat
import Scry.Store
import Scry.Datalog
import Scry.Eval
/-!
# Scry.Cert

**Derivation certificates** for scry's Datalog (`import Scry.Cert`): a finding is a
fact plus a finite, acyclic derivation tree, and `Derivation.check` decides whether the
tree is a valid rule instance by rule instance from the EDB.

This is the S8 slice of `wiz-notes/code-analysis-design.md`: §4.5's `Derivation p db
fact` and §5.1's "the kernel evaluates `Derivation.check prog db tree = .true`". The
design notes are in `wiz-notes/scry-derivation.md`.

## Shape

Wiz has no nested inductive types (an inductive's fields may not mention the type being
defined, not even under `List`), so the tree is **flat**: `Derivation` is a list of
`ProofNode`s in premise-first order, and a node names its premises by their position.
A node is one of

* `edb` — a fact of the input database;
* `rule ri env pids` — the rule `p.rules[ri]` instantiated at `env`, reading the
  non-negated body atoms from the facts at positions `pids` (in body order; a negated
  atom consumes none and is checked against `db`); the node's `fact` must be the
  instance's head fact;
* `join a b` — a lattice fact whose value is the join of the values at `a` and `b`
  (same relation and key). This is how a fixpoint value that is the join of several
  rule instances is certified.

`env` is stored in the certificate, but the checker verifies it against every body atom
and the premises, so an untrusted producer cannot use it to smuggle in a fact it has no
premise for. Premise positions must be smaller than the node's position, so the
certificate is acyclic by construction.

## Soundness

`Scry.inLfp` is the semantic statement "the fact is entailed by the least fixpoint":
it holds in every database that contains the EDB and is closed under the program's
rules. Three theorems are proved below, all by induction over the flat node list:

* `Scry.check_sound_posTuple` for the **positive tuple fragment** (no negation; tuple
  heads; no `join` node), from the program's shape alone;
* `Scry.check_sound_negFree` for **negation-free programs** (lattice heads, lattice
  body atoms and `join` nodes included), in the original `Scry.inLfp` sense, under the
  `Scry.LatLaws` of the program's lattice (`eq_refl`, `eq_sound`, join idempotence,
  commutativity and associativity);
* `Scry.check_sound` for **all node kinds**, in the absence-preserving semantics
  `Scry.inLfpNeg p frozen db`: for a frozen set of relations that contains every
  relation the program negates, extensions may not add an absent tuple of a frozen
  relation. That is the stratified reading at one stratum (the lower relations are
  frozen; current-stratum facts may still be derived); `check_sound_stratified`
  instantiates `frozen` with the program's lower strata from `Program.check`.

For absence certificates, `edbInModel` is proved sound (`edbInModel_dbIncl`: the
executable enumeration of the EDB's entries implies the semantic inclusion), and
`absence_check_sound_checked` composes that with `check` and `closedB`. The remaining
`syntactic` side condition is the matcher-completeness statement
`absence_closedB_soundStmt` (see `wiz-notes/scry-derivation.md` §7.2).
-/

/-- Evaluate a list of terms under an environment (the certificate's row constructor). -/
def Scry.evalTerms (vals : List (Nat × U64)) : List Scry.Term → List U64
  | .nil => .nil
  | .cons t ts => .cons (Scry.Term.eval vals t) (Scry.evalTerms vals ts)

-- ## Small Boolean facts

/-- `Bool.and a b = .true` gives `a = .true`. -/
def Scry.andLeft : (a b : Bool) → Bool.and a b = .true → a = .true
  | .true, _, _ => rfl
  | .false, _, h => absurd h.1

/-- `Bool.and a b = .true` gives `b = .true`. -/
def Scry.andRight : (a b : Bool) → Bool.and a b = .true → b = .true
  | .true, b, h => h
  | .false, _, h => absurd h.1

/-- `if c then t else false = .true` gives both `c` and `t`. This is the case split the
proofs use instead of a dependent match on an intermediate `if`. -/
def Scry.ifTrueAnd : (c t : Bool) →
    (if c then t else Bool.false) = .true → c = .true ∧ t = .true
  | .true, t, h => And.intro rfl h
  | .false, _, h => absurd h.1

/-- `Nat.beq m n = .true` gives `m = n`. -/
def Scry.natBeq_true : (m n : Nat) → Nat.beq m n = .true → m = n
  | .zero, .zero, _ => rfl
  | .zero, .succ _, h => absurd h.1
  | .succ _, .zero, h => absurd h.1
  | .succ m, .succ n, h => Eq.congrArg Nat.succ (Scry.natBeq_true m n h)

/-- `Scry.eqU64 a b = .true` gives `a = b` (both are `UIntN 64`, compared through
`UIntN.toNat`). -/
def Scry.eqU64_true (a b : U64) (h : Scry.eqU64 a b = .true) : a = b :=
  UIntN.ext a b (Scry.natBeq_true (UIntN.toNat a) (UIntN.toNat b) h)

/-- Componentwise row equality, as a `Bool.and` chain (so its soundness lemmas are the
`Bool.and` ones). `Scry.rowEq` in `Scry.Store` is the same relation; the checker uses
this form because `Bool.and`'s projections are definitional. -/
def Scry.rowEqB : List U64 → List U64 → Bool
  | .nil, .nil => .true
  | .nil, .cons _ _ => .false
  | .cons _ _, .nil => .false
  | .cons a as, .cons b bs => Bool.and (Scry.eqU64 a b) (Scry.rowEqB as bs)

/-- `Scry.rowEqB` soundness. -/
def Scry.rowEqB_true : (a b : List U64) → Scry.rowEqB a b = .true → a = b
  | .nil, .nil, _ => rfl
  | .nil, .cons _ _, h => absurd h.1
  | .cons _ _, .nil, h => absurd h.1
  | .cons a as, .cons b bs, h =>
    let e1 : Scry.eqU64 a b = .true :=
      Scry.andLeft (Scry.eqU64 a b) (Scry.rowEqB as bs) h;
    let e2 : Scry.rowEqB as bs = .true :=
      Scry.andRight (Scry.eqU64 a b) (Scry.rowEqB as bs) h;
    Eq.trans (Eq.congrArg (fun xs => List.cons a xs) (Scry.rowEqB_true as bs e2))
      (Eq.congrArg (fun x => List.cons x bs) (Scry.eqU64_true a b e1))

/-- `n < 0` is impossible. -/
def Scry.notLtZero (n : Nat) (h : Nat.lt n 0 = .true) : False :=
  Bool.trueNeFalse (Eq.trans (Eq.symm h) (Nat.lt_zero n))

/-- `List.all` with `Bool.and`, so its head/tail projections are the `Bool.and` ones. -/
def Scry.allB {A : Type} (f : A → Bool) : List A → Bool
  | .nil => .true
  | .cons x xs => Bool.and (f x) (Scry.allB f xs)

/-- `allB f l = .true` and a valid index give `f` at that index. -/
def Scry.allB_getD {A : Type} (f : A → Bool) (d : A) :
    (l : List A) → Scry.allB f l = .true → (i : Nat) →
      Nat.lt i (List.length l) = .true → f (List.getD l i d) = .true
  | .nil, _, i, hi => absurd (Scry.notLtZero i hi)
  | .cons x xs, h, .zero, _ => Scry.andLeft (f x) (Scry.allB f xs) h
  | .cons x xs, h, .succ j, hi =>
    Scry.allB_getD f d xs (Scry.andRight (f x) (Scry.allB f xs) h) j hi

/-- `a ++ b` is `a`'s elements then `b`'s (the certificate's node-list append). -/
def Scry.appendAll {A : Type} : List A → List A → List A
  | .nil, ys => ys
  | .cons x xs, ys => .cons x (Scry.appendAll xs ys)

/-- `a ++ [] = a`. -/
def Scry.append_nil {A : Type} : (l : List A) → Scry.appendAll l List.nil = l
  | .nil => rfl
  | .cons x xs => Eq.congrArg (fun ys => List.cons x ys) (Scry.append_nil xs)

/-- `(a ++ b) ++ c = a ++ (b ++ c)`. -/
def Scry.append_assoc {A : Type} :
    (a b c : List A) → Scry.appendAll (Scry.appendAll a b) c =
      Scry.appendAll a (Scry.appendAll b c)
  | .nil, _, _ => rfl
  | .cons x xs, b, c => Eq.congrArg (List.cons x) (Scry.append_assoc xs b c)

-- ## Facts as propositions

/-- A fact holds in a database: a tuple is present; a lattice fact's value is below the
stored value for its key (an absent key holds nothing). -/
/-- The value of a lattice key in a database (`bot` when absent). -/
def Scry.latVal {L : Type} (ops : Scry.LatOps L) (db : Scry.Db L)
    (rel : Nat) (args : List U64) : L :=
  match Scry.Db.findLat db rel args with
  | .none => ops.bot
  | .some w => w

/-- The Boolean test behind `factHolds`: a tuple is present; a lattice fact's value is
below the value of its key (`bot` when absent). -/
def Scry.factHoldsB {L : Type} (ops : Scry.LatOps L) (db : Scry.Db L)
    (f : Scry.PFact L) : Bool :=
  match f with
  | .mk rel args .none => Scry.Db.memTuple db rel args
  | .mk rel args (.some v) => ops.le v (Scry.latVal ops db rel args)

/-- A fact holds in a database. -/
def Scry.factHolds {L : Type} (ops : Scry.LatOps L) (db : Scry.Db L)
    (f : Scry.PFact L) : Prop :=
  Scry.factHoldsB ops db f = .true

/-- A body atom holds under an environment: a positive atom's instantiated row is a
fact; a negated atom's instantiated row is absent (`db` is the completed lower strata);
a lattice atom reads the value bound to its lattice variable. -/
def Scry.atomHolds {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (a : Scry.Atom) (env : Scry.Env L) : Prop :=
  match a with
  | .pos rel args =>
    Scry.factHolds p.ops db (Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none)
  | .neg rel args => Scry.Db.memTuple db rel (Scry.evalTerms env.vals args) = .false
  | .lat rel key vv =>
    match Scry.envGet vv env.lats with
    | .none => False
    | .some v => Scry.factHolds p.ops db (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v))

/-- Every body atom holds under `env`, in order. -/
def Scry.bodyHolds {L : Type} (p : Scry.Program L) (db : Scry.Db L) :
    List Scry.Atom → Scry.Env L → Prop
  | .nil, _ => True
  | .cons a rest, env => Scry.atomHolds p db a env ∧ Scry.bodyHolds p db rest env

-- ## The certificate

/-- The kind of a proof node. Premises are positions in the certificate's node list,
always smaller than the node's own position. -/
inductive Scry.ProofKind (L : Type) where
  | edb
  | rule (ri : Nat) (env : Scry.Env L) (pids : List Nat)
  | join (left : Nat) (right : Nat)

/-- One node: its fact and how it was obtained. -/
structure Scry.ProofNode (L : Type) where
  fact : Scry.PFact L
  kind : Scry.ProofKind L

/-- A flat derivation: nodes in premise-first order (node `i` may refer only to
positions `< i`), and the position of the conclusion. -/
structure Scry.Derivation (L : Type) where
  nodes : List (Scry.ProofNode L)
  root : Nat

/-- The default rule, used only when an index is out of range (the checker rejects
that case before it matters). -/
def Scry.defaultRule {L : Type} : Scry.Rule L :=
  Scry.Rule.mk (Scry.Head.tuple 0 List.nil) List.nil

/-- The default node, the result of an out-of-range premise lookup. -/
def Scry.defaultNode {L : Type} : Scry.ProofNode L :=
  Scry.ProofNode.mk (Scry.PFact.mk 0 List.nil .none) .edb

/-- The default provenance step, for an out-of-range lookup while explaining. -/
def Scry.defaultStep {L : Type} : Scry.ProofStep L :=
  Scry.ProofStep.mk 0 (Scry.PFact.mk 0 List.nil .none) .none List.nil
    (Option.none : Option L) (Option.none : Option Nat)

/-- A head fact under an environment. -/
def Scry.headFactOf {L : Type} (p : Scry.Program L) (head : Scry.Head L)
    (env : Scry.Env L) : Scry.PFact L :=
  match head with
  | .tuple rel args => Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none
  | .lat rel key val =>
    Scry.PFact.mk rel (Scry.evalTerms env.vals key)
      (.some (Scry.LExpr.eval p.ops p.funcs val env.lats))

/-- A rule's head fact under an environment. -/
def Scry.headFact {L : Type} (p : Scry.Program L) (r : Scry.Rule L)
    (env : Scry.Env L) : Scry.PFact L :=
  Scry.headFactOf p r.head env

/-- A database is closed under a program: every rule instance whose body holds has its
head fact. -/
def Scry.closed {L : Type} (p : Scry.Program L) (db : Scry.Db L) : Prop :=
  (ri : Nat) → (env : Scry.Env L) →
    Nat.lt ri (List.length p.rules) = .true →
    Scry.bodyHolds p db (List.getD p.rules ri Scry.defaultRule).body env →
    Scry.factHolds p.ops db (Scry.headFact p (List.getD p.rules ri Scry.defaultRule) env)

/-- `a` entails `b` (used for the EDB-to-closed-database inclusion). -/
def Scry.dbIncl {L : Type} (ops : Scry.LatOps L) (a b : Scry.Db L) : Prop :=
  (f : Scry.PFact L) → Scry.factHolds ops a f → Scry.factHolds ops b f

/-- **A fact is in the least fixpoint** iff it holds in every database that contains
the EDB and is closed under the rules (the intersection of all such databases). -/
def Scry.inLfp {L : Type} (p : Scry.Program L) (edb : Scry.Db L)
    (f : Scry.PFact L) : Prop :=
  (db : Scry.Db L) → Scry.dbIncl p.ops edb db → Scry.closed p db →
    Scry.factHolds p.ops db f

/-- The conclusion of a derivation (the fact at its root position). -/
def Scry.Derivation.concl {L : Type} (d : Scry.Derivation L) : Option (Scry.PFact L) :=
  .some (Scry.ProofNode.fact (List.getD d.nodes d.root Scry.defaultNode))

/-- The number of nodes (the certificate's size). -/
def Scry.Derivation.size {L : Type} (d : Scry.Derivation L) : Nat :=
  List.length d.nodes

-- ## The checker

/-- Fact equality for certificates: relation number and columns structurally, lattice
values through `ops.eq`. Mixed tuple/lattice facts are never equal. -/
def Scry.factEq {L : Type} (ops : Scry.LatOps L) (a b : Scry.PFact L) : Bool :=
  match a, b with
  | .mk ra arga .none, .mk rb argb .none =>
    Bool.and (Nat.beq ra rb) (Scry.rowEqB arga argb)
  | .mk ra arga (.some va), .mk rb argb (.some vb) =>
    Bool.and (Nat.beq ra rb) (Bool.and (Scry.rowEqB arga argb) (ops.eq va vb))
  | _, _ => .false

/-- Structure eta for `PFact`, both directions: the constructor applied to the
projections is the fact. -/
def Scry.pfact_eta {L : Type} (f : Scry.PFact L) :
    Scry.PFact.mk f.rel f.args f.lat = f := rfl

def Scry.pfact_etaR {L : Type} (f : Scry.PFact L) :
    f = Scry.PFact.mk f.rel f.args f.lat := rfl

/-- Tuple-fact equality on the fact's fields, with the lattice part as an explicit
`Option` argument (Wiz's equation compiler reduces an inductive match in a proof, but not
a structure match, so the fields are passed separately). -/
def Scry.factEqTLat {L : Type} (rel : Nat) (row : List U64)
    (lat : Option L) (r : Nat) (args : List U64) : Bool :=
  match lat with
  | .none => Bool.and (Nat.beq rel r) (Scry.rowEqB row args)
  | .some _ => Bool.false

/-- The fields a tuple-fact equality pins. -/
def Scry.factEqTLat_sound {L : Type} (rel : Nat) (row : List U64) :
    (lat : Option L) → (r : Nat) → (args : List U64) →
    Scry.factEqTLat rel row lat r args = .true →
      (lat = .none ∧ rel = r ∧ row = args)
  | .none, r, args, h =>
    (rfl,
     Scry.natBeq_true rel r
       (Scry.andLeft (Nat.beq rel r) (Scry.rowEqB row args) h),
     Scry.rowEqB_true row args
       (Scry.andRight (Nat.beq rel r) (Scry.rowEqB row args) h))
  | .some _, _, _, h => absurd h.1

/-- Tuple-fact equality: `f` is the tuple `(rel, row)`. -/
def Scry.factEqT {L : Type} (rel : Nat) (row : List U64) (f : Scry.PFact L) : Bool :=
  Scry.factEqTLat rel row f.lat f.rel f.args

/-- A tuple fact `(rel, row)` equal to `f` is the fact `f` itself. -/
def Scry.factEqT_true {L : Type} (rel : Nat) (row : List U64) :
    (f : Scry.PFact L) → Scry.factEqT rel row f = .true →
      f = Scry.PFact.mk rel row .none
  | f, h =>
    let s := Scry.factEqTLat_sound rel row f.lat f.rel f.args h;
    let e0 : f = Scry.PFact.mk f.rel f.args f.lat := Scry.pfact_etaR f;
    let e1 : Scry.PFact.mk f.rel f.args f.lat =
        Scry.PFact.mk rel f.args f.lat :=
      Eq.congrArg (fun x => Scry.PFact.mk x f.args f.lat) (Eq.symm s.2.1);
    let e2 : Scry.PFact.mk rel f.args f.lat = Scry.PFact.mk rel row f.lat :=
      Eq.congrArg (fun xs => Scry.PFact.mk rel xs f.lat) (Eq.symm s.2.2);
    let e3 : Scry.PFact.mk rel row f.lat = Scry.PFact.mk rel row .none :=
      Eq.congrArg (fun l => Scry.PFact.mk rel row l) s.1;
    @Eq.trans (Scry.PFact L) f (Scry.PFact.mk f.rel f.args f.lat)
      (Scry.PFact.mk rel row .none) e0
      (@Eq.trans (Scry.PFact L) (Scry.PFact.mk f.rel f.args f.lat)
        (Scry.PFact.mk rel f.args f.lat) (Scry.PFact.mk rel row .none) e1
        (@Eq.trans (Scry.PFact L) (Scry.PFact.mk rel f.args f.lat)
          (Scry.PFact.mk rel row f.lat) (Scry.PFact.mk rel row .none) e2 e3))

/-- Head equality for a rule instance: tuple heads use the specialized tuple equality,
lattice heads the general one (with `ops.eq`). -/
def Scry.checkHeadEq {L : Type} (p : Scry.Program L) (head : Scry.Head L)
    (env : Scry.Env L) (fact : Scry.PFact L) : Bool :=
  match head with
  | .tuple rel args => Scry.factEqT rel (Scry.evalTerms env.vals args) fact
  | .lat _ _ _ => Scry.factEq p.ops (Scry.headFactOf p head env) fact

/-- Is `f` in the database (the EDB leaves of a certificate)? -/
def Scry.factInDb {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (f : Scry.PFact L) : Bool :=
  Scry.factHoldsB p.ops db f

/-- `factInDb` is the Boolean form of `factHolds` (definitionally). -/
def Scry.factInDb_true {L : Type} :
    (p : Scry.Program L) → (db : Scry.Db L) → (f : Scry.PFact L) →
    Scry.factInDb p db f = .true → Scry.factHolds p.ops db f :=
  fun p db f h => h

/-- Check the bodies of a rule instance against the premise positions. The
environment is supplied by the certificate but every atom is re-instantiated and
compared with a premise (or the database), so it is not trusted. -/
def Scry.checkAtoms {L : Type} (p : Scry.Program L) (db : Scry.Db L) (env : Scry.Env L)
    (done : List (Scry.ProofNode L)) : List Scry.Atom → List Nat → Bool
  | .nil, .nil => .true
  | .nil, .cons _ _ => .false
  | .cons a rest, ps =>
    match a with
    | .neg rel args =>
      if Scry.Db.memTuple db rel (Scry.evalTerms env.vals args) then .false
      else Scry.checkAtoms p db env done rest ps
    | .pos rel args =>
      match ps with
      | .nil => .false
      | .cons pid ps' =>
        if Nat.lt pid (List.length done) then
          if Scry.factEqT rel (Scry.evalTerms env.vals args)
              (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
          then Scry.checkAtoms p db env done rest ps'
          else .false
        else .false
    | .lat rel key vv =>
      match ps with
      | .nil => .false
      | .cons pid ps' =>
        if Nat.lt pid (List.length done) then
          match Scry.envGet vv env.lats with
          | .none => .false
          | .some v =>
            if Scry.factEq p.ops
                (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v))
                (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
            then Scry.checkAtoms p db env done rest ps'
            else .false
        else .false

/-- A lattice join: both facts have the same relation and key, and the conclusion is
their join. -/
def Scry.checkJoin {L : Type} (p : Scry.Program L) (fa fb f : Scry.PFact L) : Bool :=
  match fa, fb, f with
  | .mk ra arga (.some va), .mk rb argb (.some vb), .mk rf argf (.some v) =>
    if Nat.beq ra rb then
      if Nat.beq rf ra then
        if Scry.rowEqB arga argb then
          if Scry.rowEqB argf arga then p.ops.eq v (p.ops.join va vb) else .false
        else .false
      else .false
    else .false
  | _, _, _ => .false

/-- Check the head and body of a rule instance (the bound on `ri` is the caller's). -/
def Scry.checkRuleParts {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (done : List (Scry.ProofNode L)) (fact : Scry.PFact L) (head : Scry.Head L)
    (body : List Scry.Atom) (env : Scry.Env L) (pids : List Nat) : Bool :=
  if Scry.checkAtoms p db env done body pids then
    Scry.checkHeadEq p head env fact
  else .false

/-- Check one node (its fact and kind) against the already-validated prefix `done`.
The kind is an argument so the soundness proof can reduce the match: Wiz reduces an
inductive match in a proof, but not a structure match. -/
def Scry.checkNode {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (done : List (Scry.ProofNode L)) (fact : Scry.PFact L)
    (kind : Scry.ProofKind L) : Bool :=
  match kind with
  | .edb => Scry.factInDb p db fact
  | .rule ri env pids =>
    if Nat.lt ri (List.length p.rules) then
      Scry.checkRuleParts p db done fact
        (List.getD p.rules ri Scry.defaultRule).head
        (List.getD p.rules ri Scry.defaultRule).body env pids
    else .false
  | .join left right =>
    if Nat.lt left (List.length done) then
      if Nat.lt right (List.length done) then
        Scry.checkJoin p
          (Scry.ProofNode.fact (List.getD done left Scry.defaultNode))
          (Scry.ProofNode.fact (List.getD done right Scry.defaultNode))
          fact
      else .false
    else .false

/-- Check every node, in order, against the growing validated prefix. -/
def Scry.checkNodes {L : Type} (p : Scry.Program L) (db : Scry.Db L) :
    List (Scry.ProofNode L) → List (Scry.ProofNode L) → Bool
  | _done, .nil => .true
  | done, .cons n rest =>
    if Scry.checkNode p db done n.fact n.kind then
      Scry.checkNodes p db (Scry.appendAll done (List.cons n List.nil)) rest
    else .false

/-- **The certificate checker.** It accepts a derivation when the root position is
inside the node list and every node is checked in premise-first order. Stratification
and range restriction are `Program.check`'s job; the certificate validates one
derivation, and its soundness does not need them (see the notes). -/
def Scry.Derivation.check {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (d : Scry.Derivation L) : Bool :=
  if Nat.lt d.root (List.length d.nodes) then
    Scry.checkNodes p db List.nil d.nodes
  else .false

-- ## The positive tuple fragment

/-- Whether an atom is positive (a plain tuple atom). -/
def Scry.Atom.isPos : Scry.Atom → Bool
  | .pos _ _ => .true
  | _ => .false

/-- Whether every atom of a body is positive. -/
def Scry.bodyPos (body : List Scry.Atom) : Bool :=
  Scry.allB Scry.Atom.isPos body

def Scry.bodyPos_head : (a : Scry.Atom) → (rest : List Scry.Atom) →
    Scry.bodyPos (List.cons a rest) = .true → Scry.Atom.isPos a = .true
  | .pos _ _, _, _ => rfl
  | .neg _ _, _, h => absurd h.1
  | .lat _ _ _, _, h => absurd h.1

def Scry.bodyPos_tail : (a : Scry.Atom) → (rest : List Scry.Atom) →
    Scry.bodyPos (List.cons a rest) = .true → Scry.bodyPos rest = .true
  | .pos _ _, _, h => h
  | .neg _ _, _, h => absurd h.1
  | .lat _ _ _, _, h => absurd h.1

/-- Whether a head is a tuple head. -/
def Scry.headTupleB {L : Type} : Scry.Head L → Bool
  | .tuple _ _ => .true
  | .lat _ _ _ => .false

/-- A rule in the positive tuple fragment: a tuple head and a body of positive atoms. -/
def Scry.Rule.posTuple {L : Type} (r : Scry.Rule L) : Bool :=
  Bool.and (Scry.headTupleB r.head) (Scry.bodyPos r.body)

/-- A program in the positive tuple fragment: every rule is. -/
def Scry.Program.posTuple {L : Type} (p : Scry.Program L) : Bool :=
  Scry.allB Scry.Rule.posTuple p.rules

/-- A kind is join-free (the fragment's derivation side). -/
def Scry.ProofKind.joinFree {L : Type} : Scry.ProofKind L → Bool
  | .join _ _ => .false
  | _ => .true

/-- A node is join-free. -/
def Scry.ProofNode.joinFree {L : Type} (n : Scry.ProofNode L) : Bool :=
  Scry.ProofKind.joinFree n.kind

/-- A derivation has no join nodes. -/
def Scry.Derivation.tuple {L : Type} (d : Scry.Derivation L) : Bool :=
  Scry.allB Scry.ProofNode.joinFree d.nodes

/-- The rule at a valid index has a tuple head and a positive body. -/
def Scry.rulePos_of_program {L : Type} (p : Scry.Program L)
    (hp : Scry.Program.posTuple p = .true) (ri : Nat)
    (hri : Nat.lt ri (List.length p.rules) = .true) :
    Scry.Rule.posTuple (List.getD p.rules ri Scry.defaultRule) = .true :=
  Scry.allB_getD Scry.Rule.posTuple Scry.defaultRule p.rules hp ri hri

-- ## Folding the node list

/-- `allInLfp` on a list of nodes: every node's fact is in the least fixpoint. -/
def Scry.allInLfp {L : Type} (p : Scry.Program L) (db : Scry.Db L) :
    List (Scry.ProofNode L) → Prop
  | .nil => True
  | .cons n rest => Scry.inLfp p db n.fact ∧ Scry.allInLfp p db rest

/-- Append two checked prefixes. -/
def Scry.allInLfp_append {L : Type} (p : Scry.Program L) (db : Scry.Db L) :
    (a b : List (Scry.ProofNode L)) → Scry.allInLfp p db a → Scry.allInLfp p db b →
      Scry.allInLfp p db (Scry.appendAll a b)
  | .nil, _, _, hb => hb
  | .cons n rest, b, ha, hb =>
    And.intro ha.1 (Scry.allInLfp_append p db rest b ha.2 hb)

/-- A one-node list is checked when its fact is. -/
def Scry.allInLfp_single {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (n : Scry.ProofNode L) (h : Scry.inLfp p db n.fact) :
    Scry.allInLfp p db (List.cons n List.nil) :=
  And.intro h True.intro

/-- The fact at a valid position of a checked list is in the least fixpoint. -/
def Scry.allInLfp_getD {L : Type} (p : Scry.Program L) (db : Scry.Db L) :
    (l : List (Scry.ProofNode L)) → Scry.allInLfp p db l → (i : Nat) →
      Nat.lt i (List.length l) = .true →
      Scry.inLfp p db (Scry.ProofNode.fact (List.getD l i Scry.defaultNode))
  | .nil, _, i, hi => absurd (Scry.notLtZero i hi)
  | .cons n rest, ha, .zero, _ => ha.1
  | .cons n rest, ha, .succ j, hi =>
    Scry.allInLfp_getD p db rest ha.2 j hi

/-- Transport `allInLfp` along an equality of node lists. -/
def Scry.allInLfp_congr {L : Type} (p : Scry.Program L) (db : Scry.Db L) :
    (a b : List (Scry.ProofNode L)) → a = b →
    Scry.allInLfp p db a → Scry.allInLfp p db b :=
  fun a b e h => @Eq.substProp (List (Scry.ProofNode L)) (fun l => Scry.allInLfp p db l) a b e h

/-- Transport a fact's membership along an equality of facts. -/
def Scry.factHolds_congr {L : Type} (ops : Scry.LatOps L) (db : Scry.Db L) :
    (f g : Scry.PFact L) → f = g →
    Scry.factHolds ops db f → Scry.factHolds ops db g :=
  fun f g e h => @Eq.substProp (Scry.PFact L) (fun x => Scry.factHolds ops db x) f g e h

/-- Transport `inLfp` along an equality of facts. -/
def Scry.inLfp_congr {L : Type} (p : Scry.Program L) (db : Scry.Db L) :
    (f g : Scry.PFact L) → f = g → Scry.inLfp p db f → Scry.inLfp p db g :=
  fun f g e h => @Eq.substProp (Scry.PFact L) (fun x => Scry.inLfp p db x) f g e h

-- ## Soundness: the positive tuple fragment

/-- **The body of a checked rule instance holds in every closed database containing
the EDB**, given that every premise fact is in the least fixpoint. -/
def Scry.checkAtoms_sound {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (env : Scry.Env L) (done : List (Scry.ProofNode L)) :
    (body : List Scry.Atom) → (pids : List Nat) →
    Scry.allInLfp p db done →
    Scry.bodyPos body = .true →
    Scry.checkAtoms p db env done body pids = .true →
    ∀ (db' : Scry.Db L), Scry.dbIncl p.ops db db' → Scry.closed p db' →
      Scry.bodyHolds p db' body env
  | .nil, _, _, _, _ => fun _ _ _ => True.intro
  | .cons (.pos rel args) rest, .nil, _, _, hcheck => absurd hcheck.1
  | .cons (.pos rel args) rest, .cons pid ps, hdone, hbody, hcheck =>
    let hrest : Scry.bodyPos rest = .true :=
      Scry.bodyPos_tail (.pos rel args) rest hbody;
    let hb : Nat.lt pid (List.length done) = .true ∧
        (if Scry.factEqT rel (Scry.evalTerms env.vals args)
            (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
          then Scry.checkAtoms p db env done rest ps else Bool.false) = .true :=
      Scry.ifTrueAnd (Nat.lt pid (List.length done))
        (if Scry.factEqT rel (Scry.evalTerms env.vals args)
            (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
          then Scry.checkAtoms p db env done rest ps else Bool.false) hcheck;
    let hf : Scry.factEqT rel (Scry.evalTerms env.vals args)
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)) = .true ∧
        Scry.checkAtoms p db env done rest ps = .true :=
      Scry.ifTrueAnd (Scry.factEqT rel (Scry.evalTerms env.vals args)
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)))
        (Scry.checkAtoms p db env done rest ps) hb.2;
    let hprem : Scry.inLfp p db
        (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)) :=
      Scry.allInLfp_getD p db done hdone pid hb.1;
    let heq : Scry.ProofNode.fact (List.getD done pid Scry.defaultNode) =
        Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none :=
      Scry.factEqT_true rel (Scry.evalTerms env.vals args)
        (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)) hf.1;
    fun db' hincl hclosed =>
      let hfh : Scry.factHolds p.ops db'
          (Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none) :=
        Scry.factHolds_congr p.ops db'
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
          (Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none) heq
          (hprem db' hincl hclosed);
      let hrestHolds : Scry.bodyHolds p db' rest env :=
        @Scry.checkAtoms_sound L p db env done rest ps hdone hrest hf.2 db' hincl hclosed;
      And.intro hfh hrestHolds
  | .cons (.neg rel args) rest, _, _, hbody, _hcheck =>
    absurd (Scry.bodyPos_head (.neg rel args) rest hbody).1
  | .cons (.lat rel key vv) rest, _, _, hbody, _hcheck =>
    absurd (Scry.bodyPos_head (.lat rel key vv) rest hbody).1

/-- **A checked rule instance's fact is in the least fixpoint** (positive tuple
fragment). The head is an equation argument, so the tuple branch can compute its fact
and the lattice branch is excluded by `Rule.posTuple`. -/
def Scry.checkRuleParts_sound {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (done : List (Scry.ProofNode L)) (hprog : Scry.Program.posTuple p = .true)
    (hdone : Scry.allInLfp p db done) :
    (ri : Nat) → (hri : Nat.lt ri (List.length p.rules) = .true) →
    (head : Scry.Head L) →
    (hheadEq : (List.getD p.rules ri Scry.defaultRule).head = head) →
    (body : List Scry.Atom) →
    (hbodyEq : (List.getD p.rules ri Scry.defaultRule).body = body) →
    (env : Scry.Env L) → (pids : List Nat) → (fact : Scry.PFact L) →
    Scry.headTupleB head = .true →
    Scry.bodyPos body = .true →
    Scry.checkRuleParts p db done fact head body env pids = .true →
    Scry.inLfp p db fact
  | ri, hri, .tuple rel args, _hheadEq, body, hbodyEq, env, pids, fact, _hhead, hbodyPos, hcheck =>
    let hca : Scry.checkAtoms p db env done body pids = .true ∧
        Scry.factEqT rel (Scry.evalTerms env.vals args) fact = .true :=
      Scry.ifTrueAnd (Scry.checkAtoms p db env done body pids)
        (Scry.checkHeadEq p (.tuple rel args) env fact) hcheck;
    fun db' hincl hclosed =>
      let hb : Scry.bodyHolds p db' body env :=
        Scry.checkAtoms_sound p db env done body pids hdone hbodyPos hca.1
          db' hincl hclosed;
      let hbGet : Scry.bodyHolds p db'
          (List.getD p.rules ri Scry.defaultRule).body env :=
        @Eq.mpr' (List Scry.Atom)
          (List.getD p.rules ri Scry.defaultRule).body body
          (fun b => Scry.bodyHolds p db' b env) hbodyEq hb;
      let hfhGet : Scry.factHolds p.ops db'
          (Scry.headFact p (List.getD p.rules ri Scry.defaultRule) env) :=
        hclosed ri env hri hbGet;
      let hfh : Scry.factHolds p.ops db'
          (Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none) :=
        Scry.factHolds_congr p.ops db'
          (Scry.headFact p (List.getD p.rules ri Scry.defaultRule) env)
          (Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none)
          (Eq.congrArg (fun hd => Scry.headFactOf p hd env) hheadEq) hfhGet;
      let heq : fact = Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none :=
        Scry.factEqT_true rel (Scry.evalTerms env.vals args) fact hca.2;
      Scry.factHolds_congr p.ops db'
        (Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none) fact
        (@Eq.symm (Scry.PFact L) fact
          (Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none) heq) hfh
  | ri, _hri, .lat _ _ _, _hheadEq, _body, _hbodyEq, _env, _pids, _fact, hhead, _hbodyPos, _hcheck =>
    absurd hhead.1

/-- **A checked node is in the least fixpoint** (the local step of the induction). -/
def Scry.checkNode_sound {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (done : List (Scry.ProofNode L)) (hprog : Scry.Program.posTuple p = .true)
    (hdone : Scry.allInLfp p db done) :
    (fact : Scry.PFact L) → (kind : Scry.ProofKind L) →
    Scry.ProofKind.joinFree kind = .true →
    Scry.checkNode p db done fact kind = .true → Scry.inLfp p db fact
  | fact, .edb, _hfree, hcheck =>
    fun db' hincl _hclosed => hincl fact (Scry.factInDb_true p db fact hcheck)
  | fact, .rule ri env pids, _hfree, hcheck =>
    let hb : Nat.lt ri (List.length p.rules) = .true ∧
        Scry.checkRuleParts p db done fact
          (List.getD p.rules ri Scry.defaultRule).head
          (List.getD p.rules ri Scry.defaultRule).body env pids = .true :=
      Scry.ifTrueAnd (Nat.lt ri (List.length p.rules))
        (Scry.checkRuleParts p db done fact
          (List.getD p.rules ri Scry.defaultRule).head
          (List.getD p.rules ri Scry.defaultRule).body env pids) hcheck;
    let hpos : Scry.Rule.posTuple (List.getD p.rules ri Scry.defaultRule) = .true :=
      Scry.rulePos_of_program p hprog ri hb.1;
    Scry.checkRuleParts_sound p db done hprog hdone ri hb.1
      (List.getD p.rules ri Scry.defaultRule).head rfl
      (List.getD p.rules ri Scry.defaultRule).body rfl
      env pids fact
      (Scry.andLeft (Scry.headTupleB (List.getD p.rules ri Scry.defaultRule).head)
        (Scry.bodyPos (List.getD p.rules ri Scry.defaultRule).body) hpos)
      (Scry.andRight (Scry.headTupleB (List.getD p.rules ri Scry.defaultRule).head)
        (Scry.bodyPos (List.getD p.rules ri Scry.defaultRule).body) hpos)
      hb.2
  | _fact, .join _ _, hfree, _hcheck => absurd hfree.1

/-- **Every checked node is in the least fixpoint** (the list induction). -/
def Scry.checkNodes_sound {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (hprog : Scry.Program.posTuple p = .true) :
    (done nodes : List (Scry.ProofNode L)) →
    Scry.allInLfp p db done →
    Scry.allB Scry.ProofNode.joinFree nodes = .true →
    Scry.checkNodes p db done nodes = .true →
    Scry.allInLfp p db (Scry.appendAll done nodes)
  | done, .nil, hdone, _, _ =>
    Scry.allInLfp_congr p db done (Scry.appendAll done List.nil)
      (Eq.symm (Scry.append_nil done)) hdone
  | done, .cons n rest, hdone, hfree, hcheck =>
    let hcn : Scry.checkNode p db done n.fact n.kind = .true ∧
        Scry.checkNodes p db (Scry.appendAll done (List.cons n List.nil)) rest = .true :=
      Scry.ifTrueAnd (Scry.checkNode p db done n.fact n.kind)
        (Scry.checkNodes p db (Scry.appendAll done (List.cons n List.nil)) rest) hcheck;
    let hfreeN : Scry.ProofNode.joinFree n = .true :=
      Scry.andLeft (Scry.ProofNode.joinFree n)
        (Scry.allB Scry.ProofNode.joinFree rest) hfree;
    let hfreeRest : Scry.allB Scry.ProofNode.joinFree rest = .true :=
      Scry.andRight (Scry.ProofNode.joinFree n)
        (Scry.allB Scry.ProofNode.joinFree rest) hfree;
    let hnode : Scry.inLfp p db n.fact :=
      Scry.checkNode_sound p db done hprog hdone n.fact n.kind hfreeN hcn.1;
    let hdone' : Scry.allInLfp p db (Scry.appendAll done (List.cons n List.nil)) :=
      Scry.allInLfp_append p db done (List.cons n List.nil) hdone
        (Scry.allInLfp_single p db n hnode);
    let hrestAll : Scry.allInLfp p db
        (Scry.appendAll (Scry.appendAll done (List.cons n List.nil)) rest) :=
      Scry.checkNodes_sound p db hprog
        (Scry.appendAll done (List.cons n List.nil)) rest hdone' hfreeRest hcn.2;
    Scry.allInLfp_congr p db
      (Scry.appendAll (Scry.appendAll done (List.cons n List.nil)) rest)
      (Scry.appendAll done (List.cons n rest))
      (Scry.append_assoc done (List.cons n List.nil) rest)
      hrestAll

/-- **`Derivation.check` is sound on the positive tuple fragment**: an accepted
certificate's conclusion is in the least fixpoint of the program over the EDB. -/
def Scry.checkSoundPosTupleStmt {L : Type} (p : Scry.Program L) : Prop :=
  (db : Scry.Db L) → (d : Scry.Derivation L) → (f : Scry.PFact L) →
    Scry.Derivation.tuple d = .true →
    Scry.Derivation.concl d = .some f →
    Scry.Derivation.check p db d = .true →
    Scry.inLfp p db f

/-- The positive tuple fragment's soundness theorem. -/
def Scry.check_sound_posTuple {L : Type} (p : Scry.Program L)
    (hprog : Scry.Program.posTuple p = .true) : Scry.checkSoundPosTupleStmt p :=
  fun db d f htuple hconcl hcheck =>
    let hb : Nat.lt d.root (List.length d.nodes) = .true ∧
        Scry.checkNodes p db List.nil d.nodes = .true :=
      Scry.ifTrueAnd (Nat.lt d.root (List.length d.nodes))
        (Scry.checkNodes p db List.nil d.nodes) hcheck;
    let hnodes : Scry.allInLfp p db (Scry.appendAll List.nil d.nodes) :=
      Scry.checkNodes_sound p db hprog List.nil d.nodes True.intro htuple hb.2;
    let hnodes' : Scry.allInLfp p db d.nodes :=
      Scry.allInLfp_congr p db (Scry.appendAll List.nil d.nodes) d.nodes rfl hnodes;
    let hroot : Scry.inLfp p db
        (Scry.ProofNode.fact (List.getD d.nodes d.root Scry.defaultNode)) :=
      Scry.allInLfp_getD p db d.nodes hnodes' d.root hb.1;
    Scry.inLfp_congr p db
      (Scry.ProofNode.fact (List.getD d.nodes d.root Scry.defaultNode)) f
      hconcl.1 hroot

-- ## Rendering and explaining

/-- Render the columns of a row, separated by commas. -/
def Scry.renderRow (row : List U64) : String :=
  String.intercalate "," (List.map (fun x => Nat.repr (UIntN.toNat x)) row)

/-- Render a fact (`r3(1,2)`; a lattice fact adds `=value`). -/
def Scry.renderFact {L : Type} (showL : L → String) (f : Scry.PFact L) : String :=
  let base : String :=
    String.append "r" (String.append (Nat.repr f.rel)
      (String.append "(" (String.append (Scry.renderRow f.args) ")")));
  match f.lat with
  | .none => base
  | .some v => String.append base (String.append "=" (showL v))

/-- Render a node's justification. -/
def Scry.renderKind {L : Type} (k : Scry.ProofKind L) : String :=
  match k with
  | .edb => "edb"
  | .rule ri _ pids =>
    String.append "rule " (String.append (Nat.repr ri)
      (String.append " <- " (String.intercalate "," (List.map Nat.repr pids))))
  | .join a b =>
    String.append "join " (String.append (Nat.repr a) (String.append " " (Nat.repr b)))

/-- The lines of a derivation, one per node, numbering from `i`. -/
def Scry.renderNodes {L : Type} (showL : L → String) :
    Nat → List (Scry.ProofNode L) → List String
  | _, .nil => List.nil
  | i, .cons n rest =>
    List.cons
      (String.append (Nat.repr i)
        (String.append ": " (String.append (Scry.renderFact showL n.fact)
          (String.append "  [" (String.append (Scry.renderKind n.kind) "]")))))
      (Scry.renderNodes showL (Nat.succ i) rest)

/-- Render a derivation: one line per node in premise-first order, then the root
position. This is the string a finding carries (`scry explain` prints it). -/
def Scry.Derivation.render {L : Type} (showL : L → String)
    (d : Scry.Derivation L) : String :=
  String.append (String.intercalate "\n" (Scry.renderNodes showL 0 d.nodes))
    (String.append "\nroot: " (Nat.repr d.root))

/-- The checked witness for a finding: `explain` returns the derivation only if it
checks against the EDB, so a caller that prints it can trust the check result. -/
def Scry.explain {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (d : Scry.Derivation L) : Option (Scry.Derivation L) :=
  if Scry.Derivation.check p db d then .some d else .none

-- ## Rebuilding a certificate from the evaluator's provenance

/-- Insert a provenance step into a list sorted by id. -/
def Scry.insertStep {L : Type} (s : Scry.ProofStep L) :
    List (Scry.ProofStep L) → List (Scry.ProofStep L)
  | .nil => List.cons s List.nil
  | .cons t ts =>
    if Nat.lt s.id t.id then List.cons s (List.cons t ts)
    else List.cons t (Scry.insertStep s ts)

/-- Provenance steps sorted by id (a topological order: a premise's id is smaller). -/
def Scry.sortSteps {L : Type} : List (Scry.ProofStep L) → List (Scry.ProofStep L)
  | .nil => List.nil
  | .cons s rest => Scry.insertStep s (Scry.sortSteps rest)

/-- The position of a step id in a sorted list. -/
def Scry.stepPosL {L : Type} (id : Nat) : List (Scry.ProofStep L) → Nat → Option Nat
  | .nil, _ => .none
  | .cons s rest, i =>
    if Nat.beq s.id id then .some i else Scry.stepPosL id rest (Nat.succ i)

/-- Renumber premise ids to positions (an unknown id maps past the end, so the checker
rejects it). -/
def Scry.renumberPids {L : Type} (steps : List (Scry.ProofStep L))
    (ids : List Nat) : List Nat :=
  List.map (fun id =>
    match Scry.stepPosL id steps 0 with
    | .some p => p
    | .none => List.length steps) ids

/-- Rebuild the environment of a provenance step from its premise facts: unify each
positive atom's terms with the premise's row, and bind each lattice variable to the
premise's value. (A reconstruction that disagrees with the facts is simply rejected by
the checker, so this is untrusted convenience, not a trusted part.) -/
def Scry.envOfAtoms {L : Type} (p : Scry.Program L) (steps : List (Scry.ProofStep L)) :
    List Scry.Atom → List Nat → Scry.Env L → Option (Scry.Env L)
  | .nil, _, env => .some env
  | .cons a rest, pids, env =>
    match a with
    | .neg _ _ => Scry.envOfAtoms p steps rest pids env
    | .pos _ args =>
      match pids with
      | .nil => .none
      | .cons pid ps =>
        match (List.getD steps pid Scry.defaultStep).fact with
        | .mk _ row .none =>
          match Scry.unifyTerms p.ops args row env with
          | .some env' => Scry.envOfAtoms p steps rest ps env'
          | .none => .none
        | .mk _ _ (.some _) => .none
    | .lat _ key vv =>
      match pids with
      | .nil => .none
      | .cons pid ps =>
        match (List.getD steps pid Scry.defaultStep).fact with
        | .mk _ row (.some v) =>
          match Scry.unifyTerms p.ops key row env with
          | .some env' =>
            match Scry.Env.bindLat env' p.ops vv v with
            | .some env'' => Scry.envOfAtoms p steps rest ps env''
            | .none => .none
          | .none => .none
        | .mk _ _ .none => .none

/-- Turn a provenance step into a proof node (rebuilding the environment). -/
def Scry.nodeOfStep {L : Type} (p : Scry.Program L) (steps : List (Scry.ProofStep L))
    (s : Scry.ProofStep L) : Option (Scry.ProofNode L) :=
  match s.rule with
  | .none => .some (Scry.ProofNode.mk s.fact .edb)
  | .some ri =>
    if Nat.lt ri (List.length p.rules) then
      let rule : Scry.Rule L := List.getD p.rules ri Scry.defaultRule;
      let pids : List Nat := Scry.renumberPids steps s.premises;
      match Scry.envOfAtoms p steps rule.body pids Scry.Env.empty with
      | .some env => .some (Scry.ProofNode.mk s.fact (.rule ri env pids))
      | .none => .none
    else .none

/-- Turn every provenance step into a proof node. -/
def Scry.nodesOfSteps {L : Type} (p : Scry.Program L) (steps : List (Scry.ProofStep L)) :
    List (Scry.ProofStep L) → Option (List (Scry.ProofNode L))
  | .nil => .some List.nil
  | .cons s rest =>
    match Scry.nodeOfStep p steps s with
    | .some n =>
      match Scry.nodesOfSteps p steps rest with
      | .some ns => .some (List.cons n ns)
      | .none => .none
    | .none => .none

/-- **Explain a tuple finding from the evaluator's provenance.** The state's provenance
heap is converted to a certificate, renumbered in topological order, and checked
against `edb` (the input facts, not the derived state); `.none` means the provenance
did not produce a valid certificate. Lattice findings are not reconstructed here: a
lattice step records the accumulated value, not its contribution, so joining the
contributions needs an engine that stores them (see the notes). -/
def Scry.State.explainTuple {L : Type} (p : Scry.Program L) (edb : Scry.Db L)
    (st : Scry.State L) (rel : Nat) (row : List U64) : Option (Scry.Derivation L) :=
  match st.whyTuple p.ops rel row with
  | .none => .none
  | .some root =>
    let steps : List (Scry.ProofStep L) :=
      Scry.sortSteps (List.cons root (st.expandWitness root).steps);
    match Scry.nodesOfSteps p steps steps with
    | .some nodes =>
      let rootPos : Nat :=
        match Scry.stepPosL root.id steps 0 with
        | .some k => k
        | .none => 0;
      let d : Scry.Derivation L := Scry.Derivation.mk nodes rootPos;
      if Scry.Derivation.check p edb d then .some d else .none
    | .none => .none

/-- Every step reachable from a list of ids through premises *and* lattice links (a
lattice step's `prev`). -/
partial def Scry.stepsFrom {L : Type} (nodes : List (Scry.ProofStep L)) :
    List Nat → List (Scry.ProofStep L) → List (Scry.ProofStep L)
  | .nil, acc => acc
  | .cons id rest, acc =>
    match Scry.stepByIdL nodes id with
    | .none => Scry.stepsFrom nodes rest acc
    | .some s =>
      Scry.stepsFrom nodes
        (List.append (List.append s.premises
          (match s.prev with | .none => List.nil | .some p => List.cons p List.nil)) rest)
        (List.cons s acc)

/-- A step id's position in an association list (the first match). -/
def Scry.posOf (id : Nat) : List (Nat × Nat) → Option Nat
  | .nil => Option.none
  | .cons e rest => if Nat.beq id e.1 then Option.some e.2 else Scry.posOf id rest

/-- The fact a provenance step contributes as a *node*: the recorded fact, except for a
lattice step that joined onto a previous value, whose node concludes the contribution. -/
def Scry.nodeFactOf {L : Type} (s : Scry.ProofStep L) : Scry.PFact L :=
  match s.prev with
  | .none => s.fact
  | .some _ => Scry.PFact.mk s.fact.rel s.fact.args s.contrib

/-- A provenance step as a node, with a lattice step's `contrib` as the fact (the join
node that follows it concludes the stored value). -/
def Scry.nodeOfStepL {L : Type} (p : Scry.Program L) (steps : List (Scry.ProofStep L))
    (s : Scry.ProofStep L) : Option (Scry.ProofNode L) :=
  match s.rule with
  | .none => Option.some (Scry.ProofNode.mk (Scry.nodeFactOf s) .edb)
  | .some ri =>
    if Nat.lt ri (List.length p.rules) then
      let rule : Scry.Rule L := List.getD p.rules ri Scry.defaultRule;
      let pids : List Nat := Scry.renumberPids steps s.premises;
      match Scry.envOfAtoms p steps rule.body pids Scry.Env.empty with
      | .some env => Option.some (Scry.ProofNode.mk (Scry.nodeFactOf s) (.rule ri env pids))
      | .none => Option.none
    else Option.none

/-- Build the node list for a sorted list of steps, one rule/EDB node each plus a `join`
node for every lattice step with a previous value. The association list maps a step id to
the position of the node that concludes that step's recorded fact. -/
def Scry.nodesOfStepsL {L : Type} (p : Scry.Program L) (steps : List (Scry.ProofStep L)) :
    List (Scry.ProofStep L) → List (Scry.ProofNode L) → List (Nat × Nat) →
      Option (List (Scry.ProofNode L) × List (Nat × Nat))
  | .nil, done, pos => Option.some (done, pos)
  | .cons s rest, done, pos =>
    match Scry.nodeOfStepL p steps s with
    | .none => Option.none
    | .some n =>
      let done1 : List (Scry.ProofNode L) := Scry.appendAll done (List.cons n List.nil);
      let own : Nat := List.length done;
      match s.prev with
      | .none => Scry.nodesOfStepsL p steps rest done1 (List.cons (s.id, own) pos)
      | .some pid =>
        match Scry.posOf pid pos with
        | .none => Option.none
        | .some ppos =>
          let jn : Scry.ProofNode L := Scry.ProofNode.mk s.fact (.join ppos own);
          let done2 : List (Scry.ProofNode L) := Scry.appendAll done1 (List.cons jn List.nil);
          Scry.nodesOfStepsL p steps rest done2 (List.cons (s.id, List.length done1) pos)

/-- **Explain a lattice finding from the evaluator's provenance.** A lattice step records
its rule contribution and the step that established the previous value, so the chain
(`bot → c₀ → c₀ ⊔ c₁ → …`) is rebuilt as alternating rule and `join` nodes; each node's
fact is the accumulated value, so the certificate concludes exactly the value the engine
stored. `.none` means the provenance did not produce a valid certificate (for example when
the lattice's `bot` is not the identity, so the first contribution differs from the stored
value and no join node can absorb it). -/
def Scry.State.explainLat {L : Type} (p : Scry.Program L) (edb : Scry.Db L)
    (st : Scry.State L) (rel : Nat) (key : List U64) : Option (Scry.Derivation L) :=
  match st.whyLat p.ops rel key with
  | .none => Option.none
  | .some root =>
    let steps : List (Scry.ProofStep L) :=
      Scry.sortSteps (Scry.stepsFrom st.nodes (List.cons root.id List.nil) List.nil);
    match Scry.nodesOfStepsL p steps steps List.nil List.nil with
    | .none => Option.none
    | .some (nodes, pos) =>
      match Scry.posOf root.id pos with
      | .none => Option.none
      | .some rootPos =>
        let d : Scry.Derivation L := Scry.Derivation.mk nodes rootPos;
        if Scry.Derivation.check p edb d then Option.some d else Option.none

-- ## Lattice laws and the full proof (all node kinds)

structure Scry.LatLaws {L : Type} (ops : Scry.LatOps L) where
  eq_refl : (a : L) -> ops.eq a a = .true
  eq_sound : (a b : L) -> ops.eq a b = .true -> a = b
  join_idem : (a : L) -> ops.join a a = a
  join_comm : (a b : L) -> ops.join a b = ops.join b a
  join_assoc : (a b c : L) -> ops.join (ops.join a b) c = ops.join a (ops.join b c)
  /-- `bot` is the identity of the join. This is the law behind a lattice
  provenance chain's first contribution: the engine joins every value onto `bot`. -/
  join_bot_left : (a : L) -> ops.join ops.bot a = a
  join_bot_right : (a : L) -> ops.join a ops.bot = a

/-- The value of an `Option L` with `bot` for `none`. -/
def Scry.optLatVal {L : Type} (ops : Scry.LatOps L) : Option L → L
  | .none => ops.bot
  | .some v => v

/-- `latVal` is `optLatVal` of the lookup (definitionally). -/
def Scry.latVal_eq {L : Type} (ops : Scry.LatOps L) (db : Scry.Db L)
    (rel : Nat) (key : List U64) :
    Scry.latVal ops db rel key = Scry.optLatVal ops (Scry.Db.findLat db rel key) := rfl

/-- `bot` is below every value (the left identity law). -/
def Scry.le_bot_left {L : Type} (ops : Scry.LatOps L) (laws : Scry.LatLaws ops)
    (a : L) : Scry.LatOps.le ops ops.bot a = .true :=
  Eq.trans
    (Eq.congrArg (fun x => ops.eq x a) (laws.join_bot_left a))
    (laws.eq_refl a)

/-- `le a a`. -/
def Scry.le_refl {L : Type} (ops : Scry.LatOps L) (laws : Scry.LatLaws ops)
    (a : L) : Scry.LatOps.le ops a a = .true :=
  @Eq.substProp L (fun x => ops.eq x a = .true) a (ops.join a a)
    (Eq.symm (laws.join_idem a)) (laws.eq_refl a)

/-- `le` is transitive. -/
def Scry.le_trans {L : Type} (ops : Scry.LatOps L) (laws : Scry.LatLaws ops)
    (a b c : L) (hab : Scry.LatOps.le ops a b = .true)
    (hbc : Scry.LatOps.le ops b c = .true) : Scry.LatOps.le ops a c = .true :=
  let e1 : ops.join a b = b := laws.eq_sound (ops.join a b) b hab;
  let e2 : ops.join b c = c := laws.eq_sound (ops.join b c) c hbc;
  let s1 : ops.join a c = ops.join a (ops.join b c) :=
    Eq.congrArg (fun x => ops.join a x) (Eq.symm e2);
  let s2 : ops.join a (ops.join b c) = ops.join (ops.join a b) c :=
    Eq.symm (laws.join_assoc a b c);
  let s3 : ops.join (ops.join a b) c = ops.join b c :=
    Eq.congrArg (fun x => ops.join x c) e1;
  let s : ops.join a c = c :=
    Eq.trans s1 (Eq.trans s2 (Eq.trans s3 e2));
  @Eq.substProp L (fun x => ops.eq x c = .true) c (ops.join a c)
    (Eq.symm s) (laws.eq_refl c)

/-- `a` is below `a ⊔ b`. -/
def Scry.join_ub_left {L : Type} (ops : Scry.LatOps L) (laws : Scry.LatLaws ops)
    (a b : L) : Scry.LatOps.le ops a (ops.join a b) = .true :=
  let e1 : ops.join a (ops.join a b) = ops.join (ops.join a a) b :=
    Eq.symm (laws.join_assoc a a b);
  let e2 : ops.join (ops.join a a) b = ops.join a b :=
    Eq.congrArg (fun x => ops.join x b) (laws.join_idem a);
  let e : ops.join a (ops.join a b) = ops.join a b := Eq.trans e1 e2;
  @Eq.substProp L (fun x => ops.eq x (ops.join a b) = .true)
    (ops.join a b) (ops.join a (ops.join a b)) (Eq.symm e)
    (laws.eq_refl (ops.join a b))

/-- `b` is below `a ⊔ b`. -/
def Scry.join_ub_right {L : Type} (ops : Scry.LatOps L) (laws : Scry.LatLaws ops)
    (a b : L) : Scry.LatOps.le ops b (ops.join a b) = .true :=
  let e1 : ops.join b (ops.join a b) = ops.join (ops.join b a) b :=
    Eq.symm (laws.join_assoc b a b);
  let e2 : ops.join (ops.join b a) b = ops.join (ops.join a b) b :=
    Eq.congrArg (fun x => ops.join x b) (laws.join_comm b a);
  let e3 : ops.join (ops.join a b) b = ops.join a (ops.join b b) :=
    laws.join_assoc a b b;
  let e4 : ops.join a (ops.join b b) = ops.join a b :=
    Eq.congrArg (fun x => ops.join a x) (laws.join_idem b);
  let e : ops.join b (ops.join a b) = ops.join a b :=
    Eq.trans e1 (Eq.trans e2 (Eq.trans e3 e4));
  @Eq.substProp L (fun x => ops.eq x (ops.join a b) = .true)
    (ops.join a b) (ops.join b (ops.join a b)) (Eq.symm e)
    (laws.eq_refl (ops.join a b))

/-- The join is the least upper bound. -/
def Scry.join_least {L : Type} (ops : Scry.LatOps L) (laws : Scry.LatLaws ops)
    (a b c : L) (ha : Scry.LatOps.le ops a c = .true)
    (hb : Scry.LatOps.le ops b c = .true) :
    Scry.LatOps.le ops (ops.join a b) c = .true :=
  let e1 : ops.join a c = c := laws.eq_sound (ops.join a c) c ha;
  let e2 : ops.join b c = c := laws.eq_sound (ops.join b c) c hb;
  let s1 : ops.join (ops.join a b) c = ops.join a (ops.join b c) :=
    laws.join_assoc a b c;
  let s2 : ops.join a (ops.join b c) = ops.join a c :=
    Eq.congrArg (fun x => ops.join a x) e2;
  let s : ops.join (ops.join a b) c = c := Eq.trans s1 (Eq.trans s2 e1);
  @Eq.substProp L (fun x => ops.eq x c = .true) c (ops.join (ops.join a b) c)
    (Eq.symm s) (laws.eq_refl c)

/-- A database inclusion is monotone for lattice values: the stored value of a key in
`db` is below its value in any included `db'`. -/
def Scry.latVal_le {L : Type} (ops : Scry.LatOps L) (laws : Scry.LatLaws ops)
    (db db' : Scry.Db L) (hincl : Scry.dbIncl ops db db')
    (rel : Nat) (key : List U64) :
    Scry.LatOps.le ops (Scry.latVal ops db rel key)
      (Scry.latVal ops db' rel key) = .true :=
  hincl (Scry.PFact.mk rel key (.some (Scry.latVal ops db rel key)))
    (Scry.le_refl ops laws (Scry.latVal ops db rel key))

/-- `factEq` is sound: it only compares equal facts.  Written on the fields with the
lattice part as an explicit `Option` (Wiz reduces an inductive match in a proof, but not
a structure match), as `factEqTLat` is. -/
def Scry.factEq_sound {L : Type} (ops : Scry.LatOps L) (laws : Scry.LatLaws ops) :
    (ra : Nat) -> (arga : List U64) -> (la : Option L) ->
    (rb : Nat) -> (argb : List U64) -> (lb : Option L) ->
    Scry.factEq ops (@Scry.PFact.mk L ra arga la) (@Scry.PFact.mk L rb argb lb) = .true ->
    @Scry.PFact.mk L ra arga la = @Scry.PFact.mk L rb argb lb
  | ra, arga, .none, rb, argb, .none, h =>
    let hr : Nat.beq ra rb = .true :=
      Scry.andLeft (Nat.beq ra rb) (Scry.rowEqB arga argb) h;
    let ha : Scry.rowEqB arga argb = .true :=
      Scry.andRight (Nat.beq ra rb) (Scry.rowEqB arga argb) h;
    let e1 : @Scry.PFact.mk L ra arga .none = @Scry.PFact.mk L rb arga .none :=
      Eq.congrArg (fun r => @Scry.PFact.mk L r arga .none)
        (Scry.natBeq_true ra rb hr);
    let e2 : @Scry.PFact.mk L rb arga .none = @Scry.PFact.mk L rb argb .none :=
      Eq.congrArg (fun xs => @Scry.PFact.mk L rb xs .none)
        (Scry.rowEqB_true arga argb ha);
    @Eq.trans (Scry.PFact L)
      (@Scry.PFact.mk L ra arga .none) (@Scry.PFact.mk L rb arga .none)
      (@Scry.PFact.mk L rb argb .none) e1 e2
  | ra, arga, (.some va), rb, argb, (.some vb), h =>
    let hr : Nat.beq ra rb = .true :=
      Scry.andLeft (Nat.beq ra rb)
        (Bool.and (Scry.rowEqB arga argb) (ops.eq va vb)) h;
    let hrest : Bool.and (Scry.rowEqB arga argb) (ops.eq va vb) = .true :=
      Scry.andRight (Nat.beq ra rb)
        (Bool.and (Scry.rowEqB arga argb) (ops.eq va vb)) h;
    let ha : Scry.rowEqB arga argb = .true :=
      Scry.andLeft (Scry.rowEqB arga argb) (ops.eq va vb) hrest;
    let he : ops.eq va vb = .true :=
      Scry.andRight (Scry.rowEqB arga argb) (ops.eq va vb) hrest;
    let e1 : @Scry.PFact.mk L ra arga (.some va) =
        @Scry.PFact.mk L rb arga (.some va) :=
      Eq.congrArg (fun r => @Scry.PFact.mk L r arga (.some va))
        (Scry.natBeq_true ra rb hr);
    let e2 : @Scry.PFact.mk L rb arga (.some va) =
        @Scry.PFact.mk L rb argb (.some va) :=
      Eq.congrArg (fun xs => @Scry.PFact.mk L rb xs (.some va))
        (Scry.rowEqB_true arga argb ha);
    let e3 : @Scry.PFact.mk L rb argb (.some va) =
        @Scry.PFact.mk L rb argb (.some vb) :=
      Eq.congrArg (fun x => @Scry.PFact.mk L rb argb (.some x))
        (laws.eq_sound va vb he);
    @Eq.trans (Scry.PFact L)
      (@Scry.PFact.mk L ra arga (.some va)) (@Scry.PFact.mk L rb arga (.some va))
      (@Scry.PFact.mk L rb argb (.some vb)) e1
      (@Eq.trans (Scry.PFact L)
        (@Scry.PFact.mk L rb arga (.some va)) (@Scry.PFact.mk L rb argb (.some va))
        (@Scry.PFact.mk L rb argb (.some vb)) e2 e3)
  | _, _, .none, _, _, (.some _), h => absurd h.1
  | _, _, (.some _), _, _, .none, h => absurd h.1

/-- `checkHeadEq` soundness: a checked node fact is the rule head's fact under the
certificate's environment. -/
def Scry.checkHeadEq_sound {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops) :
    (head : Scry.Head L) -> (env : Scry.Env L) -> (fact : Scry.PFact L) ->
    Scry.checkHeadEq p head env fact = .true ->
      fact = Scry.headFactOf p head env
  | .tuple rel args, env, fact, h =>
    Scry.factEqT_true rel (Scry.evalTerms env.vals args) fact h
  | .lat rel key val, env, fact, h =>
    @Eq.symm (Scry.PFact L) (Scry.headFactOf p (.lat rel key val) env) fact
      (Scry.factEq_sound p.ops laws
        (Scry.headFactOf p (.lat rel key val) env).rel
        (Scry.headFactOf p (.lat rel key val) env).args
        (Scry.headFactOf p (.lat rel key val) env).lat
        fact.rel fact.args fact.lat h)

/-- `if c then false else t = true` gives both `c = false` and `t = true`. -/
def Scry.ifFalseElse : (c t : Bool) ->
    (if c then Bool.false else t) = .true -> c = .false ∧ t = .true
  | .true, _, h => absurd h.1
  | .false, t, h => (rfl, h)

/-- Whether an atom is a negation. -/
def Scry.Atom.hasNeg : Scry.Atom -> Bool
  | .neg _ _ => .true
  | _ => .false

/-- Whether a body contains a negation (a local, head-first test; unlike `bodyPos` it is
`true` as soon as the head is a negation). -/
def Scry.bodyHasNeg : List Scry.Atom -> Bool
  | .nil => .false
  | .cons a rest =>
    if Scry.Atom.hasNeg a then .true else Scry.bodyHasNeg rest

def Scry.bodyHasNeg_pos (rel : Nat) (args : List Scry.Term) (rest : List Scry.Atom) :
    Scry.bodyHasNeg (List.cons (.pos rel args) rest) = Scry.bodyHasNeg rest := rfl

def Scry.bodyHasNeg_lat (rel : Nat) (key : List Scry.Term) (vv : Nat)
    (rest : List Scry.Atom) :
    Scry.bodyHasNeg (List.cons (.lat rel key vv) rest) = Scry.bodyHasNeg rest := rfl

def Scry.bodyHasNeg_neg (rel : Nat) (args : List Scry.Term) (rest : List Scry.Atom) :
    Scry.bodyHasNeg (List.cons (.neg rel args) rest) = .true := rfl

/-- Every negated atom in the body names a *frozen* relation (the relations whose absent
tuples an extension may not add). This is the checker-side side condition negation needs;
a stratified program freezes its lower-stratum relations. -/
def Scry.bodyNegRelsOk (frozen : Nat -> Bool) : List Scry.Atom -> Bool
  | .nil => .true
  | .cons a rest =>
    match a with
    | .neg rel _ => if frozen rel then Scry.bodyNegRelsOk frozen rest else .false
    | _ => Scry.bodyNegRelsOk frozen rest

def Scry.bodyNegRelsOk_pos (frozen : Nat -> Bool) (rel : Nat) (args : List Scry.Term)
    (rest : List Scry.Atom) :
    Scry.bodyNegRelsOk frozen (List.cons (.pos rel args) rest) =
      Scry.bodyNegRelsOk frozen rest := rfl

def Scry.bodyNegRelsOk_lat (frozen : Nat -> Bool) (rel : Nat) (key : List Scry.Term)
    (vv : Nat) (rest : List Scry.Atom) :
    Scry.bodyNegRelsOk frozen (List.cons (.lat rel key vv) rest) =
      Scry.bodyNegRelsOk frozen rest := rfl

/-- A body with no negation satisfies `bodyNegRelsOk` for every frozen set. -/
def Scry.bodyNegRelsOk_true_of_bodyHasNeg_false (frozen : Nat -> Bool) :
    (body : List Scry.Atom) -> Scry.bodyHasNeg body = .false ->
      Scry.bodyNegRelsOk frozen body = .true
  | .nil, _ => rfl
  | .cons (.pos rel args) rest, h =>
    Eq.trans (Scry.bodyNegRelsOk_pos frozen rel args rest)
      (Scry.bodyNegRelsOk_true_of_bodyHasNeg_false frozen rest
        (Eq.trans (Eq.symm (Scry.bodyHasNeg_pos rel args rest)) h))
  | .cons (.lat rel key vv) rest, h =>
    Eq.trans (Scry.bodyNegRelsOk_lat frozen rel key vv rest)
      (Scry.bodyNegRelsOk_true_of_bodyHasNeg_false frozen rest
        (Eq.trans (Eq.symm (Scry.bodyHasNeg_lat rel key vv rest)) h))
  | .cons (.neg rel args) rest, h => absurd h.1

/-- A predicate on all facts in a node list (generic form of `allInLfp`). -/
def Scry.AllOn {L : Type} (P : Scry.PFact L -> Prop) :
    List (Scry.ProofNode L) -> Prop
  | .nil => True
  | .cons n rest => P n.fact ∧ Scry.AllOn P rest

def Scry.AllOn_append {L : Type} (P : Scry.PFact L -> Prop) :
    (a b : List (Scry.ProofNode L)) -> Scry.AllOn P a -> Scry.AllOn P b ->
      Scry.AllOn P (Scry.appendAll a b)
  | .nil, _, _, hb => hb
  | .cons n rest, b, ha, hb =>
    And.intro ha.1 (Scry.AllOn_append P rest b ha.2 hb)

def Scry.AllOn_single {L : Type} (P : Scry.PFact L -> Prop)
    (n : Scry.ProofNode L) (h : P n.fact) :
    Scry.AllOn P (List.cons n List.nil) :=
  And.intro h True.intro

def Scry.AllOn_getD {L : Type} (P : Scry.PFact L -> Prop) :
    (l : List (Scry.ProofNode L)) -> Scry.AllOn P l -> (i : Nat) ->
      Nat.lt i (List.length l) = .true ->
      P (Scry.ProofNode.fact (List.getD l i Scry.defaultNode))
  | .nil, _, i, hi => absurd (Scry.notLtZero i hi)
  | .cons n rest, ha, .zero, _ => ha.1
  | .cons n rest, ha, .succ j, hi =>
    Scry.AllOn_getD P rest ha.2 j hi

def Scry.AllOn_congr {L : Type} (P : Scry.PFact L -> Prop) :
    (a b : List (Scry.ProofNode L)) -> a = b ->
    Scry.AllOn P a -> Scry.AllOn P b :=
  fun a b e h => @Eq.substProp (List (Scry.ProofNode L)) (fun l => Scry.AllOn P l)
    a b e h

/-- A database extension preserves the absences of `db` on the `frozen` relations: a
tuple of a frozen relation absent from `db` is absent from `db'`. A stratum's lower
relations are exactly such an extension (see the notes). -/
def Scry.NegTransfer {L : Type} (frozen : Nat -> Bool) (db db' : Scry.Db L) : Prop :=
  (rel : Nat) -> frozen rel = .true -> (row : List U64) ->
    Scry.Db.memTuple db rel row = .false ->
    Scry.Db.memTuple db' rel row = .false

/-- A fact is in the least fixpoint *of the extensions that satisfy `agree`*: it holds in
every database containing `db`, closed under the rules, and satisfying `agree`. With
`agree` the empty predicate this is vacuous; with `agree = NegTransfer db` it is the
stratified reading of a derivation at one stratum. -/
def Scry.inLfpAgree {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (agree : Scry.Db L -> Prop) (f : Scry.PFact L) : Prop :=
  (db' : Scry.Db L) -> Scry.dbIncl p.ops db db' -> Scry.closed p db' ->
    agree db' -> Scry.factHolds p.ops db' f

/-- The semantics used by the full checker: extensions that add no tuple absent from
the EDB on the frozen relations. A stratified program freezes its lower-stratum
relations, so a negated atom sees exactly the completed lower model. -/
def Scry.inLfpNeg {L : Type} (p : Scry.Program L) (frozen : Nat -> Bool)
    (db : Scry.Db L) (f : Scry.PFact L) : Prop :=
  Scry.inLfpAgree p db (Scry.NegTransfer frozen db) f

/-- A `match` on an `Option` known to be `none` is its default. -/
def Scry.matchNone_eq {A B : Type} (o : Option A) (d : B) (f : A -> B)
    (he : o = .none) :
    (match o with | .none => d | .some a => f a) = d :=
  @Eq.substProp (Option A)
    (fun x => (match x with | .none => d | .some a => f a) = d)
    .none o (Eq.symm he) rfl

/-- A `match` on an `Option` known to be `some a` is the `some` branch. -/
def Scry.matchSome_eq {A B : Type} (o : Option A) (a : A) (d : B) (f : A -> B)
    (he : o = .some a) :
    (match o with | .none => d | .some a => f a) = f a :=
  @Eq.substProp (Option A)
    (fun x => (match x with | .none => d | .some a => f a) = f a)
    (.some a) o (Eq.symm he) rfl

/-- The `lat` branch's Boolean test, with the looked-up value passed explicitly (so a
proof can case on it as a variable). -/
def Scry.checkLatMatchB {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (env : Scry.Env L) (done : List (Scry.ProofNode L))
    (rel : Nat) (key : List Scry.Term) (rest : List Scry.Atom)
    (ps : List Nat) (pid : Nat) (o : Option L) : Bool :=
  match o with
  | .none => Bool.false
  | .some v =>
    if Scry.factEq p.ops
        (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v))
        (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
      then Scry.checkAtoms p db env done rest ps else Bool.false

/-- The lattice atom's meaning, with its matched value passed explicitly (so the proof can
case on the `Option` as a variable). -/
def Scry.latHoldsAt {L : Type} (p : Scry.Program L) (db' : Scry.Db L)
    (rel : Nat) (key : List U64) (o : Option L) : Prop :=
  match o with
  | .none => False
  | .some v => Scry.factHolds p.ops db' (Scry.PFact.mk rel key (.some v))

/-- One checked `lat` atom: the value lookup succeeded, the premise matches the body
fact, and the premise is in the least fixpoint, so the atom holds. -/
def Scry.checkLatAtom_sound {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (db : Scry.Db L) (agree : Scry.Db L -> Prop) (db' : Scry.Db L)
    (hincl : Scry.dbIncl p.ops db db') (hclosed : Scry.closed p db')
    (hagree : agree db') (env : Scry.Env L) (done : List (Scry.ProofNode L))
    (rel : Nat) (key : List Scry.Term) (vv : Nat) (rest : List Scry.Atom)
    (ps : List Nat) (pid : Nat)
    (hdone : Scry.AllOn (Scry.inLfpAgree p db agree) done)
    (hbound : Nat.lt pid (List.length done) = .true) :
    (o : Option L) ->
    (hm : Scry.checkLatMatchB p db env done rel key rest ps pid o = .true) ->
    Scry.latHoldsAt p db' rel (Scry.evalTerms env.vals key) o ∧
      Scry.checkAtoms p db env done rest ps = .true
  | .none, hm => absurd hm.1
  | .some v, hm =>
    let hf : Scry.factEq p.ops
          (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v))
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)) = .true ∧
        Scry.checkAtoms p db env done rest ps = .true :=
      Scry.ifTrueAnd (Scry.factEq p.ops
          (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v))
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)))
        (Scry.checkAtoms p db env done rest ps) hm;
    let hprem : Scry.inLfpAgree p db agree
        (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)) :=
      Scry.AllOn_getD (Scry.inLfpAgree p db agree) done hdone pid hbound;
    let heq : Scry.ProofNode.fact (List.getD done pid Scry.defaultNode) =
        Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v) :=
      @Eq.symm (Scry.PFact L)
        (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v))
        (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
        (Scry.factEq_sound p.ops laws
          (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v)).rel
          (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v)).args
          (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v)).lat
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)).rel
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)).args
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)).lat hf.1);
    And.intro
      (Scry.factHolds_congr p.ops db'
        (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
        (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v)) heq
        (hprem db' hincl hclosed hagree))
      hf.2

/-- **A checked body holds in every relevant extension**: if every premise fact is in the
least fixpoint of the extensions satisfying `agree`, then the body holds in a particular
such extension `db'`. The `hneg` argument supplies the absence of a checked negated tuple
in `db'` for the frozen relations, and `hok` says every negated atom of the body names a
frozen relation; both are vacuous for bodies without negations. -/
def Scry.checkAtoms_sound_all {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (db : Scry.Db L) (agree : Scry.Db L -> Prop) (frozen : Nat -> Bool)
    (db' : Scry.Db L)
    (hincl : Scry.dbIncl p.ops db db') (hclosed : Scry.closed p db')
    (hagree : agree db') (env : Scry.Env L) (done : List (Scry.ProofNode L)) :
    (body : List Scry.Atom) -> (pids : List Nat) ->
    Scry.AllOn (Scry.inLfpAgree p db agree) done ->
    ((rel : Nat) -> (row : List U64) -> frozen rel = .true ->
      Scry.Db.memTuple db rel row = .false ->
      Scry.Db.memTuple db' rel row = .false) ->
    Scry.bodyNegRelsOk frozen body = .true ->
    Scry.checkAtoms p db env done body pids = .true ->
    Scry.bodyHolds p db' body env
  | .nil, .nil, _, _, _, _ => True.intro
  | .nil, .cons _ _, _, _, _, hcheck => absurd hcheck.1
  | .cons (.pos rel args) rest, .nil, _, _, _, hcheck => absurd hcheck.1
  | .cons (.pos rel args) rest, .cons pid ps, hdone, hneg, hok, hcheck =>
    let hokRest : Scry.bodyNegRelsOk frozen rest = .true :=
      Eq.trans (Eq.symm (Scry.bodyNegRelsOk_pos frozen rel args rest)) hok;
    let hb : Nat.lt pid (List.length done) = .true ∧
        (if Scry.factEqT rel (Scry.evalTerms env.vals args)
            (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
          then Scry.checkAtoms p db env done rest ps else Bool.false) = .true :=
      Scry.ifTrueAnd (Nat.lt pid (List.length done))
        (if Scry.factEqT rel (Scry.evalTerms env.vals args)
            (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
          then Scry.checkAtoms p db env done rest ps else Bool.false) hcheck;
    let hf : Scry.factEqT rel (Scry.evalTerms env.vals args)
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)) = .true ∧
        Scry.checkAtoms p db env done rest ps = .true :=
      Scry.ifTrueAnd (Scry.factEqT rel (Scry.evalTerms env.vals args)
          (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)))
        (Scry.checkAtoms p db env done rest ps) hb.2;
    let hprem : Scry.inLfpAgree p db agree
        (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)) :=
      Scry.AllOn_getD (Scry.inLfpAgree p db agree) done hdone pid hb.1;
    let heq : Scry.ProofNode.fact (List.getD done pid Scry.defaultNode) =
        Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none :=
      Scry.factEqT_true rel (Scry.evalTerms env.vals args)
        (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode)) hf.1;
    let hfh : Scry.factHolds p.ops db'
        (Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none) :=
      Scry.factHolds_congr p.ops db'
        (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
        (Scry.PFact.mk rel (Scry.evalTerms env.vals args) .none) heq
        (hprem db' hincl hclosed hagree);
    let hrestHolds : Scry.bodyHolds p db' rest env :=
      @Scry.checkAtoms_sound_all L p laws db agree frozen db' hincl hclosed hagree env done
        rest ps hdone hneg hokRest hf.2;
    And.intro hfh hrestHolds
  | .cons (.lat rel key vv) rest, .nil, _, _, _, hcheck => absurd hcheck.1
  | .cons (.lat rel key vv) rest, .cons pid ps, hdone, hneg, hok, hcheck =>
    let hokRest : Scry.bodyNegRelsOk frozen rest = .true :=
      Eq.trans (Eq.symm (Scry.bodyNegRelsOk_lat frozen rel key vv rest)) hok;
    let hb : Nat.lt pid (List.length done) = .true ∧
        (match Scry.envGet vv env.lats with
         | .none => Bool.false
         | .some v =>
           if Scry.factEq p.ops
               (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v))
               (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
             then Scry.checkAtoms p db env done rest ps else Bool.false) = .true :=
      Scry.ifTrueAnd (Nat.lt pid (List.length done))
        (match Scry.envGet vv env.lats with
         | .none => Bool.false
         | .some v =>
           if Scry.factEq p.ops
               (Scry.PFact.mk rel (Scry.evalTerms env.vals key) (.some v))
               (Scry.ProofNode.fact (List.getD done pid Scry.defaultNode))
             then Scry.checkAtoms p db env done rest ps else Bool.false) hcheck;
    let hres := Scry.checkLatAtom_sound p laws db agree db' hincl hclosed hagree env done
        rel key vv rest ps pid hdone hb.1 (Scry.envGet vv env.lats) hb.2;
    let hrestHolds : Scry.bodyHolds p db' rest env :=
      @Scry.checkAtoms_sound_all L p laws db agree frozen db' hincl hclosed hagree env done
        rest ps hdone hneg hokRest hres.2;
    And.intro hres.1 hrestHolds
  | .cons (.neg rel args) rest, _, hdone, hneg, hok, hcheck =>
    let hb : Scry.Db.memTuple db rel (Scry.evalTerms env.vals args) = .false ∧
        Scry.checkAtoms p db env done rest _ = .true :=
      Scry.ifFalseElse (Scry.Db.memTuple db rel (Scry.evalTerms env.vals args))
        (Scry.checkAtoms p db env done rest _) hcheck;
    let hfok : frozen rel = .true ∧ Scry.bodyNegRelsOk frozen rest = .true :=
      Scry.ifTrueAnd (frozen rel) (Scry.bodyNegRelsOk frozen rest) hok;
    let hnegt : Scry.Db.memTuple db' rel (Scry.evalTerms env.vals args) = .false :=
      hneg rel (Scry.evalTerms env.vals args) hfok.1 hb.1;
    let hrestHolds : Scry.bodyHolds p db' rest env :=
      @Scry.checkAtoms_sound_all L p laws db agree frozen db' hincl hclosed hagree env done
        rest _ hdone hneg hfok.2 hb.2;
    And.intro hnegt hrestHolds

/-- **A checked join's fields**: all three facts are lattice facts and the conclusion is
their join. -/
def Scry.checkJoin_fields {L : Type} (p : Scry.Program L)
    (ra : Nat) (arga : List U64) (va : L)
    (rb : Nat) (argb : List U64) (vb : L)
    (rf : Nat) (argf : List U64) (v : L)
    (h : Scry.checkJoin p
      (Scry.PFact.mk ra arga (.some va))
      (Scry.PFact.mk rb argb (.some vb))
      (Scry.PFact.mk rf argf (.some v)) = .true) :
    Nat.beq ra rb = .true ∧ Nat.beq rf ra = .true ∧
      Scry.rowEqB arga argb = .true ∧ Scry.rowEqB argf arga = .true ∧
      p.ops.eq v (p.ops.join va vb) = .true :=
  let h1 : Nat.beq ra rb = .true ∧
      (if Nat.beq rf ra then
        (if Scry.rowEqB arga argb then
          (if Scry.rowEqB argf arga then p.ops.eq v (p.ops.join va vb) else Bool.false)
         else Bool.false)
       else Bool.false) = .true :=
    Scry.ifTrueAnd (Nat.beq ra rb)
      (if Nat.beq rf ra then
        (if Scry.rowEqB arga argb then
          (if Scry.rowEqB argf arga then p.ops.eq v (p.ops.join va vb) else Bool.false)
         else Bool.false)
       else Bool.false) h;
  let h2 : Nat.beq rf ra = .true ∧
      (if Scry.rowEqB arga argb then
        (if Scry.rowEqB argf arga then p.ops.eq v (p.ops.join va vb) else Bool.false)
       else Bool.false) = .true :=
    Scry.ifTrueAnd (Nat.beq rf ra)
      (if Scry.rowEqB arga argb then
        (if Scry.rowEqB argf arga then p.ops.eq v (p.ops.join va vb) else Bool.false)
       else Bool.false) h1.2;
  let h3 : Scry.rowEqB arga argb = .true ∧
      (if Scry.rowEqB argf arga then p.ops.eq v (p.ops.join va vb) else Bool.false) = .true :=
    Scry.ifTrueAnd (Scry.rowEqB arga argb)
      (if Scry.rowEqB argf arga then p.ops.eq v (p.ops.join va vb) else Bool.false) h2.2;
  let h4 : Scry.rowEqB argf arga = .true ∧
      p.ops.eq v (p.ops.join va vb) = .true :=
    Scry.ifTrueAnd (Scry.rowEqB argf arga)
      (p.ops.eq v (p.ops.join va vb)) h3.2;
  (h1.1, h2.1, h3.1, h4.1, h4.2)

/-- **A checked join is in the least fixpoint**: the join of two facts in the least
fixpoint is below the key's stored value in every relevant extension. -/
def Scry.checkJoin_sound {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (db : Scry.Db L) (agree : Scry.Db L -> Prop)
    (ra : Nat) (arga : List U64) (va : L)
    (rb : Nat) (argb : List U64) (vb : L)
    (rf : Nat) (argf : List U64) (v : L)
    (hfa : Scry.inLfpAgree p db agree (Scry.PFact.mk ra arga (.some va)))
    (hfb : Scry.inLfpAgree p db agree (Scry.PFact.mk rb argb (.some vb)))
    (hcheck : Scry.checkJoin p
      (Scry.PFact.mk ra arga (.some va))
      (Scry.PFact.mk rb argb (.some vb))
      (Scry.PFact.mk rf argf (.some v)) = .true) :
    Scry.inLfpAgree p db agree (Scry.PFact.mk rf argf (.some v)) :=
  let hf := Scry.checkJoin_fields p ra arga va rb argb vb rf argf v hcheck;
  let erel : ra = rb := Scry.natBeq_true ra rb hf.1;
  let efr : rf = ra := Scry.natBeq_true rf ra hf.2.1;
  let earg : arga = argb := Scry.rowEqB_true arga argb hf.2.2.1;
  let efarg : argf = arga := Scry.rowEqB_true argf arga hf.2.2.2.1;
  let ev : v = p.ops.join va vb := laws.eq_sound v (p.ops.join va vb) hf.2.2.2.2;
  fun db' hincl hclosed hagree =>
    let ha : Scry.factHolds p.ops db'
        (Scry.PFact.mk ra arga (.some va)) := hfa db' hincl hclosed hagree;
    let hb0 : Scry.factHolds p.ops db'
        (Scry.PFact.mk rb argb (.some vb)) := hfb db' hincl hclosed hagree;
    let hb1 : Scry.factHolds p.ops db'
        (Scry.PFact.mk ra argb (.some vb)) :=
      Scry.factHolds_congr p.ops db'
        (Scry.PFact.mk rb argb (.some vb)) (Scry.PFact.mk ra argb (.some vb))
        (Eq.congrArg (fun r => Scry.PFact.mk r argb (.some vb)) (Eq.symm erel)) hb0;
    let hb : Scry.factHolds p.ops db'
        (Scry.PFact.mk ra arga (.some vb)) :=
      Scry.factHolds_congr p.ops db'
        (Scry.PFact.mk ra argb (.some vb)) (Scry.PFact.mk ra arga (.some vb))
        (Eq.congrArg (fun xs => Scry.PFact.mk ra xs (.some vb)) (Eq.symm earg)) hb1;
    let hjl : Scry.factHolds p.ops db'
        (Scry.PFact.mk ra arga (.some (p.ops.join va vb))) :=
      Scry.join_least p.ops laws va vb (Scry.latVal p.ops db' ra arga) ha hb;
    let hjoin : Scry.factHolds p.ops db'
        (Scry.PFact.mk ra arga (.some v)) :=
      Scry.factHolds_congr p.ops db'
        (Scry.PFact.mk ra arga (.some (p.ops.join va vb)))
        (Scry.PFact.mk ra arga (.some v))
        (Eq.congrArg (fun x => Scry.PFact.mk ra arga (.some x)) (Eq.symm ev)) hjl;
    @Eq.substProp (List U64)
      (fun x => Scry.factHolds p.ops db' (Scry.PFact.mk rf x (.some v)))
      arga argf (Eq.symm efarg)
      (@Eq.substProp Nat
        (fun x => Scry.factHolds p.ops db' (Scry.PFact.mk x arga (.some v)))
        ra rf (Eq.symm efr) hjoin)

/-- `checkJoin_sound` on arbitrary facts: the mixed tuple/lattice cases are rejected by
the checker. -/
def Scry.checkJoin_sound_facts {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (db : Scry.Db L) (agree : Scry.Db L -> Prop) :
    (ra : Nat) -> (arga : List U64) -> (la : Option L) ->
    (rb : Nat) -> (argb : List U64) -> (lb : Option L) ->
    (rf : Nat) -> (argf : List U64) -> (lf : Option L) ->
    Scry.inLfpAgree p db agree (Scry.PFact.mk ra arga la) ->
    Scry.inLfpAgree p db agree (Scry.PFact.mk rb argb lb) ->
    Scry.checkJoin p (Scry.PFact.mk ra arga la) (Scry.PFact.mk rb argb lb)
      (Scry.PFact.mk rf argf lf) = .true ->
    Scry.inLfpAgree p db agree (Scry.PFact.mk rf argf lf)
  | ra, arga, .some va, rb, argb, .some vb, rf, argf, .some v, hfa, hfb, hcheck =>
    Scry.checkJoin_sound p laws db agree ra arga va rb argb vb rf argf v
      hfa hfb hcheck
  | _, _, .none, _, _, _, _, _, _, _, _, hcheck => absurd hcheck.1
  | _, _, .some _, _, _, .none, _, _, _, _, _, hcheck => absurd hcheck.1
  | _, _, .some _, _, _, .some _, _, _, .none, _, _, hcheck => absurd hcheck.1

/-- **A checked rule instance's fact is in the least fixpoint** (all rule shapes). -/
def Scry.checkRuleParts_sound_all {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (db : Scry.Db L) (agree : Scry.Db L -> Prop) (frozen : Nat -> Bool)
    (done : List (Scry.ProofNode L))
    (hdone : Scry.AllOn (Scry.inLfpAgree p db agree) done) :
    (ri : Nat) -> (hri : Nat.lt ri (List.length p.rules) = .true) ->
    (head : Scry.Head L) ->
    (hheadEq : (List.getD p.rules ri Scry.defaultRule).head = head) ->
    (body : List Scry.Atom) ->
    (hbodyEq : (List.getD p.rules ri Scry.defaultRule).body = body) ->
    (env : Scry.Env L) -> (pids : List Nat) -> (fact : Scry.PFact L) ->
    ((db' : Scry.Db L) -> agree db' -> (rel : Nat) -> (row : List U64) ->
      frozen rel = .true -> Scry.Db.memTuple db rel row = .false ->
      Scry.Db.memTuple db' rel row = .false) ->
    Scry.bodyNegRelsOk frozen body = .true ->
    Scry.checkRuleParts p db done fact head body env pids = .true ->
    Scry.inLfpAgree p db agree fact
  | ri, hri, head, hheadEq, body, hbodyEq, env, pids, fact, hnegAll, hok, hcheck =>
    fun db' hincl hclosed hagree =>
      let hca : Scry.checkAtoms p db env done body pids = .true ∧
          Scry.checkHeadEq p head env fact = .true :=
        Scry.ifTrueAnd (Scry.checkAtoms p db env done body pids)
          (Scry.checkHeadEq p head env fact) hcheck;
      let hb : Scry.bodyHolds p db' body env :=
        Scry.checkAtoms_sound_all p laws db agree frozen db' hincl hclosed hagree env done
          body pids hdone (hnegAll db' hagree) hok hca.1;
      let hbGet : Scry.bodyHolds p db'
          (List.getD p.rules ri Scry.defaultRule).body env :=
        @Eq.mpr' (List Scry.Atom)
          (List.getD p.rules ri Scry.defaultRule).body body
          (fun b => Scry.bodyHolds p db' b env) hbodyEq hb;
      let hfhGet : Scry.factHolds p.ops db'
          (Scry.headFact p (List.getD p.rules ri Scry.defaultRule) env) :=
        hclosed ri env hri hbGet;
      let hheadFactEq : Scry.headFact p (List.getD p.rules ri Scry.defaultRule) env =
          Scry.headFactOf p head env :=
        Eq.congrArg (fun hd => Scry.headFactOf p hd env) hheadEq;
      let hfhHead : Scry.factHolds p.ops db' (Scry.headFactOf p head env) :=
        Scry.factHolds_congr p.ops db'
          (Scry.headFact p (List.getD p.rules ri Scry.defaultRule) env)
          (Scry.headFactOf p head env) hheadFactEq hfhGet;
      let heq : fact = Scry.headFactOf p head env :=
        Scry.checkHeadEq_sound p laws head env fact hca.2;
      Scry.factHolds_congr p.ops db'
        (Scry.headFactOf p head env) fact
        (@Eq.symm (Scry.PFact L) fact (Scry.headFactOf p head env) heq) hfhHead

/-- **A checked node is in the least fixpoint** (all node kinds). -/
def Scry.checkNode_sound_all {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (db : Scry.Db L) (agree : Scry.Db L -> Prop) (frozen : Nat -> Bool)
    (done : List (Scry.ProofNode L))
    (hdone : Scry.AllOn (Scry.inLfpAgree p db agree) done) :
    (fact : Scry.PFact L) -> (kind : Scry.ProofKind L) ->
    ((db' : Scry.Db L) -> agree db' -> (ri : Nat) ->
      (hri : Nat.lt ri (List.length p.rules) = .true) ->
      Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true ->
      (rel : Nat) -> (row : List U64) -> frozen rel = .true ->
      Scry.Db.memTuple db rel row = .false ->
      Scry.Db.memTuple db' rel row = .false) ->
    ((ri : Nat) -> (hri : Nat.lt ri (List.length p.rules) = .true) ->
      Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true) ->
    Scry.checkNode p db done fact kind = .true ->
    Scry.inLfpAgree p db agree fact
  | fact, .edb, _hneg, _hokRule, hcheck =>
    fun db' hincl _hclosed _hagree => hincl fact (Scry.factInDb_true p db fact hcheck)
  | fact, .rule ri env pids, hneg, hokRule, hcheck =>
    let hb : Nat.lt ri (List.length p.rules) = .true ∧
        Scry.checkRuleParts p db done fact
          (List.getD p.rules ri Scry.defaultRule).head
          (List.getD p.rules ri Scry.defaultRule).body env pids = .true :=
      Scry.ifTrueAnd (Nat.lt ri (List.length p.rules))
        (Scry.checkRuleParts p db done fact
          (List.getD p.rules ri Scry.defaultRule).head
          (List.getD p.rules ri Scry.defaultRule).body env pids) hcheck;
    Scry.checkRuleParts_sound_all p laws db agree frozen done hdone
      ri hb.1
      (List.getD p.rules ri Scry.defaultRule).head rfl
      (List.getD p.rules ri Scry.defaultRule).body rfl
      env pids fact
      (fun db' ha rel row hfrozen hfalse =>
        hneg db' ha ri hb.1 (hokRule ri hb.1) rel row hfrozen hfalse)
      (hokRule ri hb.1)
      hb.2
  | fact, .join left right, _hneg, _hokRule, hcheck =>
    let h1 : Nat.lt left (List.length done) = .true ∧
        (if Nat.lt right (List.length done) then
          Scry.checkJoin p
            (Scry.ProofNode.fact (List.getD done left Scry.defaultNode))
            (Scry.ProofNode.fact (List.getD done right Scry.defaultNode)) fact
         else Bool.false) = .true :=
      Scry.ifTrueAnd (Nat.lt left (List.length done))
        (if Nat.lt right (List.length done) then
          Scry.checkJoin p
            (Scry.ProofNode.fact (List.getD done left Scry.defaultNode))
            (Scry.ProofNode.fact (List.getD done right Scry.defaultNode)) fact
         else Bool.false) hcheck;
    let h2 : Nat.lt right (List.length done) = .true ∧
        Scry.checkJoin p
          (Scry.ProofNode.fact (List.getD done left Scry.defaultNode))
          (Scry.ProofNode.fact (List.getD done right Scry.defaultNode)) fact = .true :=
      Scry.ifTrueAnd (Nat.lt right (List.length done))
        (Scry.checkJoin p
          (Scry.ProofNode.fact (List.getD done left Scry.defaultNode))
          (Scry.ProofNode.fact (List.getD done right Scry.defaultNode)) fact) h1.2;
    let hfa : Scry.inLfpAgree p db agree
        (Scry.ProofNode.fact (List.getD done left Scry.defaultNode)) :=
      Scry.AllOn_getD (Scry.inLfpAgree p db agree) done hdone left h1.1;
    let hfb : Scry.inLfpAgree p db agree
        (Scry.ProofNode.fact (List.getD done right Scry.defaultNode)) :=
      Scry.AllOn_getD (Scry.inLfpAgree p db agree) done hdone right h2.1;
    let fa := Scry.ProofNode.fact (List.getD done left Scry.defaultNode);
    let fb := Scry.ProofNode.fact (List.getD done right Scry.defaultNode);
    Scry.checkJoin_sound_facts p laws db agree
      fa.rel fa.args fa.lat fb.rel fb.args fb.lat fact.rel fact.args fact.lat
      hfa hfb h2.2

/-- Transport `inLfpAgree` along an equality of facts. -/
def Scry.inLfpAgree_congr {L : Type} (p : Scry.Program L) (db : Scry.Db L)
    (agree : Scry.Db L -> Prop) :
    (f g : Scry.PFact L) -> f = g ->
    Scry.inLfpAgree p db agree f -> Scry.inLfpAgree p db agree g :=
  fun f g e h => @Eq.substProp (Scry.PFact L)
    (fun x => Scry.inLfpAgree p db agree x) f g e h

/-- **Every checked node is in the least fixpoint** (the list induction, all node
kinds). -/
def Scry.checkNodes_sound_all {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (db : Scry.Db L) (agree : Scry.Db L -> Prop) (frozen : Nat -> Bool)
    (hneg : (db' : Scry.Db L) -> agree db' -> (ri : Nat) ->
      (hri : Nat.lt ri (List.length p.rules) = .true) ->
      Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true ->
      (rel : Nat) -> (row : List U64) -> frozen rel = .true ->
      Scry.Db.memTuple db rel row = .false ->
      Scry.Db.memTuple db' rel row = .false)
    (hokRule : (ri : Nat) -> (hri : Nat.lt ri (List.length p.rules) = .true) ->
      Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true) :
    (done nodes : List (Scry.ProofNode L)) ->
    Scry.AllOn (Scry.inLfpAgree p db agree) done ->
    Scry.checkNodes p db done nodes = .true ->
    Scry.AllOn (Scry.inLfpAgree p db agree) (Scry.appendAll done nodes)
  | done, .nil, hdone, _ =>
    Scry.AllOn_congr (Scry.inLfpAgree p db agree) done
      (Scry.appendAll done List.nil) (Eq.symm (Scry.append_nil done)) hdone
  | done, .cons n rest, hdone, hcheck =>
    let hcn : Scry.checkNode p db done n.fact n.kind = .true ∧
        Scry.checkNodes p db (Scry.appendAll done (List.cons n List.nil)) rest = .true :=
      Scry.ifTrueAnd (Scry.checkNode p db done n.fact n.kind)
        (Scry.checkNodes p db (Scry.appendAll done (List.cons n List.nil)) rest) hcheck;
    let hnode : Scry.inLfpAgree p db agree n.fact :=
      Scry.checkNode_sound_all p laws db agree frozen done hdone
        n.fact n.kind hneg hokRule hcn.1;
    let hdone' : Scry.AllOn (Scry.inLfpAgree p db agree)
        (Scry.appendAll done (List.cons n List.nil)) :=
      Scry.AllOn_append (Scry.inLfpAgree p db agree) done (List.cons n List.nil) hdone
        (Scry.AllOn_single (Scry.inLfpAgree p db agree) n hnode);
    let hrestAll : Scry.AllOn (Scry.inLfpAgree p db agree)
        (Scry.appendAll (Scry.appendAll done (List.cons n List.nil)) rest) :=
      Scry.checkNodes_sound_all p laws db agree frozen hneg hokRule
        (Scry.appendAll done (List.cons n List.nil)) rest hdone' hcn.2;
    Scry.AllOn_congr (Scry.inLfpAgree p db agree)
      (Scry.appendAll (Scry.appendAll done (List.cons n List.nil)) rest)
      (Scry.appendAll done (List.cons n rest))
      (Scry.append_assoc done (List.cons n List.nil) rest) hrestAll

/-- **`Derivation.check` is sound for all node kinds**, in the absence-preserving
semantics: for any frozen set that contains every relation the program negates, the
conclusion is in the least fixpoint of the extensions that add no absent tuple of a
frozen relation. -/
def Scry.checkSoundNegStmt {L : Type} (p : Scry.Program L) (frozen : Nat -> Bool)
    (hokRule : (ri : Nat) -> (hri : Nat.lt ri (List.length p.rules) = .true) ->
      Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true) :
    Prop :=
  (db : Scry.Db L) -> (d : Scry.Derivation L) -> (f : Scry.PFact L) ->
    Scry.Derivation.concl d = .some f ->
    Scry.Derivation.check p db d = .true ->
    Scry.inLfpNeg p frozen db f

/-- The full soundness theorem (negation handled by frozen relations, lattice facts by
`LatLaws`). -/
def Scry.check_sound_neg {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (frozen : Nat -> Bool)
    (hokRule : (ri : Nat) -> (hri : Nat.lt ri (List.length p.rules) = .true) ->
      Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true) :
    Scry.checkSoundNegStmt p frozen hokRule :=
  fun db d f hconcl hcheck =>
    let hb : Nat.lt d.root (List.length d.nodes) = .true ∧
        Scry.checkNodes p db List.nil d.nodes = .true :=
      Scry.ifTrueAnd (Nat.lt d.root (List.length d.nodes))
        (Scry.checkNodes p db List.nil d.nodes) hcheck;
    let hneg : (db' : Scry.Db L) -> Scry.NegTransfer frozen db db' -> (ri : Nat) ->
        (hri : Nat.lt ri (List.length p.rules) = .true) ->
        Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true ->
        (rel : Nat) -> (row : List U64) -> frozen rel = .true ->
        Scry.Db.memTuple db rel row = .false ->
        Scry.Db.memTuple db' rel row = .false :=
      fun db' ha _ _ _ rel row hfrozen hfalse => ha rel hfrozen row hfalse;
    let hnodes : Scry.AllOn (Scry.inLfpAgree p db (Scry.NegTransfer frozen db))
        (Scry.appendAll List.nil d.nodes) :=
      Scry.checkNodes_sound_all p laws db (Scry.NegTransfer frozen db) frozen hneg hokRule
        List.nil d.nodes True.intro hb.2;
    let hnodes' : Scry.AllOn (Scry.inLfpAgree p db (Scry.NegTransfer frozen db)) d.nodes :=
      Scry.AllOn_congr (Scry.inLfpAgree p db (Scry.NegTransfer frozen db))
        (Scry.appendAll List.nil d.nodes) d.nodes rfl hnodes;
    let hroot : Scry.inLfpAgree p db (Scry.NegTransfer frozen db)
        (Scry.ProofNode.fact (List.getD d.nodes d.root Scry.defaultNode)) :=
      Scry.AllOn_getD (Scry.inLfpAgree p db (Scry.NegTransfer frozen db)) d.nodes hnodes'
        d.root hb.1;
    Scry.inLfpAgree_congr p db (Scry.NegTransfer frozen db)
      (Scry.ProofNode.fact (List.getD d.nodes d.root Scry.defaultNode)) f
      hconcl.1 hroot

/-- `Bool.not b = true` gives `b = false`. -/
def Scry.not_true_false : (b : Bool) -> Bool.not b = .true -> b = .false
  | .true, h => absurd h.1
  | .false, _ => rfl

/-- A rule body has no negation. -/
def Scry.Rule.negFree {L : Type} (r : Scry.Rule L) : Bool :=
  Bool.not (Scry.bodyHasNeg r.body)

/-- Every rule body of a program has no negation. -/
def Scry.Program.negFree {L : Type} (p : Scry.Program L) : Bool :=
  Scry.allB Scry.Rule.negFree p.rules

/-- A valid rule of a neg-free program has a neg-free body. -/
def Scry.ruleNegFree_of_program {L : Type} (p : Scry.Program L)
    (hp : Scry.Program.negFree p = .true) (ri : Nat)
    (hri : Nat.lt ri (List.length p.rules) = .true) :
    Scry.bodyHasNeg (List.getD p.rules ri Scry.defaultRule).body = .false :=
  Scry.not_true_false (Scry.bodyHasNeg (List.getD p.rules ri Scry.defaultRule).body)
    (Scry.allB_getD Scry.Rule.negFree Scry.defaultRule p.rules hp ri hri)

/-- The old, unconditional `inLfp` statement for programs without negation. -/
def Scry.checkSoundNegFreeStmt {L : Type} (p : Scry.Program L) : Prop :=
  (db : Scry.Db L) -> (d : Scry.Derivation L) -> (f : Scry.PFact L) ->
    Scry.Derivation.concl d = .some f ->
    Scry.Derivation.check p db d = .true ->
    Scry.inLfp p db f

/-- **`Derivation.check` is sound for negation-free programs** (lattice rules and join
nodes included): the conclusion is in the least fixpoint in the original sense. -/
def Scry.check_sound_negFree {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (hp : Scry.Program.negFree p = .true) : Scry.checkSoundNegFreeStmt p :=
  fun db d f hconcl hcheck =>
    let frozen : Nat -> Bool := fun _ => Bool.false;
    let hokRule : (ri : Nat) -> (hri : Nat.lt ri (List.length p.rules) = .true) ->
        Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true :=
      fun ri hri =>
        Scry.bodyNegRelsOk_true_of_bodyHasNeg_false frozen
          (List.getD p.rules ri Scry.defaultRule).body
          (Scry.ruleNegFree_of_program p hp ri hri);
    let hb : Nat.lt d.root (List.length d.nodes) = .true ∧
        Scry.checkNodes p db List.nil d.nodes = .true :=
      Scry.ifTrueAnd (Nat.lt d.root (List.length d.nodes))
        (Scry.checkNodes p db List.nil d.nodes) hcheck;
    let hneg : (db' : Scry.Db L) -> True -> (ri : Nat) ->
        (hri : Nat.lt ri (List.length p.rules) = .true) ->
        Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true ->
        (rel : Nat) -> (row : List U64) -> frozen rel = .true ->
        Scry.Db.memTuple db rel row = .false ->
        Scry.Db.memTuple db' rel row = .false :=
      fun db' _ ri hri hok rel row hfrozen hfalse => absurd hfrozen.1;
    let hnodes : Scry.AllOn (Scry.inLfpAgree p db (fun _ => True))
        (Scry.appendAll List.nil d.nodes) :=
      Scry.checkNodes_sound_all p laws db (fun _ => True) frozen hneg hokRule
        List.nil d.nodes True.intro hb.2;
    let hnodes' : Scry.AllOn (Scry.inLfpAgree p db (fun _ => True)) d.nodes :=
      Scry.AllOn_congr (Scry.inLfpAgree p db (fun _ => True))
        (Scry.appendAll List.nil d.nodes) d.nodes rfl hnodes;
    let hroot : Scry.inLfpAgree p db (fun _ => True)
        (Scry.ProofNode.fact (List.getD d.nodes d.root Scry.defaultNode)) :=
      Scry.AllOn_getD (Scry.inLfpAgree p db (fun _ => True)) d.nodes hnodes'
        d.root hb.1;
    let hrootOld : Scry.inLfp p db
        (Scry.ProofNode.fact (List.getD d.nodes d.root Scry.defaultNode)) :=
      fun db' hincl hclosed => hroot db' hincl hclosed True.intro;
    Scry.inLfp_congr p db
      (Scry.ProofNode.fact (List.getD d.nodes d.root Scry.defaultNode)) f
      hconcl.1 hrootOld

-- ## The full statement

/-- **`Derivation.check` is sound**, for all node kinds: for any frozen set that contains
every relation the program negates, an accepted certificate's conclusion is in the least
fixpoint of the extensions that add no absent tuple of a frozen relation
(`Scry.inLfpNeg`). The proof is the flat-certificate induction in this file; the lattice
part needs `LatLaws`, and the negation part needs the frozen-set side condition. The
original `Scry.inLfp` statement is proved for negation-free programs by
`Scry.check_sound_negFree`, which includes lattice rules and `join` nodes. -/
def Scry.checkSoundStmt {L : Type} (p : Scry.Program L) : Prop :=
  (frozen : Nat -> Bool) ->
  (hok : (ri : Nat) -> (hri : Nat.lt ri (List.length p.rules) = .true) ->
    Scry.bodyNegRelsOk frozen (List.getD p.rules ri Scry.defaultRule).body = .true) ->
  Scry.checkSoundNegStmt p frozen hok

/-- The full soundness theorem. -/
def Scry.check_sound {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops) :
    Scry.checkSoundStmt p :=
  fun frozen hok => Scry.check_sound_neg p laws frozen hok

-- ## Stratification: instantiating `frozen` from `Program.check`
--
-- The frozen set is no longer an arbitrary parameter: for a stratified program it is the
-- set of relations *below* the finding's stratum. `Program.check` returns the stratum map,
-- and the strata are a fixpoint of the relaxation pass, so every rule's head stratum
-- covers the requirement of every body atom — in particular a negated atom's relation lies
-- strictly below the head. That is exactly `bodyNegRelsOk (belowStratum strat s)`.
--
-- `Scry.check_sound_stratified` is the resulting theorem: a checked derivation for a fact
-- at stratum `s`, in a program whose negating rules all live at strata `≤ s`, holds in
-- every database that contains `db` (the **completed lower-stratum model**: the EDB plus
-- the facts the lower strata derived), is closed under the rules, and adds no absent tuple
-- of a lower-stratum relation.

/-- The relations strictly below stratum `s`: the frozen set of a finding at stratum `s`.
A stratified program evaluates the strata in order, so when stratum `s` runs the relations
below it are complete. -/
def Scry.belowStratum (strat : List Nat) (s : Nat) : Nat -> Bool :=
  fun rel => Nat.lt (List.getD strat rel 0) s

/-- One relaxation step of `Program.stratPass`, as a named function (so the proofs below
can unfold it: `stratPass` itself is a `List.foldr` over an inline lambda). -/
def Scry.stratStep {L : Type} (r : Scry.Rule L) (acc : List Nat × Bool) : List Nat × Bool :=
  let need := Scry.Rule.stratumReq acc.1 r;
  let hs := List.getD acc.1 r.head.rel 0;
  if Nat.lt hs need then ((List.setAt acc.1 r.head.rel need, Bool.true) : List Nat × Bool) else acc

/-- The same step with its test passed explicitly (a proof can case on the `Bool`). -/
def Scry.stratStepB (c : Bool) (strata : List Nat) (rel need : Nat)
    (acc : List Nat × Bool) : List Nat × Bool :=
  if c then ((List.setAt strata rel need, Bool.true) : List Nat × Bool) else acc

/-- `stratStep` through `stratStepB` (definitionally). -/
def Scry.stratStep_eq {L : Type} (r : Scry.Rule L) (acc : List Nat × Bool) :
    Scry.stratStep r acc =
      Scry.stratStepB (Nat.lt (List.getD acc.1 r.head.rel 0) (Scry.Rule.stratumReq acc.1 r))
        acc.1 r.head.rel (Scry.Rule.stratumReq acc.1 r) acc := rfl

/-- The first component of a step: the raised strata when the test succeeds, the input
otherwise. -/
def Scry.stratStepBFst : (c : Bool) → (strata : List Nat) → (rel need : Nat) →
    (acc : List Nat × Bool) →
    (Scry.stratStepB c strata rel need acc).1 =
      (if c then List.setAt strata rel need else acc.1)
  | .true, _, _, _ => rfl
  | .false, _, _, _ => rfl

/-- The second component of a step: `true` when the test succeeds. -/
def Scry.stratStepBSnd : (c : Bool) → (strata : List Nat) → (rel need : Nat) →
    (acc : List Nat × Bool) →
    (Scry.stratStepB c strata rel need acc).2 = (if c then Bool.true else acc.2)
  | .true, _, _, _ => rfl
  | .false, _, _, _ => rfl

/-- `Program.stratPass` as a recursion from the right (definitionally the same function:
`List.foldr` folds from the right). -/
def Scry.stratPassR {L : Type} : List Nat → List (Scry.Rule L) → List Nat × Bool
  | strata, .nil => ((strata, Bool.false) : List Nat × Bool)
  | strata, .cons r rest => Scry.stratStep r (Scry.stratPassR strata rest)

def Scry.foldr_stratStep {L : Type} : (rules : List (Scry.Rule L)) → (strata : List Nat) →
    List.foldr Scry.stratStep (strata, Bool.false) rules = Scry.stratPassR strata rules
  | .nil, _ => rfl
  | .cons r rest, strata =>
    Eq.congrArg (Scry.stratStep r) (Scry.foldr_stratStep rest strata)

/-- `Program.stratPass` is the structural recursion `stratPassR`. -/
def Scry.stratPass_eq {L : Type} (p : Scry.Program L) (strata : List Nat) :
    Scry.Program.stratPass p strata = Scry.stratPassR strata p.rules :=
  Scry.foldr_stratStep p.rules strata

/-- Case analysis on a `Nat`, with the predicate passed explicitly (so the two branches see
`0` and `succ k`). -/
def Scry.natCases (P : Nat → Prop) : (n : Nat) → P 0 → ((k : Nat) → P (Nat.succ k)) → P n
  | .zero, h0, _ => h0
  | .succ k, _, hs => hs k

/-- The first component of `stratStep`: the raised strata, or the accumulator's. -/
def Scry.stratStepFst {L : Type} (r : Scry.Rule L) (acc : List Nat × Bool) :
    (Scry.stratStep r acc).1 =
      (if Nat.lt (List.getD acc.1 r.head.rel 0) (Scry.Rule.stratumReq acc.1 r)
       then List.setAt acc.1 r.head.rel (Scry.Rule.stratumReq acc.1 r) else acc.1) :=
  Eq.trans
    (Eq.congrArg (fun (q : List Nat × Bool) => q.1) (Scry.stratStep_eq r acc))
    (Scry.stratStepBFst (Nat.lt (List.getD acc.1 r.head.rel 0) (Scry.Rule.stratumReq acc.1 r))
      acc.1 r.head.rel (Scry.Rule.stratumReq acc.1 r) acc)

/-- The second component of `stratStep`: `true` when it moved something. -/
def Scry.stratStepSnd {L : Type} (r : Scry.Rule L) (acc : List Nat × Bool) :
    (Scry.stratStep r acc).2 =
      (if Nat.lt (List.getD acc.1 r.head.rel 0) (Scry.Rule.stratumReq acc.1 r)
       then Bool.true else acc.2) :=
  Eq.trans
    (Eq.congrArg (fun (q : List Nat × Bool) => q.2) (Scry.stratStep_eq r acc))
    (Scry.stratStepBSnd (Nat.lt (List.getD acc.1 r.head.rel 0) (Scry.Rule.stratumReq acc.1 r))
      acc.1 r.head.rel (Scry.Rule.stratumReq acc.1 r) acc)

/-- An `if` on a `Bool` condition with `Prop` conclusion: if `(if c then true else u)` is
`false`, then `c` is `false` and so is `u`. -/
def Scry.ifFalseProp (c : Bool) (u : Bool) (h : (if c then Bool.true else u) = Bool.false) :
    c = Bool.false ∧ u = Bool.false :=
  Or.elim (Bool.cases c)
    (fun hc => absurd (Bool.trueNeFalse
      (Eq.mp' (fun (b : Bool) => (if b then Bool.true else u) = Bool.false) hc h)))
    (fun hc => (hc, Eq.mp' (fun (b : Bool) => (if b then Bool.true else u) = Bool.false) hc h))

/-- **A pass that changes nothing is a fixpoint, rule by rule.** It leaves the strata
unchanged and every rule's head stratum covers its body's requirement (in particular
`stratumReq` of a negated atom, which is one more than its relation's stratum). -/
def Scry.stratPassR_ok {L : Type} :
    (rules : List (Scry.Rule L)) → (strata strata' : List Nat) → (flag : Bool) →
    (Scry.stratPassR strata rules).1 = strata' →
    (Scry.stratPassR strata rules).2 = flag →
    flag = Bool.false →
    strata' = strata ∧
      ((ri : Nat) → Nat.lt ri (List.length rules) = Bool.true →
        Nat.lt (List.getD strata' (List.getD rules ri Scry.defaultRule).head.rel 0)
          (Scry.Rule.stratumReq strata' (List.getD rules ri Scry.defaultRule)) = Bool.false)
  | .nil, strata, strata', flag, h1, _, _ =>
    And.intro (Eq.symm h1) (fun ri hi => absurd (Scry.notLtZero ri hi))
  | .cons r rest, strata, strata', flag, h1, h2, hf =>
    let acc : List Nat × Bool := Scry.stratPassR strata rest;
    let need : Nat := Scry.Rule.stratumReq acc.1 r;
    let hif1 : (if Nat.lt (List.getD acc.1 r.head.rel 0) need
        then List.setAt acc.1 r.head.rel need else acc.1) = strata' :=
      Eq.trans (Eq.symm (Scry.stratStepFst r acc)) h1;
    let hif2 : (if Nat.lt (List.getD acc.1 r.head.rel 0) need then Bool.true else acc.2) = flag :=
      Eq.trans (Eq.symm (Scry.stratStepSnd r acc)) h2;
    let hflag : Nat.lt (List.getD acc.1 r.head.rel 0) need = Bool.false :=
      (Scry.ifFalseProp (Nat.lt (List.getD acc.1 r.head.rel 0) need) acc.2
        (Eq.trans hif2 hf)).1;
    let hacc : strata' = acc.1 :=
      Eq.symm (Eq.mp' (fun (b : Bool) =>
        (if b then List.setAt acc.1 r.head.rel need else acc.1) = strata') hflag hif1);
    let hfa : acc.2 = Bool.false :=
      (Scry.ifFalseProp (Nat.lt (List.getD acc.1 r.head.rel 0) need) acc.2
        (Eq.trans hif2 hf)).2;
    let ih := Scry.stratPassR_ok rest strata acc.1 acc.2 rfl rfl hfa;
    And.intro
      (Eq.trans hacc ih.1)
      (fun ri hi =>
        Scry.natCases
          (fun n => Nat.lt n (List.length (List.cons r rest)) = Bool.true →
            Nat.lt (List.getD strata' (List.getD (List.cons r rest) n Scry.defaultRule).head.rel 0)
              (Scry.Rule.stratumReq strata'
                (List.getD (List.cons r rest) n Scry.defaultRule)) = Bool.false)
          ri
          (fun _ =>
            Eq.mpr' (fun (s : List Nat) => Nat.lt (List.getD s r.head.rel 0)
                (Scry.Rule.stratumReq s r) = Bool.false) hacc hflag)
          (fun j hj =>
            Eq.mpr' (fun (s : List Nat) =>
                Nat.lt (List.getD s (List.getD rest j Scry.defaultRule).head.rel 0)
                  (Scry.Rule.stratumReq s (List.getD rest j Scry.defaultRule)) = Bool.false)
              hacc (ih.2 j hj))
          hi)

/-- `Program.stratPasses` as a structural recursion (definitionally the same function). -/
def Scry.stratPassesR {L : Type} (p : Scry.Program L) : Nat → List Nat → List Nat × Bool
  | .zero, strata => Scry.stratPassR strata p.rules
  | .succ n, strata => Scry.stratPassesR p n (Scry.stratPassR strata p.rules).1

/-- The two spellings of `Program.stratPasses` agree. -/
def Scry.stratPasses_eq {L : Type} (p : Scry.Program L) :
    (n : Nat) → (strata : List Nat) →
      Scry.Program.stratPasses p n strata = Scry.stratPassesR p n strata
  | .zero, strata => Scry.stratPass_eq p strata
  | .succ n, strata =>
    Eq.trans
      (Eq.congrArg
        (fun (x : List Nat × Bool) => match x with | (s', _) => Scry.Program.stratPasses p n s')
        (Scry.stratPass_eq p strata))
      (Scry.stratPasses_eq p n (Scry.stratPassR strata p.rules).1)

/-- A `stratPasses` run whose last pass moves nothing is at a fixpoint of `stratPass`. -/
def Scry.stratPassesR_fix {L : Type} (p : Scry.Program L) :
    (n : Nat) → (strata final : List Nat) → (flag : Bool) →
    (Scry.stratPassesR p n strata).1 = final →
    (Scry.stratPassesR p n strata).2 = flag →
    flag = Bool.false →
    (Scry.Program.stratPass p final).1 = final ∧
      (Scry.Program.stratPass p final).2 = Bool.false
  | .zero, strata, final, flag, h1, h2, hf =>
    let hok := Scry.stratPassR_ok p.rules strata final flag h1 h2 hf;
    let hp1 : (Scry.stratPassR final p.rules).1 = final :=
      Eq.mpr' (fun (s : List Nat) => (Scry.stratPassR s p.rules).1 = final) hok.1 h1;
    let hp2 : (Scry.stratPassR final p.rules).2 = Bool.false :=
      Eq.mpr' (fun (s : List Nat) => (Scry.stratPassR s p.rules).2 = Bool.false) hok.1
        (Eq.trans h2 hf);
    And.intro
      (Eq.trans (Eq.congrArg (fun (q : List Nat × Bool) => q.1) (Scry.stratPass_eq p final)) hp1)
      (Eq.trans (Eq.congrArg (fun (q : List Nat × Bool) => q.2) (Scry.stratPass_eq p final)) hp2)
  | .succ n, strata, final, flag, h1, h2, hf =>
    Scry.stratPassesR_fix p n (Scry.stratPassR strata p.rules).1 final flag h1 h2 hf

/-- The same for `Program.stratPasses`. -/
def Scry.stratPasses_fix {L : Type} (p : Scry.Program L) :
    (n : Nat) → (strata final : List Nat) → (flag : Bool) →
    (Scry.Program.stratPasses p n strata).1 = final →
    (Scry.Program.stratPasses p n strata).2 = flag →
    flag = Bool.false →
    (Scry.Program.stratPass p final).1 = final ∧
      (Scry.Program.stratPass p final).2 = Bool.false :=
  fun n strata final flag h1 h2 hf =>
    Scry.stratPassesR_fix p n strata final flag
      (Eq.mp' (fun (q : List Nat × Bool) => q.1 = final) (Scry.stratPasses_eq p n strata) h1)
      (Eq.mp' (fun (q : List Nat × Bool) => q.2 = flag) (Scry.stratPasses_eq p n strata) h2)
      hf

-- ### Reading `Program.stratify`'s result

/-- The `match` in `Program.stratify`, as a function of the pair's components. -/
def Scry.stratMatchB (f : List Nat) (b : Bool) : Option (List Nat) :=
  match b with
  | .true => Option.none
  | .false => Option.some f

/-- `Program.stratify` through `stratMatchB` (definitionally). -/
def Scry.stratify_eq {L : Type} (p : Scry.Program L) :
    Scry.Program.stratify p =
      Scry.stratMatchB
        (Scry.Program.stratPasses p (Nat.succ (List.length p.arities))
          (Scry.zeros (List.length p.arities))).1
        (Scry.Program.stratPasses p (Nat.succ (List.length p.arities))
          (Scry.zeros (List.length p.arities))).2 := rfl

/-- `some a = some b` gives `a = b` (equality of an inductive's constructor is the
constructor's arguments' equality). -/
def Scry.someInj {A : Type} {a b : A} (e : Option.some a = Option.some b) : a = b := e.1

/-- `stratMatchB` returns a `some` only for the `false` flag, and then with its first
argument. -/
def Scry.stratMatchB_some : (f strat : List Nat) → (b : Bool) →
    Scry.stratMatchB f b = Option.some strat → (b = Bool.false ∧ f = strat)
  | _, _, .false, h => (rfl, Scry.someInj h)
  | _, _, .true, h => absurd h.1

/-- A successful `Program.stratify` names the last pass's strata, with its flag `false`. -/
def Scry.stratify_some {L : Type} (p : Scry.Program L) (strat : List Nat)
    (h : Scry.Program.stratify p = Option.some strat) :
    (Scry.Program.stratPasses p (Nat.succ (List.length p.arities))
      (Scry.zeros (List.length p.arities))).1 = strat ∧
    (Scry.Program.stratPasses p (Nat.succ (List.length p.arities))
      (Scry.zeros (List.length p.arities))).2 = Bool.false :=
  let q : List Nat × Bool :=
    Scry.Program.stratPasses p (Nat.succ (List.length p.arities))
      (Scry.zeros (List.length p.arities));
  let hb : q.2 = Bool.false ∧ q.1 = strat :=
    Scry.stratMatchB_some q.1 strat q.2
      (Eq.mp' (fun (x : Option (List Nat)) => x = Option.some strat) (Scry.stratify_eq p) h);
  (hb.2, hb.1)

/-- A conditional whose `then` branch is a `some` is `true`, and the branch is the
result. -/
def Scry.ifSome {A : Type} : (c : Bool) → (t : Option A) → (a : A) →
    (if c then t else (Option.none : Option A)) = Option.some a → c = Bool.true ∧ t = Option.some a
  | .true, _, _, h => (rfl, h)
  | .false, _, _, h => absurd h.1

/-- **The stratification invariant.** When `Program.check` accepts a program, its stratum
map is a fixpoint of the relaxation pass: every rule's head stratum covers its body's
requirement. (The requirement of a negated atom is one more than its relation's stratum,
so a negated relation is strictly below the head.) -/
def Scry.check_strata_ok {L : Type} (p : Scry.Program L) (strat : List Nat)
    (hcheck : Scry.Program.check p = Option.some strat) :
    (ri : Nat) → Nat.lt ri (List.length p.rules) = Bool.true →
      Nat.lt (List.getD strat (List.getD p.rules ri Scry.defaultRule).head.rel 0)
        (Scry.Rule.stratumReq strat (List.getD p.rules ri Scry.defaultRule)) = Bool.false :=
  let hsome := Scry.ifSome (Scry.Program.wellFormed p) (Scry.Program.stratify p) strat hcheck;
  let hpass := Scry.stratify_some p strat hsome.2;
  let hfix := Scry.stratPasses_fix p (Nat.succ (List.length p.arities))
    (Scry.zeros (List.length p.arities)) strat Bool.false hpass.1 hpass.2 rfl;
  let hp1 : (Scry.stratPassR strat p.rules).1 = strat :=
    Eq.trans (Eq.symm (Eq.congrArg (fun (q : List Nat × Bool) => q.1)
      (Scry.stratPass_eq p strat))) hfix.1;
  let hp2 : (Scry.stratPassR strat p.rules).2 = Bool.false :=
    Eq.trans (Eq.symm (Eq.congrArg (fun (q : List Nat × Bool) => q.2)
      (Scry.stratPass_eq p strat))) hfix.2;
  (Scry.stratPassR_ok p.rules strat strat Bool.false hp1 hp2 rfl).2

-- ### The `bodyNegRelsOk` side condition from stratification

/-- `Nat.lt a b = false` gives `b ≤ a` (the `Nat.not_le` instance at `succ a`). -/
def Scry.not_lt_le (a b : Nat) (h : Nat.lt a b = Bool.false) : Nat.Le b a :=
  Nat.not_le (Nat.succ a) b h

/-- A fold maximum dominates its entries. -/
def Scry.listMaxFrom {A : Type} (f : A → Nat) : List A → Nat
  | .nil => 0
  | .cons a rest =>
    if Nat.lt (Scry.listMaxFrom f rest) (f a) then f a else Scry.listMaxFrom f rest

/-- The fold maximum dominates every entry. -/
def Scry.listMaxFrom_ge {A : Type} (f : A → Nat) (d : A) :
    (l : List A) → (i : Nat) → Nat.lt i (List.length l) = Bool.true →
      Nat.Le (f (List.getD l i d)) (Scry.listMaxFrom f l)
  | .nil, i, hi => absurd (Scry.notLtZero i hi)
  | .cons a rest, .zero, _ =>
    Or.elim (Bool.cases (Nat.lt (Scry.listMaxFrom f rest) (f a)))
      (fun ht =>
        Eq.mpr' (fun (b : Bool) => Nat.Le (f a) (if b then f a else Scry.listMaxFrom f rest)) ht
          (Nat.le_refl (f a)))
      (fun hf =>
        Eq.mpr' (fun (b : Bool) => Nat.Le (f a) (if b then f a else Scry.listMaxFrom f rest)) hf
          (Scry.not_lt_le (Scry.listMaxFrom f rest) (f a) hf))
  | .cons a rest, .succ j, hj =>
    let ih := Scry.listMaxFrom_ge f d rest j hj;
    Or.elim (Bool.cases (Nat.lt (Scry.listMaxFrom f rest) (f a)))
      (fun ht =>
        Eq.mpr' (fun (b : Bool) => Nat.Le (f (List.getD rest j d))
            (if b then f a else Scry.listMaxFrom f rest)) ht
          (Nat.le_trans (f (List.getD rest j d)) (Scry.listMaxFrom f rest) (f a)
            ih (Nat.le_of_lt (Scry.listMaxFrom f rest) (f a) ht)))
      (fun hf =>
        Eq.mpr' (fun (b : Bool) => Nat.Le (f (List.getD rest j d))
            (if b then f a else Scry.listMaxFrom f rest)) hf ih)

/-- The default atom, the result of an out-of-range body lookup. -/
def Scry.defaultAtom : Scry.Atom := Scry.Atom.pos 0 List.nil

/-- `Rule.stratumReq` is the fold maximum of the body atoms' requirements (definitionally). -/
def Scry.stratumReq_eq {L : Type} (strata : List Nat) (r : Scry.Rule L) :
    Scry.Rule.stratumReq strata r =
      Scry.listMaxFrom (Scry.Atom.stratumReq strata) r.body := rfl

/-- Every body atom's requirement is below its rule's. -/
def Scry.stratumReq_atom {L : Type} (strata : List Nat) (r : Scry.Rule L) (i : Nat)
    (hi : Nat.lt i (List.length r.body) = Bool.true) :
    Nat.Le (Scry.Atom.stratumReq strata (List.getD r.body i Scry.defaultAtom))
      (Scry.Rule.stratumReq strata r) :=
  Eq.mpr' (fun (x : Nat) => Nat.Le (Scry.Atom.stratumReq strata (List.getD r.body i Scry.defaultAtom)) x)
    (Scry.stratumReq_eq strata r)
    (Scry.listMaxFrom_ge (Scry.Atom.stratumReq strata) Scry.defaultAtom r.body i hi)

/-- The atom at a position inside the body is a negation only if the body contains one. -/
def Scry.bodyHasNeg_getD : (body : List Scry.Atom) → (i : Nat) →
    Nat.lt i (List.length body) = Bool.true → (rel : Nat) → (args : List Scry.Term) →
    List.getD body i Scry.defaultAtom = Scry.Atom.neg rel args →
    Scry.bodyHasNeg body = Bool.true
  | .nil, i, hi, _, _, _ => absurd (Scry.notLtZero i hi)
  | .cons a rest, .zero, _, rel, args, he =>
    Eq.mpr' (fun (x : Scry.Atom) => Scry.bodyHasNeg (List.cons x rest) = Bool.true) he
      (Scry.bodyHasNeg_neg rel args rest)
  | .cons (.pos rel args) rest, .succ j, hj, rel', args', he =>
    Eq.mp' (fun (b : Bool) => b = Bool.true)
      (Scry.bodyHasNeg_pos rel args rest)
      (Scry.bodyHasNeg_getD rest j hj rel' args' he)
  | .cons (.lat rel key vv) rest, .succ j, hj, rel', args', he =>
    Eq.mp' (fun (b : Bool) => b = Bool.true)
      (Scry.bodyHasNeg_lat rel key vv rest)
      (Scry.bodyHasNeg_getD rest j hj rel' args' he)
  | .cons (.neg rel args) rest, .succ j, hj, rel', args', he =>
    Scry.bodyHasNeg_neg rel args rest

/-- An `if` whose condition is true is its `then` branch. -/
def Scry.if_true_eq : (c : Bool) → (t : Bool) → c = Bool.true →
    (if c then t else Bool.false) = t
  | .true, _, _ => rfl
  | .false, _, h => absurd h.1

/-- A body whose negated atoms all name relations in `frozen` passes `bodyNegRelsOk`. -/
def Scry.bodyNegRelsOk_getD (frozen : Nat → Bool) :
    (body : List Scry.Atom) →
    ((i : Nat) → Nat.lt i (List.length body) = Bool.true → (rel : Nat) → (args : List Scry.Term) →
      List.getD body i Scry.defaultAtom = Scry.Atom.neg rel args →
      frozen rel = Bool.true) →
    Scry.bodyNegRelsOk frozen body = Bool.true
  | .nil, _ => rfl
  | .cons (.pos rel args) rest, hok =>
    Eq.trans (Scry.bodyNegRelsOk_pos frozen rel args rest)
      (Scry.bodyNegRelsOk_getD frozen rest
        (fun i hi r a he => hok (Nat.succ i) hi r a he))
  | .cons (.lat rel key vv) rest, hok =>
    Eq.trans (Scry.bodyNegRelsOk_lat frozen rel key vv rest)
      (Scry.bodyNegRelsOk_getD frozen rest
        (fun i hi r a he => hok (Nat.succ i) hi r a he))
  | .cons (.neg rel args) rest, hok =>
    let hthis : frozen rel = Bool.true :=
      hok 0 rfl rel args rfl;
    let hrest : Scry.bodyNegRelsOk frozen rest = Bool.true :=
      Scry.bodyNegRelsOk_getD frozen rest
        (fun i hi r a he => hok (Nat.succ i) hi r a he);
    Eq.trans (Scry.if_true_eq (frozen rel) (Scry.bodyNegRelsOk frozen rest) hthis) hrest

/-- **A stratified program satisfies the frozen side condition at every stratum above its
negating rules**: every negated relation of a rule whose head is at stratum `≤ s` lies
below `s`. -/
def Scry.bodyNegRelsOk_belowStratum {L : Type} (p : Scry.Program L) (strat : List Nat)
    (hcheck : Scry.Program.check p = Option.some strat) (s : Nat)
    (hs : (ri : Nat) → (Nat.lt ri (List.length p.rules) = Bool.true) →
      (Scry.bodyHasNeg (List.getD p.rules ri Scry.defaultRule).body = Bool.true) →
      (Nat.Le (List.getD strat (List.getD p.rules ri Scry.defaultRule).head.rel 0) s))
    (ri : Nat) (hri : Nat.lt ri (List.length p.rules) = Bool.true) :
    Scry.bodyNegRelsOk (Scry.belowStratum strat s)
      (List.getD p.rules ri Scry.defaultRule).body = Bool.true :=
  let rule : Scry.Rule L := List.getD p.rules ri Scry.defaultRule;
  let hok := Scry.check_strata_ok p strat hcheck ri hri;
  Scry.bodyNegRelsOk_getD (Scry.belowStratum strat s) rule.body
    (fun i hi rel args he =>
      let hle := Scry.stratumReq_atom strat rule i hi;
      let hrel : Nat.Le (Nat.succ (List.getD strat rel 0)) (Scry.Rule.stratumReq strat rule) :=
        Eq.mp' (fun (x : Scry.Atom) => Nat.Le (Scry.Atom.stratumReq strat x) (Scry.Rule.stratumReq strat rule))
          he hle;
      let hhead : Nat.Le (Scry.Rule.stratumReq strat rule) (List.getD strat rule.head.rel 0) :=
        Scry.not_lt_le (List.getD strat rule.head.rel 0) (Scry.Rule.stratumReq strat rule) hok;
      let hneg := Scry.bodyHasNeg_getD rule.body i hi rel args he;
      Nat.le_trans (Nat.succ (List.getD strat rel 0)) (List.getD strat rule.head.rel 0) s
        (Nat.le_trans (Nat.succ (List.getD strat rel 0)) (Scry.Rule.stratumReq strat rule)
          (List.getD strat rule.head.rel 0) hrel hhead)
        (hs ri hri hneg))

/-- The stratified soundness statement: a checked derivation for a fact at stratum `s`,
in a stratified program whose negating rules live at strata `≤ s`, holds in every database
that contains `db` (the completed lower-stratum model), is closed under the rules, and adds
no absent tuple of a relation below `s`. -/
def Scry.checkSoundStratifiedStmt {L : Type} (p : Scry.Program L) (strat : List Nat)
    (s : Nat) : Prop :=
  (db : Scry.Db L) → (d : Scry.Derivation L) → (f : Scry.PFact L) →
    Scry.Derivation.concl d = Option.some f →
    Scry.Derivation.check p db d = Bool.true →
    Scry.inLfpNeg p (Scry.belowStratum strat s) db f

/-- **`Derivation.check` is sound for a stratified program, with the frozen set read off
`Program.check`'s stratum map.** `s` is the stratum of the finding; every rule that
negates must have its head at a stratum `≤ s` (for a finding at the top stratum this is
automatic; a lower-stratum finding is checked against the sub-program of strata `≤ s`).
`db` is the completed lower-stratum model, and the conclusion holds in every database
containing it, closed under the rules, that adds no absent tuple of a relation below `s`.
This is `Scry.check_sound` with `frozen = Scry.belowStratum strat s`. -/
def Scry.check_sound_stratified {L : Type} (p : Scry.Program L) (laws : Scry.LatLaws p.ops)
    (strat : List Nat) (hcheck : Scry.Program.check p = Option.some strat) (s : Nat)
    (hs : (ri : Nat) → (Nat.lt ri (List.length p.rules) = Bool.true) →
      (Scry.bodyHasNeg (List.getD p.rules ri Scry.defaultRule).body = Bool.true) →
      (Nat.Le (List.getD strat (List.getD p.rules ri Scry.defaultRule).head.rel 0) s)) :
    Scry.checkSoundStratifiedStmt p strat s :=
  Scry.check_sound_neg p laws (Scry.belowStratum strat s)
    (fun ri hri => Scry.bodyNegRelsOk_belowStratum p strat hcheck s hs ri hri)

/-- The stratified theorem with no per-rule side condition: `s` at or above every rule's
head stratum (the program's top stratum, for a top-level finding). -/
def Scry.check_sound_stratified_all {L : Type} (p : Scry.Program L)
    (laws : Scry.LatLaws p.ops) (strat : List Nat)
    (hcheck : Scry.Program.check p = Option.some strat) (s : Nat)
    (hall : (ri : Nat) → (Nat.lt ri (List.length p.rules) = Bool.true) →
      (Nat.Le (List.getD strat (List.getD p.rules ri Scry.defaultRule).head.rel 0) s)) :
    Scry.checkSoundStratifiedStmt p strat s :=
  Scry.check_sound_stratified p laws strat hcheck s (fun ri hri _ => hall ri hri)

-- ## Absence certificates

-- A derivation certificate proves that a fact holds. A **negated** atom needs the
-- opposite: that the tuple is absent from the lower stratum, which the derivation checker
-- can only read off the EDB it is given. An absence certificate makes that assumption
-- checkable: it carries the **candidate model of the lower strata** — a flat list of
-- facts, any order — and the tuple claimed absent. If the model contains the EDB and is
-- closed under the rules then, being a closed superset of the EDB, it contains the least
-- fixpoint; so a tuple absent from the model is absent from the least fixpoint. That is
-- `Scry.absence_check_sound` below.
--
-- The model is the "completeness claim"; `Absence.edbInModel` and `Absence.closedB` check
-- the two side conditions syntactically (`closedB` enumerates the rule instances with the
-- evaluator's matcher, so its soundness additionally needs the matcher's *completeness*:
-- that every instance the check must see appears among the matches — see the notes).

/-- An absence certificate: the candidate model of the lower strata and the tuple claimed
absent from it. -/
structure Scry.Absence (L : Type) where
  model : List (Scry.PFact L)
  rel : Nat
  row : List U64

/-- The certificate's model as a database. -/
def Scry.dbOfFacts {L : Type} : List (Scry.PFact L) → Scry.Db L
  | .nil => Scry.Db.empty
  | .cons f rest =>
    match f.lat with
    | .none => (Scry.Db.insertTuple (Scry.dbOfFacts rest) f.rel f.args).1
    | .some v => Scry.Db.setLat (Scry.dbOfFacts rest) f.rel f.args v

def Scry.Absence.db {L : Type} (a : Scry.Absence L) : Scry.Db L := Scry.dbOfFacts a.model

/-- **The check**: the claimed tuple is absent from the certificate's model. This is the
part `Scry.absence_check_sound` turns into absence from the least fixpoint; the model's
two semantic side conditions are `edbInModel` and `closedB`. -/
def Scry.Absence.check {L : Type} (p : Scry.Program L) (a : Scry.Absence L) : Bool :=
  Bool.not (Scry.factHoldsB p.ops a.db (Scry.PFact.mk a.rel a.row .none))

/-- The tuple facts of a relation, as a flat list. -/
def Scry.tupleRelFacts {L : Type} (rel : Nat) (t : Scry.TupleRel) : List (Scry.PFact L) :=
  List.map (fun row => Scry.PFact.mk rel row (Option.none : Option L)) t.toList

def Scry.tuplesFacts {L : Type} : List (Nat × Scry.TupleRel) → List (Scry.PFact L)
  | .nil => List.nil
  | .cons e rest =>
    List.append (Scry.tupleRelFacts e.1 e.2) (Scry.tuplesFacts rest)

/-- The lattice facts of a relation, as a flat list. -/
def Scry.latRelFacts {L : Type} (rel : Nat) (t : Scry.LatRel L) : List (Scry.PFact L) :=
  List.map (fun kv => Scry.PFact.mk rel kv.1 (Option.some kv.2)) t.toList

def Scry.latsFacts {L : Type} : List (Nat × Scry.LatRel L) → List (Scry.PFact L)
  | .nil => List.nil
  | .cons e rest =>
    List.append (Scry.latRelFacts e.1 e.2) (Scry.latsFacts rest)

/-- Every fact of a database, as a flat list (in the certificate's `model` format). -/
def Scry.dbFacts {L : Type} (db : Scry.Db L) : List (Scry.PFact L) :=
  List.append (Scry.tuplesFacts db.tuples) (Scry.latsFacts db.lats)

/-- Every row of a tuple relation holds in the model. -/
def Scry.allRowsHoldB {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (rel : Nat) (rows : List (List U64)) : Bool :=
  List.foldr (fun row acc =>
    if Scry.factHoldsB p.ops a.db (Scry.PFact.mk rel row (Option.none : Option L))
    then acc else Bool.false) Bool.true rows

/-- Every tuple entry of a database holds in the model. -/
def Scry.allTupleEntriesHoldB {L : Type} (p : Scry.Program L) (a : Scry.Absence L) :
    List (Nat × Scry.TupleRel) → Bool
  | .nil => Bool.true
  | .cons e rest =>
    if Scry.allRowsHoldB p a e.1 e.2.toList then
      Scry.allTupleEntriesHoldB p a rest
    else Bool.false

/-- Every entry of one lattice relation holds in the model. -/
def Scry.allLatRowsHoldB {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (rel : Nat) (entries : List (List U64 × L)) : Bool :=
  List.foldr (fun kv acc =>
    if Scry.factHoldsB p.ops a.db
      (Scry.PFact.mk rel kv.1 (Option.some kv.2)) then acc else Bool.false)
    Bool.true entries

/-- Every lattice entry of a database holds in the model. -/
def Scry.allLatEntriesHoldB {L : Type} (p : Scry.Program L) (a : Scry.Absence L) :
    List (Nat × Scry.LatRel L) → Bool
  | .nil => Bool.true
  | .cons e rest =>
    if Scry.allLatRowsHoldB p a e.1 e.2.toList then
      Scry.allLatEntriesHoldB p a rest
    else Bool.false

/-- The first side condition, syntactically: every fact of the EDB holds in the model. -/
def Scry.Absence.edbInModel {L : Type} (p : Scry.Program L) (edb : Scry.Db L)
    (a : Scry.Absence L) : Bool :=
  Bool.and (Scry.allTupleEntriesHoldB p a edb.tuples)
    (Scry.allLatEntriesHoldB p a edb.lats)

-- ### The EDB side: enumerating the EDB facts

def Scry.natBeq_refl : (n : Nat) -> Nat.beq n n = .true
  | .zero => rfl
  | .succ n => Scry.natBeq_refl n

def Scry.eqU64_refl (a : U64) : Scry.eqU64 a a = .true :=
  Scry.natBeq_refl (UIntN.toNat a)

def Scry.rowEq_refl : (r : List U64) -> Scry.rowEq r r = .true
  | .nil => rfl
  | .cons a as => Eq.trans
      (Eq.congrArg (fun (b : Bool) => if b then Scry.rowEq as as else Bool.false) (Scry.eqU64_refl a))
      (Scry.rowEq_refl as)

def Scry.rowEq_true : (a b : List U64) -> Scry.rowEq a b = .true -> a = b
  | .nil, .nil, _ => rfl
  | .nil, .cons _ _, h => absurd h.1
  | .cons _ _, .nil, h => absurd h.1
  | .cons a as, .cons b bs, h =>
    let h1 : Scry.eqU64 a b = .true :=
      (Scry.ifTrueAnd (Scry.eqU64 a b) (Scry.rowEq as bs) h).1;
    let h2 : Scry.rowEq as bs = .true :=
      (Scry.ifTrueAnd (Scry.eqU64 a b) (Scry.rowEq as bs) h).2;
    Eq.trans
      (Eq.congrArg (fun (z : List U64) => List.cons a z) (Scry.rowEq_true as bs h2))
      (Eq.congrArg (fun (z : U64) => List.cons z bs) (Scry.eqU64_true a b h1))

def Scry.allRowsHoldB_get {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (rel : Nat) : (rows : List (List U64)) -> (w : List U64) ->
    Scry.allRowsHoldB p a rel rows = .true ->
    Scry.memRow w rows = .true ->
    Scry.factHoldsB p.ops a.db (Scry.PFact.mk rel w (Option.none : Option L)) = .true
  | .nil, w, _, h2 => absurd h2
  | .cons x xs, w, h1, h2 =>
    let hif : (if Scry.factHoldsB p.ops a.db
        (Scry.PFact.mk rel x (Option.none : Option L)) then Scry.allRowsHoldB p a rel xs else Bool.false) = .true := h1;
    Or.elim (Bool.cases (Scry.rowEq w x))
      (fun (ht : Scry.rowEq w x = .true) =>
        let e : w = x := Scry.rowEq_true w x ht;
        let hc := (Scry.ifTrueAnd (Scry.factHoldsB p.ops a.db
          (Scry.PFact.mk rel x (Option.none : Option L))) (Scry.allRowsHoldB p a rel xs) hif).1;
        Eq.mpr' (fun (z : List U64) => Scry.factHoldsB p.ops a.db
          (Scry.PFact.mk rel z (Option.none : Option L)) = .true) e hc)
      (fun (hf : Scry.rowEq w x = .false) =>
        let h2' : Scry.memRow w xs = .true :=
          Eq.mp' (fun (b : Bool) => (if b then Bool.true else Scry.memRow w xs) = .true) hf h2;
        let ht := (Scry.ifTrueAnd (Scry.factHoldsB p.ops a.db
          (Scry.PFact.mk rel x (Option.none : Option L))) (Scry.allRowsHoldB p a rel xs) hif).2;
        Scry.allRowsHoldB_get p a rel xs w ht h2')

def Scry.assocGet_cons {A : Type} (d : A) (k : Nat) (e : Nat × A) (rest : List (Nat × A)) :
    Scry.assocGet d k (List.cons e rest) =
      (if Nat.beq k e.1 then e.2 else Scry.assocGet d k rest) := rfl

def Scry.any_if {A : Type} (p : A -> Bool) (c : Bool) (a b : List A) :
    List.any p (if c then a else b) = (if c then List.any p a else List.any p b) :=
  match c with
  | .true => rfl
  | .false => rfl

def Scry.tupleToList_if (c : Bool) (a b : Scry.TupleRel) :
    (if c then a else b).toList = (if c then a.toList else b.toList) :=
  match c with
  | .true => rfl
  | .false => rfl

def Scry.tupleLookup_holds {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (r : Nat) (row : List U64) : (entries : List (Nat × Scry.TupleRel)) ->
    Scry.allTupleEntriesHoldB p a entries = .true ->
    List.any (Scry.rowEq row) (Scry.assocGet Scry.TupleRel.empty r entries).toList = .true ->
    Scry.factHoldsB p.ops a.db (Scry.PFact.mk r row (Option.none : Option L)) = .true
  | .nil, h1, h2 => absurd h2
  | .cons e rest, h1, h2 =>
    let hif : (if Scry.allRowsHoldB p a e.1 e.2.toList then
        Scry.allTupleEntriesHoldB p a rest else Bool.false) = .true := h1;
        let h2u : (if Nat.beq r e.1 then
            List.any (Scry.rowEq row) e.2.toList
          else List.any (Scry.rowEq row) (Scry.assocGet Scry.TupleRel.empty r rest).toList) = .true :=
          let e1 : Scry.TupleRel.toList (Scry.assocGet Scry.TupleRel.empty r (List.cons e rest)) =
              Scry.TupleRel.toList (if Nat.beq r e.1 then e.2 else Scry.assocGet Scry.TupleRel.empty r rest) :=
            Eq.congrArg Scry.TupleRel.toList (Scry.assocGet_cons Scry.TupleRel.empty r e rest);
          let e2 : Scry.TupleRel.toList (if Nat.beq r e.1 then e.2 else Scry.assocGet Scry.TupleRel.empty r rest) =
              (if Nat.beq r e.1 then Scry.TupleRel.toList e.2
               else Scry.TupleRel.toList (Scry.assocGet Scry.TupleRel.empty r rest)) :=
            Scry.tupleToList_if (Nat.beq r e.1) e.2 (Scry.assocGet Scry.TupleRel.empty r rest);
          let e3 : List.any (Scry.rowEq row)
              (if Nat.beq r e.1 then Scry.TupleRel.toList e.2
               else Scry.TupleRel.toList (Scry.assocGet Scry.TupleRel.empty r rest)) =
              (if Nat.beq r e.1 then List.any (Scry.rowEq row) e.2.toList
               else List.any (Scry.rowEq row) (Scry.assocGet Scry.TupleRel.empty r rest).toList) :=
            Scry.any_if (Scry.rowEq row) (Nat.beq r e.1) e.2.toList
              (Scry.assocGet Scry.TupleRel.empty r rest).toList;
          let hany : List.any (Scry.rowEq row)
              (if Nat.beq r e.1 then Scry.TupleRel.toList e.2
               else Scry.TupleRel.toList (Scry.assocGet Scry.TupleRel.empty r rest)) = .true :=
            Eq.mp' (fun (t : List (List U64)) => List.any (Scry.rowEq row) t = .true)
              (Eq.trans e1 e2) h2;
          Eq.mp' (fun (b : Bool) => b = .true) e3 hany;
    Or.elim (Bool.cases (Nat.beq r e.1))
      (fun ht =>
        let he : r = e.1 := Scry.natBeq_true r e.1 ht;
        let hrows := (Scry.ifTrueAnd (Scry.allRowsHoldB p a e.1 e.2.toList)
          (Scry.allTupleEntriesHoldB p a rest) hif).1;
        let h2e : List.any (Scry.rowEq row) e.2.toList = .true :=
          Eq.mp' (fun (b : Bool) => (if b then
              List.any (Scry.rowEq row) e.2.toList
            else List.any (Scry.rowEq row) (Scry.assocGet Scry.TupleRel.empty r rest).toList) = .true) ht h2u;
        let hf := Scry.allRowsHoldB_get p a e.1 e.2.toList row hrows h2e;
        Eq.mpr' (fun (z : Nat) => Scry.factHoldsB p.ops a.db
          (Scry.PFact.mk z row (Option.none : Option L)) = .true) (he) hf)
      (fun hf =>
        let h2' : List.any (Scry.rowEq row) (Scry.assocGet Scry.TupleRel.empty r rest).toList = .true :=
          Eq.mp' (fun (b : Bool) => (if b then
              List.any (Scry.rowEq row) e.2.toList
            else List.any (Scry.rowEq row) (Scry.assocGet Scry.TupleRel.empty r rest).toList) = .true) hf h2u;
        let hrest := (Scry.ifTrueAnd (Scry.allRowsHoldB p a e.1 e.2.toList)
          (Scry.allTupleEntriesHoldB p a rest) hif).2;
        Scry.tupleLookup_holds p a r row rest hrest h2')

def Scry.latLookup_holds {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (rel : Nat) (key : List U64) : (entries : List (List U64 × L)) -> (w : L) ->
    Scry.allLatRowsHoldB p a rel entries = .true ->
    Scry.LatRel.findL key entries = Option.some w ->
    Scry.factHoldsB p.ops a.db (Scry.PFact.mk rel key (Option.some w)) = .true
  | .nil, w, _, hf => absurd hf.1
  | .cons e rest, w, h1, hf =>
    let hif : (if Scry.factHoldsB p.ops a.db
        (Scry.PFact.mk rel e.1 (Option.some e.2)) then
        Scry.allLatRowsHoldB p a rel rest else Bool.false) = .true := h1;
    Or.elim (Bool.cases (Scry.rowEq key e.1))
      (fun ht =>
        let hf' : Option.some e.2 = Option.some w :=
          Eq.mp' (fun (b : Bool) => (if b then Option.some e.2 else
            Scry.LatRel.findL key rest) = Option.some w) ht hf;
        let he2 : e.2 = w := Scry.someInj hf';
        let hkey : key = e.1 := Scry.rowEq_true key e.1 ht;
        let hc := (Scry.ifTrueAnd (Scry.factHoldsB p.ops a.db
          (Scry.PFact.mk rel e.1 (Option.some e.2)))
          (Scry.allLatRowsHoldB p a rel rest) hif).1;
        let hc' : Scry.factHoldsB p.ops a.db
            (Scry.PFact.mk rel key (Option.some w)) = .true :=
          Eq.mpr' (fun (z : List U64) => Scry.factHoldsB p.ops a.db
            (Scry.PFact.mk rel z (Option.some w)) = .true) hkey
            (Eq.mpr' (fun (z : L) => Scry.factHoldsB p.ops a.db
              (Scry.PFact.mk rel e.1 (Option.some z)) = .true) (Eq.symm he2) hc);
        hc')
      (fun hf0 =>
        let hf' : Scry.LatRel.findL key rest = Option.some w :=
          Eq.mp' (fun (b : Bool) => (if b then Option.some e.2 else
            Scry.LatRel.findL key rest) = Option.some w) hf0 hf;
        let hrest := (Scry.ifTrueAnd (Scry.factHoldsB p.ops a.db
          (Scry.PFact.mk rel e.1 (Option.some e.2)))
          (Scry.allLatRowsHoldB p a rel rest) hif).2;
        Scry.latLookup_holds p a rel key rest w hrest hf')

def Scry.latToList_if {L : Type} (c : Bool) (a b : Scry.LatRel L) :
    (if c then a else b).toList = (if c then a.toList else b.toList) :=
  match c with
  | .true => rfl
  | .false => rfl

def Scry.latFindL_if {L : Type} (key : List U64) (c : Bool)
    (a b : List (List U64 × L)) :
    Scry.LatRel.findL key (if c then a else b) =
      (if c then Scry.LatRel.findL key a else Scry.LatRel.findL key b) :=
  match c with
  | .true => rfl
  | .false => rfl

def Scry.findLat_cons {L : Type} (tuples : List (Nat × Scry.TupleRel))
    (e : Nat × Scry.LatRel L) (rest : List (Nat × Scry.LatRel L))
    (r : Nat) (key : List U64) :
    Scry.Db.findLat (Scry.Db.mk tuples (List.cons e rest)) r key =
      (if Nat.beq r e.1 then (e.2.find key)
       else Scry.Db.findLat (Scry.Db.mk tuples rest) r key) :=
  let e1 : Scry.LatRel.findL key
      (Scry.LatRel.toList (Scry.assocGet (@Scry.LatRel.empty L) r (List.cons e rest))) =
      Scry.LatRel.findL key
        (Scry.LatRel.toList (if Nat.beq r e.1 then e.2
          else Scry.assocGet (@Scry.LatRel.empty L) r rest)) :=
    Eq.congrArg (fun (t : Scry.LatRel L) => Scry.LatRel.findL key t.toList)
      (Scry.assocGet_cons (@Scry.LatRel.empty L) r e rest);
  let e2 : Scry.LatRel.findL key
      (Scry.LatRel.toList (if Nat.beq r e.1 then e.2
        else Scry.assocGet (@Scry.LatRel.empty L) r rest)) =
      Scry.LatRel.findL key
        (if Nat.beq r e.1 then e.2.toList
         else (Scry.assocGet (@Scry.LatRel.empty L) r rest).toList) :=
    Eq.congrArg (fun (xs : List (List U64 × L)) => Scry.LatRel.findL key xs)
      (Scry.latToList_if (Nat.beq r e.1) e.2
        (Scry.assocGet (@Scry.LatRel.empty L) r rest));
  let e3 : Scry.LatRel.findL key
      (if Nat.beq r e.1 then e.2.toList
       else (Scry.assocGet (@Scry.LatRel.empty L) r rest).toList) =
      (if Nat.beq r e.1 then Scry.LatRel.findL key e.2.toList
       else Scry.LatRel.findL key
         (Scry.assocGet (@Scry.LatRel.empty L) r rest).toList) :=
    Scry.latFindL_if key (Nat.beq r e.1) e.2.toList
      (Scry.assocGet (@Scry.LatRel.empty L) r rest).toList;
  Eq.trans e1 (Eq.trans e2 e3)

def Scry.latEntryLookup_holds {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (tuples : List (Nat × Scry.TupleRel)) :
    (lats : List (Nat × Scry.LatRel L)) -> (r : Nat) -> (key : List U64) -> (w : L) ->
    Scry.allLatEntriesHoldB p a lats = .true ->
    Scry.Db.findLat (Scry.Db.mk tuples lats) r key = Option.some w ->
    Scry.factHoldsB p.ops a.db (Scry.PFact.mk r key (Option.some w)) = .true
  | .nil, r, key, w, h1, hf => absurd hf.1
  | .cons e rest, r, key, w, h1, hf =>
    let hif : (if Scry.allLatRowsHoldB p a e.1 e.2.toList then
        Scry.allLatEntriesHoldB p a rest else Bool.false) = .true := h1;
    let hfs : (if Nat.beq r e.1 then (e.2.find key)
        else Scry.Db.findLat (Scry.Db.mk tuples rest) r key) = Option.some w :=
      Eq.mp' (fun (x : Option L) => x = Option.some w)
        (Scry.findLat_cons tuples e rest r key) hf;
    Or.elim (Bool.cases (Nat.beq r e.1))
      (fun ht =>
        let hrows := (Scry.ifTrueAnd (Scry.allLatRowsHoldB p a e.1 e.2.toList)
          (Scry.allLatEntriesHoldB p a rest) hif).1;
        let hfind : Scry.LatRel.findL key e.2.toList = Option.some w :=
          Eq.mp' (fun (b : Bool) => (if b then (e.2.find key)
            else Scry.Db.findLat (Scry.Db.mk tuples rest) r key) = Option.some w) ht hfs;
        let hc := Scry.latLookup_holds p a e.1 key e.2.toList w hrows hfind;
        let he : e.1 = r := Eq.symm (Scry.natBeq_true r e.1 ht);
        Eq.mp' (fun (z : Nat) => Scry.factHoldsB p.ops a.db
          (Scry.PFact.mk z key (Option.some w)) = .true) he hc)
      (fun hf0 =>
        let hrest := (Scry.ifTrueAnd (Scry.allLatRowsHoldB p a e.1 e.2.toList)
          (Scry.allLatEntriesHoldB p a rest) hif).2;
        let hf' : Scry.Db.findLat (Scry.Db.mk tuples rest) r key = Option.some w :=
          Eq.mp' (fun (b : Bool) => (if b then (e.2.find key)
            else Scry.Db.findLat (Scry.Db.mk tuples rest) r key) = Option.some w) hf0 hfs;
        Scry.latEntryLookup_holds p a tuples rest r key w hrest hf')

def Scry.latVal_some {L : Type} (ops : Scry.LatOps L) (db : Scry.Db L)
    (r : Nat) (key : List U64) (w : L)
    (h : Scry.Db.findLat db r key = Option.some w) :
    Scry.latVal ops db r key = w :=
  Eq.trans (Scry.latVal_eq ops db r key)
    (Eq.congrArg (Scry.optLatVal ops) h)

def Scry.latVal_none {L : Type} (ops : Scry.LatOps L) (db : Scry.Db L)
    (r : Nat) (key : List U64)
    (h : Scry.Db.findLat db r key = Option.none) :
    Scry.latVal ops db r key = ops.bot :=
  Eq.trans (Scry.latVal_eq ops db r key)
    (Eq.congrArg (Scry.optLatVal ops) h)

def Scry.edbTupleHolds {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (edb : Scry.Db L) (r : Nat) (row : List U64)
    (hall : Scry.allTupleEntriesHoldB p a edb.tuples = .true)
    (hmem : Scry.Db.memTuple edb r row = .true) :
    Scry.factHoldsB p.ops a.db (Scry.PFact.mk r row (Option.none : Option L)) = .true :=
  Scry.tupleLookup_holds p a r row edb.tuples hall hmem

def Scry.edbLatHoldsOpt {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (laws : Scry.LatLaws p.ops) (edb : Scry.Db L) (r : Nat) (key : List U64)
    (v : L) (hall : Scry.allLatEntriesHoldB p a edb.lats = .true) :
    (o : Option L) -> Scry.Db.findLat edb r key = o ->
    Scry.LatOps.le p.ops v (Scry.optLatVal p.ops o) = .true ->
    Scry.LatOps.le p.ops v (Scry.latVal p.ops a.db r key) = .true
  | .none, hfind, hmem =>
    let hb : Scry.latVal p.ops edb r key = p.ops.bot := Scry.latVal_none p.ops edb r key hfind;
    let hv : Scry.LatOps.le p.ops v p.ops.bot = .true := hmem;
    Scry.le_trans p.ops laws v p.ops.bot (Scry.latVal p.ops a.db r key)
      hv (Scry.le_bot_left p.ops laws (Scry.latVal p.ops a.db r key))
  | .some w, hfind, hmem =>
    let hw : Scry.latVal p.ops edb r key = w := Scry.latVal_some p.ops edb r key w hfind;
    let hv : Scry.LatOps.le p.ops v w = .true := hmem;
    let hlook := Scry.latEntryLookup_holds p a edb.tuples edb.lats r key w hall hfind;
    Scry.le_trans p.ops laws v w (Scry.latVal p.ops a.db r key) hv hlook

def Scry.edbLatHolds {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (laws : Scry.LatLaws p.ops) (edb : Scry.Db L) (r : Nat) (key : List U64)
    (v : L) (hall : Scry.allLatEntriesHoldB p a edb.lats = .true)
    (hmem : Scry.LatOps.le p.ops v (Scry.latVal p.ops edb r key) = .true) :
    Scry.LatOps.le p.ops v (Scry.latVal p.ops a.db r key) = .true :=
  Scry.edbLatHoldsOpt p a laws edb r key v hall
    (Scry.Db.findLat edb r key) rfl
    (Eq.mp' (fun (z : L) => Scry.LatOps.le p.ops v z = .true)
      (Scry.latVal_eq p.ops edb r key) hmem)

def Scry.factInModel {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (laws : Scry.LatLaws p.ops) (edb : Scry.Db L)
    (ht : Scry.allTupleEntriesHoldB p a edb.tuples = .true)
    (hl : Scry.allLatEntriesHoldB p a edb.lats = .true) :
    (rel : Nat) -> (args : List U64) -> (lat : Option L) ->
    Scry.factHolds p.ops edb (Scry.PFact.mk rel args lat) ->
    Scry.factHolds p.ops a.db (Scry.PFact.mk rel args lat)
  | rel, args, .none, hf =>
    Scry.edbTupleHolds p a edb rel args ht hf
  | rel, args, (.some v), hf =>
    Scry.edbLatHolds p a laws edb rel args v hl hf

def Scry.edbInModel_dbIncl {L : Type} (p : Scry.Program L) (a : Scry.Absence L)
    (laws : Scry.LatLaws p.ops) (edb : Scry.Db L)
    (hedb : Scry.Absence.edbInModel p edb a = .true) :
    Scry.dbIncl p.ops edb a.db :=
  fun (f : Scry.PFact L) (hf : Scry.factHolds p.ops edb f) =>
    let ht : Scry.allTupleEntriesHoldB p a edb.tuples = .true :=
      Scry.andLeft (Scry.allTupleEntriesHoldB p a edb.tuples)
        (Scry.allLatEntriesHoldB p a edb.lats) hedb;
    let hl : Scry.allLatEntriesHoldB p a edb.lats = .true :=
      Scry.andRight (Scry.allTupleEntriesHoldB p a edb.tuples)
        (Scry.allLatEntriesHoldB p a edb.lats) hedb;
    let hf' : Scry.factHolds p.ops edb (Scry.PFact.mk f.rel f.args f.lat) :=
      Eq.mpr' (fun (x : Scry.PFact L) => Scry.factHolds p.ops edb x)
        (Scry.pfact_etaR f) hf;
    let h := Scry.factInModel p a laws edb ht hl f.rel f.args f.lat hf';
    Eq.mp' (fun (x : Scry.PFact L) => Scry.factHolds p.ops a.db x)
      (Scry.pfact_etaR f) h



/-- The second side condition, syntactically: for every rule and every body match the
evaluator finds in the model, the instance's head holds in the model. (The matcher's
completeness makes this cover every instance; see the notes.) -/
def Scry.Absence.closedB {L : Type} (p : Scry.Program L) (a : Scry.Absence L) : Bool :=
  List.foldr (fun r acc =>
    if List.foldr (fun m acc' =>
        if Scry.factHoldsB p.ops a.db (Scry.headFact p r m.1) then acc' else Bool.false)
        Bool.true (Scry.evalAtoms p.ops (Scry.State.mk a.db List.nil 0) r.body Scry.Env.empty)
      then acc else Bool.false) Bool.true p.rules

/-- The full checker: the tuple is absent from the model, the model contains the EDB, and
the model is closed. -/
def Scry.Absence.checkFull {L : Type} (p : Scry.Program L) (edb : Scry.Db L)
    (a : Scry.Absence L) : Bool :=
  if Scry.Absence.check p a then
    if Scry.Absence.edbInModel p edb a then Scry.Absence.closedB p a else Bool.false
  else Bool.false

/-- **The soundness statement.** A certificate that passes `check`, whose model contains
`edb` and is closed under the rules, proves the tuple absent from the least fixpoint — so
a `neg` finding can cite it instead of trusting the EDB. -/
def Scry.absenceSoundStmt {L : Type} (p : Scry.Program L) (edb : Scry.Db L)
    (a : Scry.Absence L) : Prop :=
  Scry.Absence.check p a = Bool.true →
  Scry.dbIncl p.ops edb a.db →
  Scry.closed p a.db →
  ¬ Scry.inLfp p edb (Scry.PFact.mk a.rel a.row (Option.none : Option L))

/-- **Absence certificates are sound**: the core of the statement is proved here from the
checker, the EDB inclusion and closure (the two `Absence.edbInModel`/`closedB` side
conditions are the syntactic form of the last two hypotheses). -/
def Scry.absence_check_sound {L : Type} (p : Scry.Program L) (edb : Scry.Db L)
    (a : Scry.Absence L) : Scry.absenceSoundStmt p edb a :=
  fun hcheck hincl hclosed hlfp =>
    let hfalse : Scry.factHoldsB p.ops a.db
        (Scry.PFact.mk a.rel a.row (Option.none : Option L)) = Bool.false :=
      Scry.not_true_false _ hcheck;
    let hholds : Scry.factHolds p.ops a.db
        (Scry.PFact.mk a.rel a.row (Option.none : Option L)) :=
      hlfp a.db hincl hclosed;
    absurd (Bool.trueNeFalse (Eq.trans (Eq.symm hholds) hfalse))

/-- The `closedB` side of the certificate, as a statement: if the syntactic closure check
passes, the model is semantically closed. Its proof needs the matcher's completeness
(every rule instance is among `evalAtoms`' matches); it is recorded here as the remaining
obligation (see `wiz-notes/scry-derivation.md`). -/
def Scry.absence_closedB_soundStmt {L : Type} (p : Scry.Program L) (a : Scry.Absence L) :
    Prop :=
  Scry.Absence.closedB p a = Bool.true → Scry.closed p a.db

/-- The full checker's soundness statement: a certificate that passes `checkFull` proves
the tuple absent from the least fixpoint. -/
def Scry.absenceCheckedStmt {L : Type} (p : Scry.Program L) (edb : Scry.Db L)
    (a : Scry.Absence L) : Prop :=
  Scry.Absence.checkFull p edb a = Bool.true →
  ¬ Scry.inLfp p edb (Scry.PFact.mk a.rel a.row (Option.none : Option L))

/-- **Absence certificates are sound from the executable checks alone**, given the
lattice laws of the program and the matcher-completeness fact `ClosedB` (the single
remaining syntactic side condition, stated as `absence_closedB_soundStmt`).

The EDB side is no longer a hypothesis: `edbInModel` is an enumeration of `edb`'s tuple
and lattice entries, and `edbInModel_dbIncl` proves it implies `dbIncl` (lattice facts use
transitivity and `le_bot_left`, hence the `LatLaws`). The model side is `closedB` through
`ClosedB`. -/
def Scry.absence_check_sound_checked {L : Type} (p : Scry.Program L)
    (laws : Scry.LatLaws p.ops) (edb : Scry.Db L) (a : Scry.Absence L)
    (ClosedB : Scry.absence_closedB_soundStmt p a) :
    Scry.absenceCheckedStmt p edb a :=
  fun hfull hlfp =>
    let hcheck : Scry.Absence.check p a = Bool.true :=
      (Scry.ifTrueAnd (Scry.Absence.check p a)
        (if Scry.Absence.edbInModel p edb a then Scry.Absence.closedB p a else Bool.false)
        hfull).1;
    let htail : (if Scry.Absence.edbInModel p edb a then
        Scry.Absence.closedB p a else Bool.false) = Bool.true :=
      (Scry.ifTrueAnd (Scry.Absence.check p a)
        (if Scry.Absence.edbInModel p edb a then Scry.Absence.closedB p a else Bool.false)
        hfull).2;
    let hparts := Scry.ifTrueAnd (Scry.Absence.edbInModel p edb a)
      (Scry.Absence.closedB p a) htail;
    Scry.absence_check_sound p edb a hcheck
      (Scry.edbInModel_dbIncl p a laws edb hparts.1)
      (ClosedB hparts.2) hlfp

