import Text
import Logic
import Functor
import Scry.Wil
import Scry.Analysis
import Scry.PointsTo
/-!
# Scry.Optics: read-only accessors and traversals over Wil and analyses

`import Scry.Optics`.

The additive, read-only accessor layer for the Wil side of Scry: statements, terms,
origins, uses, definitions, data-dependence edges and the points-to state. Every optic is
a small record of functions over the types Scry already uses; there is no second
representation of a program or an analysis result, and nothing here mutates a store.

The CST/facts half lives in `Scry.CstOptics` (in `scry/src`), because `Scry.Node`,
`Scry.Facts` and `Scry.CstStore` are in the `scry` package's source root. This module is
in the library root so a `lib/Scry` pass or rule can import it without depending on the
CLI package. The split is deliberate: the core optics and the Wil analysis are usable by
both, while only the CST-aware code pays for `Scry.CstStore`.

## The four optics

| optic | reading | write? |
|---|---|---|
| `Getter S A` | exactly one `A` in an `S` | no |
| `Fold S A` | zero or more `A`s in an `S` | no |
| `Lens S A` | exactly one `A`, with a pure local `over` | pure rewrite of a value |
| `Traversal S A` | zero or more `A`s, with a pure local `over` | pure rewrite of a value |

`Lens`/`Traversal` do not have a store or an in-place update: `over f s` returns a new
`s`. Only Wil values have these local rewrites (an origin, a data-dependence variable);
a CST or a fact store has no `Lens` at all (O4).

## Laws

A `Lens` obeys the read-only lens laws (the `set`-free form of the usual three):

* `Lens.GetOver`: `get (over f s) = f (get s)`;
* `Lens.OverId`: `over id s = s`;
* `Lens.OverOver`: `over f (over g s) = over (f ∘ g) s`.

A `Traversal` obeys `Traversal.OverId` and
`Traversal.OverList` (`toList (over f s) = List.map f (toList s)`).

A `Getter`/`Fold` is read-only; its composition law is definitional:

* `Getter.comp_get`: `get (comp g h) s = get h (get g s)`;
* `Fold.comp_toList`: `toList (comp f g) s = flatMap (toList g) (toList f s)`.

The laws are proved for the concrete lenses/traversals below (and the generic list and
statement traversals); the composition of two lenses/traversals is provided and its law
is exercised on the fixture rather than proved generically (the generic proof needs the
same list-fusion lemmas as the traversal laws).

## What is *not* an optic

A fixpoint (points-to, reaching definitions), a lowering pass, a parser, a validator and
a function that has to maintain a column/CSR invariant are ordinary functions. They
transform or build a whole structure; an optic would only hide that. Use an optic when
the question is "which parts of this existing value do I read (or locally rewrite)?"
and the answer is a path that composes.

## Additive by decision

`wiz-notes/analysis-optics-decisions.md` O12: this module does not migrate a pass or a
CLI query. The taint rules, points-to fixpoint and `Scry.Query` still call their existing
functions. The tests exercise the API beside them; a pass migrates only after the laws,
tests and measurements are green.
-/


-- ## The four optics

/-- A read-only focus on one `A` in an `S`. `Getter.comp` is the path composition. -/
structure Scry.Getter (S A : Type) where
  /-- The focused value. -/
  get : S → A

/-- A read-only focus on zero or more `A`s in an `S`. This is the CST/facts traversal:
direct, non-mutating, and composed with `Fold.comp`. -/
structure Scry.Fold (S A : Type) where
  /-- Every focused value, in traversal order. -/
  toList : S → List A

/-- A read-only lens: one focus, and a pure rewrite of that focus. There is no `set`
that mutates a store; `over` returns a new value. Only Wil values get these (O4). -/
structure Scry.Lens (S A : Type) where
  /-- The focused value. -/
  get : S → A
  /-- Rewrite the focus, returning a new `S`. -/
  over : (A → A) → S → S

/-- A read-only traversal: zero or more focuses, and a pure rewrite of every focus. -/
structure Scry.Traversal (S A : Type) where
  /-- Every focused value, in traversal order. -/
  toList : S → List A
  /-- Rewrite every focus, returning a new `S`. -/
  over : (A → A) → S → S

-- ## Getter: one read-only focus

/-- Read the focus. -/
def Scry.Getter.read {S A : Type} (g : Scry.Getter S A) (s : S) : A := g.get s

/-- A getter as a fold of zero or one element. -/
def Scry.Getter.toFold {S A : Type} (g : Scry.Getter S A) : Scry.Fold S A :=
  Scry.Fold.mk (fun s => .cons (g.get s) .nil)

/-- Compose two getters: read the outer focus, then the inner one. -/
def Scry.Getter.comp {S A B : Type} (g : Scry.Getter S A) (h : Scry.Getter A B) :
    Scry.Getter S B :=
  Scry.Getter.mk (fun s => h.get (g.get s))

/-- The composition law for getters is definitional. -/
def Scry.Getter.comp_get {S A B : Type} (g : Scry.Getter S A) (h : Scry.Getter A B) (s : S) :
    (Scry.Getter.comp g h).get s = h.get (g.get s) := rfl

-- ## Fold: zero or more read-only focuses

/-- The focused values, in order. -/
def Scry.Fold.read {S A : Type} (f : Scry.Fold S A) (s : S) : List A := f.toList s

/-- Compose two folds: for each outer focus, take the inner fold. -/
def Scry.Fold.comp {S A B : Type} (f : Scry.Fold S A) (g : Scry.Fold A B) :
    Scry.Fold S B :=
  Scry.Fold.mk (fun s => List.flatMap (f.toList s) g.toList)

/-- The composition law for folds is definitional. -/
def Scry.Fold.comp_toList {S A B : Type} (f : Scry.Fold S A) (g : Scry.Fold A B) (s : S) :
    (Scry.Fold.comp f g).toList s = List.flatMap (f.toList s) g.toList := rfl

/-- Map a getter over every focus of a fold. This is the common query path:
`Fold S A → Getter A B → Fold S B`. -/
def Scry.Fold.mapGetter {S A B : Type} (f : Scry.Fold S A) (g : Scry.Getter A B) :
    Scry.Fold S B :=
  Scry.Fold.mk (fun s => List.map g.get (f.toList s))

/-- Map a pure function over every focus. -/
def Scry.Fold.map {S A B : Type} (f : Scry.Fold S A) (g : A → B) : Scry.Fold S B :=
  Scry.Fold.mk (fun s => List.map g (f.toList s))

/-- Keep the focuses that satisfy `p`. -/
def Scry.Fold.filter {S A : Type} (p : A → Bool) (f : Scry.Fold S A) : Scry.Fold S A :=
  Scry.Fold.mk (fun s => List.filter p (f.toList s))

/-- Fold the focuses from the left. -/
def Scry.Fold.foldl {S A B : Type} (g : B → A → B) (b : B) (f : Scry.Fold S A) (s : S) : B :=
  List.foldl g b (f.toList s)

/-- The number of focuses. -/
def Scry.Fold.length {S A : Type} (f : Scry.Fold S A) (s : S) : Nat :=
  List.length (f.toList s)

/-- Whether some focus satisfies `p`. -/
def Scry.Fold.any {S A : Type} (p : A → Bool) (f : Scry.Fold S A) (s : S) : Bool :=
  List.any p (f.toList s)

/-- Whether every focus satisfies `p` (true when there are none). -/
def Scry.Fold.all {S A : Type} (p : A → Bool) (f : Scry.Fold S A) (s : S) : Bool :=
  List.all p (f.toList s)

/-- The first focus satisfying `p`. -/
def Scry.Fold.find {S A : Type} (p : A → Bool) (f : Scry.Fold S A) (s : S) : Option A :=
  List.find p (f.toList s)

-- ## Lens: one focus with a pure local rewrite

/-- A lens as a getter. -/
def Scry.Lens.toGetter {S A : Type} (l : Scry.Lens S A) : Scry.Getter S A :=
  Scry.Getter.mk l.get

/-- A lens as a fold of one element. -/
def Scry.Lens.toFold {S A : Type} (l : Scry.Lens S A) : Scry.Fold S A :=
  Scry.Fold.mk (fun s => .cons (l.get s) .nil)

/-- A lens as a one-element traversal. -/
def Scry.Lens.toTraversal {S A : Type} (l : Scry.Lens S A) : Scry.Traversal S A :=
  Scry.Traversal.mk (fun s => .cons (l.get s) .nil) l.over

/-- Set the focus to a constant (the derived write). -/
def Scry.Lens.set {S A : Type} (l : Scry.Lens S A) (a : A) (s : S) : S :=
  l.over (fun _ => a) s

/-- Compose two lenses: get the inner focus, rewrite it in place. -/
def Scry.Lens.comp {S A B : Type} (l : Scry.Lens S A) (m : Scry.Lens A B) :
    Scry.Lens S B :=
  Scry.Lens.mk (fun s => m.get (l.get s))
    (fun f s => l.over (fun a => m.over f a) s)

/-- The get-composition law is definitional. -/
def Scry.Lens.comp_get {S A B : Type} (l : Scry.Lens S A) (m : Scry.Lens A B) (s : S) :
    (Scry.Lens.comp l m).get s = m.get (l.get s) := rfl

/-- GetOver: a rewrite changes the focus by exactly that function. -/
def Scry.Lens.GetOver {S A : Type} (l : Scry.Lens S A) : Prop :=
  (f : A → A) → (s : S) → l.get (l.over f s) = f (l.get s)

/-- OverId: rewriting with the identity changes nothing. -/
def Scry.Lens.OverId {S A : Type} (l : Scry.Lens S A) : Prop :=
  (s : S) → l.over (fun a => a) s = s

/-- OverOver: two rewrites compose. -/
def Scry.Lens.OverOver {S A : Type} (l : Scry.Lens S A) : Prop :=
  (f g : A → A) → (s : S) → l.over f (l.over g s) = l.over (fun a => f (g a)) s

-- ## Traversal: many focuses with a pure local rewrite

/-- A traversal as a fold. -/
def Scry.Traversal.toFold {S A : Type} (t : Scry.Traversal S A) : Scry.Fold S A :=
  Scry.Fold.mk t.toList

/-- A one-element traversal from a lens. -/
def Scry.Traversal.fromLens {S A : Type} (l : Scry.Lens S A) : Scry.Traversal S A :=
  Scry.Traversal.mk (fun s => .cons (l.get s) .nil) l.over

/-- Compose two traversals: for each outer focus, traverse the inner one. -/
def Scry.Traversal.comp {S A B : Type} (t : Scry.Traversal S A) (u : Scry.Traversal A B) :
    Scry.Traversal S B :=
  Scry.Traversal.mk
    (fun s => List.flatMap (t.toList s) u.toList)
    (fun f s => t.over (fun a => u.over f a) s)

/-- The toList composition law is definitional. -/
def Scry.Traversal.comp_toList {S A B : Type} (t : Scry.Traversal S A) (u : Scry.Traversal A B) (s : S) :
    (Scry.Traversal.comp t u).toList s = List.flatMap (t.toList s) u.toList := rfl

/-- OverId for a traversal. -/
def Scry.Traversal.OverId {S A : Type} (t : Scry.Traversal S A) : Prop :=
  (s : S) → t.over (fun a => a) s = s

/-- OverList: a rewrite maps exactly the focused values. -/
def Scry.Traversal.OverList {S A : Type} (t : Scry.Traversal S A) : Prop :=
  (f : A → A) → (s : S) → t.toList (t.over f s) = List.map f (t.toList s)

-- `List.map` with the identity is the identity. The list traversals below need it, and
-- the library does not state it yet.
/-- `List.map id xs = xs`. -/
def Scry.listMapId {A : Type} : (xs : List A) → List.map (fun x => x) xs = xs
  | .nil => rfl
  | .cons x xs => Eq.congrArg (List.cons x) (Scry.listMapId xs)

/-- The list traversal: every element, in order; `over` is `List.map`. -/
def Scry.Traversal.list {A : Type} : Scry.Traversal (List A) A :=
  Scry.Traversal.mk (fun xs => xs) (fun f xs => List.map f xs)

/-- `Traversal.list` satisfies OverId. -/
def Scry.Traversal.list_overId {A : Type} : Scry.Traversal.OverId (@Scry.Traversal.list A) :=
  Scry.listMapId

/-- `Traversal.list` satisfies OverList (definitionally). -/
def Scry.Traversal.list_overList {A : Type} : Scry.Traversal.OverList (@Scry.Traversal.list A) :=
  fun f xs => rfl

-- ## Wil: statements, terms and origins

/-- A statement's origin, with a pure rewrite. Each constructor of `Wil.Stmt` stores the
origin last, so every law is by cases and `rfl`. -/
def Scry.Wil.stmtOriginL : Scry.Lens Wil.Stmt Wil.Span :=
  Scry.Lens.mk Wil.stmtOrigin
    (fun f s => Wil.withOrigin s (f (Wil.stmtOrigin s)))

/-- `stmtOriginL` satisfies GetOver. -/
def Scry.Wil.stmtOriginL_getOver : Scry.Lens.GetOver Scry.Wil.stmtOriginL :=
  fun f s => match s with
    | .assign x e o => rfl
    | .assume c o => rfl
    | .store p v o => rfl
    | .free p o => rfl
    | .call r c a o => rfl
    | .nop o => rfl

/-- `stmtOriginL` satisfies OverId. -/
def Scry.Wil.stmtOriginL_overId : Scry.Lens.OverId Scry.Wil.stmtOriginL :=
  fun s => match s with
    | .assign x e o => rfl
    | .assume c o => rfl
    | .store p v o => rfl
    | .free p o => rfl
    | .call r c a o => rfl
    | .nop o => rfl

/-- `stmtOriginL` satisfies OverOver. -/
def Scry.Wil.stmtOriginL_overOver : Scry.Lens.OverOver Scry.Wil.stmtOriginL :=
  fun f g s => match s with
    | .assign x e o => rfl
    | .assume c o => rfl
    | .store p v o => rfl
    | .free p o => rfl
    | .call r c a o => rfl
    | .nop o => rfl

/-- A terminator's origin, with a pure rewrite. -/
def Scry.Wil.termOriginL : Scry.Lens Wil.Term Wil.Span :=
  Scry.Lens.mk Wil.termOrigin
    (fun f t => Wil.withTermOrigin t (f (Wil.termOrigin t)))

/-- `termOriginL` satisfies GetOver. -/
def Scry.Wil.termOriginL_getOver : Scry.Lens.GetOver Scry.Wil.termOriginL :=
  fun f t => match t with
    | .goto b o => rfl
    | .br c x y o => rfl
    | .ret v o => rfl
    | .unreachable o => rfl

/-- `termOriginL` satisfies OverId. -/
def Scry.Wil.termOriginL_overId : Scry.Lens.OverId Scry.Wil.termOriginL :=
  fun t => match t with
    | .goto b o => rfl
    | .br c x y o => rfl
    | .ret v o => rfl
    | .unreachable o => rfl

/-- `termOriginL` satisfies OverOver. -/
def Scry.Wil.termOriginL_overOver : Scry.Lens.OverOver Scry.Wil.termOriginL :=
  fun f g t => match t with
    | .goto b o => rfl
    | .br c x y o => rfl
    | .ret v o => rfl
    | .unreachable o => rfl

/-- A function's definition origin, with a pure rewrite. -/
def Scry.Wil.funcOriginL : Scry.Lens Wil.Func Wil.Span :=
  Scry.Lens.mk (fun fn => fn.origin)
    (fun f fn => { fn with origin := f fn.origin })

/-- `funcOriginL` satisfies GetOver (a structure field). -/
def Scry.Wil.funcOriginL_getOver : Scry.Lens.GetOver Scry.Wil.funcOriginL :=
  fun f fn => rfl
/-- `funcOriginL` satisfies OverId. -/
def Scry.Wil.funcOriginL_overId : Scry.Lens.OverId Scry.Wil.funcOriginL :=
  fun fn => rfl
/-- `funcOriginL` satisfies OverOver. -/
def Scry.Wil.funcOriginL_overOver : Scry.Lens.OverOver Scry.Wil.funcOriginL :=
  fun f g fn => rfl

/-- Every statement of a block, in order. -/
def Scry.Wil.blockStmtsT : Scry.Traversal Wil.Block Wil.Stmt :=
  Scry.Traversal.mk (fun b => b.stmts)
    (fun f b => { b with stmts := List.map f b.stmts })

/-- `blockStmtsT` satisfies OverList (definitionally). OverId on a concrete block is
`rfl` after the list reduces; the generic statement is a structure equality with one
field updated, which Wiz states componentwise, so it is tested on the fixture rather
than proved here. -/
def Scry.Wil.blockStmtsT_overList : Scry.Traversal.OverList Scry.Wil.blockStmtsT :=
  fun f b => rfl

/-- Every block of a function, in order. -/
def Scry.Wil.funcBlocksT : Scry.Traversal Wil.Func Wil.Block :=
  Scry.Traversal.mk (fun fn => fn.blocks)
    (fun f fn => { fn with blocks := List.map f fn.blocks })

/-- `funcBlocksT` satisfies OverList (definitionally). -/
def Scry.Wil.funcBlocksT_overList : Scry.Traversal.OverList Scry.Wil.funcBlocksT :=
  fun f fn => rfl

/-- Every statement of a function (blocks in order). -/
def Scry.Wil.funcStmtsT : Scry.Traversal Wil.Func Wil.Stmt :=
  Scry.Traversal.comp Scry.Wil.funcBlocksT Scry.Wil.blockStmtsT

/-- Every terminator of a function (one per block). -/
def Scry.Wil.funcTermsT : Scry.Traversal Wil.Func Wil.Term :=
  Scry.Traversal.mk
    (fun fn => List.map (fun b => b.term) fn.blocks)
    (fun f fn => { fn with blocks := List.map (fun b => { b with term := f b.term }) fn.blocks })

/-- Every statement origin of a function, as a traversal of spans. -/
def Scry.Wil.funcStmtOriginsT : Scry.Traversal Wil.Func Wil.Span :=
  Scry.Traversal.comp Scry.Wil.funcStmtsT
    (Scry.Lens.toTraversal Scry.Wil.stmtOriginL)

-- ## Scry.Analysis: uses, definitions and dependencies

/-- A statement's reads, as a read-only fold. -/
def Scry.Analysis.stmtUsesF : Scry.Fold Wil.Stmt Nat :=
  Scry.Fold.mk Scry.stmtUses

/-- A statement's writes, as a read-only fold. -/
def Scry.Analysis.stmtDefsF : Scry.Fold Wil.Stmt Nat :=
  Scry.Fold.mk Scry.stmtDefs

/-- A terminator's reads, as a read-only fold. -/
def Scry.Analysis.termUsesF : Scry.Fold Wil.Term Nat :=
  Scry.Fold.mk Scry.termUses

/-- A right-hand side's reads, as a read-only fold. -/
def Scry.Analysis.rhsUsesF : Scry.Fold Wil.Rhs Nat :=
  Scry.Fold.mk Scry.rhsUses

/-- Every use in a function's points, as a read-only fold. -/
def Scry.Analysis.fnUsesF : Scry.Fold Scry.FnInfo Nat :=
  Scry.Fold.mk (fun info =>
    Scry.concatLists (fun n => Scry.usesAt info.g n) (Scry.range info.g.count))

/-- Every definition `(point, register)` in a function, as a read-only fold. -/
def Scry.Analysis.fnDefsF : Scry.Fold Scry.FnInfo (Nat × Nat) :=
  Scry.Fold.mk (fun info => info.defs)

/-- Every data-dependence edge in a function, as a read-only fold. -/
def Scry.Analysis.fnDepsF : Scry.Fold Scry.FnInfo Scry.DataDep :=
  Scry.Fold.mk (fun info => info.deps)

/-- A data-dependence edge's definition point. -/
def Scry.Analysis.depFrom : Scry.Getter Scry.DataDep Nat :=
  Scry.Getter.mk (fun d => d.from)

/-- A data-dependence edge's use point. -/
def Scry.Analysis.depTo : Scry.Getter Scry.DataDep Nat :=
  Scry.Getter.mk (fun d => d.to)

/-- A data-dependence edge's register. -/
def Scry.Analysis.depVar : Scry.Getter Scry.DataDep Nat :=
  Scry.Getter.mk (fun d => d.var)

/-- A data-dependence edge's register, with a pure rewrite. -/
def Scry.Analysis.depVarL : Scry.Lens Scry.DataDep Nat :=
  Scry.Lens.mk (fun d => d.var) (fun f d => { d with var := f d.var })

/-- `depVarL` satisfies GetOver (a structure field). -/
def Scry.Analysis.depVarL_getOver : Scry.Lens.GetOver Scry.Analysis.depVarL :=
  fun f d => rfl
/-- `depVarL` satisfies OverId. -/
def Scry.Analysis.depVarL_overId : Scry.Lens.OverId Scry.Analysis.depVarL :=
  fun d => rfl
/-- `depVarL` satisfies OverOver. -/
def Scry.Analysis.depVarL_overOver : Scry.Lens.OverOver Scry.Analysis.depVarL :=
  fun f g d => rfl

-- ## Scry.PointsTo: read-only views of the analysis state

/-- The points-to solution of a result. -/
def Scry.PointsTo.ptStateG : Scry.Getter Scry.PtResult Scry.PtState :=
  Scry.Getter.mk (fun r => r.state)

/-- The deterministic location table of a result. -/
def Scry.PointsTo.ptLocsF : Scry.Fold Scry.PtResult Scry.Loc :=
  Scry.Fold.mk (fun r => r.locs)

/-- The abstract locations of one register. -/
def Scry.PointsTo.ptLocF (func : String) (var : Nat) : Scry.Fold Scry.PtResult Scry.Loc :=
  Scry.Fold.mk (fun r => Scry.ptLocs r func var)

/-- The location ids of one register. -/
def Scry.PointsTo.ptIdF (func : String) (var : Nat) : Scry.Fold Scry.PtResult Nat :=
  Scry.Fold.mk (fun r => Scry.ptIds r func var)

/-- The registers that have a location, as a read-only fold. -/
def Scry.PointsTo.ptVarsF : Scry.Fold Scry.PtState (Scry.VarKey × List Scry.Loc) :=
  Scry.Fold.mk (fun st => st.pt)

/-- The resolved targets of an indirect call. -/
def Scry.PointsTo.indirectF (func : String) (point : Nat) : Scry.Fold Scry.PtResult String :=
  Scry.Fold.mk (fun r => (Scry.indirectAt r func point).names)

-- ## Query and rewrite examples

/-- The registers a function reads, via the def-use layer. -/
def Scry.Optics.fnUses (info : Scry.FnInfo) : List Nat :=
  Scry.Fold.toList Scry.Analysis.fnUsesF info


/-- The registers a function writes, via the def-use layer. -/
def Scry.Optics.fnDefs (info : Scry.FnInfo) : List (Nat × Nat) :=
  Scry.Fold.toList Scry.Analysis.fnDefsF info


/-- The data-dependence edges of a function. -/
def Scry.Optics.fnDeps (info : Scry.FnInfo) : List Scry.DataDep :=
  Scry.Fold.toList Scry.Analysis.fnDepsF info

-- ## Rewrite examples: pure, and only over Wil


/-- Shift every statement origin of a function by `d` bytes, leaving the program
semantics unchanged. This is the rewrite shape optics are good at: a path to a small
part, a local pure update. -/
def Scry.Optics.shiftStmtOrigins (d : Nat) (fn : Wil.Func) : Wil.Func :=
  Scry.Traversal.over Scry.Wil.funcStmtOriginsT
    (fun sp => Wil.Span.mk sp.file (Nat.add sp.start d) (Nat.add sp.stop d) sp.node) fn


/-- Rename the register of every data-dependence edge, pure. -/
def Scry.Optics.renameDepVars (f : Nat → Nat) (info : Scry.FnInfo) : Scry.FnInfo :=
  { info with deps := List.map (fun dep => Scry.Lens.over Scry.Analysis.depVarL f dep) info.deps }

