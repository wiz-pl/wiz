import Prelude
import Text
import Scry.Wil
import Scry.Analysis
import Scry.AiCfg
import Scry.AiDomain
import Scry.AiFixpoint
import Scry.RuleTaint
/-!
# Scry.Nullness: the S5 null-dereference check, wired to Wil

`Scry.AiFixpoint` has the nullness alarm (`Alarm.nullDeref`) but no Wil frontend, so the
`scry taint` pipeline never ran it. This module is the missing translation: it builds the
`ACfg` of a Wil function, runs the same worklist/fixpoint engine, and turns the alarm into
the `scry/memory/null-dereference` diagnostic the CVE corpus expects.

## The translation

Wil program points become CFG blocks. A statement point whose lowering needs more than one
abstract statement (a `load` result, a `store`, a call result) gets a short chain of
blocks; the terminator point gets a `skip` block carrying its guards. The abstract
variables are the Wil registers, so `AState` is a per-point register environment.

The nullness projections are:

| Wil | abstract |
|---|---|
| `cst .nul` | `.null` — definitely null |
| `cst` integer / `bin` / `un` | a non-null value |
| `slot`, `gep` of a non-null base | non-null pointer |
| `alloc` (`malloc`/`calloc`/`realloc`) | **maybe null**: the allocation can fail |
| `load` | its **base** is checked; the loaded pointer is assumed non-null (no memory nullness) |
| `call` result | **maybe null** unless a constant-return summary proves otherwise |
| `store` | a dereference of the base: alarms when the base may be null |
| `free` | no dereference (`free(NULL)` is defined) |

A memory access through a pointer parameter is *not* reported by default: a function
parameter is given a non-null entry value, so the pass does not flag every
`f(p) { p->x }`. That is a deliberate assumption ("callers pass valid objects"), stated
here rather than hidden. It means a null that arrives through a parameter and is only
discovered in the callee (CVE-2020-1971, CVE-2021-3449) is a documented false negative;
the local pattern (a pointer set to null by an allocation, a failed call or a literal,
then dereferenced without a guard) is what this pass reports.

## The guard kill

A two-way branch refines nullness on both edges: `if (p)` / `if (p != NULL)` gives
`p ≠ null` on the true edge, `if (!p)` / `if (p == NULL)` gives `p = null`; an early
`return` after the check therefore removes the null value from the path that reaches the
dereference. In addition, `condKnown` evaluates a branch when its operands are constant in
the post-fixpoint state, and unreachable targets are pruned before the alarms are read.
That is what makes `if (status == APR_SUCCESS) { req->method }` silent when the callee
always returns `APR_ENOMEM`: the guard is constant-false, the guarded block is unreachable,
and the definitely-null `req` is only dereferenced on the unreachable path.

## Limits

* No memory nullness: a field store (`s.p = NULL`) is not tracked. A pointer read from
  memory is therefore treated as non-null for the *next* access (its own access is still
  checked); a NULL in a field is a documented false negative, not a source of chained
  warnings.
* A parameter is non-null at entry (above), so nullness does not flow into a callee.
* Function points are capped at `maxNullPoints`; a larger function is skipped, because the
  list-based worklist is a prototype and the pass must not turn a one-minute CVE analysis
  into a ten-minute one.
* Branch conditions with `&&`/`||` refine only their first nullness test.

## Frontend facts

A frontend that knows more than Wil's types (C#: `T?`, `#nullable enable`, `!`) supplies
a `Scry.NullTables` per function: which parameter registers allow null at entry, which
statements define a maybe-null value regardless of their RHS, which statements
dereference a register, which statements assert one non-null, and which registers are
non-null by annotation. `Scry.nullDerefWarningsWith` uses them; `Scry.nullDerefWarnings`
passes `NullTables.empty`, so the C frontend supplies no facts and its alarms are the
load/store ones (the reserved-register split below applies to both). The tables become
the statements `AStmt.check` (a dereference) and `AStmt.checkAssign` (an assignment to a
non-null-annotated register, the CS8600 shape).
-/

/-- The largest function the nullness pass runs on. Larger functions are skipped (the
worklist is list-based; see the module note). -/
def Scry.maxNullPoints : Nat := 300

/-- One block of the translated CFG: the Wil point it belongs to and the abstract
statement. -/
structure Scry.NBlock where
  point : Nat
  stmt : AStmt

/-- A translated function: the CFG, the block -> point map, and the point -> first/last
block bases. -/
structure Scry.NCfg where
  cfg : ACfg
  blocks : List (Nat × Scry.NBlock)
  bases : List (Nat × Nat × Nat)

def Scry.nIsPtr (t : Wil.Ty) : Bool :=
  match t with
  | .ptr _ => .true
  | _ => .false

/-- The variable index reserved for an unknown value (`top`, hence maybe-null). It is one
past every register the function mentions. -/
def Scry.nMaxVar (fn : Wil.Func) : Nat :=
  let g := Scry.flatten fn;
  let fromStmts := List.foldl (fun acc p =>
    match Scry.nodeStmt g p with
    | .none => match Scry.nodeTerm g p with
      | .some t => List.foldl (fun a v => Nat.max a (Nat.succ v)) acc (Scry.termUses t)
      | .none => acc
    | .some s =>
      let uses := Scry.stmtUses s;
      let defs := Scry.stmtDefs s;
      List.foldl (fun a v => Nat.max a (Nat.succ v)) acc (List.append uses defs))
    (List.foldl (fun a v => Nat.max a (Nat.succ v.index)) 0
      (List.append fn.params fn.locals)) (Scry.range g.count);
  fromStmts

/-- The reserved registers are `nMaxVar` (the unknown value: `havoc`, an unknown call
result, an unknown operator) and `nMaxVar + 1` (the scratch a load's base check writes).
They are distinct: a load-base check must not define the unknown-value register as a
non-null load result, or every later maybe-null value would read back as non-null. -/
def Scry.nHavoc (fn : Wil.Func) : Nat := Scry.nMaxVar fn

def Scry.nScratch (fn : Wil.Func) : Nat := Nat.succ (Scry.nMaxVar fn)

def Scry.nVars (fn : Wil.Func) : List Nat :=
  Scry.range (Nat.succ (Scry.nScratch fn))

/-- The entry environment: parameters are valid objects (non-null); everything else is
unknown. `maybe` lists parameter registers whose **declared annotation** allows null
(a C# `T?`, or an unannotated reference outside a `#nullable enable` context): they
enter as `Value.top`, which the nullness domain reads as "may be null". -/
def Scry.nEntryEnvWith (maybe : List Nat) (fn : Wil.Func) : AiEnv :=
  List.foldl (fun env v => AiEnv.set v.index
      (match List.any (Nat.beq v.index) maybe with
        | .true => Value.top
        | .false => Value.intTop) env)
    (AiEnv.topOf (Scry.nVars fn)) fn.params

def Scry.nEntryEnv (fn : Wil.Func) : AiEnv := Scry.nEntryEnvWith .nil fn

-- ## Frontend-supplied nullness tables

/-- Facts a frontend that knows more than Wil's types publishes for one function. The C#
lowering supplies all of them; the C frontend supplies none, so its analysis is exactly
the previous one. Every list is restricted to the function being analysed
(`Scry.nullDerefWarningsWith` splits the program-wide table once per function). -/
structure Scry.NullTables where
  /-- Parameter registers whose declaration allows null. -/
  paramsMaybe : List Nat
  /-- `(node, var)`: the value assigned to `var` where the statement's origin node is
  `node` is maybe-null whatever the RHS says (`as`, a `T?` field read, a
  `FirstOrDefault`-shaped call). -/
  mayNull : List (Nat × Nat)
  /-- `(node, var)`: a dereference of `var` at a statement with this origin node. -/
  derefs : List (Nat × Nat)
  /-- `(node, var)`: the value assigned to `var` at this node is asserted non-null
  (C#'s `!`). -/
  asserts : List (Nat × Nat)
  /-- Registers whose declared annotation is non-null: an assignment to one that may be
  null is a `nullableAssign` alarm (CS8600 shape). -/
  nonNull : List Nat

def Scry.NullTables.empty : Scry.NullTables :=
  Scry.NullTables.mk .nil .nil .nil .nil .nil

/-- The origin node of a statement (`0` for a hand-built one). -/
def Scry.stmtNode : Wil.Stmt → Nat
  | .assign _ _ sp => sp.node
  | .assume _ sp => sp.node
  | .store _ _ sp => sp.node
  | .free _ sp => sp.node
  | .call _ _ _ sp => sp.node
  | .nop sp => sp.node

def Scry.nodeHas (l : List (Nat × Nat)) (node v : Nat) : Bool :=
  List.any (fun p => Bool.and (Nat.beq p.1 node) (Nat.beq p.2 v)) l

-- ## Constant-return summaries

/-- The number a constant stands for in a guard: an integer literal, or 0 for the null
pointer. The lowering writes a pointer zero (`!p`, `p == NULL` on a pointer) as `nul`, so
without the second case a pointer guard is never an `isNull`/`notNull` test. -/
def Scry.nConstVal : Wil.Val → Option Nat
  | .int _ _ n => .some n
  | .nul => .some 0
  | _ => .none

/-- A register's only definition is a constant, so it is that constant everywhere. Only
unambiguous definitions are recorded (`none` marks a conflict); this is enough for a
status code returned from a failed helper. -/
def Scry.constVars (g : Scry.Fn) : List (Nat × Option Nat) :=
  List.foldl (fun acc d =>
    match Scry.nodeStmt g d.1 with
    | .some (.assign x (.cst v) _) => (match Scry.nConstVal v with
      | .none => acc
      | .some n =>
        if Nat.beq x.index d.2 then
          match List.find (fun p => Nat.beq p.1 d.2) acc with
          | .none => List.cons (d.2, .some n) acc
          | .some p => match p.2 with
            | .none => acc
            | .some m =>
              if Nat.beq m n then acc
              else List.cons (d.2, (.none : Option Nat))
                (List.filter (fun q => Bool.not (Nat.beq q.1 d.2)) acc)
        else acc)
    | _ => acc) .nil (Scry.defsOf g)

/-- The unambiguous constant of a register, if it has one. -/
def Scry.constOfVar (cs : List (Nat × Option Nat)) (v : Nat) : Option Nat :=
  match List.find (fun p => Nat.beq p.1 v) cs with
  | .none => .none
  | .some p => p.2

/-- A function whose every `ret` is the same integer literal. Used to resolve a status
code at a call site (`if (status == SUCCESS)`), which is how the fixed CVE-2017-7659
control kills the null dereference. -/
def Scry.retConstOf (fn : Wil.Func) : Option Nat :=
  let g := Scry.flatten fn;
  match Nat.le g.count Scry.maxNullPoints with
  | .false => .none
  | .true =>
    let defs := Scry.defsOf g;
    let rd := Scry.rdIn g defs;
    let consts := Scry.constVars g;
    let result := List.foldl (fun acc p =>
      match Scry.nodeTerm g p with
      | .none => acc
      | .some (.ret (.some v) _) =>
        let ds := Scry.rdForVar defs rd p v.index;
        match ds with
        | .nil => .none
        | .cons d _ =>
          let first : Option Nat := match Scry.nodeStmt g d with
            | .some (.assign x (.cst (.int _ _ n)) _) =>
              if Nat.beq x.index v.index then .some n else .none
            | .some (.assign x (.use y) _) =>
              if Nat.beq x.index v.index then Scry.constOfVar consts y.index else .none
            | _ => .none;
          match first with
          | .none => .none
          | .some n =>
            let same := List.all (fun d2 =>
              match Scry.nodeStmt g d2 with
              | .some (.assign x (.cst (.int _ _ n2)) _) =>
                Bool.and (Nat.beq x.index v.index) (Nat.beq n n2)
              | .some (.assign x (.use y) _) =>
                Bool.and (Nat.beq x.index v.index)
                  (match Scry.constOfVar consts y.index with
                   | .some m => Nat.beq n m
                   | .none => .false)
              | _ => .false) ds;
            match same with
            | .true => match acc with
              | .none => .some n
              | .some m => if Nat.beq n m then .some n else .none
            | .false => .none
      | .some (.ret .none _) => .none
      | _ => acc) (.none : Option Nat) (Scry.range g.count);
    result

def Scry.retConstTable (p : Wil.Program) : List (String × Nat) :=
  List.foldl (fun acc fn =>
    match Scry.retConstOf fn with
    | .some n => List.cons (fn.name, n) acc
    | .none => acc) .nil p.funcs

def Scry.retConstOfName (tab : List (String × Nat)) (name : String) : Option Nat :=
  match List.find (fun p => String.eq p.1 name) tab with
  | .none => .none
  | .some p => .some p.2

-- ## Conditions

/-- The nullness-relevant half of a mapped condition. -/
def Scry.pickNull (a b : Option ACond) : Option ACond :=
  match a with
  | .some (.isNull _) => a
  | .some (.notNull _) => a
  | _ => b

def Scry.negCond : ACond → ACond
  | .lt x e => .ge x e
  | .le x e => .gt x e
  | .gt x e => .le x e
  | .ge x e => .lt x e
  | .eq x e => .ne x e
  | .ne x e => .eq x e
  | .isNull x => .notNull x
  | .notNull x => .isNull x

/-- Map a Wil condition to an abstract guard. `zero` registers make `p == 0` an
`isNull`/`notNull` test, which is what the guard kill uses. -/
def Scry.nCond (consts : List (Nat × Option Nat)) (c : Wil.Cond) : Option ACond :=
  match c with
  | .const _ => .none
  | .not c1 => match Scry.nCond consts c1 with
    | .none => .none
    | .some a => .some (Scry.negCond a)
  | .and a b => Scry.pickNull (Scry.nCond consts a) (Scry.nCond consts b)
  | .or _ _ => .none
  | .cmp op a b =>
    let za := Scry.constOfVar consts a.index;
    let zb := Scry.constOfVar consts b.index;
    match op with
    | .eq => match zb with
      | .some 0 => .some (.isNull a.index)
      | _ => match za with
        | .some 0 => .some (.isNull b.index)
        | _ => .some (.eq a.index (AExpr.var b.index))
    | .ne => match zb with
      | .some 0 => .some (.notNull a.index)
      | _ => match za with
        | .some 0 => .some (.notNull b.index)
        | _ => .some (.ne a.index (AExpr.var b.index))
    | .lt => .some (.lt a.index (AExpr.var b.index))
    | .le => .some (.le a.index (AExpr.var b.index))
    | .gt => .some (.gt a.index (AExpr.var b.index))
    | .ge => .some (.ge a.index (AExpr.var b.index))
    | _ => .none

/-- Evaluate a condition whose operands are known in the post-fixpoint state. -/
def Scry.cmpKnown (op : Wil.Op) (a b : Nat) : Option Bool :=
  match op with
  | .eq => .some (Nat.beq a b)
  | .ne => .some (Bool.not (Nat.beq a b))
  | .lt => .some (Nat.lt a b)
  | .le => .some (Nat.le a b)
  | .gt => .some (Nat.lt b a)
  | .ge => .some (Nat.le b a)
  | _ => .none

def Scry.condKnown (env : AiEnv) (c : Wil.Cond) : Option Bool :=
  match c with
  | .const b => .some b
  | .not c1 => match Scry.condKnown env c1 with
    | .some b => .some (Bool.not b)
    | .none => .none
  | .and a b => match Scry.condKnown env a, Scry.condKnown env b with
    | .some .false, _ => .some .false
    | _, .some .false => .some .false
    | .some .true, .some .true => .some .true
    | _, _ => .none
  | .or a b => match Scry.condKnown env a, Scry.condKnown env b with
    | .some .true, _ => .some .true
    | _, .some .true => .some .true
    | .some .false, .some .false => .some .false
    | _, _ => .none
  | .cmp op a b =>
    let va := AiEnv.getD env a.index Value.top;
    let vb := AiEnv.getD env b.index Value.top;
    match va.cst, vb.cst with
    | .known x, .known y => Scry.cmpKnown op x y
    | .known 0, _ =>
      match op with
      | .eq => match vb.nul with
        | .nul => .some .true
        | .nonNull => .some .false
        | _ => .none
      | .ne => match vb.nul with
        | .nul => .some .false
        | .nonNull => .some .true
        | _ => .none
      | _ => .none
    | _, .known 0 =>
      match op with
      | .eq => match va.nul with
        | .nul => .some .true
        | .nonNull => .some .false
        | _ => .none
      | .ne => match va.nul with
        | .nul => .some .false
        | .nonNull => .some .true
        | _ => .none
      | _ => .none
    | _, _ => match op with
      | .eq => match va.nul, vb.nul with
        | .nul, .nul => .some .true
        | .nul, .nonNull => .some .false
        | .nonNull, .nul => .some .false
        | _, _ => .none
      | .ne => match va.nul, vb.nul with
        | .nul, .nul => .some .false
        | .nul, .nonNull => .some .true
        | .nonNull, .nul => .some .true
        | _, _ => .none
      | _ => .none

-- ## Statements

/-- The abstract value of a Wil right-hand side. A loaded pointer and a call result are
unknown; allocations are **maybe null** (they can fail); a stack slot is a fresh non-null
object. -/
def Scry.nRhs (fn : Wil.Func) (tab : List (String × Nat)) (e : Wil.Rhs) : AExpr :=
  match e with
  | .use v => AExpr.var v.index
  | .cst .nul => AExpr.null
  | .cst (.int _ _ n) => AExpr.lit n
  | .cst (.ptr _ _) => AExpr.alloc (AExpr.lit 1)
  | .cst .undef => AExpr.var (Scry.nHavoc fn)
  | .bin op a b => match op with
    | .add => AExpr.add (AExpr.var a.index) (AExpr.var b.index)
    | .sub => AExpr.sub (AExpr.var a.index) (AExpr.var b.index)
    | .mul => AExpr.mul (AExpr.var a.index) (AExpr.var b.index)
    | _ => AExpr.var (Scry.nHavoc fn)
  | .un _ _ => AExpr.var (Scry.nHavoc fn)
  | .load p => AExpr.load p.index (AExpr.lit 0) 1
  | .gep p _ => AExpr.var p.index
  | .gepVar p _ _ => AExpr.var p.index
  | .alloc _ => AExpr.var (Scry.nHavoc fn)
  | .slot _ => AExpr.alloc (AExpr.lit 1)
  | .globalRef _ => AExpr.alloc (AExpr.lit 1)
  | .fnptr _ => AExpr.alloc (AExpr.lit 1)
  | .havoc _ => AExpr.var (Scry.nHavoc fn)

/-- The abstract statements of one Wil statement. A call contributes its result (a
constant when the callee's return summary proves one, otherwise an unknown). The
frontend's tables refine the value a statement assigns (maybe-null or asserted non-null),
add a receiver dereference check, and turn an assignment to a non-null-annotated
register into the CS8600-shaped `checkAssign`. -/
def Scry.nStmts (fn : Wil.Func) (tab : List (String × Nat))
    (tbls : Scry.NullTables) (consts : List (Nat × Option Nat)) (s : Wil.Stmt) :
    List AStmt :=
  let node := Scry.stmtNode s;
  let havoc := AExpr.var (Scry.nHavoc fn);
  let over := fun (v : Nat) (d : AExpr) =>
    match Scry.nodeHas tbls.mayNull node v with
    | .true => havoc
    | .false => match Scry.nodeHas tbls.asserts node v with
      | .true => AExpr.alloc (AExpr.lit 1)
      | .false => d;
  let defOf := fun (v : Wil.Var) (d : AExpr) =>
    match List.any (Nat.beq v.index) tbls.nonNull with
    | .true => AStmt.checkAssign v.index (over v.index d)
    | .false => AStmt.assign v.index (over v.index d);
  -- A fact is keyed by the *node*, and a construct can emit several statements at one
  -- node (the `?.` guard's null constant, the call, the result copy). The dereference is
  -- only the statement that actually uses the value: a call with it as an argument (a
  -- receiver, an element or an argument), or a copy from it (an unboxing cast).
  let isDerefStmt := fun (v : Nat) => match s with
    | .call _ _ args _ => List.any (fun a => Nat.beq a.index v) args
    | .assign _ (.use y) _ => Nat.beq y.index v
    | _ => .false;
  let checks : List AStmt := List.map (fun p => AStmt.check p.2)
    (List.filter (fun p => Bool.and (Nat.beq p.1 node) (isDerefStmt p.2)) tbls.derefs);
  let body : List AStmt := match s with
    | .assign x (.load p) _ =>
      -- Two statements: one checks the base (the alarm), the other gives the loaded
      -- value a **non-null** abstract value, unless the frontend says the field's
      -- declared type allows null. A pointer read out of memory is not tracked as a
      -- null field (no memory nullness); treating every one as maybe-null would warn on
      -- every `p = s->field; p->x` chain. The access through the base is still checked.
      List.cons (AStmt.assign (Scry.nScratch fn) (AExpr.load p.index (AExpr.lit 0) 1))
        (List.cons (defOf x (AExpr.alloc (AExpr.lit 1))) .nil)
    | .assign x e _ =>
      let rhs : AExpr := match e, x.ty with
        | .cst (.int _ _ 0), .ptr _ => AExpr.null
        | _, _ => Scry.nRhs fn tab e;
      List.cons (defOf x rhs) .nil
    | .assume c _ => match Scry.nCond consts c with
      | .some a => List.cons (AStmt.assume a) .nil
      | .none => .nil
    | .store p _ _ => List.cons (AStmt.store p.index (AExpr.lit 0) 1) .nil
    | .free _ _ => .nil
    | .call r callee _args _ =>
      match r with
      | .some v =>
        let e := match callee with
          | .direct name => match Scry.retConstOfName tab name with
            | .some 0 => match v.ty with
              | .ptr _ => AExpr.null
              | _ => AExpr.lit 0
            | .some n => AExpr.lit n
            | .none => havoc
          | .indirect _ => havoc;
        -- A call result is trusted against the callee's declared contract *unless* the
        -- frontend marks the call as maybe-null by its shape (`FirstOrDefault`, an
        -- absent environment variable). Only then is an assignment to a
        -- non-null-annotated variable a `checkAssign` alarm.
        let may := Scry.nodeHas tbls.mayNull node v.index;
        let val := match may with
          | .true => havoc
          | .false => e;
        let stmt := match Bool.and (List.any (Nat.beq v.index) tbls.nonNull) may with
          | .true => AStmt.checkAssign v.index val
          | .false => AStmt.assign v.index val;
        List.cons stmt .nil
      | .none => .nil
    | .nop _ => .nil;
  List.append body checks

/-- The number of CFG blocks a point needs (at least one, so a terminator has a block to
carry its guards). -/
def Scry.nSize (fn : Wil.Func) (tab : List (String × Nat)) (tbls : Scry.NullTables)
    (consts : List (Nat × Option Nat)) (g : Scry.Fn) (p : Nat) : Nat :=
  match Scry.nodeStmt g p with
  | .none => 1
  | .some s => Nat.max 1 (List.length (Scry.nStmts fn tab tbls consts s))

def Scry.nStmtAt (fn : Wil.Func) (tab : List (String × Nat)) (tbls : Scry.NullTables)
    (consts : List (Nat × Option Nat)) (g : Scry.Fn) (p : Nat) (j : Nat) : AStmt :=
  match Scry.nodeStmt g p with
  | .none => AStmt.skip
  | .some s => match Wil.listNth (Scry.nStmts fn tab tbls consts s) j with
    | .some a => a
    | .none => AStmt.skip

/-- Allocate block bases: point `p` owns `[base, base + size)`. -/
def Scry.nBases (fn : Wil.Func) (tab : List (String × Nat)) (tbls : Scry.NullTables)
    (consts : List (Nat × Option Nat)) (g : Scry.Fn) :
    List (Nat × Nat × Nat) × Nat :=
  List.foldl (fun acc p =>
    let size := Scry.nSize fn tab tbls consts g p;
    (List.append acc.1 (List.cons (p, acc.2, size) .nil), Nat.add acc.2 size))
    (.nil, 0) (Scry.range g.count)

def Scry.nBaseOf (bases : List (Nat × Nat × Nat)) (p : Nat) : Nat :=
  match List.find (fun t => Nat.beq t.1 p) bases with
  | .some t => t.2.1
  | .none => 0

def Scry.nSizeOf (bases : List (Nat × Nat × Nat)) (p : Nat) : Nat :=
  match List.find (fun t => Nat.beq t.1 p) bases with
  | .some t => t.2.2
  | .none => 1

def Scry.nLastOf (bases : List (Nat × Nat × Nat)) (p : Nat) : Nat :=
  Nat.sub (Nat.add (Scry.nBaseOf bases p) (Scry.nSizeOf bases p)) 1

/-- Translate one function to an `ACfg`, with the frontend's nullness tables. -/
def Scry.translateWith (fn : Wil.Func) (tab : List (String × Nat))
    (tbls : Scry.NullTables) : Scry.NCfg :=
  let g := Scry.flatten fn;
  let consts := Scry.constVars g;
  let bases := (Scry.nBases fn tab tbls consts g).1;
  let blocks := Scry.concatLists (fun p =>
    let base := Scry.nBaseOf bases p;
    let size := Scry.nSizeOf bases p;
    List.map (fun j => (Nat.add base j, Scry.NBlock.mk p (Scry.nStmtAt fn tab tbls consts g p j)))
      (Scry.range size)) (Scry.range g.count);
  let stmts := List.map (fun b => (b.1, b.2.stmt)) blocks;
  let intra := Scry.concatLists (fun p =>
    let base := Scry.nBaseOf bases p;
    let size := Scry.nSizeOf bases p;
    List.map (fun j => AEdge.mk (Nat.add base j) (Nat.add base (Nat.succ j)) .none)
      (Scry.range (Nat.sub size 1))) (Scry.range g.count);
  let inter := Scry.concatLists (fun p =>
    let from := Scry.nLastOf bases p;
    match Scry.nodeTerm g p with
    | .some (.br c t f _) =>
      let ca := Scry.nCond consts c;
      let cf : Option ACond := match ca with
        | .none => .none
        | .some a => .some (Scry.negCond a);
      List.cons (AEdge.mk from (Scry.nBaseOf bases (Scry.nodeOf g t 0)) ca)
        (List.cons (AEdge.mk from (Scry.nBaseOf bases (Scry.nodeOf g f 0)) cf) .nil)
    | _ =>
      List.map (fun q => AEdge.mk from (Scry.nBaseOf bases q) .none) (Scry.succs g p))
    (Scry.range g.count);
  Scry.NCfg.mk
    (ACfg.mk (Scry.nBaseOf bases (Scry.entryNode g)) (Scry.nVars fn) stmts
      (List.append intra inter))
    blocks bases

/-- The CFG translation with no frontend facts (the C analysis). -/
def Scry.translate (fn : Wil.Func) (tab : List (String × Nat)) : Scry.NCfg :=
  Scry.translateWith fn tab Scry.NullTables.empty

-- ## Reachability and alarms

/-- The reachable Wil points under the post-fixpoint state. A branch whose condition is
constant-false only keeps the other target, so a guarded block is not alarmed. -/
partial def Scry.nReachGo (g : Scry.Fn) (ncfg : Scry.NCfg) (st : AState)
    (work : List Nat) (seen : List Nat) : List Nat :=
  match work with
  | .nil => seen
  | .cons p rest =>
    match Scry.memNat p seen with
    | .true => Scry.nReachGo g ncfg st rest seen
    | .false =>
      let seen' := List.cons p seen;
      let succs := Scry.succs g p;
      let next := match Scry.nodeTerm g p with
        | .some (.br c t f _) =>
          let env := AState.at ncfg.cfg st (Scry.nLastOf ncfg.bases p);
          match Scry.condKnown env c with
          | .some .true => List.cons (Scry.nodeOf g t 0) .nil
          | .some .false => List.cons (Scry.nodeOf g f 0) .nil
          | .none => succs
        | _ => succs;
      Scry.nReachGo g ncfg st (List.append rest next) seen'

/-- The warning detail for a block: the kind of access a human should see. -/
def Scry.nullDetail (b : Scry.NBlock) : String :=
  match b.stmt with
  | .assign _ (.load arr _ _) =>
    "load through pointer register " ++ Nat.repr arr ++ ", which may be null"
  | .store arr _ _ =>
    "store through pointer register " ++ Nat.repr arr ++ ", which may be null"
  | .check v =>
    "dereference of register " ++ Nat.repr v ++ ", which may be null"
  | .checkAssign x _ =>
    "non-null-annotated register " ++ Nat.repr x ++ " assigned a value that may be null"
  | _ => "memory access through a pointer that may be null"

/-- The nullness warnings of one translated function: a dereference of a maybe-null
value, and an assignment of a maybe-null value to a non-null-annotated variable. Both
are read off the same post-fixpoint; they are separate alarm classes so the second can
be reported where no dereference follows (the CS8600 shape). -/
def Scry.nullWarningsOfCfg (fnName : String) (ncfg : Scry.NCfg) (st : AState)
    (reach : List Nat) : List Scry.MemWarning :=
  Scry.concatLists (fun b =>
    let point := b.2.point;
    match Scry.memNat point reach with
    | .false => .nil
    | .true =>
      let alarms := AStmt.alarms (AiMach.mk 64) b.1
        (AState.at ncfg.cfg st b.1) b.2.stmt;
      let derefs := List.filter (fun a => match a with
        | .nullDeref _ => .true
        | _ => .false) alarms;
      let assigns := List.filter (fun a => match a with
        | .nullableAssign _ => .true
        | _ => .false) alarms;
      List.append
        (List.map (fun _ => Scry.memWarning Scry.MemWarnKind.nullDereference fnName point
          (Scry.nullDetail b.2)) derefs)
        (List.map (fun _ => Scry.memWarning Scry.MemWarnKind.nullableAssignment fnName point
          (Scry.nullDetail b.2)) assigns)) ncfg.blocks

/-- The nullness warnings of one function, with the frontend's tables. -/
def Scry.nullWarningsOfFuncWith (fn : Wil.Func) (tab : List (String × Nat))
    (tbls : Scry.NullTables) : List Scry.MemWarning :=
  let g := Scry.flatten fn;
  match Nat.le g.count Scry.maxNullPoints with
  | .false => .nil
  | .true =>
    let ncfg := Scry.translateWith fn tab tbls;
    let st := fixpointFrom (AiMach.mk 64) ncfg.cfg (Scry.nEntryEnvWith tbls.paramsMaybe fn);
    let reach := Scry.nReachGo g ncfg st
      (List.cons (Scry.entryNode g) .nil) .nil;
    Scry.nullWarningsOfCfg fn.name ncfg st reach

/-- The nullness warnings of one function with no frontend facts. -/
def Scry.nullWarningsOfFunc (fn : Wil.Func) (tab : List (String × Nat)) : List Scry.MemWarning :=
  Scry.nullWarningsOfFuncWith fn tab Scry.NullTables.empty

/-- Deduplicate null warnings by function and point and kind (one per access; a
dereference and an annotation alarm at the same statement stay separate). -/
def Scry.dedupNullWarnings (ws : List Scry.MemWarning) : List Scry.MemWarning :=
  List.foldl (fun acc w =>
    let key := w.func ++ "|" ++ Nat.repr w.point ++ "|" ++ Scry.MemWarnKind.show w.kind;
    match List.any (fun x =>
      String.eq (x.func ++ "|" ++ Nat.repr x.point ++ "|" ++ Scry.MemWarnKind.show x.kind) key) acc with
    | .true => acc
    | .false => List.append acc (List.cons w .nil)) .nil ws

/-- Every nullness warning of a program. `Scry.analyzeWithNull` runs it; the default
`Scry.analyze` does not (the CLI flag is `--null-deref`). -/
def Scry.nullDerefWarnings (p : Wil.Program) : List Scry.MemWarning :=
  let tab := Scry.retConstTable p;
  Scry.dedupNullWarnings
    (Scry.concatLists (fun fn => Scry.nullWarningsOfFunc fn tab) p.funcs)

/-- The same over a program with a program-wide frontend table. The table is keyed by
the `Wil.Func` itself: parameter facts need the function's parameter count, so a name
alone is not enough. -/
def Scry.nullDerefWarningsWith (p : Wil.Program)
    (tablesOf : Wil.Func → Scry.NullTables) : List Scry.MemWarning :=
  let tab := Scry.retConstTable p;
  Scry.dedupNullWarnings
    (Scry.concatLists (fun fn => Scry.nullWarningsOfFuncWith fn tab (tablesOf fn)) p.funcs)
