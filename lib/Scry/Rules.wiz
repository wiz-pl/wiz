import Text
/-!
# Scry.Rules

A **rule pack** for taint-style analyses (`import Scry.Rules`): named rules with an id, a
severity, a message, sources and sanitisers *per argument*, sinks *per argument*, and
function-name matching. This is the S4 "real rule pack and spec file" slice; the
prototype's `Scry.TaintSpec` (a bare source/sanitiser/sink triple) stays for the
intraprocedural examples.

## The `.scry` format

A pack is a sequence of blocks:

```
# command injection
rule command-injection
  kind taint
  severity error
  message Attacker-controlled data reaches a command interpreter
  source getenv result
  source recv result
  source read arg 1
  sanitise escape_shell result
  sanitise sanitize arg 0
  sink system arg 0
  sink popen arg 0
end
```

* `rule ID` starts a block and `end` closes it. A missing `end` is closed at end of file.
* `kind taint` (the default) or `kind forbidden` (a call that is unsafe whenever it
  appears: `gets`, `strcpy`).
* `severity error|warning|note` (default `warning`).
* `message TEXT` takes the rest of the line.
* `source NAME result|arg K`, `sanitise NAME result|arg K` (also spelled `sanitize`),
  `sink NAME arg K`. `result` is the default when the argument selector is omitted.
* `call NAME` (§`kind forbidden` only) names a forbidden callee.
* Blank lines and lines starting with `#` are comments; unknown keywords are ignored.

`NAME` is matched against the callee name with `*` as a wildcard, so `mem*` matches
`memcpy` and `memset`. Matching is over the whole name (`strcpy*` does not match
`astrcpy`), and `Scry.TaintSpec`'s exact matching is unchanged.

## What a per-argument source means

`source read arg 1` says that argument 1 is written by the call (a buffer filled with
attacker data); `source getenv result` says the *result* is. Likewise a sanitiser can
clean its result or an argument in place. The caller of these models is
`Scry.RuleTaint`, which turns a written argument into an extra definition point so the
ordinary def-use layer can carry the value on.
-/

-- ## Severity, argument selectors and path nodes

inductive Scry.Severity where
  | error
  | warning
  | note

def Scry.Severity.show : Scry.Severity → String
  | .error => "error"
  | .warning => "warning"
  | .note => "note"

/-- The SARIF `level` spelling. -/
def Scry.Severity.sarif : Scry.Severity → String := Scry.Severity.show

def Scry.Severity.parse (s : String) : Scry.Severity :=
  if String.eq s "error" then .error
  else if String.eq s "note" then .note
  else .warning

/-- Which part of a call a source or sanitiser names. -/
inductive Scry.ArgRef where
  | result
  | arg (index : Nat)

def Scry.ArgRef.show : Scry.ArgRef → String
  | .result => "result"
  | .arg k => String.append "arg " (Nat.repr k)

/-- The kind of a finding. -/
inductive Scry.FindingKind where
  | taint
  | forbidden

def Scry.FindingKind.show : Scry.FindingKind → String
  | .taint => "taint"
  | .forbidden => "forbidden"

/-- A step of a source -> sink path (the `origin`-carrying location is a separate map,
see `Scry.Sarif`). `var` is the register that carries the value, `point` the program
point of `func`. -/
inductive Scry.PathKind where
  | source
  | param
  | call
  | returnSeed
  | returnValue
  | flow
  /-- A store into a memory location (`store`): the path enters memory here. -/
  | store
  /-- A load from a memory location: the path leaves memory here. -/
  | load
  | sink
  | recursion
  | assumed

def Scry.PathKind.show : Scry.PathKind → String
  | .source => "source"
  | .param => "parameter"
  | .call => "call"
  | .returnSeed => "return"
  | .returnValue => "return-value"
  | .flow => "flow"
  | .store => "store"
  | .load => "load"
  | .sink => "sink"
  | .recursion => "recursion"
  | .assumed => "assumed"

structure Scry.PathNode where
  func : String
  point : Nat
  var : Nat
  kind : Scry.PathKind

/-- A finding with its rule metadata and evidence path. The path is evidence, not a
proof; `Scry.Certify` turns the underlying alert into a checked derivation. -/
structure Scry.RuleFinding where
  rule : String
  severity : Scry.Severity
  message : String
  kind : Scry.FindingKind
  /-- The function the sink is in. -/
  func : String
  /-- The sink's program point. -/
  sink : Nat
  /-- The callee name. -/
  name : String
  /-- The checked argument index. -/
  arg : Nat
  path : List Scry.PathNode

-- ## The rules

structure Scry.RuleSink where
  name : String
  arg : Nat

/-- Optional reporting metadata for a rule (`name`, description, CWE ids, help URI,
security severity, precision and tags). It is emitted as the SARIF reporting descriptor's
`shortDescription`/`fullDescription`/`helpUri`/`properties`. Every field may be empty:
`Scry.Sarif` then falls back to its built-in table for the default rule ids, and finally
to the rule id and pack message, so an old pack without metadata still produces a valid
descriptor. -/
structure Scry.RuleInfo where
  /-- A short human name (`Command injection`), not the id. -/
  name : String
  /-- The long description; `""` means "use the pack message". -/
  description : String
  /-- CWE ids (`[78]`). An empty list means no CWE mapping. -/
  cwe : List Nat
  /-- A documentation URL. -/
  helpUri : String
  /-- GitHub's `security-severity`, a 0.0-10.0 score as text (`"9.8"`). -/
  securitySeverity : String
  /-- `high`, `medium`, `low` or `""` (the SARIF default, `medium`). -/
  precision : String
  /-- Extra tags; `Scry.Sarif` adds `security` and the `external/cwe/cwe-NNN` tags. -/
  tags : List String

def Scry.RuleInfo.empty (id : String) : Scry.RuleInfo :=
  Scry.RuleInfo.mk "" "" .nil "" "" "" .nil

def Scry.RuleInfo.setName (name : String) (i : Scry.RuleInfo) : Scry.RuleInfo :=
  { i with name := name }

def Scry.RuleInfo.setDescription (description : String) (i : Scry.RuleInfo) : Scry.RuleInfo :=
  { i with description := description }

def Scry.RuleInfo.addCwe (n : Nat) (i : Scry.RuleInfo) : Scry.RuleInfo :=
  { i with cwe := List.append i.cwe (List.cons n .nil) }

def Scry.RuleInfo.setHelpUri (uri : String) (i : Scry.RuleInfo) : Scry.RuleInfo :=
  { i with helpUri := uri }

def Scry.RuleInfo.setSecuritySeverity (s : String) (i : Scry.RuleInfo) : Scry.RuleInfo :=
  { i with securitySeverity := s }

def Scry.RuleInfo.setPrecision (s : String) (i : Scry.RuleInfo) : Scry.RuleInfo :=
  { i with precision := s }

def Scry.RuleInfo.addTag (t : String) (i : Scry.RuleInfo) : Scry.RuleInfo :=
  { i with tags := List.append i.tags (List.cons t .nil) }

/-- Fill the empty fields of `primary` from `fallback` (a built-in table entry). A field
the pack sets always wins; CWE ids and tags are only taken from the fallback when the
pack has none of its own. -/
def Scry.RuleInfo.merge (primary fallback : Scry.RuleInfo) : Scry.RuleInfo :=
  let name := match String.isEmpty primary.name with
    | .true => fallback.name
    | .false => primary.name;
  let description := match String.isEmpty primary.description with
    | .true => fallback.description
    | .false => primary.description;
  let cwe := match primary.cwe with
    | .nil => fallback.cwe
    | _ => primary.cwe;
  let helpUri := match String.isEmpty primary.helpUri with
    | .true => fallback.helpUri
    | .false => primary.helpUri;
  let securitySeverity := match String.isEmpty primary.securitySeverity with
    | .true => fallback.securitySeverity
    | .false => primary.securitySeverity;
  let precision := match String.isEmpty primary.precision with
    | .true => fallback.precision
    | .false => primary.precision;
  Scry.RuleInfo.mk name description cwe helpUri securitySeverity precision
    (List.append primary.tags fallback.tags)

structure Scry.TaintRule where
  id : String
  severity : Scry.Severity
  message : String
  /-- `(callee pattern, part written by the call)`. -/
  sources : List (String × Scry.ArgRef)
  /-- `(callee pattern, part cleaned by the call)`. -/
  sanitisers : List (String × Scry.ArgRef)
  sinks : List Scry.RuleSink
  /-- Human name, CWE ids, help URI and tags for the SARIF descriptor. -/
  info : Scry.RuleInfo

structure Scry.ForbiddenRule where
  id : String
  severity : Scry.Severity
  message : String
  calls : List String
  info : Scry.RuleInfo

inductive Scry.PackRule where
  | taint (r : Scry.TaintRule)
  | forbidden (r : Scry.ForbiddenRule)

def Scry.PackRule.id : Scry.PackRule → String
  | .taint r => r.id
  | .forbidden r => r.id

def Scry.PackRule.severity : Scry.PackRule → Scry.Severity
  | .taint r => r.severity
  | .forbidden r => r.severity

def Scry.PackRule.message : Scry.PackRule → String
  | .taint r => r.message
  | .forbidden r => r.message

def Scry.PackRule.kind : Scry.PackRule → Scry.FindingKind
  | .taint _ => .taint
  | .forbidden _ => .forbidden

def Scry.PackRule.info : Scry.PackRule → Scry.RuleInfo
  | .taint r => r.info
  | .forbidden r => r.info

structure Scry.RulePack where
  rules : List Scry.PackRule

def Scry.rulePackConcat {A B : Type} (f : A → List B) : List A → List B
  | .nil => .nil
  | .cons x xs => List.append (f x) (Scry.rulePackConcat f xs)

def Scry.RulePack.taintRules (p : Scry.RulePack) : List Scry.TaintRule :=
  Scry.rulePackConcat (fun r => match r with
    | .taint t => List.cons t .nil
    | .forbidden _ => .nil) p.rules

def Scry.RulePack.forbiddenRules (p : Scry.RulePack) : List Scry.ForbiddenRule :=
  Scry.rulePackConcat (fun r => match r with
    | .taint _ => .nil
    | .forbidden f => List.cons f .nil) p.rules

-- ## Function-name matching

/-- Glob matching with `*` as "any sequence": the character list form. -/
partial def Scry.globChars (pat s : List Char) : Bool :=
  match pat with
  | .nil => List.isEmpty s
  | .cons c ps =>
    if Char.eq c (Char.mk 42) then
      Bool.or (Scry.globChars ps s)
        (match s with
          | .nil => .false
          | .cons _ ss => Scry.globChars pat ss)
    else
      match s with
      | .nil => .false
      | .cons d ds => Bool.and (Char.eq c d) (Scry.globChars ps ds)

/-- Whether the callee name matches the rule pattern (`*` is a wildcard). -/
def Scry.nameMatches (pat name : String) : Bool :=
  Scry.globChars (String.chars pat) (String.chars name)

-- ## The parser

/-- Split on spaces, dropping the empty words a run of spaces produces. -/
def Scry.words (s : String) : List String :=
  List.filter (fun w => Bool.not (String.isEmpty w)) (String.splitOn s " ")

/-- The text after `kw ` on a trimmed line, if the line starts with it. -/
def Scry.restOf (line kw : String) : Option String :=
  String.stripPrefix line (String.append kw " ")

/-- Parse the `result` / `arg K` selector (default `result`). -/
def Scry.parseArgRef (rest : List String) : Scry.ArgRef :=
  match rest with
  | .cons head (.cons k _) =>
    if String.eq head "arg" then
      match String.parseNat (String.trim k) with
      | .some n => Scry.ArgRef.arg n
      | .none => .result
    else .result
  | _ => .result

structure Scry.PartialRule where
  id : String
  kind : String
  severity : Scry.Severity
  message : String
  sources : List (String × Scry.ArgRef)
  sanitisers : List (String × Scry.ArgRef)
  sinks : List Scry.RuleSink
  calls : List String
  info : Scry.RuleInfo

def Scry.PartialRule.fresh (id : String) : Scry.PartialRule :=
  Scry.PartialRule.mk id "taint" .warning "" .nil .nil .nil .nil (Scry.RuleInfo.empty id)

def Scry.PartialRule.finish (r : Scry.PartialRule) : Scry.PackRule :=
  if String.eq r.kind "forbidden" then
    .forbidden (Scry.ForbiddenRule.mk r.id r.severity r.message r.calls r.info)
  else
    .taint (Scry.TaintRule.mk r.id r.severity r.message r.sources r.sanitisers r.sinks r.info)

structure Scry.PackState where
  cur : Option Scry.PartialRule
  rules : List Scry.PackRule

def Scry.PackState.empty : Scry.PackState := Scry.PackState.mk .none .nil

def Scry.PackState.finish (st : Scry.PackState) : Scry.PackState :=
  match st.cur with
  | .none => st
  | .some r => Scry.PackState.mk .none (List.cons (Scry.PartialRule.finish r) st.rules)

def Scry.PartialRule.addSink (name : String) (rest : List String)
    (r : Scry.PartialRule) : Scry.PartialRule :=
  match rest with
  | .cons _ (.cons idx _) => match String.parseNat (String.trim idx) with
    | .some n => { r with sinks := List.cons (Scry.RuleSink.mk name n) r.sinks }
    | .none => r
  | _ => r

def Scry.PartialRule.addLine (words : List String) (r : Scry.PartialRule) : Scry.PartialRule :=
  match words with
  | .cons kw rest =>
    if String.eq kw "kind" then
      match rest with
      | .cons k _ => { r with kind := k }
      | .nil => r
    else if String.eq kw "severity" then
      match rest with
      | .cons s _ => { r with severity := Scry.Severity.parse s }
      | .nil => r
    else if Bool.or (String.eq kw "source")
        (Bool.or (String.eq kw "sanitise") (String.eq kw "sanitize")) then
      match rest with
      | .cons name sel =>
        let ref := Scry.parseArgRef sel;
        if String.eq kw "source" then { r with sources := List.cons (name, ref) r.sources }
        else { r with sanitisers := List.cons (name, ref) r.sanitisers }
      | .nil => r
    else if String.eq kw "sink" then
      match rest with
      | .cons name sel => Scry.PartialRule.addSink name sel r
      | .nil => r
    else if String.eq kw "call" then
      match rest with
      | .cons name _ => { r with calls := List.cons name r.calls }
      | .nil => r
    else if String.eq kw "name" then
      match rest with
      | .cons _ _ => { r with info := Scry.RuleInfo.setName (String.intercalate " " rest) r.info }
      | .nil => r
    else if String.eq kw "description" then
      match rest with
      | .cons _ _ =>
        { r with info := Scry.RuleInfo.setDescription (String.intercalate " " rest) r.info }
      | .nil => r
    else if String.eq kw "cwe" then
      match rest with
      | .cons n _ => match String.parseNat (String.trim n) with
        | .some k => { r with info := Scry.RuleInfo.addCwe k r.info }
        | .none => r
      | .nil => r
    else if Bool.or (String.eq kw "help-uri") (String.eq kw "help") then
      match rest with
      | .cons uri _ => { r with info := Scry.RuleInfo.setHelpUri uri r.info }
      | .nil => r
    else if String.eq kw "security-severity" then
      match rest with
      | .cons s _ => { r with info := Scry.RuleInfo.setSecuritySeverity s r.info }
      | .nil => r
    else if String.eq kw "precision" then
      match rest with
      | .cons s _ => { r with info := Scry.RuleInfo.setPrecision s r.info }
      | .nil => r
    else if String.eq kw "tag" then
      match rest with
      | .cons t _ => { r with info := Scry.RuleInfo.addTag t r.info }
      | .nil => r
    else r
  | .nil => r

def Scry.PackState.addLine (line : String) (st : Scry.PackState) : Scry.PackState :=
  let line := String.trim line;
  if String.isEmpty line then st
  else if String.startsWith line "#" then st
  else
    let ws := Scry.words line;
    match ws with
    | .cons kw rest =>
      if String.eq kw "rule" then
        match rest with
        | .cons id _ =>
          let st' := st.finish;
          Scry.PackState.mk (.some (Scry.PartialRule.fresh id)) st'.rules
        | .nil => st
      else if String.eq kw "end" then st.finish
      else if String.eq kw "message" then
        match st.cur with
        | .none => st
        | .some r =>
          match Scry.restOf line "message" with
          | .some msg => Scry.PackState.mk (.some { r with message := String.trim msg }) st.rules
          | .none => st
      else
        match st.cur with
        | .none => st
        | .some r =>
          Scry.PackState.mk (.some (Scry.PartialRule.addLine ws r)) st.rules
    | .nil => st

/-- Parse a `.scry` rule pack. Unknown keywords and lines outside a block are ignored. -/
def Scry.parseRulePack (text : String) : Scry.RulePack :=
  let st := List.foldl (fun acc line => Scry.PackState.addLine line acc) Scry.PackState.empty
    (String.splitOn text "\n");
  let st := st.finish;
  Scry.RulePack.mk (List.reverse st.rules)

-- ## Rendering (for round-trip tests and diagnostics)

def Scry.renderSourceLine (kw name : String) (ref : Scry.ArgRef) : String :=
  match ref with
  | .result =>
    String.append (String.append (String.append "  " kw) (String.append " " name)) " result"
  | .arg k =>
    String.append (String.append (String.append (String.append "  " kw) (String.append " " name))
      " arg ") (Nat.repr k)

def Scry.RuleSink.render (s : Scry.RuleSink) : String :=
  String.append (String.append (String.append "  sink " s.name) " arg ") (Nat.repr s.arg)

def Scry.RuleInfo.render (i : Scry.RuleInfo) : String :=
  let name := match String.isEmpty i.name with
    | .true => ""
    | .false => String.append (String.append "  name " i.name) "\n";
  let description := match String.isEmpty i.description with
    | .true => ""
    | .false => String.append (String.append "  description " i.description) "\n";
  let cwes := String.join (List.map (fun n => String.append (String.append "  cwe "
    (Nat.repr n)) "\n") i.cwe);
  let helpUri := match String.isEmpty i.helpUri with
    | .true => ""
    | .false => String.append (String.append "  help-uri " i.helpUri) "\n";
  let severity := match String.isEmpty i.securitySeverity with
    | .true => ""
    | .false => String.append (String.append "  security-severity " i.securitySeverity) "\n";
  let precision := match String.isEmpty i.precision with
    | .true => ""
    | .false => String.append (String.append "  precision " i.precision) "\n";
  let tags := String.join (List.map (fun t => String.append (String.append "  tag " t) "\n")
    i.tags);
  String.join [name, description, cwes, helpUri, severity, precision, tags]

def Scry.PackRule.render (r : Scry.PackRule) : String :=
  match r with
  | .taint t =>
    let head := String.append (String.append (String.append (String.append
      (String.append (String.append "rule " t.id) "\n  kind taint\n  severity ")
      (Scry.Severity.show t.severity)) "\n  message ") t.message) "\n";
    let meta := Scry.RuleInfo.render t.info;
    let sources := String.join (List.map (fun p => Scry.renderSourceLine "source" p.1 p.2) t.sources);
    let sans := String.join (List.map (fun p => Scry.renderSourceLine "sanitise" p.1 p.2) t.sanitisers);
    let sinks := String.join (List.map Scry.RuleSink.render t.sinks);
    String.append (String.append (String.append (String.append head meta) (String.append sources sans)) "\n")
      (String.append sinks "\nend")
  | .forbidden f =>
    let head := String.append (String.append (String.append (String.append
      (String.append (String.append "rule " f.id) "\n  kind forbidden\n  severity ")
      (Scry.Severity.show f.severity)) "\n  message ") f.message) "\n";
    let meta := Scry.RuleInfo.render f.info;
    let calls := String.join (List.map (fun c => String.append "  call " c) f.calls);
    String.append (String.append (String.append head meta) calls) "\nend"

def Scry.RulePack.render (p : Scry.RulePack) : String :=
  String.join (List.map (fun r => String.append (Scry.PackRule.render r) "\n") p.rules)
