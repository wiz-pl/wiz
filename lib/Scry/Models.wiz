import Scry.Rules
import Text
/-!
# Scry.Models

**External function models** (`import Scry.Models`): what a call to a libc function or a
syscall wrapper does to taint and memory, written down once instead of being scattered
through the lowering and the taint rules.

The model table has three kinds of entry:

* **libc/syscall semantics** — `getenv`, `read`/`recv`, the `exec*` family, `system`,
  `popen`, the `printf`/`sprintf`/`snprintf` family, the `strcpy`/`strcat`/`memcpy`
  family, `malloc`/`calloc`/`realloc` and `free`. These are the calls whose effects a
  reader can reasonably expect a C taint tool to know.
* **base policy** — the sanitiser names the default rule pack trusts (`escape_shell`,
  `sanitize`, `sanitize_path`, …). They are models because a sanitiser is an effect on a
  value, not a rule-pack side table; putting them here makes the effect visible to tests
  and to any frontend. A model sanitiser is only applied when the pack names the
  function (`RulePack.trustsSanitiser`), so a pack that omits `sanitize` still gets the
  no-sanitiser behaviour.
* **pure/none** — calls such as `strlen` or `strcmp` that neither copy taint nor write
  memory. A model with an empty effect list is a claim that the call is **modelled as
  pure**, not a claim that the function is safe in general.
* **CLR (C#)** — the C# frontend emits CLR spellings (`Namespace.Type.Method`,
  `T[].get_Item`), so the same table carries the BCL reads it lowers to: any property
  getter, array/string lengths and element reads, `String` operations, LINQ projections,
  ASP.NET Core minimal-API registration calls, `TypedResults`/`Results` factories,
  `Console.ReadLine` and the HTTP request accessors as sources, and `ILogger.Log*` as a
  log-line sink (CWE-117). Writes through a receiver or an argument, constructors and
  `Dispose` are deliberately not modelled. See "CLR (C#) models" below.

## Effects

| effect | meaning |
|---|---|
| `source ref` | the result or an argument is attacker-controlled (a written buffer, `getenv`'s result) |
| `sink arg class` | the value at `arg` reaches a dangerous operation; `class` selects the rule (`command`, `format`, `length`, `size`) |
| `sanitise ref` | the result or an argument is cleaned in place |
| `copy dst src` | the call copies `src`'s contents into the object `dst` points at (`strcpy`) |
| `copyArgs dst first` | the call formats every argument from `first` into `dst` (`sprintf`, `snprintf`) |
| `alloc size count` | the call returns a fresh object; `size`/`count` are the size argument positions when they exist |
| `free arg` | the call may free the object at `arg` |
| `unknown` | the effect is not known; this is the explicit fallback for an unmodelled external |

`copyArgs` exists because a format call has no single source: the destination receives a
mixture of the format and its variadic arguments. It expands to `arity - first` copy
pairs, so the taint layer can treat each argument as a source of the written object.

## Unknown is explicit

`Scry.modelOf` returns `Option Scry.FnModel`; `Scry.modelFor` returns the `unknown` model
for a name that is not in the table. `Scry.isUnknownModel` is the predicate the analysis
uses to keep an unmodelled external's result and memory effect unknown (and to warn)
rather than silently treating the call as pure. An external call is only "modelled as
pure" when it has an entry with an empty effect list.

## Model rules

A sink effect names a class, and a class maps to one rule id: `command-injection`,
`format-string`, `buffer-overflow` or `integer-overflow`. `Scry.RulePack.withModels`
appends the missing rule descriptors (with no source/sink/sanitiser entries of their own)
so a rule pack does not have to repeat them. The descriptors are metadata for SARIF and
for a finding's `rule` field; the sink facts come from the model table.
-/

-- ## Effects

/-- The dangerous operation a sink argument reaches. The class selects the rule that
owns the finding. -/
inductive Scry.SinkClass where
  /-- A command interpreter or a command argument (`system`, `popen`, `exec*`). -/
  | command
  /-- A format string (`printf`, `sprintf`, `snprintf`). -/
  | format
  /-- A copy/read length or destination bound (`read`, `recv`, `snprintf`). -/
  | length
  /-- An allocation size (`malloc`, `calloc`, `realloc`). -/
  | size
  /-- A log line written to a file (a log-injection sink, CWE-117). -/
  | log

def Scry.SinkClass.show : Scry.SinkClass → String
  | .command => "command"
  | .format => "format"
  | .length => "length"
  | .size => "size"
  | .log => "log"

def Scry.SinkClass.ruleId : Scry.SinkClass → String
  | .command => "command-injection"
  | .format => "format-string"
  | .length => "buffer-overflow"
  | .size => "integer-overflow"
  | .log => "log-injection"

/-- Is this sink a log-line write? An integer written into a log line cannot forge a
record, so the model adds log sinks only for pointer-like (string/object) arguments. -/
def Scry.SinkClass.isLog : Scry.SinkClass → Bool
  | .log => .true
  | _ => .false

def Scry.SinkClass.severity : Scry.SinkClass → Scry.Severity
  | .command => .error
  | .format => .warning
  | .length => .warning
  | .size => .warning
  | .log => .warning

def Scry.SinkClass.message : Scry.SinkClass → String
  | .command => "Attacker-controlled data reaches a command interpreter"
  | .format => "Attacker-controlled data is used as a format string"
  | .length => "Attacker-controlled length reaches a copy or read; the destination can overflow"
  | .size => "Attacker-controlled value reaches an allocation size; the size may overflow or exhaust memory"
  | .log => "Attacker-controlled data reaches a log line written to a file"

/-- One effect of an external call. `ArgRef` is the rule pack's `result`/`arg K`
selector, so a model and a pack line mean the same thing. -/
/-- `copy dst src` writes `src`'s contents into the object `dst` points at;
`copyArgs dst first` writes the formatted arguments from `first` on into `dst`;
`alloc sizeArg countArg` returns a fresh object (the argument positions are optional,
so a format-driven allocation such as `asprintf` has neither); `free arg` frees the
object at `arg`; `unknown` is the explicit unmodelled fallback. -/
inductive Scry.Effect where
  | source (ref : Scry.ArgRef)
  | sink (arg : Nat) (sinkClass : Scry.SinkClass)
  | sanitise (ref : Scry.ArgRef)
  | copy (dst : Nat) (src : Nat)
  | copyArgs (dst : Nat) (first : Nat)
  | alloc (sizeArg : Option Nat) (countArg : Option Nat)
  | free (arg : Nat)
  | unknown

/-- The shape of an allocation effect. -/
structure Scry.AllocShape where
  sizeArg : Option Nat
  countArg : Option Nat

/-- One external function's model. `family` is descriptive (`libc`, `syscall`, `policy`,
`pure`); it is not consulted by the analysis. -/
structure Scry.FnModel where
  name : String
  family : String
  effects : List Scry.Effect
  note : String

-- ## Queries

def Scry.modelFlat {A B : Type} (f : A → List B) : List A → List B
  | .nil => .nil
  | .cons x xs => List.append (f x) (Scry.modelFlat f xs)

def Scry.modelSources (m : Scry.FnModel) : List Scry.ArgRef :=
  Scry.modelFlat (fun e => match e with
    | .source r => List.cons r .nil
    | _ => .nil) m.effects

def Scry.modelSans (m : Scry.FnModel) : List Scry.ArgRef :=
  Scry.modelFlat (fun e => match e with
    | .sanitise r => List.cons r .nil
    | _ => .nil) m.effects

def Scry.modelSinkArgs (m : Scry.FnModel) : List (Nat × Scry.SinkClass) :=
  Scry.modelFlat (fun e => match e with
    | .sink arg c => List.cons (arg, c) .nil
    | _ => .nil) m.effects

def Scry.modelRangeFrom : Nat → Nat → List Nat
  | .zero, _ => .nil
  | .succ k, first => List.append (Scry.modelRangeFrom k first)
      (List.cons (Nat.add first k) .nil)

/-- The `(destination, source)` pairs a model copies into. `arity` is the call's argument
count, which is what expands a `copyArgs` effect (a format call has no fixed arity). -/
def Scry.modelCopyPairs (m : Scry.FnModel) (arity : Nat) : List (Nat × Nat) :=
  Scry.modelFlat (fun e => match e with
    | .copy dst src => List.cons (dst, src) .nil
    | .copyArgs dst first => List.map (fun src => (dst, src))
        (Scry.modelRangeFrom (Nat.sub arity first) first)
    | _ => .nil) m.effects

def Scry.modelAlloc (m : Scry.FnModel) : Option Scry.AllocShape :=
  match List.find (fun e => match e with
    | .alloc _ _ => .true
    | _ => .false) m.effects with
  | .none => .none
  | .some e => match e with
    | .alloc sizeArg countArg => .some (Scry.AllocShape.mk sizeArg countArg)
    | _ => .none

def Scry.modelFreeArg (m : Scry.FnModel) : Option Nat :=
  match List.find (fun e => match e with
    | .free _ => .true
    | _ => .false) m.effects with
  | .none => .none
  | .some e => match e with
    | .free arg => .some arg
    | _ => .none

def Scry.modelHasUnknown (m : Scry.FnModel) : Bool :=
  List.any (fun e => match e with
    | .unknown => .true
    | _ => .false) m.effects

-- ## The table

def Scry.sourceGetenv : Scry.FnModel :=
  Scry.FnModel.mk "getenv" "libc" (List.cons (.source .result) .nil)
    "the environment value is attacker-controlled"

def Scry.sourceRead : Scry.FnModel :=
  Scry.FnModel.mk "read" "syscall"
    (List.cons (.source (.arg 1))
      (List.cons (.sink 2 .length) .nil))
    "fills buffer argument 1; the length argument 2 is a bound"

def Scry.sourceRecv : Scry.FnModel :=
  Scry.FnModel.mk "recv" "syscall"
    (List.cons (.source (.arg 1))
      (List.cons (.sink 2 .length) .nil))
    "fills buffer argument 1; the length argument 2 is a bound"

def Scry.sourceFgets : Scry.FnModel :=
  Scry.FnModel.mk "fgets" "libc" (List.cons (.source (.arg 0)) .nil)
    "fills buffer argument 0"

def Scry.sourceGetline : Scry.FnModel :=
  Scry.FnModel.mk "getline" "libc" (List.cons (.source (.arg 0)) .nil)
    "fills the line buffer argument 0"

def Scry.sourceFread : Scry.FnModel :=
  Scry.FnModel.mk "fread" "libc" (List.cons (.source (.arg 0)) .nil)
    "fills buffer argument 0"

def Scry.sinkSystem : Scry.FnModel :=
  Scry.FnModel.mk "system" "libc" (List.cons (.sink 0 .command) .nil)
    "argument 0 is passed to the shell"

def Scry.sinkPopen : Scry.FnModel :=
  Scry.FnModel.mk "popen" "libc" (List.cons (.sink 0 .command) .nil)
    "argument 0 is passed to the shell"

/-- `execl`/`execle`/`execlp` are variadic: the path is argument 0 and every argv entry
is a possible command argument. Positions 0–7 are modelled; a call with more arguments
is still handled by the lower-ranked positions, and the limit is stated here rather than
silently assuming one position. -/
def Scry.sinkExec : Scry.FnModel :=
  Scry.FnModel.mk "execl" "libc"
    (Scry.modelFlat (fun k => List.cons (.sink k .command) .nil)
      (Scry.modelRangeFrom 8 0))
    "path and every variadic argv entry are command sinks (positions 0–7)"

def Scry.sinkExeclp : Scry.FnModel :=
  Scry.FnModel.mk "execlp" "libc"
    (Scry.modelFlat (fun k => List.cons (.sink k .command) .nil)
      (Scry.modelRangeFrom 8 0))
    "path and every variadic argv entry are command sinks (positions 0–7)"

def Scry.sinkExecle : Scry.FnModel :=
  Scry.FnModel.mk "execle" "libc"
    (Scry.modelFlat (fun k => List.cons (.sink k .command) .nil)
      (Scry.modelRangeFrom 8 0))
    "path, argv and the environment are command sinks (positions 0–7)"

def Scry.sinkExecv : Scry.FnModel :=
  Scry.FnModel.mk "execv" "libc"
    (List.cons (.sink 0 .command) (List.cons (.sink 1 .command) .nil))
    "the path and the argv pointer"

def Scry.sinkExecvp : Scry.FnModel :=
  Scry.FnModel.mk "execvp" "libc"
    (List.cons (.sink 0 .command) (List.cons (.sink 1 .command) .nil))
    "the path and the argv pointer"

def Scry.sinkExecvpe : Scry.FnModel :=
  Scry.FnModel.mk "execvpe" "libc"
    (List.cons (.sink 0 .command)
      (List.cons (.sink 1 .command) (List.cons (.sink 2 .command) .nil)))
    "the path, the argv pointer and the environment"

def Scry.sinkExecve : Scry.FnModel :=
  Scry.FnModel.mk "execve" "libc"
    (List.cons (.sink 0 .command)
      (List.cons (.sink 1 .command) (List.cons (.sink 2 .command) .nil)))
    "the path, the argv pointer and the environment"

def Scry.sinkPosixSpawn : Scry.FnModel :=
  Scry.FnModel.mk "posix_spawn" "libc"
    (List.cons (.sink 1 .command)
      (List.cons (.sink 4 .command) (List.cons (.sink 5 .command) .nil)))
    "the path (1), argv (4) and environment (5); argument 0 is the pid output"

def Scry.sinkPosixSpawnp : Scry.FnModel :=
  Scry.FnModel.mk "posix_spawnp" "libc"
    (List.cons (.sink 1 .command)
      (List.cons (.sink 4 .command) (List.cons (.sink 5 .command) .nil)))
    "the path (1), argv (4) and environment (5); argument 0 is the pid output"

def Scry.sinkPrintf : Scry.FnModel :=
  Scry.FnModel.mk "printf" "libc" (List.cons (.sink 0 .format) .nil)
    "argument 0 is the format string"

def Scry.sinkFprintf : Scry.FnModel :=
  Scry.FnModel.mk "fprintf" "libc" (List.cons (.sink 1 .format) .nil)
    "argument 1 is the format string"

def Scry.sinkSprintf : Scry.FnModel :=
  Scry.FnModel.mk "sprintf" "libc"
    (List.cons (.sink 1 .format) (List.cons (.copyArgs 0 1) .nil))
    "argument 1 is the format; the formatted arguments are copied into the destination"

def Scry.sinkSnprintf : Scry.FnModel :=
  Scry.FnModel.mk "snprintf" "libc"
    (List.cons (.sink 1 .length)
      (List.cons (.sink 2 .format)
        (List.cons (.copyArgs 0 2) .nil)))
    "argument 1 is the bound, argument 2 the format; the formatted arguments are copied"

def Scry.sinkVprintf : Scry.FnModel :=
  Scry.FnModel.mk "vprintf" "libc" (List.cons (.sink 0 .format) .nil)
    "argument 0 is the format string"

def Scry.sinkVfprintf : Scry.FnModel :=
  Scry.FnModel.mk "vfprintf" "libc" (List.cons (.sink 1 .format) .nil)
    "argument 1 is the format string"

def Scry.sinkVsprintf : Scry.FnModel :=
  Scry.FnModel.mk "vsprintf" "libc"
    (List.cons (.sink 1 .format) (List.cons (.copyArgs 0 1) .nil))
    "argument 1 is the format; the formatted arguments are copied into the destination"

def Scry.sinkVsnprintf : Scry.FnModel :=
  Scry.FnModel.mk "vsnprintf" "libc"
    (List.cons (.sink 1 .length)
      (List.cons (.sink 2 .format)
        (List.cons (.copyArgs 0 2) .nil)))
    "argument 1 is the bound, argument 2 the format; the formatted arguments are copied"

def Scry.sinkSyslog : Scry.FnModel :=
  Scry.FnModel.mk "syslog" "libc" (List.cons (.sink 1 .format) .nil)
    "argument 1 is the format string"

def Scry.sinkDprintf : Scry.FnModel :=
  Scry.FnModel.mk "dprintf" "libc" (List.cons (.sink 1 .format) .nil)
    "argument 1 is the format string"

def Scry.copyStrcpy : Scry.FnModel :=
  Scry.FnModel.mk "strcpy" "libc" (List.cons (.copy 0 1) .nil)
    "argument 1 is copied into the object argument 0 points at"

def Scry.copyStrncpy : Scry.FnModel :=
  Scry.FnModel.mk "strncpy" "libc" (List.cons (.copy 0 1) .nil)
    "a bounded copy, still a copy from argument 1 to argument 0"

def Scry.copyStrcat : Scry.FnModel :=
  Scry.FnModel.mk "strcat" "libc" (List.cons (.copy 0 1) .nil)
    "argument 1 is appended to the object argument 0 points at"

def Scry.copyStrncat : Scry.FnModel :=
  Scry.FnModel.mk "strncat" "libc" (List.cons (.copy 0 1) .nil)
    "a bounded append, still a copy from argument 1 to argument 0"

def Scry.copyStpcpy : Scry.FnModel :=
  Scry.FnModel.mk "stpcpy" "libc" (List.cons (.copy 0 1) .nil)
    "argument 1 is copied into argument 0"

def Scry.copyStrlcpy : Scry.FnModel :=
  Scry.FnModel.mk "strlcpy" "libc" (List.cons (.copy 0 1) .nil)
    "a size-bounded copy from argument 1 to argument 0"

def Scry.copyStrlcat : Scry.FnModel :=
  Scry.FnModel.mk "strlcat" "libc" (List.cons (.copy 0 1) .nil)
    "a size-bounded append from argument 1 to argument 0"

def Scry.copyMemcpy : Scry.FnModel :=
  Scry.FnModel.mk "memcpy" "libc" (List.cons (.copy 0 1) .nil)
    "argument 1 is copied into argument 0"

def Scry.copyMemmove : Scry.FnModel :=
  Scry.FnModel.mk "memmove" "libc" (List.cons (.copy 0 1) .nil)
    "argument 1 is moved into argument 0"

def Scry.allocMalloc : Scry.FnModel :=
  Scry.FnModel.mk "malloc" "libc"
    (List.cons (.alloc (.some 0) .none) (List.cons (.sink 0 .size) .nil))
    "a fresh object; argument 0 is the byte count"

def Scry.allocCalloc : Scry.FnModel :=
  Scry.FnModel.mk "calloc" "libc"
    (List.cons (.alloc (.some 1) (.some 0))
      (List.cons (.sink 0 .size) (List.cons (.sink 1 .size) .nil)))
    "a fresh zeroed object; arguments 0 and 1 are the count and element size"

def Scry.allocRealloc : Scry.FnModel :=
  Scry.FnModel.mk "realloc" "libc"
    (List.cons (.alloc (.some 1) .none) (List.cons (.sink 1 .size) .nil))
    "a fresh object; the old object may also be freed (not modelled as a free here, to keep the may-alias result)"

def Scry.freeFree : Scry.FnModel :=
  Scry.FnModel.mk "free" "libc" (List.cons (.free 0) .nil)
    "argument 0 is freed"

-- Policy models: the sanitiser names the default pack trusts. A model supplies the
-- effect; the pack opts in by naming the function. The model is not a proof that the
-- function is safe for every use.

def Scry.sanEscapeShell : Scry.FnModel :=
  Scry.FnModel.mk "escape_shell" "policy" (List.cons (.sanitise .result) .nil)
    "shell-escapes its argument and returns a new string"

def Scry.sanShellescape : Scry.FnModel :=
  Scry.FnModel.mk "shellescape" "policy" (List.cons (.sanitise .result) .nil)
    "shell-escapes its argument and returns a new string"

def Scry.sanQuoteArg : Scry.FnModel :=
  Scry.FnModel.mk "quote_arg" "policy" (List.cons (.sanitise .result) .nil)
    "quotes one shell argument"

def Scry.sanSanitize : Scry.FnModel :=
  Scry.FnModel.mk "sanitize" "policy" (List.cons (.sanitise (.arg 0)) .nil)
    "cleans argument 0 in place"

def Scry.sanSanitizeFormat : Scry.FnModel :=
  Scry.FnModel.mk "sanitize_format" "policy" (List.cons (.sanitise .result) .nil)
    "returns a format string with no conversions"

def Scry.sanSanitizePath : Scry.FnModel :=
  Scry.FnModel.mk "sanitize_path" "policy" (List.cons (.sanitise .result) .nil)
    "returns a path with traversal components removed"

def Scry.sanConfinePath : Scry.FnModel :=
  Scry.FnModel.mk "confine_path" "policy" (List.cons (.sanitise .result) .nil)
    "confines a path to a base directory"

def Scry.sanCheckedSize : Scry.FnModel :=
  Scry.FnModel.mk "checked_size" "policy" (List.cons (.sanitise .result) .nil)
    "returns a size after an overflow check"

def Scry.sanClampLen : Scry.FnModel :=
  Scry.FnModel.mk "clamp_len" "policy" (List.cons (.sanitise .result) .nil)
    "returns a length clamped to a bound"

def Scry.sanClampSize : Scry.FnModel :=
  Scry.FnModel.mk "clamp_size" "policy" (List.cons (.sanitise .result) .nil)
    "returns a size clamped to a bound"

-- Pure/read-only calls: an empty effect list is a positive model, not `unknown`.
-- It says "this call does not copy attacker data, write memory or allocate"; the
-- analysis still keeps the argument's own register untainted (nothing is laundered).

def Scry.pureName (name : String) : Scry.FnModel :=
  Scry.FnModel.mk name "pure" .nil "modelled as pure: no taint, memory or allocation effect"

def Scry.pureModels : List Scry.FnModel :=
  List.map Scry.pureName
    [ "strlen", "strnlen", "strcmp", "strncmp", "strchr", "strrchr", "strstr"
    , "memcmp", "memchr", "atoi", "atol", "strtol", "strtoul", "strtod", "abs"
    , "isdigit", "isspace", "isalpha", "toupper", "tolower", "puts", "fputs"
    , "fwrite", "fflush", "close", "perror" ]

def Scry.libcModels : List Scry.FnModel :=
  [ Scry.sourceGetenv
  , Scry.sourceRead
  , Scry.sourceRecv
  , Scry.sourceFgets
  , Scry.sourceGetline
  , Scry.sourceFread
  , Scry.sinkSystem
  , Scry.sinkPopen
  , Scry.sinkExec
  , Scry.sinkExeclp
  , Scry.sinkExecle
  , Scry.sinkExecv
  , Scry.sinkExecvp
  , Scry.sinkExecvpe
  , Scry.sinkExecve
  , Scry.sinkPosixSpawn
  , Scry.sinkPosixSpawnp
  , Scry.sinkPrintf
  , Scry.sinkFprintf
  , Scry.sinkSprintf
  , Scry.sinkSnprintf
  , Scry.sinkVprintf
  , Scry.sinkVfprintf
  , Scry.sinkVsprintf
  , Scry.sinkVsnprintf
  , Scry.sinkSyslog
  , Scry.sinkDprintf
  , Scry.copyStrcpy
  , Scry.copyStrncpy
  , Scry.copyStrcat
  , Scry.copyStrncat
  , Scry.copyStpcpy
  , Scry.copyStrlcpy
  , Scry.copyStrlcat
  , Scry.copyMemcpy
  , Scry.copyMemmove
  , Scry.allocMalloc
  , Scry.allocCalloc
  , Scry.allocRealloc
  , Scry.freeFree
  ]

def Scry.policyModels : List Scry.FnModel :=
  [ Scry.sanEscapeShell
  , Scry.sanShellescape
  , Scry.sanQuoteArg
  , Scry.sanSanitize
  , Scry.sanSanitizeFormat
  , Scry.sanSanitizePath
  , Scry.sanConfinePath
  , Scry.sanCheckedSize
  , Scry.sanClampLen
  , Scry.sanClampSize
  ]

-- ## CLR (C#) models

-- The C# frontend emits **CLR spellings**, not C ones (`scry/CSHARP.md` §3): a function
-- is `Namespace.Type.Method`, an instance call's receiver is argument 0, a property is
-- `Type.get_P` / `Type.set_P`, an indexer is `Type.get_Item` / `Type.set_Item`, a
-- constructor is `Type..ctor`, and an array's type is part of the name
-- (`System.Int32[].get_Length`). The classes modelled here:
--
-- * **reads and projections** — a length, an element, a property getter, a string
--   operation, a LINQ operator, an ASP.NET Core minimal-API registration call. A read
--   *writes nothing through an argument, frees nothing and is not a taint source*: it is
--   a claim about effects, not about safety.
--   It does not launder either: the taint layer's ordinary `gen` rule still carries
--   taint from the receiver and the arguments to the result, so `s.Substring(1)` of a
--   tainted `s` is tainted, and `xs.Select(f)` of a tainted `xs` is tainted. A model is
--   never *narrower* than `unknown` for taint: an unmodelled call also has no source
--   fact, so the two differ only in the warning and in the effects a model names.
-- * **one source** — `System.Console.ReadLine` returns attacker-controlled text. The
--   C# rule pack already declares it a source; the model makes the effect independent
--   of a pack (model sources and pack sources are deduplicated, so a pack that also
--   names it is unchanged).
-- * **one allocation shape** — `System.Array.$new`, the collection-expression array: a
--   fresh object whose elements are its arguments.
--
-- What is deliberately **not** modelled:
--
-- * anything that writes through its receiver or an argument (`set_*`, `set_Item`,
--   `Add`, `Append`, `Insert`, `Remove`, `Clear`, `CopyTo`, `Array.Copy`, `Read` into a
--   buffer): its memory effect is unknown, so the explicit `unmodelled-external`
--   warning stays. A `copy` model into an unknown `Loc` would taint every later load
--   through an unknown pointer — more false positives, not more soundness.
-- * a **log write** is the exception among writes: `ILogger.Log*` has no memory effect
--   the points-to model can name, but its data arguments reach a file, so they are a
--   `sink` (`SinkClass.log`, CWE-117). Only pointer-like arguments are sinks; an integer
--   length cannot forge a log line.
-- * a constructor (`Type..ctor`): it writes the object it returns; `gen` already taints
--   that object from the arguments, and a `copy` effect would land in `Loc.unknown`.
-- * `Dispose`: `free` would claim the managed object dies; a `using` block's `Dispose`
--   does not (and the lifetime rule would then report a false use-after-free).
-- * `Process.Start` and the rest of the C# rule pack's sinks: a sink needs a *rule
--   class*, and the pack owns those. The pack is what makes them findings; adding the
--   same sink to the table would only duplicate the fact.

/-- A CLR read/projection: no write through an argument, no free, no new source. The
result is an ordinary external value (points-to keeps it `Loc.unknown`, as for every
external call), and taint still reaches it through `gen`. -/
def Scry.clrRead (name : String) : Scry.FnModel :=
  Scry.FnModel.mk name "clr-read" .nil
    "a CLR read or projection: no write through an argument, no free, no new source; its result derives from the receiver and arguments (taint still flows through gen)"

/-- The last `.`-separated segment of a CLR name (`System.Int32[].get_Item` → `get_Item`). -/
def Scry.clrLast : List String → String
  | .nil => ""
  | .cons x .nil => x
  | .cons _ rest => Scry.clrLast rest

def Scry.clrLastSegment (name : String) : String := Scry.clrLast (String.splitOn name ".")

/-- Is this a CLR property getter? Every CLR member name the C# frontend emits contains a
`.` (`T.get_P`, `?.get_P`), while a C identifier never does, so the shape rule cannot
capture a C function named `get_Foo`. A getter's only input is the receiver: it returns a
value derived from it (taint reaches the result through `gen`), has no data argument to
write through, and is not a source. `set_*` is *not* matched: a setter writes. -/
def Scry.clrIsGetter (name : String) : Bool :=
  Bool.and (String.contains name ".") (String.startsWith (Scry.clrLastSegment name) "get_")

/-- The shape rule `Scry.clrModelOf` adds after the exact names: any CLR property getter
(read), and the object-protocol member shapes (also reads on any receiver). A name that
ends this way and is not defined by the unit is a read: it writes nothing through an
argument, frees nothing, and is not a source. It is not a sanitiser either. -/
def Scry.clrReadSuffixes : List String :=
  [ ".ToString", ".Equals", ".GetHashCode", ".GetType", ".CompareTo"
  , ".MoveNext", ".GetEnumerator" ]

/-- ASP.NET Core minimal-API registration/fluent member names (`Microsoft.AspNetCore.
Builder.EndpointRouteBuilderExtensions`, `…RouteHandlerBuilderExtensions`): they return
the builder or endpoint derived from the receiver, so taint in the receiver reaches the
result through `gen`, and they take no buffer the analysis could write a tainted value
into. Any registration state they keep *inside* the builder is outside the points-to
model either way. Matched by the member segment on any CLR receiver, because the
frontend often does not know the builder's type (`?.Produces`, `?.MapPost`). -/
def Scry.clrFluentNames : List String :=
  [ "Produces", "ProducesProblem", "ProducesValidationProblem"
  , "WithName", "WithSummary", "WithDescription", "WithTags", "WithOpenApi"
  , "WithMetadata", "WithDisplayName", "AddEndpointFilter"
  , "MapGet", "MapPost", "MapPut", "MapDelete", "MapPatch", "MapMethods"
  , "MapGroup", "MapControllers", "MapHub", "MapFallback"
  , "AllowAnonymous", "RequireAuthorization", "RequireCors", "RequireRateLimiting"
  , "RequireHost", "DisableAntiforgery", "ExcludeFromDescription" ]

/-- `Microsoft.AspNetCore.Http.TypedResults` / `Results` factory members: they return an
`IResult` carrying the argument values, so taint reaches the result through `gen`; no
argument is written through. -/
def Scry.clrResultNames : List String :=
  [ "Problem", "Ok", "Created", "CreatedAtRoute", "NoContent", "BadRequest"
  , "NotFound", "Unauthorized", "Forbid", "Conflict", "UnprocessableEntity"
  , "Json", "Text", "Bytes", "File", "Stream", "PhysicalFile", "VirtualFile"
  , "Content", "Accepted", "AcceptedAtRoute", "Redirect", "RedirectToRoute"
  , "StatusCode", "Empty" ]

def Scry.clrMemberIn (names : List String) (name : String) : Bool :=
  List.any (fun x => String.eq x (Scry.clrLastSegment name)) names

/-- A fluent registration call (see `Scry.clrFluentNames`); gated on a CLR name so a C
function called `Produces` is untouched. -/
def Scry.clrIsFluent (name : String) : Bool :=
  Bool.and (String.contains name ".") (Scry.clrMemberIn Scry.clrFluentNames name)

/-- A `TypedResults`/`Results` factory (see `Scry.clrResultNames`). -/
def Scry.clrIsResult (name : String) : Bool :=
  Bool.and (Scry.clrMemberIn Scry.clrResultNames name)
    (Bool.or (String.contains name "TypedResults.") (String.contains name "Results."))

/-- Exact CLR read/projection names: the ones a receiver's shape does not reveal (a
`String` member or a LINQ operator whose receiver type the lowering knows, and the
`?`-receiver spellings it emits when it does not). `String.Concat`/`String.Format` are
what the lowering emits for `+`, interpolation and `string.Format`, so a tainted part
reaches the result through `gen`. -/
def Scry.clrReadNames : List String :=
  [ "System.String.Concat", "System.String.Format", "System.String.Join"
  , "System.String.Substring", "System.String.Split", "System.String.Replace"
  , "System.String.Trim", "System.String.TrimStart", "System.String.TrimEnd"
  , "System.String.ToLower", "System.String.ToUpper"
  , "System.String.ToLowerInvariant", "System.String.ToUpperInvariant"
  , "System.String.Contains", "System.String.StartsWith", "System.String.EndsWith"
  , "System.String.IndexOf", "System.String.LastIndexOf"
  , "System.String.PadLeft", "System.String.PadRight"
  , "System.String.IsNullOrEmpty", "System.String.IsNullOrWhiteSpace"
  , "System.String.op_Equality", "System.String.op_Inequality"
  , "System.Convert.FromBase64String", "System.Convert.ToBase64String"
  , "?.Substring", "?.Split", "?.Replace", "?.Trim", "?.TrimStart", "?.TrimEnd"
  , "?.ToLower", "?.ToUpper", "?.ToLowerInvariant", "?.ToUpperInvariant"
  , "?.Contains", "?.StartsWith", "?.EndsWith", "?.IndexOf", "?.LastIndexOf"
  , "?.PadLeft", "?.PadRight", "?.Select", "?.Where", "?.SelectMany"
  , "?.OrderBy", "?.OrderByDescending", "?.ThenBy", "?.ThenByDescending"
  , "?.Distinct", "?.Take", "?.Skip", "?.ToList", "?.ToArray", "?.AsEnumerable"
  , "?.Concat", "?.Union", "?.Intersect", "?.Except", "?.GroupBy"
  , "?.First", "?.FirstOrDefault", "?.Single", "?.SingleOrDefault"
  , "?.Last", "?.LastOrDefault", "?.Any", "?.All", "?.Count", "?.LongCount"
  , "?.Sum", "?.Min", "?.Max", "?.Average", "?.ElementAt", "?.ElementAtOrDefault"
  , "?.Cast", "?.OfType", "?.Reverse", "?.Zip", "?.DefaultIfEmpty"
  , "System.Linq.Enumerable.Select", "System.Linq.Enumerable.SelectMany"
  , "System.Linq.Enumerable.Where", "System.Linq.Enumerable.OrderBy"
  , "System.Linq.Enumerable.OrderByDescending", "System.Linq.Enumerable.ThenBy"
  , "System.Linq.Enumerable.ThenByDescending", "System.Linq.Enumerable.Distinct"
  , "System.Linq.Enumerable.Take", "System.Linq.Enumerable.Skip"
  , "System.Linq.Enumerable.TakeWhile", "System.Linq.Enumerable.SkipWhile"
  , "System.Linq.Enumerable.ToList", "System.Linq.Enumerable.ToArray"
  , "System.Linq.Enumerable.AsEnumerable", "System.Linq.Enumerable.Concat"
  , "System.Linq.Enumerable.Union", "System.Linq.Enumerable.Intersect"
  , "System.Linq.Enumerable.Except", "System.Linq.Enumerable.GroupBy"
  , "System.Linq.Enumerable.First", "System.Linq.Enumerable.FirstOrDefault"
  , "System.Linq.Enumerable.Single", "System.Linq.Enumerable.SingleOrDefault"
  , "System.Linq.Enumerable.Last", "System.Linq.Enumerable.LastOrDefault"
  , "System.Linq.Enumerable.Any", "System.Linq.Enumerable.All"
  , "System.Linq.Enumerable.Count", "System.Linq.Enumerable.LongCount"
  , "System.Linq.Enumerable.Sum", "System.Linq.Enumerable.Min"
  , "System.Linq.Enumerable.Max", "System.Linq.Enumerable.Average"
  , "System.Linq.Enumerable.Contains", "System.Linq.Enumerable.ElementAt"
  , "System.Linq.Enumerable.ElementAtOrDefault", "System.Linq.Enumerable.Cast"
  , "System.Linq.Enumerable.OfType", "System.Linq.Enumerable.Reverse"
  , "System.Linq.Enumerable.Zip", "System.Linq.Enumerable.DefaultIfEmpty"
  , "System.Linq.Enumerable.Empty", "System.Linq.Enumerable.Range"
  -- Console: output is terminal (nothing flows back into the program), and the
  -- `Out`/`Error`/`In` getters are reads. `ReadLine` is the source below.
  , "System.Console.Write", "System.Console.WriteLine"
  , "System.Console.WriteAsync", "System.Console.WriteLineAsync"
  , "System.Console.get_Out", "System.Console.get_Error", "System.Console.get_In"
  , "System.Console.Read", "System.Console.ReadKey"
  , "?.Write", "?.WriteLine", "?.WriteAsync", "?.WriteLineAsync", "?.Flush" ]

/-- An ASP.NET Core minimal-API registration/fluent call (see `Scry.clrFluentNames`): the
result is the builder or endpoint derived from the receiver, so taint in the receiver
reaches it through `gen`; no argument is written through. -/
def Scry.clrFluent (name : String) : Scry.FnModel :=
  Scry.FnModel.mk name "clr-fluent" .nil
    "an ASP.NET Core minimal-API registration/fluent call: its result derives from the receiver (taint flows through gen), it writes no memory the points-to model can name, and it is not a source"

/-- `System.Array.$new(a…)` is the collection-expression constructor the C# lowering
emits (`new[] { … }`, `[…]`). It returns a fresh array whose elements are its arguments,
so taint reaches the array through `gen`; the model names the allocation and nothing
else. -/
def Scry.clrAllocArrayNew : Scry.FnModel :=
  Scry.FnModel.mk "System.Array.$new" "clr-alloc"
    (List.cons (.alloc .none .none) .nil)
    "the collection-expression array: a fresh object whose elements are the arguments (taint reaches the array through gen)"

/-- `System.Console.ReadLine`: stdin is attacker-controlled text (the C# rule pack names
it as a source too; model and pack sources are deduplicated). -/
def Scry.clrSourceReadLine : Scry.FnModel :=
  Scry.FnModel.mk "System.Console.ReadLine" "clr-source"
    (List.cons (.source .result) .nil)
    "stdin text is attacker-controlled"

/-- A CLR request read: the result is supplied by the caller (an HTTP request), so it is
attacker-controlled. The property getters would otherwise be modelled as ordinary reads;
an exact source entry wins over the shape rule. `?.` is the spelling the lowering emits
when it cannot resolve the receiver's type (`ctx.Request.Headers`). -/
def Scry.clrSource (name : String) : Scry.FnModel :=
  Scry.FnModel.mk name "clr-source" (List.cons (.source .result) .nil)
    "the HTTP request value is attacker-controlled"

def Scry.clrHttpSourceNames : List String :=
  [ "Microsoft.AspNetCore.Http.HttpRequest.get_Body", "HttpRequest.get_Body", "?.get_Body"
  , "Microsoft.AspNetCore.Http.HttpRequest.get_ContentType", "HttpRequest.get_ContentType", "?.get_ContentType"
  , "Microsoft.AspNetCore.Http.HttpRequest.get_Query", "HttpRequest.get_Query", "?.get_Query"
  , "Microsoft.AspNetCore.Http.HttpRequest.get_Form", "HttpRequest.get_Form", "?.get_Form"
  , "Microsoft.AspNetCore.Http.HttpRequest.get_Headers", "HttpRequest.get_Headers", "?.get_Headers"
  , "Microsoft.AspNetCore.Http.HttpRequest.get_Cookies", "HttpRequest.get_Cookies", "?.get_Cookies"
  , "Microsoft.AspNetCore.Http.HttpRequest.get_RouteValues", "HttpRequest.get_RouteValues", "?.get_RouteValues"
  , "Microsoft.AspNetCore.Http.HttpRequest.get_Path", "HttpRequest.get_Path", "?.get_Path"
  , "Microsoft.AspNetCore.Http.HttpRequest.get_QueryString", "HttpRequest.get_QueryString", "?.get_QueryString"
  , "Microsoft.AspNetCore.Http.HttpRequest.ReadFormAsync", "HttpRequest.ReadFormAsync", "?.ReadFormAsync"
  , "Microsoft.AspNetCore.Http.HttpRequest.ReadFromJsonAsync", "HttpRequest.ReadFromJsonAsync", "?.ReadFromJsonAsync"
  , "Microsoft.AspNetCore.Http.HttpRequest.ReadFromJson", "HttpRequest.ReadFromJson", "?.ReadFromJson"
  ]

def Scry.clrHttpSources : List Scry.FnModel :=
  List.map Scry.clrSource Scry.clrHttpSourceNames

/-- A log write: the formatted line is written to the configured sink. The receiver
(argument 0) and the variadic data arguments (1–8) are covered; a data argument from a
request is a CWE-117 sink. The receiver is deliberately not a sink, so a tainted logger
object does not fire on its own. -/
def Scry.clrLog (name : String) : Scry.FnModel :=
  Scry.FnModel.mk name "clr-log"
    (Scry.modelFlat (fun k => List.cons (.sink k .log) .nil) (Scry.modelRangeFrom 8 1))
    "writes its message and variadic data arguments (1–8) to the configured log sink (a file)"

def Scry.clrLogNames : List String :=
  [ "ILogger.LogTrace", "ILogger.LogDebug", "ILogger.LogInformation"
  , "ILogger.LogWarning", "ILogger.LogError", "ILogger.LogCritical"
  , "?.LogTrace", "?.LogDebug", "?.LogInformation"
  , "?.LogWarning", "?.LogError", "?.LogCritical"
  , "Microsoft.Extensions.Logging.LoggerExtensions.LogTrace"
  , "Microsoft.Extensions.Logging.LoggerExtensions.LogDebug"
  , "Microsoft.Extensions.Logging.LoggerExtensions.LogInformation"
  , "Microsoft.Extensions.Logging.LoggerExtensions.LogWarning"
  , "Microsoft.Extensions.Logging.LoggerExtensions.LogError"
  , "Microsoft.Extensions.Logging.LoggerExtensions.LogCritical"
  ]

def Scry.clrLogModels : List Scry.FnModel :=
  List.map Scry.clrLog Scry.clrLogNames

def Scry.clrModels : List Scry.FnModel :=
  List.append Scry.clrHttpSources (List.append Scry.clrLogModels
    (List.cons Scry.clrSourceReadLine (List.cons Scry.clrAllocArrayNew
      (List.map Scry.clrRead Scry.clrReadNames))))

/-- A CLR model by exact name, then by the shape rules (property getter, object-protocol
member, ASP.NET fluent registration, `TypedResults`/`Results` factory). The shape rules
only fire for a name that is not in the exact table and contains a `.`, so they cannot
capture a C identifier; a unit-defined function is filtered by `Wil.findFunc` before the
table is read at all. -/
def Scry.clrModelOf (name : String) : Option Scry.FnModel :=
  match List.find (fun m => String.eq m.name name) Scry.clrModels with
  | .some m => .some m
  | .none =>
    if Scry.clrIsGetter name then .some (Scry.clrRead name)
    else if Scry.clrIsFluent name then .some (Scry.clrFluent name)
    else if Scry.clrIsResult name then .some (Scry.clrRead name)
    else match List.find (fun s => String.endsWith name s) Scry.clrReadSuffixes with
      | .some _ => .some (Scry.clrRead name)
      | .none => .none

/-- The model table without the CLR (C#) layer: libc/syscall semantics, the policy
sanitisers and the C pure calls — what the analysis knew before the BCL reads were
modelled. The external-coverage measurement reads it for the `before` column, so one
tool and one input give both numbers. -/
def Scry.coreModels : List Scry.FnModel :=
  List.append Scry.libcModels (List.append Scry.policyModels Scry.pureModels)

def Scry.models : List Scry.FnModel :=
  List.append Scry.coreModels Scry.clrModels

/-- `isModelled` against the pre-CLR table (the `before` side of the coverage
measurement). -/
def Scry.isModelledCore (name : String) : Bool :=
  match List.find (fun m => String.eq m.name name) Scry.coreModels with
  | .some _ => .true
  | .none => .false

def Scry.modelOf (name : String) : Option Scry.FnModel :=
  match List.find (fun m => String.eq m.name name) Scry.models with
  | .some m => .some m
  | .none => Scry.clrModelOf name

def Scry.isModelled (name : String) : Bool :=
  match Scry.modelOf name with
  | .some _ => .true
  | .none => .false

def Scry.isUnknownModel (m : Scry.FnModel) : Bool :=
  Bool.or (Scry.modelHasUnknown m) (String.eq m.family "unknown")

/-- The explicit fallback: an unmodelled external has an `unknown` effect, never an empty
effect list. -/
def Scry.unknownModel (name : String) : Scry.FnModel :=
  Scry.FnModel.mk name "unknown" (List.cons .unknown .nil)
    "unmodelled external: its result and memory effect are unknown"

def Scry.modelFor (name : String) : Scry.FnModel :=
  match Scry.modelOf name with
  | .some m => m
  | .none => Scry.unknownModel name

def Scry.sourcesOf (name : String) : List Scry.ArgRef :=
  Scry.modelSources (Scry.modelFor name)

def Scry.sansOf (name : String) : List Scry.ArgRef :=
  Scry.modelSans (Scry.modelFor name)

def Scry.sinksOf (name : String) : List (Nat × Scry.SinkClass) :=
  Scry.modelSinkArgs (Scry.modelFor name)

def Scry.copyPairsOf (name : String) (arity : Nat) : List (Nat × Nat) :=
  Scry.modelCopyPairs (Scry.modelFor name) arity

def Scry.allocOf (name : String) : Option Scry.AllocShape :=
  Scry.modelAlloc (Scry.modelFor name)

def Scry.freeArgOf (name : String) : Option Nat :=
  Scry.modelFreeArg (Scry.modelFor name)

-- Namespaced aliases for callers that read the table by name. The definitions above
-- live in the `Scry` namespace (following the module style); these give the public
-- `Scry.Models.*` spellings the analysis and tests use.

def Scry.Models.modelFor (name : String) : Scry.FnModel := Scry.modelFor name

def Scry.Models.isModelled (name : String) : Bool := Scry.isModelled name

def Scry.Models.isUnknownModel (m : Scry.FnModel) : Bool := Scry.isUnknownModel m

def Scry.Models.sourcesOf (name : String) : List Scry.ArgRef := Scry.sourcesOf name

def Scry.Models.sansOf (name : String) : List Scry.ArgRef := Scry.sansOf name

def Scry.Models.sinksOf (name : String) : List (Nat × Scry.SinkClass) := Scry.sinksOf name

def Scry.Models.copyPairsOf (name : String) (arity : Nat) : List (Nat × Nat) :=
  Scry.copyPairsOf name arity

def Scry.Models.allocOf (name : String) : Option Scry.AllocShape := Scry.allocOf name

def Scry.Models.freeArgOf (name : String) : Option Nat := Scry.freeArgOf name

/-- Does the pack trust this sanitiser name? A model sanitiser is a *policy* effect:
the table supplies the semantics, but a pack has to name the function (directly or with
a glob) before its result or argument is cleaned. That keeps the pack's spec-driven kill
honest: a pack that omits `sanitize` does not get it from the model table. -/
def Scry.RulePack.trustsSanitiser (p : Scry.RulePack) (name : String) : Bool :=
  List.any (fun r => List.any (fun pair => Scry.nameMatches pair.1 name) r.sanitisers)
    (Scry.RulePack.taintRules p)

-- ## Model rules

def Scry.modelSinkClasses : List Scry.SinkClass :=
  [ .command, .format, .length, .size, .log ]

def Scry.modelRule (c : Scry.SinkClass) : Scry.PackRule :=
  .taint (Scry.TaintRule.mk (Scry.SinkClass.ruleId c) (Scry.SinkClass.severity c)
    (Scry.SinkClass.message c) .nil .nil .nil)

def Scry.RulePack.hasRule (p : Scry.RulePack) (id : String) : Bool :=
  List.any (fun r => String.eq (Scry.PackRule.id r) id) p.rules

def Scry.RulePack.taintRuleById (p : Scry.RulePack) (id : String) : Option Scry.TaintRule :=
  List.find (fun r => String.eq r.id id) (Scry.RulePack.taintRules p)

/-- Add the model rule descriptors the pack does not already have. Idempotent, and it
does not add source/sink/sanitiser lines: the sink facts come from the model table. -/
def Scry.RulePack.withModels (p : Scry.RulePack) : Scry.RulePack :=
  let step : Scry.RulePack → Scry.SinkClass → Scry.RulePack :=
    fun acc c => match acc.hasRule (Scry.SinkClass.ruleId c) with
      | .true => acc
      | .false => Scry.RulePack.mk (List.append acc.rules (List.cons (Scry.modelRule c) .nil));
  List.foldl step p Scry.modelSinkClasses

-- ## Rendering (for diagnostics and docs)

def Scry.Effect.render : Scry.Effect → String
  | .source r => "source " ++ Scry.ArgRef.show r
  | .sink arg c => "sink " ++ Nat.repr arg ++ " (" ++ Scry.SinkClass.show c ++ ")"
  | .sanitise r => "sanitise " ++ Scry.ArgRef.show r
  | .copy dst src => "copy " ++ Nat.repr dst ++ " <- " ++ Nat.repr src
  | .copyArgs dst first => "copyArgs " ++ Nat.repr dst ++ " from " ++ Nat.repr first
  | .alloc size count =>
    "alloc" ++ (match size with | .some k => " size " ++ Nat.repr k | .none => "")
      ++ (match count with | .some k => " count " ++ Nat.repr k | .none => "")
  | .free arg => "free " ++ Nat.repr arg
  | .unknown => "unknown"

def Scry.FnModel.render (m : Scry.FnModel) : String :=
  m.name ++ " [" ++ m.family ++ "]: "
    ++ String.intercalate "; " (List.map Scry.Effect.render m.effects)
