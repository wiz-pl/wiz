import Prelude
import Text
import Deriving
import Logic
import Int
import Scry.AiDomain
/-!
# Scry.AiCfg: a tiny three-address language, CFG and transfer functions

The frontend-independent half of the abstract-interpretation core: a small language
(`AExpr`/`ACond`/`AStmt`), a CFG (`ACfg`/`AEdge`), and the concrete-ish transfer
functions for the `Value` domain of `Scry.AiDomain`. There is no parser and no Wil
dependency: a Wil lowering will construct these values in stage S2/S5.

The language has the operations the S5 alarms need: machine-width `add`/`sub`/`mul`,
array `load` with an explicit static length, `alloc`, and `null`. The transfer functions
are width-aware: an operation whose exact range could leave `[0, 2^w)` becomes `Top`
(unsigned wrap-around is never ignored). Soundness obligations are the `Prop` statements
at the end of the module.

```
import Scry.AiCfg

#eval (AExpr.eval (AiMach.u 8) [] (.lit 7)).itv
```
-/

/-- What an arithmetic overflow means: two's-complement wrap-around (C unsigned, Java)
or undefined behaviour (C signed, `-fwrapv` off). The transfer functions return `Top` on
either; the policy decides whether the checker reports an alarm (`.ub`) or treats the
wrapped result as defined (`.wrap`). -/
inductive Overflow where
  /-- two's-complement wrap-around: defined, so no alarm -/
  | wrap
  /-- undefined behaviour: an operation whose range may leave the word alarms -/
  | ub
  deriving Inhabited, BEq, Repr

/-- The ambient machine: a width, whether the integers are signed, and the overflow
policy. The width is what the unsigned `Interval` and the signed `SInterval` operations
use; the policy is what the alarm checks use. `AiMach.u`/`AiMach.s` are the usual
constructors (unsigned wrap and signed undefined behaviour). -/
structure AiMach where
  /-- the width in bits -/
  width : Nat
  /-- interpret values as two's-complement signed -/
  signed : Bool
  /-- what an overflow means -/
  overflow : Overflow

def AiMach.u (width : Nat) : AiMach := AiMach.mk width .false .wrap
def AiMach.s (width : Nat) : AiMach := AiMach.mk width .true .ub
def AiMach.sw (width : Nat) : AiMach := AiMach.mk width .true .wrap

/-- The largest unsigned value at this width. -/
def AiMach.maxVal (m : AiMach) : Nat := Ai.maxVal m.width
/-- The number of representable values. -/
def AiMach.modulus (m : AiMach) : Nat := Nat.pow 2 m.width
/-- `-2^(w-1)`, the smallest signed value of this width. -/
def AiMach.signedMin (m : AiMach) : Int := Int.negOfNat (Nat.pow 2 (Nat.sub m.width 1))
/-- `2^(w-1) - 1`, the largest signed value of this width. -/
def AiMach.signedMax (m : AiMach) : Int :=
  Int.ofNat (Nat.sub (Nat.pow 2 (Nat.sub m.width 1)) 1)

-- ## Expressions

/-- A three-address expression. `load arr idx len` reads an array (`arr` is a variable)
of static length `len`; `alloc len` makes a fresh non-null array of `len` elements. -/
inductive AExpr where
  | var (x : Nat)
  | lit (n : Nat)
  | add (a b : AExpr)
  | sub (a b : AExpr)
  | mul (a b : AExpr)
  | load (arr : Nat) (idx : AExpr) (len : Nat)
  | alloc (len : AExpr)
  | null
  deriving BEq, Repr

/-- A guard. -/
inductive ACond where
  | lt (x : Nat) (e : AExpr)
  | le (x : Nat) (e : AExpr)
  | gt (x : Nat) (e : AExpr)
  | ge (x : Nat) (e : AExpr)
  | eq (x : Nat) (e : AExpr)
  | ne (x : Nat) (e : AExpr)
  | isNull (x : Nat)
  | notNull (x : Nat)
  deriving BEq, Repr

/-- A statement. -/
inductive AStmt where
  | assign (x : Nat) (e : AExpr)
  | assume (c : ACond)
  | skip
  deriving BEq, Repr

-- ## Value-level operations

/-- Build a numeric value, tightening the interval only if the constant is known and the
interval is not `Top` (so an out-of-range result is never narrowed to a wrong point). -/
def AiValue.num (itv : Interval) (cst : Const) : Value :=
  Value.norm (Value.mk itv cst Null.nonNull)

/-- A word of width `m`: a point if representable, otherwise `Top`. -/
def AiValue.word (m : AiMach) (n : Nat) : Value := match Nat.lt n (AiMach.modulus m) with
  | .true => AiValue.num (.range n n) (.known n)
  | .false => AiValue.num .top .unknown

/-- Addition of intervals, width-aware. -/
def Interval.add (m : AiMach) : Interval → Interval → Interval
  | .bot, _ => .bot
  | _, .bot => .bot
  | .range al ah, .range bl bh =>
      let s := Nat.add ah bh
      match Nat.lt s (AiMach.modulus m) with
      | .true => .range (Nat.add al bl) s
      | .false => .top
  | _, _ => .top

/-- Subtraction of unsigned intervals: underflow (any `a < b` possible) gives `Top`. -/
def Interval.sub (m : AiMach) : Interval → Interval → Interval
  | .bot, _ => .bot
  | _, .bot => .bot
  | .range al ah, .range bl bh =>
      match Nat.le bh al with
      | .true => .range (Nat.sub al bh) (Nat.sub ah bl)
      | .false => .top
  | _, _ => .top

/-- Multiplication of unsigned intervals, width-aware. -/
def Interval.mul (m : AiMach) : Interval → Interval → Interval
  | .bot, _ => .bot
  | _, .bot => .bot
  | .range al ah, .range bl bh =>
      let p := Nat.mul ah bh
      match Nat.lt p (AiMach.modulus m) with
      | .true => .range (Nat.mul al bl) p
      | .false => .top
  | _, _ => .top

-- ## Signed intervals

/-- The smaller of two integers. -/
def AiInt.min (a b : Int) : Int := match Int.le a b with
  | .true => a
  | .false => b
/-- The larger of two integers. -/
def AiInt.max (a b : Int) : Int := match Int.le a b with
  | .true => b
  | .false => a

/-- A signed machine interval over `Int`, for `Wil.Ty.int w .true` values. Bounds are
two's-complement values, so `top` means "any value of the ambient signed width" and the
operations take the width from `AiMach`. The unsigned `Interval` is unchanged. -/
inductive SInterval where
  | bot
  | top
  | range (lo hi : Int)
  deriving Inhabited

def SInterval.beq : SInterval → SInterval → Bool
  | .bot, .bot => .true
  | .top, .top => .true
  | .range lo hi, .range lo' hi' => Bool.and (Int.beq lo lo') (Int.beq hi hi')
  | _, _ => .false

instance : BEq SInterval where
  beq := SInterval.beq

def SInterval.le : SInterval → SInterval → Bool
  | .bot, _ => .true
  | .top, .top => .true
  | .top, _ => .false
  | _, .top => .true
  | _, .bot => .false
  | .range lo hi, .range lo' hi' => Bool.and (Int.le lo' lo) (Int.le hi hi')

def SInterval.join : SInterval → SInterval → SInterval
  | .bot, b => b
  | a, .bot => a
  | .top, _ => .top
  | _, .top => .top
  | .range lo hi, .range lo' hi' => .range (AiInt.min lo lo') (AiInt.max hi hi')

def SInterval.ebot : SInterval := .bot
def SInterval.etop : SInterval := .top
def SInterval.point (w : Nat) (z : Int) : SInterval :=
  match Int.le (Int.negOfNat (Nat.pow 2 (Nat.sub w 1))) z with
  | .true => match Int.le z (Int.ofNat (Nat.sub (Nat.pow 2 (Nat.sub w 1)) 1)) with
    | .true => .range z z
    | .false => .top
  | .false => .top

def SInterval.loOpt : SInterval → Option Int
  | .range lo _ => .some lo
  | _ => .none
def SInterval.hiOpt : SInterval → Option Int
  | .range _ hi => .some hi
  | _ => .none
def SInterval.isBot : SInterval → Bool
  | .bot => .true
  | _ => .false
def SInterval.isTop : SInterval → Bool
  | .top => .true
  | _ => .false

/-- Computable concretisation: does the interval contain the signed integer `z`? -/
def SInterval.contains (i : SInterval) (z : Int) : Bool := match i with
  | .bot => .false
  | .top => .true
  | .range lo hi => Bool.and (Int.le lo z) (Int.le z hi)

def SInterval.meet : SInterval → SInterval → SInterval
  | .bot, _ => .bot
  | _, .bot => .bot
  | .top, b => b
  | a, .top => a
  | .range lo hi, .range lo' hi' =>
      let l := AiInt.max lo lo'
      let h := AiInt.min hi hi'
      match Int.le l h with
      | .true => .range l h
      | .false => .bot

instance : Lattice SInterval where
  bot := SInterval.ebot
  le := SInterval.le
  join := SInterval.join

def SInterval.widen (a b : SInterval) : SInterval := match SInterval.le b a with
  | .true => a
  | .false => SInterval.etop

instance : Widen SInterval where
  widen := SInterval.widen

def SInterval.narrow (a b : SInterval) : SInterval := match SInterval.le b a with
  | .true => b
  | .false => a

instance : Narrow SInterval where
  narrow := SInterval.narrow

def SInterval.laws : Prop :=
  Lattice.le_refl_stmt SInterval × Lattice.le_trans_stmt SInterval ×
  Lattice.bot_le_stmt SInterval × Lattice.join_ub_left_stmt SInterval ×
  Lattice.join_ub_right_stmt SInterval × Lattice.join_least_stmt SInterval ×
  Widen.widen_ub_stmt SInterval

/-- Whether `[lo, hi]` fits the signed word of `m`. -/
def AiMach.inSignedRange (m : AiMach) (lo hi : Int) : Bool :=
  Bool.and (Int.le (AiMach.signedMin m) lo) (Int.le hi (AiMach.signedMax m))

/-- Signed addition: exact when the sum range fits the word, else `Top` (both wrap and
undefined behaviour are treated as a loss of precision here; the policy decides the
alarm). -/
def SInterval.add (m : AiMach) : SInterval → SInterval → SInterval
  | .bot, _ => .bot
  | _, .bot => .bot
  | .range al ah, .range bl bh =>
      let lo := Int.add al bl;
      let hi := Int.add ah bh;
      match AiMach.inSignedRange m lo hi with
      | .true => .range lo hi
      | .false => .top
  | _, _ => .top

/-- Signed subtraction: exact when `[al - bh, ah - bl]` fits. -/
def SInterval.sub (m : AiMach) : SInterval → SInterval → SInterval
  | .bot, _ => .bot
  | _, .bot => .bot
  | .range al ah, .range bl bh =>
      let lo := Int.sub al bh;
      let hi := Int.sub ah bl;
      match AiMach.inSignedRange m lo hi with
      | .true => .range lo hi
      | .false => .top
  | _, _ => .top

/-- Signed multiplication: the min/max of the four endpoint products, exact when they
fit. -/
def SInterval.mul (m : AiMach) : SInterval → SInterval → SInterval
  | .bot, _ => .bot
  | _, .bot => .bot
  | .range al ah, .range bl bh =>
      let p1 := Int.mul al bl;
      let p2 := Int.mul al bh;
      let p3 := Int.mul ah bl;
      let p4 := Int.mul ah bh;
      let lo := AiInt.min (AiInt.min p1 p2) (AiInt.min p3 p4);
      let hi := AiInt.max (AiInt.max p1 p2) (AiInt.max p3 p4);
      match AiMach.inSignedRange m lo hi with
      | .true => .range lo hi
      | .false => .top
  | _, _ => .top

/-- A nonempty signed interval within the signed word? `bot` is trivially safe, `top` is
not. Used by the overflow alarm. -/
def SInterval.within (m : AiMach) : SInterval → Bool
  | .bot => .true
  | .range lo hi => Bool.and (Int.le (AiMach.signedMin m) lo) (Int.le hi (AiMach.signedMax m))
  | .top => .false

-- ## Signed constants

/-- A signed constant domain (the signed counterpart of `Const`). -/
inductive SConst where
  | cbot
  | known (z : Int)
  | unknown
  deriving Inhabited

def SConst.beq : SConst → SConst → Bool
  | .cbot, .cbot => .true
  | .known a, .known b => Int.beq a b
  | .unknown, .unknown => .true
  | _, _ => .false

instance : BEq SConst where
  beq := SConst.beq

/-- Concretisation of a signed constant. -/
def SConst.gamma : SConst → Int → Prop
  | .cbot => fun _ => False
  | .known z => fun v => v = z
  | .unknown => fun _ => True

def SConst.le : SConst → SConst → Bool
  | .cbot, _ => .true
  | .known a, .known b => Int.beq a b
  | .known _, .unknown => .true
  | .known _, .cbot => .false
  | .unknown, .unknown => .true
  | .unknown, _ => .false

def SConst.join : SConst → SConst → SConst
  | .cbot, b => b
  | a, .cbot => a
  | .unknown, _ => .unknown
  | _, .unknown => .unknown
  | .known a, .known b => match Int.beq a b with
    | .true => .known a
    | .false => .unknown

instance : Lattice SConst where
  bot := SConst.cbot
  le := SConst.le
  join := SConst.join

def SConst.widen (a b : SConst) : SConst := match SConst.le b a with
  | .true => a
  | .false => SConst.unknown
instance : Widen SConst where
  widen := SConst.widen

def SConst.narrow (a b : SConst) : SConst := match SConst.le b a with
  | .true => b
  | .false => a
instance : Narrow SConst where
  narrow := SConst.narrow

def SConst.laws : Prop :=
  Lattice.le_refl_stmt SConst × Lattice.le_trans_stmt SConst ×
  Lattice.bot_le_stmt SConst × Lattice.join_ub_left_stmt SConst ×
  Lattice.join_ub_right_stmt SConst × Lattice.join_least_stmt SConst

def SConst.addC (m : AiMach) : SConst → SConst → SConst
  | .known a, .known b =>
      let z := Int.add a b;
      match AiMach.inSignedRange m z z with
      | .true => .known z
      | .false => .unknown
  | _, _ => .unknown

def SConst.subC (m : AiMach) : SConst → SConst → SConst
  | .known a, .known b =>
      let z := Int.sub a b;
      match AiMach.inSignedRange m z z with
      | .true => .known z
      | .false => .unknown
  | _, _ => .unknown

def SConst.mulC (m : AiMach) : SConst → SConst → SConst
  | .known a, .known b =>
      let z := Int.mul a b;
      match AiMach.inSignedRange m z z with
      | .true => .known z
      | .false => .unknown
  | _, _ => .unknown

/-- Constant arithmetic: known only when both sides are known and the result is
representable. -/
def Const.addC (m : AiMach) : Const → Const → Const
  | .known a, .known b => match Nat.lt (Nat.add a b) (AiMach.modulus m) with
    | .true => .known (Nat.add a b)
    | .false => .unknown
  | _, _ => .unknown

def Const.subC (m : AiMach) : Const → Const → Const
  | .known a, .known b => match Nat.le b a with
    | .true => .known (Nat.sub a b)
    | .false => .unknown
  | _, _ => .unknown

def Const.mulC (m : AiMach) : Const → Const → Const
  | .known a, .known b => match Nat.lt (Nat.mul a b) (AiMach.modulus m) with
    | .true => .known (Nat.mul a b)
    | .false => .unknown
  | _, _ => .unknown

/-- Evaluate an expression abstractly. -/
def AExpr.eval (m : AiMach) (env : Env) : AExpr → Value
  | .var x => Env.getD env x Value.top
  | .lit n => AiValue.word m n
  | .add a b =>
      let av := AExpr.eval m env a
      let bv := AExpr.eval m env b
      AiValue.num (Interval.add m av.itv bv.itv) (Const.addC m av.cst bv.cst)
  | .sub a b =>
      let av := AExpr.eval m env a
      let bv := AExpr.eval m env b
      AiValue.num (Interval.sub m av.itv bv.itv) (Const.subC m av.cst bv.cst)
  | .mul a b =>
      let av := AExpr.eval m env a
      let bv := AExpr.eval m env b
      AiValue.num (Interval.mul m av.itv bv.itv) (Const.mulC m av.cst bv.cst)
  | .load _ _ _ => AiValue.num .top .unknown
  | .alloc _ => Value.ptr
  | .null => Value.null

-- ## Guard refinement

/-- Refine the interval of `x` by intersecting it with `i`; keep the other components. -/
def Env.refineItv (x : Nat) (i : Interval) (env : Env) : Env :=
  let v := Env.getD env x Value.top
  Env.set x (Value.norm (Value.mk (Interval.meet v.itv i) v.cst v.nul)) env

/-- Refine nullness of `x`, keeping its other components. -/
def Env.refineNull (x : Nat) (n : Null) (env : Env) : Env :=
  let v := Env.getD env x Value.top
  Env.set x (Value.mk v.itv (match n with | .nul => .cbot | _ => v.cst) n) env

/-- Refine the environment by a guard. A guard whose right side is `Top` refines
nothing numerically; one whose right side is `Bot` makes the edge unreachable
(`Env` bottom, i.e. the variable set to `Value.bot`). -/
def ACond.refine (m : AiMach) (env : Env) : ACond → Env
  | .lt x e =>
      let ev := AExpr.eval m env e
      match ev.itv with
      | .bot => Env.set x Value.bot env
      | .range _ eh => match Nat.beq eh 0 with
        | .true => Env.set x Value.bot env
        | .false => Env.refineItv x (.range 0 (Nat.sub eh 1)) env
      | .top => Env.refineNull x .nonNull env
  | .le x e =>
      let ev := AExpr.eval m env e
      match ev.itv with
      | .bot => Env.set x Value.bot env
      | .range _ eh => Env.refineItv x (.range 0 eh) env
      | .top => Env.refineNull x .nonNull env
  | .gt x e =>
      let ev := AExpr.eval m env e
      match ev.itv with
      | .bot => Env.set x Value.bot env
      | .range el _ => Env.refineItv x (.range (Nat.succ el) (AiMach.maxVal m)) env
      | .top => Env.refineNull x .nonNull env
  | .ge x e =>
      let ev := AExpr.eval m env e
      match ev.itv with
      | .bot => Env.set x Value.bot env
      | .range el _ => Env.refineItv x (.range el (AiMach.maxVal m)) env
      | .top => Env.refineNull x .nonNull env
  | .eq x e =>
      let ev := AExpr.eval m env e
      match ev.itv with
      | .bot => Env.set x Value.bot env
      | _ => Env.refineItv x ev.itv env
  | .ne _ _ => env
  | .isNull x => Env.refineNull x .nul env
  | .notNull x => Env.refineNull x .nonNull env

-- ## Statements, edges and CFGs

/-- The abstract transfer function of a statement. -/
def AStmt.transfer (m : AiMach) (env : Env) : AStmt → Env
  | .assign x e => Env.set x (AExpr.eval m env e) env
  | .assume c => ACond.refine m env c
  | .skip => env

/-- One CFG edge. A guard is the condition under which control takes the edge; `none`
is an unconditional edge. -/
structure AEdge where
  src : Nat
  dst : Nat
  guard : Option ACond
  deriving BEq, Repr

/-- A CFG: an entry block, the function's variables, each block's statement, and the
edge list. Block ids are natural numbers; every edge's ends must have a statement. -/
structure ACfg where
  entry : Nat
  vars : List Nat
  stmts : List (Nat × AStmt)
  edges : List AEdge

/-- Look a block's statement up. -/
def ACfg.stmtGo (p : Nat) : List (Nat × AStmt) → AStmt
  | .nil => AStmt.skip
  | .cons (k, s) rest => match Nat.beq p k with
    | .true => s
    | .false => ACfg.stmtGo p rest

def ACfg.stmt (cfg : ACfg) (p : Nat) : AStmt := ACfg.stmtGo p cfg.stmts

/-- The outgoing edges of a block. -/
def ACfg.outEdges (cfg : ACfg) (p : Nat) : List AEdge :=
  List.filter (fun e => Nat.beq e.src p) cfg.edges

/-- Transfer along an edge: the source state, refined by the edge's guard. -/
def AEdge.transfer (m : AiMach) (env : Env) (e : AEdge) : Env :=
  match e.guard with
  | .none => env
  | .some c => ACond.refine m env c

-- ## Obligations

/-- Transfer soundness for the expression evaluator: if `n` is a concrete value of `e`
in concrete state `c`, it is in `γ (eval env e).itv`. The concrete relation `den` is
deliberately abstract here (it is Wil's semantics in S5); the statement records what S5
must prove. -/
def AExpr.eval_sound_stmt (C : Type) [AbsDomain C Env]
    (den : AiMach → C → AExpr → Nat → Prop) : Prop :=
  (m : AiMach) → (c : C) → (env : Env) → (e : AExpr) → (n : Nat) →
    AbsDomain.gamma env c → den m c e n → Interval.contains (AExpr.eval m env e).itv n = .true

/-- The width-aware addition never claims a value outside the machine range. -/
def Interval.add_range_stmt (m : AiMach) : Prop :=
  (a b : Interval) → (x y : Nat) → Interval.contains a x = .true →
    Interval.contains b y = .true →
    (n : Nat) → Interval.contains (Interval.add m a b) n = .true →
      Nat.lt n (AiMach.modulus m) = .true

/-- Statement transfer soundness (the S5 obligation for `AStmt.transfer`), in the shape
of `Transfer.sound_stmt`: γ before, concrete step, γ after. -/
def AStmt.transfer_sound_stmt (m : AiMach) (C : Type) [AbsDomain C Env]
    (sem : AStmt → C → C → Prop) : Prop :=
  (s : AStmt) → (a : Env) → (c c' : C) → AbsDomain.gamma a c → sem s c c' →
    AbsDomain.gamma (AStmt.transfer m a s) c'
