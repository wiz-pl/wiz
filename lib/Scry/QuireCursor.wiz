import Word
import Text
import Functor
import WordMap
import Scry.Quire.Core
import Scry.Quire.Storage
import Scry.Quire
/-!
# Page cursors: index scans over Quire's fact pages

The pure slice's `Cursor` walks `U64Map` entries; this is the page-backed one. It walks
only the index-root page and the fact chains of the slots a `KeyRange` can reach, so an
equality query touches one slot's pages instead of every index entry, and an index-only
query reads no primary page at all.

The plan mirrors `Cursor.wiz`: `filterKey` tightens the range *before* the first step
(pushdown), `next` consumes the linear handle, `fold`/`foldUntil` are the supported
loops, and `Cost` carries the read-path counts. The new field is `Cost.pages`: the 4 KiB
mapped pages the plan touched (the index root, each fact page, and each primary leaf for
a `follow`).

`indexOnlyRange`/`indexCursorRange` project the index entry (no primary read);
`indexNodesRange` follows each candidate to its node. The fold is exact without a
primary re-check because a move writes a remove fact in the old value's slot and an add
fact in the new one, and the plan reads every slot a queried value can be in.
-/

-- ## Slot selection

/-- The position of `d` in the schema (its slot block). -/
partial def QOrdOf (d : IndexDef) : List IndexDef → Nat
  | [] => 0
  | List.cons x xs =>
    match UIntN.beq x.id d.id with
    | .true => 0
    | .false => Nat.succ (QOrdOf d xs)

-- ## Folding a slot

/-- Fold a slot's facts (newest first): the first fact for a node decides whether it is
in the queried range. -/
partial def QFoldFacts (fs : List QFact) (kr : KeyRange)
    (m : U64Map (U64 × Bool)) : U64Map (U64 × Bool) :=
  match fs with
  | [] => m
  | List.cons f rest =>
    match U64Map.find m f.node with
    | .some _ => QFoldFacts rest kr m
    | .none => match KeyRange.contains kr f.value with
      | .true => QFoldFacts rest kr (U64Map.insert m f.node (f.value, f.add))
      | .false => QFoldFacts rest kr m

/-- The live `(value, node)` pairs of a folded slot. -/
def QLiveList : List (U64 × (U64 × Bool)) → List (U64 × U64)
  | [] => []
  | List.cons e rest =>
    match e.2.2 with
    | .true => List.cons (e.2.1, e.1) (QLiveList rest)
    | .false => QLiveList rest

/-- The live entries of a slot for a range. -/
def QFactsLive (fs : List QFact) (kr : KeyRange) : List (U64 × U64) :=
  QLiveList (U64Map.toList (QFoldFacts fs kr U64Map.empty))

-- ## The plan

/-- A page-backed query plan. `cur` is the live `(value, node)` entries of the slot being
emitted; `pending` is the slots not yet read; `project` turns an entry (and the fetched
node, when `needNode`) into the output. -/
structure QPlan (a : Type) where
  snap : QSnapshot
  ord : Nat
  slots : Nat
  range : KeyRange
  heads : List Nat
  pending : List Nat
  cur : List (U64 × U64)
  project : U64 → U64 → Option Node → Option a
  needNode : Bool
  post : List (a → Bool)
  cost : Cost

/-- One advance: the end (and the final cost), or a value and the continuation. -/
inductive QAdvanced (a : Type) where
  | done (plan : QPlan a)
  | more (value : a) (plan : QPlan a)

/-- The linear handle (the constructor is private: only the engine makes one). -/
inductive QCursor (a : Type) where
  | private mk (plan : QPlan a)

/-- A step of a page cursor. -/
inductive QStep (a : Type) where
  | done
  | more (value : a) (1 next : QCursor a)

-- ## Making a plan

/-- The global slots (the index root's head numbers) of a local range. -/
def QGlobalSlots (ord slots : Nat) (kr : KeyRange) : List Nat :=
  List.map (fun s => Nat.add (Nat.mul ord slots) s) (QSlotsFor slots kr)

/-- An index scan over `kr`. `needNode` decides whether a candidate is followed to the
primary; `project` says what the plan yields. -/
def QCursor.ofIndex {a : Type} (s : QSnapshot) (d : IndexDef) (kr : KeyRange)
    (project : U64 → U64 → Option Node → Option a) (needNode : Bool) : QCursor a :=
  let slots := QSlotsPer (List.length s.indices);
  let ord := QOrdOf d s.indices;
  let heads := QDirRead s.map s.indexRoot.toNat;
  let cost := match Nat.beq s.indexRoot.toNat 0 with
    | .true => Cost.zero
    | .false => Cost.page;
  QCursor.mk (QPlan.mk s ord slots kr heads (QGlobalSlots ord slots kr) []
    project needNode [] cost)

/-- Index-only scan: the indexed value, no primary read. -/
def QSnapshot.indexOnlyRange (d : IndexDef) (kr : KeyRange) (s : QSnapshot) : QCursor U64 :=
  QCursor.ofIndex s d kr (fun v _ _ => .some v) .false

/-- Index-only scan of the primary ids (the index entry carries both). -/
def QSnapshot.indexCursorRange (d : IndexDef) (kr : KeyRange) (s : QSnapshot) : QCursor U64 :=
  QCursor.ofIndex s d kr (fun _ id _ => .some id) .false

/-- An index scan for one key. -/
def QSnapshot.indexCursor (d : IndexDef) (v : U64) (s : QSnapshot) : QCursor U64 :=
  QSnapshot.indexCursorRange d (KeyRange.eq v) s

/-- Index scan followed to the primary nodes. -/
def QSnapshot.indexNodesRange (d : IndexDef) (kr : KeyRange) (s : QSnapshot) : QCursor Node :=
  QCursor.ofIndex s d kr (fun _ _ n => n) .true

/-- Every entry of an index, followed to its node. -/
def QSnapshot.indexNodesAll (d : IndexDef) (s : QSnapshot) : QCursor Node :=
  QSnapshot.indexNodesRange d KeyRange.all s

/-- An index scan for one key, followed to the nodes. -/
def QSnapshot.indexNodes (d : IndexDef) (v : U64) (s : QSnapshot) : QCursor Node :=
  QSnapshot.indexNodesRange d (KeyRange.eq v) s

-- ## Advancing

/-- The fuel for a fact chain: a chain cannot be longer than the file's pages. -/
def QPlan.fuel {a : Type} (p : QPlan a) : Nat := Nat.succ (Nat.div (Map.len p.snap.map) pageSize)

/-- The next result, or the end. The plan is an accumulator (no linear argument). -/
partial def QAdvance {a : Type} (p : QPlan a) : QAdvanced a :=
  match p.cur with
  | [] => match p.pending with
    | [] => .done p
    | List.cons slot rest =>
      let head := QNth p.heads slot 0;
      let (fs, pages) := QReadFacts p.snap.map head p.fuel p.ord;
      let live := QFactsLive fs p.range;
      let cost := Cost.add p.cost (Cost.add (Cost.pageN pages)
        (Cost.mk 0 (List.length fs) 0));
      QAdvance (QPlan.mk p.snap p.ord p.slots p.range p.heads rest live p.project
        p.needNode p.post cost)
  | List.cons (v, id) rest =>
    let cost := match p.needNode with
      | .true => Cost.add p.cost (Cost.mk 1 0 1)
      | .false => p.cost;
    let got := match p.needNode with
      | .true => QReadNode p.snap.map p.snap.root id
      | .false => Option.none;
    match p.project v id got with
    | .none => QAdvance (QPlan.mk p.snap p.ord p.slots p.range p.heads p.pending rest
        p.project p.needNode p.post cost)
    | .some x =>
      match List.all (fun q => q x) p.post with
      | .true => .more x (QPlan.mk p.snap p.ord p.slots p.range p.heads p.pending rest
          p.project p.needNode p.post cost)
      | .false => QAdvance (QPlan.mk p.snap p.ord p.slots p.range p.heads p.pending rest
          p.project p.needNode p.post cost)

-- ## Consuming

/-- One step. -/
def QCursor.next {a : Type} (1 c : QCursor a) : QStep a :=
  match c with
  | .mk p => match QAdvance p with
    | .done _ => .done
    | .more x p' => .more x (QCursor.mk p')

/-- Consume the cursor without reading the rest. -/
def QCursor.close {a : Type} (1 c : QCursor a) : Unit :=
  match c with
  | .mk _ => ()

/-- Fold the plan (the recursion is on the ω plan, not the linear handle). -/
partial def QCursor.foldPlan {a b : Type} (p : QPlan a) (k : b → a → b) (b0 : b)
    : b × Cost :=
  match QAdvance p with
  | .done p' => (b0, p'.cost)
  | .more x p' => QCursor.foldPlan p' k (k b0 x)

/-- Fold with early exit. -/
partial def QCursor.foldUntilPlan {a b : Type} (p : QPlan a) (k : b → a → Control b)
    (b0 : b) : b × Cost :=
  match QAdvance p with
  | .done p' => (b0, p'.cost)
  | .more x p' => match k b0 x with
    | .stop b' => (b', p'.cost)
    | .go b' => QCursor.foldUntilPlan p' k b'

/-- Fold the handle once, returning the value and its read-path cost. -/
def QCursor.foldWith {a b : Type} (1 c : QCursor a) (k : b → a → b) (b0 : b) : b × Cost :=
  match c with
  | .mk p => QCursor.foldPlan p k b0

/-- Fold the handle, discarding the cost. -/
def QCursor.fold {a b : Type} (1 c : QCursor a) (k : b → a → b) (b0 : b) : b :=
  match c with
  | .mk p => match QCursor.foldPlan p k b0 with
    | (b, _) => b

/-- The number of results. -/
def QCursor.length {a : Type} (1 c : QCursor a) : Nat :=
  QCursor.fold c (fun n _ => Nat.succ n) 0

/-- The first result, and the cost up to it (early exit). -/
def QCursor.firstWith {a : Type} (1 c : QCursor a) : Option a × Cost :=
  match c with
  | .mk p => match QAdvance p with
    | .done p' => (Option.none, p'.cost)
    | .more x p' => (Option.some x, p'.cost)

-- ## Pushdown

/-- Tighten the plan's range before its first step; after that the predicate is a
post-filter (the same results, no re-read). -/
def QCursor.pushKey {a : Type} (pred : KeyPred) (test : a → Bool)
    (1 c : QCursor a) : QCursor a :=
  match c with
  | .mk p => match Nat.beq p.cost.keys 0 with
    | .true =>
      let r' := KeyRange.tighten p.range pred;
      QCursor.mk (QPlan.mk p.snap p.ord p.slots r' p.heads
        (QGlobalSlots p.ord p.slots r') [] p.project p.needNode p.post p.cost)
    | .false => QCursor.mk { p with post := List.append p.post [test] }

/-- Push an equality/range predicate into an index-only plan (the key *is* the indexed
field). -/
def QCursor.filterKey (pred : KeyPred) (1 c : QCursor U64) : QCursor U64 :=
  QCursor.pushKey pred (fun v => KeyPred.test pred v) c

/-- Push a predicate into a followed index scan; on another index it stays a post-filter
on the node's field. -/
def QCursor.filterOnNode (d : IndexDef) (pred : KeyPred)
    (1 c : QCursor Node) : QCursor Node :=
  QCursor.pushKey pred (fun n => KeyPred.test pred (Node.field n d.field.toNat)) c

/-- An index-only query with a pushed predicate. -/
def QSnapshot.indexOnlyWhere (d : IndexDef) (pred : KeyPred) (s : QSnapshot) : QCursor U64 :=
  QCursor.filterKey pred (QSnapshot.indexOnlyRange d KeyRange.all s)

/-- An index→primary query with a pushed predicate. -/
def QSnapshot.indexNodesWhere (d : IndexDef) (pred : KeyPred) (s : QSnapshot) : QCursor Node :=
  QCursor.filterOnNode d pred (QSnapshot.indexNodesAll d s)
