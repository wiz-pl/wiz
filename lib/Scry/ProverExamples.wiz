import Scry.Prover
import Scry.RuleTaint
/-!
# Tiny prover examples

Two EDBs for the taint rules, small enough to read. They isolate the prover from the
C# frontend, so the `scry-prover` tests can check the proof objects with exact rows:

```
point 0: v0 = source()          src(0, 0)
point 1: v1 = f(v0)             flow(0, 1, 0), gen(1, 1), [san(1, 1)]
point 2: sink(v1)               flow(1, 2, 1), sink(2, 0, 1)
```

`Scry.proverSafe` has the `san(1, 1)` kill (the sanitiser); `Scry.proverUnsafe` does
not. The safe claim's invariant is `{(0,0)}`: the only seed, and the transfer rule is
blocked at point 1. The unsafe closure adds `{(1,1)}` and the alert obligation fires at
`sink 2 argument 0`.

The relation numbers are `Scry.rtFlow`/`rtSrc`/`rtSink`/`rtSan`/`rtGen`.
-/

def Scry.proverSafe : Scry.State Nat :=
  let st := Scry.State.empty;
  let st := Scry.State.addTuple st Scry.rtSrc [U64.ofNat 0, U64.ofNat 0];
  let st := Scry.State.addTuple st Scry.rtFlow [U64.ofNat 0, U64.ofNat 1, U64.ofNat 0];
  let st := Scry.State.addTuple st Scry.rtGen [U64.ofNat 1, U64.ofNat 1];
  let st := Scry.State.addTuple st Scry.rtSan [U64.ofNat 1, U64.ofNat 1];
  let st := Scry.State.addTuple st Scry.rtFlow [U64.ofNat 1, U64.ofNat 2, U64.ofNat 1];
  let st := Scry.State.addTuple st Scry.rtSink [U64.ofNat 2, U64.ofNat 0, U64.ofNat 1];
  st

def Scry.proverUnsafe : Scry.State Nat :=
  let st := Scry.State.empty;
  let st := Scry.State.addTuple st Scry.rtSrc [U64.ofNat 0, U64.ofNat 0];
  let st := Scry.State.addTuple st Scry.rtFlow [U64.ofNat 0, U64.ofNat 1, U64.ofNat 0];
  let st := Scry.State.addTuple st Scry.rtGen [U64.ofNat 1, U64.ofNat 1];
  let st := Scry.State.addTuple st Scry.rtFlow [U64.ofNat 1, U64.ofNat 2, U64.ofNat 1];
  let st := Scry.State.addTuple st Scry.rtSink [U64.ofNat 2, U64.ofNat 0, U64.ofNat 1];
  st

/-- The safe claim, proved by the default script. -/
def Scry.proverSafeClaim : Option Scry.Claim :=
  Scry.prove Scry.ruleTaintProgram Scry.proverSafe

/-- The safe claim's verdict (should be `ok`). -/
def Scry.proverSafeVerdict : Scry.Verdict :=
  match Scry.proverSafeClaim with
  | .some c => Scry.check Scry.ruleTaintProgram Scry.proverSafe c
  | .none => .rejected "the default script found no invariant"

/-- The unsafe closure: seeds and one closure round, no final check (the point is to
show the checker refusing it). -/
def Scry.proverUnsafeCover : Option Scry.Claim :=
  Scry.proveWith Scry.ruleTaintProgram Scry.proverUnsafe
    [ Scry.Tactic.intro Scry.rtSrc
    , Scry.Tactic.intro Scry.rtParam
    , Scry.Tactic.intro Scry.rtRetSrc
    , Scry.Tactic.close ]

/-- The unsafe claim's verdict (should be rejected at the alert obligation). -/
def Scry.proverUnsafeVerdict : Scry.Verdict :=
  match Scry.proverUnsafeCover with
  | .some c => Scry.check Scry.ruleTaintProgram Scry.proverUnsafe c
  | .none => .rejected "no invariant"

/-- An empty invariant: the seed rule must catch it. -/
def Scry.proverEmptyVerdict : Scry.Verdict :=
  Scry.check Scry.ruleTaintProgram Scry.proverSafe (Scry.Claim.mk "empty" [])

/-- The unsafe program's invariant checked against the safe program. -/
def Scry.proverCrossVerdict : Scry.Verdict :=
  match Scry.proverUnsafeCover with
  | .some c => Scry.check Scry.ruleTaintProgram Scry.proverSafe c
  | .none => .rejected "no invariant"

/-- The invariant after the safe script, rendered. -/
def Scry.proverSafeInvariant : String :=
  match Scry.proverSafeClaim with
  | .some c => Scry.showInv c.invariant
  | .none => "?"

/-- The unsafe invariant after the cover script, rendered. -/
def Scry.proverUnsafeInvariant : String :=
  match Scry.proverUnsafeCover with
  | .some c => Scry.showInv c.invariant
  | .none => "?"
