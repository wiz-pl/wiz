import IO
/-!
# Std

The standard library for systems code (stage 12a): containers and text with native
representations, updated in place when they are unique.

* `Array A`: a growable array (`Array.push`, `Array.getD`, `Array.set`);
* `Str`: UTF-8 text in a native buffer (`Str.append`, `Str.push`, `Str.join`,
  `Str.slice`, `Str.byte`);
* `StrMap V`: a map from `Str` keys to values (`StrMap.insert`, `StrMap.findD`).

They are axioms with `extern` operations, implemented by the runtime (runtime/).
When a value is unique (its reference count is one), `push`, `set` and `insert`
update it in place instead of copying it. `Str.append` and `Str.push` too: a loop
that keeps only the new text (`s := Str.push s b`) appends in amortised constant
time, and `Str.join` is the same for a list of pieces.

```
def squares : Array Nat :=
  Array.push (Array.push (Array.push Array.empty 0) 1) 4
-- Array.getD squares 2 0 = 4, Array.size squares = 3
```
-/

/-- Arrays of any values: a native buffer, indexed from 0. -/
axiom Array : Type → Type
/-- The empty array. -/
extern "wiz_array_empty" Array.empty : {A : Type} → Array A
/-- Add an element at the end (in place when the array is unique). -/
extern "wiz_array_push" Array.push : {A : Type} → Array A → A → Array A
/-- The number of elements. -/
extern "wiz_array_size" Array.size : {A : Type} → Array A → Nat
/-- `Array.getD a i d`: the element at index `i`, or the default `d` if `i` is out of
range. -/
extern "wiz_array_get" Array.getD : {A : Type} → Array A → Nat → A → A
/-- `Array.set a i x`: `a` with the element at `i` replaced by `x` (unchanged if `i` is
out of range; in place when the array is unique). -/
extern "wiz_array_set" Array.set : {A : Type} → Array A → Nat → A → Array A

/-- UTF-8 text in a native buffer (unlike the Prelude's `String`, which is a value of
the compiler's own). Sizes and indices count bytes. -/
axiom Str : Type
/-- The empty text. -/
extern "wiz_str_empty" Str.empty : Str
/-- A `String` as a `Str`. -/
extern "wiz_str_of_cstr" Str.ofString : String → Str
/-- A `Str` as a `String`. -/
extern "wiz_str_to_cstr" Str.toString : Str → String
/-- The two texts one after the other (in place when the first is unique). -/
extern "wiz_str_append" Str.append : Str → Str → Str
/-- Add one byte at the end (in place when the text is unique). -/
extern "wiz_str_push" Str.push : Str → Nat → Str
/-- The pieces one after the other (`Str.append` onto the accumulator). -/
def Str.joinGo (acc : Str) : List Str → Str
  | .nil => acc
  | .cons s ss => Str.joinGo (Str.append acc s) ss
/-- The pieces one after the other. `Str.join` folds from the left, so each step
keeps the accumulated text unique and `Str.append` extends it in place; a loop of
`Str.push` is the byte-at-a-time builder. -/
def Str.join (ss : List Str) : Str := Str.joinGo Str.empty ss
/-- The length in bytes. -/
extern "wiz_str_size" Str.size : Str → Nat
/-- `Str.byte s i`: the byte at offset `i`, a number below 256 (0 past the end). -/
extern "wiz_str_byte" Str.byte : Str → Nat → Nat
/-- `Str.slice s i j`: the bytes from offset `i` up to (not including) `j`, clamped to the
text. -/
extern "wiz_str_slice" Str.slice : Str → Nat → Nat → Str
/-- Whether the two texts are byte for byte equal. -/
extern "wiz_str_eq" Str.eq : Str → Str → Bool
/-- Whether the first text comes before the second (byte order). -/
extern "wiz_str_lt" Str.lt : Str → Str → Bool

/-- Maps from text (`Str`) to values of type `V`. -/
axiom StrMap : Type → Type
/-- The empty map. -/
extern "wiz_map_empty" StrMap.empty : {V : Type} → StrMap V
/-- `StrMap.insert m k v`: `m` with the key `k` mapped to `v` (replacing any old value;
in place when the map is unique). -/
extern "wiz_map_insert" StrMap.insert : {V : Type} → StrMap V → Str → V → StrMap V
/-- `StrMap.findD m k d`: the value of key `k`, or the default `d` if there is none. -/
extern "wiz_map_find" StrMap.findD : {V : Type} → StrMap V → Str → V → V
/-- The number of keys. -/
extern "wiz_map_size" StrMap.size : {V : Type} → StrMap V → Nat

/-- `IO.writeFile path text`: write `text` to the file at `path`, replacing it. The text
is written as UTF-8 up to its first NUL (use `FS.writeBytes` in lib/Sys.wiz for binary
data). `IO Unit` has no error channel, so a failure (a bad path, a full disk) prints
`wiz: <path>: <message>` on standard error and exits 1 rather than looking like
success. -/
extern "wiz_io_write_file" IO.writeFile : String → String → IO Unit

-- ## Bytes and arrays

-- `Bytes` (`lib/IO.wiz`) is a native buffer and `Array` is a native array of boxed
-- values, so the conversion is a loop of `Bytes.push`/`Array.getD` (`Bytes` holds
-- numbers below 256; `Bytes.push` keeps the low eight bits). `Array` lives here rather
-- than in `IO`, which is why the conversions are in this module.

/-- `Bytes.ofArrayAux a fuel i acc`: `acc` with the elements of `a` from `i` on pushed,
at most `fuel` of them (a helper of `Bytes.ofArray`). -/
def Bytes.ofArrayAux (a : Array Nat) : Nat → Nat → Bytes → Bytes
  | .zero, _, acc => acc
  | .succ fuel, i, acc => match Nat.lt i (Array.size a) with
    | .true => Bytes.ofArrayAux a fuel (Nat.succ i) (Bytes.push acc (Array.getD a i 0))
    | .false => acc

/-- The bytes of an array of numbers, each mod 256: `Bytes.ofArray squares`. -/
def Bytes.ofArray (a : Array Nat) : Bytes := Bytes.ofArrayAux a (Array.size a) 0 Bytes.empty

/-- `Bytes.toArrayAux b fuel i acc`: `acc` with the bytes of `b` from `i` on pushed, at
most `fuel` of them (a helper of `Bytes.toArray`). -/
def Bytes.toArrayAux (b : Bytes) : Nat → Nat → Array Nat → Array Nat
  | .zero, _, acc => acc
  | .succ fuel, i, acc => match Nat.lt i (Bytes.size b) with
    | .true => Bytes.toArrayAux b fuel (Nat.succ i) (Array.push acc (Bytes.get b i))
    | .false => acc

/-- The bytes as an array of numbers: `Bytes.toArray (Bytes.ofArray a)` has the
elements of `a`, each mod 256. -/
def Bytes.toArray (b : Bytes) : Array Nat := Bytes.toArrayAux b (Bytes.size b) 0 Array.empty
