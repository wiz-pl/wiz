import Word
import Text
import Data.PMap
import Logic
/-!
# Intern

Interned strings (`import Intern`): an `InternTable` gives each distinct string a
small id, a `U32`, so that strings compare and hash as words (equal ids, equal
strings, within one table). Ids are stable: a string keeps its id as more are
interned, and ids are handed out in order, 0, 1, 2, … A table is a functional value,
updated in place when it is unique (as `StrMap`); keep one per program or per
analysis, and key `U64Map`s (lib/WordMap.wiz) or index `U32Array`s by the ids.

The model. A table is a map from a string to its id, `mk (ids : PMap String U32)`: ids
are `0, 1, 2, …`, handed out in order, and the module keeps them distinct and contiguous
(the constructor is private). `intern` is a `PMap` lookup and insert, so it is O(log n)
comparisons in the kernel, under `#eval` and under `#run`, not a scan of all the strings.
`toList` and `lookup` read the same map by id (through `PMap Nat String`). The kernel
computes with the definitions, and `#eval`/`#run` run them.

Compiled code runs natives instead (`runtime/`, `wiz_itab_*`): the strings by
id (each `String` value kept as it is, so `lookup` copies nothing) and a hash index
from a string to its id, so `intern` and `find` take time proportional to the
string's length, and `lookup` constant time. Construction is native too: `ofList`/`empty`
build the C table (`wiz_itab_of_list`, `wiz_itab_empty` is not needed: an empty list has
the same effect) and `toList` reads it back, so compiled code never builds or destructures
the model's map.

Trust. The natives are trusted to agree with the definitions (`#print axioms` lists
them, marked `native`, 22f). They abort when memory runs out or a table would hold
2^32 - 1 strings (the model's ids wrap around there). The tests (group `natives`)
run the same programs under the interpreter and compiled, C and LLVM.

the map from a string to its id, in first-occurrence order
-/

-- the strings by first occurrence, each with the next id (so duplicates keep the id of
-- their first occurrence, as the C `of_list` does)
private def InternTable.addStrs : PMap String U32 → List String → PMap String U32
  | m, .nil => m
  | m, .cons s rest => match PMap.find m s with
    | .some _ => InternTable.addStrs m rest
    | .none => InternTable.addStrs (PMap.insert m s (U32.ofNat (PMap.size m))) rest

sealed inductive InternTable where
  | private mk (ids : PMap String U32)

-- the map from a string to its id
private def InternTable.ids : InternTable → PMap String U32
  | .mk m => m
-- the map of a list of strings, indexed from 0
private def InternTable.ofStrs (strs : List String) : PMap String U32 :=
  InternTable.addStrs PMap.empty strs
-- the ids of a map, as a map from the id to the string
private def InternTable.byId (m : PMap String U32) : PMap Nat String :=
  PMap.foldl (fun acc s id => PMap.insert acc id.toNat s) PMap.empty m
-- the strings of a map, by id
private def InternTable.strsOf (m : PMap String U32) : List String :=
  List.map (fun e => e.2) (PMap.toList (InternTable.byId m))

-- the table of a list of strings: ids in list order, 0, 1, 2, …
def InternTable.ofList (strs : List String) : InternTable := .mk (InternTable.ofStrs strs)
def InternTable.empty : InternTable := InternTable.ofList .nil
-- `s`'s id, if it has one
def InternTable.find (t : InternTable) (s : String) : Option U32 := PMap.find t.ids s
-- the table with `s`, and `s`'s id (a new one, `size t`, if `s` is new)
def InternTable.intern (t : InternTable) (s : String) : InternTable × U32 :=
  match InternTable.find t s with
  | .some i => (t, i)
  | .none =>
    let i := U32.ofNat (PMap.size t.ids);
    (.mk (PMap.insert t.ids s i), i)
-- the string with id `i`, or ""
def InternTable.lookupL : List (String × U32) → Nat → String
  | .nil, _ => ""
  | .cons e rest, i => match Nat.beq e.2.toNat i with
    | .true => e.1
    | .false => InternTable.lookupL rest i
-- the strings, by id (compiled code calls `toListNative`, the C list directly)
def InternTable.toList (t : InternTable) : List String := InternTable.strsOf t.ids
def InternTable.size (t : InternTable) : Nat := List.length (InternTable.toList t)
def InternTable.lookup (t : InternTable) (i : U32) : String :=
  InternTable.lookupL (PMap.toList t.ids) i.toNat
-- (Wiz functions over the operations above)
-- the ids of a list of strings, interning each
def InternTable.internAll : InternTable → List String → InternTable × List U32
  | t, .nil => (t, .nil)
  | t, .cons s rest =>
    let p := InternTable.intern t s;
    let q := InternTable.internAll p.1 rest;
    (q.1, .cons p.2 q.2)

-- a `String` passed to C as the Wiz value itself (as `NatObj`), not as a C string
def StringObj : Type := String
-- The C table is the compiled representation of a table: `ofList` builds it from the
-- strings in id order, and `toList` reads them back. `empty`, `ofList`, `toList` and the
-- lookups are the only compiled operations, so compiled code never builds or destructures
-- the model's `PMap` (and `#eval`/`#run`, which cannot call C, run the model).
extern "wiz_itab_of_list" InternTable.ofListNative : List String → InternTable
extern "wiz_itab_to_list" InternTable.toListNative : InternTable → List String
attribute [implemented_by InternTable.ofListNative] InternTable.ofList
attribute [implemented_by InternTable.toListNative] InternTable.toList
extern "wiz_itab_find" InternTable.findNative : InternTable → StringObj → Option U32
extern "wiz_itab_intern" InternTable.internNative : InternTable → StringObj → InternTable × U32
extern "wiz_itab_lookup" InternTable.lookupNative : InternTable → U32 → StringObj
attribute [implemented_by InternTable.findNative] InternTable.find
attribute [implemented_by InternTable.internNative] InternTable.intern
attribute [implemented_by InternTable.lookupNative] InternTable.lookup

-- ## Laws (on the model). That `lookup` gives back an interned string needs `String.eq`
-- to be equality (true, not proved in lib/Text.wiz yet) and fewer than 2^32 strings;
-- it is tested, not proved, here.
def InternTable.size_empty : InternTable.size InternTable.empty = 0 := rfl
def InternTable.find_empty (s : String) : InternTable.find InternTable.empty s = .none := rfl
