import Hdl.Core
/-!
# Hdl.Crc

CRC-8/SMBUS (polynomial `x^8 + x^2 + x + 1` = `0x07`, initial value 0, most significant
bit first, no reflection, no final xor), twice: as hardware, one byte per clock cycle,
and as a function on numbers, which is what a host computes. It is the CRC of the
iCEstick project (`wiz-icestick-uart/src/Icestick/Crc.wiz`) with the
board-specific vocabulary removed, so any design can use it.

The specification is `Crc.bit` (one bit), `Crc.iter` (n bits), `Crc.step` (one byte),
`Crc.ofList` (a whole message), `Crc.hex` (a nibble as an ASCII hexadecimal digit) and
`Crc.reply` (the iCEstick's two-hex-digit answer line). The hardware is `Crc.hwBit`,
`Crc.hwIter` and `Crc.hwStep` (eight unrolled `hwBit` steps on `c XOR d`), and the
streaming circuit `Crc.crcC`: input `valid`/`data`, output `valid`/`crc`, one byte per
cycle while `valid` is high.

The known-answer test is in the module (`Crc.checkDigits`, `Crc.checkValue`,
`Crc.check_ok`): CRC-8/SMBUS of the ASCII `"123456789"` is `0xF4` = 244. The test group
`bus-crc` (`examples/hdl-crc.wiz`) also compares the hardware with the specification on
every `(crc, byte)` pair (65536 inputs), checks `Crc.hexDigit` against `Crc.hex` on all
16 nibbles, and runs `Crc.crcC` through the value simulation, `Netlist.simulate` and
`Circuit.simFast`.

`Crc.protoC` is the line-framed CRC service of the iCEstick's `proto` design with the
UART removed, so it sits behind any byte transport: input `valid`/`data`/`txIdle`,
output `ready`/`valid`/`data`/`lines`. A line is bytes other than 10 and then the
newline 10; the service answers the line's CRC as two upper-case hex digits and a
newline, one byte per `txIdle` cycle. The contract is one outstanding line: `ready` is
low from the accepted newline until the reply ends, and bytes offered while it is low
are dropped, not queued. The host half is `Crc.reply`/`Crc.replies`; `Crc.reply_check`
is the kernel-checked on-the-wire known answer. The example `examples/hdl-crc-link.wiz`
(test groups `hdl` and `bus-crc`) checks the two sides against each other.
-/

/-- One bit. -/
def Crc.Bit : HwTy := HwTy.bits 1
/-- The CRC register's width (CRC-8). -/
def Crc.B8 : HwTy := HwTy.bits 8
/-- A hexadecimal digit. -/
def Crc.B4 : HwTy := HwTy.bits 4

/-- Shift an 8-bit register up by one place, zeros in at the bottom. -/
def Crc.shl1 {r : HwTy → Type} [Hw r] (c : r Crc.B8) : r Crc.B8 :=
  Hw.cat (Hw.slice 0 7 c) (Hw.lit 1 0)

/-- One bit of the hardware CRC: shift left, and subtract (xor) the polynomial if a one
fell out of the top. -/
def Crc.hwBit {r : HwTy → Type} [Hw r] (c : r Crc.B8) : r Crc.B8 :=
  let sh := Crc.shl1 c;
  if Hw.slice 7 1 c then Hw.xor sh (Hw.lit 8 7) else sh

/-- `n` copies of `Crc.hwBit` (a meta-level recursion: the netlist has the copies, not a
loop). -/
def Crc.hwIter {r : HwTy → Type} [Hw r] : Nat → r Crc.B8 → r Crc.B8
  | .zero, c => c
  | .succ k, c => Crc.hwIter k (Crc.hwBit c)

/-- The CRC after one more byte `d`: eight copies of `Crc.hwBit`, unrolled, on `c XOR d`. -/
def Crc.hwStep {r : HwTy → Type} [Hw r] (c d : r Crc.B8) : r Crc.B8 :=
  Crc.hwIter 8 (Hw.xor c d)

/-- A nibble as an ASCII hexadecimal digit (upper case). -/
def Crc.hexDigit {r : HwTy → Type} [Hw r] (nib : r Crc.B4) : r Crc.B8 :=
  let z := Hw.cat (Hw.lit 4 0) nib;
  if Hw.ult nib (Hw.lit 4 10) then Hw.add z (Hw.lit 8 48) else Hw.add z (Hw.lit 8 55)

------------------------------------------------------------------------------------
-- The specification, on numbers.

/-- One bit of the CRC: shift left modulo 256, and xor the polynomial if bit 7 was set. -/
def Crc.bit (c : Nat) : Nat := match Nat.testBit c 7 with
  | .true => Nat.xor (Nat.mod (Nat.mul c 2) 256) 7
  | .false => Nat.mod (Nat.mul c 2) 256

/-- `n` bits of the CRC. -/
def Crc.iter : Nat → Nat → Nat
  | .zero, c => c
  | .succ k, c => Crc.iter k (Crc.bit c)

/-- The CRC after one byte: eight bit steps on `c XOR d`. -/
def Crc.step (c d : Nat) : Nat := Crc.iter 8 (Nat.xor c d)

/-- The CRC of a message, from an initial value. -/
def Crc.ofList : Nat → List Nat → Nat
  | c, .nil => c
  | c, .cons d ds => Crc.ofList (Crc.step c d) ds

/-- A nibble as an ASCII hexadecimal digit (upper case), at values. -/
def Crc.hex (n : Nat) : Nat := match Nat.lt n 10 with
  | .true => 48 + n
  | .false => 55 + n

/-- The device's answer to a line: two hex digits of its CRC and a newline. -/
def Crc.reply (line : List Nat) : List Nat :=
  let c := Crc.ofList 0 line;
  .cons (Crc.hex (Nat.div c 16)) (.cons (Crc.hex (Nat.mod c 16)) (.cons 10 .nil))

/-- The host's answers to a list of lines, in order: the CRC protocol's expected reply
stream (the host-side half of `Crc.protoC`). -/
def Crc.replies : List (List Nat) → List Nat
  | .nil => .nil
  | .cons l ls => List.append (Crc.reply l) (Crc.replies ls)

------------------------------------------------------------------------------------
-- The streaming circuit: a CRC register and an input/output handshake.

/-- The CRC register. -/
structure Crc.St (r : HwTy → Type) where
  crc : r Crc.B8
  deriving Bundle

/-- A byte in: `valid`/`data`. -/
structure Crc.In (r : HwTy → Type) where
  valid : r Crc.Bit
  data : r Crc.B8
  deriving Bundle

/-- The CRC out: `valid` (this cycle accepted a byte) and the CRC after it. -/
structure Crc.Out (r : HwTy → Type) where
  valid : r Crc.Bit
  crc : r Crc.B8
  deriving Bundle

/-- One cycle: on `valid`, advance the CRC by `data`; the output shows the new value. -/
def Crc.streamStep {r : HwTy → Type} [Hw r] (s : Crc.St r) (x : Crc.In r) :
    r (HwTy.prod Crc.St.code Crc.Out.code) :=
  let c := Hw.mux x.valid (Crc.hwStep s.crc x.data) s.crc;
  Hw.pair (Crc.St.pack (Crc.St.mk c)) (Crc.Out.pack (Crc.Out.mk x.valid c))

/-- The streaming CRC-8 as a circuit. -/
def Crc.crcC : Circuit Crc.In.code Crc.Out.code :=
  Circuit.bundled Crc.St.bundle Crc.In.bundle Crc.Out.bundle (Crc.St.mk (BitVec.ofNat 8 0))
    (fun s x => Crc.streamStep s x)

------------------------------------------------------------------------------------
-- The line protocol: a transport-independent CRC service. It is the `proto` design of
-- the iCEstick project (`Icestick.Designs`) with the UART removed from the cell, and
-- the host's half is `Crc.reply`/`Crc.replies`.
--
-- The contract is request/response and AXI4-Lite-shaped: one line outstanding, no
-- bursts. A line is data bytes (any byte but 10) followed by a newline (10). When the
-- newline is accepted the service answers with the line's CRC as two upper-case hex
-- digits and a newline, one byte per cycle while `txIdle` is high. `ready` is low from
-- the accepted newline until the reply's newline has been sent; while it is low the
-- input byte is ignored (a host that starts another line early loses it, it is not
-- queued), so a second line cannot be accepted before the first is answered.

/-- The service's state: the running CRC, the CRC being reported, the reply phase
(0: accepting a line; 1, 2: the hex digits; 3: the reply's newline) and the number of
lines answered. -/
structure Crc.Proto (r : HwTy → Type) where
  crc : r Crc.B8
  hold : r Crc.B8
  phase : r (HwTy.bits 2)
  lines : r (HwTy.bits 4)
  deriving Bundle

/-- The service's input: a received byte (`valid`/`data`) and whether the transmitter is
idle (`txIdle`); a reply byte is offered only in an idle cycle. -/
structure Crc.ProtoIn (r : HwTy → Type) where
  valid : r Crc.Bit
  data : r Crc.B8
  txIdle : r Crc.Bit
  deriving Bundle

/-- The service's output: `ready` (no reply in flight: a new line may start), `valid`
with `data` (a reply byte to send) and the line counter. -/
structure Crc.ProtoOut (r : HwTy → Type) where
  ready : r Crc.Bit
  valid : r Crc.Bit
  data : r Crc.B8
  lines : r (HwTy.bits 4)
  deriving Bundle

/-- One cycle of the CRC service. `accept` is `ready && valid`: while a reply is in
flight the input is ignored. A data byte advances the CRC; an accepted newline starts
the reply (phase 1) and keeps the CRC to report. A reply byte is sent when the phase is
non-zero and `txIdle` is high; phase 3 sends the newline and wraps to 0. -/
def Crc.protoStep {r : HwTy → Type} [Hw r] (s : Crc.Proto r) (x : Crc.ProtoIn r) :
    r (HwTy.prod Crc.Proto.code Crc.ProtoOut.code) :=
  let free := s.phase === 0;
  let accept := free &&& x.valid;
  let newline := x.data === 10;
  let endLine := accept &&& newline;
  let dataByte := accept &&& ~~~newline;
  let send := (s.phase =/= 0) &&& x.txIdle;
  let nib := if s.phase === 1 then Hw.slice 4 4 s.hold else Hw.slice 0 4 s.hold;
  let ch := if s.phase === 3 then 10 else Crc.hexDigit nib;
  Hw.pair
    (Crc.Proto.pack (Crc.Proto.mk
      (if endLine then 0 else if dataByte then Crc.hwStep s.crc x.data else s.crc)
      (if endLine then s.crc else s.hold)
      (if endLine then 1 else if send then s.phase + 1 else s.phase)
      (if endLine then s.lines + 1 else s.lines)))
    (Crc.ProtoOut.pack (Crc.ProtoOut.mk free send ch s.lines))

/-- The CRC service as a circuit: a byte stream in, a byte stream out, one line
outstanding. -/
def Crc.protoC : Circuit Crc.ProtoIn.code Crc.ProtoOut.code :=
  Circuit.bundled Crc.Proto.bundle Crc.ProtoIn.bundle Crc.ProtoOut.bundle
    (Crc.Proto.mk (BitVec.ofNat 8 0) (BitVec.ofNat 8 0) (BitVec.ofNat 2 0)
      (BitVec.ofNat 4 0))
    (fun s x => Crc.protoStep s x)

------------------------------------------------------------------------------------
-- Known-answer test (CRC-8/SMBUS of the ASCII "123456789" is 0xF4 = 244).

/-- The ASCII bytes of `"123456789"`. -/
def Crc.checkDigits : List Nat :=
  .cons 49 (.cons 50 (.cons 51 (.cons 52 (.cons 53 (.cons 54 (.cons 55 (.cons 56 (.cons 57 .nil))))))))

/-- The CRC-8/SMBUS check value. -/
def Crc.checkValue : Nat := 244

/-- The specification meets the check value (kernel-checked). -/
def Crc.check_ok : Crc.ofList 0 Crc.checkDigits = Crc.checkValue := rfl

/-- The known answer on the wire: `"123456789"` is answered `"F4\n"` (the host side of
the protocol, kernel-checked). -/
def Crc.reply_check :
    Crc.reply Crc.checkDigits = .cons 70 (.cons 52 (.cons 10 .nil)) := rfl
