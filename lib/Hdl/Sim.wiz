import Hdl.Core
import Std
/-!
# Hdl.Sim

Fast netlist simulation for compiled programs (`import Hdl.Sim`).

`Netlist.simulate` (lib/Hdl/Core.wiz) is the netlist's semantics, written for the
kernel: node values in a persistent random-access list, O(nodes · log nodes) per cycle
with an allocation per node. `Circuit.run` (the value simulation) is the circuit's
semantics; compiled, it runs the step function at `HwTy.El` every cycle, with every
meta-level computation in it (table trees, constants computed from the configuration,
bundle codes, dictionary calls) done again in each cycle.

`Netlist.simFast` computes exactly what `Netlist.simulate` computes (the same
operations on the same numbers, node by node), but builds the netlist's program once
and runs it over native arrays updated in place (`Array`, lib/Std.wiz): a value per
node, the register values, the input values. The netlist is the step function with
all the meta-level work done once (synthesis is partial evaluation), and hash-consed,
so this is also the fast way to run a circuit's value simulation:
`Circuit.simFast`, `Design.simFast` (on leaves, as `Circuit.runLeaves` and
`Design.runLeaves`). Compiled code only: `Array` has no definition the kernel or
`#eval` could run.

Agreement: `Netlist.simFast n xs = Netlist.simulate n xs` for every netlist whose node
arguments refer to earlier nodes, whose registers, memory reads and writes and ports
refer to nodes and memories that exist, and which has no vendor primitive (every netlist
`Circuit.netlist` builds from code without primitives; `Netlist.wellFormed` checks it),
and `Netlist.simFast` falls back to `Netlist.simulate` on any other (primitive
instances included). The `hdl` test group
checks both against `Circuit.run` cycle for cycle.
-/

/-- One instruction of the fast simulation: a node's operation with its destination and
arguments, the meta-level work (widths, masks) folded in. -/
inductive FastNode where
  | add (i a b m : Nat)
  | sub (i a b p m : Nat)
  | mul (i a b m : Nat)
  | and (i a b : Nat)
  | or (i a b : Nat)
  | xor (i a b : Nat)
  | not (i a m : Nat)
  | eq (i a b : Nat)
  | ult (i a b : Nat)
  | mux (i a b c : Nat)
  | concat (i a b k : Nat)
  | slice (i a k m : Nat)
  | resetTo (i a b k : Nat)
  | hold (i a b c : Nat)
  | shl (i a b w : Nat)        -- (H14 S4) `w`: the width (of the result; of the operands for slt)
  | lshr (i a b w : Nat)
  | ashr (i a b w : Nat)
  | slt (i a b w : Nat)
  -- a read of memory `k` at address node `a`: the words below `size` live in the flat
  -- memory array from `base`, any others (an address beyond the memory's range, as an
  -- input port can give) in a trie keyed by (k, address)
  | memRead (i a k base size : Nat)

/-- A memory's place in the flat array: its first word and its number of words there
(2^aw, or the initial contents if longer; only the initial contents for aw > 20). -/
inductive FastMem where
  | mk (base size : Nat)

/-- A memory's first word in the flat array. -/
def FastMem.base : FastMem → Nat
  | .mk b _ => b
/-- A memory's number of words in the flat array. -/
def FastMem.size : FastMem → Nat
  | .mk _ n => n

/-- How many words of a memory go in the flat array: `2^aw`, or its initial contents if
longer (only the initial contents for `aw > 20`). -/
def FastMem.sizeOf (m : NetMem) : Nat :=
  let ω n := List.length m.init;
  match Nat.lt 20 m.aw with
  | .true => n
  | .false => (match Nat.lt n (Nat.pow 2 m.aw) with
    | .true => Nat.pow 2 m.aw
    | .false => n)

/-- The memories' places in the flat array, starting at `base`. -/
def FastMem.layout : Nat → List NetMem → List FastMem
  | _, .nil => .nil
  | base, .cons m ms => .cons (FastMem.mk base (FastMem.sizeOf m)) (FastMem.layout (base + FastMem.sizeOf m) ms)

/-- a write at the clock edge (memory `k`, enable, address and data nodes), in order -/
inductive FastWrite where
  | mk (k base size e a d : Nat)

/-- One memory's writes as `FastWrite`s. -/
def FastWrite.ofMem (k : Nat) (lay : FastMem) : List (Nat × (Nat × Nat)) → List FastWrite
  | .nil => .nil
  | .cons w ws => .cons (FastWrite.mk k (FastMem.base lay) (FastMem.size lay) w.1 w.2.1 w.2.2) (FastWrite.ofMem k lay ws)

/-- Every memory's writes, in order. -/
def FastWrite.ofMems : Nat → List NetMem → List FastMem → List FastWrite
  | k, .cons m ms, .cons l ls => List.append (FastWrite.ofMem k l m.writes) (FastWrite.ofMems (Nat.succ k) ms ls)
  | _, _, _ => .nil

/-- the flat array's initial contents: each memory's words, then zeros up to its size -/
def FastSim.pad : Nat → List Nat → Array Nat → Array Nat
  | .zero, _, a => a
  | .succ k, .nil, a => FastSim.pad k .nil (Array.push a 0)
  | .succ k, .cons w ws, a => FastSim.pad k ws (Array.push a w)

/-- The flat array's initial contents: each memory's words, then zeros up to its size. -/
def FastSim.memInit : List NetMem → List FastMem → Array Nat → Array Nat
  | .cons m ms, .cons l ls, a => FastSim.memInit ms ls (FastSim.pad (FastMem.size l) m.init a)
  | _, _, a => a

/-- the nodes that read an input port (node `i`, port `k`) or a register (node `i`,
register `k`): written at the start of each cycle -/
inductive FastSlot where
  | mk (i k : Nat)

/-- a register: what it loads (`NetReg.load`), its reset and enable flattened -/
inductive FastReg where
  | plain (next : Nat)
  | en (next e : Nat)
  | rst (next r init : Nat)
  | both (next e r init : Nat)

/-- A register, with its reset and enable flattened into a constructor. -/
def FastReg.ofReg (r : NetReg) : FastReg := match r.rst, r.en with
  | .none, .none => FastReg.plain r.next
  | .none, .some e => FastReg.en r.next e
  | .some k, .none => FastReg.rst r.next k r.init
  | .some k, .some e => FastReg.both r.next e k r.init

/-- The netlist prepared: the instructions in order, the input and register slots, the
registers, the output nodes, and the node values before the first cycle (each
constant's value, 0 for the others: constants are never written again). -/
structure FastProg where
  code : List FastNode
  ins : List FastSlot
  regIns : List FastSlot
  regs : List FastReg
  outs : List Nat
  init : List Nat
  writes : List FastWrite

/-- sorting one node into the program (`acc` in reverse) -/
def FastSim.node (lay : List FastMem) (i : Nat) (n : SimNode) (acc : FastProg) : FastProg :=
  let ω a := Hdl.nthD 0 n.args 0;
  let ω b := Hdl.nthD 0 n.args 1;
  let ω c := Hdl.nthD 0 n.args 2;
  let ω p := Nat.pow 2 n.width;
  let ω m := p - 1;
  let ω op := fun (x : FastNode) => FastProg.mk (.cons x acc.code) acc.ins acc.regIns acc.regs acc.outs (.cons 0 acc.init) acc.writes;
  match n.op with
  | .input port => FastProg.mk acc.code (.cons (FastSlot.mk i port) acc.ins) acc.regIns acc.regs acc.outs (.cons 0 acc.init) acc.writes
  | .const v => FastProg.mk acc.code acc.ins acc.regIns acc.regs acc.outs (.cons v acc.init) acc.writes
  | .reg r => FastProg.mk acc.code acc.ins (.cons (FastSlot.mk i r) acc.regIns) acc.regs acc.outs (.cons 0 acc.init) acc.writes
  | .add => op (FastNode.add i a b m)
  | .sub => op (FastNode.sub i a b p m)
  | .mul => op (FastNode.mul i a b m)
  | .and => op (FastNode.and i a b)
  | .or => op (FastNode.or i a b)
  | .xor => op (FastNode.xor i a b)
  | .not => op (FastNode.not i a m)
  | .eq => op (FastNode.eq i a b)
  | .ult => op (FastNode.ult i a b)
  | .mux => op (FastNode.mux i a b c)
  | .concat => op (FastNode.concat i a b n.aux)
  | .slice lo => op (FastNode.slice i a lo m)
  | .resetTo v => op (FastNode.resetTo i a b v)
  | .hold => op (FastNode.hold i a b c)
  | .shl => op (FastNode.shl i a b n.width)
  | .lshr => op (FastNode.lshr i a b n.width)
  | .ashr => op (FastNode.ashr i a b n.width)
  | .slt => op (FastNode.slt i a b n.aux)
  | .memRead k => (match Hdl.nthD (FastMem.mk 0 0) lay k with
    | .mk base size => op (FastNode.memRead i a k base size))
  -- (vendor primitives, H14 P1: not in the fast simulation yet; such a netlist is not well
  -- formed here, so `simFast` falls back to `Netlist.simulate`)
  | .inst _ => FastProg.mk acc.code acc.ins acc.regIns acc.regs acc.outs (.cons 0 acc.init) acc.writes
  | .instOut _ _ => FastProg.mk acc.code acc.ins acc.regIns acc.regs acc.outs (.cons 0 acc.init) acc.writes
  | .clock _ => FastProg.mk acc.code acc.ins acc.regIns acc.regs acc.outs (.cons 0 acc.init) acc.writes

/-- Sort the nodes into the program, in order. -/
def FastSim.nodes (lay : List FastMem) : Nat → List SimNode → FastProg → FastProg
  | _, .nil, acc => acc
  | i, .cons n ns, acc => FastSim.nodes lay (Nat.succ i) ns (FastSim.node lay i n acc)

/-- A netlist prepared for the fast simulation. -/
def FastProg.ofNetlist (n : Netlist) : FastProg :=
  let ω lay := FastMem.layout 0 n.mems;
  let ω r := FastSim.nodes lay 0 (SimNode.ofNodes n.nodes Hdl.Vec.empty) (FastProg.mk .nil .nil .nil .nil .nil .nil .nil);
  FastProg.mk (Hdl.reverse r.code) (Hdl.reverse r.ins) (Hdl.reverse r.regIns) (Hdl.map FastReg.ofReg n.regs)
    (Hdl.map (fun (p : NetPort) => p.node) n.outputs) (Hdl.reverse r.init) (FastWrite.ofMems 0 n.mems lay)

------------------------------------------------------------------------------------
-- Well-formedness: what makes the array reads below the reads of `Netlist.simulate`.

/-- Whether every number of a list is below `k`. -/
def FastSim.allBelow (k : Nat) : List Nat → Bool
  | .nil => .true
  | .cons x xs => Bool.and (Nat.lt x k) (FastSim.allBelow k xs)

/-- Whether every node's arguments are earlier nodes, and the register and memory it reads
exist. -/
def FastSim.nodesOk (nregs nmems : Nat) : Nat → List NetNode → Bool
  | _, .nil => .true
  | k, .cons n ns => Bool.and (Bool.and (FastSim.allBelow k n.args) (match n.op with
      | .reg r => Nat.lt r nregs
      | .memRead m => Nat.lt m nmems
      | .inst _ => .false
      | .instOut _ _ => .false
      | .clock _ => .false
      | _ => .true)) (FastSim.nodesOk nregs nmems (Nat.succ k) ns)

/-- Whether every memory write reads earlier nodes. -/
def FastSim.writesOk (k : Nat) : List NetMem → Bool
  | .nil => .true
  | .cons m ms => Bool.and (FastSim.allBelow k (NetMem.reads m.writes)) (FastSim.writesOk k ms)

/-- Whether an optional number is below `k`. -/
def FastSim.optBelow (k : Nat) : Option Nat → Bool
  | .none => .true
  | .some x => Nat.lt x k

/-- Whether what every register loads (and its reset and enable) is an earlier node. -/
def FastSim.regsOk (k : Nat) : List NetReg → Bool
  | .nil => .true
  | .cons r rs => Bool.and (Bool.and (Nat.lt r.next k) (Bool.and (FastSim.optBelow k r.rst) (FastSim.optBelow k r.en)))
      (FastSim.regsOk k rs)

/-- Whether every port shows an earlier node. -/
def FastSim.portsOk (k : Nat) : List NetPort → Bool
  | .nil => .true
  | .cons p ps => Bool.and (Nat.lt p.node k) (FastSim.portsOk k ps)

/-- Node arguments refer to earlier nodes, register reads to registers, and what the
registers load and the outputs show to nodes; no vendor primitives (H14 P1: not
simulated here yet). -/
def Netlist.wellFormed (n : Netlist) : Bool :=
  let ω k := List.length n.nodes;
  Bool.and (FastSim.nodesOk (List.length n.regs) (List.length n.mems) 0 n.nodes)
    (Bool.and (FastSim.regsOk k n.regs) (Bool.and (FastSim.portsOk k n.outputs) (FastSim.writesOk k n.mems)))

------------------------------------------------------------------------------------
-- One cycle. `vals` holds a value per node, updated in place: the inputs and register
-- outputs first, then the instructions in order (arguments come first, so every node
-- is written in a cycle before it is read in it).

/-- The value at an index of the array (0 past the end). -/
def FastSim.get (a : Array Nat) (i : Nat) : Nat := Array.getD a i 0

/-- Whether a number is 0. -/
def FastSim.isZero (v : Nat) : Bool := Nat.beq v 0

/-- the formulas are `SimNode.eval`'s -/
def FastNode.exec (n : FastNode) (vals : Array Nat) : Array Nat := match n with
  | .add i a b m => Array.set vals i (Nat.land (FastSim.get vals a + FastSim.get vals b) m)
  | .sub i a b p m => Array.set vals i (Nat.land (FastSim.get vals a + p - FastSim.get vals b) m)
  | .mul i a b m => Array.set vals i (Nat.land (FastSim.get vals a * FastSim.get vals b) m)
  | .and i a b => Array.set vals i (Nat.land (FastSim.get vals a) (FastSim.get vals b))
  | .or i a b => Array.set vals i (Nat.lor (FastSim.get vals a) (FastSim.get vals b))
  | .xor i a b => Array.set vals i (Nat.xor (FastSim.get vals a) (FastSim.get vals b))
  | .not i a m => Array.set vals i (m - FastSim.get vals a)
  | .eq i a b => Array.set vals i (Nat.ofBool (Nat.beq (FastSim.get vals a) (FastSim.get vals b)))
  | .ult i a b => Array.set vals i (Nat.ofBool (Nat.lt (FastSim.get vals a) (FastSim.get vals b)))
  | .mux i a b c => Array.set vals i (match FastSim.isZero (FastSim.get vals a) with
    | .true => FastSim.get vals c
    | .false => FastSim.get vals b)
  | .concat i a b k => Array.set vals i (Nat.shiftLeft (FastSim.get vals a) k + FastSim.get vals b)
  | .slice i a k m => Array.set vals i (Nat.land (Nat.shiftRight (FastSim.get vals a) k) m)
  | .resetTo i a b k => Array.set vals i (match FastSim.isZero (FastSim.get vals a) with
    | .true => FastSim.get vals b
    | .false => k)
  | .hold i a b c => Array.set vals i (match FastSim.isZero (FastSim.get vals a) with
    | .true => FastSim.get vals c
    | .false => FastSim.get vals b)
  | .shl i a b w => Array.set vals i (Hdl.shlN w (FastSim.get vals a) (FastSim.get vals b))
  | .lshr i a b w => Array.set vals i (Hdl.lshrN w (FastSim.get vals a) (FastSim.get vals b))
  | .ashr i a b w => Array.set vals i (Hdl.ashrN w (FastSim.get vals a) (FastSim.get vals b))
  | .slt i a b w => Array.set vals i (Nat.ofBool (Hdl.sltN w (FastSim.get vals a) (FastSim.get vals b)))
  | .memRead _ _ _ _ _ => vals   -- run by `FastSim.run`, which has the memories

/-- a word of memory `k` (`Hdl.memGet`: absent words are 0) -/
def FastSim.memGet (mem : Array Nat) (over : HTrie Nat) (k base size a : Nat) : Nat :=
  match Nat.lt a size with
  | .true => FastSim.get mem (base + a)
  | .false => (match HTrie.get (.cons k (.cons a .nil)) over with
    | .some v => v
    | .none => 0)

/-- The instructions of one cycle, in order (a memory read needs the memories). -/
def FastSim.run (mem : Array Nat) (over : HTrie Nat) : List FastNode → Array Nat → Array Nat
  | .nil, vals => vals
  | .cons n ns, vals => match n with
    | .memRead i a k base size => FastSim.run mem over ns (Array.set vals i (FastSim.memGet mem over k base size (FastSim.get vals a)))
    | _ => FastSim.run mem over ns (FastNode.exec n vals)

/-- The memories at the clock edge: the enabled writes, in order (a later one wins; reads
in the cycle saw the old contents, and the netlist's bypass nodes the new word) -/
def FastSim.storeAll (vals : Array Nat) : List FastWrite → Array Nat → HTrie Nat → Array Nat × HTrie Nat
  | .nil, mem, over => (mem, over)
  | .cons (.mk k base size e a d) ws, mem, over => match FastSim.isZero (FastSim.get vals e) with
    | .true => FastSim.storeAll vals ws mem over
    | .false =>
      let ω addr := FastSim.get vals a;
      let ω v := FastSim.get vals d;
      (match Nat.lt addr size with
      | .true => FastSim.storeAll vals ws (Array.set mem (base + addr) v) over
      | .false => FastSim.storeAll vals ws mem (HTrie.put (.cons k (.cons addr .nil)) v over))

/-- the input ports' values (`Hdl.nthD 0`, as `SimNode.eval` reads them) -/
def FastSim.setIns (ins : List Nat) : List FastSlot → Array Nat → Array Nat
  | .nil, vals => vals
  | .cons (.mk i k) ss, vals => FastSim.setIns ins ss (Array.set vals i (Hdl.nthD 0 ins k))

/-- Write the register values into the slots that read them. -/
def FastSim.setRegs (regs : Array Nat) : List FastSlot → Array Nat → Array Nat
  | .nil, vals => vals
  | .cons (.mk i k) ss, vals => FastSim.setRegs regs ss (Array.set vals i (FastSim.get regs k))

/-- what a register loads (`NetReg.load`): `init` under reset, its own value without enable -/
def FastReg.load (vals : Array Nat) (r : FastReg) (cur : Nat) : Nat := match r with
  | .plain next => FastSim.get vals next
  | .en next e => (match FastSim.isZero (FastSim.get vals e) with
    | .true => cur
    | .false => FastSim.get vals next)
  | .rst next k init => (match FastSim.isZero (FastSim.get vals k) with
    | .true => FastSim.get vals next
    | .false => init)
  | .both next e k init => match FastSim.isZero (FastSim.get vals k) with
    | .true => (match FastSim.isZero (FastSim.get vals e) with
      | .true => cur
      | .false => FastSim.get vals next)
    | .false => init

/-- the registers' next values, written over their current ones (`regs` is unique) -/
def FastSim.loadAll (vals : Array Nat) : List FastReg → Nat → Array Nat → Array Nat
  | .nil, _, regs => regs
  | .cons r rs, k, regs =>
    let ω v := FastReg.load vals r (FastSim.get regs k);
    FastSim.loadAll vals rs (Nat.succ k) (Array.set regs k v)

/-- The values of the output nodes, in order. -/
def FastSim.outputs (vals : Array Nat) : List Nat → List Nat
  | .nil => .nil
  | .cons k ks => .cons (FastSim.get vals k) (FastSim.outputs vals ks)

/-- A list as an array. -/
def FastSim.ofList : List Nat → Array Nat → Array Nat
  | .nil, a => a
  | .cons x xs, a => FastSim.ofList xs (Array.push a x)

/-- the cycles: `vals` and `regs` are reused from cycle to cycle (overwritten in place) -/
def FastSim.go (p : FastProg) : Array Nat → Array Nat → HTrie Nat → Array Nat → List (List Nat) → List (List Nat) → List (List Nat)
  | _, _, _, _, .nil, acc => Hdl.reverse acc
  | regs, mem, over, vals, .cons ins rest, acc =>
    let ω vals2 := FastSim.run mem over p.code (FastSim.setRegs regs p.regIns (FastSim.setIns ins p.ins vals));
    let ω out := FastSim.outputs vals2 p.outs;
    let ω regs2 := FastSim.loadAll vals2 p.regs 0 regs;
    let ω m2 := FastSim.storeAll vals2 p.writes mem over;
    FastSim.go p regs2 m2.1 m2.2 vals2 rest (List.cons out acc)

/-- The cycles of the fast simulation (`vals` and `regs` are overwritten in place). -/
def Netlist.simFastGo (n : Netlist) (inputs : List (List Nat)) : List (List Nat) :=
  let ω p := FastProg.ofNetlist n;
  FastSim.go p (FastSim.ofList (Hdl.map (fun (r : NetReg) => r.init) n.regs) Array.empty)
    (FastSim.memInit n.mems (FastMem.layout 0 n.mems) Array.empty) HTrie.tip
    (FastSim.ofList p.init Array.empty) inputs List.nil

/-- = `Netlist.simulate n inputs` -/
def Netlist.simFast (n : Netlist) (inputs : List (List Nat)) : List (List Nat) :=
  match Netlist.wellFormed n with
  | .true => Netlist.simFastGo n inputs
  | .false => Netlist.simulate n inputs

------------------------------------------------------------------------------------
-- Circuits and designs: the value simulation on leaves, run on the netlist.
-- `Circuit.simFast c xs` is `Circuit.runLeaves c xs` (values in, one number per output
-- port per cycle out); `Design.simFast d xs` is `Design.runLeaves d xs` (one number per
-- input port per cycle in).

/-- `Circuit.runLeaves` run on the netlist: one number per output port per cycle. -/
def Circuit.simFast {ω i o : HwTy} (c : Circuit i o) (xs : List (HwTy.El i)) : List (List Nat) :=
  Netlist.simFast (Circuit.netlist "c" c) (Hdl.map (HwTy.leaves i) xs)

/-- `Design.runLeaves` run on the netlist: one number per input port per cycle. -/
def Design.simFast (d : Design) (xs : List (List Nat)) : List (List Nat) :=
  Netlist.simFast (Design.netlist d) xs
