import Hdl.Axi4
import Hdl.BusLaw
/-!
# Hdl.Axi4Law

The obligations of the AXI4 burst adapters in `Hdl.Axi4`, as Boolean checks over the
burst traces `examples/hdl-axi4.wiz` generates, in the style of `Hdl.BusLaw` and
`Hdl.ProtocolLaw`. The example (test group `bus-protocol`) evaluates every check on INCR
and WRAP bursts with a stalling bus slave, at the same time as it compares the value
simulation, `Netlist.simulate` and `Circuit.simFast`. They are **tested, not proved**;
only the small lemmas at the end are kernel-checked.

The laws, by obligation:

* **Legal bursts.** `Axi4.Law.legal`: `AxSIZE` fits the bus data width (`2^SIZE` bytes
  per beat) and a WRAP burst has 2, 4, 8 or 16 beats
  (`Axi4.legalWrap`, `Axi4.Law.legalLen`).
* **Address progression.** The `k`-th beat's address is `Axi4.beatAddr`: INCR adds
  `2^SIZE`, WRAP walks its aligned `(LEN + 1) * 2^SIZE` window and wraps at the end,
  FIXED holds the base. `Axi4.Law.addrsOk` checks that the bus addresses of a burst are
  exactly `Axi4.beatSeq`, and `Axi4.Law.WrBeatOk`/`RdBeatOk` check one beat at the
  adapter pins (address, data and byte strobes).
* **Beat count.** A burst has `LEN + 1` beats: `Axi4.Law.beatCountOk` on the number of
  bus beats (and the number of `W`/`R` beats). `WLAST`/`RLAST` are high exactly on beat
  `LEN` (`Axi4.Law.WLastOk`/`RLastOk`).
* **Write strobes.** Every `W` beat's `WSTRB` arrives unchanged on the bus request
  (`Axi4.Law.WrBeatOk`), one per beat, in order: no byte strobe is dropped or repeated
  under backpressure.
* **Response ordering and IDs.** `B` echoes the `AW` ID and `BRESP` is `SLVERR` exactly
  for a bus error; `R` echoes the `AR` ID, carries the bus data and `SLVERR`, and
  `RLAST` marks the last beat (`Axi4.Law.BRespOk`/`RRespOk`). With several IDs in flight
  the adapters are single outstanding: each response is the one to the burst at the head
  of the issue list, which the example checks (the general multi-ID completion order is
  modelled at values by `Axi4.orderOf`).
-/

------------------------------------------------------------------------------------
-- Views of the packed channels

/-- The write address fields of a packed `Axi4.Aw`. -/
def Axi4.Law.aw {ω aw idw : Nat} (x : HwTy.El (Axi4.Aw.code aw idw)) :
    Axi4.Aw aw idw HwTy.El := Axi4.Aw.unpack aw idw x
/-- The write data fields of a packed `Axi4.W`. -/
def Axi4.Law.w {ω dw : Nat} (x : HwTy.El (Axi4.W.code dw)) : Axi4.W dw HwTy.El :=
  Axi4.W.unpack dw x
/-- The write response fields of a packed `Axi4.B`. -/
def Axi4.Law.b {ω idw : Nat} (x : HwTy.El (Axi4.B.code idw)) : Axi4.B idw HwTy.El :=
  Axi4.B.unpack idw x
/-- The read address fields of a packed `Axi4.Ar`. -/
def Axi4.Law.ar {ω aw idw : Nat} (x : HwTy.El (Axi4.Ar.code aw idw)) :
    Axi4.Ar aw idw HwTy.El := Axi4.Ar.unpack aw idw x
/-- The read response fields of a packed `Axi4.R`. -/
def Axi4.Law.r {ω dw idw : Nat} (x : HwTy.El (Axi4.R.code dw idw)) :
    Axi4.R dw idw HwTy.El := Axi4.R.unpack dw idw x

/-- `AWVALID`. -/
def Axi4.Law.awValid {ω aw idw : Nat} (x : HwTy.El (Axi4.Aw.code aw idw)) : Bool :=
  Bus.Law.bit (Axi4.Law.aw x).valid
/-- `WVALID`. -/
def Axi4.Law.wValid {ω dw : Nat} (x : HwTy.El (Axi4.W.code dw)) : Bool :=
  Bus.Law.bit (Axi4.Law.w x).valid
/-- `WLAST`. -/
def Axi4.Law.wLast {ω dw : Nat} (x : HwTy.El (Axi4.W.code dw)) : Bool :=
  Bus.Law.bit (Axi4.Law.w x).last
/-- `BVALID`. -/
def Axi4.Law.bValid {ω idw : Nat} (x : HwTy.El (Axi4.B.code idw)) : Bool :=
  Bus.Law.bit (Axi4.Law.b x).valid
/-- `ARVALID`. -/
def Axi4.Law.arValid {ω aw idw : Nat} (x : HwTy.El (Axi4.Ar.code aw idw)) : Bool :=
  Bus.Law.bit (Axi4.Law.ar x).valid
/-- `RVALID`. -/
def Axi4.Law.rValid {ω dw idw : Nat} (x : HwTy.El (Axi4.R.code dw idw)) : Bool :=
  Bus.Law.bit (Axi4.Law.r x).valid
/-- `RLAST`. -/
def Axi4.Law.rLast {ω dw idw : Nat} (x : HwTy.El (Axi4.R.code dw idw)) : Bool :=
  Bus.Law.bit (Axi4.Law.r x).last

/-- A Boolean equality (`Bus.Law.bEq` is the library's). -/
def Axi4.Law.bEq (a b : Bool) : Bool := Bus.Law.bEq a b

------------------------------------------------------------------------------------
-- Legal bursts

/-- A burst is legal for a bus of `dw` data bits when `AxSIZE` fits the bus width
(`2^SIZE` bytes per beat) and a WRAP burst has 2, 4, 8 or 16 beats. -/
def Axi4.Law.legal (dw size len burst : Nat) : Bool :=
  Bool.and (Nat.le (Axi4.bytes size) (Nat.div dw 8))
    (Bool.or (Bool.not (Nat.beq burst Axi4.wrap)) (Axi4.legalWrap len))

/-- `LEN` is legal for the burst code: WRAP needs `LEN` 1, 3, 7 or 15. -/
def Axi4.Law.legalLen (len burst : Nat) : Bool :=
  Bool.or (Bool.not (Nat.beq burst Axi4.wrap)) (Axi4.legalWrap len)

------------------------------------------------------------------------------------
-- Address progression and beat count

/-- The Boolean form of address progression: the bus addresses are
`Axi4.beatSeq burst base size len`, in order. -/
def Axi4.Law.addrsOk (burst base size len : Nat) (addrs : List Nat) : Bool :=
  Hdl.natsEq addrs (Axi4.beatSeq burst base size len)

/-- The Boolean form of the beat count: a burst has `LEN + 1` beats. -/
def Axi4.Law.beatCountOk (len n : Nat) : Bool := Nat.beq n (Axi4.beats len)

------------------------------------------------------------------------------------
-- One beat at the adapter pins

/-- One write beat: the bus request is a write at the expected beat address, with the
`W` beat's data and byte strobes. This is the "no lost strobes" law at the pins. -/
def Axi4.Law.WrBeatOk {ω aw dw : Nat} (w : HwTy.El (Axi4.W.code dw))
    (q : HwTy.El (Bus.ReqW.code aw dw)) (addr : Nat) : Bool :=
  let x := Axi4.Law.w w;
  let y := Bus.Law.reqW q;
  Bool.and (BitVec.beq y.we (BitVec.ofNat 1 1))
    (Bool.and (Nat.beq (BitVec.toNat y.addr) addr)
      (Bool.and (BitVec.beq y.wdata x.data) (BitVec.beq y.wstrb x.strb)))

/-- One read beat: the bus request is a read at the expected beat address, with no
write data and no strobes. -/
def Axi4.Law.RdBeatOk {ω aw dw : Nat} (q : HwTy.El (Bus.ReqW.code aw dw)) (addr : Nat) : Bool :=
  let y := Bus.Law.reqW q;
  Bool.and (BitVec.beq y.we (BitVec.ofNat 1 0))
    (Bool.and (Nat.beq (BitVec.toNat y.addr) addr)
      (Bool.and (BitVec.beq y.wdata (BitVec.ofNat dw 0))
        (BitVec.beq y.wstrb (BitVec.ofNat (Nat.div dw 8) 0))))

/-- `WLAST` is high exactly on the last beat. -/
def Axi4.Law.WLastOk {ω dw : Nat} (w : HwTy.El (Axi4.W.code dw)) (last : Bool) : Bool :=
  Axi4.Law.bEq (Axi4.Law.wLast w) last

/-- `RLAST` is high exactly on the last beat. -/
def Axi4.Law.RLastOk {ω dw idw : Nat} (r : HwTy.El (Axi4.R.code dw idw)) (last : Bool) : Bool :=
  Axi4.Law.bEq (Axi4.Law.rLast r) last

/-- A `B` response belongs to the `AW` burst: the same ID, and `SLVERR` exactly when the
bus reported an error. -/
def Axi4.Law.BRespOk {ω aw idw : Nat} (aw : HwTy.El (Axi4.Aw.code aw idw))
    (b : HwTy.El (Axi4.B.code idw)) (err : Bool) : Bool :=
  let x := Axi4.Law.aw aw;
  let y := Axi4.Law.b b;
  let resp := if err then Axi4.slverr else Axi4.okay;
  Bool.and (BitVec.beq y.id x.id) (BitVec.beq y.resp (BitVec.ofNat Axi4.respW resp))

/-- An `R` beat belongs to the `AR` burst: the same ID, the bus data, `SLVERR` exactly on
a bus error, and the expected `RLAST`. -/
def Axi4.Law.RRespOk {ω aw dw idw : Nat} (ar : HwTy.El (Axi4.Ar.code aw idw))
    (r : HwTy.El (Axi4.R.code dw idw)) (data : Nat) (err last : Bool) : Bool :=
  let x := Axi4.Law.ar ar;
  let y := Axi4.Law.r r;
  let resp := if err then Axi4.slverr else Axi4.okay;
  Bool.and (BitVec.beq y.id x.id)
    (Bool.and (Nat.beq (BitVec.toNat y.data) data)
      (Bool.and (BitVec.beq y.resp (BitVec.ofNat Axi4.respW resp))
        (Axi4.Law.bEq (Bus.Law.bit y.last) last)))

-- The adapter is single outstanding, so a response belongs to the burst that is
-- currently in flight; `Axi4.Law.BRespOk`/`RRespOk` check that (the ID, data and code),
-- and the example also checks one `B` per write burst and one `R` list per read burst.

------------------------------------------------------------------------------------
-- Kernel-checked lemmas

/-- `Axi4.legalWrap` accepts the four AXI4 WRAP lengths. -/
def Axi4.Law.legalWrap_2 : Axi4.legalWrap 1 = .true := rfl
def Axi4.Law.legalWrap_4 : Axi4.legalWrap 3 = .true := rfl
def Axi4.Law.legalWrap_8 : Axi4.legalWrap 7 = .true := rfl
def Axi4.Law.legalWrap_16 : Axi4.legalWrap 15 = .true := rfl

/-- `Axi4.legalWrap` rejects a non-power-of-two length (5 beats). -/
def Axi4.Law.legalWrap_bad : Axi4.legalWrap 4 = .false := rfl

/-- A burst of `LEN = 0` has one beat; a beat is one byte at `SIZE = 0`. -/
def Axi4.Law.beats_zero : Axi4.beats 0 = 1 := rfl
def Axi4.Law.bytes_zero : Axi4.bytes 0 = 1 := rfl

/-- A quiet write address has `AWVALID` low. -/
def Axi4.Law.noAw_valid {ω aw idw : Nat} :
    (Axi4.noAw : Axi4.Aw aw idw HwTy.El).valid = BitVec.ofNat 1 0 := rfl

/-- The write adapter starts idle. -/
def Axi4.Law.wrInit_phase {ω aw dw idw : Nat} :
    (Axi4.wrInit aw dw idw).phase = BitVec.ofNat 2 0 := rfl

/-- The read adapter starts idle. -/
def Axi4.Law.rdInit_phase {ω aw dw idw : Nat} :
    (Axi4.rdInit aw dw idw).phase = BitVec.ofNat 2 0 := rfl

/-- `Axi4.respOfErr` is `OKAY` when the bus did not report an error. -/
def Axi4.Law.respOfErr_okay :
    Axi4.respOfErr (r := HwTy.El) (BitVec.ofNat 1 0) =
      BitVec.ofNat Axi4.respW Axi4.okay := rfl

/-- `Axi4.respOfErr` is `SLVERR` when the bus reported an error. -/
def Axi4.Law.respOfErr_err :
    Axi4.respOfErr (r := HwTy.El) (BitVec.ofNat 1 1) =
      BitVec.ofNat Axi4.respW Axi4.slverr := rfl
