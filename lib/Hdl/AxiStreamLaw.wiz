import Hdl.AxiStream
/-!
# Hdl.AxiStreamLaw

The obligations of the AXI4-Stream parts in `Hdl.AxiStream`, stated over value traces as
in `Hdl.BusLaw`, plus the small lemmas the HDL model can prove by computation.

The backpressure law is one rule and its three consequences:

* `AxiStream.Law.Stable`: while a beat is offered and not accepted (`tvalid` high,
  `tready` low), the whole source half of the beat is unchanged next cycle and `tvalid`
  stays high. This is the source's obligation.
* `AxiStream.Law.NoLoss`, `AxiStream.Law.NoDup` and `AxiStream.Law.Order`: the accepted
  payloads on the output are exactly the accepted payloads on the input — same number
  (no lost beat), each one once (no duplicated beat), in the same order.
* `AxiStream.Law.SliceNoLoss`: the register slice's accepted sequence is the input's
  accepted sequence, for any input/sink stall pattern. `AxiStream.Law.UpConvert` and
  `DownConvert` are the grouped-beat forms of the same statement for the width
  converters, in the fixed-group model documented in `Hdl.AxiStream`.

`examples/hdl-stream.wiz` evaluates the Boolean forms on generated source/sink, slice and
converter traces with a stalling sink, at the same time as it compares the value
simulation, `Netlist.simulate` and `Circuit.simFast`. They are **tested, not proved**;
the lemmas at the end are kernel-checked.
-/

------------------------------------------------------------------------------------
-- Views of the beat and the accepted-beat sequence

/-- `tvalid`. -/
def AxiStream.Law.valid {ω dw : Nat} (b : HwTy.El (AxiStream.Beat.code dw)) : Bool :=
  BitVec.isTrue (AxiStream.Beat.unpack dw b).tvalid
/-- `tready`. -/
def AxiStream.Law.ready {ω dw : Nat} (b : HwTy.El (AxiStream.Beat.code dw)) : Bool :=
  BitVec.isTrue (AxiStream.Beat.unpack dw b).tready
/-- `tlast`. -/
def AxiStream.Law.last {ω dw : Nat} (b : HwTy.El (AxiStream.Beat.code dw)) : Bool :=
  BitVec.isTrue (AxiStream.Beat.unpack dw b).tlast
/-- The beat is accepted this cycle: `tvalid && tready`. -/
def AxiStream.Law.fire {ω dw : Nat} (b : HwTy.El (AxiStream.Beat.code dw)) : Bool :=
  Bool.and (AxiStream.Law.valid b) (AxiStream.Law.ready b)

/-- The packed source half of a beat: `tdata`, `tlast`, `tkeep` and `tuser`, without the
handshake bits. Two beats have the same payload exactly when these encodings are equal. -/
def AxiStream.Law.payload {ω dw : Nat} (b : HwTy.El (AxiStream.Beat.code dw)) : Nat :=
  let x := AxiStream.Beat.unpack dw b;
  HwTy.pack (AxiStream.Tx.code dw) (AxiStream.Tx.pack dw
    (AxiStream.Tx.mk (dw := dw) (r := HwTy.El) x.tdata x.tvalid x.tlast x.tkeep x.tuser))

/-- The accepted payloads of a trace: one number per beat in a cycle with `tvalid` and
`tready` both high. This is the sequence a sink observes. -/
def AxiStream.Law.accepted {ω dw : Nat} :
    List (HwTy.El (AxiStream.Beat.code dw)) → List Nat
  | .nil => .nil
  | .cons b bs =>
    if AxiStream.Law.fire b then
      List.cons (AxiStream.Law.payload b) (AxiStream.Law.accepted bs)
    else AxiStream.Law.accepted bs

/-- The number of beats a sink accepted. -/
def AxiStream.Law.acceptedN {ω dw : Nat}
    (bs : List (HwTy.El (AxiStream.Beat.code dw))) : Nat :=
  List.length (AxiStream.Law.accepted bs)

/-- The Boolean form of the order law: the accepted payloads are equal. -/
def AxiStream.Law.acceptedEq {ω dw : Nat}
    (ins outs : List (HwTy.El (AxiStream.Beat.code dw))) : Bool :=
  BEq.beq (AxiStream.Law.accepted outs) (AxiStream.Law.accepted ins)

/-- The Boolean form of no lost/duplicated beats: the accepted counts are equal. -/
def AxiStream.Law.acceptedNOk {ω dw : Nat}
    (ins outs : List (HwTy.El (AxiStream.Beat.code dw))) : Bool :=
  Nat.beq (AxiStream.Law.acceptedN outs) (AxiStream.Law.acceptedN ins)

/-- The Boolean form of `Stable`: a stalled beat is the same beat next cycle. -/
def AxiStream.Law.StableStep {ω dw : Nat} (b b' : HwTy.El (AxiStream.Beat.code dw)) : Bool :=
  Bool.or (Bool.not (Bool.and (AxiStream.Law.valid b) (Bool.not (AxiStream.Law.ready b))))
    (Bool.and (AxiStream.Law.valid b')
      (Nat.beq (AxiStream.Law.payload b') (AxiStream.Law.payload b)))

------------------------------------------------------------------------------------
-- The laws, as predicates over traces

/-- The source holds a stalled beat: while `tvalid` is high and `tready` low, the whole
source half (and `tvalid`) is unchanged next cycle. -/
def AxiStream.Law.Stable {ω dw : Nat}
    (bs : Trace (HwTy.El (AxiStream.Beat.code dw))) : Prop :=
  (t : Nat) → (AxiStream.Law.valid (bs t) = .true ∧ AxiStream.Law.ready (bs t) = .false) →
    AxiStream.Law.payload (bs (Nat.succ t)) = AxiStream.Law.payload (bs t) ∧
    AxiStream.Law.valid (bs (Nat.succ t)) = .true

/-- No beat is lost: the output accepts as many beats as the input offered and accepted. -/
def AxiStream.Law.NoLoss {ω dw : Nat}
    (ins outs : List (HwTy.El (AxiStream.Beat.code dw))) : Prop :=
  Nat.le (AxiStream.Law.acceptedN ins) (AxiStream.Law.acceptedN outs) = .true

/-- No beat is duplicated: the accepted payloads are equal, so each occurs once. -/
def AxiStream.Law.NoDup {ω dw : Nat}
    (ins outs : List (HwTy.El (AxiStream.Beat.code dw))) : Prop :=
  Nat.le (AxiStream.Law.acceptedN outs) (AxiStream.Law.acceptedN ins) = .true

/-- Order is preserved: the accepted payload sequence is the same on both sides. -/
def AxiStream.Law.Order {ω dw : Nat}
    (ins outs : List (HwTy.El (AxiStream.Beat.code dw))) : Prop :=
  AxiStream.Law.accepted outs = AxiStream.Law.accepted ins

/-- The three halves together: the handshake's backpressure law. -/
def AxiStream.Law.Backpressure {ω dw : Nat}
    (ins outs : List (HwTy.El (AxiStream.Beat.code dw))) : Prop :=
  AxiStream.Law.NoLoss ins outs ∧ AxiStream.Law.NoDup ins outs ∧
  AxiStream.Law.Order ins outs

/-- The register slice preserves the accepted-beat sequence for any input and any sink
stall pattern. -/
def AxiStream.Law.SliceNoLoss {ω dw : Nat}
    (ins outs : List (HwTy.El (AxiStream.Beat.code dw))) : Prop :=
  AxiStream.Law.Backpressure ins outs

/-- The width converters preserve every payload bit, in the fixed-group model: the
accepted output payloads are the grouped input payloads (the example checks the exact
grouping; this predicate states that no group is dropped or repeated). -/
def AxiStream.Law.ConvertNoLoss {ω dw : Nat}
    (ins outs : List (HwTy.El (AxiStream.Beat.code dw))) : Prop :=
  AxiStream.Law.NoLoss ins outs ∧ AxiStream.Law.NoDup ins outs

------------------------------------------------------------------------------------
-- Kernel-checked lemmas

/-- Nothing is accepted from an empty trace. -/
def AxiStream.Law.accepted_nil {ω dw : Nat} :
    AxiStream.Law.accepted (dw := dw) [] = [] := rfl

/-- The keep of a byte-wide beat is one bit. -/
def AxiStream.Law.keepW_8 : AxiStream.keepW 8 = 1 := rfl

/-- The register slice starts empty. -/
def AxiStream.Law.sliceInit_valid {ω dw : Nat} :
    (AxiStream.sliceInit dw).valid = BitVec.ofNat 1 0 := rfl

/-- The source starts with `n` beats left. -/
def AxiStream.Law.sourceInit_left {ω n : Nat} :
    (AxiStream.sourceInit n).left = BitVec.ofNat 16 n := rfl

/-- The sink starts with no accepted beats. -/
def AxiStream.Law.sinkInit_count {ω dw : Nat} :
    (AxiStream.sinkInit dw).count = BitVec.ofNat 16 0 := rfl

/-- The upsize starts with no beats accumulated. -/
def AxiStream.Law.upInit_n {ω dw ratio : Nat} :
    (AxiStream.upInit dw ratio).n = BitVec.ofNat 16 0 := rfl

/-- The downsize starts idle. -/
def AxiStream.Law.downInit_active {ω dw ratio : Nat} :
    (AxiStream.downInit dw ratio).active = BitVec.ofNat 1 0 := rfl
