import IO
import Json
import Tagged
import Web.Highlight
import Web.InfoTree
import Web.Loom

/-!
# Web.Hover

The hover card: `textDocument/hover`'s Markdown as the lines the card shows, and the
`textDocument/definition` target as a label.

`web/hover.js` used to normalise the three LSP contents shapes, split fences and draw
each line with `textContent`; it is here now, as a pure view. The host keeps what needs a
browser: when to ask, the timers, the request generation and the card's position. The
card's markup is `Loom`'s, so a server's text is escaped by construction.
-/

/-- One card line: text (maybe code), a thematic rule, or the truncation ellipsis.
`tokens` are the line's highlight spans (UTF-16, from a `wizHighlight` answer or a
provider's own data); they are rendered by `Web.Highlight`, so the card and the docs
share the class table and the span assembler. -/
structure Hover.Line where
  text : String
  code : Bool
  rule : Bool
  ellipsis : Bool
  tokens : List Highlight.Token

/-- A plain line. -/
def Hover.textLine (s : String) : Hover.Line := Hover.Line.mk s .false .false .false []
/-- A code line. -/
def Hover.codeLine (s : String) : Hover.Line := Hover.Line.mk s .true .false .false []
/-- A code line with highlight spans. -/
def Hover.codeLineTokens (s : String) (ts : List Highlight.Token) : Hover.Line :=
  Hover.Line.mk s .true .false .false ts
/-- A horizontal rule. -/
def Hover.rule : Hover.Line := Hover.Line.mk "" .false .true .false []

/-- One LSP content part as `{kind, text, language}`; `kind` is `markdown` or
`plaintext`, `language` is the fence's tag when the part says it is code. -/
def Hover.part (p : Json) : Option (String × String × String) :=
  match p with
  | .str s => .some ("plaintext", s, "")
  | .obj _ =>
    let value := Json.getStr p "value";
    let kind := match String.eq (Json.getStr p "kind") "plaintext" with
      | .true => "plaintext"
      | .false => "markdown";
    let language := match Json.get p "language" with
      | .some (.str s) => s
      | _ => "";
    match String.isEmpty (String.trim value) with
    | .true => .none
    | .false => .some (kind, value, language)
  | _ => .none

/-- `Hover.part` on each element, dropping the ones with nothing to show. -/
def Hover.parts (ps : List Json) : List (String × String × String) :=
  match ps with
  | .nil => []
  | .cons p rest => match Hover.part p with
    | .none => Hover.parts rest
    | .some v => List.append [v] (Hover.parts rest)

/-- The parts of an LSP hover result, or `[]` when there is nothing to show. -/
def Hover.contents (result : Json) : List (String × String × String) :=
  let raw := match Json.get result "contents" with
    | .some c => c
    | .none => result;
  match raw with
  | .arr xs => Hover.parts (Jsons.toList xs)
  | _ => Hover.parts [raw]

/-- The single text lines of a hover result: fenced `{language, value}` parts get a
fence, so `Hover.lines` keeps them code; plain parts are paragraphs. -/
def Hover.textOf (result : Json) : Option String :=
  let ps := Hover.contents result;
  match ps with
  | .nil => .none
  | .cons _ _ =>
    let text := String.intercalate "\n\n" (List.map (fun p =>
      match String.isEmpty p.2.2 with
      | .true => String.trim p.2.1
      | .false => String.append "```" (String.append p.2.2
          (String.append "\n" (String.append (String.trimRight p.2.1) "\n```")))) ps);
    .some text

/-- Whether a line is a fence marker (returns its character: `` ` `` or `~`). -/
def Hover.fence (s : String) : Option Char :=
  let t := String.trimLeft s;
  match String.chars t with
  | .cons c rest => match Char.eq c (Char.mk 96) with
    | .true => .some c
    | .false => match Char.eq c (Char.mk 126) with
      | .true => .some c
      | .false => .none
  | _ => .none

/-- A Markdown thematic break (`---`, `***`, `___`). -/
def Hover.isRule (s : String) : Bool :=
  let t := String.trim s;
  match String.chars t with
  | .cons c rest =>
    let same := List.all (fun x => Char.eq x c) rest;
    Bool.and same (Bool.or (Nat.le 3 (String.length t))
      (Bool.or (Char.eq c (Char.mk 45)) (Bool.or (Char.eq c (Char.mk 42)) (Char.eq c (Char.mk 95)))))
  | _ => .false

/-- The characters of `s` after any run of `c` (a fence's marker run). -/
partial def Hover.dropMarker (c : Char) : List Char → List Char
  | .nil => .nil
  | .cons x xs => match Char.eq x c with
    | .true => Hover.dropMarker c xs
    | .false => .cons x xs

/-- The language word of a fence line (````wiz` → `wiz`; `~~~` → `""`). -/
def Hover.fenceLang (s : String) : String :=
  let t := String.trimLeft s;
  match String.chars t with
  | .cons c rest => String.trim (String.mk (Hover.dropMarker c rest))
  | .nil => ""

/-- What the line walker is inside: an open fence's marker, the index of the block being
read (the n-th fence of the hover), the number of fences opened, and the line's offset
in the block's source (UTF-16, for slicing the answer's `wizHighlight` spans). -/
structure Hover.LineState where
  marker : Option Char
  block : Nat
  fences : Nat
  offset : Nat

/-- Outside any fence. -/
def Hover.initialLines : Hover.LineState := Hover.LineState.mk .none 0 0 0

/-- Walk the hover's lines with the answer's `wizHighlight` blocks: a code line gets the
block's spans clipped to that line (`InfoTree.tokensForLine`), so the card renders the
same tokens the docs page does. `blocks` empty: plain code, exactly the old output. -/
partial def Hover.linesWithGo (blocks : List InfoTree.HighlightBlock) (st : Hover.LineState)
    (xs : List String) (acc : List Hover.Line) : List Hover.Line :=
  match xs with
  | .nil => List.reverse acc
  | .cons line rest =>
    let trimmed := String.trimRight line;
    match Hover.fence trimmed with
    | .some c =>
      match st.marker with
      | .none =>
        -- open a fence: its block index is the number opened before it
        Hover.linesWithGo blocks (Hover.LineState.mk (.some c) st.fences (st.fences + 1) 0) rest acc
      | .some open => match Char.eq c open with
        | .true => Hover.linesWithGo blocks (Hover.LineState.mk .none st.block st.fences 0) rest acc
        | .false =>
          let len := String.length trimmed;
          let ts := InfoTree.tokensForLine blocks st.block st.offset len;
          Hover.linesWithGo blocks { st with offset := st.offset + len + 1 } rest
            (List.append acc [Hover.codeLineTokens trimmed ts])
    | .none =>
      match st.marker with
      | .some _ =>
        let len := String.length trimmed;
        let ts := InfoTree.tokensForLine blocks st.block st.offset len;
        Hover.linesWithGo blocks { st with offset := st.offset + len + 1 } rest
          (List.append acc [Hover.codeLineTokens trimmed ts])
      | .none =>
        match Hover.isRule trimmed with
        | .true => Hover.linesWithGo blocks st rest (List.append acc [Hover.rule])
        | .false => match String.isEmpty trimmed with
          | .true => Hover.linesWithGo blocks st rest acc
          | .false => Hover.linesWithGo blocks st rest (List.append acc [Hover.textLine trimmed])

/-- The card's lines with highlight spans from the answer's `wizHighlight` blocks. -/
def Hover.linesWith (text : String) (limit : Nat)
    (blocks : List InfoTree.HighlightBlock) : List Hover.Line :=
  let all := Hover.linesWithGo blocks Hover.initialLines (String.splitOn text "\n") [];
  match Nat.le (List.length all) limit with
  | .true => all
  | .false => List.append (List.take (limit - 1) all) [Hover.Line.mk "…" .false .false .true []]

/-- The card's lines, without highlight spans (`Hover.linesWith` with no blocks). -/
def Hover.lines (text : String) (limit : Nat) : List Hover.Line :=
  Hover.linesWith text limit []

/-- A hexadecimal digit's value. -/
def Hover.hexVal (c : Char) : Option Nat :=
  let n := Char.code c;
  if Nat.le 48 n && Nat.le n 57 then .some (n - 48)
  else if Nat.le 65 n && Nat.le n 70 then .some (n - 55)
  else if Nat.le 97 n && Nat.le n 102 then .some (n - 87)
  else .none

/-- Decode a URI path's `%XX` bytes; a malformed escape is kept, and `+` stays (a path's
`+` is not a space, unlike a query component's). -/
partial def Hover.percentGo : List Char → List Char
  | .nil => .nil
  | .cons c cs =>
    if Nat.beq (Char.code c) 37 then
      match cs with
      | .cons a (.cons b rest) =>
        match Hover.hexVal a, Hover.hexVal b with
        | .some hi, .some lo => .cons (Char.mk (hi * 16 + lo)) (Hover.percentGo rest)
        | _, _ => .cons c (Hover.percentGo cs)
      | _ => .cons c (Hover.percentGo cs)
    else .cons c (Hover.percentGo cs)

def Hover.percentDecode (s : String) : String := .mk (Hover.percentGo (String.chars s))

/-- The path's last segment, for people (`file:///lib/Prelude.wiz` → `Prelude.wiz`).
A query string or fragment is not part of the name, and a percent-encoded name is
decoded (`My%20File.wiz` → `My File.wiz`), as the page's oracle does. -/
def Hover.documentName (uri : String) : String :=
  let noFragment := match String.splitOn uri "#" with
    | .cons h _ => h
    | _ => uri;
  let noQuery := match String.splitOn noFragment "?" with
    | .cons h _ => h
    | _ => noFragment;
  let parts := String.splitOn (Hover.percentDecode noQuery) "/";
  match List.reverse parts with
  | .cons name rest => match String.isEmpty name with
    | .true => "?"
    | .false => name
  | _ => "?"

/-- A definition target's range: `LINE:CHAR-LINE:CHAR`. -/
def Hover.rangeSpan (range : Json) : String :=
  let start := match Json.get range "start" with
    | .some s => s
    | .none => Json.mkNull;
  let stop := match Json.get range "end" with
    | .some e => e
    | .none => start;
  String.append (Nat.toString (Json.getNat start "line"))
    (String.append ":" (String.append (Nat.toString (Json.getNat start "character"))
      (String.append "-" (String.append (Nat.toString (Json.getNat stop "line"))
        (String.append ":" (Nat.toString (Json.getNat stop "character")))))))

/-- `uri` and its range as a span. -/
structure Hover.Target where
  uri : String
  range : String

/-- One `Location`/`LocationLink`. -/
def Hover.oneTarget (v : Json) : Option Hover.Target :=
  let uri := match Json.get v "uri" with
    | .some (.str s) => s
    | _ => match Json.get v "targetUri" with
      | .some (.str s) => s
      | _ => "";
  match String.isEmpty uri with
  | .true => .none
  | .false =>
    let range := match Json.get v "range" with
      | .some r => r
      | .none => match Json.get v "targetSelectionRange" with
        | .some r => r
        | .none => match Json.get v "targetRange" with
          | .some r => r
          | .none => Json.mkNull;
    match Json.get range "start" with
    | .none => .none
    | .some _ => .some (Hover.Target.mk uri (Hover.rangeSpan range))

/-- The usable targets, dropping the rest. -/
def Hover.oneTargets (xs : List Json) : List Hover.Target :=
  match xs with
  | .nil => []
  | .cons x rest => match Hover.oneTarget x with
    | .none => Hover.oneTargets rest
    | .some t => List.append [t] (Hover.oneTargets rest)

/-- A `textDocument/definition` result: the first usable location (the server ordered
them; the page has one editor). -/
def Hover.target (result : Json) : Option Hover.Target :=
  match result with
  | .arr xs => match Hover.oneTargets (Jsons.toList xs) with
    | .cons t _ => .some t
    | .nil => .none
  | _ => Hover.oneTarget result

/-- `file:line:col` for a target, 1-based. -/
def Hover.label (t : Hover.Target) : String :=
  let parts := String.splitOn t.range "-";
  let start := match parts with
    | .cons s _ => s
    | _ => t.range;
  let lc := String.splitOn start ":";
  let line := match lc with
    | .cons l _ => l
    | _ => "0";
  let col := match lc with
    | .cons _ (.cons c _) => c
    | _ => "0";
  String.append (Hover.documentName t.uri)
    (String.append ":" (String.append (Nat.toString (Nat.succ (match String.parseNat line with
      | .some n => n
      | .none => 0))) (String.append ":" (Nat.toString (Nat.succ (match String.parseNat col with
        | .some n => n
        | .none => 0))))))

/-- The `line,col` at one end of a `LINE:CHAR-LINE:CHAR` span. -/
def Hover.spanPair (s : String) : Nat × Nat :=
  let lc := String.splitOn s ":";
  let line := match lc with
    | .cons l _ => l
    | _ => "0";
  let col := match lc with
    | .cons _ (.cons c _) => c
    | _ => "0";
  let nLine := match String.parseNat line with
    | .some n => n
    | .none => 0;
  let nCol := match String.parseNat col with
    | .some n => n
    | .none => 0;
  (nLine, nCol)

/-- The start of a `LINE:CHAR-LINE:CHAR` span. -/
def Hover.spanStart (span : String) : Nat × Nat :=
  match String.splitOn span "-" with
  | .cons s _ => Hover.spanPair s
  | _ => Hover.spanPair span

/-- The end of a `LINE:CHAR-LINE:CHAR` span. -/
def Hover.spanEnd (span : String) : Nat × Nat :=
  match String.splitOn span "-" with
  | .cons _ (.cons e _) => Hover.spanPair e
  | _ => Hover.spanStart span

/-- A `textDocument/definition` result as
`{"uri", "range":{"start":{"line","character"},"end":{…}}, "label"}`, or `null`. This is
the page's whole rule for the answer: the first usable location, the range to select and
the label of a place the page cannot open. -/
def Hover.targetJson (result : String) : String :=
  match Json.parse result with
  | .ok j => match Hover.target j with
    | .some t =>
      let start := Hover.spanStart t.range;
      let stop := Hover.spanEnd t.range;
      Json.render (Json.mkObj
        [ ("uri", Json.mkStr t.uri)
        , ("range", Json.mkObj
            [ ("start", Json.mkObj
                [("line", Json.ofNat start.1), ("character", Json.ofNat start.2)])
            , ("end", Json.mkObj
                [("line", Json.ofNat stop.1), ("character", Json.ofNat stop.2)]) ])
        , ("label", Json.mkStr (Hover.label t))
        ])
    | .none => "null"
  | .error _ => "null"

/-- The card from its lines: the label (a definition's place, optionally) and the lines.
A code line's text goes through `Web.Highlight`, so a provider's spans use the docs'
eight classes and a bad span degrades to plain text instead of shifting the card. -/
def Hover.cardLines {M : Type} (lines : List Hover.Line) (label : String) : Loom.VNode M :=
  match Bool.and (List.isEmpty lines) (String.isEmpty label) with
  | .true => Loom.text ""
  | .false =>
    let head := match String.isEmpty label with
      | .true => []
      | .false => [Loom.el "div" [Loom.class "hover-head"] [Loom.text label]];
    let body := List.map (fun l => match l.rule with
      | .true => Loom.el "hr" [] []
      | .false => Loom.el "div" [Loom.class (String.append "hover-line"
          (String.append (match l.code with | .true => " code" | .false => "")
            (match l.ellipsis with | .true => " more" | .false => "")))]
        [Highlight.node l.text l.tokens]) lines;
    Loom.el "div" [Loom.id "wiz-hover", Loom.class "wiz-hover", Loom.attr "role" "tooltip"]
      (List.append head body)

/-- The card from the LSP's `contents` (the pre-`wiz.hover/1` path). -/
def Hover.cardContents {M : Type} (raw label : String) : Loom.VNode M :=
  let contents := match Json.parse raw with
    | .ok j => Hover.textOf j
    | .error _ => (.none : Option String);
  let lines := match contents with
    | .some text => Hover.lines text 24
    | .none => [];
  Hover.cardLines lines label

/-- The card: a `wiz.hover/1` payload when the result carries one (the Markdown comes
from the payload's own field ladder, and its `wizHighlight` blocks supply the code's
spans), else the LSP `contents` as before. `raw` is a hover result; an empty one draws
nothing unless there is a label. -/
def Hover.card {M : Type} (raw label : String) : Loom.VNode M :=
  match Json.parse raw with
  | .ok j => match InfoTree.Answer.ofJson j with
    | .some a => Hover.cardLines (Hover.linesWith (InfoTree.Answer.markdown a) 24 a.highlight) label
    | .none => Hover.cardContents raw label
  | .error _ => Hover.cardContents raw label
