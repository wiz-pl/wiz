import Web.Loom

/-!
# Web.Landing

The landing page's one interactive component: a quantity explorer. It is a
`Loom.LiveApp`: the state is which quantity is under discussion (0, 1 or ω), the
`change` event of a `<select>` chooses it, and the view renders all three panels every
time. CSS selects the visible panel from the root's class, so a state change is **one**
`setAttr "class"` on that root — no text patches, no node insertion, and the seeded
state is not re-rendered from data it already holds.

Three properties the page relies on:

* the first paint (`Landing.initial`) is the same tree the runtime exports as
  `wiz_loom_ssr_hash`, so `mount` adopts the server-rendered tree instead of replacing
  it (`docs/notes/loom-wire-protocol.md` §4);
* all three panels are in every render, so the no-JavaScript page is the whole
  explainer (the page's CSS hides the ones a live select did not choose);
* the `<select>` carries no `selected` attribute: the browser owns the control's live
  value, and a step must not patch it. The first option is the initial state.

The examples are the same three definitions `web/landing/snippets/quantities.wiz`
shows; that file is checked by `web/landing/test.sh`, and so is this module (the
landing page test renders it).
-/

/-- The one message: the select changed; the payload is its live value. -/
inductive Landing.Msg where
  | choose

/-- `q` is 0, 1 or 2 for quantities 0, 1 and ω. -/
structure Landing.State where
  q : Nat

/-- The first paint: quantity 0. -/
def Landing.initial : Landing.State := Landing.State.mk 0

/-- The root class of state `q`. One class attribute carries the whole selection; the
page's stylesheet (`web/landing/landing.css`) reads it. -/
def Landing.rootClass (q : Nat) : String :=
  if Nat.beq q 0 then "q-app q0"
  else if Nat.beq q 1 then "q-app q1"
  else "q-app qw"

/-- One quantity panel. All three are rendered; `data-for` names the quantity so the
stylesheet can show the selected one. -/
def Landing.panel (for_ title code note : String) : Loom.VNode Landing.Msg :=
  Loom.el "section" [Loom.class "q-panel", Loom.attr "data-for" for_]
    [ Loom.el "h4" List.nil [Loom.text title]
    , Loom.el "pre" [Loom.attr "tabindex" "0"]
        [Loom.el "code" [Loom.class "language-wiz"] [Loom.text code]]
    , Loom.el "p" List.nil [Loom.text note]
    ]

/-- An `<option>` with a value and a label. -/
def Landing.option (value label : String) : Loom.VNode Landing.Msg :=
  Loom.el "option" [Loom.attr "value" value] [Loom.text label]

/-- The view: the instruction, the select (CSS-hidden until the runtime mounts), and
the three panels. -/
def Landing.view (s : Landing.State) : Loom.VNode Landing.Msg :=
  Loom.el "div" [Loom.class (Landing.rootClass s.q), Loom.id "quantity-widget"]
    [ Loom.el "p" [Loom.class "q-intro"]
        [Loom.text "The same shape of definition under each quantity."]
    , Loom.el "div" [Loom.class "q-control"]
        [ Loom.el "label" [Loom.attr "for" "q-select"] [Loom.text "Quantity"]
        , Loom.on "change" Landing.Msg.choose
            (Loom.el "select" [Loom.id "q-select", Loom.attr "name" "quantity"]
              [ Landing.option "0" "0 — erased at run time"
              , Landing.option "1" "1 — used exactly once"
              , Landing.option "w" "ω — unrestricted" ])
        ]
    , Landing.panel "0" "0 — erased at run time"
        "def ignore {0 A : Type} (0 x : A) : Nat := 0"
        "The argument is absent from the compiled code: it may be a type, a proof, or an index, and the body cannot use it."
    , Landing.panel "1" "1 — used exactly once"
        "def identity {0 A : Type} (1 x : A) : A := x"
        "A linear value must be consumed once: a file handle, a token, or a proof that must not be duplicated or dropped."
    , Landing.panel "w" "ω — unrestricted"
        "def dup {0 A : Type} (ω x : A) : A × A := (x, x)"
        "Ordinary data is unrestricted: the body may use it any number of times, including twice in the same pair."
    ]

/-- The `change` payload is the select's live value (`0`, `1`, `w`); an unknown value
leaves the state alone. -/
def Landing.update (m : Landing.Msg) (payload : String) (s : Landing.State) : Landing.State :=
  match m with
  | .choose =>
    if String.eq payload "0" then { s with q := 0 }
    else if String.eq payload "1" then { s with q := 1 }
    else if String.eq payload "w" then { s with q := 2 }
    else s

/-- The app the page mounts. -/
def Landing.app : Loom.LiveApp Landing.State Landing.Msg :=
  Loom.LiveApp.mk Landing.initial Landing.update Landing.view
