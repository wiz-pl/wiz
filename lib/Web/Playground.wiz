import IO
import Text
import Json
import Web.Draft
import Web.Editor
import Web.Examples
import Web.Loom

/-!
# Web.Playground

The playground's output pane as a Loom app.

The pane is pure presentation. The page owns the editor and the Wasm engine; it hands
the engine's text to `Model.ofText` (a run) or `Model.ofFailure` (an exit, abort or
trap) and renders the result. Nothing here calls the engine, so the component renders
and diffs without WebAssembly (`web/playground_loom_gen.wiz` drives it under
`web/playground_loom_test.mjs`).

`Line.kind` is the CSS class the page already uses: `err` for an error line, `val` for a
kernel value (`val raw` when `renderValue` does not know its shape). The value grammar
(`web/framework/values.mjs`, the test oracle) lives here now, so a line's kind is decided
in one place; the JavaScript module is only the corpus's reference.
-/

/-- One output line: the engine's text, the classes the page adds, what the line shows
(a value's friendly form) and its tooltip (the raw text of a value). -/
structure Line where
  text : String
  kind : String
  shown : String
  title : String

/-- The pane's state: the lines, how many of them are errors, the page's status pair
(`setStatus(text, kind)`), and the `#count` text (the page writes `exit code 3` there
for a failure instead of a line count). -/
structure Model where
  lines : List Line
  failures : Nat
  status : String
  statusKind : String
  count : String

/-- The pane has no events yet. The clear control is the first one it will gain; the
run and the engine stay on the page's side because they are effects. -/
inductive PlaygroundMsg where
  | clear

def Model.empty : Model := Model.mk List.nil 0 "" "" "0 lines"

def nonEmpty (s : String) : Bool :=
  match String.isEmpty s with
  | .true => .false
  | .false => .true

def isErr (l : Line) : Bool :=
  match String.eq l.kind "err" with
  | .true => .true
  | .false => .false

-- ## Kernel values (`web/framework/values.mjs`, ported)
--
-- `#eval` prints the kernel's normal form: the runtime's tagged values, e.g.
-- `con((#1, (con((#0, (tt, tt))), (tt, tt))))` for 1. The page used to parse that shape in
-- JavaScript (`isValue`, `renderValue`); the pane's classification is here now, so a
-- line's kind is decided in one place. The JavaScript module is still the oracle:
-- `web/playground_loom_gen.wiz` carries a corpus and `web/playground_loom_test.mjs`
-- compares the two.

/-- A value as the runtime prints it: `tt`, a tag `#n`, or a pair. -/
inductive PlaygroundValue where
  | tt
  | tag (n : Nat)
  | pair (a b : PlaygroundValue)

/-- Skip the white space the printer may put between tokens (space, newline, tab). -/
def PlaygroundValue.skip : List Char → List Char
  | .nil => .nil
  | .cons c rest => match Char.isSpace c with
    | .true => PlaygroundValue.skip rest
    | .false => .cons c rest

/-- Whether `p` is a prefix of `s`. -/
def PlaygroundValue.isPrefix (p s : List Char) : Bool :=
  match p, s with
  | .nil, _ => .true
  | .cons _ _, .nil => .false
  | .cons pc ps, .cons sc ss => match Char.eq pc sc with
    | .true => PlaygroundValue.isPrefix ps ss
    | .false => .false

/-- The decimal digits at the front of `cs`, with the rest. -/
partial def PlaygroundValue.digits (n : Nat) (cs : List Char) : Nat × List Char :=
  match cs with
  | .nil => (n, .nil)
  | .cons c rest => match Char.isDigit c with
    | .true => PlaygroundValue.digits (n * 10 + (Char.code c - 48)) rest
    | .false => (n, cs)

/-- Parse one value at the front of `cs`: `tt`, `#n`, `(a, b)`, or `con(v)` (which is just
`v`). Mirrors `parse` in `web/framework/values.mjs`. -/
partial def PlaygroundValue.at (cs : List Char) : Option (PlaygroundValue × List Char) :=
  let s := PlaygroundValue.skip cs;
  match PlaygroundValue.isPrefix (String.chars "con(") s with
  | .true => match PlaygroundValue.at (List.drop 4 s) with
    | .none => .none
    | .some p => match PlaygroundValue.skip p.2 with
      | .nil => .none
      | .cons c rest => match Char.eq c (Char.mk 41) with
        | .true => .some (p.1, rest)
        | .false => .none
  | .false => match PlaygroundValue.isPrefix (String.chars "tt") s with
    | .true => .some (PlaygroundValue.tt, List.drop 2 s)
    | .false => match s with
      | .nil => .none
      | .cons c rest => match Char.eq c (Char.mk 35) with
        | .true => match rest with
          | .nil => .none
          | .cons d _ => match Char.isDigit d with
            | .true => let p := PlaygroundValue.digits 0 rest; .some (PlaygroundValue.tag p.1, p.2)
            | .false => .none
        | .false => match Char.eq c (Char.mk 40) with
          | .true => match PlaygroundValue.at rest with
            | .none => .none
            | .some a => match PlaygroundValue.skip a.2 with
              | .nil => .none
              | .cons comma r => match Char.eq comma (Char.mk 44) with
                | .true => match PlaygroundValue.at r with
                  | .none => .none
                  | .some b => match PlaygroundValue.skip b.2 with
                    | .nil => .none
                    | .cons close r2 => match Char.eq close (Char.mk 41) with
                      | .true => .some (PlaygroundValue.pair a.1 b.1, r2)
                      | .false => .none
                | .false => .none
          | .false => .none

/-- A whole string as one value (nothing but white space after it). -/
def PlaygroundValue.whole (s : String) : Option PlaygroundValue :=
  match PlaygroundValue.at (String.chars s) with
  | .none => .none
  | .some p => match PlaygroundValue.skip p.2 with
    | .nil => .some p.1
    | .cons _ _ => .none

/-- The fields of a constructor's payload, `(f1, (f2, … (tt, tt)))`; `(tt, tt)` is none. -/
partial def PlaygroundValue.fields (v : PlaygroundValue) (acc : List PlaygroundValue) : Option (List PlaygroundValue) :=
  match v with
  | .pair a b => match a, b with
    | .tt, .tt => .some (List.reverse acc)
    | _, _ => PlaygroundValue.fields b (.cons a acc)
  | _ => .none

/-- `con((#tag, payload))` as the tag and its fields. -/
def PlaygroundValue.con (v : PlaygroundValue) : Option (Nat × List PlaygroundValue) :=
  match v with
  | .pair a b => match a with
    | .tag n => match PlaygroundValue.fields b List.nil with
      | .some fs => .some (n, fs)
      | .none => .none
    | _ => .none
  | _ => .none

/-- A Nat: a chain of `succ` (tag 1, one field) to `zero` (tag 0, no fields). -/
partial def PlaygroundValue.nat (v : PlaygroundValue) : Option Nat :=
  match PlaygroundValue.con v with
  | .none => .none
  | .some c => match Nat.beq c.1 0 with
    | .true => match c.2 with
      | .nil => .some 0
      | .cons _ _ => .none
    | .false => match Nat.beq c.1 1 with
      | .true => match c.2 with
        | .nil => .none
        | .cons f rest => match rest with
          | .nil => match PlaygroundValue.nat f with
            | .some n => .some (n + 1)
            | .none => .none
          | .cons _ _ => .none
      | .false => .none

mutual
/-- A list: `nil` (tag 0, no fields; only inside a list) or `cons` (tag 1, two fields). -/
partial def PlaygroundValue.list (nested : Bool) (v : PlaygroundValue) : Option (List String) :=
  match PlaygroundValue.con v with
  | .none => .none
  | .some c => match Nat.beq c.1 0 with
    | .true => match c.2 with
      | .nil => match nested with
        | .true => .some List.nil
        | .false => .none
      | .cons _ _ => .none
    | .false => match Nat.beq c.1 1 with
      | .true => match c.2 with
        | .nil => .none
        | .cons head rest => match rest with
          | .nil => .none
          | .cons tail more => match more with
            | .nil => match PlaygroundValue.elem head with
              | .none => .none
              | .some h => match PlaygroundValue.list .true tail with
                | .none => .none
                | .some t => .some (.cons h t)
            | .cons _ _ => .none
      | .false => .none

/-- One element of a list: a positive Nat, `true`, or a nested list. -/
partial def PlaygroundValue.elem (v : PlaygroundValue) : Option String :=
  match PlaygroundValue.nat v with
  | .some n => match Nat.beq n 0 with
    | .true => PlaygroundValue.elemOther v
    | .false => .some (Nat.toString n)
  | .none => PlaygroundValue.elemOther v

/-- The fallbacks of `PlaygroundValue.elem`: a `true`, then a nested list. -/
partial def PlaygroundValue.elemOther (v : PlaygroundValue) : Option String :=
  match PlaygroundValue.con v with
  | .some c => match Nat.beq c.1 1 with
    | .true => match c.2 with
      | .nil => .some "true"
      | .cons _ _ => PlaygroundValue.elemList v
    | .false => PlaygroundValue.elemList v
  | .none => PlaygroundValue.elemList v

partial def PlaygroundValue.elemList (v : PlaygroundValue) : Option String :=
  match PlaygroundValue.list .true v with
  | .none => .none
  | .some xs => .some (String.append "[" (String.append (String.intercalate ", " xs) "]"))
end

/-- `renderValue`'s last fallback: a list (where `nil` alone is not enough: it looks like
`false` and `0`). -/
def renderList (v : PlaygroundValue) : Option String :=
  match PlaygroundValue.list .false v with
  | .none => .none
  | .some xs => .some (String.append "[" (String.append (String.intercalate ", " xs) "]"))

/-- `renderValue`'s first fallbacks: a `true`, then a list. -/
def renderOther (v : PlaygroundValue) : Option String :=
  match PlaygroundValue.con v with
  | .some c => match Nat.beq c.1 1 with
    | .true => match c.2 with
      | .nil => .some "true"
      | .cons _ _ => renderList v
    | .false => renderList v
  | .none => renderList v

/-- The display text for one output line, or `none` to show it as it came (the page's
`renderValue`). -/
def renderValue (line : String) : Option String :=
  match PlaygroundValue.whole line with
  | .none => .none
  | .some v => match PlaygroundValue.nat v with
    | .some n => match Nat.beq n 0 with
      | .true => renderOther v
      | .false => .some (Nat.toString n)
    | .none => renderOther v

/-- Lines that are a kernel value rather than a definition or an error. -/
def isValue (line : String) : Bool := String.startsWith line "con("


/-- `line`, plus `err`/`val` when the line has a kind (the page sets `line` and adds
the kind separately). -/
def Line.cls (l : Line) : String :=
  match String.isEmpty l.kind with
  | .true => "line"
  | .false => String.append "line " l.kind

/-- An output line, classified the way the page's `line()` does: `error:` and
`parse error` are `err`; a kernel value (`con(…)`) is `val` with its friendly form when
`renderValue` knows it (`val raw` otherwise); everything else is plain text. -/
def Line.ofText (text : String) : Line :=
  match String.startsWith text "error:" with
  | .true => Line.mk text "err" text ""
  | .false =>
    match String.startsWith text "parse error" with
    | .true => Line.mk text "err" text ""
    | .false => match isValue text with
      | .true => match renderValue text with
        | .some shown => Line.mk text "val" shown text
        | .none => Line.mk text "val raw" text text
      | .false => Line.mk text "" text ""

/-- A line's attributes: its class, and the raw text as the tooltip of a value line. -/
def Line.attrs (l : Line) : List Loom.Attr :=
  match String.isEmpty l.title with
  | .true => [Loom.class (Line.cls l)]
  | .false => [Loom.class (Line.cls l), Loom.attr "title" l.title]

/-- The non-empty lines of `text`, classified. -/
def linesOf (text : String) : List Line :=
  List.map Line.ofText (List.filter nonEmpty (String.splitOn text "\n"))

def countOf (ls : List Line) : Nat :=
  List.length (List.filter isErr ls)

/-- The `#count` text, exactly what the page writes today: `3 lines`, or
`3 lines · 1 error`. -/
def plainCount (ls : List Line) (failures : Nat) : String :=
  let n := List.length ls;
  let base := String.append (Nat.toString n) (match Nat.beq n 1 with
    | .true => " line"
    | .false => " lines");
  match Nat.beq failures 0 with
  | .true => base
  | .false => String.append base (String.append " · " (String.append (Nat.toString failures)
      (match Nat.beq failures 1 with
        | .true => " error"
        | .false => " errors")))

/-- A run that produced output. `status`/`kind` are the page's `setStatus` pair. -/
def Model.ofText (text : String) (status : String) (kind : String) : Model :=
  let ls := linesOf text;
  let f := countOf ls;
  Model.mk ls f status kind (plainCount ls f)

/-- A run that ended in the engine guard: its lines, the page's status, and the count
the page shows instead of a line count (`exit code 3`, or the failure's kind). -/
def Model.ofFailure (text : String) (status : String) (count : String) (kind : String) : Model :=
  let ls := linesOf text;
  Model.mk ls (countOf ls) status kind count

def Line.view {M : Type} (l : Line) : Loom.VNode M :=
  Loom.el "div" (Line.attrs l) [Loom.text l.shown]

/-- The pane: the page's `#output` element, one `.line` div per line. -/
def Model.view {M : Type} (s : Model) : Loom.VNode M :=
  Loom.el "div"
    [Loom.class "output", Loom.attr "id" "output", Loom.attr "aria-live" "polite"]
    (List.map Line.view s.lines)

/-- SSR of the pane at `s`, and its patches between two states. The app exists so
that the pane can be mounted through the same driver as any other Loom page once the
playground serves it from its own Wasm instance. -/
def app : Loom.App Model PlaygroundMsg := Loom.App.mk Model.empty
  (fun _ s => s)
  Model.view

-- ## The page (the whole playground as one Loom app)

/-- The page's state: the editor component, the output pane's model (which owns
`#status`'s text and kind and `#count`), the footer's engine line, the example the
editor holds, the transient note beside the status, and the **effect requests** the
page cannot do itself.

The runtime is pure, so a step cannot run the engine, write `localStorage` or touch
`history`. Instead it increments a counter and `Page.requests` turns the non-zero ones
into a JSON list of `{kind, payload}`; `web/framework/mount.js` hands each to the page's
`onRequest`, and the page acknowledges it with `wiz_loom_effect "ack"` after doing it.
`loads` is a run, `save` a file download, `share` a copied link, and `sync` the URL
fragment and the localStorage draft (the state format is `Web.Draft`'s, the storage and
`history` calls are the host's). -/
structure Page where
  editor : WebEditor
  output : Model
  engine : String
  preset : String
  loads : Nat
  save : Nat
  share : Nat
  sync : Nat
  note : String

/-- The first paint: the default example in the editor, the examples menu on it,
"loading the engine…", Run disabled, an empty count. -/
def Page.initial : Page :=
  Page.mk (WebEditor.initial (Examples.codeOf Examples.defaultExampleId))
    (Model.mk List.nil 0 "loading the engine…" "running" "")
    "engine: loading" Examples.defaultExampleId 0 0 0 0 ""

def Page.setEditor (s : Page) (e : WebEditor) : Page := { s with editor := e }

/-- The output pane's model, and the editor's `#count` text (the pane owns the count;
the editor shows it). -/
def Page.setOutput (s : Page) (o : Model) : Page :=
  { s with editor := WebEditor.withCount s.editor o.count, output := o }

def Page.setEngine (s : Page) (engine : String) : Page := { s with engine := engine }

/-- `setStatus(text, kind)`, the page's status line. -/
def Page.status (s : Page) (text kind : String) : Page :=
  let o := s.output;
  Page.setOutput s (Model.mk o.lines o.failures text kind o.count)

/-- Run on or off (the page while the engine loads and while a run is in flight). -/
def Page.enable (s : Page) (on : Bool) : Page :=
  Page.setEditor s (WebEditor.withDisabled s.editor (match on with | .true => .false | .false => .true))

/-- An effect request: its name and whatever the page needs to carry out (`""` when
the state has everything). -/
def Page.requestJson (kind payload : String) : Json :=
  Json.mkObj [("kind", Json.mkStr kind), ("payload", Json.mkStr payload)]

/-- The program as the state format sees it. -/
def Page.stateOf (s : Page) : Draft.State :=
  Draft.State.mk s.editor.text s.preset

/-- The requests the page must service now, as JSON: `[{"kind":"run","payload":""}, …]`
in request order. A counter stays non-zero until the page's `ack` effect clears it, so
a request that arrives while one is in flight is still visible after the first. -/
def Page.requests (s : Page) : String :=
  if Nat.beq s.loads 0 && Nat.beq s.save 0 && Nat.beq s.share 0 && Nat.beq s.sync 0 then "[]"
  else
    let st := Page.stateOf s;
    let fragment := Draft.encodeFragment st;
    let draft := Draft.serializeDraft st;
    let syncPayload := Json.render (Json.mkObj
      [("draft", Json.mkStr draft), ("fragment", Json.mkStr fragment)]);
    let reqs :=
      (if Nat.lt 0 s.loads then [Page.requestJson "run" ""] else [])
      ++ (if Nat.lt 0 s.save then [Page.requestJson "save" (Draft.withPrelude s.editor.text)] else [])
      ++ (if Nat.lt 0 s.share then [Page.requestJson "share" fragment] else [])
      ++ (if Nat.lt 0 s.sync then [Page.requestJson "sync" syncPayload] else []);
    Json.render (Json.mkArr reqs)

/-- Clear a serviced request (`wiz_loom_effect "ack"`). -/
def Page.ack (s : Page) (kind : String) : Page :=
  if String.eq kind "run" then { s with loads := 0 }
  else if String.eq kind "save" then { s with save := 0 }
  else if String.eq kind "share" then { s with share := 0 }
  else if String.eq kind "sync" then { s with sync := 0 }
  else s

/-- Note something for the page's short-lived message (`#note`). -/
def Page.noteWith (s : Page) (text : String) : Page := { s with note := text }

/-- The state changed: ask the page to write the draft and the URL fragment. -/
def Page.touch (s : Page) : Page := { s with sync := s.sync + 1 }

/-- Ask the page to run the program, unless Run is disabled (the engine is loading or a
run is in flight). -/
def Page.requestRun (s : Page) : Page :=
  match s.editor.disabled with
  | .true => s
  | .false => { s with loads := s.loads + 1 }

/-- Empty the output pane (the count goes back to `0 lines`; the status is the page's). -/
def Page.clearOutput (s : Page) : Page :=
  Page.setOutput s (Model.ofText "" s.output.status s.output.statusKind)

/-- Load example `id`: the editor's text becomes its program and the output pane is
emptied (the page runs it). An unknown id changes nothing. -/
def Page.loadExample (s : Page) (id : String) : Page :=
  match Examples.exampleOf id with
  | .none => s
  | .some e =>
    let s1 := Page.clearOutput s;
    let s2 := Page.setEditor s1 (WebEditor.withText s1.editor e.code);
    Page.touch { s2 with preset := id, loads := s2.loads + 1 }

/-- A run that finished: its output, classified, and the page's status text (`done in
12 ms`). The kind is the output's: an error line makes it `error`, as the page's
`errorCount` did. -/
def Page.finished (s : Page) (text status : String) : Page :=
  let bad := countOf (linesOf text);
  let kind := match Nat.beq bad 0 with
    | .true => "ready"
    | .false => "error";
  Page.setOutput s (Model.ofText text status kind)

/-- A run that ended in the engine guard: its lines, the status `failed`, and the count
text the page shows instead of a line count (`exit code 3`, or the failure's kind). -/
def Page.failed (s : Page) (text count : String) : Page :=
  Page.setOutput s (Model.ofFailure text "failed" count "error")

/-- The editor's text replaced (a share link or the initial program). -/
def Page.setText (s : Page) (text : String) : Page :=
  Page.setEditor s (WebEditor.withText s.editor text)

/-- Restore the default example and empty the output (`Reset`). -/
def Page.reset (s : Page) : Page :=
  let d := Draft.defaultState;
  let s1 := Page.setEditor s (WebEditor.withText s.editor d.code);
  let s2 := Page.clearOutput s1;
  Page.touch { s2 with preset := d.preset, note := "reset to the default program" }

/-- The state from a URL fragment and a draft, in that order: the fragment wins, then
the draft, then the default example (the static page's `initPageState`). -/
def Page.load (s : Page) (hash draft : String) : Page :=
  let fromUrl := Draft.decodeFragment hash;
  let initial := match fromUrl with
    | .some st => st
    | .none => match Draft.parseDraft draft with
      | .some st => st
      | .none => Draft.defaultState;
  let s1 := Page.setEditor s (WebEditor.withText s.editor initial.code);
  let s2 := Page.clearOutput s1;
  let s3 := Page.touch { s2 with preset := initial.preset };
  match fromUrl with
  | .some _ => Page.noteWith s3 "loaded the program from the link"
  | .none => match String.isEmpty hash with
    | .true => s3
    | .false => Page.noteWith s3 "ignored an invalid playground link"

/-- The page's effects (`wiz_loom_effect`), one typed entry point instead of one export
per effect: the engine's result, the status, Run's state, the footer, the editor's text,
the initial state and the request acknowledgement. -/
def Page.effect (s : Page) (kind a b : String) : Page :=
  if String.eq kind "finished" then Page.finished s a b
  else if String.eq kind "failed" then Page.failed s a b
  else if String.eq kind "status" then Page.status s a b
  else if String.eq kind "enable" then Page.enable s (String.eq a "1")
  else if String.eq kind "engine" then Page.setEngine s a
  else if String.eq kind "text" then Page.setText s a
  else if String.eq kind "note" then Page.noteWith s a
  else if String.eq kind "load" then Page.load s a b
  else if String.eq kind "ack" then Page.ack s a
  else s

/-- The page's messages: the editor's own, the examples menu's (`preset`, whose payload
is the chosen id), and the toolbar's Share, Save, Reset and Clear. -/
inductive PageMsg where
  | editor (m : WebEditor.Msg)
  | preset
  | share
  | save
  | reset
  | clear
  | key

/-- An example's `<option>` attributes: its id, and `selected` when it is the current one. -/
def Page.exampleAttrs (current : String) (e : Examples.Example) : List Loom.Attr :=
  match String.eq current e.id with
  | .true => [Loom.attr "value" e.id, Loom.attr "selected" "selected"]
  | .false => [Loom.attr "value" e.id]

/-- A keydown payload is the key, then its modifiers after a newline (`Enter\nc` for
Ctrl+Enter, `s\ncm` for ⌘+S); with no modifier it is the key alone. (A key is never a
newline.) -/
def Page.splitKey (payload : String) : String × String :=
  match String.splitOn payload "\n" with
  | .cons key (.cons mods _) => (key, mods)
  | .cons key .nil => (key, "")
  | .nil => ("", "")

/-- Whether the key's modifiers include Ctrl or ⌘. -/
def Page.command (mods : String) : Bool :=
  String.contains mods "c" || String.contains mods "m"

/-- The keyboard policy: Ctrl/⌘+Enter runs, Ctrl/⌘+S saves. Every other key is the
page's (it types, moves the caret, …) and the runtime does not consume it. -/
def Page.key (s : Page) (payload : String) : Page :=
  let p := Page.splitKey payload;
  if Page.command p.2 then
    if String.eq p.1 "Enter" then Page.requestRun s
    else if String.eq p.1 "s" then Page.touch { s with save := s.save + 1 }
    else s
  else s

/-- What the driver asks after a handled `Loom.onPrevent` event: did the runtime consume
the default action? Only the two shortcuts above do, so typing is never swallowed. -/
def Page.consume (e : Loom.Event) (_s : Page) : Bool :=
  match String.eq e.name "keydown" with
  | .false => .false
  | .true =>
    let p := Page.splitKey e.payload;
    Page.command p.2 && (String.eq p.1 "Enter" || String.eq p.1 "s")

/-- The menu's "Custom program" option: selected when the text is no example exactly
(`preset` is `""`), and not loadable. -/
def Page.customOption (current : String) : Loom.VNode PageMsg :=
  let attrs := match String.isEmpty current with
    | .true => [Loom.attr "value" "", Loom.attr "selected" "selected", Loom.attr "disabled" "disabled"]
    | .false => [Loom.attr "value" "", Loom.attr "disabled" "disabled"];
  Loom.el "option" attrs [Loom.text "Custom program"]

/-- One toolbar button, with its id (the static page's) and its message. -/
def Page.button (id label : String) (msg : PageMsg) : Loom.VNode PageMsg :=
  Loom.on "click" msg
    (Loom.el "button" [Loom.id id, Loom.class "small", Loom.attr "type" "button"]
      [Loom.text label])

/-- The toolbar: the examples menu (`change` carries the chosen id), then Share, Save,
Reset and Clear. Every control is the runtime's; the page services the requests. -/
def Page.toolbar (s : Page) : Loom.VNode PageMsg :=
  Loom.el "div" [Loom.class "toolbar", Loom.attr "role" "group",
      Loom.attr "aria-label" "Program actions"]
    [ Loom.el "label" [Loom.class "select-label", Loom.attr "for" "preset"]
        [Loom.text "Example"]
    , Loom.on "change" PageMsg.preset
        (Loom.el "select" [Loom.id "preset", Loom.attr "aria-label" "Load an example"]
          (List.cons (Page.customOption s.preset)
            (List.map (fun e => Loom.el "option" (Page.exampleAttrs s.preset e) [Loom.text e.title])
              Examples.examples)))
    , Page.button "share" "Share" PageMsg.share
    , Page.button "save" "Save" PageMsg.save
    , Page.button "reset" "Reset" PageMsg.reset
    , Page.button "clear" "Clear" PageMsg.clear
    ]

def Page.header (s : Page) : Loom.VNode PageMsg :=
  Loom.el "header" List.nil
    [ Loom.el "div" [Loom.class "brand"]
        [ Loom.el "a" [Loom.class "home", Loom.attr "href" "../"] [Loom.text "← Wiz"]
        , Loom.el "strong" List.nil [Loom.text "Playground"]
        , Loom.el "span" [Loom.class "dim"]
            [Loom.text "the self-hosted checker, compiled to WebAssembly — goals from an optional language server"]
        , Loom.el "nav" [Loom.class "pagenav", Loom.attr "aria-label" "Site"]
            [Loom.el "a" [Loom.attr "href" "../docs/"] [Loom.text "Docs"]]
        ]
    , Page.toolbar s
    , Loom.el "div" [Loom.class "meta"]
        [ Loom.el "span" [Loom.id "status", Loom.class (String.append "status " s.output.statusKind),
            Loom.attr "role" "status"] [Loom.text s.output.status]
        , Loom.el "span" [Loom.id "note"] [Loom.text s.note] ]
    ]

/-- The goals pane's heading and hint (the text is the pane's, unchanged). -/
def Page.goalsHead : Loom.VNode PageMsg :=
  Loom.el "div" [Loom.class "pane-head"]
    [ Loom.el "span" List.nil [Loom.text "Goals"]
    , Loom.el "span" [Loom.class "hint"]
        [Loom.text "from ", Loom.el "code" List.nil [Loom.text "?lsp=ws://host:port"]] ]

def Page.outputHead : Loom.VNode PageMsg :=
  Loom.el "div" [Loom.class "pane-head"]
    [ Loom.el "span" List.nil [Loom.text "Output"]
    , Loom.el "span" [Loom.class "hint"]
        [Loom.text "one line per command; ", Loom.el "code" List.nil [Loom.text "#eval"],
         Loom.text " is the kernel's normal form"] ]

def Page.main (s : Page) : Loom.VNode PageMsg :=
  Loom.onPrevent "keydown" PageMsg.key
    (Loom.el "main" List.nil
      [ Loom.mapMsg PageMsg.editor (WebEditor.view s.editor)
      , Loom.el "section" [Loom.class "pane side"]
          [ Page.goalsHead
          , Loom.el "div" [Loom.id "goals", Loom.class "goals", Loom.attr "tabindex" "0",
              Loom.attr "aria-live" "polite"] List.nil
          , Page.outputHead
          , Model.view s.output
          ]
      ])

def Page.footer (s : Page) : Loom.VNode PageMsg :=
  Loom.el "footer" List.nil
    [ Loom.el "span" [Loom.id "engine", Loom.class "dim"] [Loom.text s.engine]
    , Loom.el "span" [Loom.class "dim"]
        [Loom.text "A definition prints its signature, ",
         Loom.el "code" List.nil [Loom.text "#check"],
         Loom.text " a type, ", Loom.el "code" List.nil [Loom.text "#eval"],
         Loom.text " a value (shown raw if it is not a Nat, Bool or list)."] ]

/-- The whole page: one app, three top-level siblings (a body's children). -/
def Page.view (s : Page) : Loom.VNode PageMsg :=
  Loom.seq [Page.header s, Page.main s, Page.footer s]

/-- The page's update: the editor's messages go to the editor (an input also asks for a
draft/URL sync, a Run request asks the page to run), a preset load replaces the text,
and the toolbar's buttons are requests or state changes. -/
def Page.update (m : PageMsg) (payload : String) (s : Page) : Page :=
  match m with
  | .editor em => match em with
    | .input =>
      let e := WebEditor.update em payload s.editor;
      Page.touch { s with editor := e, preset := Draft.matchedPresetId payload }
    | .run =>
      let s1 := { s with editor := WebEditor.update em payload s.editor };
      Page.requestRun s1
  | .preset => Page.loadExample s payload
  | .share => Page.touch { s with share := s.share + 1 }
  | .save => Page.touch { s with save := s.save + 1 }
  | .reset => Page.reset s
  | .clear => Page.clearOutput s
  | .key => Page.key s payload

/-- The playground page as a `Loom.LiveApp`: the textarea's `input` carries the text, the
examples menu's `change` carries the chosen id. -/
def pageApp : Loom.LiveApp Page PageMsg :=
  Loom.LiveApp.mk Page.initial Page.update Page.view
