-- test: run
-- NOTE: `e2e-egraph.expected` was written from the checked-in corpus goldens and
-- the contracts below, not copied from a completed run. The first live run was
-- blocked before it reached the test (missing tree-sitter-c-sharp out-link), so
-- treat the expected file as a contract until the scry goldens job has compared
-- it. Do not mark this case as verified in a report before then.
import Sys
import Json
import Text

-- `scry egraph`: the e-graph driver, end to end on `fixtures/egraph-const.c`.
--
-- The human report is the deterministic fold/rewrite log; `--json` is
-- `scry-egraph-report/1`; `--sarif OUT` writes the rewrites as SARIF `note` results.
-- Exit statuses: 0 clean, 1 `--fail-on-rewrite` with a rewrite applied, 2 usage/IO,
-- 3 nothing analysed (a file with no function).

def check (label : String) (ok : Bool) : EIO Unit :=
  EIO.lift (match ok with
    | .true => IO.println (label ++ ": ok")
    | .false => IO.bind (IO.println (label ++ ": FAILED"))
        (fun _ => Process.exit 1))

structure Res where
  code : Nat
  out : String
  err : String

def run (args : List String) : EIO Res := do
  out ← Process.output ".grail/bin/scry" args "";
  let code := match out.status with
    | .exited n => n
    | .signaled _ => 99;
  EIO.pure (Res.mk code out.stdout out.stderr)

partial def jAt (j : Json) (path : List String) : Json :=
  match path with
  | .nil => j
  | .cons k rest => match Json.get j k with
    | .some x => jAt x rest
    | .none => Json.mkNull

def jNat (j : Json) (path : List String) : Nat :=
  match jAt j path with
  | .int _ n => n
  | _ => 0

def jStr (j : Json) (path : List String) : String :=
  match jAt j path with
  | .str s => s
  | _ => ""

def jList (j : Json) (path : List String) : List Json :=
  match jAt j path with
  | .arr xs => Jsons.toList xs
  | _ => .nil

def nthJ : List Json → Nat → Json
  | .nil, _ => Json.mkNull
  | .cons x _, .zero => x
  | .cons _ xs, .succ k => nthJ xs k

def parseJson (label text : String) : EIO Json :=
  match Json.parse text with
  | .ok j => EIO.pure j
  | .error e => do
    check (label ++ ": JSON parses (" ++ e ++ ")") .false;
    EIO.pure Json.mkNull

def firstLine (s : String) : String :=
  match String.splitOn s "\n" with
  | .cons l _ => l
  | .nil => ""

def readText (p : String) : EIO (Except String String) := do
  ok ← EIO.lift (FS.exists p);
  match ok with
  | .false => EIO.pure (.error ("no such file: " ++ p))
  | .true => do
    t ← FS.readFile p;
    EIO.pure (.ok t)

def main : IO Unit := EIO.toIO (do
  bin ← EIO.lift (FS.exists ".grail/bin/scry");
  match bin with
  | .false => EIO.lift (IO.println "e2e-egraph: skip (.grail/bin/scry absent)")
  | .true => do
    dir ← FS.createTempDir;
    let sarif := Path.join dir "egraph.sarif";

    -- 1. the read-only report: JSON schema and the deterministic counts
    r0 ← run ["egraph", "fixtures/egraph-const.c", "--json", "--sarif", sarif];
    j0 ← parseJson "report" r0.out;
    check "report: exit 0" (Nat.beq r0.code 0);
    check "report: schema scry-egraph-report/1"
      (String.eq (jStr j0 ["schema"]) "scry-egraph-report/1");
    check "report: kind egraph" (String.eq (jStr j0 ["kind"]) "egraph");
    check "report: one function" (Nat.beq (jNat j0 ["functions"]) 1);
    check "report: 11 statements" (Nat.beq (jNat j0 ["statements"]) 11);
    check "report: 13 e-classes" (Nat.beq (jNat j0 ["eclasses"]) 13);
    check "report: 28 e-nodes" (Nat.beq (jNat j0 ["enodes"]) 28);
    check "report: 2 rewrite steps" (Nat.beq (jNat j0 ["rewrites"]) 2);
    check "report: stop fixpoint" (String.eq (jStr j0 ["stop"]) "fixpoint");
    check "report: a 4-entry rewrite log" (Nat.beq (List.length (jList j0 ["log"])) 4);
    check "report: the first entry is the fold"
      (String.eq (jStr (nthJ (jList j0 ["log"]) 0) ["rule"]) "fold");

    -- 2. the same fixture in human mode keeps its first line
    r1 ← run ["egraph", "fixtures/egraph-const.c"];
    check "human: exit 0" (Nat.beq r1.code 0);
    check "human: the report names the file"
      (String.eq (firstLine r1.out) "egraph: fixtures/egraph-const.c");

    -- 3. the gate: --fail-on-rewrite is 1 when a rewrite was applied
    r2 ← run ["egraph", "fixtures/egraph-const.c", "--json",
      "--fail-on-rewrite"];
    check "gate: --fail-on-rewrite exits 1" (Nat.beq r2.code 1);

    -- 4. --rewrite: the checked extraction back to Wil
    r3 ← run ["egraph", "fixtures/egraph-const.c", "--rewrite", "--json"];
    j3 ← parseJson "rewrite" r3.out;
    check "rewrite: exit 0" (Nat.beq r3.code 0);
    check "rewrite: the extract object is present"
      (Nat.lt 0 (jNat j3 ["extract", "rewritten"]));
    check "rewrite: the report is the same deterministic graph"
      (Nat.beq (jNat j3 ["eclasses"]) 13);

    -- 5. statuses: usage/IO 2, nothing analysed 3
    r4 ← run ["egraph"];
    check "usage: no file exits 2" (Nat.beq r4.code 2);
    check "usage: the error names the usage"
      (String.startsWith (firstLine r4.err) "scry: usage: scry egraph");
    r5 ← run ["egraph", "fixtures/does-not-exist.c"];
    check "IO: a missing file exits 2" (Nat.beq r5.code 2);
    r6 ← run ["egraph", "fixtures/empty.c", "--json"];
    j6 ← parseJson "nothing" r6.out;
    check "nothing: a file with no function exits 3" (Nat.beq r6.code 3);
    check "nothing: the JSON says 0 functions" (Nat.beq (jNat j6 ["functions"]) 0);

    -- 6. SARIF: one note per applied rewrite
    readOut ← readText sarif;
    match readOut with
    | .error e => check ("sarif: read (" ++ e ++ ")") .false
    | .ok text => match Json.parse text with
      | .error e => check ("sarif: parses (" ++ e ++ ")") .false
      | .ok j => do
        let run0 := nthJ (jList j ["runs"]) 0;
        check "sarif: version 2.1.0" (String.eq (jStr j ["version"]) "2.1.0");
        check "sarif: driver scry"
          (String.eq (jStr run0 ["tool", "driver", "name"]) "scry");
        check "sarif: one note per log entry"
          (Nat.beq (List.length (jList run0 ["results"])) 4);
        check "sarif: every result is a rewrite note"
          (List.all (fun r => Bool.and
            (String.eq (jStr r ["ruleId"]) "scry/egraph/rewrite")
            (String.eq (jStr r ["level"]) "note")) (jList run0 ["results"])));

    FS.removeAll dir)
