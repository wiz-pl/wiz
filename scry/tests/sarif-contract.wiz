-- test: run
import Sys
import Json
import Scry.Sarif
import Scry.Rules
import Scry.Budget
-- The industrial SARIF output contract (`wiz-notes/sota-program-analysis.md` R6/R7).
--
-- One case per field:
--   partialFingerprints.scry/v1                  the line-independent semantic id
--   partialFingerprints.primaryLocationLineHash  GitHub's cross-run key, from
--                                                Scry.lineHash when the line text is known
--   codeFlows.threadFlows.locations              the source -> sink chain, every step
--   nestingLevel/executionOrder                  call depth and render order
--   relatedLocations                             unchanged: the steps before the sink
--   invocations.executionSuccessful              true only for a complete run
--   invocations.toolExecutionNotifications       one per scry/budget/* note
--
-- The last group is the "deliberate truncation" case: a run with a real finding, no
-- boundary warning and no other visible trouble. Without the run-level notification it
-- is indistinguishable from a complete run; the test asserts the notice is there, the
-- finding is unchanged, and a budget note passed as a boundary result is promoted too.

def check (label : String) (ok : Bool) : EIO Unit :=
  EIO.lift (match ok with
    | .true => IO.println (label ++ ": ok")
    | .false => IO.bind (IO.println (label ++ ": FAILED"))
        (fun _ => Process.exit 1))

partial def jAt (j : Json) (path : List String) : Json :=
  match path with
  | .nil => j
  | .cons k rest => match Json.get j k with
    | .some x => jAt x rest
    | .none => Json.mkNull

def jNat (j : Json) (path : List String) : Nat :=
  match jAt j path with
  | .int _ n => n
  | _ => 0

def jStr (j : Json) (path : List String) : String :=
  match jAt j path with
  | .str s => s
  | _ => ""

def jBool (j : Json) (path : List String) : Bool :=
  match jAt j path with
  | .bool b => b
  | _ => .false

def jList (j : Json) (path : List String) : List Json :=
  match jAt j path with
  | .arr xs => Jsons.toList xs
  | _ => .nil

def nthJ (xs : List Json) (i : Nat) : Json := Scry.nthD Json.mkNull xs i

def runOf (j : Json) : Json := nthJ (Json.getList j "runs") 0

def resultOf (j : Json) : Json := nthJ (Json.getList (runOf j) "results") 0

def invocationOf (j : Json) : Json := nthJ (Json.getList (runOf j) "invocations") 0

def mkOrigin (func : String) (point line col : Nat) : Scry.OriginEntry :=
  Scry.OriginEntry.mk func point (Scry.Origin.mk "demo.c" line col line (Nat.add col 1))

def origins : Scry.OriginMap :=
  [ mkOrigin "main" 1 3 3
  , mkOrigin "main" 2 5 3
  , mkOrigin "callee" 3 10 3
  , mkOrigin "callee" 4 11 3 ]

def path : List Scry.PathNode :=
  [ Scry.PathNode.mk "main" 1 0 .source
  , Scry.PathNode.mk "main" 2 0 .call
  , Scry.PathNode.mk "callee" 3 0 .param
  , Scry.PathNode.mk "callee" 4 0 .sink ]

def finding : Scry.RuleFinding :=
  Scry.RuleFinding.mk "command-injection" .error "attacker data reaches system" .taint
    "callee" 4 "system" 0 path

def pack : Scry.RulePack :=
  Scry.RulePack.mk
    [ .taint (Scry.TaintRule.mk "command-injection" .error
        "attacker data reaches system" [] []
        [Scry.RuleSink.mk "system" (.one 0)]) ]

def parseOk (label : String) (text : String) : EIO Json :=
  match Json.parse text with
  | .ok j => EIO.pure j
  | .error e => EIO.fail (label ++ " does not parse: " ++ e)

/-- The primary line of the sink (`demo.c:11`, `system(buf);`), as a provider would
return it. -/
def lineAt : Scry.LineTextAt := fun uri line =>
  match Bool.and (String.eq uri "demo.c") (Nat.beq line 11) with
  | .true => .some "  system(buf);  "
  | .false => .none

def main : IO Unit := EIO.toIO (do
  let text := Scry.renderSarifWith "scry" origins pack [(finding, .true)] .nil;
  j ← parseOk "complete run" text;
  let res := resultOf j;
  let inv := invocationOf j;

  -- partialFingerprints, both keys
  check "fingerprints: scry/v1 is the semantic id"
    (String.eq (jStr res ["partialFingerprints", "scry/v1"])
      (Scry.semanticId finding "demo.c"));
  check "fingerprints: primaryLocationLineHash is present"
    (Nat.lt 0 (String.length (jStr res ["partialFingerprints", "primaryLocationLineHash"])));
  check "fingerprints: without line text the semantic id is the fallback"
    (String.eq (jStr res ["partialFingerprints", "primaryLocationLineHash"])
      (Scry.semanticId finding "demo.c"));

  let textL := Scry.renderSarifWithLines "scry" origins pack
    [Scry.SarifFinding.mk finding .true .none] .nil lineAt;
  jL ← parseOk "line-text run" textL;
  check "fingerprints: with line text the value is Scry.lineHash"
    (String.eq (jStr (resultOf jL) ["partialFingerprints", "primaryLocationLineHash"])
      (Scry.lineHash finding "  system(buf);  "));

  -- codeFlows: the source -> sink chain
  let flows := jList res ["codeFlows"];
  check "codeFlows: one flow" (Nat.beq (List.length flows) 1);
  let threads := jList (nthJ flows 0) ["threadFlows"];
  check "codeFlows: one thread flow" (Nat.beq (List.length threads) 1);
  let steps := jList (nthJ threads 0) ["locations"];
  check "codeFlows: one location per path step" (Nat.beq (List.length steps) 4);
  check "codeFlows: every step has a physical location"
    (List.all (fun s => Nat.lt 0 (jNat s ["location", "physicalLocation", "region", "startLine"])) steps);
  check "codeFlows: the last step is the sink"
    (Nat.beq (jNat (nthJ steps 3) ["location", "physicalLocation", "region", "startLine"]) 11);
  check "codeFlows: nestingLevel is 1 inside the callee"
    (Bool.and (Nat.beq (jNat (nthJ steps 0) ["nestingLevel"]) 0)
      (Nat.beq (jNat (nthJ steps 2) ["nestingLevel"]) 1));
  check "codeFlows: executionOrder is 1..n"
    (Bool.and (Nat.beq (jNat (nthJ steps 0) ["executionOrder"]) 1)
      (Nat.beq (jNat (nthJ steps 3) ["executionOrder"]) 4));

  -- relatedLocations is unchanged by codeFlows: the path before the sink
  check "relatedLocations: still the three steps before the sink"
    (Nat.beq (List.length (jList res ["relatedLocations"])) 3);

  -- the complete run's invocation
  check "run: complete executionSuccessful is true"
    (jBool inv ["executionSuccessful"]);
  check "run: complete has no notifications"
    (Nat.beq (List.length (jList inv ["toolExecutionNotifications"])) 0);
  check "run: complete truncated flag is false"
    (Bool.not (jBool inv ["properties", "truncated"]));

  -- deliberate truncation: a real finding and no other sign of trouble
  let notes := Scry.Budget.terminationNotes (Scry.Termination.rounds 2 2);
  let textT := Scry.renderSarifPartialWith "scry" origins pack [(finding, .true)] .nil notes;
  jT ← parseOk "truncated run" textT;
  let invT := invocationOf jT;
  let resT := resultOf jT;
  check "run: truncation has one budget note" (Nat.beq (List.length notes) 1);
  check "run: truncation sets executionSuccessful false"
    (Bool.not (jBool invT ["executionSuccessful"]));
  check "run: truncation sets the truncated flag"
    (jBool invT ["properties", "truncated"]);
  check "run: truncation has one run-level notification"
    (Nat.beq (List.length (jList invT ["toolExecutionNotifications"])) 1);
  check "run: the notification names the budget rule"
    (String.eq (jStr (nthJ (jList invT ["toolExecutionNotifications"]) 0)
      ["descriptor", "id"]) "scry/budget/max-rounds");
  check "run: the notification carries the reason"
    (String.contains (jStr (nthJ (jList invT ["toolExecutionNotifications"]) 0)
      ["message", "text"]) "max-rounds");
  check "truncation: the finding is unchanged"
    (Bool.and
      (Nat.beq (List.length (jList (runOf jT) "results"))
        (List.length (jList (runOf j) "results")))
      (String.eq (jStr resT ["ruleId"]) (jStr res ["ruleId"])));

  -- the existing CLI shape: the note arrives as an extra boundary result
  let budgetResult := Scry.boundaryResultJson "scry/budget/max-rounds" .none "main" 0
    "stopped after 2 round(s) at --max-rounds 2";
  let textA := Scry.renderSarifWith "scry" origins pack [(finding, .true)] [budgetResult];
  jA ← parseOk "promoted run" textA;
  let invA := invocationOf jA;
  check "run: a budget boundary result is promoted to a notification"
    (Bool.and (Bool.not (jBool invA ["executionSuccessful"]))
      (Nat.beq (List.length (jList invA ["toolExecutionNotifications"])) 1)));
  check "run: promotion does not add a result"
    (Nat.beq (List.length (jList (runOf jA) "results")) 2);
  check "run: promotion leaves the finding's rule id alone"
    (String.eq (jStr (resultOf jA) ["ruleId"]) "scry/c/command-injection")
)
