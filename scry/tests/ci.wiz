-- test: run
import Sys
import Scry.Cli
-- End to end: the CI frontend over the four fixtures. The first command analyses both
-- unsafe files together (a GitHub workflow and an Azure pipeline: one cross-platform
-- report); the second prints the graph summary of the safe GitHub workflow, whose
-- findings are empty. `grail build` runs the same commands as the `ci` and `ci-store`
-- targets.
def main : IO Unit := do
  r1 ← Scry.dispatch ["ci", "fixtures/ci/gh-unsafe.yml", "fixtures/ci/azure-unsafe.yml"];
  r2 ← Scry.dispatch ["ci-store", "fixtures/ci/gh-safe.yml"];
  Process.exit 0
