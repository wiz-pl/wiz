-- test: run
import Scry.NativeLink
import Sys
import Text
import Json
import Scry.Project
import Scry.ProjectIO
import Scry.ProjectTaint
import Scry.ProjectCache
import Scry.Preproc
import Scry.TaintCmd
-- Multi-file project driver tests:
--
-- * compile-database parsing (`arguments` vs `command`, flag filtering, and the
--   preprocessor allowlist that refuses `-B`/`-fplugin`/`@file` by name);
-- * shared-header dedupe, the static-symbol qualification, duplicate and unresolved
--   policy;
-- * cross-TU taint (a source in app.c reaching a sink in io.c), per-file counts and
--   checked certificates;
-- * SARIF `artifacts` with relative URIs, `%SRCROOT%`, and an index on every result;
-- * the per-TU parse cache: cold, warm, a changed declaration, and a corrupt entry;
-- * the per-TU lowering cache: cold/warm Wil equality, a changed header/macro, a header
--   comment (same preprocessed text, new origins), corrupt/truncated entries, and a key
--   that differs only in the unit target.
--
-- `cc` must be on PATH (the same requirement as `scry project` itself).

def check (label : String) (ok : Bool) : EIO Unit :=
  EIO.lift (match ok with
    | .true => IO.println (label ++ ": ok")
    | .false => IO.bind (IO.ePrintln (label ++ ": FAILED"))
        (fun _ => Process.exit 1))

def build (dir : String) (cache : Scry.CacheOpts) :
    EIO (Scry.Project × Scry.CacheStats) :=
  Scry.ProjectIO.buildProject dir .none "cc" .true .false .false .nil cache

def buildSkip (dir : String) : EIO (Scry.Project × Scry.CacheStats) :=
  Scry.ProjectIO.buildProject dir .none "cc" .true .false .true .nil Scry.CacheOpts.none

def reportOf (dir : String) (cache : Scry.CacheOpts) :
    EIO (Scry.ProjectReport × Scry.CacheStats) := do
  r ← build dir cache;
  pack ← Scry.loadTaintPack .none;
  EIO.pure (Scry.analyzeProject r.1 pack r.2, r.2)

/-- A report's findings, rendered in order, so two runs can be compared as text. -/
def findingsText (rep : Scry.ProjectReport) : String :=
  String.join (List.map (fun pair => Scry.renderFinding rep.origins pair.1 pair.2)
    (Scry.zipFindings rep.findings rep.checks))

def jNat (j : Json) (k : String) : Nat :=
  match Json.get j k with
  | .some x => match Json.asNat x with | .some n => n | .none => 0
  | .none => 0

def jStr (j : Json) (k : String) : String :=
  match Json.get j k with
  | .some x => match Json.asString x with | .some s => s | .none => ""
  | .none => ""

def jList (j : Json) (k : String) : List Json :=
  match Json.get j k with
  | .some x => Json.asList x
  | .none => .nil

def contains (xs : List String) (x : String) : Bool := List.any (String.eq x) xs

def countName (p : Scry.Project) (n : String) : Nat :=
  List.length (List.filter (fun s => String.eq s n) p.paths)

def main : IO Unit := EIO.toIO (do
  -- path normalisation and URI escaping (the line-marker/artifact edge cases)
  check "path: a/x/../b.c normalises to a/b.c"
    (String.eq (Scry.normalisePath "a/x/../b.c") "a/b.c");
  check "path: absolute normalisation keeps the root"
    (String.eq (Scry.normalisePath "/a/./b/../c.c") "/a/c.c");
  check "uri: a space is percent-encoded"
    (String.eq (Scry.uriEscape "a b.c") "a%20b.c");

  -- compile database: arguments and command forms, flags filtered
  let dbText :=
    "[{\"directory\":\"d\",\"file\":\"a.c\",\"arguments\":[\"cc\",\"-I\",\"inc\",\"-DFOO=1\",\"" ++
    "-c\",\"a.c\",\"-o\",\"a.o\",\"-MMD\"]}," ++
    "{\"directory\":\"d\",\"file\":\"b.c\",\"command\":\"cc -Iinc2 -DBAR=2 -c b.c -o b.o\"}]";
  match Scry.parseCompdb dbText with
  | .error e => check ("compdb parse: " ++ e) .false
  | .ok cmds => do
    check "compdb: two entries" (Nat.beq (List.length cmds) 2);
    let c1 := List.getD cmds 0 (Scry.CompileCommand.mk "" "" .nil);
    let c2 := List.getD cmds 1 (Scry.CompileCommand.mk "" "" .nil);
    check "compdb: -I and -D kept, -c/-o/-MMD dropped"
      (Bool.and (contains c1.flags "-I") (Bool.and (contains c1.flags "inc")
        (Bool.and (contains c1.flags "-DFOO=1")
          (Bool.not (contains c1.flags "-o")))));
    check "compdb: command form keeps -Iinc2 and -DBAR=2"
      (Bool.and (contains c2.flags "-Iinc2") (contains c2.flags "-DBAR=2"));

  -- security-01: only preprocessing flags are forwarded; a flag that can execute code
  -- (or a response file) refuses the database instead of being filtered into silence.
  let forbiddenB :=
    "[{\"directory\":\".\",\"file\":\"a.c\",\"arguments\":[\"cc\",\"-Bbin\",\"a.c\"]}]";
  match Scry.parseCompdb forbiddenB with
  | .ok _ => check "compdb: -Bbin is refused" .false
  | .error e => check "compdb: -Bbin is refused (names the flag)"
      (String.contains e "-Bbin");
  let forbiddenRsp :=
    "[{\"directory\":\".\",\"file\":\"a.c\",\"arguments\":[\"cc\",\"@args.rsp\",\"a.c\"]}]";
  match Scry.parseCompdb forbiddenRsp with
  | .ok _ => check "compdb: @file is refused" .false
  | .error e => check "compdb: @file is refused (names the file)"
      (String.contains e "@args.rsp");
  -- #478: the allowlist is the policy. A real database's non-preprocessing options
  -- (-O2/-Wall/-fPIC) are refused by name, not dropped; the branch's explicit deny list
  -- is an additional first check. A whole command line is still accepted when every
  -- word is on the allowlist.
  let optDb :=
    "[{\"directory\":\".\",\"file\":\"a.c\",\"arguments\":[\"cc\",\"-I\",\"inc\",\"-DVAL=1\"," ++
    "\"-std=c11\",\"-O2\",\"-Wall\",\"-fPIC\",\"-c\",\"a.c\",\"-o\",\"a.o\"]}]";
  match Scry.parseCompdb optDb with
  | .ok _ => check "compdb: non-allowlisted flags are refused (-O2 named)" .false
  | .error e => check "compdb: non-allowlisted flags are refused (-O2 named)"
      (String.contains e "-O2");
  let normalDb :=
    "[{\"directory\":\".\",\"file\":\"a.c\",\"arguments\":[\"cc\",\"-I\",\"inc\",\"-DVAL=1\"," ++
    "\"-std=c11\",\"-c\",\"a.c\",\"-o\",\"a.o\"]}]";
  match Scry.parseCompdb normalDb with
  | .error e => check ("compdb: normal flags parse (" ++ e ++ ")") .false
  | .ok cmds => match cmds with
    | .cons c _ => check "compdb: preprocessing flags kept, driver flags dropped"
        (Bool.and (contains c.flags "-I") (Bool.and (contains c.flags "inc")
          (Bool.and (contains c.flags "-DVAL=1") (Bool.and (contains c.flags "-std=c11")
            (Bool.not (contains c.flags "-o"))))))
    | .nil => check "compdb: normal flags parse" .false;

  -- the same three cases end to end: the hostile databases are refused before `cc`
  -- runs (the committed `bin/cc1` writes a marker if it is ever executed).
  b1 ← EIO.lift (Scry.ProjectIO.buildProject "tests/fixtures/project/flags-b" .none "cc"
    .true .false .false .nil Scry.CacheOpts.none);
  match b1 with
  | .ok _ => check "flags-b: compile database refused" .false
  | .error e => check "flags-b: compile database refused (-Bbin named)"
      (String.contains e "-Bbin");
  ran ← EIO.lift (FS.exists "tests/fixtures/project/flags-b/bin/executed");
  check "flags-b: the committed cc1 never ran" (Bool.not ran);
  b2 ← EIO.lift (Scry.ProjectIO.buildProject "tests/fixtures/project/flags-rsp" .none "cc"
    .true .false .false .nil Scry.CacheOpts.none);
  match b2 with
  | .ok _ => check "flags-rsp: response file refused" .false
  | .error e => check "flags-rsp: response file refused (@args.rsp named)"
      (String.contains e "@args.rsp");
  b3 ← EIO.lift (Scry.ProjectIO.buildProject "tests/fixtures/project/flags-normal" .none "cc"
    .true .false .false .nil Scry.CacheOpts.none);
  match b3 with
  | .error e => check ("flags-normal: still analysed (" ++ e ++ ")") .false
  | .ok r => check "flags-normal: still analysed (one unit)"
      (Nat.beq (List.length r.1.units) 1);
  -- the flag allowlist: only preprocessing flags may reach `cc -E`; a database is
  -- repository-supplied, so an execution vector is refused by name, never stripped
  check "compdb: -Bbin is refused by name"
    (match Scry.parseCompdb
      "[{\"directory\":\"d\",\"file\":\"a.c\",\"arguments\":[\"cc\",\"-Bbin\",\"a.c\"]}]" with
      | .error e => String.contains e "-Bbin"
      | .ok _ => Bool.false);
  check "compdb: -fplugin is refused by name"
    (match Scry.parseCompdb
      "[{\"directory\":\"d\",\"file\":\"a.c\",\"command\":\"cc -fplugin=bin/p.so a.c\"}]" with
      | .error e => String.contains e "-fplugin=bin/p.so"
      | .ok _ => Bool.false);
  check "compdb: @file is refused"
    (match Scry.parseCompdb
      "[{\"directory\":\"d\",\"file\":\"a.c\",\"arguments\":[\"cc\",\"@bin/args\",\"a.c\"]}]" with
      | .error e => String.contains e "@bin/args"
      | .ok _ => Bool.false);
  check "compdb: an option-shaped value is refused"
    (match Scry.parseCompdb
      "[{\"directory\":\"d\",\"file\":\"a.c\",\"arguments\":[\"cc\",\"-I\",\"-Bbin\",\"a.c\"]}]" with
      | .error e => String.contains e "-Bbin"
      | .ok _ => Bool.false);
  check "compdb: -std=c11 kept, -o/-c dropped"
    (match Scry.parseCompdb
      "[{\"directory\":\"d\",\"file\":\"a.c\",\"arguments\":[\"cc\",\"-std=c11\",\"-DX=1\",\"-c\",\"a.c\",\"-o\",\"a.o\"]}]" with
      | .error _ => Bool.false
      | .ok cmds => match cmds with
        | .cons c _ => Bool.and (contains c.flags "-std=c11")
            (Bool.and (contains c.flags "-DX=1")
              (Bool.not (contains c.flags "-o")))
        | .nil => Bool.false);

  -- duplicate non-static definitions: reported, first analysed, no crash
  rd ← build "corpus/project/duplicate" Scry.CacheOpts.none;
  let pd := rd.1;
  check "duplicate: two units" (Nat.beq (List.length pd.units) 2);
  check "duplicate: one duplicate name" (Nat.beq (List.length pd.dups) 1);
  check "duplicate: both definitions in symbols" (Nat.beq (List.length pd.symbols) 3);
  check "duplicate: only first definition analysed" (Nat.beq (List.length pd.analyzed) 2);
  check "duplicate: call resolves to first definition"
    (match pd.callGraph with
      | .cons e _ => Bool.and (Nat.beq e.1 1) (Nat.beq e.2 0)
      | .nil => Bool.false);

  -- unresolved call
  rm ← build "corpus/project/missing" Scry.CacheOpts.none;
  check "unresolved: one call" (Nat.beq (List.length rm.1.unresolved) 1);
  check "unresolved: callee name" (match rm.1.unresolved with
    | .cons u _ => String.eq u.2 "missing"
    | .nil => Bool.false);

  -- shared header, static qualification and cross-TU call graph
  rp ← build "corpus/project" Scry.CacheOpts.none;
  let p := rp.1;
  check "project: three real files" (Nat.beq (List.length p.realPaths) 3);
  check "project: shared header appears once" (Nat.beq (countName p "math.h") 1);
  check "project: static helper is unit-qualified"
    (Bool.and (Nat.beq (List.length (p.funcIndices "static:0:helper")) 1)
      (Nat.beq (List.length (p.funcIndices "static:helper")) 0));
  check "project: three direct-call edges" (Nat.beq (List.length p.callGraph) 3);
  check "project: no duplicates" (Nat.beq (List.length p.dups) 0);

  -- --skip-broken: a missing include is recorded, not fatal
  bad ← FS.createTempDir;
  FS.writeFile (String.append bad "/good.c") "int good(void) { return 1; }\n";
  FS.writeFile (String.append bad "/bad.c") "#include <missing-header.h>\nint bad(void) { return 0; }\n";
  rs ← buildSkip bad;
  check "skip-broken: one unit" (Nat.beq (List.length rs.1.units) 1);
  check "skip-broken: one skipped TU" (Nat.beq (List.length rs.1.skipped) 1);
  FS.removeAll bad;

  -- cross-TU taint, per-file findings and certificates
  rt ← reportOf "corpus/project/taint" Scry.CacheOpts.none;
  let rep := rt.1;
  check "taint: two findings" (Nat.beq (List.length rep.findings) 2);
  check "taint: both checked" (Nat.beq (rep.checkedCount) 2);
  check "taint: finding in io.c" (Nat.beq (rep.fileOf "io.c").findings 1);
  check "taint: finding in util.c" (Nat.beq (rep.fileOf "util.c").findings 1);
  check "taint: no finding in app.c" (Nat.beq (rep.fileOf "app.c").findings 0);
  check "taint: path crosses the TU boundary"
    (match rep.findings with
      | .cons f _ => Bool.and (String.eq f.func "run_cmd")
          (match f.path with
            | .cons first _ => String.eq first.func "main"
            | .nil => Bool.false)
      | .nil => Bool.false);
  check "taint: app.c and io.c helpers stay distinct"
    (Bool.and (Nat.beq (List.length (rep.project.funcIndices "static:0:helper")) 1)
      (Nat.beq (List.length (rep.project.funcIndices "static:1:helper")) 1));

  -- SARIF: artifacts are relative, indexed, and every result names one
  let sj := rep.sarifJson;
  match Json.get sj "runs" with
  | .none => check "sarif: runs" .false
  | .some runs => match Json.asList runs with
    | .nil => check "sarif: one run" .false
    | .cons run _ => do
      let arts := jList run "artifacts";
      check "sarif: four artifacts" (Nat.beq (List.length arts) 4);
      check "sarif: first artifact is app.c"
        (match arts with
          | .cons a _ => match Json.get a "location" with
            | .some loc => String.eq (jStr loc "uri") "app.c"
            | .none => Bool.false
          | .nil => Bool.false);
      let results := jList run "results";
      check "sarif: one result per finding and warning"
        (Nat.beq (List.length results)
          (Nat.add (List.length rep.findings)
            (Nat.add (List.length rep.boundaries) (List.length rep.memory))));
      check "sarif: result artifact has uriBaseId and index"
        (match results with
          | .cons r _ => match Json.get r "locations" with
            | .some ls => match Json.asList ls with
              | .cons l _ => match Json.get l "physicalLocation" with
                | .some pl => match Json.get pl "artifactLocation" with
                  | .some al => Bool.and
                      (String.eq (jStr al "uriBaseId") "%SRCROOT%")
                      (match Json.get al "index" with
                        | .some (.int .false n) => Nat.lt n 4
                        | _ => Bool.false)
                  | .none => Bool.false
                | .none => Bool.false
              | .nil => Bool.false
            | .none => Bool.false
          | .nil => Bool.false);

  -- cache: cold, warm, identical findings, every key input, corrupt/truncated entries
  tmp ← FS.createTempDir;
  let cacheDir := String.append tmp "/cache";
  let cache : Scry.CacheOpts := Scry.CacheOpts.mk .true cacheDir .json;
  check "cache: the frontend stamp is in the key" (Bool.not (String.eq (Scry.cacheKeyFor "frontend-a" "p.c" "p.c" "int f(void);\n" .nil .true .false) (Scry.cacheKeyFor "frontend-b" "p.c" "p.c" "int f(void);\n" .nil .true .false)));
  check "cache: --keep-system-headers is in the key" (Bool.not (String.eq (Scry.cacheKey "p.c" "p.c" "int f(void);\n" .nil .true .false) (Scry.cacheKey "p.c" "p.c" "int f(void);\n" .nil .true .true)));
  check "cache: --allow-errors is in the key" (Bool.not (String.eq (Scry.cacheKey "p.c" "p.c" "int f(void);\n" .nil .true .false) (Scry.cacheKey "p.c" "p.c" "int f(void);\n" .nil .false .false)));
  check "cache: the flags are in the key" (Bool.not (String.eq (Scry.cacheKey "p.c" "p.c" "int f(void);\n" ["-DX=1"] .true .false) (Scry.cacheKey "p.c" "p.c" "int f(void);\n" ["-DX=2"] .true .false)));
  check "cache: the source path is in the key" (Bool.not (String.eq (Scry.cacheKey "a/p.c" "a/p.c" "int f(void);\n" .nil .true .false) (Scry.cacheKey "b/p.c" "b/p.c" "int f(void);\n" .nil .true .false)));
  check "cache: the stored CST path is in the key" (Bool.not (String.eq (Scry.cacheKey "p.c" "a/p.c" "int f(void);\n" .nil .true .false) (Scry.cacheKey "p.c" "b/p.c" "int f(void);\n" .nil .true .false)));
  check "cache: the source text is in the key" (Bool.not (String.eq (Scry.cacheKey "p.c" "p.c" "int f(void);\n" .nil .true .false) (Scry.cacheKey "p.c" "p.c" "int f(void) { return 0; }\n" .nil .true .false)));
  c1 ← build "corpus/project/taint" cache;
  let s1 := c1.2;
  check "cache: cold miss for every TU" (Bool.and (Nat.beq s1.hit 0) (Bool.and (Nat.beq s1.miss 3) (Nat.beq s1.write 3)));
  c2 ← build "corpus/project/taint" cache;
  let s2 := c2.2;
  check "cache: warm hit for every TU" (Bool.and (Nat.beq s2.hit 3) (Nat.beq s2.miss 0));
  pack ← Scry.loadTaintPack .none;
  let repCold := Scry.analyzeProject c1.1 pack s1;
  let repWarm := Scry.analyzeProject c2.1 pack s2;
  check "cache: a warm cache reproduces the findings byte for byte" (String.eq (findingsText repCold) (findingsText repWarm));
  -- an option that changes the cached result is in the key: a strict run does not
  -- reuse an --allow-errors entry, and its own entry warms separately
  cs1 ← Scry.ProjectIO.buildProject "corpus/project/taint" .none "cc" .false .false .false .nil cache;
  check "cache: --allow-errors is in the key (a strict run misses)" (Bool.and (Nat.beq cs1.2.hit 0) (Nat.beq cs1.2.miss 3));
  cs2 ← Scry.ProjectIO.buildProject "corpus/project/taint" .none "cc" .false .false .false .nil cache;
  check "cache: the strict entry warms too" (Nat.beq cs2.2.hit 3);
  -- a rule pack is not part of the CST key: findings are recomputed from the CST, so a
  -- changed pack on a warm cache must change the report rather than replay an old one
  -- (package-relative, like every other fixture path here: `grail test` runs the test
  -- with the package directory as the working directory, so `scry/rules/…` would be
  -- `scry/scry/rules/…`)
  oob ← Scry.loadTaintPack (.some "rules/oob.scry");
  let repOob := Scry.analyzeProject c2.1 oob s2;
  check "cache: a rule-pack change cannot replay stale findings" (Bool.not (String.eq (findingsText repWarm) (findingsText repOob)));

  -- one source file: its content is the key (not its timestamp)
  let srcDir := String.append tmp "/src";
  FS.createDir srcDir;
  let srcCache : Scry.CacheOpts := Scry.CacheOpts.mk .true (String.append tmp "/srccache") .json;
  let srcFile := String.append srcDir "/a.c";
  FS.writeFile srcFile "int f(void) { return 1; }\n";
  b0 ← build srcDir srcCache;
  check "cache: a single-TU project is cold" (Nat.beq b0.2.miss 1);
  FS.writeFile srcFile "int f(void) { return 1; }\n";
  b1 ← build srcDir srcCache;
  check "cache: rewriting identical source text still hits" (Nat.beq b1.2.hit 1);
  FS.writeFile srcFile "int f(void) { return 1; }\nint g(void) { return f(); }\n";
  b2 ← build srcDir srcCache;
  check "cache: a changed source file misses" (Bool.and (Nat.beq b2.2.hit 0) (Nat.beq b2.2.miss 1));
  check "cache: the changed source is what was analysed (two functions)" (Nat.beq (List.length b2.1.funcs) 2);

  -- a header is not in the outer key, but its text reaches the preprocessed digest
  let hdrDir := String.append tmp "/hdr";
  FS.createDir hdrDir;
  let hdrCache : Scry.CacheOpts := Scry.CacheOpts.mk .true (String.append tmp "/hdrcache") .json;
  FS.writeFile (String.append hdrDir "/h.h") "#define CALL a\nchar *a(void);\nchar *b(void);\n";
  FS.writeFile (String.append hdrDir "/m.c") "#include \"h.h\"\nvoid m(void) { CALL(); }\n";
  h1 ← build hdrDir hdrCache;
  check "cache: a header project is cold" (Nat.beq h1.2.miss 1);
  h2 ← build hdrDir hdrCache;
  check "cache: a header project warms" (Nat.beq h2.2.hit 1);
  check "cache: the header's first macro names the callee" (List.any (fun r => String.eq r.2 "a") h2.1.unresolved);
  FS.writeFile (String.append hdrDir "/h.h") "#define CALL b\nchar *a(void);\nchar *b(void);\n";
  h3 ← build hdrDir hdrCache;
  check "cache: a changed header misses" (Bool.and (Nat.beq h3.2.hit 0) (Nat.beq h3.2.miss 1));
  check "cache: the changed header's macro is what was parsed" (List.any (fun r => String.eq r.2 "b") h3.1.unresolved);

  -- the entry names its own format and frontend version: a grammar, shim, spill-format
  -- or preprocessing change is a clean miss, never a stale CST. The literal pins
  -- Scry.projectCacheFrontend; a deliberate bump updates this test in the same commit.
  let fmtDir := String.append tmp "/fmt";
  FS.createDir fmtDir;
  let fmtCacheDir := String.append tmp "/fmtcache";
  let fmtCache : Scry.CacheOpts := Scry.CacheOpts.mk .true fmtCacheDir .json;
  FS.writeFile (String.append fmtDir "/x.c") "int x(void) { return 0; }\n";
  f0 ← build fmtDir fmtCache;
  check "cache: the one-TU version fixture is cold" (Nat.beq f0.2.miss 1);
  fnames ← FS.listDir fmtCacheDir;
  -- the same cache directory also holds the lowering entries (`lower-<key>.tu`);
  -- the format test is about the parse entry
  let fentries := List.filter (fun n => Bool.not (String.startsWith n "lower-")) fnames;
  let fentry := match fentries with
    | .cons n _ => String.append fmtCacheDir (String.append "/" n)
    | .nil => "";
  ftext ← FS.readFile fentry;
  check "cache: the entry names its format version" (String.startsWith ftext "scry-project-tu 3\n");
  check "cache: the entry names the frontend stamp" (String.contains ftext "frontend cst-1 ts-0.27.2 c-0.24.2 abi-15");
  let oldFront := "frontend cst-1 ts-0.27.2 c-0.24.2 abi-15";
  let fchanged := String.replace ftext oldFront "frontend cst-0 ts-0.0.0 c-0.0.0 abi-0";
  check "cache: the frontend fixture rewrote its stamp" (Bool.not (String.eq fchanged ftext));
  FS.writeFile fentry fchanged;
  f1 ← build fmtDir fmtCache;
  check "cache: an entry from another frontend is a clean miss" (Bool.and (Nat.beq f1.2.hit 0) (Bool.and (Nat.beq f1.2.miss 1) (Nat.beq f1.2.corrupt 0)));
  f2 ← build fmtDir fmtCache;
  check "cache: the frontend-mismatched entry warms after rewrite" (Nat.beq f2.2.hit 1);
  -- an entry from an older format version is a miss, not corruption
  ftext2 ← FS.readFile fentry;
  let fold := String.replace ftext2 "scry-project-tu " "scry-project-tu 99";
  check "cache: the format fixture rewrote its magic" (Bool.not (String.eq fold ftext2));
  FS.writeFile fentry fold;
  f3 ← build fmtDir fmtCache;
  check "cache: an entry from another format is a clean miss" (Bool.and (Nat.beq f3.2.hit 0) (Bool.and (Nat.beq f3.2.miss 1) (Nat.beq f3.2.corrupt 0)));
  f4 ← build fmtDir fmtCache;
  check "cache: the format-mismatched entry warms after rewrite" (Nat.beq f4.2.hit 1);
  -- a truncated entry is recomputed, not a hit and not a crash
  ftext3 ← FS.readFile fentry;
  FS.writeFile fentry (String.take (Nat.div (String.length ftext3) 2) ftext3);
  f5 ← build fmtDir fmtCache;
  check "cache: a truncated entry is recomputed, not a hit" (Bool.and (Nat.beq f5.2.hit 0) (Bool.and (Nat.lt 0 f5.2.corrupt) (Nat.beq f5.2.miss 1)));
  f6 ← build fmtDir fmtCache;
  check "cache: the truncated entry warms after rewrite" (Nat.beq f6.2.hit 1);
  -- the full-column digest: a body whose columns no longer hash to the recorded digest
  -- is recomputed (not a stale hit). This is the guard for a lossy spill round trip.
  ftext4 ← FS.readFile fentry;
  let fdigest := String.replace ftext4 "\ndigest " "\ndigest 0";
  check "cache: the digest fixture rewrote its digest" (Bool.not (String.eq fdigest ftext4));
  FS.writeFile fentry fdigest;
  f7 ← build fmtDir fmtCache;
  check "cache: a digest mismatch is recomputed" (Bool.and (Nat.beq f7.2.hit 0) (Nat.lt 0 f7.2.corrupt));
  f8 ← build fmtDir fmtCache;
  check "cache: the digest-mismatched entry warms after rewrite" (Nat.beq f8.2.hit 1);
  -- a warm hit is the *same store*, column for column, as a cold parse
  fCold ← Scry.ProjectIO.buildProject fmtDir .none "cc" .true .false .false .nil (Scry.CacheOpts.mk .false "" .json);
  fWarm ← build fmtDir fmtCache;
  let sameStore : Bool := match fCold.1.units, fWarm.1.units with
    | .cons a _, .cons b _ => String.eq (Scry.cstFullDigest a.store) (Scry.cstFullDigest b.store)
    | _, _ => Bool.false;
  check "cache: a warm CST has the cold parse's full-column digest" sameStore;

  -- corrupt every entry, then the run must recompute and rewrite
  names ← FS.listDir cacheDir;
  Scry.corruptCacheEntries cacheDir names;
  c3 ← build "corpus/project/taint" cache;
  let s3 := c3.2;
  check "cache: corrupt entries are recomputed" (Bool.and (Nat.lt 0 s3.corrupt) (Nat.beq s3.hit 0));
  c4 ← build "corpus/project/taint" cache;
  let s4 := c4.2;
  check "cache: warm again after corruption" (Nat.beq s4.hit 3);
  -- a committed symlink at an entry's sibling `.tmp` must not be truncated through
  FS.writeFile (String.append tmp "/victim.txt") "keep\n";
  FS.symlink (String.append tmp "/victim.txt") (String.append tmp "/cache/k.tu.tmp");
  saveRes ← EIO.lift (Scry.cacheSave (String.append tmp "/cache") "k" "pre" "0" "digest" "cst");
  let tmpRefused :=
    match saveRes with
    | .error _ => Bool.true
    | .ok _ => Bool.false;
  check "cache: symlink tmp refused" tmpRefused;
  victimText ← FS.readFile (String.append tmp "/victim.txt");
  check "cache: symlink target unchanged" (String.eq victimText "keep\n");

  -- findings index: JSON and Quire round-trip the same rows, and a corrupt or
  -- truncated Quire file is a clean miss
  let frows := Scry.rowsOfReport rep;
  let fid := Scry.ProjectIO.projectIndexId rep.project;
  let fjson : Scry.CacheOpts := Scry.CacheOpts.mk .true tmp .json;
  let fquire : Scry.CacheOpts := Scry.CacheOpts.mk .true tmp .quire;
  j1 ← Scry.cacheFindings fjson fid frows;
  check "index: json cold" (String.eq j1.reason "cold");
  j2 ← Scry.cacheFindings fjson fid frows;
  check "index: json hit" (String.eq j2.reason "hit");
  q1 ← Scry.cacheFindings fquire fid frows;
  check "index: quire cold" (String.eq q1.reason "cold");
  q2 ← Scry.cacheFindings fquire fid frows;
  check "index: quire hit" (String.eq q2.reason "hit");
  jl ← Scry.findingsLoad fjson fid;
  ql ← Scry.findingsLoad fquire fid;
  let sameKeys : Bool := match jl, ql with
    | .ok a, .ok b => Bool.and (Nat.beq (List.length a) (List.length b))
        (UIntN.beq (Scry.fiPrint a) (Scry.fiPrint b))
    | _, _ => Bool.false;
  check "index: json and quire hold the same findings" sameKeys;
  let sev0 := List.length (List.filter (fun r => Nat.beq r.severity 0) frows);
  qc ← Scry.findingsQuery fquire fid 0;
  -- The type is written out: a `let` gives its body no expected type, so the `.false`
  -- term in the second branch has nothing to resolve against, and the elaborator no
  -- longer guesses a constructor's type from the first branch (23cf4a314, "Error
  -- messages: audit and the top 20 fixes"). `Bool.false` would do as well.
  let qOk : Bool := match qc with
    | .ok n => Nat.beq n sev0
    | .error _ => Bool.false;
  check "index: quire severity query" qOk;
  jc ← Scry.findingsQuery fjson fid 0;
  let jOk : Bool := match jc with
    | .ok n => Nat.beq n sev0
    | .error _ => Bool.false;
  check "index: json severity query" jOk;
  let qpath := Scry.findingsCachePath fquire fid;
  FS.writeFile qpath "not a quire image\n";
  q3 ← Scry.cacheFindings fquire fid frows;
  check "index: corrupt quire is a miss" (String.eq q3.reason "corrupt");
  q4 ← Scry.cacheFindings fquire fid frows;
  check "index: quire hit after repair" (String.eq q4.reason "hit");
  qb ← FS.readBytes qpath;
  FS.writeBytes qpath (Bytes.slice qb 0 100);
  q5 ← Scry.cacheFindings fquire fid frows;
  check "index: truncated quire is a miss" (String.eq q5.reason "corrupt");

  -- lowering cache (Stage B of wiz-notes/incremental-scry.md §6.2): the key names the
  -- lowering's own inputs, a cold run writes one atomic record per TU, a warm run
  -- reconstructs the identical Wil, and a changed header, a truncated/corrupt record or
  -- a different target is a miss (never a stale TU). One-line checks throughout: a
  -- newline before a bare identifier or string argument ends a Wiz application.
  let lpaths := ["a.c"];
  let ltexts := ["int f(void);\n"];
  let ltextsG := ["int g(void);\n"];
  let lkBase := Scry.lowerCacheKeyFor "lowerer" "cst" "pre" "a.c" lpaths ltexts .true;
  let lowererKey := Scry.lowerCacheKeyFor "lowerer-b" "cst" "pre" "a.c" lpaths ltexts .true;
  check "lower: the lowerer identity is in the key" (Bool.not (String.eq lkBase lowererKey));
  let cstKey := Scry.lowerCacheKeyFor "lowerer" "cst-b" "pre" "a.c" lpaths ltexts .true;
  check "lower: the full CST digest is in the key" (Bool.not (String.eq lkBase cstKey));
  let preKey := Scry.lowerCacheKeyFor "lowerer" "cst" "pre-b" "a.c" lpaths ltexts .true;
  check "lower: the preprocessing digest is in the key" (Bool.not (String.eq lkBase preKey));
  let targetKey := Scry.lowerCacheKeyFor "lowerer" "cst" "pre" "b.c" lpaths ltexts .true;
  check "lower: the target alone changes the key" (Bool.not (String.eq lkBase targetKey));
  let textKey := Scry.lowerCacheKeyFor "lowerer" "cst" "pre" "a.c" lpaths ltextsG .true;
  check "lower: the original text digest is in the key" (Bool.not (String.eq lkBase textKey));
  let modeKey := Scry.lowerCacheKeyFor "lowerer" "cst" "pre" "a.c" lpaths ltexts .false;
  check "lower: --allow-errors is in the key" (Bool.not (String.eq lkBase modeKey));
  -- H5: a same-length `#line` rewrite blanks to the same preprocessed text, so the parse
  -- cache's `preDigest` cannot see it; the lowering key's digest also covers the line map
  let raw10 := "# 10 \"x.c\"\nint f(void) { return 0; }\n";
  let raw20 := "# 20 \"x.c\"\nint f(void) { return 0; }\n";
  let origText := "int f(void) { return 0; }\n";
  let lineFiles := [("x.c", origText)];
  let p10 := Scry.preprocess "x.c" raw10 lineFiles;
  let p20 := Scry.preprocess "x.c" raw20 lineFiles;
  check "lower: a same-length #line rewrite keeps the blanked preprocessed text" (String.eq p10.text p20.text);
  check "lower: a same-length #line rewrite changes the lowering pre digest" (Bool.not (String.eq (Scry.lowerPreDigest p10) (Scry.lowerPreDigest p20)));

  let ldir := String.append tmp "/lower";
  FS.createDir ldir;
  let lcacheDir := String.append tmp "/lowercache";
  let lcache : Scry.CacheOpts := Scry.CacheOpts.mk .true lcacheDir .json;
  FS.writeFile (String.append ldir "/h.h") "#define VALUE 1\nint helper(int x);\n";
  FS.writeFile (String.append ldir "/a.c") "#include \"h.h\"\nint main(void) { return helper(VALUE); }\n";
  l0 ← build ldir lcache;
  check "lower: cold hit 0" (Nat.beq l0.2.lowerHit 0);
  check "lower: cold miss 1" (Nat.beq l0.2.lowerMiss 1);
  check "lower: cold write 1" (Nat.beq l0.2.lowerWrite 1);
  l1 ← build ldir lcache;
  check "lower: warm hit 1" (Nat.beq l1.2.lowerHit 1);
  check "lower: warm miss 0" (Nat.beq l1.2.lowerMiss 0);
  check "lower: warm write 0" (Nat.beq l1.2.lowerWrite 0);
  let tu0 := match l0.1.units with
    | .cons a _ => Scry.tuDump a.tu a.path a.errors (Scry.cstFullDigest a.store)
    | .nil => "";
  let tu1 := match l1.1.units with
    | .cons b _ => Scry.tuDump b.tu b.path b.errors (Scry.cstFullDigest b.store)
    | .nil => "";
  check "lower: the warm TU dump is byte-identical to cold" (String.eq tu0 tu1);
  FS.writeFile (String.append ldir "/h.h") "#define VALUE 2\nint helper(int x);\n";
  l2 ← build ldir lcache;
  check "lower: a changed header does not hit" (Nat.beq l2.2.lowerHit 0);
  check "lower: a changed header misses" (Nat.lt 0 l2.2.lowerMiss);
  l2cold ← Scry.ProjectIO.buildProject ldir .none "cc" .true .false .false .nil (Scry.CacheOpts.mk .false "" .json);
  let tu2 := match l2.1.units with
    | .cons a _ => Scry.tuDump a.tu a.path a.errors (Scry.cstFullDigest a.store)
    | .nil => "";
  let tu2cold := match l2cold.1.units with
    | .cons b _ => Scry.tuDump b.tu b.path b.errors (Scry.cstFullDigest b.store)
    | .nil => "";
  check "lower: the changed-header TU equals a cold build" (String.eq tu2 tu2cold);
  l3 ← build ldir lcache;
  check "lower: the changed header's entry warms" (Nat.beq l3.2.lowerHit 1);
  let tu3 := match l3.1.units with
    | .cons a _ => Scry.tuDump a.tu a.path a.errors (Scry.cstFullDigest a.store)
    | .nil => "";
  check "lower: the re-warmed TU equals the cold build" (String.eq tu3 tu2cold);

  -- H5 operationally: a comment edit in a header changes the original text (and so
  -- every byte offset in that file) but not the preprocessed text, so the CST cache hits
  -- while the lowering cache must miss and re-lower to the new origins
  let cmDir := String.append tmp "/lower-comment";
  FS.createDir cmDir;
  let cmCacheDir := String.append tmp "/lower-comment-cache";
  let cmCache : Scry.CacheOpts := Scry.CacheOpts.mk .true cmCacheDir .json;
  FS.writeFile (String.append cmDir "/h.h") "/* one */\nstatic int helper(void) { return 1; }\n";
  FS.writeFile (String.append cmDir "/a.c") "#include \"h.h\"\nint main(void) { return helper(); }\n";
  m0 ← build cmDir cmCache;
  check "lower: the comment fixture is cold" (Nat.beq m0.2.hit 0);
  check "lower: the comment fixture lowers cold" (Nat.beq m0.2.lowerMiss 1);
  m1 ← build cmDir cmCache;
  check "lower: the comment fixture parse warms" (Nat.beq m1.2.hit 1);
  check "lower: the comment fixture lower warms" (Nat.beq m1.2.lowerHit 1);
  FS.writeFile (String.append cmDir "/h.h") "/* a much longer comment */\nstatic int helper(void) { return 1; }\n";
  m2 ← build cmDir cmCache;
  check "lower: a header comment hits the CST cache" (Nat.beq m2.2.hit 1);
  check "lower: a header comment misses the parse cache 0" (Nat.beq m2.2.miss 0);
  check "lower: a header comment misses the lowering cache" (Nat.beq m2.2.lowerHit 0);
  check "lower: a header comment re-lowers" (Nat.beq m2.2.lowerMiss 1);
  m2cold ← Scry.ProjectIO.buildProject cmDir .none "cc" .true .false .false .nil (Scry.CacheOpts.mk .false "" .json);
  let tu4 := match m2.1.units with
    | .cons a _ => Scry.tuDump a.tu a.path a.errors (Scry.cstFullDigest a.store)
    | .nil => "";
  let tu4cold := match m2cold.1.units with
    | .cons b _ => Scry.tuDump b.tu b.path b.errors (Scry.cstFullDigest b.store)
    | .nil => "";
  check "lower: the comment change's warm TU has the cold origins" (String.eq tu4 tu4cold);

  -- a fresh one-TU project for the corruption cases, so the cache holds exactly one
  -- lowering entry (the header fixture above has an older, still-valid one too)
  let cdir := String.append tmp "/lower-corrupt";
  FS.createDir cdir;
  let ccacheDir := String.append tmp "/lower-corrupt-cache";
  let ccache : Scry.CacheOpts := Scry.CacheOpts.mk .true ccacheDir .json;
  FS.writeFile (String.append cdir "/c.c") "int c(void) { return 1; }\n";
  c0 ← build cdir ccache;
  check "lower: the corruption fixture writes one entry" (Nat.beq c0.2.lowerWrite 1);
  cnames ← FS.listDir ccacheDir;
  let centries := List.filter (fun n => String.startsWith n "lower-") cnames;
  let centry := match centries with
    | .cons n _ => String.append ccacheDir (String.append "/" n)
    | .nil => "";
  ctext ← FS.readFile centry;
  check "lower: the entry names its format" (String.startsWith ctext "scry-project-lower 1\n");
  check "lower: the entry names the lowerer stamp" (String.contains ctext "lowerer c-lower-1 default-models");
  FS.writeFile centry (String.take (Nat.div (String.length ctext) 2) ctext);
  c1 ← build cdir ccache;
  check "lower: a truncated entry does not hit" (Nat.beq c1.2.lowerHit 0);
  check "lower: a truncated entry is corrupt" (Nat.lt 0 c1.2.lowerCorrupt);
  check "lower: a truncated entry misses" (Nat.beq c1.2.lowerMiss 1);
  c2 ← build cdir ccache;
  check "lower: warms after truncation" (Nat.beq c2.2.lowerHit 1);
  ctext2 ← FS.readFile centry;
  let cbad := String.replace ctext2 "\nfunc\t" "\nfunc\tX";
  check "lower: the body corruption fixture changed" (Bool.not (String.eq cbad ctext2));
  FS.writeFile centry cbad;
  c3 ← build cdir ccache;
  check "lower: a body corruption does not hit" (Nat.beq c3.2.lowerHit 0);
  check "lower: a body corruption is corrupt" (Nat.lt 0 c3.2.lowerCorrupt);
  c4 ← build cdir ccache;
  check "lower: warms after the digest mismatch" (Nat.beq c4.2.lowerHit 1);

  -- two units with identical text at different targets: the target is part of the key,
  -- so one TU's lowering can never be served for the other
  let twinDir := String.append tmp "/lower-twins";
  FS.createDir twinDir;
  let twinCache : Scry.CacheOpts := Scry.CacheOpts.mk .true (String.append tmp "/lower-twincache") .json;
  FS.writeFile (String.append twinDir "/a.c") "int twin(void) { return 1; }\n";
  FS.writeFile (String.append twinDir "/b.c") "int twin(void) { return 1; }\n";
  t0 ← build twinDir twinCache;
  check "lower: twin cold hit 0" (Nat.beq t0.2.lowerHit 0);
  check "lower: twin cold misses 2" (Nat.beq t0.2.lowerMiss 2);
  check "lower: twin cold writes 2" (Nat.beq t0.2.lowerWrite 2);
  t1 ← build twinDir twinCache;
  check "lower: both targets hit on the second run" (Nat.beq t1.2.lowerHit 2);

  FS.removeAll tmp;
  check "cache: cleanup" .true)
