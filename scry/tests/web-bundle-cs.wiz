-- test: run timeout 900
import Scry.NativeLink
import Sys
import Json
import Text
-- The C# half of the static source reader: `scry cs --bundle DIR` writes the bundle
-- `scry web` writes for C, over `tests/fixtures/report-cs` (six files: `taint/`'s three
-- tainted, one safe, one large and one non-ASCII file, and `cap/Overflow.cs`, the AST cap's
-- seed). The target is the directory, not `taint/` as the header used to say: the seed is a
-- fixture of this tree, and a golden whose target is a subdirectory leaves the rest of the
-- fixture unread while its prose still describes it.
--
-- **Units.** tree-sitter spans are UTF-8 bytes and the reader's `Source.Span` is UTF-16
-- code units, so every bound here is the file's unit count (`units` below), never
-- `String.length` (which counts characters). `Unicode.cs` is the case where the three
-- disagree — mixing them moves its sink 27 units (bytes) or 3 units (code points) — and
-- its finding's span is pinned exactly, not merely bounded.
--
-- What this pins (the `gs_*` lines are the golden's subject; every `check` line is an
-- assertion that must be `: ok`, or `: skip` with a reason that names the defect):
--
-- * the bundle's shape: six files, the manifest's schema, mode, counts and
--   `language: csharp` footer, and relative paths only;
-- * every tainted file has its finding, with a UTF-16 span inside its own file, the
--   `command-injection` rule, and the reader's facts at the sink;
-- * `sink`/`flow` rows keep the C bundle's shape, and the `ast` rows carry the tree for
--   the infotree: a parent id, a depth, a sibling order;
-- * the AST cap: a tree larger than `ast.cap` writes exactly the cap's rows and reports
--   the rest (the padded seed case). `Huge.cs` is the deliberate exception: it is
--   pinned as *not* truncated **until the product makes that true**, and the check says
--   `: skip` with the defect until it does;
-- * two exports are byte-identical (no timestamp, stable ids and order);
-- * `scry web` and `scry report` refuse a C#-only tree instead of writing an empty
--   bundle, name `scry cs`; an empty directory gets its own message; a directory with
--   both languages is read as C, with a note naming the C# files it did not read.
--
-- The bundle's own content (the reader's first paint, the answer schema, the scripted
-- patch trace) is `web/source_static_test.mjs`'s contract, run on this bundle by
-- `web/source_cs_gate.sh`, whose mutations are the negative half. Neither is run here.

/-- `Option`-filtering map: the library has no `List.filter_map`, and this is the shape
`corpus-parse.wiz` defines for itself. -/
def filterMap {A B : Type} (f : A → Option B) : List A → List B
  | .nil => []
  | .cons x rest => match f x with
    | .some y => List.cons y (filterMap f rest)
    | .none => filterMap f rest

def check (label : String) (ok : Bool) : EIO Unit :=
  EIO.lift (match ok with
    | .true => IO.println (label ++ ": ok")
    | .false => IO.bind (IO.ePrintln (label ++ ": FAILED"))
        (fun _ => Process.exit 1))

/-- An assertion the product does not meet yet, kept with the defect it pins instead of
being deleted. It prints the assertion, the reason and the value the product gives now,
and does not fail the run - so it is visibly not a pass, and the day the assertion starts
holding the reason in the line is stale. `check` is for everything the product must do. -/
def skipWith (label reason detail : String) : EIO Unit :=
  EIO.lift (IO.println (label ++ ": skip (" ++ reason ++ "; observed " ++ detail ++ ")"))

/-- A golden line that reports a value (a count) rather than passing or failing. -/
def say (label : String) : EIO Unit :=
  EIO.lift (IO.println ("gs_" ++ label))

structure Res where
  code : Nat
  out : String
  err : String

def ensureBuild : EIO Unit := do
  ok ← EIO.lift (FS.exists "build");
  match ok with
  | .true => EIO.pure ()
  | .false => FS.createDir "build"

def run (args : List String) : EIO Res := do
  r ← Process.output ".grail/bin/scry" args "";
  let code := match r.status with
    | .exited n => n
    | .signaled _ => 99;
  EIO.pure (Res.mk code r.stdout r.stderr)

def jAt (j : Json) (path : List String) : Json :=
  match path with
  | .nil => j
  | .cons k rest => match Json.get j k with
    | .some x => jAt x rest
    | .none => Json.mkNull

def jStr (j : Json) (path : List String) : String :=
  match jAt j path with
  | .str s => s
  | _ => ""

def jNat (j : Json) (path : List String) : Nat :=
  match jAt j path with
  | .int _ n => n
  | _ => 0

def jList (j : Json) (path : List String) : List Json :=
  match jAt j path with
  | .arr xs => Jsons.toList xs
  | _ => .nil

def readJson (path : String) : EIO Json := do
  text ← FS.readFile path;
  match Json.parse text with
  | .ok j => EIO.pure j
  | .error e => do
    check ("cs bundle: " ++ path ++ " parses (" ++ e ++ ")") .false;
    EIO.pure Json.mkNull

/-- A file's length in **UTF-16 code units**: the bound a `Source.Span` must fit and the
unit the bundle's `bytes` field counts (the export's `Scry.webUtf8Size`). `String.length`
counts characters, so it is the wrong bound for any non-ASCII file and would pass a
byte/unit mix-up that lands past the real end. A character outside the BMP is 2 units. -/
partial def unitsGo : List Char → Nat → Nat
  | .nil, n => n
  | .cons c rest, n => unitsGo rest (Nat.add n (match Nat.lt 0xFFFF (Char.code c) with
      | .true => 2
      | .false => 1))

def units (s : String) : Nat := unitsGo (String.chars s) 0

/-- Pad `seed` to `n` copies: the cap's case needs a tree larger than
`Scry.Cs.astFactCap`, and the seed is short. `n` is read from the manifest's `ast.cap`, so
the fixture grows with the cap instead of silently stopping to overflow one. The padding
is a suffix (each copy its own string literal), so the seed's first lines — and the
sink the path checks pin — keep their offsets. -/
partial def padGo (seed : String) : Nat → String → String
  | 0, acc => acc
  | Nat.succ k, acc => padGo seed k (String.append acc seed)

def padded (seed : String) (n : Nat) : String := padGo seed (Nat.sub n 1) seed

def copyPadded (src dst : String) (n : Nat) : EIO Unit := do
  text ← FS.readFile src;
  FS.writeFile dst (padded text n)

/-- Copy `from` to `to` (the mixed-directory case's two sources). -/
def copyIn (src dst : String) : EIO Unit := do
  text ← FS.readFile src;
  FS.writeFile dst text

/-- A message's lines joined by ` | `, so a multi-line refusal stays one golden line. -/
def trimLines (s : String) : String :=
  String.intercalate " | " (List.map String.trim (String.splitOn s "\n"))

/-- A path that would bind the bundle to this checkout: absolute, or climbing out. -/
def relative (p : String) : Bool :=
  Bool.not (Bool.or (String.startsWith p "/") (String.contains p ".."))

/-- A fact row's column `k` (the first pair with that key). -/
def column (r : Json) (k : String) : String :=
  let pairOf : Json → Option String := fun p => match p with
    | .arr xs => match Jsons.toList xs with
      | .cons k0 (.cons v _) => match k0 with
        | .str s => match String.eq s k with
          | .true => match v with
            | .str t => .some t
            | _ => .none
          | .false => .none
        | _ => .none
      | _ => .none
    | _ => .none;
  match filterMap pairOf (jList r ["columns"]) with
  | .cons t _ => t
  | .nil => ""

def isKind (k : String) (r : Json) : Bool := String.eq (jStr r ["kind"]) k

/-- A file's own `data/f/<id>.json`. -/
def readFile (id : String) : EIO Json :=
  readJson ("build/web-bundle-cs/data/f/" ++ id ++ ".json")

def idOf (files : List Json) (suffix : String) : String :=
  match List.find (fun f => String.endsWith (jStr f ["path"]) suffix) files with
  | .some f => jStr f ["id"]
  | .none => ""

/-- The file row with id `id`, or `none`. -/
def fileWith (files : List Json) (id : String) : Option Json :=
  List.find (fun f => String.eq (jStr f ["id"]) id) files

/-- `List.mapM`: the library has no monadic map (`List.traverseM` is Optic's state-passing
traversal), so this is the usual hand-written one, as `filterMap` above is. -/
partial def mapME {A B : Type} (f : A → EIO B) : List A → EIO (List B)
  | .nil => EIO.pure []
  | .cons x rest => do
    y ← f x;
    ys ← mapME f rest;
    EIO.pure (List.cons y ys)

/-- Whether a finding's span is inside its file and its id is listed in that file's JSON.
A `let`-bound `fun … => do` loses the block's termination (the parser then blames the next
`def`), so the body lives here as a top-level definition - the same hoist `Scry.Cs.finish`
needed for its `do` arms. -/
def findingBound (files : List Json) (f : Json) : EIO Bool := do
  let id := jStr f ["fileId"];
  match fileWith files id with
  | .none => EIO.pure .false
  | .some meta => do
    d ← readFile id;
    let len := units (jStr d ["source"]);
    let inJson := List.any (fun g => String.eq (jStr g ["id"]) (jStr f ["id"]))
      (jList d ["findings"]);
    EIO.pure (Bool.and (Bool.and (Nat.lt (jNat f ["span", "start"])
        (jNat f ["span", "stop"])) (Nat.le (jNat f ["span", "stop"]) len)) inJson)

/-- The `leftOut` count the manifest records for the truncated file whose path ends `name`,
or 0 when the manifest does not name it. A `let`-bound function with a parameter does not
parse (the same family as a `let`-bound `do`), so it lives at top level. -/
def leftOutOf (manifest : Json) (name : String) : Nat :=
  match List.find (fun t => String.endsWith (jStr t ["path"]) name)
      (jList manifest ["ast", "truncated"]) with
  | .some t => jNat t ["leftOut"]
  | .none => 0

/-- Whether file `f`'s id set agrees with the summary's for this file, in both directions:
every finding the summary lists for `f` is in `f`'s own JSON, and every finding in `f`'s
JSON is the summary's row for `f`. One direction alone would pass a summary that dropped a
finding the file still has, or a file that invented one. -/
def findingsAgree (summary : List Json) (f : Json) : EIO Bool := do
  d ← readFile (jStr f ["id"]);
  let own := jList d ["findings"];
  let mine := List.filter (fun g => String.eq (jStr g ["fileId"]) (jStr f ["id"])) summary;
  let inOwn := fun g => List.any (fun h => String.eq (jStr h ["id"]) (jStr g ["id"])) own;
  let inMine := fun h => List.any (fun g => String.eq (jStr g ["id"]) (jStr h ["id"])) mine;
  EIO.pure (Bool.and (List.all inOwn mine) (List.all inMine own))

/-- The `start..stop` slice of `s` in UTF-16 units' *character* arithmetic: the fixtures'
spans here are ASCII beyond the sink, so `String.drop`/`String.take` count the same units.
Used to compare a finding's span with text the source actually has, not only with two
integers. -/
def sliceStr (s : String) (start stop : Nat) : String :=
  String.take (Nat.sub stop start) (String.drop start s)

/-- `findingsAgree` partially applied to the summary, so it can be passed to `mapME`. -/
def findingsAgreeOf (summary : List Json) (f : Json) : EIO Bool :=
  findingsAgree summary f

/-- Whether a file's JSON carries its *own* findings and nothing else: every row names this
file, and there is at least one when the summary lists one for it. While the export handed
every file the whole program's findings, both directions "agreed" while each row's span was
clamped into the wrong text; the path check is what fails in that case. -/
def ownFindingsOnly (f : Json) : EIO Bool := do
  d ← readFile (jStr f ["id"]);
  let path := jStr f ["path"];
  EIO.pure (List.all (fun g => String.eq (jStr g ["path"]) path) (jList d ["findings"]))

/-- Write `bytes` to `p` verbatim: `FS.writeFile` is text and would not carry a NUL or a
byte above 0x7F. -/
def writeBytesAt (p : String) (bytes : Bytes) : EIO Unit :=
  FS.writeBytes p bytes

/-- A file's size in bytes, from its raw contents. -/
def fileBytes (p : String) : EIO Nat := do
  bytes ← FS.readBytes p;
  EIO.pure (Bytes.size bytes)

/-- Whether two number lists agree element for element (the library has no `zipWith`, so
this is the walk: each step matches one list and takes the other's head with a `match`). -/
def sameNatList (xs ys : List Nat) : Bool :=
  match xs with
  | .nil => match ys with
    | .nil => .true
    | .cons _ _ => .false
  | .cons x rest => match ys with
    | .nil => .false
    | .cons y more => Bool.and (Nat.beq x y) (sameNatList rest more)

/-- Whether the two files hold the same bytes (`FS.readFile` is text and stops at a NUL, so
it cannot answer this for a wasm): the raw buffers as number lists, compared in full. -/
def sameBytes (a b : String) : EIO Bool := do
  x ← FS.readBytes a;
  y ← FS.readBytes b;
  EIO.pure (Bool.and (Nat.beq (Bytes.size x) (Bytes.size y))
    (sameNatList (Bytes.toList x) (Bytes.toList y)))

/-- Whether a file's own `data/f/<id>.json` carries at least one `ast` row: the manifest's
`factKinds` names the kinds the export *writes*, so this is the check that the name is not
an empty promise. A `let`-bound `fun … => do` loses the block's termination in this
dialect (the parser then blames the next `def`), so it is a top-level definition. -/
def hasAstRows (f : Json) : EIO Bool := do
  d ← readFile (jStr f ["id"]);
  EIO.pure (Nat.lt 0 (List.length (jList d ["ast"])))

/-- Whether the two exports wrote the same file `p`. A `let`-bound function with a `do`
body loses the block's termination, so it is a top-level definition. -/
def sameExport (p : String) : EIO Bool := do
  a ← FS.readFile ("build/web-bundle-cs/" ++ p);
  b ← FS.readFile ("build/web-bundle-cs2/" ++ p);
  EIO.pure (String.eq a b)

/-- Whether the two exports wrote the same `data/f/<id>.json` for the file row `f`. A
`let`-bound function with a `do` body loses the block's termination, so it lives here. -/
def sameFileExport (f : Json) : EIO Bool :=
  sameExport ("data/f/" ++ jStr f ["id"] ++ ".json")

def main : IO Unit := EIO.toIO (do
  bin ← EIO.lift (FS.exists ".grail/bin/scry");
  match bin with
  | .false => EIO.lift (IO.println "cs bundle: skip (.grail/bin/scry absent)")
  | .true => do
    ensureBuild;
    -- The directory, not `taint/`: `cap/Overflow.cs` is a fixture of this same tree and
    -- the export walks it, so the bundle's file table is six rows and its counts are six.
    -- (`taint/` alone was five files and a different findings set.)
    let target := "tests/fixtures/report-cs";
    r ← run ["cs", target, "--bundle", "build/web-bundle-cs", "--assets", "../web"];
    check "cs bundle: exit 0" (Nat.beq r.code 0);
    m ← readJson "build/web-bundle-cs/data/manifest.json";
    fs ← readJson "build/web-bundle-cs/data/files.json";
    fl ← readJson "build/web-bundle-cs/data/findings.json";
    let files := jList fs ["files"];
    let findings := jList fl ["findings"];
    let nFiles := jNat m ["counts", "files"];
    let nFindings := jNat m ["counts", "findings"];
    say ("manifest: schema=" ++ jStr m ["schema"] ++ " mode=" ++ jStr m ["mode"]
      ++ " language=" ++ jStr m ["language"] ++ " files=" ++ Nat.repr nFiles
      ++ " findings=" ++ Nat.repr nFindings);
    check "cs bundle: manifest names the bundle schema"
      (String.eq (jStr m ["schema"]) "scry.web.bundle/1");
    check "cs bundle: the export is static" (String.eq (jStr m ["mode"]) "static");
    check "cs bundle: the manifest says C#" (String.eq (jStr m ["language"]) "csharp");
    check ("cs bundle: the manifest lists the fact kinds ("
      ++ Nat.repr (List.length (jList m ["factKinds"])) ++ ")")
      (Nat.beq (List.length (jList m ["factKinds"])) 3);
    -- The fact kinds are declared *and written*: an array of names is a promise, and the
    -- export that declared `ast` without writing one row per file is what a reader would
    -- have drawn an empty infotree from. Every file the manifest lists carries `ast` rows
    -- of its own (each of the six fixtures parses), so `factKinds` is not a declaration
    -- with nothing behind it.
    haveAst ← mapME hasAstRows files;
    check "cs bundle: every file has ast rows, so factKinds is not a promise"
      (List.all (fun b => b) haveAst);
    check "cs bundle: every path is relative to the target"
      (List.all (fun f => relative (jStr f ["path"])) files);
    -- Shell.cs: the sink, the path and the tree.
    let shellId := idOf files "Shell.cs";
    sh ← readFile shellId;
    let shFacts := jList sh ["facts"];
    let astRows := jList sh ["ast"];
    let sinkRows := List.filter (isKind "sink") shFacts;
    let flowRows := List.filter (isKind "flow") shFacts;
    say ("shell: sink=" ++ Nat.repr (List.length sinkRows) ++ " flow="
      ++ Nat.repr (List.length flowRows) ++ " ast=" ++ Nat.repr (List.length astRows));
    -- A count of exactly 1 was a guess written before this path ever ran; the analyser
    -- reports every sink it derives, including the ones propagated through the helpers
    -- `Shell.Run` calls. Assert the property that matters - at least one, and the pinned
    -- `Process.Start(cmd)` sink among them - not a total that was invented.
    -- Every `sink` row is a `command-injection` occurrence of *this* file, and the one a
    -- reader would open first is Shell.cs's own call: `Process.Start(cmd)` at 13:9, whose
    -- span is the invocation expression of the parse (`[290..308]`, measured with
    -- `tools/ProbeCstMain.wiz`). A row whose line is past the file's last line (14) is not
    -- a mark on this file at all.
    check "cs bundle: Shell.cs has sink rows" (Nat.lt 0 (List.length sinkRows));
    check "cs bundle: Shell.cs's own call is a sink at 13:9 spanning Process.Start(cmd)"
      (List.any (fun x => Bool.and (String.eq (column x "rule") "command-injection")
        (Bool.and (Nat.beq (jNat x ["line"]) 13) (Bool.and (Nat.beq (jNat x ["column"]) 9)
          (Bool.and (Nat.beq (jNat x ["span", "start"]) 290)
            (Nat.beq (jNat x ["span", "stop"]) 308))))) sinkRows);
    check "cs bundle: every sink row is a mark inside Shell.cs"
      (let len := units (jStr sh ["source"]);
       List.all (fun x => Bool.and (Nat.lt 0 (jNat x ["line"]))
         (Bool.and (Nat.le (jNat x ["line"]) (jNat sh ["lines"]))
           (Nat.le (jNat x ["span", "stop"]) len))) sinkRows);
    check "cs bundle: the sink row names its rule"
      (List.all (fun x => String.eq (column x "rule") "command-injection") sinkRows);
    -- Parity with the C bundle: a `flow` row carries the same columns `Scry.webFactsOf`
    -- writes for C (`kind`, `func`, `rule`, `finding`), so the reader shows a C# path the
    -- same way (`web/source_static_test.mjs`'s C section asserts the C shape).
    check "cs bundle: every flow row carries the C bundle's columns"
      (List.all (fun x => Bool.and (Nat.lt 0 (String.length (column x "kind")))
        (Bool.and (Nat.lt 0 (String.length (column x "finding")))
          (String.eq (column x "rule") "command-injection"))) flowRows);
    check "cs bundle: every ast row has a kind label"
      (List.all (fun x => Nat.lt 0 (String.length (column x "kind"))) astRows);
    check "cs bundle: exactly one ast root"
      (Nat.beq (List.length (List.filter (fun x => String.eq (column x "parent") "")
        astRows)) 1);
    check "cs bundle: every parent id names a row of the same file"
      (List.all (fun x => match String.eq (column x "parent") "" with
        | .true => .true
        | .false => List.any (fun y => String.eq (jStr y ["node"])
            (column x "parent")) astRows) astRows);
    check "cs bundle: every ast span fits its file"
      (let len := units (jStr sh ["source"]);
       List.all (fun x => Bool.and (Nat.le (jNat x ["span", "start"])
         (jNat x ["span", "stop"])) (Nat.le (jNat x ["span", "stop"]) len)) astRows);
    check "cs bundle: every ast row has a depth and an order"
      (List.all (fun x => Bool.and (Nat.lt 0 (String.length (column x "depth")))
        (Nat.lt 0 (String.length (column x "order")))) astRows);
    -- Findings: the count against the manifest, all in bound, all in their file's JSON.
    check ("cs bundle: " ++ Nat.repr (List.length findings) ++ " finding(s) match the manifest")
      (Nat.beq (List.length findings) nFindings);
    bounds ← mapME (findingBound files) findings;
    check "cs bundle: every finding's span is inside its file, listed in its file's JSON"
      (List.all (fun b => b) bounds);
    -- Every finding row in the summary is also a finding of its file's JSON, and every
    -- per-file finding is in the summary: the two tables are written from one model, so a
    -- row that exists in `findings.json` alone would draw a finding the reader cannot open
    -- from the file it is about.
    inFiles ← mapME (findingsAgreeOf (jList fl ["findings"])) files;
    check "cs bundle: findings.json and every data/f/<id>.json agree"
      (List.all (fun b => b) inFiles);
    ownOnly ← mapME ownFindingsOnly files;
    check "cs bundle: every data/f/<id>.json carries only that file's findings"
      (List.all (fun b => b) ownOnly);
    -- Unicode.cs: the byte/UTF-16 case. Its sink is `Process.Start(cmd)` — 18 units at
    -- 1274..1292 (the statement's `;` is not part of the call). `span.stop` is exclusive:
    -- the other plausible conversions are 1301..1319 (bytes, 27 past) and 1271..1289 (code
    -- points, 3 short), and the bundle's start matched 1274 while its stop was 1292. That
    -- one unit of disagreement was this test's own comment asserting 1293, read into the
    -- golden before the export had ever run: `Unicode.cs`'s text has 1334 units.
    un ← readFile (idOf files "Unicode.cs");
    let unFinding : Option Json := List.find (fun f => String.eq (jStr f ["rule"])
      "command-injection") (jList un ["findings"]);
    match unFinding with
    | .none => check "cs bundle: Unicode.cs has its command-injection finding" .false
    | .some f => do
      say ("unicode: sink span=" ++ Nat.repr (jNat f ["span", "start"]) ++ ".."
        ++ Nat.repr (jNat f ["span", "stop"]) ++ " text=" ++ jStr f ["spanText"]
        ++ " line=" ++ Nat.repr (jNat f ["line"]) ++ " col=" ++ Nat.repr (jNat f ["column"]));
      check "cs bundle: Unicode.cs's sink is at the UTF-16 span of Process.Start(cmd)"
        (Bool.and (Nat.beq (jNat f ["span", "start"]) 1274)
          (Nat.beq (jNat f ["span", "stop"]) 1292));
      check "cs bundle: Unicode.cs's sink line and column are the source's own"
        (Bool.and (Nat.beq (jNat f ["column"]) 9) (Nat.beq (jNat f ["line"]) 28));
      -- The finding's span is the statement itself: slice the tested text at it and compare
      -- with the text the export says it points at, so the assertion is about the source's
      -- own units, not only about two integers.
      check "cs bundle: Unicode.cs's span slices Process.Start(cmd) in units"
        (String.eq (sliceStr (jStr un ["source"]) 1274 1292) "Process.Start(cmd)");
      -- Every `ast` row of the same file: each must slice text the parse actually made
      -- (a skew would cut a character in half), and the tree's root is the whole file.
      let len := units (jStr un ["source"]);
      let unAst := jList un ["ast"];
      check "cs bundle: Unicode.cs's every ast span is inside its UTF-16 length"
        (Bool.and (Nat.lt 0 (List.length unAst))
          (List.all (fun x => Bool.and (Nat.le (jNat x ["span", "start"])
            (jNat x ["span", "stop"])) (Nat.le (jNat x ["span", "stop"]) len)) unAst));
      let root := List.filter (fun x => String.eq (column x "parent") "") unAst;
      check "cs bundle: Unicode.cs's ast root spans the whole file, in units"
        (match root with
          | .cons r _ => Bool.and (Nat.beq (jNat r ["span", "start"]) 0)
              (Nat.beq (jNat r ["span", "stop"]) len)
          | .nil => .false);
      check "cs bundle: Unicode.cs's ast titles keep their non-ASCII text"
        (List.any (fun x => String.contains (column x "title") "→") unAst);
    -- Huge.cs: 59 lines against a cap of 2,000 nodes. The fixture describes it as "one
    -- file whose tree overflows the export's AST cap", and this block asserted that
    -- overflow (`leftOut` > 0, and `ast + leftOut = cap`). It does not overflow: the export
    -- writes 839 rows and names no truncation. Then `ast + leftOut = cap` can never hold for
    -- a file under the cap - it says the file's tree was exactly the cap - which is the
    -- arithmetic of a full tree, not of a truncated one.
    --
    -- The cap is a product decision (does the fixture grow, or is 2,000 nodes the real size
    -- the cap should be?), so the assertion stays as written and is *skipped with the
    -- defect named* while it is false. It is not deleted, and it is not `: ok`: `say` below
    -- prints the three numbers each run, so whichever way the cap is settled, the line says
    -- what the product did.
    huge ← readFile (idOf files "Huge.cs");
    let hugeAst := List.length (jList huge ["ast"]);
    let cap := jNat m ["ast", "cap"];
    let leftOut := leftOutOf m "Huge.cs";
    say ("huge: ast=" ++ Nat.repr hugeAst ++ " cap=" ++ Nat.repr cap
      ++ " leftOut=" ++ Nat.repr leftOut);
    check "cs bundle: Huge.cs keeps the manifest's cap and no more"
      (Bool.and (Nat.le hugeAst cap) (Nat.lt 0 hugeAst));
    let overflows := Bool.and (Nat.lt 0 leftOut) (Nat.beq (Nat.add hugeAst leftOut) cap);
    match overflows with
    | .true => check "cs bundle: the manifest's leftOut is the rows the cap left out" .true
    | .false => skipWith "cs bundle: the manifest's leftOut is the rows the cap left out"
        ("Huge.cs's tree (" ++ Nat.repr hugeAst ++ " nodes) is under ast.cap ("
         ++ Nat.repr cap ++ "), so no row was left out and `ast + leftOut = cap` cannot"
         ++ " hold; see the block comment above")
        (Nat.repr hugeAst ++ " + " ++ Nat.repr leftOut ++ " != " ++ Nat.repr cap);
    check "cs bundle: the manifest does not name Huge.cs as truncated"
      (Bool.not (List.any (fun t => String.endsWith (jStr t ["path"]) "Huge.cs")
        (jList m ["ast", "truncated"])));
    check "cs bundle: a file under the cap is not named as truncated"
      (Bool.not (List.any (fun t => String.endsWith (jStr t ["path"]) "Shell.cs")
        (jList m ["ast", "truncated"])));
    -- The cap, on a tree that really overflows it: one seed file padded to just over the
    -- manifest's own cap. Huge.cs's size is not pinned, so the truncation above is only
    -- "capped, and adds up"; this is the case where the cap is the binding constraint.
    capDir ← EIO.lift (FS.exists "build/cs-cap");
    match capDir with
    | .true => EIO.pure ()
    | .false => FS.createDir "build/cs-cap";
    -- The seed is about 9 CST nodes a line (measured: 211 nodes for its 24 lines), so
    -- `cap * 3 / 20` copies is a tree about 1.5x the cap - enough for the last copies to fall
    -- to the cap, without writing 16x the cap by accident (2,000 nodes and the seed's 211:
    -- `cap / 4 + 8` writes 37k rows per file and makes this case the test's slowest).
    let copies := Nat.add (Nat.div (Nat.mul cap 3) 20) 8;
    copyPadded "tests/fixtures/report-cs/cap/Overflow.cs" "build/cs-cap/Overflow.cs" copies;
    rc ← run ["cs", "build/cs-cap", "--bundle", "build/web-bundle-cs-cap",
      "--assets", "../web"];
    check "cs bundle: the padded cap fixture exports" (Nat.beq rc.code 0);
    fc ← readJson "build/web-bundle-cs-cap/data/files.json";
    capf ← readJson ("build/web-bundle-cs-cap/data/f/" ++ idOf (jList fc ["files"])
      "Overflow.cs" ++ ".json");
    let capRows := List.length (jList capf ["ast"]);
    mc ← readJson "build/web-bundle-cs-cap/data/manifest.json";
    let capLeft := match List.find (fun t => String.endsWith (jStr t ["path"])
        "Overflow.cs") (jList mc ["ast", "truncated"]) with
      | .some t => jNat t ["leftOut"]
      | .none => 0;
    say ("cap fixture: ast=" ++ Nat.repr capRows ++ " leftOut=" ++ Nat.repr capLeft
      ++ " cap=" ++ Nat.repr cap);
    check ("cs bundle: an overflowing tree writes the cap's rows (" ++ Nat.repr capRows
      ++ " of " ++ Nat.repr (Nat.add capRows capLeft) ++ " nodes)")
      (Bool.and (Nat.beq capRows cap) (Nat.lt 0 capLeft));
    -- Two copies alone are under the cap (the seed is dozens of nodes, not thousands),
    -- so the whole tree is written: the truncation all comes from the extra copies.
    copyPadded "tests/fixtures/report-cs/cap/Overflow.cs" "build/cs-cap/Overflow.cs" 2;
    r2c ← run ["cs", "build/cs-cap", "--bundle", "build/web-bundle-cs-cap2",
      "--assets", "../web"];
    check "cs bundle: the two-copy cap fixture exports" (Nat.beq r2c.code 0);
    fc2 ← readJson "build/web-bundle-cs-cap2/data/files.json";
    mc2 ← readJson "build/web-bundle-cs-cap2/data/manifest.json";
    let twoLeft := match List.find (fun t => String.endsWith (jStr t ["path"])
        "Overflow.cs") (jList mc2 ["ast", "truncated"]) with
      | .some t => jNat t ["leftOut"]
      | .none => 0;
    check "cs bundle: two copies are under the cap and lose no node" (Nat.beq twoLeft 0);
    -- Determinism.
    r2 ← run ["cs", target, "--bundle", "build/web-bundle-cs2", "--assets", "../web"];
    check "cs bundle: the second export exits 0" (Nat.beq r2.code 0);
    sameManifest ← sameExport "data/manifest.json";
    check "cs bundle: two exports write the same manifest" sameManifest;
    sameFiles ← sameExport "data/files.json";
    check "cs bundle: two exports write the same files" sameFiles;
    sameFindings ← sameExport "data/findings.json";
    check "cs bundle: two exports write the same findings" sameFindings;
    sameFileJson ← sameExport ("data/f/" ++ shellId ++ ".json");
    check "cs bundle: two exports write the same per-file JSON" sameFileJson;
    -- The per-file table and the reader's trace, not just Shell.cs: a node id or a fact
    -- order that comes from a map's iteration order is stable inside one process and would
    -- pass a one-file check while the other five differ. The file list is the export's own
    -- table, so a file that left one bundle fails on the read.
    perFile ← mapME sameFileExport files;
    check "cs bundle: two exports write every per-file JSON the same"
      (List.all (fun b => b) perFile);
    sameTrace ← sameExport "ui-trace.json";
    check "cs bundle: two exports write the same ui-trace.json" sameTrace;
    -- The page is the runtime's SSR and `app.js`: byte-identical too, so no time or
    -- counter leaks into the first paint.
    samePage ← sameExport "index.html";
    check "cs bundle: two exports write the same index.html" samePage;
    -- The reader's runtime (`--ui`). `app.js` imports `wiz-source-ui.mjs`, and Emscripten
    -- fetches `wiz-source-ui.wasm` beside it: a bundle that copied only the module makes the
    -- browser fetch a missing wasm, receive the 404 page as `text/html`, and abort with
    -- "expected 'application/wasm'". The wasm fixture is a **real** wasm header
    -- (`00 61 73 6d 01 00 00 00`) followed by a 0xFF byte: it starts with a NUL (so a text
    -- copy stops before its first byte) and is not UTF-8 (so a text read cannot round-trip
    -- it), and neither failure is visible in a file's size alone - `--ui` copied a 0-byte
    -- wasm for exactly that reason. This asserts the bytes, not that a file exists.
    uiDir ← EIO.lift (FS.exists "build/cs-ui-src");
    match uiDir with
    | .true => EIO.pure ()
    | .false => FS.createDir "build/cs-ui-src";
    copyIn "tests/fixtures/report-cs/taint/Shell.cs" "build/cs-ui-src/wiz-source-ui.mjs";
    writeBytesAt "build/cs-ui-src/wiz-source-ui.wasm"
      (Bytes.ofList [0, 0x61, 0x73, 0x6d, 1, 0, 0, 0, 4, 0xFF, 0x80]);
    ru ← run ["cs", target, "--bundle", "build/web-bundle-cs-ui",
      "--assets", "../web", "--ui", "build/cs-ui-src/wiz-source-ui.mjs"];
    check "cs bundle: --ui exports" (Nat.beq ru.code 0);
    uiMjs ← FS.readFile "build/web-bundle-cs-ui/wiz-source-ui.mjs";
    uiMjsStub ← FS.readFile "build/cs-ui-src/wiz-source-ui.mjs";
    check "cs bundle: --ui copies wiz-source-ui.mjs" (String.eq uiMjs uiMjsStub);
    sameWasm ← sameBytes "build/cs-ui-src/wiz-source-ui.wasm"
      "build/web-bundle-cs-ui/wiz-source-ui.wasm";
    check "cs bundle: --ui copies wiz-source-ui.wasm byte for byte (NUL and 0xFF included)"
      sameWasm;
    wasmSize ← fileBytes "build/web-bundle-cs-ui/wiz-source-ui.wasm";
    check ("cs bundle: the copied wasm is not truncated (" ++ Nat.repr wasmSize ++ " bytes)")
      (Nat.beq wasmSize 11);
    -- And a module built without a wasm is not an error: the module is copied, the wasm is
    -- simply absent, and the export still exits 0 (the runtime may be self-contained).
    copyIn "tests/fixtures/report-cs/taint/Safe.cs" "build/cs-ui-src/solo.mjs";
    rs ← run ["cs", target, "--bundle", "build/web-bundle-cs-ui-solo",
      "--assets", "../web", "--ui", "build/cs-ui-src/solo.mjs"];
    check "cs bundle: --ui without a .wasm beside it still exits 0" (Nat.beq rs.code 0);
    soloMjs ← EIO.lift (FS.exists "build/web-bundle-cs-ui-solo/wiz-source-ui.mjs");
    check "cs bundle: --ui without a .wasm still copies the module" soloMjs;
    soloWasm ← EIO.lift (FS.exists "build/web-bundle-cs-ui-solo/wiz-source-ui.wasm");
    check "cs bundle: --ui writes no wasm when there is none to copy"
      (Bool.not soloWasm);
    uiManifest ← readJson "build/web-bundle-cs-ui/data/manifest.json";
    check "cs bundle: the manifest says the runtime came with the bundle"
      (match jAt uiManifest ["assets", "runtime"] with
        | .bool true => .true
        | _ => .false);
    -- The page is the reader's first paint, not a file listing: an SSR container `app.js`
    -- mounts on, the runtime's own markup, and no `<ul>` of paths that the old
    -- `Scry.Cs.bundlePage` wrote.
    page ← FS.readFile "build/web-bundle-cs/index.html";
    say ("page: " ++ Nat.repr (String.length page) ++ " bytes");
    check "cs bundle: index.html is the reader's mount point"
      (String.contains page "<div id=\"app\"");
    check "cs bundle: index.html is not the old file listing"
      (Bool.not (String.contains page "listing, not the reader"));
    -- The scripted walk the reader replays, without which the page cannot step a finding.
    trace ← readJson "build/web-bundle-cs/ui-trace.json";
    check "cs bundle: ui-trace.json carries the first paint"
      (Nat.lt 0 (String.length (jStr trace ["initial"])));
    check "cs bundle: ui-trace.json carries a scripted step to replay"
      (Nat.lt 0 (List.length (jList trace ["steps"])));
    check "cs bundle: ui-trace.json answers every finding's hover and info"
      (Nat.beq (List.length (jList trace ["answers"])) (Nat.mul 2 nFindings));
    -- `scry web` on the same tree: refused, the C# path named, nothing written.
    w ← run ["web", target, "--out", "build/web-bundle-cs-refused"];
    check "web refuses a C#-only tree (non-zero exit)" (Bool.not (Nat.beq w.code 0));
    say ("web refusal: exit " ++ Nat.repr w.code ++ ": " ++ String.trim w.err);
    check "web refusal names scry cs" (String.contains w.err "scry cs");
    there ← EIO.lift (FS.exists "build/web-bundle-cs-refused/data/manifest.json");
    check "web refusal writes no bundle" (Bool.not there);
    -- `scry report` on the same tree: the same refusal (the walk it shares), and an
    -- empty directory is its own message, never an empty report that reads as clean.
    rp ← run ["report", target, "--out", "build/web-bundle-cs-report.html"];
    check "report refuses a C#-only tree (non-zero exit)" (Bool.not (Nat.beq rp.code 0));
    say ("report refusal: exit " ++ Nat.repr rp.code ++ ": " ++ trimLines rp.err);
    check "report refusal names scry cs" (String.contains rp.err "scry cs");
    empty ← EIO.lift (FS.exists "build/cs-empty-dir");
    match empty with
    | .true => EIO.pure ()
    | .false => FS.createDir "build/cs-empty-dir";
    we ← run ["web", "build/cs-empty-dir", "--out", "build/web-bundle-cs-empty"];
    check "web refuses an empty directory (non-zero exit)" (Bool.not (Nat.beq we.code 0));
    say ("web empty-dir refusal: exit " ++ Nat.repr we.code ++ ": " ++ trimLines we.err);
    check "the empty-directory refusal is not the C# one"
      (Bool.and (String.contains we.err "no *.c file") (Bool.not (String.contains we.err
        "has no *.c file, but")));
    -- A directory with both languages: `scry web` works (it is a C tree) and says which
    -- C# files it did not read; `scry cs --bundle` works too, on the same directory.
    mixed ← EIO.lift (FS.exists "build/cs-mixed");
    match mixed with
    | .true => EIO.pure ()
    | .false => FS.createDir "build/cs-mixed";
    copyIn "tests/fixtures/report/safe.c" "build/cs-mixed/safe.c";
    copyIn "tests/fixtures/report-cs/taint/Safe.cs" "build/cs-mixed/Safe.cs";
    wm ← run ["web", "build/cs-mixed", "--out", "build/web-bundle-cs-mixed"];
    check "web accepts a directory with *.c and *.cs" (Nat.beq wm.code 0);
    say ("mixed note: " ++ trimLines wm.err);
    check "the mixed directory's note counts the C# files it did not read"
      (Bool.and (String.contains wm.err "also has 1 *.cs file(s)")
        (String.contains wm.err "scry cs --bundle"))
  )
