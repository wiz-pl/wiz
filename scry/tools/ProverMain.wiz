import Sys
import Scry.ProverCmd
/-!
# prover: the standalone driver

A thin wrapper over `Scry.ProverCmd` (the same code `scry prover` runs), kept so
`scry/corpus/prover/build.sh` and `check.sh` keep their `key<TAB>value` contract:

    prover FILE NAMESPACE.Type.Method                 # default no-flow script
    prover FILE NAMESPACE.Type.Method --cover         # closure only + check
    prover FILE NAMESPACE.Type.Method --rows 0:0,2:1  # check a hand-written I
    prover FILE NAMESPACE.Type.Method --dump          # the EDB relations
    prover FILE.c main --cut                          # every write is preceded by a check
    prover FILE.c main --cut --guards 2,3             # the same, with a chosen cut

Options: `--entry`, `--classify`, `--pack FILE`, `--json`, `--sarif OUT`.
Exit status: 0 proved, 1 refuted/refused, 2 usage/IO, 3 nothing analysed.
-/
def main : IO Unit :=
  IO.bind IO.args (fun args =>
    IO.bind (EIO.toIO (Scry.proverMain args)) (fun n => Process.exit n))
