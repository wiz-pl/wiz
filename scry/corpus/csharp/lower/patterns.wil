func Demo.Match.Length(%0)
  b0:
    %2 = null
    %3 = havoc u1
    %4 = 0
    br (ne %0, %2) and (ne %3, %4) ? b1 : b2
  b1:
    %1 = %0
    %5 = call System.String.get_Length(%1)
    ret %5
  b2:
    goto b3
  b3:
    %6 = 1
    %7 = neg %6
    ret %7
func Demo.Match.IsNull(%0)
  b0:
    %1 = null
    %2 = eq %0, %1
    ret %2
func Demo.Match.NotNull(%0)
  b0:
    %1 = null
    %2 = ne %0, %1
