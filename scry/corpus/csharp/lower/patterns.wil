func Demo.Match.TypeTest(%0)
  b0:
    %1 = havoc u1
    ret %1
func Demo.Match.Guarded(%0)
  b0:
    %2 = null
    %3 = havoc u1
    %4 = 0
    br (ne %0, %2) and (ne %3, %4) ? b1 : b2
  b1:
    %1 = %0
    %5 = %1
    goto b3
  b2:
    %6 = 0
    %5 = %6
    goto b3
  b3:
    %7 = %5
    ret %7
func Demo.Match.OrNone(%0)
  b0:
    %2 = havoc u1
    %3 = 0
    br ne %2, %3 ? b1 : b2
  b1:
    %4 = global $str:"none"
    ret %4
  b2:
    %1 = %0
    goto b3
  b3:
    ret %1
func Demo.Match.NotEither(%0)
  b0:
    %2 = null
    %3 = havoc u1
    %4 = 0
    br not ((ne %0, %2) and (ne %3, %4)) ? b1 : b2
  b1:
