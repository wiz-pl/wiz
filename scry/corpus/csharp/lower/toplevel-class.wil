func Geometry.Point..ctor(%0, %1, %2)
  b0:
    %3 = gep %0, 0
    store %3, %1
    %4 = gep %0, 1
    store %4, %2
    ret %0
func toplevel-class_Program.<Main>$(%0)
  b0:
    %1 = 3
    %2 = 4
    %3 = alloc 3
    %4 = call Geometry.Point..ctor(%3, %1, %2)
    %5 = %3
