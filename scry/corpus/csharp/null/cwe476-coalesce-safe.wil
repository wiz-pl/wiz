  b3:
    %4 = 0
    %6 = null
    br eq %1, %6 ? b4 : b5
  b4:
    %5 = %4
    goto b6
  b5:
    %5 = %1
    goto b6
  b6:
    ret %5
func NullFixtures.Coalesce.Choose(%0)
  b0:
    %1 = global $str:"none"
    %3 = null
    br eq %0, %3 ? b1 : b2
  b1:
    %2 = %1
