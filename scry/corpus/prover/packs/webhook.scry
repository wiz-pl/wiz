# Dogfood pack: an unvalidated request header must not reach the webhook processor.
#
# `CommunicationsWebhookEndpoints.SendGridMarketingWebhook` reads two header values
# (signature, timestamp) and a body, verifies the signature, and then hands the parsed
# *body* events to the processor. The property is that the header values themselves do
# not reach the processor's arguments.
rule unvalidated-header
  kind taint
  severity error
  message An unvalidated header value reaches the webhook processor
  source Microsoft.AspNetCore.Http.HttpRequest.get_Headers result
  source HttpRequest.get_Headers result
  source Microsoft.AspNetCore.Http.HttpRequest.get_Form result
  source HttpRequest.get_Form result
  source Microsoft.AspNetCore.Http.HttpRequest.get_Query result
  source HttpRequest.get_Query result
  sink Crux.Communications.Infrastructure.DeliveryEventProcessor.ProcessAsync args
  sink DeliveryEventProcessor.ProcessAsync args
  sink Crux.Notifications.Twilio.TwilioStatusEventProcessor.ProcessAsync args
  sink TwilioStatusEventProcessor.ProcessAsync args
end
