import Grail
-- scry, the code-analysis package (S1 skeleton; design: wiz-notes/code-analysis-design.md
-- §4, §6, layout notes: wiz-notes/scry-package.md). grail reads `grail.wiz`, so the
-- build file is this one even though the design calls the package "scry".
--
--   grail build                 check src/, build .grail/bin/scry, run every command
--   grail build scry            just the CLI
--   grail run scry -- facts fixtures/demo.facts.json
--   grail test                  the pure loader/stats tests (tests/*.expected)
--
-- S1: `parse --stats` parses C with the vendored tree-sitter shim; the JSON and
-- scry-cst stores remain for the synthetic corpus and the spill format.
def package : Package := Package.new "scry"
  |> Package.lib "src" "src"
  -- `gen/C/Schema.wiz` is checked in (generated by the `schema` command below); checking
  -- it as a lib root is what `tests/schema-index.wiz` and `tests/cst.wiz` import.
  |> Package.lib "gen" "gen"
  -- the Scry library (Wil, Analysis, Rules, RuleTaint, Interproc, Sarif, Certify).
  -- `lib/` is the repository's standard library root; the scry package sits beside it.
  |> Package.lib "scrylib" "../lib"
  |> Package.exe "scry" "App.wiz"
  |> Package.exe "scry-schema" "tools/SchemaMain.wiz"
  |> Package.exe "scry-cst" "tools/CstMain.wiz"
  -- the C# external-frequency probe (`scry/CSHARP.md` §"External models"): the merged
  -- program's unmodelled callees, counted. Measurement only; no test depends on it.
  |> Package.exe "cs-externals" "tools/CsExternalsMain.wiz"
  |> Package.tests "tests" "tests"
  -- the S1 skeleton's end-to-end checks: each command runs the CLI over the fixture.
  -- They are ordinary build jobs (keyed by the exe, the fixture and the arguments), so
  -- `grail build` exercises the loader and a second build runs none of them.
  |> Package.command (Command.new "facts" (Tool.exe "scry")
       |> Command.arg "facts"
       |> Command.input "fixtures/demo.facts.json"
       |> Command.stdout "build/facts.txt")
  |> Package.command (Command.new "query" (Tool.exe "scry")
       |> Command.arg "query"
       |> Command.input "fixtures/demo.facts.json"
       |> Command.arg "--kind"
       |> Command.arg "call_expression"
       |> Command.stdout "build/query.txt")
  |> Package.command (Command.new "explain" (Tool.exe "scry")
       |> Command.arg "explain"
       |> Command.input "fixtures/demo.facts.json"
       |> Command.arg "4"
       |> Command.stdout "build/explain.txt")
  |> Package.command (Command.new "parse" (Tool.exe "scry")
       |> Command.arg "parse"
       |> Command.arg "--stats"
       |> Command.input "fixtures/demo.facts.json"
       |> Command.stdout "build/parse-stats.txt")
  -- The real parser (S1): a C fixture through the vendored tree-sitter shim.
  |> Package.command (Command.new "parse-native" (Tool.exe "scry")
       |> Command.arg "parse"
       |> Command.arg "--stats"
       |> Command.input "fixtures/hello.c"
       |> Command.stdout "build/parse-native.txt")
  -- Dynamic evidence: a malformed fixture's CST/ERROR spans as JSON (fuzz/run.py
  -- embeds the same object in its report; this target keeps the CLI exercised).
  |> Package.command (Command.new "fuzz-span" (Tool.exe "scry")
       |> Command.arg "fuzz-span"
       |> Command.arg "--json"
       |> Command.input "fixtures/broken.c"
       |> Command.stdout "build/fuzz-span.json")
  -- The e-graph layer (S12): lowered Wil terms, folds/rewrites, deterministic report.
  |> Package.command (Command.new "egraph" (Tool.exe "scry")
       |> Command.arg "egraph"
       |> Command.input "fixtures/egraph-const.c"
       |> Command.stdout "build/egraph.txt")
  -- The checked extraction back to Wil (S12): the same fixture, `--rewrite` mode.
  |> Package.command (Command.new "egraph-rewrite" (Tool.exe "scry")
       |> Command.arg "egraph"
       |> Command.input "fixtures/egraph-const.c"
       |> Command.arg "--rewrite"
       |> Command.stdout "build/egraph-rewrite.txt")
  -- Schema codegen (design §4.2): `gen/C/Schema.wiz` is the checked-in output of this
  -- command, and `schema-check` (phony) refuses a stale one.
  |> Package.command (Command.new "schema" (Tool.exe "scry-schema")
       |> Command.input "grammars/tree-sitter-c/node-types.json"
       |> Command.stdout "build/Schema.wiz")
  |> Package.phony (Command.new "schema-check" (Tool.exe "scry-schema")
       |> Command.arg "--check"
       |> Command.input "gen/C/Schema.wiz"
       |> Command.input "grammars/tree-sitter-c/node-types.json")
  -- Resource-limit regressions (findings scrydos-01/02): a few-MiB file must stay
  -- below 20x its size in peak RSS, and 16/64/128/256 `a++;` statements must each
  -- finish inside a small wall-clock budget. Manual, because it runs the built CLI over
  -- generated multi-MiB inputs: `grail build dos-check` (CI's bench workflow runs it).
  |> Package.command (Command.new "dos-check" (Tool.path "python3")
       |> Command.arg "scripts/dos-check.py"
       |> Command.arg "--scry"
       |> Command.arg ".grail/bin/scry"
       |> Command.uses (Tool.exe "scry")
       |> Command.manual)
  -- The C parse/lower fuzz campaign's replay: every minimised regression at the
  -- cap and budget in `tests/fixtures/fuzz-regression/manifest.json`. Manual for the
  -- same reason (it runs the built CLI); the CI bench workflow runs it and the
  -- bounded `--ci` profile.
  |> Package.command (Command.new "fuzz-regressions" (Tool.path "python3")
       |> Command.arg "scripts/fuzz-lower.py"
       |> Command.arg "--regressions-only"
       |> Command.uses (Tool.exe "scry")
       |> Command.manual)
  |> Package.command (Command.new "fuzz-ci" (Tool.path "python3")
       |> Command.arg "scripts/fuzz-lower.py"
       |> Command.arg "--ci"
       |> Command.arg "--iterations"
       |> Command.arg "10"
       |> Command.arg "--no-write-fixtures"
       |> Command.uses (Tool.exe "scry")
       |> Command.manual)
