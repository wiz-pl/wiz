import Json
import Scry.AnalysisFile
import Scry.Report
import Scry.ReportCmd
import Scry.Rules
import Web.EditorModel
import Web.Source.Facts
import Web.Source.Model
import Web.Source.Span

/-!
# Scry.SourceBundle: the source reader's bundle, for any front end

`scry web` exports the reader (`web/source-app.js`, `source-static.js`,
`lib/Web/Source/**`) from a `*.c` walk: `index.html` and `data/{manifest,files,findings}.json`
plus one `data/f/<fileId>.json` per file. This module is that export **without the C walk
and without the host files**: the models, the JSON, and the per-file writer, so a front
end with its own discovery — `scry cs`, with its `.cs` walk, `.csproj`/`.sln` handling
and C# lowering — writes data the same reader decodes.

**One pipeline per file.** `Scry.reportFileOf` (C, through `Scry.analyzeFile`) and
`Scry.Cs.reportFileOf` (C#, through `Scry.CsLower` and the rule pack) both build an
`Scry.ReportFile`; `Scry.bundleModelOf` (one file) and `Scry.bundleWriteData` (the
tables) turn them into the reader's data. Findings, spans, fact rows and node numbering are therefore the same code for
both languages (`Scry.webFactsOf`'s `sink` and `flow` rows), and a fact kind is data,
not a branch: the C# export adds `ast` rows for the infotree, and the info view renders
them through the same `columns` list a `sink` row uses.

**One span conversion.** `Scry.Origin` is 1-based code-point line/column; every span
written here is UTF-16 (`Web.Source.Span`). `Scry.webSpanOfOrigin` is the only
conversion, and it takes the per-file `Web.EditorModel.PositionIndex`, so both languages
agree about a non-BMP character.

**Determinism.** Files come in the order the caller's walk produced (every walk sorts);
findings are sorted by semantic id; a fact's node is its position in its file's table.
No timestamp, machine name or elapsed time is written.
-/

-- ## Literals

/-- The tool string both exports name in their manifest. -/
def Scry.sourceTool : String := "scry 0.1.0-dev (S1)"

/-- A file's language as the reader names it (`source-app.js`'s highlighter switches on
it): `c`, `csharp`, `wiz`, or `text`. -/
def Scry.webLanguage (path : String) : String :=
  match String.endsWith path ".cs" with
  | .true => "csharp"
  | .false => match String.endsWith path ".c" with
    | .true => "c"
    | .false => match String.endsWith path ".h" with
      | .true => "c"
      | .false => match String.endsWith path ".wiz" with
        | .true => "wiz"
        | .false => "text"

-- ## Small helpers

/-- The UTF-8 length of a code point. -/
def Scry.webUtf8Len (c : Nat) : Nat :=
  match Nat.lt c 0x80 with
  | .true => 1
  | .false => match Nat.lt c 0x800 with
    | .true => 2
    | .false => match Nat.lt c 0x10000 with
      | .true => 3
      | .false => 4

/-- The UTF-8 size of a string (the `bytes` field of the file table). -/
def Scry.webUtf8Size (s : String) : Nat :=
  List.foldl (fun acc c => acc + Scry.webUtf8Len (Char.code c)) 0 (String.chars s)

/-- A `Source.FactRow` column by name, or `""`. -/
def Scry.webColumn (r : Source.FactRow) (key : String) : String :=
  match List.find (fun p => String.eq p.1 key) r.columns with
  | .some p => p.2
  | .none => ""

/-- The file with `id`, if the bundle has one. -/
def Scry.webFileOf (files : List Source.File) (id : String) : Option Source.File :=
  List.find (fun f => String.eq f.id id) files

/-- The index of the file with `id`, if it is in the bundle. -/
def Scry.webIndexOf (files : List Source.File) (id : String) :
    Option EditorModel.PositionIndex :=
  match Scry.webFileOf files id with
  | .some f => .some (EditorModel.index f.text)
  | .none => .none

/-- Insert a finding into a list ordered by semantic id (stable for equal ids). -/
def Scry.webInsertById (f : Source.Finding) : List Source.Finding → List Source.Finding
  | .nil => List.cons f .nil
  | .cons g rest => match String.lt f.id g.id with
    | .true => List.cons f (List.cons g rest)
    | .false => List.cons g (Scry.webInsertById f rest)

/-- Findings sorted by semantic id: the bundle's order, independent of line numbers. -/
def Scry.webSortById (fs : List Source.Finding) : List Source.Finding :=
  List.foldl (fun acc f => Scry.webInsertById f acc) (.nil : List Source.Finding) fs

/-- `[["key","value"], …]` for the JSON columns field. -/
def Scry.webColumnsJson (cs : List (String × String)) : Json :=
  Json.mkArr (List.map (fun p => Json.mkArr [Json.mkStr p.1, Json.mkStr p.2]) cs)

/-- A span as `{"start","stop"}`. -/
def Scry.webSpanJson (s : Source.Span) : Json :=
  Json.mkObj [("start", Json.ofNat s.start), ("stop", Json.ofNat s.stop)]

/-- The 1-based `LINE:COL` of an offset. -/
def Scry.webLineColumn (i : EditorModel.PositionIndex) (n : Nat) : Nat × Nat :=
  let p := Source.Span.positionOf i n;
  (p.1 + 1, p.2 + 1)

-- ## The models

/-- A report origin (1-based code points) as a UTF-16 span; `line = 0` is unlocated and
stays an empty span at the start (never a mark on the first character). -/
def Scry.webSpanOfOrigin (i : EditorModel.PositionIndex)
    (line column endLine endColumn : Nat) : Source.Span :=
  match Nat.beq line 0 with
  | .true => Source.Span.at 0
  | .false => Source.Span.ofOrigin i line column endLine endColumn

/-- The `flow` facts of a finding: one row per located path step. `n` is the next node
number; the result is the rows (in path order) and the number after them. -/
def Scry.webFlowFactsGo (i : EditorModel.PositionIndex) (fileId : String)
    (f : Source.Finding) : List Scry.ReportStep → Nat → List Source.FactRow →
    List Source.FactRow × Nat
  | .nil, n, acc => (List.reverse acc, n)
  | .cons s rest, n, acc => match Nat.beq s.line 0 with
    | .true => Scry.webFlowFactsGo i fileId f rest n acc
    | .false =>
      let span := Scry.webSpanOfOrigin i s.line s.column s.endLine s.endColumn;
      -- The path's last step is the sink itself: the `sink` row already carries that
      -- span, so a second row there would make the info view show the same node twice.
      match Bool.and (Nat.beq span.start f.span.start) (Nat.beq span.stop f.span.stop) with
      | .true => Scry.webFlowFactsGo i fileId f rest n acc
      | .false =>
        let row := Source.FactRow.mk "flow" (String.append "n" (Nat.repr n)) fileId span
          [ ("kind", s.kind)
          , ("func", s.func)
          , ("rule", f.rule)
          , ("finding", f.id)
          ];
        Scry.webFlowFactsGo i fileId f rest (n + 1) (List.cons row acc)

/-- The facts a finding contributes: one `sink` row and one `flow` row per located path
step. `base` is the row's position in the file's table, so it is stable across a rebuild. -/
def Scry.webFactsOf (i : EditorModel.PositionIndex) (fileId : String) (base : Nat)
    (f : Source.Finding) (steps : List Scry.ReportStep) : List Source.FactRow × Nat :=
  let sink := Source.FactRow.mk "sink" (String.append "n" (Nat.repr base)) fileId f.span
    [ ("rule", f.rule)
    , ("severity", f.severity)
    , ("message", f.message)
    , ("derivation", match f.checked with
        | .true => "checked against this EDB"
        | .false => "no certificate")
    , ("finding", f.id)
    ];
  let rest := Scry.webFlowFactsGo i fileId f steps (base + 1) [];
  (List.cons sink rest.1, rest.2)

/-- Build one file's findings and facts, threading the fact node number. -/
def Scry.webFindingsOf (i : EditorModel.PositionIndex) (fileId path : String) :
    List Scry.ReportFinding → Nat → List Source.Finding × List Source.FactRow × Nat
  | .nil, n => ([], [], n)
  | .cons rf rest, n =>
    let span := Scry.webSpanOfOrigin i rf.sinkLine rf.sinkColumn rf.endLine rf.endColumn;
    let finding := Source.Finding.mk rf.id fileId path rf.rule rf.severity rf.message
      span rf.sinkLine rf.sinkColumn rf.checked "";
    let facts := Scry.webFactsOf i fileId n finding rf.steps;
    let tail := Scry.webFindingsOf i fileId path rest facts.2;
    (List.cons finding tail.1, List.append facts.1 tail.2.1, tail.2.2)

/-- A path step with its location replaced (a `Scry.ReindexedOrigin`'s `fixed` span,
which is `(startLine, startColumn, stopLine, stopColumn)`). -/
def Scry.reindexStep (s : Scry.ReportStep) (r : Scry.ReindexedOrigin) : Scry.ReportStep :=
  { s with line := r.fixed.1, column := r.fixed.2.1
  , endLine := r.fixed.2.2.1, endColumn := r.fixed.2.2.2 }

/-- A finding's path steps as the reader places them: `pathSteps` when the front end
supplied located points (C#), else the page's own `steps`; `reindexed` locations applied
step by step (path step `k` is step `2 + k`), `rejected` ones left out (`webFactsOf`
skips a step whose `line` is 0, the same rule a C path's unlocated step gets). -/
def Scry.bundleStepsOf (r : Scry.ReportFinding) : List Scry.ReportStep :=
  let steps := match r.pathSteps with
    | .nil => r.steps
    | _ => r.pathSteps;
  let fixed : List Scry.ReportStep := Scry.mapIdxFrom 0 (fun k s =>
      match List.find (fun x => Nat.beq x.step (Nat.add 2 k)) r.reindexed with
      | .some x => Scry.reindexStep s x
      | .none => s) steps;
  match r.rejected with
  | .nil => fixed
  | _ => Scry.mapIdxFrom 0 (fun k s =>
      match List.find (fun x => Nat.beq x.step (Nat.add 2 k)) r.rejected with
      | .some _ => { s with line := 0, column := 0, endLine := 0, endColumn := 0 }
      | .none => s) fixed

/-- The finding rows of one report file (`Scry.bundleModelOf`'s finding half); `after` is
the number to start this file's fact nodes at (`0` when it is the only source of rows). -/
partial def Scry.bundleFindingsGo (rf : Scry.ReportFile) (i : EditorModel.PositionIndex) :
    List Scry.ReportFinding → Nat → List Source.Finding × List Source.FactRow × Nat
  | .nil, n => ([], [], n)
  | .cons r rest, n =>
    let span := Scry.webSpanOfOrigin i r.sinkLine r.sinkColumn r.endLine r.endColumn;
    let finding := Source.Finding.mk r.id rf.anchor rf.path r.rule r.severity r.message
      span r.sinkLine r.sinkColumn r.checked "";
    let facts := Scry.webFactsOf i rf.anchor n finding (Scry.bundleStepsOf r);
    let tail := Scry.bundleFindingsGo rf i rest facts.2;
    (List.cons finding tail.1, List.append facts.1 tail.2.1, tail.2.2)

/-- A `RejectedOrigin` (a report step whose origin is outside its file) as a reader
finding: the same span rule (`Source.Span.ofOrigin` clamps it into the file), the
severity `error`, and a message saying the step was dropped. It is a *bundle* warning,
not an analysis finding: the analysis ran, but this evidence could not be placed, and a
bundle that silently shortened a path would overstate what it shows. -/
def Scry.bundleRejectionFinding (rf : Scry.ReportFile) (r : Scry.RejectedOrigin) :
    Source.Finding :=
  let i := EditorModel.index rf.source;
  let span := Scry.webSpanOfOrigin i r.line r.column r.endLine r.endColumn;
  -- The id hashes the location, not the moved function's name, so it survives a rename.
  let id := String.append "f_" (Scry.hex16 (Scry.fnv (String.intercalate "|"
    ["scry/unplaced-origin", Scry.normPath rf.path, Nat.repr r.line, Nat.repr r.column])));
  Source.Finding.mk id rf.anchor rf.path
    "scry/unplaced-origin" "error"
    (r.reason ++ " (finding " ++ r.finding ++ ", step " ++ Nat.repr r.step ++ ": "
      ++ r.func ++ ":" ++ Nat.repr r.point ++ ")")
    span r.line r.column .false ""

/-- The finding rows of one report file (`Scry.bundleModelOf`'s finding half); `after` is
the number to start this file's fact nodes at (`0` when it is the only source of rows).
A step the file's source cannot place (`rf.findings`'s `rejected`) becomes a
`scry/unplaced-origin` warning finding rather than a silently shortened path. -/
def Scry.bundleFindingsOf (rf : Scry.ReportFile) (i : EditorModel.PositionIndex)
    (after : Nat) : List Source.Finding × List Source.FactRow × Nat :=
  let own := Scry.bundleFindingsGo rf i rf.findings after;
  let rejected := List.map (Scry.bundleRejectionFinding rf) (List.concat (List.map
    (fun r => r.rejected) rf.findings));
  (List.append own.1 rejected, own.2.1, own.2.2)

/-- One file's reader model from its findings and its fact rows. The facts are numbered
after the finding rows (`after`), so the file's node ids are one sequence.

The findings' facts are `rf.findings`' `sink` rows plus one `flow` row per step the reader
can place, followed by the caller's own rows (`facts`, the C# export's `ast` nodes). A
finding whose `pathSteps` are set (the C# front end's program points) uses those, with the
`reindexed` spans applied in order and a `rejected` one left out; otherwise the page's own
`steps` are used, which is what `scry report` shows. -/
def Scry.bundleModelOf (rf : Scry.ReportFile) (facts : List Source.FactRow) (after : Nat) :
    Source.File × List Source.Finding × List Source.FactRow :=
  let i := EditorModel.index rf.source;
  let file := Source.File.mk rf.anchor rf.path (Scry.webLanguage rf.path) rf.source
    (EditorModel.lineCount i);
  let built := Scry.bundleFindingsOf rf i after;
  (file, built.1, List.append built.2.1 facts)

-- ## JSON writers

/-- A file's metadata row (`data/files.json`, the manifest's table). -/
def Scry.webFileMetaJson (f : Source.File) : Json :=
  Json.mkObj
    [ ("id", Json.mkStr f.id)
    , ("path", Json.mkStr f.path)
    , ("language", Json.mkStr f.language)
    , ("bytes", Json.ofNat (Scry.webUtf8Size f.text))
    , ("lines", Json.ofNat f.lines)
    , ("contentHash", Json.mkStr (Scry.wfHex (Scry.wfFnv f.text)))
    ]

/-- One finding as JSON. `spanText`/`line`/`column` are display fields, so the browser
host needs no line arithmetic of its own. -/
def Scry.webFindingJson (i : EditorModel.PositionIndex) (f : Source.Finding) : Json :=
  let lc := Scry.webLineColumn i f.span.start;
  Json.mkObj
    [ ("id", Json.mkStr f.id)
    , ("fileId", Json.mkStr f.fileId)
    , ("path", Json.mkStr f.path)
    , ("rule", Json.mkStr f.rule)
    , ("severity", Json.mkStr f.severity)
    , ("message", Json.mkStr f.message)
    , ("span", Scry.webSpanJson f.span)
    , ("spanText", Json.mkStr (Source.Span.show i f.span))
    , ("line", Json.ofNat (match Nat.beq f.line 0 with | .true => lc.1 | .false => f.line))
    , ("column", Json.ofNat (match Nat.beq f.column 0 with | .true => lc.2 | .false => f.column))
    , ("checked", Json.mkBool f.checked)
    , ("claimId", Json.mkStr f.claimId)
    ]

/-- One fact row as JSON. -/
def Scry.webFactJson (i : EditorModel.PositionIndex) (r : Source.FactRow) : Json :=
  let lc := Scry.webLineColumn i r.span.start;
  Json.mkObj
    [ ("kind", Json.mkStr r.kind)
    , ("node", Json.mkStr r.node)
    , ("fileId", Json.mkStr r.fileId)
    , ("span", Scry.webSpanJson r.span)
    , ("spanText", Json.mkStr (Source.Span.show i r.span))
    , ("line", Json.ofNat lc.1)
    , ("column", Json.ofNat lc.2)
    , ("columns", Scry.webColumnsJson r.columns)
    ]

/-- The host's one-time payload (`scry.source.bundle-ui/1`): exactly the three tables the
reader's decoder reads. The host assembles it from `data/*.json`; the exporter builds it
here too for the UI trace, so both sides decode the same shape. -/
def Scry.webBundleUiJson (mode tool : String) (files : List Source.File)
    (findings : List Source.Finding) (facts : List Source.FactRow)
    (indexOf : String → Option EditorModel.PositionIndex) : Json :=
  let fileJson : Source.File → Json := fun f =>
    Json.mkObj
      [ ("id", Json.mkStr f.id), ("path", Json.mkStr f.path)
      , ("language", Json.mkStr f.language), ("text", Json.mkStr f.text)
      , ("lines", Json.ofNat f.lines) ];
  let emptyFinding : Source.Finding → Json := fun f =>
    match indexOf f.fileId with
    | .some i => Scry.webFindingJson i f
    | .none => Json.mkObj [("id", Json.mkStr f.id), ("path", Json.mkStr f.path)];
  let emptyFact : Source.FactRow → Json := fun r =>
    match indexOf r.fileId with
    | .some i => Scry.webFactJson i r
    | .none => Json.mkObj [("kind", Json.mkStr r.kind)];
  Json.mkObj
    [ ("schema", Json.mkStr "scry.source.bundle-ui/1")
    , ("mode", Json.mkStr mode)
    , ("tool", Json.mkStr tool)
    , ("files", Json.mkArr (List.map fileJson files))
    , ("findings", Json.mkArr (List.map emptyFinding findings))
    , ("facts", Json.mkArr (List.map emptyFact facts))
    ]

-- ## Writing the data directory

/-- The revision the manifest pins: the tool and every file's text, so two bundles with
the same revision carry the same source (a content identifier, not a signature). -/
def Scry.bundleRevision (tool : String) (files : List Source.File) : String :=
  Scry.wfHex (Scry.wfFnv (String.append tool (String.join
    (List.map (fun f => Scry.wfHex (Scry.wfFnv f.text)) files))))

/-- `data/manifest.json` (`scry.web.bundle/1`): the counts, the file table, the hash
note and the two panel names the reader has. `extra` is the front end's own footer
(`{"language": …, "ast": …}` for C#), so the manifest says what the reader should expect
without a second schema. -/
def Scry.bundleManifestJson (tool revision : String) (files : List Source.File)
    (findings : List Source.Finding) (host framework : List String)
    (runtime : Bool) (extra : List (String × Json)) : Json :=
  let fileMetas := List.map Scry.webFileMetaJson files;
  Json.mkObj (List.append
    [ ("schema", Json.mkStr "scry.web.bundle/1")
    , ("tool", Json.mkStr tool)
    , ("revision", Json.mkStr revision)
    , ("mode", Json.mkStr "static")
    , ("counts", Json.mkObj
        [ ("files", Json.ofNat (List.length files))
        , ("findings", Json.ofNat (List.length findings)) ])
    , ("files", Json.mkArr fileMetas)
    , ("hash", Json.mkObj
        [ ("hash", Json.mkStr "fnv1a64")
        , ("note", Json.mkStr "a content identifier, not a signature") ])
    , ("assets", Json.mkObj
        [ ("host", Json.mkArr (List.map Json.mkStr host))
        , ("framework", Json.mkArr (List.map Json.mkStr framework))
        , ("runtime", Json.mkBool runtime) ])
    , ("panels", Json.mkArr
        [ Json.mkObj [("name", Json.mkStr "findings"), ("kind", Json.mkStr "list")]
        , Json.mkObj [("name", Json.mkStr "info"), ("kind", Json.mkStr "rows")]
        ])
    ] extra)

/-- `data/files.json` (`scry.source.files/1`). -/
def Scry.bundleFilesJson (files : List Source.File) : Json :=
  Json.mkObj
    [ ("schema", Json.mkStr "scry.source.files/1")
    , ("files", Json.mkArr (List.map Scry.webFileMetaJson files))
    ]

/-- `data/findings.json` (`scry.source.findings/1`): a finding whose file is not in the
bundle is dropped, exactly as `scry web` drops it. -/
def Scry.bundleFindingsJson (files : List Source.File) (findings : List Source.Finding) : Json :=
  let rows := List.concat (List.map (fun f =>
      match Scry.webIndexOf files f.fileId with
      | .some i => [Scry.webFindingJson i f]
      | .none => []) findings);
  Json.mkObj
    [ ("schema", Json.mkStr "scry.source.findings/1")
    , ("findings", Json.mkArr rows)
    ]

/-- One `data/f/<id>.json` (`scry.source.file/1`): the source, the file's findings and
its facts (in that order: node ids count the findings first). -/
/-- One file's `data/f/<id>.json` (`scry.source.file/1`). `facts` are the findings' rows
(`sink`, `flow`) and `ast` the tree the file's parse produced, kept as its own list: the
reader draws the two panels from different shapes, and a file whose `ast` is empty says
"no tree" by an empty array rather than by a missing key. -/
def Scry.bundleFileJson (f : Source.File) (findings : List Source.Finding)
    (facts : List Source.FactRow) : Json :=
  let i := EditorModel.index f.text;
  let own := List.filter (fun x => String.eq x.fileId f.id) findings;
  let fs := List.filter (fun r => String.eq r.fileId f.id) facts;
  let trees := List.filter (fun r => Bool.and (String.eq r.fileId f.id)
      (String.eq r.kind "ast")) facts;
  Json.mkObj
    [ ("schema", Json.mkStr "scry.source.file/1")
    , ("id", Json.mkStr f.id)
    , ("path", Json.mkStr f.path)
    , ("language", Json.mkStr f.language)
    , ("source", Json.mkStr f.text)
    , ("lines", Json.ofNat f.lines)
    , ("findings", Json.mkArr (List.map (Scry.webFindingJson i) own))
    , ("facts", Json.mkArr (List.map (Scry.webFactJson i) fs))
    , ("ast", Json.mkArr (List.map (Scry.webFactJson i) trees))
    ]

/-- Create `p` when it does not exist (one level: the caller makes the parents). -/
def Scry.bundleEnsureDir (p : String) : EIO Unit := do
  present ← EIO.lift (FS.exists p);
  match present with
  | .true => do
    isDir ← EIO.lift (FS.isDir p);
    match isDir with
    | .true => EIO.pure ()
    | .false => EIO.fail (p ++ " exists and is not a directory")
  | .false => FS.createDir p

/-- `data/`, `data/f/` and `framework/` (the reader's three directories). -/
def Scry.bundleDirs (out : String) : EIO Unit := do
  Scry.bundleEnsureDir out;
  Scry.bundleEnsureDir (String.append out "/data");
  Scry.bundleEnsureDir (String.append out "/data/f");
  Scry.bundleEnsureDir (String.append out "/framework")

/-- Copy one file; `false` when the source does not exist. -/
def Scry.webCopy (from to : String) : EIO Bool := do
  present ← EIO.lift (FS.isFile from);
  match present with
  | .false => EIO.pure .false
  | .true => do
    text ← FS.readFile from;
    FS.writeFile to text;
    EIO.pure .true

/-- The first `web/` directory that has the host's files, from the current directory up
(or `--assets`). -/
partial def Scry.webFindAssetsGo : List String → EIO (Option String)
  | .nil => EIO.pure .none
  | .cons d rest => do
    present ← EIO.lift (FS.isFile (String.append d "/source-app.js"));
    match present with
    | .true => EIO.pure (.some d)
    | .false => Scry.webFindAssetsGo rest

def Scry.webFindAssets (assets : Option String) : EIO (Option String) :=
  match assets with
  | .some d => do
    present ← EIO.lift (FS.isDir d);
    match present with
    | .true => EIO.pure (.some d)
    | .false => EIO.pure .none
  | .none => Scry.webFindAssetsGo ["web", "../web", "../../web", "../../../web"]

/-- Copy the host's files (`web/source-*` to the bundle root). -/
def Scry.webCopyHostGo (assets out : String) :
    List (String × String) → EIO (List String)
  | .nil => EIO.pure []
  | .cons p rest => do
    ok ← Scry.webCopy (String.append assets (String.append "/" p.1))
      (String.append out (String.append "/" p.2));
    more ← Scry.webCopyHostGo assets out rest;
    EIO.pure (match ok with
      | .true => List.cons p.2 more
      | .false => more)

/-- Copy the framework modules the browser half needs. -/
def Scry.webCopyFrameworkGo (assets out : String) : List String → EIO (List String)
  | .nil => EIO.pure []
  | .cons n rest => do
    ok ← Scry.webCopy (String.append assets (String.append "/framework/" n))
      (String.append out (String.append "/framework/" n));
    more ← Scry.webCopyFrameworkGo assets out rest;
    EIO.pure (match ok with
      | .true => List.cons n more
      | .false => more)

/-- Write one `data/f/<id>.json` per file. A loop in the shape `Scry.emitForStrings`
uses: a `do` block cannot sequence a `List.foldl` of effects as its last statement. -/
partial def Scry.bundleWriteFilesGo (out : String) (findings : List Source.Finding)
    (facts : List Source.FactRow) : List Source.File → EIO Unit
  | .nil => EIO.pure ()
  | .cons f rest => do
    FS.writeFile (String.append out (String.append "/data/f/" (String.append f.id ".json")))
      (String.append (Json.render (Scry.bundleFileJson f findings facts)) "\n");
    Scry.bundleWriteFilesGo out findings facts rest

/-- Write the three index files and one `data/f/<id>.json` per file.

The findings are put in **semantic-id order here**, not by the caller: the tables, each
file's own JSON and the reader's list therefore agree whichever front end built them, and
a C# bundle (whose findings come from the rule pack in its own order) reads the same as a
C one. It is a stable insertion sort over equal ids. -/
def Scry.bundleWriteData (out tool : String) (files : List Source.File)
    (findings0 : List Source.Finding) (facts : List Source.FactRow)
    (host framework : List String) (runtime : Bool) (extra : List (String × Json)) : EIO Unit := do
  let findings : List Source.Finding := Scry.webSortById findings0;
  let manifest := Scry.bundleManifestJson tool (Scry.bundleRevision tool files) files
    findings host framework runtime extra;
  FS.writeFile (String.append out "/data/manifest.json")
    (String.append (Json.render manifest) "\n");
  FS.writeFile (String.append out "/data/files.json")
    (String.append (Json.render (Scry.bundleFilesJson files)) "\n");
  FS.writeFile (String.append out "/data/findings.json")
    (String.append (Json.render (Scry.bundleFindingsJson files findings)) "\n");
  Scry.bundleWriteFilesGo out findings facts files

/-- Warn (on stderr) about a file whose text is large enough that the Wasm reader's
`Json.parse` can exhaust its stack: a single string of about 50 KB failed in a browser
probe, while 10 KB worked. The bundle is still written — the limit is the runtime's
parser, not the data — but the page may show only "Maximum call stack size exceeded". -/
partial def Scry.bundleWarnLarge : List Source.File → EIO Unit
  | .nil => EIO.pure ()
  | .cons f rest => do
    let n := String.length f.text;
    match Nat.lt 40000 n with
    | .true => EIO.lift (IO.ePrintln (String.append "note: "
        (String.append f.path (String.append " is " (String.append (Nat.repr n)
          " characters; the Wasm reader's JSON parser can overflow its stack on a single string of about 50 KB, so this bundle may not mount")))))
    | .false => EIO.pure ();
    Scry.bundleWarnLarge rest

/-- Copy the Loom runtime into a bundle: `--ui` names the `.mjs`, and Emscripten fetches its
`.wasm` **beside it** (`wiz-source-ui.wasm`). Copying only the module makes the browser fetch a
missing `.wasm`, receive the 404 page's `text/html`, and abort with "Response has unsupported
MIME type 'text/html;charset=utf-8' expected 'application/wasm'". The wasm is optional (a
module built without one), so a miss is not an error. -/
def Scry.webCopyUi (src out : String) : EIO Bool := do
  m ← Scry.webCopy src (String.append out "/wiz-source-ui.mjs");
  -- `src` ends in `.mjs`; the wasm is the same stem.
  let wasm := String.append (String.dropEnd 4 src) ".wasm";
  _copiedWasm ← Scry.webCopy wasm (String.append out "/wiz-source-ui.wasm");
  EIO.pure m

/-- The reader's page. The first paint is the reader's SSR; `app.js` mounts the Loom
runtime on it. A missing runtime leaves the SSR in place and one plain reason, never a
blank page. -/
def Scry.bundleIndexHtml (ssr : String) : String :=
  "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">"
  ++ "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
  ++ "<title>scry source</title><link rel=\"stylesheet\" href=\"app.css\"></head>"
  ++ "<body><div id=\"app\" data-wiz-mode=\"static\">" ++ ssr ++ "</div>"
  ++ "<script type=\"module\" src=\"app.js\"></script>"
  ++ "<noscript><p>This reader needs JavaScript for its Loom runtime; the source is in "
  ++ "<code>data/</code>.</p></noscript></body></html>\n"
