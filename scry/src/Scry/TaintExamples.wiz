import Scry.Taint
/-!
# A hand-built taint corpus

The programs here are written with `Scry.Wil`'s builder, not lowered from C. They are the
golden corpus for the `scry-taint` test group (`Tests/ScryTaint.lean`) and exercise one
feature of the prototype each:

* `directFn` — taint through copies and arithmetic (`getenv` -> `copy` -> `add` ->
  `system`);
* `sanitisedFn` — a sanitiser kills the flow (no finding, although a source reaches the
  sink along the CFG);
* `cleanFn` — a source and a sink with no data path between them (no finding);
* `branchFn` — a branch merge: one arm copies the source, the other assigns a constant;
  the merge is tainted through the source arm;
* `loopFn` — the only path to the sink goes around the back edge (the sink is at the loop
  head, before the source in program order), so reaching definitions and taint need a
  fixpoint;
* `fpFn` / `fnFn` — the false-positive / false-negative pair: the first is the
  sanitiser case (a naive "source reaches sink" analysis would flag it), the second
  stores the source through a pointer and reloads it (this prototype's memory blind
  spot, so it misses it);
* `directFn` again is the positive control for the pair: the same shape without a
  sanitiser or memory is reported;
* `taintRewriteFn` — the same flow with an `x + 0` identity (the e-graph rewrite keeps
  the finding), and `taintMaskedFn` — `y = r & 0`, where the checked extraction removes a
  false positive;
* `taintReassignFn` — `x` has two definitions, which blocks the checked extraction (the
  may-equality view cannot justify the candidate), so taint is unchanged.

The comments give each statement's program point (`Scry.Analysis` numbers statements and
terminators per block), so the expected paths in the tests can be read off by hand.
-/

def Scry.tv (n : Nat) : Wil.Var := Wil.var n Wil.i32

/-- `r = getenv(); x = r; one = 1; y = x + one; system(y)`.
Points: 0 source, 1 copy, 2 const, 3 add, 4 sink, 5 return. -/
def Scry.directFn : Wil.Func :=
  let r := Scry.tv 0;
  let x := Scry.tv 1;
  let one := Scry.tv 2;
  let y := Scry.tv 3;
  Wil.func "direct" [] [r, x, one, y]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.copy x r
        , Wil.num one 1
        , Wil.binop y .add x one
        , Wil.call .none "system" [y] ]
        (Wil.ret .none) ]

/-- `r = getenv(); x = r; zero = 0; y = x + zero; system(y)`: the same flow as
`directFn`, but the arithmetic has a constant identity the e-graph layer rewrites
(`x + 0 -> x`). Taint findings must be unchanged by that read-only pass. -/
def Scry.taintRewriteFn : Wil.Func :=
  let r := Scry.tv 0;
  let x := Scry.tv 1;
  let zero := Scry.tv 2;
  let y := Scry.tv 3;
  Wil.func "rewrite" [] [r, x, zero, y]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.copy x r
        , Wil.num zero 0
        , Wil.binop y .add x zero
        , Wil.call .none "system" [y] ]
        (Wil.ret .none) ]

def Scry.taintDirect : Wil.Program := Wil.program [Scry.directFn]
def Scry.taintRewrite : Wil.Program := Wil.program [Scry.taintRewriteFn]

/-- `r = getenv(); z = 0; y = r & z; system(y)`: the mask fixes the value to 0, so the
sink is not attacker-controlled. The naive def-use taint reports one alert (`y` uses the
tainted `r`); the e-graph identity `x & 0 -> 0` proves `y` is the clean `z`, and the
checked extraction drops that alert. This is the "improvement" side of the differential.
Points: 0 source, 1 const, 2 mask, 3 sink, 4 return. -/
def Scry.taintMaskedFn : Wil.Func :=
  let r := Scry.tv 0;
  let z := Scry.tv 1;
  let y := Scry.tv 2;
  Wil.func "masked" [] [r, z, y]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.num z 0
        , Wil.binop y .and r z
        , Wil.call .none "system" [y] ]
        (Wil.ret .none) ]

def Scry.taintMasked : Wil.Program := Wil.program [Scry.taintMaskedFn]

/-- `r = getenv(); z = 0; x = 0; x = r; y = x + z; system(y)`: `x` has two definitions,
so the e-graph's may-equality view cannot say which one `x + z` sees (the identity rule
sees the `0` definition). The checked extraction refuses the candidate `x` (not
single-definition before the statement) and the program is unchanged. Taint is unchanged
too: the `r` definition still reaches the sink.
Points: 0 source, 1 zero, 2 clean constant, 3 tainted copy, 4 identity, 5 sink, 6 return. -/
def Scry.taintReassignFn : Wil.Func :=
  let r := Scry.tv 0;
  let z := Scry.tv 1;
  let x := Scry.tv 2;
  let y := Scry.tv 3;
  Wil.func "reassign" [] [r, z, x, y]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.num z 0
        , Wil.num x 0
        , Wil.copy x r
        , Wil.binop y .add x z
        , Wil.call .none "system" [y] ]
        (Wil.ret .none) ]

def Scry.taintReassign : Wil.Program := Wil.program [Scry.taintReassignFn]

/-- `r = getenv(); s = sanitize(r); system(s)`.
Points: 0 source, 1 sanitiser, 2 sink, 3 return. -/
def Scry.sanitisedFn : Wil.Func :=
  let r := Scry.tv 0;
  let s := Scry.tv 1;
  Wil.func "sanitised" [] [r, s]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.call (.some s) "sanitize" [r]
        , Wil.call .none "system" [s] ]
        (Wil.ret .none) ]

def Scry.taintSanitised : Wil.Program := Wil.program [Scry.sanitisedFn]

/-- `r = getenv(); x = 5; system(x)`.
Points: 0 source, 1 const, 2 sink, 3 return. -/
def Scry.cleanFn : Wil.Func :=
  let r := Scry.tv 0;
  let x := Scry.tv 1;
  Wil.func "clean" [] [r, x]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.num x 5
        , Wil.call .none "system" [x] ]
        (Wil.ret .none) ]

def Scry.taintClean : Wil.Program := Wil.program [Scry.cleanFn]

/-- A branch merge.
Points: block 0 has 0..2 (source, const, const) and terminator 3;
block 1 has 4 (tainted copy) and terminator 5;
block 2 has 6 (clean constant) and terminator 7;
block 3 has 8 (sink) and terminator 9. -/
def Scry.branchFn : Wil.Func :=
  let r := Scry.tv 0;
  let c := Scry.tv 1;
  let zero := Scry.tv 2;
  let x := Scry.tv 3;
  Wil.func "branch" [] [r, c, zero, x]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.num c 1
        , Wil.num zero 0 ]
        (Wil.branch (Wil.condLt zero c) (Wil.mkBlockId 1) (Wil.mkBlockId 2))
    , Wil.block [Wil.copy x r] (Wil.jump (Wil.mkBlockId 3))
    , Wil.block [Wil.num x 42] (Wil.jump (Wil.mkBlockId 3))
    , Wil.block [Wil.call .none "system" [x]] (Wil.ret .none) ]

def Scry.taintBranch : Wil.Program := Wil.program [Scry.branchFn]

/-- A loop whose only tainted path reaches the sink through the back edge.
Points: block 0 has 0,1 and terminator 2;
block 1 (head) has 3 (sink) and terminator 4;
block 2 (body) has 5 (source) and 6 (copy) and terminator 7;
block 3 has terminator 8. -/
def Scry.loopFn : Wil.Func :=
  let zero := Scry.tv 0;
  let c := Scry.tv 1;
  let x := Scry.tv 2;
  let r := Scry.tv 3;
  Wil.func "loop" [] [zero, c, x, r]
    [ Wil.block
        [ Wil.num zero 0
        , Wil.num c 1 ]
        (Wil.jump (Wil.mkBlockId 1))
    , Wil.block
        [ Wil.call .none "system" [x] ]
        (Wil.branch (Wil.condLt zero c) (Wil.mkBlockId 2) (Wil.mkBlockId 3))
    , Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.copy x r ]
        (Wil.jump (Wil.mkBlockId 1))
    , Wil.block [] (Wil.ret .none) ]

def Scry.taintLoop : Wil.Program := Wil.program [Scry.loopFn]

/-- The false-positive side of the pair: the sanitiser case (`fpFn = sanitisedFn`). -/
def Scry.fpFn : Wil.Func := Scry.sanitisedFn

def Scry.taintFp : Wil.Program := Wil.program [Scry.fpFn]

/-- The false-negative side: the source goes through memory.
Points: 0 source, 1 alloc, 2 store, 3 load, 4 sink, 5 return. -/
def Scry.fnFn : Wil.Func :=
  let r := Scry.tv 0;
  let p := Wil.var 1 (.ptr Wil.i32);
  let x := Scry.tv 2;
  Wil.func "throughMemory" [] [r, p, x]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.alloc p 1
        , Wil.store p r
        , Wil.load x p
        , Wil.call .none "system" [x] ]
        (Wil.ret .none) ]

def Scry.taintFn : Wil.Program := Wil.program [Scry.fnFn]

-- ## The memory corpus (points-to and taint through memory)

/-- Two heap objects: the tainted store goes into the first and the sink reads the
**second**. The location sets are disjoint, so this is a *known no-alias*: no finding and
no warning. Points: 0 source, 1 alloc a, 2 alloc b, 3 store a, 4 load b, 5 sink, 6 ret. -/
def Scry.distinctFn : Wil.Func :=
  let r := Scry.tv 0;
  let pa := Wil.var 1 (.ptr Wil.i32);
  let pb := Wil.var 2 (.ptr Wil.i32);
  let x := Scry.tv 3;
  Wil.func "distinct" [] [r, pa, pb, x]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.alloc pa 1
        , Wil.alloc pb 1
        , Wil.store pa r
        , Wil.load x pb
        , Wil.call .none "system" [x] ]
        (Wil.ret .none) ]

def Scry.taintDistinct : Wil.Program := Wil.program [Scry.distinctFn]

/-- Field sensitivity: the tainted store is cell 0, the first sink reads cell 1 (no
flow), the second reads cell 0 (flow). Points: 0 source, 1 alloc, 2 gep 0, 3 store,
4 gep 1, 5 load, 6 clean sink, 7 load cell 0, 8 tainted sink, 9 ret. -/
def Scry.fieldFn : Wil.Func :=
  let r := Scry.tv 0;
  let p := Wil.var 1 (.ptr Wil.i32);
  let q0 := Wil.var 2 (.ptr Wil.i32);
  let q1 := Wil.var 3 (.ptr Wil.i32);
  let y := Scry.tv 4;
  let z := Scry.tv 5;
  Wil.func "fields" [] [r, p, q0, q1, y, z]
    [ Wil.block
        [ Wil.call (.some r) "getenv" []
        , Wil.alloc p 2
        , Wil.gep q0 p 0
        , Wil.store q0 r
        , Wil.gep q1 p 1
        , Wil.load y q1
        , Wil.call .none "system" [y]
        , Wil.load z q0
        , Wil.call .none "system" [z] ]
        (Wil.ret .none) ]

def Scry.taintFields : Wil.Program := Wil.program [Scry.fieldFn]

/-- An indirect call whose function pointer holds a **known** function: the argument
taint reaches the callee's sink. -/
def Scry.indirectKnownCallee : Wil.Func :=
  let v := Scry.tv 0;
  Wil.func "knownSink" [v] []
    [ Wil.block [Wil.call .none "system" [v]] (Wil.ret .none) ]

/-- `t = getenv(); f = &knownSink; f(t)`.
Points: 0 source, 1 function address, 2 indirect call, 3 ret. -/
def Scry.indirectKnownMain : Wil.Func :=
  let f := Wil.var 0 (.ptr (.fn 1 Wil.i32));
  let t := Scry.tv 1;
  Wil.func "indirectKnown" [] [f, t]
    [ Wil.block
        [ Wil.call (.some t) "getenv" []
        , Wil.fnptr f "knownSink"
        , Wil.callIndirect .none f [t] ]
        (Wil.ret .none) ]

def Scry.indirectKnownProgram : Wil.Program :=
  Wil.program [Scry.indirectKnownMain, Scry.indirectKnownCallee]

/-- Memory across calls: `memWriter(p)` stores the source through its parameter,
`memReader(q)` loads through its own and sinks it, and `memMain` passes the same object.
The location taint is program-wide (a summary), so the reader's evaluation sees the
writer's store. -/
def Scry.memWriterFn : Wil.Func :=
  let p := Wil.var 0 (.ptr Wil.i32);
  let r := Scry.tv 1;
  Wil.func "memWriter" [p] [r]
    [ Wil.block [Wil.call (.some r) "getenv" [], Wil.store p r] (Wil.ret .none) ]

def Scry.memReaderFn : Wil.Func :=
  let q := Wil.var 0 (.ptr Wil.i32);
  let x := Scry.tv 1;
  Wil.func "memReader" [q] [x]
    [ Wil.block [Wil.load x q, Wil.call .none "system" [x]] (Wil.ret .none) ]

def Scry.memMainFn : Wil.Func :=
  let p := Wil.var 0 (.ptr Wil.i32);
  Wil.func "memMain" [] [p]
    [ Wil.block
        [ Wil.alloc p 1
        , Wil.call .none "memWriter" [p]
        , Wil.call .none "memReader" [p] ]
        (Wil.ret .none) ]

def Scry.memAcrossProgram : Wil.Program :=
  Wil.program [Scry.memMainFn, Scry.memWriterFn, Scry.memReaderFn]

/-- The demo spec used by the tests and the notes. -/
def Scry.demoSpec : Scry.TaintSpec :=
  Scry.TaintSpec.mk ["getenv", "recv"]
    ["sanitize", "escape_shell"]
    [("system", 0), ("printf", 0)]

/-- The same spec in the line format, to exercise the parser. -/
def Scry.demoSpecText : String :=
  "source getenv\nsource recv\nsanitise sanitize\nsanitise escape_shell\nsink system 0\nsink printf 0\n"
