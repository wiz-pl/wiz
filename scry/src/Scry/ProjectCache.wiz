import Sys
import Text
import Functor
import WordArray
import Scry.CstStore
import Json
import Scry.Identity
import Scry.QuireFindings
/-!
# Scry.ProjectCache: the per-translation-unit parse cache

The project driver's expensive step is tree-sitter parsing plus the native-store copy
(`Scry.Native.parse` → `Scry.CstStore`); `cc -E` and lowering are comparatively cheap.
This module caches the **`scry-cst 1` store** per translation unit, keyed by the source
path, its text and the preprocessing flags, and validates the entry against a digest of
the *actual preprocessed text*. That second check is what makes the cache safe when a
header or a macro changes: a stale entry does not match the digest and is a miss, even if
the outer key did not change. A stale hit therefore cannot silently reuse a tree from
different code.

The cache is a separate directory (`--cache[=DIR]`, default `.scry-project-cache`). Each
entry is `DIR/<key>.tu`, written through a sibling `.tmp` and renamed. A malformed or
truncated entry is `corrupt`; an entry from another format or frontend, or one whose
key/pre-digest does not match, is a `miss`. Both are recomputed and rewritten, so a bad
entry costs a parse, never a wrong result.

The store format (`native/store.c`, `scry-cst 1`) is unchanged. This cache stores the
same text the `scry cst` command writes; it does not add a second serialisation of the
CST.

## What an entry depends on

An entry is reused only when every one of these agrees:

| input | where it is checked |
|---|---|
| the resolved source path, the spelling interned in the CST's path table, and the source text | the outer key |
| the unit's preprocessing flags, in order | the outer key |
| `--allow-errors` and `--keep-system-headers` | the outer key (strictness, and which text the store was built from) |
| the preprocessed text (headers, macros, `-I`, the environment `cc` saw) | the `pre` digest, recomputed from the actual `cc -E` output |
| the entry format | the first line (`Scry.projectCacheMagic`); another format is a **miss**, not corruption |
| the frontend that produced the CST (tree-sitter runtime/grammar, the shim, `Scry.Native`, the `scry-cst` spill, preprocessing/stripping policy) | the `frontend` line (`Scry.projectCacheFrontend`); another frontend is a **miss** |
| the CST body | `scry-cst 1`'s magic, section counts, row widths and the stored byte length |

A rule pack is deliberately **not** keyed: it cannot change the cached CST, and findings
are recomputed from the CST on every run, so a warm cache with a changed pack produces
the new findings (pinned by `scry/tests/project.wiz`). Lowering, points-to and the rule
engine are likewise rerun rather than cached.

The frontend stamp is a constant, not a hash of the grammar sources: an installed
toolchain has no source path to hash, and hashing a 30 MB `parser.c` per translation unit
would cost more than the parse it protects. Bumping the constant is the contract; the
golden pins it.
-/

/-- The findings index's storage backend (see `Scry.QuireFindings`). `json` is the
default: the document a reader can inspect, and the format the driver had before the
index existed. `quire` is the page-backed store (`--cache-backend=quire`). -/
inductive Scry.CacheBackend where
  | json
  | quire

def Scry.CacheBackend.show : Scry.CacheBackend → String
  | .json => "json"
  | .quire => "quire"

def Scry.CacheBackend.ofName (s : String) : Option Scry.CacheBackend :=
  match String.eq s "json" with
  | .true => .some .json
  | .false => match String.eq s "quire" with
    | .true => .some .quire
    | .false => .none

/-- The file extension of a findings index. -/
def Scry.CacheBackend.ext : Scry.CacheBackend → String
  | .json => "json"
  | .quire => "quire"

/-- Cache policy: off, or a directory and a findings-index backend. `--cache-stats`
implies enabled. -/
structure Scry.CacheOpts where
  enabled : Bool
  dir : String
  backend : Scry.CacheBackend

def Scry.CacheOpts.none : Scry.CacheOpts :=
  Scry.CacheOpts.mk .false ".scry-project-cache" .json

/-- Cache policy and statistics. `reason` is `cold`, `hit`, `miss`, `corrupt` or
`disabled` (the first event of the last TU, for the human line). -/
structure Scry.CacheStats where
  enabled : Bool
  dir : String
  hit : Nat
  miss : Nat
  write : Nat
  corrupt : Nat
  /-- TUs examined (hit + miss). -/
  files : Nat
  reason : String

def Scry.CacheStats.empty : Scry.CacheStats :=
  Scry.CacheStats.mk .false "" 0 0 0 0 0 "disabled"

def Scry.CacheStats.enabledWith (dir : String) : Scry.CacheStats :=
  Scry.CacheStats.mk .true dir 0 0 0 0 0 "cold"

def Scry.CacheStats.hitOne (s : Scry.CacheStats) : Scry.CacheStats :=
  Scry.CacheStats.mk s.enabled s.dir (Nat.succ s.hit) s.miss s.write s.corrupt
    (Nat.succ s.files) "hit"

def Scry.CacheStats.missOne (s : Scry.CacheStats) (reason : String) : Scry.CacheStats :=
  let corrupt := match String.eq reason "corrupt" with
    | .true => Nat.succ s.corrupt
    | .false => s.corrupt;
  Scry.CacheStats.mk s.enabled s.dir s.hit (Nat.succ s.miss) s.write corrupt
    (Nat.succ s.files) reason

def Scry.CacheStats.writeOne (s : Scry.CacheStats) : Scry.CacheStats :=
  Scry.CacheStats.mk s.enabled s.dir s.hit s.miss (Nat.succ s.write) s.corrupt s.files
    s.reason

/-- The cache-entry format version. Bump it when `cacheEntryText`/`cacheEntryOf` change;
an entry written by another version is a clean miss and is rewritten. -/
def Scry.projectCacheMagic : String := "scry-project-tu 2"

/-- The frontend stamp of a cached CST: everything outside the preprocessed text that can
change what `Scry.Native.parse` + `Scry.Native.toCstStore` produce for that text. Bump it
in the same commit as any of:

* the tree-sitter runtime (`scry/native/tree-sitter`, v0.27.2), the C grammar
  (`scry/native/tree-sitter-c`, v0.24.2) or its `LANGUAGE_VERSION` (ABI 15);
* `scry/native/ts_shim.c` (the native store layout, flags or error counting);
* `Scry.Native.parse`/`toCstStore` (kind/field id assignment, span conversion);
* the `scry-cst 1` spill (`Scry.CstStore.render`/`ofText`);
* the preprocessing policy that turns `cc -E` output into the `pre` text
  (`Scry.Preproc.preprocess`, `Scry.markerPaths`, `Scry.normalisePath`,
  `Scry.ProjectIO.stripSystem`, `Scry.Project.isSystemPath`).

A stale CST is worse than a reparse, so this is a deliberate version stamp rather than a
guess about the grammar's own version at run time (see the module doc). -/
def Scry.projectCacheFrontend : String := "cst-1 ts-0.27.2 c-0.24.2 abi-15"

/-- One length-prefixed key field: a field that contains the `\u{0}` separator (or the
digit/colon prefix) cannot make two different inputs share a key. -/
def Scry.cacheKeyField (s : String) : String :=
  String.append (Nat.repr (String.length s)) (String.append ":" s)

/-- A cache key: the format salt, the frontend stamp, the resolved source path, the path
the CST was built with (it is interned in the store's path table), the source text, the
flags and the two options that select the cached result. -/
def Scry.cacheKeyFor (frontend path storedPath text : String) (flags : List String)
    (allowErrors keepSystem : Bool) : String :=
  let mode := match allowErrors with | .true => "allow-errors" | .false => "strict";
  let system := match keepSystem with | .true => "keep-system" | .false => "blank-system";
  let fields := List.append [Scry.projectCacheMagic, frontend, path, storedPath, text]
    (List.append flags [mode, system]);
  let body := String.intercalate "\u{0}" (List.map Scry.cacheKeyField fields);
  Nat.repr (Scry.fnv body)

/-- The cache key of a translation unit under this build's frontend. `path` is the
resolved source path and `storedPath` the spelling `Scry.Native.toCstStore` interns. -/
def Scry.cacheKey (path storedPath text : String) (flags : List String)
    (allowErrors keepSystem : Bool) : String :=
  Scry.cacheKeyFor Scry.projectCacheFrontend path storedPath text flags allowErrors
    keepSystem

/-- The validation digest: the preprocessed text (so header/macro changes invalidate an
entry even when the key is unchanged). -/
def Scry.preDigest (pre : String) : String := Nat.repr (Scry.fnv pre)

/-- Create a directory and its missing parents. -/
partial def Scry.mkdirp (dir : String) : EIO Unit :=
  match String.isEmpty dir with
  | .true => EIO.pure ()
  | .false => do
    there ← EIO.lift (FS.exists dir);
    match there with
    | .true => EIO.pure ()
    | .false => do
      let parent := match String.splitOn dir "/" with
        | .nil => ""
        | .cons _ .nil => ""
        | parts => String.intercalate "/" (List.dropLast parts);
      Scry.mkdirp parent;
      FS.createDir dir

/-- The entry path for a key. -/
def Scry.cachePath (dir key : String) : String :=
  String.append dir (String.append "/" (String.append key ".tu"))

/-- The cache entry text. -/
def Scry.cacheEntryText (key pre errors cst : String) : String :=
  Scry.projectCacheMagic ++ "\nfrontend " ++ Scry.projectCacheFrontend
    ++ "\nkey " ++ key ++ "\npre " ++ pre ++ "\nerrors " ++ errors
    ++ "\nbytes " ++ Nat.repr (String.length cst) ++ "\n" ++ cst

/-- Parse a cache entry. Returns `(store, errors)` or a reason: `miss` for an entry
written by another format or frontend (it is recomputed and rewritten, not corruption),
`corrupt` for a malformed or truncated body. -/
def Scry.cacheEntryOf (key pre text : String) :
    Except String (Scry.CstStore × Nat) :=
  match String.splitOn text "\n" with
  | .cons magic rest =>
    match String.eq magic Scry.projectCacheMagic with
    | .false => match String.startsWith magic "scry-project-tu " with
      | .true => .error "miss"
      | .false => .error "corrupt"
    | .true => match rest with
      | .cons frontLine (.cons keyLine (.cons preLine
          (.cons errLine (.cons bytesLine rest2)))) =>
        match String.startsWith frontLine "frontend " with
        | .false => .error "corrupt"
        | .true => match String.eq (String.drop 9 frontLine) Scry.projectCacheFrontend with
          | .false => .error "miss"
          | .true => match String.startsWith keyLine "key " with
            | .false => .error "corrupt"
            | .true => match String.startsWith preLine "pre " with
              | .false => .error "corrupt"
              | .true => match String.startsWith errLine "errors " with
                | .false => .error "corrupt"
                | .true => match String.startsWith bytesLine "bytes " with
                  | .false => .error "corrupt"
                  | .true =>
                    let k := String.drop 4 keyLine;
                    let p := String.drop 4 preLine;
                    let es := String.drop 7 errLine;
                    let bs := String.drop 6 bytesLine;
                    let cst := String.intercalate "\n" rest2;
                    match Bool.and (String.eq k key) (String.eq p pre) with
                    | .false => .error "miss"
                    | .true => match String.parseNat bs with
                      | .none => .error "corrupt"
                      | .some n => match Nat.beq n (String.length cst) with
                        | .false => .error "corrupt"
                        | .true => match String.parseNat es with
                          | .none => .error "corrupt"
                          | .some e => match Scry.CstStore.ofText cst with
                            | .error _ => .error "corrupt"
                            | .ok st => .ok (st, e)
      | _ => .error "corrupt"
  | .nil => .error "corrupt"

/-- Read a cache entry; an absent entry is `cold`, an unreadable one `corrupt` (the run
recomputes instead of failing), and a mismatched one `miss`. -/
def Scry.cacheLoad (dir key pre : String) : EIO (Except String (Scry.CstStore × Nat)) := do
  let p := Scry.cachePath dir key;
  there ← EIO.lift (FS.exists p);
  match there with
  | .false => EIO.pure (.error "cold")
  | .true => do
    textRes ← EIO.lift (FS.readFile p);
    match textRes with
    | .error _ => EIO.pure (.error "corrupt")
    | .ok text => EIO.pure (Scry.cacheEntryOf key pre text)

/-- Write a cache entry atomically (sibling `.tmp`, then rename over the target). A
`.tmp` that is a symbolic link is refused: `FS.writeFile` opens with `O_TRUNC`, so a
committed `<entry>.tmp -> ~/.bashrc` would otherwise truncate the target. -/
def Scry.cacheSave (dir key pre errors cst : String) : EIO Unit := do
  Scry.mkdirp dir;
  let p := Scry.cachePath dir key;
  let tmp := String.append p ".tmp";
  st ← EIO.lift (FS.linkStat tmp);
  match st with
  | .ok s => match s.kind with
    | .symlink => EIO.fail ("cache: " ++ tmp ++ " is a symbolic link; refusing to write through it")
    | _ => EIO.pure ()
  | .error _ => EIO.pure ();
  FS.writeFile tmp (Scry.cacheEntryText key pre errors cst);
  FS.rename tmp p

/-- Overwrite every entry in `dir` with a malformed body (the corruption test). -/
partial def Scry.corruptCacheEntries (dir : String) : List String → EIO Unit
  | .nil => EIO.pure ()
  | .cons name rest => do
    FS.writeFile (String.append dir (String.append "/" name)) "not a cache entry\n";
    Scry.corruptCacheEntries dir rest

/-- The human cache line (`cache: hit=… miss=… …`). -/
def Scry.CacheStats.line (s : Scry.CacheStats) : String :=
  match s.enabled with
  | .false => "cache: disabled"
  | .true => "cache: hit=" ++ Nat.repr s.hit ++ " miss=" ++ Nat.repr s.miss
      ++ " write=" ++ Nat.repr s.write ++ " corrupt=" ++ Nat.repr s.corrupt
      ++ " files=" ++ Nat.repr s.files ++ " reason=" ++ s.reason
      ++ " dir=" ++ s.dir

/-- The JSON object for `--json`/`--cache-stats`. -/
def Scry.CacheStats.json (s : Scry.CacheStats) : Json :=
  Json.mkObj
    [ ("enabled", Json.mkBool s.enabled)
    , ("dir", Json.mkStr s.dir)
    , ("hit", Json.ofNat s.hit)
    , ("miss", Json.ofNat s.miss)
    , ("write", Json.ofNat s.write)
    , ("corrupt", Json.ofNat s.corrupt)
    , ("files", Json.ofNat s.files)
    , ("reason", Json.mkStr s.reason) ]

-- ## The findings index (after a `--taint` run)

/-- What the last findings-index check did. `reason` is `hit`, `cold`, `corrupt` or
`disabled`; `bySeverity` is the in-memory count a query must reproduce. -/
structure Scry.FindingsCacheStats where
  backend : String
  reason : String
  rows : Nat
  bySeverity : List (Nat × Nat)

/-- The human findings-index line (`findings index: backend=quire reason=hit rows=2 …`). -/
def Scry.FindingsCacheStats.line (s : Scry.FindingsCacheStats) : String :=
  "findings index: backend=" ++ s.backend ++ " reason=" ++ s.reason
    ++ " rows=" ++ Nat.repr s.rows
    ++ " bySeverity=" ++ String.intercalate ","
      (List.map (fun p => Nat.repr p.2) s.bySeverity)

/-- `<dir>/findings-<id>.<ext>`: one index per project id and backend, so a backend
switch never reads the other format. -/
def Scry.findingsCachePath (cache : Scry.CacheOpts) (id : String) : String :=
  String.append cache.dir (String.append "/findings-"
    (String.append id (String.append "." (Scry.CacheBackend.ext cache.backend))))

/-- Read the findings index. `error "cold"` when absent, `error "corrupt"` for a
truncated, garbage or stale document; neither is a failure of the run. -/
def Scry.findingsLoad (cache : Scry.CacheOpts) (id : String) :
    EIO (Except String (List Scry.FindingKey)) :=
  let p := Scry.findingsCachePath cache id;
  match cache.backend with
  | .json => do
    loaded ← Scry.fiLoadJson p;
    match loaded with
    | .error e => EIO.pure (.error e)
    | .ok rows => EIO.pure (.ok (List.map Scry.FindingsIndexRow.key rows))
  | .quire => Scry.fiLoadQuire p

/-- Write the findings index. -/
def Scry.findingsSave (cache : Scry.CacheOpts) (id : String)
    (rows : List Scry.FindingsIndexRow) : EIO Unit :=
  let p := Scry.findingsCachePath cache id;
  match cache.backend with
  | .json => Scry.fiSaveJson p rows
  | .quire => Scry.fiSaveQuire p rows

/-- The warm read: `(rows, fingerprint)`. Quire reads the meta and two sentinel records
(a warm run is O(1), not a page walk); JSON parses the document, which is the format's
cost. A missing, truncated or garbage file is a clean `error`. -/
def Scry.findingsProbe (cache : Scry.CacheOpts) (id : String) :
    EIO (Except String (Nat × U64)) :=
  let p := Scry.findingsCachePath cache id;
  match cache.backend with
  | .json => do
    loaded ← Scry.fiLoadJson p;
    match loaded with
    | .error e => EIO.pure (.error e)
    | .ok rows =>
      let ks := List.map Scry.FindingsIndexRow.key rows;
      EIO.pure (.ok (List.length ks, Scry.fiPrint ks))
  | .quire => Scry.fiProbe p

/-- The index hit: how many findings have `severity`. `quire` answers through the
severity index (no primary read); `json` parses and filters the document. -/
def Scry.findingsQuery (cache : Scry.CacheOpts) (id : String) (severity : Nat) :
    EIO (Except String Nat) :=
  let p := Scry.findingsCachePath cache id;
  match cache.backend with
  | .json => Scry.fiCountSeverityJson p severity
  | .quire => Scry.fiCountSeverityQuire p (U32.ofNat severity)

/-- The severity counts of `rows`: the numbers a query must reproduce. -/
def Scry.severityCounts (rows : List Scry.FindingsIndexRow) : List (Nat × Nat) :=
  List.map (fun n => (n, List.length (List.filter (fun r => Nat.beq r.severity n) rows)))
    [0, 1, 2]

/-- Check the findings index for this run, and write it on a cold or stale entry. The
report is never read from the index: the index is a derived projection, so an index miss
cannot change what the analysis reports. A hit requires the same row count and
fingerprint; a stale or corrupt entry is rewritten. -/
def Scry.cacheFindings (cache : Scry.CacheOpts) (id : String)
    (rows0 : List Scry.FindingsIndexRow) : EIO Scry.FindingsCacheStats :=
  let rows := Scry.fiDedupe rows0;
  let want := List.map Scry.FindingsIndexRow.key rows;
  let stats := Scry.FindingsCacheStats.mk (Scry.CacheBackend.show cache.backend) ""
    (List.length rows) (Scry.severityCounts rows);
  match cache.enabled with
  | .false => EIO.pure { stats with reason := "disabled" }
  | .true => do
    loaded ← Scry.findingsProbe cache id;
    let reason := match loaded with
      | .ok pr => match Bool.and (Nat.beq pr.1 (List.length want))
            (UIntN.beq pr.2 (Scry.fiPrint want)) with
        | .true => "hit"
        | .false => "corrupt"
      | .error e => e;
    match String.eq reason "hit" with
    | .true => EIO.pure { stats with reason := reason }
    | .false => do
      Scry.mkdirp cache.dir;
      Scry.findingsSave cache id rows;
      EIO.pure { stats with reason := reason }
