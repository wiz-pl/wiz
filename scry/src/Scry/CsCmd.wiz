import Sys
import Text
import Json
import Scry.Wil
import Scry.Preproc
import Scry.CstStore
import Scry.Native
import Scry.Rules
import Scry.CsCst
import Scry.CsLower
import Scry.SourceBundle
import Scry.TaintCmd
import Web.EditorModel
import Web.Loom
import Web.Source.Facts
import Web.Source.Static
import Scry.WebCmd
import Web.Source.Model
import Web.Source.Span
/-!
# Scry.CsCmd: `scry cs`, the repository driver for C#

`scry taint FILE.c` is one translation unit; `scry project DIR` walks C. This module is
the C# equivalent for a **tree** of `.cs` files: it walks a directory, a `.csproj` or a
`.sln`/`.slnx`, parses every file with tree-sitter-c-sharp, lowers it with `Scry.CsLower`,
runs the rule pack over the merged program, and prints a summary whose **coverage**
section names every file, construct and exclusion that was not fully analysed.

```
scry cs PATH [--json] [--sarif OUT] [--bundle DIR] [--assets DIR]
             [--fail-on error|warning|note] [--rules FILE] [--no-taint]
                   [--ui FILE]
```

`PATH` is a directory, a `.csproj`, a `.sln`/`.slnx`, or a single `.cs` file.

## The reader's bundle (`--bundle DIR`)

`--bundle DIR` also writes the **same static source bundle `scry web` exports for C**
(`Scry.SourceBundle`): `data/{manifest,files,findings}.json` and one
`data/f/<fileId>.json` per file, with the file's source, its findings in UTF-16 spans, its
`sink`/`flow` fact rows, and one `ast` row per node of its tree-sitter parse. The reader
(`web/source-app.js`, `Web.Source.*`) therefore shows a C# tree exactly as it shows a C
tree — the same views, the same answer schema, no C# branch in the reader — and `scry
web`, which reads `*.c` only, refuses a C#-only tree and names this command instead of
writing an empty bundle. `--assets DIR` is the checkout's `web/` (default: the first
`web/` found from here up), whose host files are copied in.

The bundle is deterministic: files in the walk's order, findings sorted by semantic id,
fact node ids counted per file (its findings first, then its `ast` rows), no timestamp
and no absolute path. Two runs over the same tree are byte-identical.

An `ast` fact's columns are `kind`, `title` (the kind, plus the text for value kinds like
an identifier or a literal), `parent` (the parent's node id), `field`, `order` (the
sibling slot), `depth` and `named`. At most `Scry.Cs.astFactCap` (2000) rows are written
per file, the shallowest first, so a large file keeps its tree's skeleton; the manifest's
`ast` object carries the cap and names every file the cap truncated, and the run prints
the total it left out on stderr.

## Exclusions

C# repositories carry generated and vendored trees that are not the user's code. The
walk uses a built-in, `.gitignore`-style rule list (it does not read `.gitignore`):

* any path segment `bin/`, `obj/` or `node_modules/`;
* any hidden directory (a segment starting with `.`);
* a basename ending `.g.cs` or `.Designer.cs`;
* symbolic links.

Every exclusion is counted: the report prints the `.cs` count **before** exclusions and
**after** them, and each rule appears as a coverage row with its count and one example.
An explicitly named `.cs`, `.csproj` or `.sln` is taken as the user's request, so its own
path is not excluded; files discovered *inside* it are. Explicit `<Compile Include="…">`
items in a project are still subject to the rule list, and a missing item is an error row.

For an SDK-style project (no `<Compile Include=` items) the project's directory is
walked. `<Compile Remove=` and `EnableDefaultCompileItems` are not interpreted.

## Coverage rows

Nothing is dropped silently. A row is one of:

* `parse failure` (error): the native grammar reported `ERROR`/`MISSING` nodes, so the
  file's tree is recovery output and the file was **not** lowered. The row's location is
  the first failing node's position and kind (`path:line:col (MISSING identifier)`), and
  there is one row per file: an error is never summed into a single "16 parse failure"
  row, because the operator then knows one file's name and not the other fifteen;
* `unreadable file` (error): an IO error while reading a discovered file;
* a lowering warning (warning): every message `Scry.CsLower` emits is normalised to a
  construct and counted (`lambda body not lowered`, `out/ref argument …`, an unsupported
  statement kind, a field/property initialiser, …);
* `no functions lowered` (warning): a file parsed but produced no method;
* an exclusion (note): the rule, its count and one example path;
* `taint not run …` (note): `--no-taint`, or no rule pack was found.

The process exit status is `Scry.Cs.statusOf`:

* `0` at least one file was lowered, nothing reached `--fail-on`;
* `1` a finding or coverage row reaches `--fail-on` (a parse failure is `error`, a
  lowering/skip row is `warning`, an exclusion is `note`);
* `2` usage or IO (a bad flag, a missing path, an unreadable project/solution);
* `3` nothing could be analysed (no `.cs` file, or every discovered file failed).

The last one distinguishes "no findings" from "did not run": an empty run is not clean.
-/

-- ## Severity and coverage rows

/-- Try an `EIO` action, keeping its failure as a value (the driver must not abort a
whole tree on one file). -/
def Scry.Cs.attempt {A : Type} (x : EIO A) : EIO (Except String A) :=
  IO.bind x (fun r => IO.pure (.ok r))

/-- One line of the report, on standard output. -/
def Scry.Cs.say (s : String) : EIO Unit := EIO.lift (IO.println s)

/-- One line of the report or a note, on standard error. -/
def Scry.Cs.sayErr (s : String) : EIO Unit := EIO.lift (IO.ePrintln s)

/-- `error > warning > note`, the order `--fail-on` and the report use. -/
def Scry.Cs.levelRank : Scry.Severity → Nat
  | .note => 0
  | .warning => 1
  | .error => 2

/-- One diagnostic in the coverage section, with a stable construct name and one
example location. -/
structure Scry.Cs.Diag where
  level : Scry.Severity
  construct : String
  location : String
  /-- The original message (JSON's `detail`; the human report shows `construct`). -/
  detail : String

/-- The result of one discovered file: parsed (and lowered) or failed. `funcs` and
`text` are kept so the driver can build a program and an origin map; the pure report
builders ignore them. `store` is the tree-sitter CST the file was parsed into (empty for
a file that could not be parsed), which `scry cs --bundle` turns into the reader's `ast`
facts (`Scry.Cs.factsOf`). -/
structure Scry.Cs.FileResult where
  path : String
  parseOk : Bool
  parseErrors : Nat
  funcs : List Wil.Func
  text : String
  diags : List Scry.Cs.Diag
  /-- `none` unless the store was asked for: `Facts`, or `Map` when the file's byte spans
  do not index its text (the construction that pairs them checks that). -/
  store : Option (Except String Scry.CstStore)

/-- One aggregate coverage row: a construct, how many times it was seen, one example. -/
structure Scry.Cs.CoverRow where
  level : Scry.Severity
  construct : String
  count : Nat
  example : String

/-- One aggregate finding row: a rule with its severity, count and one sink location. -/
structure Scry.Cs.FindingRow where
  rule : String
  severity : Scry.Severity
  count : Nat
  example : String

/-- What the walk found. `files` is `(path relative to the target root, path on disk)`.
`excludedCount` counts `.cs` files under excluded directories and files (a pre-exclusion
total); `excludedRules` is `(rule, count, example)`. -/
structure Scry.Cs.Walk where
  files : List (String × String)
  excludedCount : Nat
  excludedRules : List (String × Nat × String)
  /-- `(path, message)` for a directory that could not be listed. -/
  errors : List (String × String)

def Scry.Cs.Walk.empty : Scry.Cs.Walk := Scry.Cs.Walk.mk .nil 0 .nil .nil

/-- Add one excluded `.cs` file to a rule's row (or start the row). -/
def Scry.Cs.bumpRule (rule ex : String) : List (String × Nat × String) → List (String × Nat × String)
  | .nil => .cons (rule, 1, ex) .nil
  | .cons (r, n, e) rest => match String.eq r rule with
    | .true => .cons (r, Nat.succ n, e) rest
    | .false => .cons (r, n, e) (Scry.Cs.bumpRule rule ex rest)

def Scry.Cs.Walk.addExcluded (w : Scry.Cs.Walk) (rule rel : String) : Scry.Cs.Walk :=
  { w with excludedCount := Nat.succ w.excludedCount,
    excludedRules := Scry.Cs.bumpRule rule rel w.excludedRules }

def Scry.Cs.bumpRuleN (rule ex : String) (n : Nat) :
    List (String × Nat × String) → List (String × Nat × String)
  | .nil => .cons (rule, n, ex) .nil
  | .cons (r, k, e) rest => match String.eq r rule with
    | .true => .cons (r, Nat.add k n, e) rest
    | .false => .cons (r, k, e) (Scry.Cs.bumpRuleN rule ex n rest)

def Scry.Cs.Walk.addExcludedN (w : Scry.Cs.Walk) (rule rel : String) (n : Nat) :
    Scry.Cs.Walk :=
  match n with
  | .zero => w
  | _ => { w with excludedCount := Nat.add w.excludedCount n,
      excludedRules := Scry.Cs.bumpRuleN rule rel n w.excludedRules }

def Scry.Cs.Walk.addError (w : Scry.Cs.Walk) (rel msg : String) : Scry.Cs.Walk :=
  { w with errors := .cons (rel, msg) w.errors }

def Scry.Cs.Walk.addFile (w : Scry.Cs.Walk) (rel full : String) : Scry.Cs.Walk :=
  { w with files := .cons (rel, full) w.files }

/-- Merge two walks (solution/project aggregation). Counts add; per-rule rows merge. -/
def Scry.Cs.Walk.merge (a b : Scry.Cs.Walk) : Scry.Cs.Walk :=
  Scry.Cs.Walk.mk
    (List.append a.files b.files)
    (Nat.add a.excludedCount b.excludedCount)
    (List.foldl (fun rows r => Scry.Cs.bumpRuleN r.1 r.2.2 r.2.1 rows)
      a.excludedRules b.excludedRules)
    (List.append a.errors b.errors)

-- ## Paths and the exclusion rule

def Scry.Cs.baseNameGo : List String → String
  | .nil => ""
  | .cons x .nil => x
  | .cons _ rest => Scry.Cs.baseNameGo rest

def Scry.Cs.baseName (p : String) : String := Scry.Cs.baseNameGo (String.splitOn p "/")

def Scry.Cs.parentDir (p : String) : String :=
  match List.dropLast (String.splitOn p "/") with
  | .nil => "."
  | parts => String.intercalate "/" parts

/-- `p` without a trailing `/` (`/` itself is unchanged). -/
def Scry.Cs.trimSlash (p : String) : String :=
  match Bool.and (String.endsWith p "/") (Nat.lt 1 (String.length p)) with
  | .true => String.take (Nat.sub (String.length p) 1) p
  | .false => p

def Scry.Cs.join (dir name : String) : String :=
  match String.eq dir "." with
  | .true => name
  | .false => Path.join dir name

/-- `full` relative to `root` (both without trailing slashes). `full` is returned when it
is outside `root`. -/
def Scry.Cs.relTo (root full : String) : String :=
  let r := Scry.Cs.trimSlash root;
  match String.startsWith full (String.append r "/") with
  | .true => String.drop (Nat.succ (String.length r)) full
  | .false => full

def Scry.Cs.isHiddenSegment (s : String) : Bool :=
  Bool.and (String.startsWith s ".") (Bool.not (Bool.or (String.eq s ".") (String.eq s "..")))

/-- The exclusion rule for a path relative to the target root, or `none`. The first
matching rule wins: `bin/`, `obj/`, `node_modules/`, a hidden directory, then the
generated basenames. -/
partial def Scry.Cs.exclusionSegs : List String → Option String
  | .nil => .none
  | .cons s rest =>
    match String.eq s "bin" with
    | .true => .some "bin/"
    | .false => match String.eq s "obj" with
      | .true => .some "obj/"
      | .false => match String.eq s "node_modules" with
        | .true => .some "node_modules/"
        | .false => match Scry.Cs.isHiddenSegment s with
          | .true => .some "hidden directory"
          | .false => Scry.Cs.exclusionSegs rest

/-- The built-in rule list. It is deliberately not a `.gitignore` reader: a checked-in
ignore file can name anything, and a first run must be explainable from the source. -/
def Scry.Cs.exclusionOf (rel : String) : Option String :=
  match Scry.Cs.exclusionSegs (String.splitOn rel "/") with
  | .some r => .some r
  | .none =>
    let base := Scry.Cs.baseName rel;
    match String.endsWith base ".Designer.cs" with
    | .true => .some "*.Designer.cs"
    | .false => match String.endsWith base ".g.cs" with
      | .true => .some "*.g.cs"
      | .false => .none

-- ## Counting and walking

/-- `.cs` files under an excluded directory, and one example (relative). Counting does
not read a file, only lists directories, so the "before exclusions" total is real. -/
structure Scry.Cs.CountAcc where
  n : Nat
  first : Option String

mutual
partial def Scry.Cs.countNames (dir rel : String) : List String → Scry.Cs.CountAcc →
    EIO Scry.Cs.CountAcc
  | .nil, acc => EIO.pure acc
  | .cons name rest, acc => do
    let full := Scry.Cs.join dir name;
    let relC := match String.isEmpty rel with
      | .true => name
      | .false => String.append rel (String.append "/" name);
    st ← Scry.Cs.attempt (FS.linkStat full);
    match st with
    | .error _ => Scry.Cs.countNames dir rel rest acc
    | .ok s => match s.kind with
      | .dir => do
        acc1 ← Scry.Cs.countDir full relC acc;
        Scry.Cs.countNames dir rel rest acc1
      | .file => match String.endsWith name ".cs" with
        | .true => Scry.Cs.countNames dir rel rest
            (Scry.Cs.CountAcc.mk (Nat.succ acc.n)
              (match acc.first with
                | .none => .some relC
                | .some f => .some f))
        | .false => Scry.Cs.countNames dir rel rest acc
      | _ => Scry.Cs.countNames dir rel rest acc

partial def Scry.Cs.countDir (dir rel : String) (acc : Scry.Cs.CountAcc) :
    EIO Scry.Cs.CountAcc := do
  names ← Scry.Cs.attempt (FS.listDir dir);
  match names with
  | .error _ => EIO.pure acc
  | .ok ns => Scry.Cs.countNames dir rel ns acc
end

/-- A directory's entries: files are kept when they are `.cs` and not excluded;
excluded directories are counted (never descended for analysis) and excluded files are
counted with their rule. -/
mutual
partial def Scry.Cs.walkNames (dir rel : String) : List String → Scry.Cs.Walk →
    EIO Scry.Cs.Walk
  | .nil, acc => EIO.pure acc
  | .cons name rest, acc => do
    let full := Scry.Cs.join dir name;
    let relC := match String.isEmpty rel with
      | .true => name
      | .false => String.append rel (String.append "/" name);
    st ← Scry.Cs.attempt (FS.linkStat full);
    match st with
    | .error e => Scry.Cs.walkNames dir rel rest (acc.addError relC e)
    | .ok s => match s.kind with
      | .symlink => match String.endsWith name ".cs" with
        | .true => Scry.Cs.walkNames dir rel rest
            (acc.addExcluded "symbolic link" relC)
        | .false => Scry.Cs.walkNames dir rel rest acc
      | .dir => match Scry.Cs.exclusionOf relC with
        | .some rule => do
          counted ← Scry.Cs.countDir full relC (Scry.Cs.CountAcc.mk 0 .none);
          let ex := match counted.first with
            | .some f => f
            | .none => relC;
          Scry.Cs.walkNames dir rel rest (acc.addExcludedN rule ex counted.n)
        | .none => do
          acc1 ← Scry.Cs.walkDir full relC acc;
          Scry.Cs.walkNames dir rel rest acc1
      | .file => match String.endsWith name ".cs" with
        | .false => Scry.Cs.walkNames dir rel rest acc
        | .true => match Scry.Cs.exclusionOf relC with
          | .some rule => Scry.Cs.walkNames dir rel rest (acc.addExcluded rule relC)
          | .none => Scry.Cs.walkNames dir rel rest (acc.addFile relC full)
      | _ => Scry.Cs.walkNames dir rel rest acc

partial def Scry.Cs.walkDir (dir rel : String) (acc : Scry.Cs.Walk) : EIO Scry.Cs.Walk := do
  names ← Scry.Cs.attempt (FS.listDir dir);
  match names with
  | .error e => EIO.pure (acc.addError (match String.isEmpty rel with | .true => dir | .false => rel) e)
  | .ok ns => Scry.Cs.walkNames dir rel ns acc
end

/-- Reverse the accumulator lists into display order. -/
def Scry.Cs.Walk.finish (w : Scry.Cs.Walk) : Scry.Cs.Walk :=
  { w with files := List.reverse w.files, errors := List.reverse w.errors }

def Scry.Cs.walkTree (dir : String) : EIO Scry.Cs.Walk := do
  w ← Scry.Cs.walkDir dir "" Scry.Cs.Walk.empty;
  EIO.pure w.finish

/-- The pure heart of the walk: apply the exclusion rule to a list of
`(relative path, path on disk)`. The driver's `walkTree` reaches the same rows through
`FS.listDir`; the Lean tests, which cannot call `FS` externals, pass the listing in.
`before` (`found + excludedCount`) and each rule's count are the same either way. -/
def Scry.Cs.walkOfPaths (paths : List (String × String)) : Scry.Cs.Walk :=
  List.foldl (fun w p => match Scry.Cs.exclusionOf p.1 with
    | .some rule => w.addExcluded rule p.1
    | .none => w.addFile p.1 p.2) Scry.Cs.Walk.empty paths

-- ## Project and solution discovery

/-- The parts of `line` inside double quotes, in order (the odd-indexed fields of
`String.splitOn line "\""`). -/
partial def Scry.Cs.oddParts (i : Nat) : List String → List String
  | .nil => .nil
  | .cons x rest => match Nat.beq (Nat.mod i 2) 1 with
    | .true => .cons x (Scry.Cs.oddParts (Nat.succ i) rest)
    | .false => Scry.Cs.oddParts (Nat.succ i) rest

def Scry.Cs.quotedParts (line : String) : List String :=
  Scry.Cs.oddParts 0 (String.splitOn line "\"")

def Scry.Cs.slashes (p : String) : String := String.replace p "\\" "/"

def Scry.Cs.hasWildcard (p : String) : Bool := String.contains p "*"

/-- The `<Compile Include="…">` items of a project file (empty for an SDK-style
project, whose default items are the files beside it). -/
def Scry.Cs.csprojIncludes (text : String) : List String :=
  List.concat (List.map (fun line =>
    match Bool.and (String.contains line "<Compile") (String.contains line "Include=") with
    | .true => List.filter (fun v => String.endsWith v ".cs") (Scry.Cs.quotedParts line)
    | .false => (.nil : List String)) (String.splitOn text "\n"))

/-- The `.csproj` paths named by a solution (`.sln` and `.slnx` both quote them). -/
def Scry.Cs.slnProjects (text : String) : List String :=
  List.concat (List.map (fun line =>
    List.filter (fun v => String.endsWith v ".csproj")
      (List.map Scry.Cs.slashes (Scry.Cs.quotedParts line))) (String.splitOn text "\n"))

mutual
/-- The files of one project, relative to `root`. `projectFull` may be outside `root`
(a project referenced by a solution above it). -/
partial def Scry.Cs.projectFiles (root projectFull : String) : EIO Scry.Cs.Walk := do
  let dir := Scry.Cs.parentDir projectFull;
  let relDir := Scry.Cs.relTo root dir;
  text ← Scry.Cs.attempt (FS.readFile projectFull);
  match text with
  | .error e => EIO.pure (Scry.Cs.Walk.empty.addError relDir e)
  | .ok body =>
    let items := List.map (fun p => String.trim (Scry.Cs.slashes p))
      (Scry.Cs.csprojIncludes body);
    match items with
    | .nil => Scry.Cs.walkDir dir relDir Scry.Cs.Walk.empty
    | _ => match List.any Scry.Cs.hasWildcard items with
      | .true => Scry.Cs.walkDir dir relDir Scry.Cs.Walk.empty
      | .false => Scry.Cs.includeItems root dir items Scry.Cs.Walk.empty

/-- Explicit `<Compile Include>` files: read from `dir`, reported relative to `root`.
The exclusion list still applies, and a missing include is an error row. -/
partial def Scry.Cs.includeItems (root dir : String) : List String → Scry.Cs.Walk →
    EIO Scry.Cs.Walk
  | .nil, acc => EIO.pure acc
  | .cons item rest, acc => do
    let full := match String.startsWith item "/" with
      | .true => item
      | .false => Scry.Cs.join dir item;
    let rel := Scry.Cs.relTo root full;
    there ← EIO.lift (FS.isFile full);
    match there with
    | .false => Scry.Cs.includeItems root dir rest
        (acc.addError rel "compile item not found")
    | .true => match Scry.Cs.exclusionOf rel with
      | .some rule => Scry.Cs.includeItems root dir rest (acc.addExcluded rule rel)
      | .none => Scry.Cs.includeItems root dir rest (acc.addFile rel full)
end

mutual
/-- The files of a solution: each `.csproj` it names, or the solution's directory when
it names none. -/
partial def Scry.Cs.solutionFiles (slnFull : String) : EIO Scry.Cs.Walk := do
  let root := Scry.Cs.parentDir slnFull;
  text ← Scry.Cs.attempt (FS.readFile slnFull);
  match text with
  | .error e => EIO.pure (Scry.Cs.Walk.empty.addError slnFull e)
  | .ok body =>
    let projects := Scry.Cs.slnProjects body;
    match projects with
    | .nil => Scry.Cs.walkDir root "" Scry.Cs.Walk.empty
    | _ => Scry.Cs.solutionProjects root root projects Scry.Cs.Walk.empty

partial def Scry.Cs.solutionProjects (root dir : String) : List String → Scry.Cs.Walk →
    EIO Scry.Cs.Walk
  | .nil, acc => EIO.pure acc
  | .cons p rest, acc => do
    let full := match String.startsWith p "/" with
      | .true => p
      | .false => Scry.Cs.join dir p;
    there ← EIO.lift (FS.isFile full);
    match there with
    | .false => Scry.Cs.solutionProjects root dir rest
        ({ acc with errors := List.append acc.errors [(full, "project not found")] })
    | .true => do
      w ← Scry.Cs.projectFiles root full;
      Scry.Cs.solutionProjects root dir rest (acc.merge w)
end

/-- The display root and kind of a target path. -/
structure Scry.Cs.Target where
  root : String
  kind : String
  walk : Scry.Cs.Walk

/-- Discover the `.cs` files of a directory, project, solution or single file. The
target's own path is not excluded; discovered files are. -/
def Scry.Cs.discover (path : String) : EIO Scry.Cs.Target := do
  isDir ← EIO.lift (FS.isDir path);
  match isDir with
  | .true => do
    w ← Scry.Cs.walkTree path;
    EIO.pure (Scry.Cs.Target.mk path "directory" w)
  | .false => do
    isFile ← EIO.lift (FS.isFile path);
    match isFile with
    | .false => EIO.fail ("no such file or directory: " ++ path)
    | .true =>
      let base := Scry.Cs.baseName path;
      let root := Scry.Cs.parentDir path;
      match String.endsWith base ".csproj" with
      | .true => do
        w ← Scry.Cs.projectFiles root path;
        EIO.pure (Scry.Cs.Target.mk root "project" w)
      | .false => match String.endsWith base ".sln", String.endsWith base ".slnx" with
        | .true, _ => do
          w ← Scry.Cs.solutionFiles path;
          EIO.pure (Scry.Cs.Target.mk root "solution" w)
        | _, .true => do
          w ← Scry.Cs.solutionFiles path;
          EIO.pure (Scry.Cs.Target.mk root "solution" w)
        | _, _ => match String.endsWith base ".cs" with
          | .true => EIO.pure (Scry.Cs.Target.mk root "file"
              (Scry.Cs.Walk.empty.addFile base path))
          | .false => EIO.fail ("not a directory, .cs, .csproj, .sln or .slnx: " ++ path)

-- ## Lowering and results

/-- `full` as the reader's bundle names it: relative to the directory the target's report
was about, so **the same tree read two ways names one file twice**. `scry cs DIR` and
`scry web DIR` both name `X/Y.cs` as `X/Y.cs` (not `DIR/X/Y.cs`), because the walk hands
the bundle a path relative to the root; a caller that starts the export from the
directory then gets the same row back. A target that is one file keeps its own spelling;
a directory target's absolute `full` path becomes relative to the directory (as the user
named it, so `a/../b` stays readable), and a trailing `/` on the directory is ignored, so
`scry cs DIR/` and `scry cs DIR` write the same bundle. A file outside the directory keeps
its path: a C# project can name a source above its own directory, and the bundle cannot
make one up. -/
def Scry.Cs.readerPath (root full : String) : String :=
  match String.startsWith root "/" with
  | .false =>
    let r := Scry.Cs.trimSlash root;
    let here := match String.eq r "/" with
      | .true => root
      | .false => r;
    match String.startsWith full (String.append here "/") with
    | .true => String.drop (Nat.succ (String.length here)) full
    | .false => full
  | .true =>
    match String.startsWith full "/" with
    | .true => Scry.Cs.relTo (Scry.Cs.trimSlash root) full
    | .false => full

/-- The UTF-16 offset of the character at UTF-8 byte `b`, or `none` when `b` is not the
start of a character of `text`. The parse's spans are UTF-8 bytes and the reader's are
UTF-16 units, and `Web.EditorModel` is the only line table between them. -/
partial def Scry.Cs.unitOfByteGo (b : Nat) : List Char → Nat → Nat → Option Nat
  | .nil, _, _ => .none
  | .cons c rest, u, byte =>
      let n := Scry.webUtf8Len (Char.code c);
      match Nat.beq byte b with
      | .true => .some u
      | .false =>
        let step := match n with
          | 0 => 1
          | _ => n;
        Scry.Cs.unitOfByteGo b rest (Nat.add u (List.length (EditorModel.unitsOf c)))
          (Nat.add byte step)

/-- The UTF-16 offset of the character at UTF-8 byte `b`. -/
def Scry.Cs.unitOfByte (text : String) (b : Nat) : Option Nat :=
  Scry.Cs.unitOfByteGo b (String.chars text) 0 0

/-- The reader's span for a parse node: `some` when both ends land on characters of
`text`. -/
def Scry.Cs.nodeSpan (text : String) (sp : Scry.Span) : Option Source.Span :=
  match Scry.Cs.unitOfByte text sp.start, Scry.Cs.unitOfByte text sp.stop with
  | .some a, .some b => .some (Source.Span.make a b)
  | _, _ => .none

/-- A node's title for the infotree: its kind, plus its text when its kind holds a value
(an identifier, a literal, an operator), so a method's row is not the whole method and a
`local_variable_declaration` is not its initialiser. The text is sliced by UTF-16 units
through the reader's index and clipped at 40 units: a title is a label, not a copy of the
source. -/
def Scry.Cs.nodeTitle (store : Scry.CstStore) (text : String) (i : Nat) : String :=
  let kind := Scry.CstStore.kindName store i;
  let valueKind : Bool := List.any (fun k => String.eq kind k)
    ["identifier", "integer_literal", "real_literal", "string_literal",
     "verbatim_string_literal", "character_literal", "operator", "predefined_type"];
  match valueKind with
  | .false => kind
  | .true =>
    match Scry.Cs.nodeSpan text (Scry.CstStore.spanOf store i) with
    | .none => kind
    | .some span =>
      let t := EditorModel.slice (EditorModel.index text) span.start span.stop;
      let clipped := match Nat.le 40 (String.length t) with
        | .true => String.append (String.take 40 t) "..."
        | .false => t;
      match String.eq clipped "" with
      | .true => kind
      | .false => kind ++ " " ++ clipped

/-- `i`'s slot among its parent's children (its index in the parent's child list): the
tree order the info view shows a node's siblings in. -/
def Scry.Cs.nodeSlotFrom (i : Nat) : List Scry.NodeId → Nat → Nat
  | .nil, n => n
  | .cons j rest, n => match Nat.beq j.n i with
    | .true => n
    | .false => Scry.Cs.nodeSlotFrom i rest (Nat.succ n)

def Scry.Cs.nodeSlot (store : Scry.CstStore) (p i : Nat) : Nat :=
  Scry.Cs.nodeSlotFrom i (Scry.CstStore.childrenOf store p) 0

/-- `i`'s depth (how many parents it has), or `none` past a 512-level bound: a parse of
broken input could otherwise make this walk loop, and a depth is a display field. The
export sorts `ast` rows by it so the cap in `Scry.Cs.factsOf` keeps the tree's skeleton
(shallow rows) first. -/
partial def Scry.Cs.nodeDepthFrom (store : Scry.CstStore) (fuel n j : Nat) : Option Nat :=
  match fuel with
  | 0 => .none
  | _ => match Scry.CstStore.parentOf store j with
    | .some p => Scry.Cs.nodeDepthFrom store (Nat.sub fuel 1) (Nat.succ n) p.n
    | .none => .some n

def Scry.Cs.nodeDepth (store : Scry.CstStore) (i : Nat) : Option Nat :=
  Scry.Cs.nodeDepthFrom store 512 0 i

-- ## The reader's facts (`--bundle`)

/-- The most `ast` rows written for one file. The info view shows the rows whose span
holds an offset and the tree is read top-down, so the shallowest rows are kept: a huge
file keeps its skeleton (namespaces, types, members, statements) and loses the innermost
expressions. The cap and the truncated count go in the manifest and on stderr, never
applied silently. -/
def Scry.Cs.astFactCap : Nat := 2000

/-- An `ast` fact row for CST node `i`: its `kind` and `title`, its `parent`'s node id
(`""` for the tree's root), its `field` on that arc, its sibling `order` and its `depth`.
`none` when the node's byte span does not land on the reader's text (a non-ASCII byte
before the node's end): the node is left out rather than given a wrong span.

A node whose parent is also left out (its parent's own span is unplaceable, or sits in a
file the reader does not have) gets its parent's id all the same: the reader's tree is
walked from the root by `parent`, so a row whose parent is absent shows up under the root
rather than disappearing, and the row still says which node it belongs to. -/
def Scry.Cs.astFactOf (store : Scry.CstStore) (text fileId : String) (base i : Nat) :
    Option Source.FactRow :=
  match Scry.Cs.nodeSpan text (Scry.CstStore.spanOf store i) with
  | .none => .none
  | .some span =>
    -- A depth past the walk's bound is not 0 (that would sort a deep node to the root
    -- and let the cap drop the skeleton): it keeps its parse order at the deepest slot.
    -- No tree is deeper than the document's node count, and `nodeDepth`'s bound (512) is
    -- far above any real one, so this constant is only a sort key for a broken parse.
    let deep := 1000000;
    let parentOf := Scry.CstStore.parentOf store i;
    let parent := match parentOf with
      | .some p => String.append "n" (Nat.repr (Nat.add base p.n))
      | .none => "";
    let slot := match parentOf with
      | .some p => Scry.Cs.nodeSlot store p.n i
      | .none => 0;
    .some (Source.FactRow.mk "ast" (String.append "n" (Nat.repr (Nat.add base i))) fileId
      span
      [ ("kind", Scry.CstStore.kindName store i)
      , ("title", Scry.Cs.nodeTitle store text i)
      , ("parent", parent)
      , ("field", Scry.CstStore.fieldName store i)
      , ("order", Nat.repr slot)
      , ("depth", Nat.repr (match Scry.Cs.nodeDepth store i with
          | .some d => d
          | .none => deep))
      , ("named", match Scry.CstStore.namedOf store i with
          | .true => "named"
          | .false => "anonymous")
      ])

/-- `a` before `b` for the AST cap: shallower first, then the parse's own node order. -/
def Scry.Cs.astKeyBefore (a b : Nat × Nat) : Bool :=
  match Nat.lt a.1 b.1 with
  | .true => .true
  | .false => match Nat.lt b.1 a.1 with
    | .true => .false
    | .false => Nat.lt a.2 b.2

def Scry.Cs.insertAstKey (k : Nat × Nat) : List (Nat × Nat) → List (Nat × Nat)
  | .nil => List.cons k .nil
  | .cons x rest => match Scry.Cs.astKeyBefore k x with
    | .true => List.cons k (List.cons x rest)
    | .false => List.cons x (Scry.Cs.insertAstKey k rest)

/-- `factsOf`'s row builder: each kept node's `ast` row, in the tree's order. -/
partial def Scry.Cs.astRowsGo (store : Scry.CstStore) (text fileId : String) (base : Nat) :
    List (Nat × Nat) → List Source.FactRow
  | .nil => []
  | .cons k rest => match Scry.Cs.astFactOf store text fileId base k.2 with
    | .some r => List.cons r (Scry.Cs.astRowsGo store text fileId base rest)
    | .none => Scry.Cs.astRowsGo store text fileId base rest

/-- The `ast` rows of one file's parse (the infotree's tree): every placeable node,
shallowest first, at most `Scry.Cs.astFactCap`. The second number is how many rows the
cap left out, which the manifest and the run report. -/
def Scry.Cs.factsOf (store : Scry.CstStore) (text fileId : String) (base : Nat) :
    List Source.FactRow × Nat :=
  let keys := List.foldl (fun acc i =>
      match Scry.Cs.astFactOf store text fileId base i with
      | .some _ => Scry.Cs.insertAstKey
          (match Scry.Cs.nodeDepth store i with
           | .some d => d
           | .none => 0, i) acc
      | .none => acc) (.nil : List (Nat × Nat)) (Scry.range (Scry.CstStore.nodeCount store));
  let rows : List Source.FactRow := Scry.Cs.astRowsGo store text fileId base keys;
  let kept := List.take Scry.Cs.astFactCap rows;
  (kept, Nat.sub (List.length rows) (List.length kept))

-- ## The reader's report (`--bundle`)

/-- The origin of a finding's sink as the page sees it: `none` when the run did not
locate it. -/
def Scry.Cs.sinkOriginOf (m : Scry.OriginMap) (rel : String) (f : Scry.RuleFinding) :
    Scry.Origin :=
  match Scry.originAt m f.func f.sink with
  | .some o => o
  | .none => Scry.Origin.mk rel 0 0 0 0

/-- An empty `List Scry.RejectedOrigin`, spelled as a name so the walk's tuple components
have a type where a bare `[]` literal would leave the element type unconstrained. -/
def Scry.Cs.RejectedOrigin.nil : List Scry.RejectedOrigin := []

/-- `Scry.Cs.placedOf`'s walk: `k` is the index of `sts`'s first step. -/
partial def Scry.Cs.placedGo (i : EditorModel.PositionIndex) (findId : String) :
    List Scry.ReportStep → Nat →
    List Scry.ReindexedOrigin × List Scry.ReindexedOrigin × List Scry.RejectedOrigin
  | .nil, _ => ([], [], Scry.Cs.RejectedOrigin.nil)
  | .cons st rest, k =>
      let tail := Scry.Cs.placedGo i findId rest (Nat.succ k);
      -- A path point with an origin but no end has a one-unit caret, as `ofOrigin` does.
      let span := Scry.webSpanOfOrigin i st.line st.column st.endLine st.endColumn;
      match Nat.beq st.line 0 with
      | .true => (tail.1, tail.2.1, Scry.Cs.RejectedOrigin.nil)
      | .false =>
        -- `Span.ofOrigin` clamps; a span that clamps to nothing at the start of a file
        -- that has text is not a place the reader can underline.
        match Nat.beq span.start span.stop with
        | .true =>
          (tail.1, tail.2.1,
           List.cons (Scry.RejectedOrigin.mk findId (Nat.add 2 k) "" 0 st.line st.column
             st.endLine st.endColumn
             "the path point's origin does not land on a character of this file") tail.2.2)
        | .false =>
          let start := Source.Span.positionOf i span.start;
          let stop := Source.Span.positionOf i span.stop;
          (List.cons (Scry.ReindexedOrigin.mk findId (Nat.add 2 k)
             (st.line, st.column, st.endLine, st.endColumn)
             (Nat.add start.1 1, Nat.add start.2 1, Nat.add stop.1 1, Nat.add stop.2 1))
             tail.1,
           tail.2.1,
           Scry.Cs.RejectedOrigin.nil)

/-- The finding's located path as the reader places it: `pathSteps` (the program points,
which the page's own list shows), the `reindexed` steps whose origin `Source.Span.ofOrigin`
re-expressed in the reader's UTF-16 index, and the `rejected` steps the file's text
cannot name. A step's span is the one the reader will use for it, and the last step is
often the sink's own span, which `Scry.webFlowFactsGo` already drops as a duplicate.

A step whose origin the page's origin map always has (the sink, and every path point the
front end recorded) is never "unlocated" here: `line = 0` means the run found no origin
for it, and such a step stays a step with no mark (the same rule a C path's unlocated
step gets). A step that has an origin but no character of this file gets a
`Scry.RejectedOrigin`, so the bundle says so instead of dropping it. -/
def Scry.Cs.placedOf (text findId : String) (f : Scry.RuleFinding) (m : Scry.OriginMap) :
    List Scry.ReportStep × List Scry.ReindexedOrigin × List Scry.RejectedOrigin :=
  let steps := List.map (Scry.reportStepOf m) f.path;
  let i := EditorModel.index text;
  let placed := Scry.Cs.placedGo i findId steps 0;
  (steps, placed.2.1, placed.2.2)

/-- One file's `Scry.ReportFile` and its `ast` facts for the reader: the report's findings
in the analysis's order (the bundle sorts them by semantic id), each with its sink's
located origin and its placed path, plus `ast` rows starting at fact node `base`. The
page's facts are built by `Scry.bundleModelOf` from this, so C# and C share the `sink`
and `flow` shapes; the `ast` rows are this front end's own. -/
def Scry.Cs.reportFileOf (r : Scry.Cs.FileResult) (raw : List Scry.RuleFinding)
    (checks : List Bool) (m : Scry.OriginMap) (base : Nat) :
    Scry.ReportFile × List Source.FactRow × Nat × Nat :=
  let rel := r.path;
  let pairs := Scry.zipFindings raw checks;
  let pages := List.map (fun p =>
    let f := p.1;
    let sink := Scry.Cs.sinkOriginOf m rel f;
    let placed := Scry.Cs.placedOf r.text (Scry.wfId "cs" f rel) f m;
    let id := Scry.wfId "cs" f rel;
    { Scry.reportFindingOf rel m f p.2 .none with
        anchor := id, id := id, sinkLine := sink.line, sinkColumn := sink.column
      , endLine := sink.endLine, endColumn := sink.endColumn
      , pathSteps := placed.1, reindexed := placed.2.1, rejected := placed.2.2 }) pairs;
  let rf := Scry.ReportFile.mk rel (Scry.reportFileAnchor rel) r.text pages [] [] [] [];
  match r.store with
  | .some (.ok store) => let f := Scry.Cs.factsOf store r.text rel base;
    (rf, f.1, Nat.add base (Scry.CstStore.nodeCount store), f.2)
  | .some (.error why) => (rf, [], base, 0)
  | .none => (rf, [], base, 0)

/-- The reader's models of every file (the C# half of `Scry.webModelsGo`): findings,
`sink`/`flow` rows and `ast` rows, in the walk's order. A file's fact node ids count one
sequence (its findings first, then its `ast` rows), so a rebuild numbers them the same
way. The fourth list is `(file, rows the cap left out)`, for the manifest. -/
partial def Scry.Cs.bundleModelsGo (raw : List Scry.RuleFinding) (checks : List Bool)
    (m : Scry.OriginMap) :
    List Scry.Cs.FileResult → EIO (List Source.File × List Source.Finding ×
      List Source.FactRow × List (String × Nat))
  | .nil => EIO.pure (([] : List Source.File), ([] : List Source.Finding),
      ([] : List Source.FactRow), ([] : List (String × Nat)))
  | .cons r rest => do
    let built := Scry.Cs.reportFileOf r raw checks m 0;
    let model := Scry.bundleModelOf built.1 built.2.1 0;
    let dropped := match built.2.2.2 with
      | 0 => []
      | n => [(r.path, n)];
    more ← Scry.Cs.bundleModelsGo raw checks m rest;
    EIO.pure (List.cons model.1 more.1,
      List.append model.2.1 more.2.1,
      List.append model.2.2 more.2.2.1, List.append dropped more.2.2.2)

-- ## `--bundle`: writing the reader's data

/-- One file's row on the bundle page (no markup from the source: paths and language are
escaped by the reader's own rules — here the page is a plain listing, so a path's `<` is
kept out by `Scry.htmlEsc`). -/
def Scry.htmlEsc (s : String) : String :=
  String.join (List.map (fun c =>
    match Char.eq c (Char.mk 60), Char.eq c (Char.mk 62), Char.eq c (Char.mk 38) with
    | .true, _, _ => "&lt;"
    | _, .true, _ => "&gt;"
    | _, _, .true => "&amp;"
    | _, _, _ => String.mk [c]) (String.chars s))

/-- The report. `found` is the number of `.cs` files analysed; `before` is
`found + walk.excludedCount`. -/
structure Scry.Cs.Report where
  target : String
  kind : String
  before : Nat
  found : Nat
  parsed : Nat
  lowered : Nat
  failed : Nat
  funcs : Nat
  excluded : Nat
  rulesPath : Option String
  ruleCount : Nat
  findings : List Scry.Cs.FindingRow
  coverage : List Scry.Cs.CoverRow

/-- The taint pass's contribution to a report. The raw findings, their checked flags,
the origin map and the rule pack are kept for `--sarif`: the human/JSON report only
needs the aggregated rows, but SARIF names each result and its location. -/
structure Scry.Cs.Analysis where
  findings : List Scry.Cs.FindingRow
  rulesPath : Option String
  ruleCount : Nat
  coverage : List Scry.Cs.Diag
  raw : List Scry.RuleFinding
  checks : List Bool
  origins : Scry.OriginMap
  pack : Scry.RulePack

-- ## `--bundle`: the manifest's C# footer

/-- The manifest footer `scry cs --bundle` adds (the front end's own facts, so the
manifest says what the reader should expect without a second schema): `language`, the
fact `kind`s the export writes, whether a tree came with the data, the `ast` object
(`cap`, and every file the cap truncated with its lost row count), the target's `kind`
and the analysis counts. A C bundle has no footer (`[]`), so its manifest is the one it
always was. -/
def Scry.Cs.bundleExtra (t : Scry.Cs.Target) (r : Scry.Cs.Report) (truncated : List (String × Nat))
    (filesWithAst : Nat) : List (String × Json) :=
  let trees := Json.mkBool (Nat.lt 0 filesWithAst);
  [ ("language", Json.mkStr "csharp")
  , ("factKinds", Json.mkArr [Json.mkStr "sink", Json.mkStr "flow", Json.mkStr "ast"])
  , ("target", Json.mkStr t.kind)
  , ("ast", Json.mkObj
      [ ("cap", Json.ofNat Scry.Cs.astFactCap)
      , ("trees", Json.ofNat filesWithAst)
      , ("truncated", Json.mkArr (List.map (fun p => Json.mkObj
          [("path", Json.mkStr p.1), ("leftOut", Json.ofNat p.2)]) truncated))
      ])
  , ("counts", Json.mkObj
      [ ("parsed", Json.ofNat r.parsed)
      , ("lowered", Json.ofNat r.lowered)
      , ("failed", Json.ofNat r.failed)
      ])
  ]

-- ## `--bundle`: the page

/-- The page a C# bundle gets in place of the reader's SSR. `scry cs` links no Loom
runtime (the wasm host is the reader's), so `app.js` and `app.css` are not written; a
page that pointed at them would mount nothing. It lists what `data/` holds instead,
pointing at the reader: the same bundle served by `scry web`'s host (copy `web/`'s
`index.html` route, or serve `data/` from any page that loads `source-app.js`) draws it.
A path or a rule is escaped, so a source's markup never becomes the page's. -/
def Scry.Cs.bundlePage (files : List Source.File) (findings : List Source.Finding) : String :=
  let row : Source.File → String := fun f =>
    "<li><code>" ++ Scry.htmlEsc f.path ++ "</code> — " ++ Nat.repr f.lines
    ++ " lines, " ++ Scry.htmlEsc f.language ++ "</li>\n";
  let frow : Source.Finding → String := fun f =>
    "<li><code>" ++ Scry.htmlEsc f.rule ++ "</code> at <code>" ++ Scry.htmlEsc f.path
    ++ ":" ++ Nat.repr f.line ++ "</code></li>\n";
  let findingSection := match findings with
    | .nil => ""
    | _ => "<h2>findings</h2>\n<ul>\n" ++ String.join (List.map frow findings) ++ "</ul>\n";
  "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">"
  ++ "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
  ++ "<title>scry source</title></head><body><h1>scry source</h1>\n"
  ++ "<p>This is <code>scry cs --bundle</code>'s listing, not the reader: this command "
  ++ "writes the data the reader decodes, and the reader itself is "
  ++ "<code>scry web</code>'s host. " ++ Nat.repr (List.length files) ++ " file(s), "
  ++ Nat.repr (List.length findings) ++ " finding(s); the data is in <code>data/</code>.</p>\n"
  ++ "<ul>\n" ++ String.join (List.map row files) ++ "</ul>\n" ++ findingSection
  ++ "</body></html>\n"

/-- `scry cs --bundle DIR`: write the reader's bundle for the analysed tree. The models
are `Scry.bundleModelOf`'s (C#'s findings and `sink`/`flow` rows) plus the `ast` rows of
each file's parse; `Scry.bundleWriteData` writes the four data files and the per-file
JSONs, so the shapes are the C export's. Without the Loom runtime this command does not
link, `index.html` is a plain listing of what the data holds, never a blank page. -/
def Scry.Cs.writeBundle (assetsOpt uiOpt : Option String) (out : String) (t : Scry.Cs.Target)
    (results : List Scry.Cs.FileResult) (analysis : Scry.Cs.Analysis)
    (r : Scry.Cs.Report) : EIO Unit := do
  models ← Scry.Cs.bundleModelsGo analysis.raw analysis.checks analysis.origins results;
  let files := models.1;
  let findings := Scry.webSortById models.2.1;
  let facts := models.2.2.1;
  let truncated := models.2.2.2;
  let filesWithAst := List.length (List.filter (fun x => match x.store with
    | .some (.ok _) => .true
    | _ => .false) results);
  Scry.bundleWarnLarge files;
  Scry.bundleDirs out;
  assets ← Scry.webFindAssets assetsOpt;
  -- The reader's host, the same set `scry web` copies (`WebCmd.wiz:395-406`): the page
  -- `bundleIndexHtml` writes below mounts `app.js`, which loads `source-static.js` for its
  -- answers. Copying only three of them left the reader unable to answer a hover.
  host ← (match assets with
    | .none => EIO.pure []
    | .some d => Scry.webCopyHostGo d out
        [("source-app.js", "app.js"), ("source.css", "app.css"),
         ("source-static.js", "source-static.js"),
         ("source-live.js", "source-live.js"),
         ("lsp-client.js", "lsp-client.js")]);
  framework ← (match assets with
    | .none => EIO.pure []
    | .some d => Scry.webCopyFrameworkGo d out
        ["mount.js", "driver.js", "runtime.js", "adopt.js"]);
  -- The Loom runtime (`--ui`): `app.js` imports `wiz-source-ui.mjs`, so a bundle without
  -- it 404s that module and the page cannot mount. `scry web` copies it the same way.
  Scry.bundleWriteData out Scry.sourceTool files findings facts host framework
    (match uiOpt with | .none => Bool.false | .some _ => Bool.true)
    (Scry.Cs.bundleExtra t r truncated filesWithAst);
  _copied ← match uiOpt with
    | .none => EIO.pure (.false : Bool)
    | .some src => Scry.webCopy src (String.append out "/wiz-source-ui.mjs");
  -- The interactive reader, not a listing: `bundleIndexHtml` wraps the Loom runtime's
  -- SSR in `<div id="app" data-wiz-mode="static">` and `app.js` mounts on it, so the page
  -- shows the source with an infoview and its findings are walkable - the same page
  -- `scry web` writes for C. The SSR comes from the UI trace's `initial`, exactly as the
  -- C path does it (`WebCmd.wiz:382-385`).
  let bundle := Source.Bundle.mk "static" Scry.sourceTool files findings facts;
  let trace := Scry.webUiTraceJson bundle;
  let ssr := match Json.parse trace with
    | .ok j => Json.getStr j "initial"
    | .error _ => "";
  FS.writeFile (String.append out "/index.html") (Scry.bundleIndexHtml ssr);
  -- The scripted walk the reader replays: the same `ui-trace.json` `scry web` writes
  -- (`WebCmd.wiz:410`). Without it the page renders its SSR and cannot step through the
  -- findings, which is what makes the reader interactive rather than a static page.
  FS.writeFile (String.append out "/ui-trace.json") (String.append trace "\n");
  match truncated with
  | .nil => EIO.pure ()
  | _ => Scry.Cs.sayErr ("note: the bundle's `ast` facts are capped at "
      ++ Nat.repr Scry.Cs.astFactCap ++ " nodes per file; "
      ++ Nat.repr (List.foldl (fun n p => Nat.add n p.2) 0 truncated)
      ++ " node(s) were left out (the manifest's `ast.truncated` names each file)");
  EIO.lift (IO.println ("wrote source bundle: " ++ out ++ " ("
    ++ Nat.repr (List.length files) ++ " file(s), "
    ++ Nat.repr (List.length findings) ++ " finding(s), "
    ++ Nat.repr (List.length facts) ++ " fact(s); the reader's data/*.json, no timestamp)"))


/-- A warning's source location. Every file is lowered on its own, so `span.file` is
the one path the caller passed. -/
def Scry.Cs.spanLoc (path : String) (sp : Wil.Span) : String :=
  match Nat.beq sp.line 0 with
  | .true => path
  | .false => path ++ ":" ++ Nat.repr sp.line ++ ":" ++ Nat.repr sp.col

/-- Normalise a lowering message into a stable coverage construct. The lowering's
messages interpolate names and types; grouping them is what makes a first run's
coverage readable ("what didn't you look at?", not "which identifier"). -/
def Scry.Cs.constructOf (m : String) : String :=
  match Bool.and (String.startsWith m "unknown name ") (String.contains m " not modelled") with
  | .true => "unknown name not modelled: havoc"
  | .false => match String.startsWith m "operator " with
    | .true => "operator not modelled: havoc"
    | .false => match String.startsWith m "call to " with
      | .true => match String.contains m ": not a method of " with
        | .true => "call to a delegate or unknown method"
        | .false => m
      | .false => match Bool.and (String.startsWith m "assignment to ")
          (String.endsWith m " not modelled") with
        | .true => "assignment target not modelled"
        | .false => match String.startsWith m "field initialiser of " with
          | .true => "field initialiser not modelled (starts as default)"
          | .false => match String.startsWith m "property initialiser of " with
            | .true => "property initialiser not modelled (starts as default)"
            | .false => m

def Scry.Cs.diagOfWarning (path : String) (w : Scry.Warning) : Scry.Cs.Diag :=
  Scry.Cs.Diag.mk .warning (Scry.Cs.constructOf w.message) (Scry.Cs.spanLoc path w.span)
    w.message

/-- A points-to/memory diagnostic as a coverage row. These are not findings: they say
the analysis did not know a memory location or an external call's effect. -/
def Scry.Cs.diagOfMem (m : Scry.OriginMap) (w : Scry.MemWarning) : Scry.Cs.Diag :=
  Scry.Cs.Diag.mk .warning (Scry.MemWarnKind.show w.kind)
    (Scry.locationText m w.func w.point) w.detail

/-- One lowered file's result. A file that parses but produces no function is a
warning row, not a silent zero. -/
def Scry.Cs.resultOfLowered (path text : String) (l : Scry.Cs.Lowered) : Scry.Cs.FileResult :=
  let warnings := List.map (Scry.Cs.diagOfWarning path) l.warnings;
  let extra := match l.funcs with
    | .nil => [Scry.Cs.Diag.mk .warning "no functions lowered" path ""]
    | _ => [];
  Scry.Cs.FileResult.mk path .true 0 l.funcs text
    (List.append extra warnings) .none

/-- One spill's result (the Lean tests' path: they cannot call the native shim). -/
def Scry.Cs.resultOfFront (path : String) (r : Scry.Cs.FrontResult) : Scry.Cs.FileResult :=
  match r with
  | .ok l => Scry.Cs.resultOfLowered path l.text l
  | .err m => Scry.Cs.FileResult.mk path .false 1 .nil ""
      [Scry.Cs.Diag.mk .error "parse failure" path m] .none

/-- The kind of a store's first failing node: `ERROR`, or `MISSING <token>` (the token
the grammar expected). Naming the node is what lets a failing file be diagnosed without a
second tool: the sweep row says which node is absent, not just that the file failed. -/
def Scry.Cs.errorKind (s : Scry.CstStore) (i : Nat) : String :=
  match Scry.CstStore.missingOf s i with
  | .true => "MISSING " ++ Scry.CstStore.kindName s i
  | .false => "ERROR"

/-- Whether the store's byte spans index `text` exactly: it holds one file, that file is
`rel`, and every node's span lies inside the text's UTF-8 length. The AST facts slice the
reader's UTF-16 text by the store's byte spans, which is the same source only under this
condition; a mismatch is reported, never guessed at. -/
def Scry.Cs.storeFits (cst : Scry.CstStore) (rel text : String) : Bool :=
  Bool.and (String.eq (Scry.CstStore.pathName cst 0) rel)
    (List.all (fun i => let sp := Scry.CstStore.spanOf cst i;
        Bool.and (Nat.le sp.start sp.stop) (Nat.le sp.stop (Scry.webUtf8Size text)))
      (Scry.range (Scry.CstStore.nodeCount cst)))

/-- Parse and lower one file. `rel` is the path the report uses; `full` is read.
A tree with `ERROR`/`MISSING` nodes is a failure (never lowered as if recovered); the
row's location names the first failing node's position and kind. `wantStore` asks for the
CST to be kept (`Scry.Cs.FileResult.store`), which only `scry cs --bundle` needs. -/
/-- The CST to keep for `--bundle`: `none` when the caller did not ask, and a rejected
store when the parse's byte spans do not index this file's own text. -/
def Scry.Cs.keptStore (wantStore : Bool) (cst : Scry.CstStore) (rel text : String) :
    Option (Except String Scry.CstStore) :=
  match wantStore with
  | .false => .none
  | .true => match Scry.Cs.storeFits cst rel text with
    | .true => .some (.ok cst)
    | .false => .some (.error (rel ++ ": the parse's byte spans do not index this file's own text"
        ++ " (a preprocessed file, or a CRLF difference); its AST facts were not written"))

def Scry.Cs.analyseFile (rel full : String) (wantStore : Bool) : EIO Scry.Cs.FileResult := do
  text ← FS.readFile full;
  st ← Scry.Native.parse "c_sharp" text;
  let errs := Scry.Native.errorCount st;
  cst ← EIO.lift (Scry.Native.toCstStoreIn "c_sharp" rel st);
  let kept := Scry.Cs.keptStore wantStore cst rel text;
  let lower := fun (_ : Unit) => Scry.Cs.lowerCstWithModels Scry.csModels rel text
      (Scry.Cs.ofStore text cst);
  match Nat.beq errs 0 with
  | .true => do
    let l := lower ();
    EIO.pure ({ Scry.Cs.resultOfLowered rel text l with store := kept })
  | .false => do
    let pre := Scry.Preprocessed.plain rel text;
    let loc := match Scry.CstStore.firstError cst with
      | .some i => let sp := Scry.CstStore.spanOf cst i;
        let pos := Scry.posOf pre sp.start;
        rel ++ ":" ++ Nat.repr pos.line ++ ":" ++ Nat.repr pos.col
          ++ " (" ++ Scry.Cs.errorKind cst i ++ ")"
      | .none => rel;
    -- The recovery tree is not lowered as a result, but its boundary rows are the first
    -- thing the reader can say about the file: they go in as warnings beside the error.
    let warnings := List.map (Scry.Cs.diagOfWarning rel) (lower ()).warnings;
    EIO.pure (Scry.Cs.FileResult.mk rel .false errs .nil text
      (List.append
        [Scry.Cs.Diag.mk .error "parse failure" loc
          (Nat.repr errs ++ " ERROR/MISSING node(s); the file was not lowered")]
        warnings)
      kept)

partial def Scry.Cs.analyseAll (wantStore : Bool) :
    List (String × String) → EIO (List Scry.Cs.FileResult)
  | .nil => EIO.pure .nil
  | .cons (rel, full) rest => do
    r ← Scry.Cs.attempt (Scry.Cs.analyseFile rel full wantStore);
    let fr := match r with
      | .ok x => x
      | .error e => Scry.Cs.FileResult.mk rel .false 1 .nil "" 
          [Scry.Cs.Diag.mk .error "unreadable file" rel e] .none;
    rs ← Scry.Cs.analyseAll wantStore rest;
    EIO.pure (List.cons fr rs)

-- ## Aggregation

def Scry.Cs.findCover (c : String) : List Scry.Cs.CoverRow → Option Nat
  | .nil => .none
  | .cons r rest => match String.eq r.construct c with
    | .true => .some r.count
    | .false => Scry.Cs.findCover c rest

/-- Add a diagnostic to the coverage rows (same construct: count + 1). An `error` row is
never merged: a count of "16 parse failure" with one example hides fifteen files, and the
point of the coverage section is to name every file that was not analysed. Warnings still
aggregate, because one construct repeated in a file is one construct. -/
def Scry.Cs.addDiag (d : Scry.Cs.Diag) : List Scry.Cs.CoverRow → List Scry.Cs.CoverRow
  | .nil => [Scry.Cs.CoverRow.mk d.level d.construct 1 d.location]
  | .cons r rest => match d.level, String.eq r.construct d.construct with
    | .error, _ => List.cons r (Scry.Cs.addDiag d rest)
    | _, .true => List.cons { r with count := Nat.succ r.count } rest
    | _, .false => List.cons r (Scry.Cs.addDiag d rest)

def Scry.Cs.coverageOf (results : List Scry.Cs.FileResult) : List Scry.Cs.CoverRow :=
  List.foldl (fun rows r => List.foldl (fun rs d => Scry.Cs.addDiag d rs) rows r.diags)
    (.nil : List Scry.Cs.CoverRow) results

/-- Aggregate a taint pass's diagnostics into the same rows (one row per construct,
with its count and first example). -/
def Scry.Cs.coverageOfDiags (diags : List Scry.Cs.Diag) : List Scry.Cs.CoverRow :=
  List.foldl (fun rows d => Scry.Cs.addDiag d rows) (.nil : List Scry.Cs.CoverRow) diags

def Scry.Cs.excludedRows (rules : List (String × Nat × String)) : List Scry.Cs.CoverRow :=
  List.map (fun t => Scry.Cs.CoverRow.mk .note ("excluded: " ++ t.1) t.2.1 t.2.2) rules

def Scry.Cs.errorRows (errors : List (String × String)) : List Scry.Cs.CoverRow :=
  List.map (fun e => Scry.Cs.CoverRow.mk .error "walk error" 1 e.1) errors

/-- Rows come out most severe first, then most frequent, then by name. -/
def Scry.Cs.rowBefore (a b : Scry.Cs.CoverRow) : Bool :=
  match Nat.lt (Scry.Cs.levelRank b.level) (Scry.Cs.levelRank a.level) with
  | .true => .true
  | .false => match Nat.lt (Scry.Cs.levelRank a.level) (Scry.Cs.levelRank b.level) with
    | .true => .false
    | .false => match Nat.lt b.count a.count with
      | .true => .true
      | .false => match Nat.lt a.count b.count with
        | .true => .false
        | .false => String.lt a.construct b.construct

def Scry.Cs.insertCover (r : Scry.Cs.CoverRow) : List Scry.Cs.CoverRow → List Scry.Cs.CoverRow
  | .nil => List.cons r .nil
  | .cons x rest => match Scry.Cs.rowBefore r x with
    | .true => List.cons r (List.cons x rest)
    | .false => List.cons x (Scry.Cs.insertCover r rest)

def Scry.Cs.sortCover (rows : List Scry.Cs.CoverRow) : List Scry.Cs.CoverRow :=
  List.foldl (fun acc r => Scry.Cs.insertCover r acc) .nil rows

def Scry.Cs.findingBefore (a b : Scry.Cs.FindingRow) : Bool :=
  match Nat.lt (Scry.Cs.levelRank b.severity) (Scry.Cs.levelRank a.severity) with
  | .true => .true
  | .false => match Nat.lt (Scry.Cs.levelRank a.severity) (Scry.Cs.levelRank b.severity) with
    | .true => .false
    | .false => match Nat.lt b.count a.count with
      | .true => .true
      | .false => match Nat.lt a.count b.count with
        | .true => .false
        | .false => String.lt a.rule b.rule

def Scry.Cs.insertFinding (r : Scry.Cs.FindingRow) :
    List Scry.Cs.FindingRow → List Scry.Cs.FindingRow
  | .nil => List.cons r .nil
  | .cons x rest => match Scry.Cs.findingBefore r x with
    | .true => List.cons r (List.cons x rest)
    | .false => List.cons x (Scry.Cs.insertFinding r rest)

def Scry.Cs.sortFindings (rows : List Scry.Cs.FindingRow) : List Scry.Cs.FindingRow :=
  List.foldl (fun acc r => Scry.Cs.insertFinding r acc) .nil rows

def Scry.Cs.findingKey (f : Scry.RuleFinding) : String :=
  f.rule ++ "|" ++ Scry.Severity.show f.severity

def Scry.Cs.addFinding (m : Scry.OriginMap) (f : Scry.RuleFinding) :
    List Scry.Cs.FindingRow → List Scry.Cs.FindingRow
  | .nil => [Scry.Cs.FindingRow.mk f.rule f.severity 1
      (Scry.locationText m f.func f.sink)]
  | .cons r rest => match String.eq (r.rule ++ "|" ++ Scry.Severity.show r.severity)
      (Scry.Cs.findingKey f) with
    | .true => List.cons { r with count := Nat.succ r.count } rest
    | .false => List.cons r (Scry.Cs.addFinding m f rest)

def Scry.Cs.findingRows (m : Scry.OriginMap) (fs : List Scry.RuleFinding) :
    List Scry.Cs.FindingRow :=
  Scry.Cs.sortFindings (List.foldl (fun rows f => Scry.Cs.addFinding m f rows)
    (.nil : List Scry.Cs.FindingRow) fs)

/-- The origin map of every lowered function, for finding locations. -/
def Scry.Cs.originMapOf (results : List Scry.Cs.FileResult) : Scry.OriginMap :=
  List.concat (List.map (fun r =>
    Scry.originEntries r.path (Scry.TextIndex.ofString r.text) r.funcs) results)


def Scry.Cs.countIf {A : Type} (p : A → Bool) (xs : List A) : Nat :=
  List.length (List.filter p xs)

def Scry.Cs.reportOf (target kind : String) (w : Scry.Cs.Walk)
    (results : List Scry.Cs.FileResult) (rulesPath : Option String) (ruleCount : Nat)
    (findings : List Scry.Cs.FindingRow) (extra : List Scry.Cs.CoverRow) : Scry.Cs.Report :=
  let found := List.length results;
  let parsed := Scry.Cs.countIf (fun r => r.parseOk) results;
  let lowered := Scry.Cs.countIf (fun r => Bool.and r.parseOk (match r.funcs with
    | .nil => .false | _ => .true)) results;
  let failed := Scry.Cs.countIf (fun r => Bool.not r.parseOk) results;
  let funcs := List.foldl (fun n r => Nat.add n (List.length r.funcs)) 0 results;
  let coverage := Scry.Cs.sortCover (List.append extra
    (List.append (Scry.Cs.coverageOf results)
      (List.append (Scry.Cs.excludedRows w.excludedRules)
        (Scry.Cs.errorRows w.errors))));
  Scry.Cs.Report.mk target kind (Nat.add found w.excludedCount) found parsed lowered failed
    funcs w.excludedCount rulesPath ruleCount findings coverage

-- ## Rendering

def Scry.Cs.padRight (n : Nat) (s : String) : String :=
  match Nat.le n (String.length s) with
  | .true => s
  | .false => s ++ Scry.Cs.spaces (Nat.sub n (String.length s))

def Scry.Cs.showCount (n : Nat) : String := Nat.repr n

def Scry.Cs.findingTotal (rows : List Scry.Cs.FindingRow) : Nat :=
  List.foldl (fun n r => Nat.add n r.count) 0 rows

def Scry.Cs.countSeverity (sev : Scry.Severity) (rows : List Scry.Cs.FindingRow) : Nat :=
  List.foldl (fun n r => match r.severity, sev with
    | .error, .error => Nat.add n r.count
    | .warning, .warning => Nat.add n r.count
    | .note, .note => Nat.add n r.count
    | _, _ => n) 0 rows

def Scry.Cs.renderRules (path : Option String) (count : Nat) : String :=
  match path with
  | .some p => p ++ " (" ++ Nat.repr count ++ " rule(s))"
  | .none => "none (no rule pack found; pass --rules FILE)"

def Scry.Cs.renderFindings (rows : List Scry.Cs.FindingRow) : List String :=
  match rows with
  | .nil => ["  (none)"]
  | _ => List.cons
      ("  " ++ Scry.Cs.padRight 9 "SEVERITY" ++ Scry.Cs.padRight 7 "COUNT" ++ "RULE  EXAMPLE")
      (List.map (fun r =>
        "  " ++ Scry.Cs.padRight 9 (Scry.Severity.show r.severity)
          ++ Scry.Cs.padRight 7 (Nat.repr r.count)
          ++ r.rule ++ "  " ++ r.example) rows)

def Scry.Cs.renderCoverage (rows : List Scry.Cs.CoverRow) : List String :=
  match rows with
  | .nil => ["  none: every discovered construct was lowered"]
  | _ => List.cons
      ("  " ++ Scry.Cs.padRight 9 "SEVERITY" ++ Scry.Cs.padRight 7 "COUNT"
        ++ Scry.Cs.padRight 52 "CONSTRUCT" ++ " EXAMPLE")
      (List.map (fun r =>
        "  " ++ Scry.Cs.padRight 9 (Scry.Severity.show r.level)
          ++ Scry.Cs.padRight 7 (Nat.repr r.count)
          ++ Scry.Cs.padRight 52 r.construct ++ " " ++ r.example) rows)

def Scry.Cs.render (r : Scry.Cs.Report) : String :=
  String.intercalate "\n" (List.append
    ["scry cs " ++ r.target,
     "target: " ++ r.target ++ " (" ++ r.kind ++ ")",
     "walk: " ++ Nat.repr r.before ++ " .cs file(s) before exclusions; "
       ++ Nat.repr r.found ++ " kept, " ++ Nat.repr r.excluded ++ " excluded by rule",
     "files: " ++ Nat.repr r.found ++ " found, " ++ Nat.repr r.parsed ++ " parsed, "
       ++ Nat.repr r.lowered ++ " lowered, " ++ Nat.repr r.failed ++ " failed",
     "functions: " ++ Nat.repr r.funcs ++ " lowered",
     "rules: " ++ Scry.Cs.renderRules r.rulesPath r.ruleCount,
     "findings: " ++ Nat.repr (Scry.Cs.findingTotal r.findings)
       ++ " (error " ++ Nat.repr (Scry.Cs.countSeverity .error r.findings)
       ++ ", warning " ++ Nat.repr (Scry.Cs.countSeverity .warning r.findings)
       ++ ", note " ++ Nat.repr (Scry.Cs.countSeverity .note r.findings) ++ ")"]
    (List.append (Scry.Cs.renderFindings r.findings)
      (List.append
        ["coverage: " ++ Nat.repr (List.length r.coverage) ++ " row(s) — what was "
           ++ "skipped or warned about"]
        (Scry.Cs.renderCoverage r.coverage))))

-- ## JSON

def Scry.Cs.coverageJson (r : Scry.Cs.CoverRow) : Json :=
  Json.mkObj [("severity", Json.ofString (Scry.Severity.show r.level)),
    ("construct", Json.ofString r.construct), ("count", Json.ofNat r.count),
    ("example", Json.ofString r.example)]

def Scry.Cs.findingJson (r : Scry.Cs.FindingRow) : Json :=
  Json.mkObj [("rule", Json.ofString r.rule),
    ("severity", Json.ofString (Scry.Severity.show r.severity)),
    ("count", Json.ofNat r.count), ("example", Json.ofString r.example)]

def Scry.Cs.rulesJson (r : Scry.Cs.Report) : Json :=
  match r.rulesPath with
  | .some p => Json.mkObj [("path", Json.ofString p), ("count", Json.ofNat r.ruleCount)]
  | .none => Json.mkObj [("path", Json.mkNull), ("count", Json.ofNat 0)]

def Scry.Cs.jsonOf (r : Scry.Cs.Report) (status : Nat) : Json :=
  Json.mkObj [
    ("schema", Json.ofString "scry-cs-report/1"),
    ("target", Json.ofString r.target),
    ("kind", Json.ofString r.kind),
    ("walk", Json.mkObj [("before", Json.ofNat r.before), ("kept", Json.ofNat r.found),
      ("excluded", Json.ofNat r.excluded)]),
    ("files", Json.mkObj [("found", Json.ofNat r.found), ("parsed", Json.ofNat r.parsed),
      ("lowered", Json.ofNat r.lowered), ("failed", Json.ofNat r.failed)]),
    ("functions", Json.ofNat r.funcs),
    ("rules", Scry.Cs.rulesJson r),
    ("findings", Json.mkObj [
      ("total", Json.ofNat (Scry.Cs.findingTotal r.findings)),
      ("error", Json.ofNat (Scry.Cs.countSeverity .error r.findings)),
      ("warning", Json.ofNat (Scry.Cs.countSeverity .warning r.findings)),
      ("note", Json.ofNat (Scry.Cs.countSeverity .note r.findings)),
      ("byRule", Json.mkArr (List.map Scry.Cs.findingJson r.findings))]),
    ("coverage", Json.mkArr (List.map Scry.Cs.coverageJson r.coverage)),
    ("exit", Json.ofNat status)]

-- ## Status and options

/-- At/above a threshold (`note < warning < error`). -/
def Scry.Cs.atOrAbove (threshold sev : Scry.Severity) : Bool :=
  Nat.le (Scry.Cs.levelRank threshold) (Scry.Cs.levelRank sev)

def Scry.Cs.gated (r : Scry.Cs.Report) (sev : Scry.Severity) : Bool :=
  Bool.or
    (List.any (fun f => Scry.Cs.atOrAbove sev f.severity) r.findings)
    (List.any (fun c => Scry.Cs.atOrAbove sev c.level) r.coverage)

/-- The driver's outcome, before it becomes an exit status. `usage` is a flag/path
problem; `report` is a completed run. -/
inductive Scry.Cs.Outcome where
  | usage
  | report (r : Scry.Cs.Report) (failOn : Option Scry.Severity)

/-- 0 clean, 1 gated, 2 usage/IO, 3 nothing analysed. -/
def Scry.Cs.statusOf : Scry.Cs.Outcome → Nat
  | .usage => 2
  | .report r failOn => match r.found with
    | 0 => 3
    | _ => match r.lowered with
      | 0 => 3
      | _ => match failOn with
        | .none => 0
        | .some sev => match Scry.Cs.gated r sev with
          | .true => 1
          | .false => 0

structure Scry.Cs.Opts where
  target : String
  json : Bool
  failOn : Option Scry.Severity
  rules : Option String
  taint : Bool
  /-- `--sarif OUT`: write the findings as SARIF 2.1.0. -/
  sarif : Option String
  /-- `--bundle DIR`: also write the source reader's data bundle (the same reader
  `scry web` exports for C) into `DIR`. -/
  bundle : Option String
  /-- `--assets DIR`: the checkout's `web/` directory whose host files go into
  `--bundle DIR` (default: the first `web/` found from here up, as `scry web`). -/
  assets : Option String
  /-- `--ui FILE`: copy a built `wiz-source-ui.mjs` (the Loom runtime,
  `web/build-source-ui.sh`) into the bundle. Without it `app.js`'s import of that module
  404s and the page cannot mount - the export is data + SSR only, as `scry web` says. -/
  ui : Option String

def Scry.Cs.usage : String :=
  "usage: scry cs PATH [--json] [--sarif OUT] [--bundle DIR] [--assets DIR]\n"
  ++ "                   [--fail-on error|warning|note] [--rules FILE] [--no-taint]\n"
  ++ "  PATH is a directory, a .csproj, a .sln/.slnx, or one .cs file.
  --ui FILE     copy a built wiz-source-ui.mjs into the bundle (web/build-source-ui.sh).
                Without it the reader's runtime is missing and the page cannot mount.\n"
  ++ "  Walks for *.cs (excluding bin/, obj/, node_modules/, hidden dirs, *.g.cs,\n"
  ++ "  *.Designer.cs), parses and lowers each file, and reports findings plus a\n"
  ++ "  coverage section naming every construct or file that was skipped.\n"
  ++ "  --bundle DIR  also write the source reader's bundle (data/*.json and one\n"
  ++ "                data/f/<id>.json per file): the same reader `scry web` exports\n"
  ++ "                for C, with findings, sink/flow facts and an `ast` fact per\n"
  ++ "                parse node for the infotree. `scry web` refuses a C#-only tree\n"
  ++ "                and names this command.\n"
  ++ "  --assets DIR  the checkout's web/ directory whose host files the bundle copies\n"
  ++ "                (default: the first web/ found from here up).\n"
  ++ "  exit: 0 clean, 1 at/above --fail-on, 2 usage/IO, 3 nothing analysed.\n"

def Scry.Cs.parseFailOn (s : String) : Except String Scry.Severity :=
  match s with
  | "error" => .ok .error
  | "warning" => .ok .warning
  | "note" => .ok .note
  | _ => .error ("--fail-on needs error, warning or note, not \"" ++ s ++ "\"\n"
      ++ Scry.Cs.usage)

partial def Scry.Cs.parseArgsGo (target : Option String) (o : Scry.Cs.Opts) :
    List String → Except String Scry.Cs.Opts
  | .nil => match target with
    | .some t => .ok { o with target := t }
    | .none => .error Scry.Cs.usage
  | .cons a rest => match a with
    | "--json" => Scry.Cs.parseArgsGo target { o with json := .true } rest
    | "--sarif" => match rest with
      | .cons v r => Scry.Cs.parseArgsGo target { o with sarif := .some v } r
      | .nil => .error ("--sarif needs an OUT path\n" ++ Scry.Cs.usage)
    | "--no-taint" => Scry.Cs.parseArgsGo target { o with taint := .false } rest
    | "--bundle" => match rest with
      | .cons v r => Scry.Cs.parseArgsGo target { o with bundle := .some v } r
      | .nil => .error ("--bundle needs a DIR\n" ++ Scry.Cs.usage)
    | "--assets" => match rest with
      | .cons v r => Scry.Cs.parseArgsGo target { o with assets := .some v } r
      | .nil => .error ("--assets needs a DIR\n" ++ Scry.Cs.usage)
    | "--ui" => match rest with
      | .cons v r => Scry.Cs.parseArgsGo target { o with ui := .some v } r
      | .nil => .error ("--ui needs a module file\n" ++ Scry.Cs.usage)
    | "--fail-on" => match rest with
      | .cons v r => match Scry.Cs.parseFailOn v with
        | .ok sev => Scry.Cs.parseArgsGo target { o with failOn := .some sev } r
        | .error e => .error e
      | .nil => .error ("--fail-on needs a severity\n" ++ Scry.Cs.usage)
    | "--rules" => match rest with
      | .cons v r => Scry.Cs.parseArgsGo target { o with rules := .some v } r
      | .nil => .error ("--rules needs a FILE\n" ++ Scry.Cs.usage)
    | _ => match String.startsWith a "-" with
      | .true => .error ("unknown option \"" ++ a ++ "\"\n" ++ Scry.Cs.usage)
      | .false => match target with
        | .some _ => .error ("scry cs takes one PATH\n" ++ Scry.Cs.usage)
        | .none => Scry.Cs.parseArgsGo (.some a) o rest

def Scry.Cs.parseArgs (args : List String) : Except String Scry.Cs.Opts :=
  Scry.Cs.parseArgsGo .none
    (Scry.Cs.Opts.mk "" .false .none .none .true .none .none .none .none) args

/-- The default C# rule pack: the corpus pack first (a checkout), then an installed
`rules/csharp.scry`. A tree with no pack still gets its coverage report. -/
def Scry.Cs.defaultPackCandidates : List String :=
  ["scry/corpus/csharp/csharp.scry", "../scry/corpus/csharp/csharp.scry",
   "scry/rules/csharp.scry", "rules/csharp.scry"]

def Scry.Cs.loadPack (rules : Option String) : EIO (Option (String × Scry.RulePack)) :=
  match rules with
  | .some path => do
    text ← FS.readFile path;
    pack ← Scry.packFromText path text;
    EIO.pure (.some (path, pack))
  | .none => do
    found ← Scry.readFirst Scry.Cs.defaultPackCandidates;
    match found with
    | .none => EIO.pure .none
    | .some text => do
      pack ← Scry.packFromText "scry/corpus/csharp/csharp.scry" text;
      EIO.pure (.some ("scry/corpus/csharp/csharp.scry", pack))

-- ## The command

/-- Write the SARIF report, or the status if there is none. A `do` arm inside a `let`-bound
`match` does not parse (`Scry.Cs.finish` used to inline it), so the effect lives here. -/
def Scry.Cs.writeSarifOr (opts : Scry.Cs.Opts) (out : String)
    (analysis : Scry.Cs.Analysis) (status : Nat) : EIO Nat := do
  w ← Scry.Cs.attempt (FS.writeFile out (String.append
    (Scry.renderSarifWith "cs" "scry" analysis.origins analysis.pack
      (Scry.zipFindings analysis.raw analysis.checks) .nil) "\n"));
  match w with
  | .error e => do
    Scry.Cs.sayErr ("scry cs: " ++ e);
    EIO.pure 2
  | .ok _ => do
    Scry.Cs.sayErr ("wrote SARIF 2.1.0: " ++ out ++ " ("
      ++ Nat.repr (List.length analysis.raw) ++ " result(s))");
    EIO.pure status

/-- Write the source bundle, then the SARIF (or the status when there is no bundle). -/
def Scry.Cs.writeBundleOr (opts : Scry.Cs.Opts) (out : String) (t : Scry.Cs.Target)
    (results : List Scry.Cs.FileResult) (analysis : Scry.Cs.Analysis)
    (r : Scry.Cs.Report) (writeSarif : EIO Nat) : EIO Nat := do
  w ← Scry.Cs.attempt (Scry.Cs.writeBundle opts.assets opts.ui out t results analysis r);
  match w with
  | .error e => do
    Scry.Cs.sayErr ("scry cs: --bundle " ++ out ++ ": " ++ e);
    EIO.pure 2
  | .ok _ => writeSarif

/-- Print the report (human or JSON) and return its status. The driver's last step is
shared by the tainted, untainted and pack-less runs. -/
def Scry.Cs.finish (opts : Scry.Cs.Opts) (t : Scry.Cs.Target)
    (results : List Scry.Cs.FileResult) (analysis : Scry.Cs.Analysis) : EIO Nat := do
  let extra := Scry.Cs.coverageOfDiags analysis.coverage;
  let r := Scry.Cs.reportOf opts.target t.kind t.walk results analysis.rulesPath
    analysis.ruleCount analysis.findings extra;
  let status := Scry.Cs.statusOf (.report r opts.failOn);
  -- A `let` would only *name* the `EIO` action (`let x := f ()` does not run `f`), so the
  -- report was constructed and never printed: `scry cs` exited 0 with silence on every
  -- path. Bind it with `<-` so `finish` runs it.
  _printed ← (match opts.json with
    | .true => Scry.Cs.say (Json.render (Scry.Cs.jsonOf r status))
    | .false => Scry.Cs.say (Scry.Cs.render r));
  -- The bundle and the SARIF come after the report, and a failure in either is an IO
  -- failure of the run (status 2), never a silent half-write.
  -- A `let`-bound `match` whose arm opens a `do` block loses the block's termination (the
  -- parser then reports the *next* `def` as unexpected). Hoisting each such arm into its own
  -- top-level helper keeps the same behaviour and parses.
  let writeSarif : EIO Nat := match opts.sarif with
    | .none => EIO.pure status
    | .some out => Scry.Cs.writeSarifOr opts out analysis status;
  let done := match opts.bundle with
    | .none => writeSarif
    | .some out => Scry.Cs.writeBundleOr opts out t results analysis r writeSarif;
  done

def Scry.Cs.run (args : List String) : EIO Nat := do
  match Scry.Cs.parseArgs args with
  | .error e => do
    Scry.Cs.sayErr e;
    EIO.pure (Scry.Cs.statusOf .usage)
  | .ok opts => do
    found ← Scry.Cs.attempt (Scry.Cs.discover opts.target);
    match found with
    | .error e => do
      Scry.Cs.sayErr ("scry cs: " ++ e);
      EIO.pure (Scry.Cs.statusOf .usage)
    | .ok t => do
      -- The CST is only kept for `--bundle` (the `ast` facts read it); plain analysis
      -- drops it, so a 75-file tree's memory does not carry a second copy of every parse.
      let wantStore : Bool := match opts.bundle with
        | .some _ => .true
        | .none => .false;
      results ← Scry.Cs.analyseAll wantStore t.walk.files;
      pack ← match opts.taint with
        | .false => EIO.pure ((.ok .none) : Except String (Option (String × Scry.RulePack)))
        | .true => Scry.Cs.attempt (Scry.Cs.loadPack opts.rules);
      match pack with
      | .error e => match opts.rules with
        | .some _ => do
          Scry.Cs.sayErr ("scry cs: " ++ e);
          EIO.pure (Scry.Cs.statusOf .usage)
        | .none => Scry.Cs.finish opts t results (Scry.Cs.Analysis.mk .nil .none 0
            [Scry.Cs.Diag.mk .note ("taint not run: " ++ e) "(none)" e]
            [] [] [] (Scry.RulePack.mk .nil))
      | .ok .none => Scry.Cs.finish opts t results (Scry.Cs.Analysis.mk .nil .none 0
          [Scry.Cs.Diag.mk .note (match opts.taint with
              | .true => "taint not run: no rule pack found"
              | .false => "taint not run: --no-taint")
            "(none)" (match opts.taint with
              | .true => "pass --rules FILE"
              | .false => "")]
          [] [] [] (Scry.RulePack.mk .nil))
      | .ok (.some (path, p)) => do
        let funcs := List.concat (List.map (fun r => r.funcs) results);
        match funcs with
        | .nil => Scry.Cs.finish opts t results (Scry.Cs.Analysis.mk .nil (.some path) 0
            [Scry.Cs.Diag.mk .note "taint not run: no functions lowered" "(none)" ""]
            [] [] [] p)
        | _ => do
          let pr := Scry.analyzeCModels Scry.csModels
            (Scry.Cs.resolveCalls (Wil.program funcs)) p;
          let raw := Scry.programFindings pr;
          let m := Scry.Cs.originMapOf results;
          Scry.Cs.finish opts t results (Scry.Cs.Analysis.mk
            (Scry.Cs.findingRows m raw)
            (.some path) (List.length p.rules)
            (List.map (Scry.Cs.diagOfMem m) pr.warnings)
            raw (List.map (fun _ => .false) raw) m p)
