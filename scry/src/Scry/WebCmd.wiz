import Sys
import Text
import Json
import Scry.Report
import Scry.ReportCmd
import Scry.SourceBundle
import Scry.Workflow
import Web.EditorModel
import Web.Hover
import Web.Loom
import Web.Source.Facts
import Web.Source.Model
import Web.Source.Span
import Web.Source.Static
import Web.Source.View

/-!
# Scry.WebCmd: `scry web` (the C walk; the model and writers are `Scry.SourceBundle`)

The static export of the reader: one directory that a plain static server serves, with
the source, the findings and the precomputed fact rows the browser needs. The reader
models, the JSON and the per-file writer live in `Scry.SourceBundle`, which `scry cs
--bundle` also uses; this module is the C front end's walk, options, answers and trace.

```
scry web FILE.c|DIR --out BUNDLE [--rules FILE] [--allow-errors]
                    [--timeout SECS] [--max-nodes N] [--max-rounds N]
                    [--assets DIR] [--ui FILE] [--source FILE]...
```

**Two kinds of file.** The analysed files are the target's `*.c` files and carry findings
and facts. A `--source FILE` is copied in verbatim with no analysis (its
language comes from the extension): it exists so a Wiz file can be read in the same
pane as the analysed code, with the live host (`web/source-live.js`, `?lsp=`) answering
hover and definition from `wiz lsp --ws`. Repeat `--source` for several. A file outside
the server's own module root cannot resolve its `import`s (today's `wiz lsp` has no
`-I`), so the live demo uses files under `lib/`.

**No silent empty bundle.** The walk is `*.c` only (`Scry.ProjectIO.walkNames`), so a
target with no `*.c` is refused before anything is written: a C#-only tree names
`scry cs` (and `scry cs --bundle` for a C# bundle of the same reader), and a directory
with no visible file says so. A directory that has `*.c` files and also `*.cs` files
says how many C# files it is not reading.

**One pipeline.** The evidence is `scry report`'s: this command calls
`Scry.reportFilesOf`/`Scry.reportFileOf`, the same functions `scry report` runs, so the
reader's findings and the HTML report's findings cannot disagree. No analysis is added
here; certificates and claims are deliberately absent (P1 fills them; see the design
note §5).

**One span conversion.** `Scry.Origin` is 1-based code-point line/column; the reader's
core is UTF-16 (`Web.Source.Span`). `Scry.webSpanOfOrigin` is the only place that
converts, and every JSON field below is already UTF-16. The browser host therefore never
counts a code point.

**One schema.** The bundle:

```
index.html                           first paint (the SSR of Web.Source.View) + app.js
app.js, app.css, source-static.js    the host (copied from the checkout's web/)
source-live.js, lsp-client.js        the live host (?lsp=); source-live.js imports lsp-client.js
wiz-source-ui.mjs                    optional (--ui): the Loom runtime
framework/{mount,driver,runtime}.js  optional: copied when the checkout has them
data/manifest.json                   schema, tool, file table, hashes, counts
data/files.json                      file metadata (no source)
data/findings.json                   the finding index (semantic ids, spans)
data/f/<fileId>.json                 one file: source, facts, its findings
ui-trace.json                        the SSR and scripted patch trace (acceptance/test)
```

**Determinism.** Files come in the walk's sorted order; findings are sorted by semantic
id; a fact's node id is its position; the manifest pins every file's FNV-1a-64 content
hash and says the hash is not a signature. No timestamp, machine name or elapsed time is
written, so two runs over the same input are byte-identical (`sha256sum data/*.json`).

**Nothing private.** The bundle embeds exactly the source this run was asked to analyse.
The command reads no rule pack, workspace note or private path.
-/

-- ## Options and usage

structure Scry.WebOpts where
  path : String
  out : String
  rules : Option String
  allowErrors : Bool
  timeoutSecs : Option Nat
  maxNodes : Option Nat
  maxRounds : Option Nat
  assets : Option String
  ui : Option String
  sources : List String

def Scry.emptyWebOpts : Scry.WebOpts :=
  Scry.WebOpts.mk "" "web-bundle" .none .false (.some 300) (.some 2000000) .none .none
    .none []

def Scry.webUsage : String :=
  "usage: scry web FILE.c|DIR --out BUNDLE [--rules FILE] [--allow-errors]\n"
  ++ "                [--timeout SECS] [--max-nodes N] [--max-rounds N]\n"
  ++ "                [--assets DIR] [--ui FILE] [--source FILE]...\n"
  ++ "  writes a static source-reader bundle (index.html + data/*.json).\n"
  ++ "  FILE.c|DIR    *.c only; a C#-only tree is refused (exit 1) and names\n"
  ++ "                `scry cs --bundle DIR`, which writes the same reader's data.\n"
  ++ "  --assets DIR  the checkout's web/ directory (source-app.js, source.css,\n"
  ++ "                source-static.js, source-live.js, lsp-client.js, framework/);\n"
  ++ "                default: the first web/ found here.\n"
  ++ "  --ui FILE     copy a built wiz-source-ui.mjs into the bundle (web/build-source-ui.sh).\n"
  ++ "  --source FILE also copy FILE in verbatim, with no analysis (repeatable): a\n"
  ++ "                Wiz file read in the pane, with the live host answering hover\n"
  ++ "                and definition (web/source-live.js, ?lsp=)."

partial def Scry.webArgsGo (path : Option String) (o : Scry.WebOpts) :
    List String → Except String Scry.WebOpts
  | .nil => match path with
    | .some p => .ok { o with path := p }
    | .none => .error Scry.webUsage
  | .cons a rest => match a with
    | "--out" => match rest with
      | .cons p more => Scry.webArgsGo path { o with out := p } more
      | .nil => .error "--out needs an output directory"
    | "--rules" => match rest with
      | .cons p more => Scry.webArgsGo path { o with rules := .some p } more
      | .nil => .error "--rules needs a file"
    | "--allow-errors" => Scry.webArgsGo path { o with allowErrors := .true } rest
    | "--assets" => match rest with
      | .cons p more => Scry.webArgsGo path { o with assets := .some p } more
      | .nil => .error "--assets needs a directory"
    | "--ui" => match rest with
      | .cons p more => Scry.webArgsGo path { o with ui := .some p } more
      | .nil => .error "--ui needs a module file"
    | "--source" => match rest with
      | .cons p more => Scry.webArgsGo path { o with sources := List.append o.sources [p] } more
      | .nil => .error "--source needs a file"
    | "--timeout" => match rest with
      | .cons p more => match String.parseNat p with
        | .some n => Scry.webArgsGo path { o with timeoutSecs := .some n } more
        | .none => .error ("--timeout needs a number of seconds, not \"" ++ p ++ "\"")
      | .nil => .error "--timeout needs a number of seconds"
    | "--max-nodes" => match rest with
      | .cons p more => match String.parseNat p with
        | .some n => Scry.webArgsGo path { o with maxNodes := .some n } more
        | .none => .error ("--max-nodes needs a node count, not \"" ++ p ++ "\"")
      | .nil => .error "--max-nodes needs a node count"
    | "--max-rounds" => match rest with
      | .cons p more => match String.parseNat p with
        | .some n => Scry.webArgsGo path { o with maxRounds := .some n } more
        | .none => .error ("--max-rounds needs a round count, not \"" ++ p ++ "\"")
      | .nil => .error "--max-rounds needs a round count"
    | "--help" => .error Scry.webUsage
    | _ => match String.startsWith a "--" with
      | .true => .error ("unknown flag " ++ a ++ "\n" ++ Scry.webUsage)
      | .false => match path with
        | .some _ => .error ("unexpected argument " ++ a ++ "\n" ++ Scry.webUsage)
        | .none => Scry.webArgsGo (.some a) o rest

def Scry.webArgs (args : List String) : Except String Scry.WebOpts :=
  match Scry.webArgsGo .none Scry.emptyWebOpts args with
  | .error e => .error e
  | .ok o => match o.path, o.out with
    | "", _ => .error Scry.webUsage
    | _, "" => .error "--out needs an output directory"
    | _, _ => .ok o

/-- The `scry report` options for one file: the same pipeline, not a copy. -/
def Scry.webReportOpts (o : Scry.WebOpts) (file : String) : Scry.ReportOpts :=
  { Scry.emptyReportOpts with path := file, rules := o.rules,
    allowErrors := o.allowErrors, timeoutSecs := o.timeoutSecs,
    maxNodes := o.maxNodes, maxRounds := o.maxRounds }

/-- The whole bundle's models, in the file walk's order. Every file is
`Scry.reportFileOf`'s (the pipeline `scry report` runs), turned into the reader's tables by
`Scry.bundleModelOf`; this is the C half, and `scry cs` is the C# half of the same shape. -/
partial def Scry.webModelsGo (o : Scry.WebOpts) :
    List String → EIO (List Source.File × List Source.Finding × List Source.FactRow)
  | .nil => EIO.pure (([] : List Source.File), ([] : List Source.Finding),
      ([] : List Source.FactRow))
  | .cons f rest => do
    rf ← Scry.reportFileOf (Scry.webReportOpts o f) f;
    let m := Scry.bundleModelOf rf [] 0;
    more ← Scry.webModelsGo o rest;
    EIO.pure (List.cons m.1 more.1,
      List.append m.2.1 more.2.1, List.append m.2.2 more.2.2)

/-- The reader model of one `--source` file: its text, no findings and no facts. The id
is a content *name* rather than an analysis anchor, because nothing was analysed; the
path is what `--source` was given (so the live host can form the LSP URI). -/
def Scry.webSourceOf (path : String) : EIO Source.File := do
  text ← FS.readFile path;
  let i := EditorModel.index text;
  EIO.pure (Source.File.mk (String.append "src_" (Scry.wfHex (Scry.wfFnv path)))
    path (Scry.webLanguage path) text (EditorModel.lineCount i))

/-- The `--source` files, in flag order, skipping a path that was already named. -/
partial def Scry.webSourcesGo : List String → List String → EIO (List Source.File)
  | .nil, _ => EIO.pure []
  | .cons p rest, seen => match List.any (fun q => String.eq q p) seen with
    | .true => Scry.webSourcesGo rest seen
    | .false => do
      f ← Scry.webSourceOf p;
      more ← Scry.webSourcesGo rest (List.cons p seen);
      EIO.pure (List.cons f more)

/-- An answer's `lines` array: `[{"text","code","rule","ellipsis"}]`. -/
def Scry.webLinesJson (lines : List Hover.Line) : Json :=
  Json.mkArr (List.map (fun l => Json.mkObj
    [ ("text", Json.mkStr l.text), ("code", Json.mkBool l.code)
    , ("rule", Json.mkBool l.rule), ("ellipsis", Json.mkBool l.ellipsis) ]) lines)

/-- `scry.source.answer/1`, the one schema both transports produce. -/
def Scry.webAnswerJson (request fileId : String) (span : Option Source.Span)
    (spanText title rule severity findingId : String) (lines : List Hover.Line)
    (rows : List Source.FactRow) (findings : List Source.Finding)
    (indexOf : String → Option EditorModel.PositionIndex) : String :=
  let rowJson : Source.FactRow → Json := fun r => match indexOf r.fileId with
    | .some i => Scry.webFactJson i r
    | .none => Json.mkObj [("kind", Json.mkStr r.kind)];
  let findingJson : Source.Finding → Json := fun f => match indexOf f.fileId with
    | .some i => Scry.webFindingJson i f
    | .none => Json.mkObj [("id", Json.mkStr f.id), ("path", Json.mkStr f.path)];
  Json.render (Json.mkObj
    [ ("schema", Json.mkStr "scry.source.answer/1")
    , ("request", Json.mkStr request)
    , ("status", Json.mkStr "ok")
    , ("fileId", Json.mkStr fileId)
    , ("span", match span with
        | .some s => Scry.webSpanJson s
        | .none => Json.mkNull)
    , ("spanText", Json.mkStr spanText)
    , ("title", Json.mkStr title)
    , ("rule", Json.mkStr rule)
    , ("severity", Json.mkStr severity)
    , ("findingId", Json.mkStr findingId)
    , ("lines", Scry.webLinesJson lines)
    , ("rows", Json.mkArr (List.map rowJson rows))
    , ("findings", Json.mkArr (List.map findingJson findings))
    ])

/-- The hover answer for a finding: its rule, severity, derivation status, message and
the sink text. This is what `web/source-static.js` produces in the browser. -/
def Scry.webHoverAnswer (files : List Source.File) (facts : List Source.FactRow)
    (f : Source.Finding) : String :=
  let i := match Scry.webIndexOf files f.fileId with
    | .some x => x
    | .none => EditorModel.index "";
  let sinkText := match Scry.webFileOf files f.fileId with
    | .some file => EditorModel.slice (EditorModel.index file.text) f.span.start f.span.stop
    | .none => "";
  let checkedText := match f.checked with
    | .true => "rule derivation checked against this EDB"
    | .false => "no certificate (unchecked)";
  let lines :=
    [ Hover.textLine f.rule
    , Hover.textLine (String.append "severity: " (String.append f.severity
        (String.append " · " checkedText)))
    , Hover.textLine f.message
    , Hover.codeLine sinkText
    ];
  Scry.webAnswerJson "hover" f.fileId (.some f.span) (Source.Span.show i f.span)
    (Source.View.title f) f.rule f.severity f.id lines [] [] (Scry.webIndexOf files)

/-- The info answer for a finding's sink: the fact rows and the findings at that node. -/
def Scry.webInfoAnswer (files : List Source.File) (facts : List Source.FactRow)
    (findings : List Source.Finding) (f : Source.Finding) : String :=
  let i := match Scry.webIndexOf files f.fileId with
    | .some x => x
    | .none => EditorModel.index "";
  let rows := Source.factsAt facts f.fileId f.span.start;
  let at := Source.findingsAt findings f.fileId f.span.start;
  let title := String.append "Info at " (Source.Span.show i f.span);
  Scry.webAnswerJson "info" f.fileId (.some f.span) (Source.Span.show i f.span)
    title "" "" "" [] rows at (Scry.webIndexOf files)

-- ## The UI trace

/-- Apply an answer exactly as the runtime's `"answer"` effect does (decode, then store),
so a trace that passes also checks the decoder. -/
def Scry.webApplyAnswer (s : Source.Page) (json : String) : Source.Page :=
  match Source.Static.decodeAnswer json with
  | .some a => Source.Page.answer s a
  | .none => s

/-- The three trace steps for one finding (select, hover, info), threading the page. -/
def Scry.webTraceStepsGo (app : Loom.LiveApp Source.Page Source.Msg) (files : List Source.File)
    (facts : List Source.FactRow) (findings : List Source.Finding) :
    Source.Page → List Source.Finding → List Json → Source.Page × List Json
  | prev, .nil, acc => (prev, acc)
  | prev, .cons f rest, acc =>
    let selected := Source.Page.step prev (.select f.id);
    let hovered := Scry.webApplyAnswer selected (Scry.webHoverAnswer files facts f);
    let informed := Scry.webApplyAnswer hovered (Scry.webInfoAnswer files facts findings f);
    let acc1 := List.append acc
      [ Json.mkObj
          [ ("name", Json.mkStr (String.append "select:" f.id))
          , ("patches", Json.mkStr (Loom.LiveApp.patches app prev selected))
          , ("html", Json.mkStr (Loom.LiveApp.html app selected)) ]
      , Json.mkObj
          [ ("name", Json.mkStr (String.append "hover:" f.id))
          , ("patches", Json.mkStr (Loom.LiveApp.patches app selected hovered))
          , ("html", Json.mkStr (Loom.LiveApp.html app hovered)) ]
      , Json.mkObj
          [ ("name", Json.mkStr (String.append "info:" f.id))
          , ("patches", Json.mkStr (Loom.LiveApp.patches app hovered informed))
          , ("html", Json.mkStr (Loom.LiveApp.html app informed)) ]
      ];
    Scry.webTraceStepsGo app files facts findings informed rest acc1

/-- The `#/f/<id>` route step for one finding. -/
def Scry.webTraceRoute (app : Loom.LiveApp Source.Page Source.Msg)
    (s0 : Source.Page) (f : Source.Finding) : Json :=
  let routed := Source.Page.route s0 (String.append "#/f/" f.id);
  Json.mkObj
    [ ("name", Json.mkStr (String.append "route:#/f/" f.id))
    , ("patches", Json.mkStr (Loom.LiveApp.patches app s0 routed))
    , ("html", Json.mkStr (Loom.LiveApp.html app routed)) ]

/-- The UI trace (`data/ui.json`): the first paint and the patch lists for the scripted
interactions the acceptance test replays. The patches are the real
`Loom.LiveApp.patches` of `Web.Source.View.app`, and every answer is decoded with
`Web.Source.Static.decodeAnswer` before it is applied. -/
def Scry.webUiTraceJson (b : Source.Bundle) : String :=
  let app := Source.View.app;
  let s0 := Source.Page.loaded Source.Page.initial b.mode b.tool b.files b.findings b.facts;
  let answers := List.concat (List.map (fun f =>
      [ Json.mkObj
          [ ("name", Json.mkStr (String.append "hover:" f.id))
          , ("kind", Json.mkStr "hover")
          , ("json", Json.mkStr (Scry.webHoverAnswer b.files b.facts f)) ]
      , Json.mkObj
          [ ("name", Json.mkStr (String.append "info:" f.id))
          , ("kind", Json.mkStr "info")
          , ("json", Json.mkStr (Scry.webInfoAnswer b.files b.facts b.findings f)) ]
      ]) b.findings);
  let walk := Scry.webTraceStepsGo app b.files b.facts b.findings s0 b.findings [];
  let routes := List.map (Scry.webTraceRoute app s0) b.findings;
  Json.render (Json.mkObj
    [ ("schema", Json.mkStr "scry.source.ui/1")
    , ("initial", Json.mkStr (Loom.LiveApp.html app s0))
    , ("answers", Json.mkArr answers)
    , ("steps", Json.mkArr (List.append walk.2 routes))
    ])

/-- `scry web`: analyse, build the models, write the bundle, say what it wrote.

The walk runs first and a target with no `*.c` is refused **before** anything is
analysed or written: a C#-only tree says so and names `scry cs` (for the C# bundle, and
for `scry cs --bundle`), and a directory with no visible file says the search found
nothing. Either way the exit status is non-zero, so an empty bundle can never stand in
for a clean one. A directory that does hold `*.c` files but also `*.cs` files says how
many C# files it is not reading. -/
def Scry.webRun (o : Scry.WebOpts) : EIO Nat := do
  w ← Scry.reportWalkOf o.path;
  let _guard := match w.files with
    | .nil => match Nat.lt 0 w.cs with
      | .true => EIO.fail (String.append (Scry.refuseCsOnly "web" o.path w)
          " For a bundle of the C#, run `scry cs --bundle DIR " ++ o.path ++ "`.")
      | .false => EIO.fail ("scry web: no *.c file under " ++ o.path
          ++ " (no files at all were visible: an empty directory, or only hidden entries)."
          ++ " Nothing was written; name a C tree, or C# with `scry cs --bundle DIR " ++ o.path
          ++ "`.")
    | _ => EIO.pure ();
  _guard;
  let note : EIO Unit := match Nat.lt 0 w.cs with
    | .true => EIO.lift (IO.ePrintln ("note: " ++ o.path ++ " also has "
        ++ Nat.repr w.cs ++ " *.cs file(s), which this bundle does not read "
        ++ "(only *.c; use `scry cs --bundle DIR` for those)"))
    | .false => EIO.pure ();
  note;
  let files := w.files;
  models ← Scry.webModelsGo o files;
  sources ← Scry.webSourcesGo o.sources ([] : List String);
  let bundleFiles := List.append models.1 sources;
  Scry.bundleWarnLarge bundleFiles;
  let bundleFindings := Scry.webSortById models.2.1;
  let bundleFacts := models.2.2;
  let tool := Scry.sourceTool;
  let payload := Json.render (Scry.webBundleUiJson "static" tool bundleFiles bundleFindings
    bundleFacts (Scry.webIndexOf bundleFiles));
  let bundle := match Source.Static.decodeBundle payload with
    | .some b => b
    | .none => Source.Bundle.mk "static" tool bundleFiles bundleFindings bundleFacts;
  let trace := Scry.webUiTraceJson bundle;
  let ssr := match Json.parse trace with
    | .ok j => Json.getStr j "initial"
    | .error _ => "";
  -- Directories.
  let out := o.out;
  Scry.bundleDirs out;
  -- The host files and the framework.
  assets ← Scry.webFindAssets o.assets;
  hostCopied ← (match assets with
    | .none => EIO.pure ([] : List String)
    | .some d => Scry.webCopyHostGo d out
        [("source-app.js", "app.js"), ("source.css", "app.css"),
         ("source-static.js", "source-static.js"),
         ("source-live.js", "source-live.js"),
         ("lsp-client.js", "lsp-client.js")]);
  frameworkCopied ← (match assets with
    | .none => EIO.pure ([] : List String)
    | .some d => Scry.webCopyFrameworkGo d out
        ["mount.js", "driver.js", "runtime.js", "adopt.js"]);
  runtimeCopied ← (match o.ui with
    | .none => EIO.pure Bool.false
    | .some src => Scry.webCopy src (String.append out "/wiz-source-ui.mjs"));
  -- Data files.
  Scry.bundleWriteData out tool bundleFiles bundleFindings bundleFacts hostCopied
    frameworkCopied runtimeCopied [];
  -- The scripted patch trace is a test/first-paint artifact, not part of the data the
  -- browser loads; it sits at the bundle root so `data/` stays the product.
  FS.writeFile (String.append out "/ui-trace.json") (String.append trace "\n");
  FS.writeFile (String.append out "/index.html") (Scry.bundleIndexHtml ssr);
  EIO.lift (IO.println ("wrote source bundle: " ++ out ++ " ("
    ++ Nat.repr (List.length bundleFiles) ++ " file(s), "
    ++ Nat.repr (List.length bundleFindings) ++ " finding(s), "
    ++ Nat.repr (List.length bundleFacts) ++ " fact(s); no timestamp, stable ids)"));
  EIO.pure 0

def Scry.webCmd (args : List String) : EIO Nat :=
  match Scry.webArgs args with
  | .ok o => Scry.webRun o
  | .error e => EIO.fail e
