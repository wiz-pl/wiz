import Prelude
import Word
import Text
import Scry.Store
/-!
# Scry.Datalog

The **deep embedding** of scry's lattice-valued Datalog (`import Scry.Datalog`), with
no surface syntax and no parser. A program is a value of `Program L`:

* `Term` is a variable (`var n`) or a literal (`lit v`); every column is a `U64`, as in
  `Scry.Store`;
* `Atom` is a positive relation atom (`pos`), a negated one (`neg`), or a
  lattice-valued atom (`lat rel key valueVar`, which reads the relation's value for a
  key and binds it to lattice variable `valueVar`);
* `Head` is a tuple head or a lattice head whose value is an `LExpr` (`lit`, a lattice
  variable, `join`, or a Wiz function from `Program.funcs` applied to an expression);
* a `Rule` is a head and a body; a `Program` adds the lattice operations, the arities,
  which relations are lattice-valued, and the transfer-function table.

`Program.check` is the macro's job done as a function of the deep embedding:
**range restriction** (every head variable and every negated variable is bound by a
positive body atom; every lattice head variable by a lattice body atom) and
**stratification** (a negated atom's relation must be in a strictly lower stratum than
the rule's head). `check` returns the stratum of every relation, or `.none`.

`Program.checkMono` adds the engine's **monotonicity obligation**: a `MonoDecl`
registers every rule that writes a lattice relation, and every transfer function a
lattice head `map`s. A rule registered monotone whose head expression is not
structurally monotone is a gap, and a checked evaluator refuses the program. Because a
Wiz function's behaviour is not decidable here, the flags are the author's claim and the
checker verifies the shape where it can. `Scry.Termination` is the matching termination
contract: a run stopped at its round budget carries `.rounds limit ran`, never a silent
short answer.

The evaluator is in `Scry.Eval`. The theorems a later stage wants (`Program.sem` is the
least fixpoint, `Derivation.check`) are not here: this stage is the executable
semantics and its reference implementation.
-/

/-- A term: a variable or a column value. -/
inductive Scry.Term where
  | var (n : Nat)
  | lit (v : U64)

/-- A lattice's operations, as a record passed explicitly (no type-class search in the
evaluator): bottom, join, and equality for deciding whether a value moved. `le` is
derived (`join a b = b`), as with a partial order. -/
structure Scry.LatOps (L : Type) where
  bot : L
  join : L → L → L
  eq : L → L → Bool

def Scry.LatOps.le {L : Type} (ops : Scry.LatOps L) (a b : L) : Bool :=
  ops.eq (ops.join a b) b

/-- A lattice expression: a constant, a body lattice variable, a join, or a function
from the program's `funcs` table applied to an expression. -/
inductive Scry.LExpr (L : Type) where
  | lit (v : L)
  | var (n : Nat)
  | join (a b : Scry.LExpr L)
  | map (f : Nat) (a : Scry.LExpr L)

/-- A body atom. A lattice atom's `val` identifies the lattice variable its value is
bound to; lattice variables and column variables are separate namespaces. -/
inductive Scry.Atom where
  | pos (rel : Nat) (args : List Scry.Term)
  | neg (rel : Nat) (args : List Scry.Term)
  | lat (rel : Nat) (key : List Scry.Term) (val : Nat)

/-- A rule head. -/
inductive Scry.Head (L : Type) where
  | tuple (rel : Nat) (args : List Scry.Term)
  | lat (rel : Nat) (key : List Scry.Term) (val : Scry.LExpr L)

structure Scry.Rule (L : Type) where
  head : Scry.Head L
  body : List Scry.Atom

structure Scry.Program (L : Type) where
  ops : Scry.LatOps L
  arities : List Nat
  latRels : List Nat
  funcs : List (L → L)
  rules : List (Scry.Rule L)

-- ## Small list helpers

def Scry.natMem (n : Nat) (l : List Nat) : Bool := List.any (Nat.beq n) l

def Scry.natSubset (xs ys : List Nat) : Bool :=
  List.foldr (fun x acc => if Scry.natMem x ys then acc else .false) .true xs

def Scry.concatMap {A B : Type} (f : A → List B) : List A → List B
  | .nil => .nil
  | .cons x xs => List.append (f x) (Scry.concatMap f xs)

def Scry.zeros : Nat → List Nat
  | .zero => .nil
  | .succ n => .cons 0 (Scry.zeros n)

def Scry.maxNat : List Nat → Nat
  | .nil => 0
  | .cons x xs => if Nat.lt (Scry.maxNat xs) x then x else Scry.maxNat xs

-- ## Ranges, arities and stratification

def Scry.Term.vars : Scry.Term → List Nat
  | .var n => .cons n .nil
  | .lit _ => .nil

def Scry.termsVars (ts : List Scry.Term) : List Nat :=
  List.foldr (fun t acc => List.append t.vars acc) .nil ts

def Scry.Atom.rel : Scry.Atom → Nat
  | .pos r _ => r
  | .neg r _ => r
  | .lat r _ _ => r

/-- The variables a positive atom binds. A negation and a lattice value bind nothing
(the negation's variables must already be bound). -/
def Scry.Atom.posVars : Scry.Atom → List Nat
  | .pos _ args => Scry.termsVars args
  | .neg _ _ => .nil
  | .lat _ key _ => Scry.termsVars key

def Scry.Atom.negVars : Scry.Atom → List Nat
  | .pos _ _ => .nil
  | .neg _ args => Scry.termsVars args
  | .lat _ _ _ => .nil

def Scry.Atom.relOk {L : Type} (p : Scry.Program L) (a : Scry.Atom) : Bool :=
  Nat.lt a.rel (List.length p.arities)

/-- A `lat` atom names a lattice relation; a `pos`/`neg` atom names an ordinary one. -/
def Scry.Atom.kindOk {L : Type} (p : Scry.Program L) (a : Scry.Atom) : Bool :=
  match a with
  | .lat r _ _ => Scry.natMem r p.latRels
  | .pos r _ => if Scry.natMem r p.latRels then .false else .true
  | .neg r _ => if Scry.natMem r p.latRels then .false else .true

def Scry.Atom.arityOk {L : Type} (p : Scry.Program L) (a : Scry.Atom) : Bool :=
  Nat.beq (List.length (match a with
    | .pos _ args => args
    | .neg _ args => args
    | .lat _ key _ => key)) (List.getD p.arities a.rel 0)

def Scry.LExpr.vars {L : Type} : Scry.LExpr L → List Nat
  | .lit _ => .nil
  | .var n => .cons n .nil
  | .join a b => List.append (Scry.LExpr.vars a) (Scry.LExpr.vars b)
  | .map _ a => Scry.LExpr.vars a

def Scry.Atom.latVal : Scry.Atom → Option Nat
  | .lat _ _ v => .some v
  | _ => .none

def Scry.Head.rel {L : Type} : Scry.Head L → Nat
  | .tuple r _ => r
  | .lat r _ _ => r

def Scry.Program.arity {L : Type} (p : Scry.Program L) (r : Nat) : Nat :=
  List.getD p.arities r 0
def Scry.Program.isLat {L : Type} (p : Scry.Program L) (r : Nat) : Bool :=
  Scry.natMem r p.latRels

/-- Every head variable and every negated variable is bound by a positive body atom,
every lattice head variable by a body lattice atom, and every atom has its declared
arity. -/
def Scry.Rule.rangeOk {L : Type} (p : Scry.Program L) (r : Scry.Rule L) : Bool :=
  let bound : List Nat := List.foldr (fun (a : Scry.Atom) (acc : List Nat) => List.append a.posVars acc) [] r.body;
  let latBound : List Nat := List.foldr (fun (a : Scry.Atom) (acc : List Nat) => match a.latVal with
    | .none => acc
    | .some v => List.cons v acc) [] r.body;
  let headVars : List Nat := match r.head with
    | .tuple _ args => Scry.termsVars args
    | .lat _ key _ => Scry.termsVars key;
  let latHeadVars : List Nat := match r.head with
    | .tuple _ _ => .nil
    | .lat _ _ val => val.vars;
  let negOk : Bool := List.foldr (fun (a : Scry.Atom) (acc : Bool) =>
    if Scry.natSubset a.negVars bound then acc else .false) .true r.body;
  let arityOk : Bool := List.foldr (fun (a : Scry.Atom) (acc : Bool) =>
    if Scry.Atom.relOk p a then
      if Scry.Atom.kindOk p a then
        if Scry.Atom.arityOk p a then acc else .false
      else .false
    else .false) .true r.body;
  let headKindOk := match r.head with
    | .tuple rel _ => if Scry.natMem rel p.latRels then Bool.false else Bool.true
    | .lat rel _ _ => Scry.natMem rel p.latRels;
  let headRelOk := Nat.lt r.head.rel (List.length p.arities);
  let headArity := match r.head with
    | .tuple _ args => List.length args
    | .lat _ key _ => List.length key;
  let headArityOk := Nat.beq headArity (p.arity r.head.rel);
  if Scry.natSubset headVars bound then
    if Scry.natSubset latHeadVars latBound then
      if negOk then
        if arityOk then
          if headRelOk then
            if headKindOk then
              if headArityOk then .true else .false
            else .false
          else .false
        else .false
      else .false
    else .false
  else .false

def Scry.Program.wellFormed {L : Type} (p : Scry.Program L) : Bool :=
  List.foldr (fun (r : Scry.Rule L) (acc : Bool) => if Scry.Rule.rangeOk p r then acc else Bool.false) Bool.true p.rules

/-- The least stratum a rule's head may have, given the strata of its body relations.
A negated atom needs one more than its relation. -/
def Scry.Atom.stratumReq (strata : List Nat) : Scry.Atom → Nat
  | .pos r _ => List.getD strata r 0
  | .neg r _ => Nat.succ (List.getD strata r 0)
  | .lat r _ _ => List.getD strata r 0

def Scry.Rule.stratumReq {L : Type} (strata : List Nat) (r : Scry.Rule L) : Nat :=
  List.foldr (fun (a : Scry.Atom) (m : Nat) => if Nat.lt m (Scry.Atom.stratumReq strata a) then Scry.Atom.stratumReq strata a else m)
    (0 : Nat) r.body

/-- One relaxation pass over every rule: raise a head's stratum until it covers its
body. The flag says whether anything moved. -/
def Scry.Program.stratPass {L : Type} (p : Scry.Program L) (strata : List Nat) : List Nat × Bool :=
  List.foldr (fun (r : Scry.Rule L) (acc : List Nat × Bool) =>
    let need := Scry.Rule.stratumReq acc.1 r;
    let hs := List.getD acc.1 r.head.rel 0;
    if Nat.lt hs need then (List.setAt acc.1 r.head.rel need, .true) else acc)
    (strata, .false) p.rules

def Scry.Program.stratPasses {L : Type} (p : Scry.Program L) :
    Nat → List Nat → List Nat × Bool
  | .zero, strata => Scry.Program.stratPass p strata
  | .succ n, strata => match Scry.Program.stratPass p strata with
    | (strata', _) => Scry.Program.stratPasses p n strata'

/-- Strata for every relation, or `.none` if a negative dependency is cyclic. A simple
path has at most `#relations` edges, so `#relations + 1` passes suffice: if the last
pass still moves something, a negation lies on a cycle. -/
def Scry.Program.stratify {L : Type} (p : Scry.Program L) : Option (List Nat) :=
  let strata := Scry.zeros (List.length p.arities);
  match Scry.Program.stratPasses p (Nat.succ (List.length p.arities)) strata with
  | (final, .true) => .none
  | (final, .false) => .some final

/-- Range restriction and stratification, the checks the surface macro will perform. -/
def Scry.Program.check {L : Type} (p : Scry.Program L) : Option (List Nat) :=
  if Scry.Program.wellFormed p then Scry.Program.stratify p else .none

-- ## The monotonicity and termination obligation

/-- How a lattice fixpoint stopped. `fixpoint` is the complete run; `rounds limit ran`
is a run that hit its round budget, so every derived relation is a lower bound and an
absence claim is not allowed. -/
inductive Scry.Termination where
  | fixpoint
  | rounds (limit : Nat) (ran : Nat)

def Scry.Termination.complete : Scry.Termination → Bool
  | .fixpoint => .true
  | .rounds _ _ => .false

/-- A one-line explanation of a truncated run (`none` when the fixpoint was reached). -/
def Scry.Termination.reason : Scry.Termination → Option String
  | .fixpoint => .none
  | .rounds limit ran =>
    .some ("fixpoint stopped after " ++ Nat.repr ran ++ " round(s) at --max-rounds "
      ++ Nat.repr limit ++ ": the derived relations are a lower bound, so recall is"
      ++ " reduced (a reported finding is still a real derivation)")

/-- The **monotonicity registration** of a program: one flag per rule (in
`Program.rules` order) and one per transfer function (in `Program.funcs` order).

The engine's delta loop assumes every lattice value only moves up a finite order. That
assumption is not decidable for an arbitrary Wiz function, so it is an explicit
obligation here: a rule that writes a lattice relation must be registered (`true`), and
a registered rule's head expression must be built only from `lit`, `var`, `join` and a
`map` whose transfer is also registered `true`. `checkMono` verifies that shape; the
flags themselves are the author's claim about the transfer's behaviour. A run without a
full registration is reported as `monoChecked = false`. -/
structure Scry.MonoDecl where
  /-- One entry per `Program.rules`; `true` registers the rule as monotone. -/
  rules : List Bool
  /-- One entry per `Program.funcs`; `true` registers the transfer as monotone. -/
  funcs : List Bool

/-- The structural half of the obligation: every `map` names a transfer registered
monotone, and `join` is monotone when both sides are. -/
def Scry.LExpr.monoOk {L : Type} (funcs : List Bool) : Scry.LExpr L → Bool
  | .lit _ => .true
  | .var _ => .true
  | .join a b => if Scry.LExpr.monoOk funcs a then Scry.LExpr.monoOk funcs b else .false
  | .map i a => if List.getD funcs i .false then Scry.LExpr.monoOk funcs a else .false

/-- The first rule the declaration does not cover, with a reason. A lattice-head rule
that is not registered, or is registered but whose head expression is not structurally
monotone, is a gap; a tuple-head rule is monotone by construction. -/
def Scry.Program.monoGapFrom {L : Type} (p : Scry.Program L) (decl : Scry.MonoDecl) :
    List (Scry.Rule L) → Nat → Option String
  | .nil, _ => .none
  | .cons r rest, i =>
    match r.head with
    | .tuple _ _ => Scry.Program.monoGapFrom p decl rest (Nat.succ i)
    | .lat rel _ val =>
      match List.getD decl.rules i .false with
      | .false =>
        .some ("rule " ++ Nat.repr i ++ " writes lattice relation " ++ Nat.repr rel
          ++ " but is not registered in the monotonicity declaration")
      | .true =>
        match Scry.LExpr.monoOk decl.funcs val with
        | .true => Scry.Program.monoGapFrom p decl rest (Nat.succ i)
        | .false =>
          .some ("rule " ++ Nat.repr i ++ " is registered monotone, but its lattice head"
            ++ " maps a transfer function that is not declared monotone (or nests a map"
            ++ " under one)")

def Scry.Program.monoGap {L : Type} (p : Scry.Program L) (decl : Scry.MonoDecl) :
    Option String :=
  Scry.Program.monoGapFrom p decl p.rules 0

/-- The result of `check` plus the monotonicity registration. `none` still means the
program is not well formed or not stratified; `gap` names the first uncovered lattice
rule (a checked evaluator refuses such a program). -/
structure Scry.MonoCheck where
  strata : List Nat
  /-- `none` means every lattice rule has a structural monotonicity registration. -/
  gap : Option String

def Scry.Program.checkMono {L : Type} (p : Scry.Program L) (decl : Scry.MonoDecl) :
    Option Scry.MonoCheck :=
  match Scry.Program.check p with
  | .none => .none
  | .some strata => .some (Scry.MonoCheck.mk strata (Scry.Program.monoGap p decl))

/-- Why a program fails the obligation: a structural error, or the first uncovered
lattice rule. `none` means the registration is complete. -/
def Scry.Program.obligationError {L : Type} (p : Scry.Program L) (decl : Scry.MonoDecl) :
    Option String :=
  match Scry.Program.check p with
  | .none => .some "program failed range restriction or stratification"
  | .some _ => Scry.Program.monoGap p decl

-- ## Equality-sorted columns (S12 seam)

/-- The kind of a relation column. `u64` is an ordinary 64-bit word; `eqsort s` is a
column whose values are e-class ids of equality sort `s`. The canonicalisation step of
`Scry.EqPlan` rewrites an `eqsort` column to its class representative, and an equality
assertion merges the two classes a row names. The kind is declared in an `EqCol` schema
next to the program, so existing `Program`s are unchanged (`Scry.Datalog`'s typed-column
work owns the column types themselves). -/
inductive Scry.ColKind where
  | u64
  | eqsort (sort : Nat)

/-- One equality-sorted column: relation `rel`, column index `col`, equality sort
`sort`. A relation with two `eqsort` columns of the same sort can be the target of an
equality assertion (`Head.eqAssert`). -/
structure Scry.EqCol where
  rel : Nat
  col : Nat
  sort : Nat

def Scry.EqCols.forRel (cols : List Scry.EqCol) (rel : Nat) : List Scry.EqCol :=
  List.filter (fun c => Nat.beq c.rel rel) cols

/-- The declared kind of one column (`u64` when nothing is declared). -/
def Scry.EqCols.kindAt (cols : List Scry.EqCol) (rel col : Nat) : Scry.ColKind :=
  match List.filter (fun c => Bool.and (Nat.beq c.rel rel) (Nat.beq c.col col)) cols with
  | .nil => .u64
  | .cons c _ => .eqsort c.sort

/-- The equality sort of a column, if it is one. -/
def Scry.EqCols.sortAt (cols : List Scry.EqCol) (rel col : Nat) : Option Nat :=
  match Scry.EqCols.kindAt cols rel col with
  | .u64 => .none
  | .eqsort s => .some s

/-- Whether a relation has at least one equality-sorted column. -/
def Scry.EqCols.hasEq (cols : List Scry.EqCol) (rel : Nat) : Bool :=
  match Scry.EqCols.forRel cols rel with
  | .nil => .false
  | .cons _ _ => .true

/-- The sorts named by a schema. -/
def Scry.EqCols.sorts (cols : List Scry.EqCol) : List Nat :=
  List.foldr (fun c acc => if Scry.natMem c.sort acc then acc else .cons c.sort acc) .nil cols

/-- A schema is well formed when every declared column exists in its relation. An
`eqsort` column of a **lattice** relation is its key, which is exactly how an e-class
analysis is written down (`itv : EClass → Interval`); a lattice relation has no value
column, so every `eqsort` column on one is a key. -/
def Scry.EqCols.ok {L : Type} (p : Scry.Program L) (cols : List Scry.EqCol) : Bool :=
  List.foldr (fun c acc =>
    if Nat.lt c.rel (List.length p.arities) then
      if Nat.lt c.col (p.arity c.rel) then acc else .false
    else .false) .true cols

/-- A rule head that **asserts an equality**: a tuple head in `rel` (an equality
relation, whose two first columns are `eqsort` of one sort) with the two terms to be
merged. `Scry.EqPlan` calls `EGraph.mergeFacts` on those rows after a round and then
canonicalises the database. -/
def Scry.Head.eqAssert {L : Type} (rel : Nat) (a b : Scry.Term) : Scry.Head L :=
  .tuple rel (.cons a (.cons b .nil))
