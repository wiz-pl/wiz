import Sys
import Json
import Scry.Query
import Scry.Parse
import Scry.CstStore
import Scry.TaintCmd
import Scry.DynamicCmd
import Scry.BenchCmd
import Scry.ProjectIO
import Scry.WorkflowCmd
import Scry.Repl
import Scry.FuzzCmd
import Scry.ReportCmd
import Scry.Native
import Scry.Lower
import Scry.EgraphWil
import Scry.EgraphExtract
/-!
# Scry.Cli: the `scry` command line

The package's CLI (design §7.1 has this as `app/scry.wiz`; plain `App.wiz` here so the
grail target is one file):

```
scry facts FILE                 load a fact store and print its stats
scry query FILE --kind KIND     nodes of a CST kind
scry query FILE --edge LABEL    edges with a label
scry query FILE --edge-src L    sources of edges labelled L
scry query FILE --rel NAME      a relation's tuples
scry explain FILE NODE          one node: span, parent, children, arcs, relations
scry parse FILE… --stats        stats of JSON or scry-cst stores (no tree-sitter: S1)
scry cst FILE OUT.cst           convert a JSON fact store to the native spill format
scry report FILE.c|DIR          one self-contained HTML page of the taint evidence
scry fuzz-span FILE             map a fuzz artifact to CST spans (dynamic evidence)
scry egraph FILE.c [--fuel N] [--rewrite]
                                build Wil e-classes and print fold/rewrite stats;
                                `--rewrite` also runs the checked extraction back to
                                Wil and prints the transformation report
```

Exit status is 0 on success, 1 on an error (a message on stderr), 2 on a usage error.
The grail command targets in `grail.wiz` run `facts`, `query`, `explain` and `parse` over
`fixtures/demo.facts.json`, so `grail build` exercises the loaders end to end.
-/

/-- The CLI's usage text. -/
def Scry.usage : String :=
  "scry: a code-analysis platform in Wiz (S1)\n"
  ++ "\n"
  ++ "usage: scry COMMAND …\n"
  ++ "\n"
  ++ "  facts FILE                 load a fact store and print its stats\n"
  ++ "  query FILE --kind KIND     nodes of a CST kind\n"
  ++ "  query FILE --edge LABEL    edges with a label\n"
  ++ "  query FILE --edge-src L    sources of edges labelled L\n"
  ++ "  query FILE --rel NAME      a relation's tuples\n"
  ++ "  explain FILE NODE          one node: span, parent, children, arcs, relations\n"
  ++ "  parse FILE… --stats        stats of JSON or scry-cst stores (S1)\n"
  ++ "  cst FILE OUT               convert a JSON fact store to scry-cst\n"
  ++ "  taint FILE.c [--rules FILE] [--sarif OUT] [--json] [--allow-errors]\n"
  ++ "              [--fail-on-finding] [--origin-map] [--progress]\n"
  ++ "              [--diff BASE|all] [--changed-lines FILE] [--diff-context N]\n"
  ++ "              [--timeout SECS] [--max-nodes N] [--max-rounds N]\n"
  ++ "                             C -> Wil -> taint -> findings/SARIF\n"
  ++ "                             (default limits: 300 s, 2 000 000 nodes)\n"
  ++ "  limits: default --timeout 300 --max-nodes 2000000; 0 disables a limit.\n"
  ++ "  A truncated fixpoint is reported as scry/budget/* and \"truncated\": true.\n"
  ++ "  dynamic FILE.c [--cc PATH] [--json] [--sarif OUT] [--timeout SECS]\n"
  ++ "              [--no-coverage] [--witness FILE] [--keep] [--work-dir DIR]\n"
  ++ "              [--no-static]\n"
  ++ "                             compile/run under ASAN/UBSAN, correlate with taint\n"
  ++ "  bench [--corpus DIR] [--baseline FILE] [--extra DIR]... [--json OUT]\n"
  ++ "        [--markdown OUT] [--update-baseline FILE] [--no-baseline]\n"
  ++ "        [--no-timing] [--quiet] [--fail-on-regression]\n"
  ++ "        [--dynamic] [--cc PATH] [--no-coverage]\n"
  ++ "                             run the taint corpus and compare with expectations\n"
  ++ "  repl [FILE.c] [--script FILE] [--init CMD] [--llvm]\n"
  ++ "                             the Wiz REPL with Scry.Repl preloaded (load once,\n"
  ++ "                             then query it as ordinary Wiz values)\n"
  ++ "  project DIR [--compdb FILE] [--cc CMD] [--allow-errors] [--facts OUT]\n"
  ++ "              [--taint] [--rules FILE] [--json] [--sarif OUT]\n"
  ++ "              [--cache[=DIR]] [--cache-stats] [--fail-on-finding]\n"
  ++ "              [--keep-system-headers] [--skip-broken]\n"
  ++ "                              preprocess and lower a multi-file C project;\n"
  ++ "                              --taint reports cross-TU findings/SARIF\n"
  ++ "  project query DIR --rel NAME | --func NAME\n"
  ++ "                              a project relation (symbols, callgraph, …) or function table\n"
  ++ "  findings scan|list|show|triage|repro|verify …\n"
  ++ "                             finding identity, triage and evidence bundles\n"
  ++ "  report FILE.c|DIR [--out FILE] [--rules FILE] [--allow-errors]\n"
  ++ "              [--diff BASE|all] [--changed-lines FILE] [--diff-context N]\n"
  ++ "              [--timeout SECS] [--max-nodes N] [--max-rounds N]\n"
  ++ "                             self-contained HTML page of the taint evidence\n"
  ++ "  fuzz-span FILE [--offset N] [--json] [--out FILE]\n"
  ++ "                             map a fuzz artifact's CST/ERROR spans for dynamic evidence\n"
  ++ "  egraph FILE.c [--fuel N] [--rewrite]\n"
  ++ "                             e-classes from lowered Wil, folds and rewrites;\n"
  ++ "                             --rewrite extracts them back into a checked Wil program\n"
  ++ "  help, --help               this text\n"
  ++ "  --version                  the version\n"

/-- Load a fact store from `path`, with a message naming it on failure. -/
def Scry.loadFacts (path : String) : EIO Scry.Facts := Scry.loadFactsFile path

/-- Print a line. -/
def Scry.say (s : String) : EIO Unit := EIO.lift (IO.println s)

/-- `scry facts FILE`. -/
def Scry.factsCmd (file : String) : EIO Nat := do
  f ← Scry.loadFacts file;
  Scry.say (Scry.renderFacts f);
  EIO.pure 0

/-- `scry query FILE …`. -/
def Scry.queryCmd (file : String) (args : List String) : EIO Nat := do
  f ← Scry.loadFacts file;
  match args with
  | .cons "--kind" (.cons kind .nil) => do
    Scry.say (Scry.renderQueryKind f kind);
    EIO.pure 0
  | .cons "--edge" (.cons label .nil) => do
    Scry.say (Scry.renderQueryEdge f label);
    EIO.pure 0
  | .cons "--edge-src" (.cons label .nil) => do
    Scry.say (Scry.renderQueryEdgeSrc f label);
    EIO.pure 0
  | .cons "--rel" (.cons name .nil) => match Scry.renderQueryRel f name with
    | .ok s => do
      Scry.say s;
      EIO.pure 0
    | .error e => EIO.fail e
  | .nil => EIO.fail "usage: scry query FILE --kind KIND | --edge LABEL | --edge-src L | --rel NAME"
  | _ => EIO.fail "usage: scry query FILE --kind KIND | --edge LABEL | --edge-src L | --rel NAME"

/-- `scry explain FILE NODE`. -/
def Scry.explainCmd (file : String) (node : String) : EIO Nat := do
  f ← Scry.loadFacts file;
  match String.parseNat node with
  | .none => EIO.fail ("\"" ++ node ++ "\" is not a node id")
  | .some n => match Scry.explainNode f (Scry.nodeId n) with
    | .ok s => do
      Scry.say s;
      EIO.pure 0
    | .error e => EIO.fail e

/-- Read and print the `parse --stats` block of every path, in order. -/
def Scry.parseBlocks : List String → EIO (List Scry.ParseBlock)
  | .nil => EIO.pure .nil
  | .cons p rest => do
    b ← Scry.parseBlock p;
    bs ← Scry.parseBlocks rest;
    EIO.pure (.cons b bs)

/-- `scry parse FILE… --stats`: one block per store, and a total for several. -/
def Scry.parseStatsAll (files : List String) : EIO Nat := do
  blocks ← Scry.parseBlocks files;
  Scry.say (String.intercalate "\n" (List.map (fun b => b.text) blocks));
  match files with
  | .cons _ (.cons _ _) => do
    Scry.say (Scry.renderParseTotal blocks);
    EIO.pure 0
  | _ => EIO.pure 0

/-- The `parse --stats` block for one path (the tests use this directly). -/
def Scry.parseStats (file : String) : EIO Nat := do
  b ← Scry.parseBlock file;
  Scry.say b.text;
  EIO.pure 0

/-- `--stats` in any position is a flag, not a file. -/
def Scry.isStatsFlag (a : String) : Bool := String.eq a "--stats"

/-- `scry parse FILE… --stats` (`--stats` may come first, last or between files). -/
def Scry.parseCmd (args : List String) : EIO Nat :=
  let files := List.filter (fun a => Bool.not (Scry.isStatsFlag a)) args;
  match List.any Scry.isStatsFlag args with
  | .false => EIO.fail "usage: scry parse FILE… --stats"
  | .true => match files with
    | .nil => EIO.fail "usage: scry parse FILE… --stats (at least one store)"
    | _ => Scry.parseStatsAll files

/-- `scry cst FILE OUT`: load a JSON fact store and write the native columns' spill
format (`Scry.CstStore.render`). -/
def Scry.cstCmd (file : String) (out : String) : EIO Nat := do
  f ← Scry.loadFacts file;
  let s := Scry.CstStore.ofFacts f;
  FS.writeFile out (Scry.CstStore.render s);
  Scry.say ("wrote " ++ Nat.repr (Scry.CstStore.nodeCount s) ++ " nodes, "
    ++ Nat.repr (Scry.CstStore.edgeCount s) ++ " edges, "
    ++ Nat.repr (Scry.CstStore.relationCount s) ++ " relations to " ++ out);
  EIO.pure 0





/-- `scry repl [FILE]`: literally `wiz repl --prelude Scry.Repl -I …`, with `FILE`
loaded through `Scry.Repl.load` before the first input. -/
def Scry.replCmd (args : List String) : EIO Nat := do
  let roots := ["lib", "src", "../lib", "../scry/src"];
  let wizPath := "wiz";
  let rootArgs := List.concat (List.map (fun r => ["-I", r]) roots);
  let (file, rest) := match args with
    | .cons a more => match String.startsWith a "--" with
      | .true => ((Option.none : Option String), args)
      | .false => ((Option.some a : Option String), more)
    | .nil => ((Option.none : Option String), ([] : List String));
  step ← (match file with
    | .some f => do
      s ← EIO.lift (Scry.Repl.load f);
      EIO.pure s
    | .none => EIO.pure ());
  st ← Process.runWith wizPath (List.append ["repl", "--prelude", "Scry.Repl"]
    (List.append rootArgs rest)) SpawnOptions.default;
  EIO.pure (match st with | .exited n => n | _ => 1)

/-- `scry egraph FILE.c [--fuel N] [--rewrite]`: parse C with the native store, lower it
to Wil, build the e-classes and run the fold/identity saturation. The first report is
read-only. With `--rewrite`, `Scry.EgraphExtract` extracts the saturated classes back
into Wil under its soundness checks and prints a second report; the CST and every Datalog
fact are still untouched (the transformed program is only printed, not re-emitted). -/
def Scry.egraphCmd (file : String) (fuel : Nat) (rewrite : Bool) : EIO Nat := do
  st ← Scry.Native.parseFile file;
  cst ← EIO.lift (Scry.Native.toCstStore file st);
  src ← FS.readFile file;
  let c := Scry.Cst.ofStore src cst;
  let tu := Scry.lowerTU file c;
  let p := Wil.program tu.funcs;
  let b := Scry.wgBuildProgram p;
  let s := Scry.wgSaturate fuel b.g .nil;
  Scry.say (Scry.wgRenderReport file b s);
  match rewrite with
  | .false => EIO.pure 0
  | .true => do
    let t := Scry.wgeRewriteProgram fuel p;
    Scry.say (Scry.wgeRenderReport file t);
    EIO.pure 0

/-- `scry egraph`'s arguments: one file, optional `--fuel N` and `--rewrite`, in any
order. A second file is a usage error. -/
partial def Scry.egraphArgsGo (file : Option String) (fuel : Nat) (rewrite : Bool) :
    List String → EIO Nat
  | .nil => match file with
    | .some f => Scry.egraphCmd f fuel rewrite
    | .none => EIO.fail "usage: scry egraph FILE.c [--fuel N] [--rewrite]"
  | .cons a rest =>
    if String.eq a "--rewrite" then
      Scry.egraphArgsGo file fuel .true rest
    else if String.eq a "--fuel" then match rest with
      | .cons n rest' => match String.parseNat n with
        | .some k => Scry.egraphArgsGo file k rewrite rest'
        | .none => EIO.fail ("\"" ++ n ++ "\" is not a fuel bound")
      | .nil => EIO.fail "usage: scry egraph FILE.c [--fuel N] [--rewrite]"
    else match file with
      | .none => Scry.egraphArgsGo (.some a) fuel rewrite rest
      | .some _ => EIO.fail ("unexpected argument \"" ++ a ++ "\" (one FILE.c)")

/-- `scry egraph FILE.c [--fuel N] [--rewrite]`. -/
def Scry.egraphArgs (args : List String) : EIO Nat :=
  Scry.egraphArgsGo .none 8 .false args

/-- Run one command; the result is the exit status or an error message. -/
def Scry.dispatch (args : List String) : EIO Nat := match args with
  | .nil => do
    Scry.say Scry.usage;
    EIO.pure 0
  | .cons "help" rest => do
    Scry.say Scry.usage;
    EIO.pure 0
  | .cons "--help" rest => do
    Scry.say Scry.usage;
    EIO.pure 0
  | .cons "--version" rest => do
    Scry.say "scry 0.1.0-dev (S1)";
    EIO.pure 0
  | .cons "facts" rest => match rest with
    | .cons file .nil => Scry.factsCmd file
    | _ => EIO.fail "usage: scry facts FILE"
  | .cons "query" rest => match rest with
    | .cons file more => Scry.queryCmd file more
    | .nil => EIO.fail "usage: scry query FILE --kind KIND | --edge LABEL | --edge-src L | --rel NAME"
  | .cons "explain" rest => match rest with
    | .cons file (.cons node .nil) => Scry.explainCmd file node
    | _ => EIO.fail "usage: scry explain FILE NODE"
  | .cons "parse" rest => Scry.parseCmd rest
  | .cons "project" rest => match rest with
    | .cons "query" more => Scry.ProjectIO.run .true more
    | _ => Scry.ProjectIO.run .false rest
  | .cons "cst" rest => match rest with
    | .cons file (.cons out .nil) => Scry.cstCmd file out
    | _ => EIO.fail "usage: scry cst FILE OUT"
  | .cons "taint" rest => Scry.taintCmd rest
  | .cons "dynamic" rest => Scry.dynCmd rest
  | .cons "bench" rest => Scry.benchCmd rest
  | .cons "repl" rest => Scry.replCmd rest
  | .cons "findings" rest => Scry.findingsCmd rest
  | .cons "report" rest => Scry.reportCmd rest
  | .cons "fuzz-span" rest => Scry.fuzzSpanCmd rest
  | .cons "egraph" rest => Scry.egraphArgs rest
  | .cons cmd rest => EIO.fail ("unknown command \"" ++ cmd ++ "\" (see scry help)")

/-- `main`: run a command and exit with its status (1 with a `scry: …` message on an
error). -/
def Scry.mainArgs (args : List String) : IO Unit :=
  IO.bind (Scry.dispatch args) (fun r => match r with
    | .ok n => Process.exit n
    | .error m => IO.bind (IO.ePrintln ("scry: " ++ m)) (fun _ => Process.exit 1))
