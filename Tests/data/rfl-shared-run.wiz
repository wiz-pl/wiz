-- Regression fixture for #256: a private state machine's definitions (imports inlined),
-- run behind one definition.
-- Before the fix, the last equation did not check in two minutes and exceeded 5 GB.
import Prelude
import Int
import Text
import Functor

def Int.when : Bool → Int → Int
  | .true, x => x
  | .false, _ => 0
def Int.nonnegB (x : Int) : Bool := Bool.not (Int.isNeg x)
def Int.posB : Int → Bool
  | .ofNat .zero => .false
  | .ofNat (.succ _) => .true
  | .negSucc _ => .false
def Int.pos : Int → Int
  | .ofNat n => .ofNat n
  | .negSucc _ => 0

inductive Status where
  | created
  | authorizing
  | authorized
  | issuing
  | completed
  | settled
  | failed
  | reversing
  | reversed
  | expired

def sumBy {A : Type} (p : A → Bool) (f : A → Int) : List A → Int
  | .nil => 0
  | .cons x xs => Int.when (p x) (f x) + sumBy p f xs

def memB (a : Nat) : List Nat → Bool
  | .nil => .false
  | .cons x xs => Bool.or (Nat.beq x a) (memB a xs)
def uniqStep (b : Bool) (x : Nat) (u : List Nat) : List Nat := match b with
  | .true => u
  | .false => .cons x u
def uniq : List Nat → List Nat
  | .nil => .nil
  | .cons x xs => uniqStep (memB x (uniq xs)) x (uniq xs)

structure Movement where
  tx : Nat
  account : Nat
  unit : Nat
  amount : Int

def Movement.mirror (m : Movement) : Movement := Movement.mk m.tx m.account m.unit (-(m.amount))
def mirror (l : List Movement) : List Movement := List.map Movement.mirror l
def forTx (l : List Movement) (t : Nat) : List Movement := List.filter (fun m => Nat.beq m.tx t) l

-- The kernel as a state machine, cut down from a private model to what
-- ACCOUNT-001's floor is about: each `Op` is one save, and `apply` returns `.none` when
-- the save is refused. Kept: the chart (Held or Mirrored accounts), movements, draw holds,
-- transactions with a status and a movement set, and the operations create, the two
-- status-only begins, authorize (with the funds gate), complete (with the re-check and
-- the per-unit balance check), settle, fail, expire and reverse (with its availability
-- check). Left out, as in the Lean model: received and incoming holds, refunds, capture
-- for less, account opening and closing, pricing, the other gates, the outbox.

-- ## The chart of accounts (UVM §Account `Backing`)

inductive Backing where
  | held
  | mirrored

def Backing.isHeld : Backing → Bool
  | .held => .true
  | .mirrored => .false

structure AccountInfo where
  unit : Nat
  backing : Backing

-- fixed in this slice: opening and closing (ACCOUNT-003) are not modelled
def Chart : Type := Nat → AccountInfo

def isHeld (c : Chart) (a : Nat) : Bool := Backing.isHeld (AccountInfo.backing (c a))

-- ## Movement sets, holds, transactions

-- one line of the movement set a transaction will post (the resolver's output)
structure Posting where
  account : Nat
  amount : Int

inductive HoldStatus where
  | active
  | captured
  | released

def HoldStatus.isActive : HoldStatus → Bool
  | .active => .true
  | .captured => .false
  | .released => .false

-- UVM §AccountHold, `Kind = Draw` only
structure Hold where
  tx : Nat
  account : Nat
  amount : Int
  status : HoldStatus

structure Tx where
  status : Status
  plan : List Posting

-- `Movement` is the model's (tx, account, unit, amount)
structure State where
  txs : Nat → Option Tx
  next : Nat
  ledger : List Movement
  holds : List Hold

def State.init : State := State.mk (fun _ => .none) 0 .nil .nil

-- ## Balances

-- posted value of an account: the sum of its movements
def posted (s : State) (a : Nat) : Int :=
  sumBy (fun m => Nat.beq (Movement.account m) a) Movement.amount (State.ledger s)

-- a hold that reserves value on `a`
def holdCounts (a : Nat) (h : Hold) : Bool :=
  Bool.and (HoldStatus.isActive (Hold.status h)) (Nat.beq (Hold.account h) a)
def heldOn (s : State) (a : Nat) : Int := sumBy (holdCounts a) Hold.amount (State.holds s)

-- UVM §Account: "posted less held"
def available (s : State) (a : Nat) : Int := posted s a - heldOn s a

-- the active hold transaction `t` has on account `a`
def ownCounts (t a : Nat) (h : Hold) : Bool := Bool.and (Nat.beq (Hold.tx h) t) (holdCounts a h)
def ownHold (s : State) (t a : Nat) : Int := sumBy (ownCounts t a) Hold.amount (State.holds s)

-- what transaction `t`'s committed movements moved on account `a`
def txNet (s : State) (t a : Nat) : Int :=
  sumBy (fun m => Bool.and (Nat.beq (Movement.tx m) t) (Nat.beq (Movement.account m) a)) Movement.amount (State.ledger s)

-- ## Movement sets

def net (plan : List Posting) (a : Nat) : Int :=
  sumBy (fun p => Nat.beq (Posting.account p) a) Posting.amount plan

-- the net draw of a movement set on one account, `max 0 (-net)` (UVM §Holds)
def draw (plan : List Posting) (a : Nat) : Int := Int.pos (-(net plan a))

def accounts (plan : List Posting) : List Nat := uniq (List.map Posting.account plan)

def unitOf (c : Chart) (p : Posting) : Nat := AccountInfo.unit (c (Posting.account p))
def planUnitSum (c : Chart) (plan : List Posting) (u : Nat) : Int :=
  sumBy (fun p => Nat.beq (unitOf c p) u) Posting.amount plan

-- every unit the set moves sums to zero (the check `DoubleEntryInterceptor` makes)
def balancedB (c : Chart) (plan : List Posting) : Bool :=
  List.all (fun u => Int.beq (planUnitSum c plan u) 0) (List.map (unitOf c) plan)

-- the movements a movement set posts for transaction `t`
def post (c : Chart) (plan : List Posting) (t : Nat) : List Movement :=
  List.map (fun p => Movement.mk t (Posting.account p) (unitOf c p) (Posting.amount p)) plan

-- one draw hold per Held account the set draws from
def drawsOn (c : Chart) (plan : List Posting) (a : Nat) : Bool := Bool.and (isHeld c a) (Int.posB (draw plan a))
def drawHolds (c : Chart) (plan : List Posting) (t : Nat) : List Hold :=
  List.map (fun a => Hold.mk t a (draw plan a) .active) (List.filter (drawsOn c plan) (accounts plan))

-- closing transaction `t`'s active holds: capture (complete) or release (fail, expire)
def statusAfter (c : Bool) (st st0 : HoldStatus) : HoldStatus := match c with
  | .true => st
  | .false => st0
def closeHold (t : Nat) (st : HoldStatus) (h : Hold) : Hold :=
  Hold.mk (Hold.tx h) (Hold.account h) (Hold.amount h)
    (statusAfter (Bool.and (Nat.beq (Hold.tx h) t) (HoldStatus.isActive (Hold.status h))) st (Hold.status h))
def closeHolds (t : Nat) (st : HoldStatus) (hs : List Hold) : List Hold := List.map (closeHold t st) hs

-- ## Guards

-- ACCOUNT-001 at authorize, the funds gate: on every Held account the set touches,
-- `draw ≤ available`
def fundsOk (c : Chart) (s : State) (plan : List Posting) : Bool :=
  List.all (fun a => Bool.or (Bool.not (isHeld c a)) (Int.nonnegB (available s a - draw plan a))) (accounts plan)

-- UVM §Debits and credits: "Complete checks a debit again … with the transaction's own
-- draw hold added back"
def recheckOk (c : Chart) (s : State) (t : Nat) (plan : List Posting) : Bool :=
  List.all (fun a => Bool.or (Bool.not (isHeld c a)) (Int.nonnegB (available s a + ownHold s t a - draw plan a)))
    (accounts plan)

-- UVM §Holds: "A reversal takes back only value the account still has available"
def reverseOk (c : Chart) (s : State) (t : Nat) : Bool :=
  List.all (fun a => Bool.or (Bool.not (isHeld c a)) (Int.nonnegB (available s a - txNet s t a)))
    (uniq (List.map Movement.account (forTx (State.ledger s) t)))

-- ## Operations

inductive Op where
  | create (plan : List Posting)
  | beginAuthorize (t : Nat)
  | authorize (t : Nat)
  | beginIssuing (t : Nat)
  -- `resolved`: what the movement resolver returns at completion; `.none` is the set it
  -- returned at authorize
  | complete (t : Nat) (resolved : Option (List Posting))
  | settle (t : Nat)
  | fail (t : Nat)
  | expire (t : Nat)
  | reverse (t : Nat)

def Status.code : Status → Nat
  | .created => 0
  | .authorizing => 1
  | .authorized => 2
  | .issuing => 3
  | .completed => 4
  | .settled => 5
  | .failed => 6
  | .reversing => 7
  | .reversed => 8
  | .expired => 9
def Status.is (s t : Status) : Bool := Nat.beq (Status.code s) (Status.code t)

def Status.canFail : Status → Bool
  | .created => .true
  | .authorizing => .true
  | .authorized => .true
  | .issuing => .true
  | .completed => .false
  | .settled => .false
  | .failed => .false
  | .reversing => .false
  | .reversed => .false
  | .expired => .false
def Status.canExpire : Status → Bool
  | .created => .true
  | .authorized => .true
  | .authorizing => .false
  | .issuing => .false
  | .completed => .false
  | .settled => .false
  | .failed => .false
  | .reversing => .false
  | .reversed => .false
  | .expired => .false

def Status.canReverse : Status → Bool
  | .completed => .true
  | .settled => .true
  | .created => .false
  | .authorizing => .false
  | .authorized => .false
  | .issuing => .false
  | .failed => .false
  | .reversing => .false
  | .reversed => .false
  | .expired => .false

def upd (f : Nat → Option Tx) (t : Nat) (v : Tx) : Nat → Option Tx :=
  fun t' => match Nat.beq t' t with
    | .true => .some v
    | .false => f t'

def Option.getD {A : Type} (d : A) : Option A → A
  | .some x => x
  | .none => d

-- the save, if the guard passed
def guard (b : Bool) (v : State) : Option State := match b with
  | .true => .some v
  | .false => .none

-- `s` with transaction `t` (now `tx`) at status `st`, ledger and holds as given
def State.save (s : State) (t : Nat) (tx : Tx) (st : Status) (l : List Movement) (hs : List Hold) : State :=
  State.mk (upd (State.txs s) t (Tx.mk st (Tx.plan tx))) (State.next s) l hs

def moveTo (s : State) (t : Nat) (tx : Tx) (from to : Status) : Option State :=
  guard (Status.is (Tx.status tx) from) (State.save s t tx to (State.ledger s) (State.holds s))

def authorizeTx (c : Chart) (s : State) (t : Nat) (tx : Tx) : Option State :=
  guard (Bool.and (Status.is (Tx.status tx) .authorizing) (fundsOk c s (Tx.plan tx)))
    (State.save s t tx .authorized (State.ledger s) (List.append (State.holds s) (drawHolds c (Tx.plan tx) t)))

def completeTx (c : Chart) (s : State) (t : Nat) (tx : Tx) (plan : List Posting) : Option State :=
  guard (Bool.and (Status.is (Tx.status tx) .issuing) (Bool.and (balancedB c plan) (recheckOk c s t plan)))
    (State.save s t tx .completed (List.append (State.ledger s) (post c plan t)) (closeHolds t .captured (State.holds s)))

def closeTx (s : State) (t : Nat) (tx : Tx) (ok : Bool) (to : Status) : Option State :=
  guard ok (State.save s t tx to (State.ledger s) (closeHolds t .released (State.holds s)))

-- the mirror of the transaction's movements (UVM §Refund, reversal and return)
def reverseTx (c : Chart) (s : State) (t : Nat) (tx : Tx) : Option State :=
  guard (Bool.and (Status.canReverse (Tx.status tx)) (reverseOk c s t))
    (State.save s t tx .reversed (List.append (State.ledger s) (mirror (forTx (State.ledger s) t))) (State.holds s))

def apply (c : Chart) (s : State) : Op → Option State
  | .create plan =>
    .some (State.mk (upd (State.txs s) (State.next s) (Tx.mk .created plan)) (Nat.succ (State.next s))
      (State.ledger s) (State.holds s))
  | .beginAuthorize t => Option.bind (State.txs s t) (fun tx => moveTo s t tx .created .authorizing)
  | .authorize t => Option.bind (State.txs s t) (fun tx => authorizeTx c s t tx)
  | .beginIssuing t => Option.bind (State.txs s t) (fun tx => moveTo s t tx .authorized .issuing)
  | .complete t resolved =>
    Option.bind (State.txs s t) (fun tx => completeTx c s t tx (Option.getD (Tx.plan tx) resolved))
  | .settle t => Option.bind (State.txs s t) (fun tx => moveTo s t tx .completed .settled)
  | .fail t => Option.bind (State.txs s t) (fun tx => closeTx s t tx (Status.canFail (Tx.status tx)) .failed)
  | .expire t => Option.bind (State.txs s t) (fun tx => closeTx s t tx (Status.canExpire (Tx.status tx)) .expired)
  | .reverse t => Option.bind (State.txs s t) (fun tx => reverseTx c s t tx)

-- The states reachable from the empty estate, by any interleaving of saves. (A relation
-- in `Type`: FINDINGS G2.)
inductive Reachable (c : Chart) : State → Type where
  | init : Reachable c State.init
  | step (s s' : State) (op : Op) (r : Reachable c s) (h : apply c s op = .some s') : Reachable c s'

def chart2 : Chart := fun a => match Nat.beq a 1 with
  | .true => AccountInfo.mk 710 .held
  | .false => AccountInfo.mk 710 .mirrored

def run2 : State → List Op → Option State
  | s, .nil => .some s
  | s, .cons op ops => Option.bind (apply chart2 s op) (fun s' => run2 s' ops)

def fund2 : List Posting := .cons (Posting.mk 2 (-500)) (.cons (Posting.mk 1 500) .nil)
def life2 (t : Nat) : List Op := .cons (.create fund2) (.cons (.beginAuthorize t)
  (.cons (.authorize t) (.cons (.beginIssuing t) (.cons (.complete t .none) .nil))))
def ops3 : List Op := List.append (life2 0) (List.append (life2 1) (life2 2))
def avail2 (ops : List Op) : Option Int := Option.map (fun s => available s 1) (run2 State.init ops)
def eqm : avail2 ops3 = .some 1500 := rfl
