-- Regression fixture for #256: a synthetic capacity scheduler, invented for this test,
-- run behind one definition. Before the fix, the last equation did not check in two
-- minutes and exceeded 5 GB.
import Prelude
import Int
import Text
import Functor

def Int.when : Bool → Int → Int
  | .true, x => x
  | .false, _ => 0
def Int.nonnegB (x : Int) : Bool := Bool.not (Int.isNeg x)
def Int.posB : Int → Bool
  | .ofNat .zero => .false
  | .ofNat (.succ _) => .true
  | .negSucc _ => .false
def Int.pos : Int → Int
  | .ofNat n => .ofNat n
  | .negSucc _ => 0

inductive Stage where
  | idle
  | queued
  | admitted
  | running
  | finished
  | archived
  | rejected
  | reverting
  | reverted
  | dropped

def sumBy {A : Type} (p : A → Bool) (f : A → Int) : List A → Int
  | .nil => 0
  | .cons x xs => Int.when (p x) (f x) + sumBy p f xs

def memB (a : Nat) : List Nat → Bool
  | .nil => .false
  | .cons x xs => Bool.or (Nat.beq x a) (memB a xs)
def uniqStep (b : Bool) (x : Nat) (u : List Nat) : List Nat := match b with
  | .true => u
  | .false => .cons x u
def uniq : List Nat → List Nat
  | .nil => .nil
  | .cons x xs => uniqStep (memB x (uniq xs)) x (uniq xs)

structure Delta where
  ticket : Nat
  pool : Nat
  unit : Nat
  amount : Int

def Delta.mirror (d : Delta) : Delta := Delta.mk d.ticket d.pool d.unit (-(d.amount))
def mirror (l : List Delta) : List Delta := List.map Delta.mirror l
def forTicket (l : List Delta) (t : Nat) : List Delta := List.filter (fun d => Nat.beq d.ticket t) l

-- A ticket moves through a small stage lattice; a pool's headroom is its realised load
-- less the loads leased by tickets that are still in flight. Each `Action` is one save,
-- and `apply` returns `.none` when the save is refused. Kept: the pool map (managed or
-- passthrough pools), load deltas, open leases, tickets with a stage and a plan, the
-- operations submit, the two stage-only begins, admit (with the capacity gate), finish
-- (with the re-check and the per-unit consistency check), archive, fail, expire and
-- rollback (with its headroom check). Left out of this slice: incoming leases, partial
-- releases, opening and closing pools, pricing, and the other gates.

inductive Mode where
  | managed
  | passthrough

def Mode.isManaged : Mode → Bool
  | .managed => .true
  | .passthrough => .false

structure PoolInfo where
  unit : Nat
  mode : Mode

-- the pool map: a pool number to its unit and mode
def Pools : Type := Nat → PoolInfo

def isManaged (c : Pools) (a : Nat) : Bool := Mode.isManaged (PoolInfo.mode (c a))

-- ## Plans, leases, tickets

-- one line of the load a ticket will apply
structure Entry where
  pool : Nat
  amount : Int

inductive LeaseState where
  | open
  | used
  | dropped

def LeaseState.isOpen : LeaseState → Bool
  | .open => .true
  | .used => .false
  | .dropped => .false

structure Lease where
  ticket : Nat
  pool : Nat
  amount : Int
  state : LeaseState

structure Ticket where
  stage : Stage
  plan : List Entry

-- a realised load: ticket, pool, unit, signed amount
structure Cluster where
  tickets : Nat → Option Ticket
  next : Nat
  history : List Delta
  leases : List Lease

def Cluster.empty : Cluster := Cluster.mk (fun _ => .none) 0 .nil .nil

-- ## Headroom

-- realised load on a pool: the sum of its deltas
def loadOf (s : Cluster) (a : Nat) : Int :=
  sumBy (fun d => Nat.beq (Delta.pool d) a) Delta.amount (Cluster.history s)

-- an open lease that holds load on `a`
def leaseCounts (a : Nat) (l : Lease) : Bool :=
  Bool.and (LeaseState.isOpen (Lease.state l)) (Nat.beq (Lease.pool l) a)
def leasedOn (s : Cluster) (a : Nat) : Int := sumBy (leaseCounts a) Lease.amount (Cluster.leases s)

-- a pool's headroom is "realised less leased"
def headroom (s : Cluster) (a : Nat) : Int := loadOf s a - leasedOn s a

-- the open lease ticket `t` has on pool `a`
def ownCounts (t a : Nat) (l : Lease) : Bool := Bool.and (Nat.beq (Lease.ticket l) t) (leaseCounts a l)
def ownLease (s : Cluster) (t a : Nat) : Int := sumBy (ownCounts t a) Lease.amount (Cluster.leases s)

-- what ticket `t`'s realised deltas moved on pool `a`
def ticketNet (s : Cluster) (t a : Nat) : Int :=
  sumBy (fun d => Bool.and (Nat.beq (Delta.ticket d) t) (Nat.beq (Delta.pool d) a)) Delta.amount (Cluster.history s)

-- ## Plans

def entryNet (plan : List Entry) (a : Nat) : Int :=
  sumBy (fun e => Nat.beq (Entry.pool e) a) Entry.amount plan

-- the net pull of a plan on one pool, `max 0 (-net)`
def pull (plan : List Entry) (a : Nat) : Int := Int.pos (-(entryNet plan a))

def poolsOf (plan : List Entry) : List Nat := uniq (List.map Entry.pool plan)

def unitOf (c : Pools) (e : Entry) : Nat := PoolInfo.unit (c (Entry.pool e))
def planUnitSum (c : Pools) (plan : List Entry) (u : Nat) : Int :=
  sumBy (fun e => Nat.beq (unitOf c e) u) Entry.amount plan

-- every unit the plan moves sums to zero
def consistentB (c : Pools) (plan : List Entry) : Bool :=
  List.all (fun u => Int.beq (planUnitSum c plan u) 0) (List.map (unitOf c) plan)

-- the deltas a plan realises for ticket `t`
def deltasOf (c : Pools) (plan : List Entry) (t : Nat) : List Delta :=
  List.map (fun e => Delta.mk t (Entry.pool e) (unitOf c e) (Entry.amount e)) plan

-- one open lease per managed pool the plan pulls from
def pullsOn (c : Pools) (plan : List Entry) (a : Nat) : Bool := Bool.and (isManaged c a) (Int.posB (pull plan a))
def leasesFor (c : Pools) (plan : List Entry) (t : Nat) : List Lease :=
  List.map (fun a => Lease.mk t a (pull plan a) .open) (List.filter (pullsOn c plan) (poolsOf plan))

-- closing ticket `t`'s open leases: use (finish) or drop (fail, expire)
def stateAfter (b : Bool) (st st0 : LeaseState) : LeaseState := match b with
  | .true => st
  | .false => st0
def closeLease (t : Nat) (st : LeaseState) (l : Lease) : Lease :=
  Lease.mk (Lease.ticket l) (Lease.pool l) (Lease.amount l)
    (stateAfter (Bool.and (Nat.beq (Lease.ticket l) t) (LeaseState.isOpen (Lease.state l))) st (Lease.state l))
def closeLeases (t : Nat) (st : LeaseState) (ls : List Lease) : List Lease := List.map (closeLease t st) ls

-- ## Gates

-- the capacity gate at admit: on every managed pool the plan touches,
-- `pull ≤ headroom`
def capacityOk (c : Pools) (s : Cluster) (plan : List Entry) : Bool :=
  List.all (fun a => Bool.or (Bool.not (isManaged c a)) (Int.nonnegB (headroom s a - pull plan a))) (poolsOf plan)

-- finish checks a pull again, with the ticket's own lease added back
def recheckOk (c : Pools) (s : Cluster) (t : Nat) (plan : List Entry) : Bool :=
  List.all (fun a => Bool.or (Bool.not (isManaged c a)) (Int.nonnegB (headroom s a + ownLease s t a - pull plan a)))
    (poolsOf plan)

-- a rollback takes back only load the pool still has headroom for
def rollbackOk (c : Pools) (s : Cluster) (t : Nat) : Bool :=
  List.all (fun a => Bool.or (Bool.not (isManaged c a)) (Int.nonnegB (headroom s a - ticketNet s t a)))
    (uniq (List.map Delta.pool (forTicket (Cluster.history s) t)))

-- ## Operations

inductive Action where
  | submit (plan : List Entry)
  | beginReview (t : Nat)
  | admit (t : Nat)
  | beginRun (t : Nat)
  -- `resolved`: what the planner returns at finish; `.none` is the plan admitted
  | finish (t : Nat) (resolved : Option (List Entry))
  | archive (t : Nat)
  | fail (t : Nat)
  | expire (t : Nat)
  | rollback (t : Nat)

def Stage.code : Stage → Nat
  | .idle => 0
  | .queued => 1
  | .admitted => 2
  | .running => 3
  | .finished => 4
  | .archived => 5
  | .rejected => 6
  | .reverting => 7
  | .reverted => 8
  | .dropped => 9
def Stage.is (s t : Stage) : Bool := Nat.beq (Stage.code s) (Stage.code t)

def Stage.canFail : Stage → Bool
  | .idle => .true
  | .queued => .true
  | .admitted => .true
  | .running => .true
  | .finished => .false
  | .archived => .false
  | .rejected => .false
  | .reverting => .false
  | .reverted => .false
  | .dropped => .false
def Stage.canExpire : Stage → Bool
  | .idle => .true
  | .admitted => .true
  | .queued => .false
  | .running => .false
  | .finished => .false
  | .archived => .false
  | .rejected => .false
  | .reverting => .false
  | .reverted => .false
  | .dropped => .false

def Stage.canRollback : Stage → Bool
  | .finished => .true
  | .archived => .true
  | .idle => .false
  | .queued => .false
  | .admitted => .false
  | .running => .false
  | .rejected => .false
  | .reverting => .false
  | .reverted => .false
  | .dropped => .false

def upd (f : Nat → Option Ticket) (t : Nat) (v : Ticket) : Nat → Option Ticket :=
  fun t' => match Nat.beq t' t with
    | .true => .some v
    | .false => f t'

def Option.getD {A : Type} (d : A) : Option A → A
  | .some x => x
  | .none => d

-- the save, if the guard passed
def guard (b : Bool) (v : Cluster) : Option Cluster := match b with
  | .true => .some v
  | .false => .none

-- `s` with ticket `t` (now `tk`) at stage `st`, history and leases as given
def Cluster.save (s : Cluster) (t : Nat) (tk : Ticket) (st : Stage) (h : List Delta) (ls : List Lease) : Cluster :=
  Cluster.mk (upd (Cluster.tickets s) t (Ticket.mk st (Ticket.plan tk))) (Cluster.next s) h ls

def moveTo (s : Cluster) (t : Nat) (tk : Ticket) (from to : Stage) : Option Cluster :=
  guard (Stage.is (Ticket.stage tk) from) (Cluster.save s t tk to (Cluster.history s) (Cluster.leases s))

def admitTicket (c : Pools) (s : Cluster) (t : Nat) (tk : Ticket) : Option Cluster :=
  guard (Bool.and (Stage.is (Ticket.stage tk) .queued) (capacityOk c s (Ticket.plan tk)))
    (Cluster.save s t tk .admitted (Cluster.history s) (List.append (Cluster.leases s) (leasesFor c (Ticket.plan tk) t)))

def finishTicket (c : Pools) (s : Cluster) (t : Nat) (tk : Ticket) (plan : List Entry) : Option Cluster :=
  guard (Bool.and (Stage.is (Ticket.stage tk) .running) (Bool.and (consistentB c plan) (recheckOk c s t plan)))
    (Cluster.save s t tk .finished (List.append (Cluster.history s) (deltasOf c plan t)) (closeLeases t .used (Cluster.leases s)))

def closeTicket (s : Cluster) (t : Nat) (tk : Ticket) (ok : Bool) (to : Stage) : Option Cluster :=
  guard ok (Cluster.save s t tk to (Cluster.history s) (closeLeases t .dropped (Cluster.leases s)))

-- the mirror of the ticket's deltas
def rollbackTicket (c : Pools) (s : Cluster) (t : Nat) (tk : Ticket) : Option Cluster :=
  guard (Bool.and (Stage.canRollback (Ticket.stage tk)) (rollbackOk c s t))
    (Cluster.save s t tk .reverted (List.append (Cluster.history s) (mirror (forTicket (Cluster.history s) t))) (Cluster.leases s))

def apply (c : Pools) (s : Cluster) : Action → Option Cluster
  | .submit plan =>
    .some (Cluster.mk (upd (Cluster.tickets s) (Cluster.next s) (Ticket.mk .idle plan)) (Nat.succ (Cluster.next s))
      (Cluster.history s) (Cluster.leases s))
  | .beginReview t => Option.bind (Cluster.tickets s t) (fun tk => moveTo s t tk .idle .queued)
  | .admit t => Option.bind (Cluster.tickets s t) (fun tk => admitTicket c s t tk)
  | .beginRun t => Option.bind (Cluster.tickets s t) (fun tk => moveTo s t tk .admitted .running)
  | .finish t resolved =>
    Option.bind (Cluster.tickets s t) (fun tk => finishTicket c s t tk (Option.getD (Ticket.plan tk) resolved))
  | .archive t => Option.bind (Cluster.tickets s t) (fun tk => moveTo s t tk .finished .archived)
  | .fail t => Option.bind (Cluster.tickets s t) (fun tk => closeTicket s t tk (Stage.canFail (Ticket.stage tk)) .rejected)
  | .expire t => Option.bind (Cluster.tickets s t) (fun tk => closeTicket s t tk (Stage.canExpire (Ticket.stage tk)) .dropped)
  | .rollback t => Option.bind (Cluster.tickets s t) (fun tk => rollbackTicket c s t tk)

-- The clusters reachable from the empty cluster, by any interleaving of saves.
inductive Reachable (c : Pools) : Cluster → Type where
  | empty : Reachable c Cluster.empty
  | step (s s' : Cluster) (op : Action) (r : Reachable c s) (h : apply c s op = .some s') : Reachable c s'

def cluster2 : Pools := fun a => match Nat.beq a 1 with
  | .true => PoolInfo.mk 710 .managed
  | .false => PoolInfo.mk 710 .passthrough

def run2 : Cluster → List Action → Option Cluster
  | s, .nil => .some s
  | s, .cons op ops => Option.bind (apply cluster2 s op) (fun s' => run2 s' ops)

def load2 : List Entry := .cons (Entry.mk 2 (-500)) (.cons (Entry.mk 1 500) .nil)
def cycle2 (t : Nat) : List Action := .cons (.submit load2) (.cons (.beginReview t)
  (.cons (.admit t) (.cons (.beginRun t) (.cons (.finish t .none) .nil))))
def plan3 : List Action := List.append (cycle2 0) (List.append (cycle2 1) (cycle2 2))
def headroom2 (ops : List Action) : Option Int := Option.map (fun s => headroom s 1) (run2 Cluster.empty ops)
def eqm : headroom2 plan3 = .some 1500 := rfl
