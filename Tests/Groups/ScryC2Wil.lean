import Wiz
import Tests.Harness

/-!
# Tests for `Scry.Lower` (C to Wil, S2's bridge)

The fixtures are in `scry/corpus/c2wil/`: a `.c` file and its checked-in `scry-cst`
spill, generated by `scry-cst` (the tree-sitter shim), so the tests need no tree-sitter
build. For every differential case the test

1. compiles the `.c` with the suite's `cc` and runs it (its exit status is the value of
   `main`), and
2. lowers the checked-in CST with `Scry.lowerTU`, runs `Wil.runFunction` on the result,
   and compares.

`havoc.c` used to be the boundary case (a struct field access was havoc + warning). Since
`agent/scry-points-to` a struct local is a stack slot and a field access is a `gep` +
`load`/`store`, so it is now a **differential** case like the others; the boundary fixture
moved to `scry/tests/fixtures/taint-boundary.c` (the taint group's end-to-end test). The
other cases cover the CFG, origins (including a `cc -E` unit whose macros, include and
`#if` map back to `main.c`/`inc.h`, and a synthetic system-header marker), `switch`
lowering, the direct-call graph and the facts EDB. The design is
`wiz-notes/scry-c2wil.md` (§13 for the memory lowering).
-/

open Wiz

namespace Tests.ScryC2Wil

/-- Every `lib/*.wiz`, `lib/D/*.wiz` (as `D.X`) and `scry/src/Scry/*.wiz` (as `Scry.X`),
by module name. The lowering lives in the scry package, so the test loader serves both
roots. -/
def loader : IO (Name → Option String) := do
  let mut m : List (Name × String) := []
  for e in ← System.FilePath.readDir "lib" do
    if e.path.extension == some "wiz" then
      m := (e.path.fileStem.getD "", ← IO.FS.readFile e.path) :: m
    else if ← e.path.isDir then
      for f in ← System.FilePath.readDir e.path do
        if f.path.extension == some "wiz" then
          m := (e.fileName ++ "." ++ f.path.fileStem.getD "", ← IO.FS.readFile f.path) :: m
  for e in ← System.FilePath.readDir "scry/src/Scry" do
    if e.path.extension == some "wiz" then
      m := ("Scry." ++ e.path.fileStem.getD "", ← IO.FS.readFile e.path) :: m
  pure fun n => m.lookup n

/-- A C string literal for `s` (the escapes the Wiz lexer reads). -/
def wizStr (s : String) : String :=
  "\"" ++ s.foldl (fun acc c => acc ++ match c with
    | '"' => "\\\""
    | '\\' => "\\\\"
    | '\n' => "\\n"
    | '\t' => "\\t"
    | c => c.toString) "" ++ "\""

/-- A fixture's C source and checked-in CST spill. -/
def fixture (name : String) : IO (String × String) := do
  let c ← IO.FS.readFile s!"scry/corpus/c2wil/{name}.c"
  let cst ← IO.FS.readFile s!"scry/corpus/c2wil/{name}.cst"
  pure (c, cst)

/-- The preprocessed fixture: `main.i` (the `cc -E` output), the two original files and
the spill of the *blanked* preprocessed text. -/
def preprocFixture : IO (String × String × String × String) := do
  let i ← IO.FS.readFile "scry/corpus/c2wil/preproc/main.i"
  let main ← IO.FS.readFile "scry/corpus/c2wil/preproc/main.c"
  let inc ← IO.FS.readFile "scry/corpus/c2wil/preproc/inc.h"
  let cst ← IO.FS.readFile "scry/corpus/c2wil/preproc/main.i.cst"
  pure (i, main, inc, cst)

/-- The definitions every prelude shares: the lowered unit, its functions by name, span
lists, and `main`'s value with a fuel bound. -/
def tuCommon : String :=
  s!"def tu : Option Scry.TU := match cst with\n" ++
  "  | .some c => .some (Scry.lowerTU \"UNIT.c\" c)\n" ++
  "  | .none => .none\n" ++
  "def first : Option Wil.Func := match tu with\n" ++
  "  | .some t => match t.funcs with\n" ++
  "    | .cons f _ => .some f\n" ++
  "    | .nil => .none\n" ++
  "  | .none => .none\n" ++
  "def fnNamed (t : Scry.TU) (name : String) : Option Wil.Func :=\n" ++
  "  List.find (fun f => String.eq f.name name) t.funcs\n" ++
  "def spansOf (f : Wil.Func) : List Wil.Span :=\n" ++
  "  List.concat (List.map (fun b => List.append (List.map Wil.stmtOrigin b.stmts)\n" ++
  "    (.cons (Wil.termOrigin b.term) .nil)) f.blocks)\n" ++
  "def warnCount : Nat := match tu with\n" ++
  "  | .some t => List.length t.warnings\n" ++
  "  | .none => 999\n" ++
  "def havocCount : Nat := match tu with\n" ++
  "  | .some t => List.length (List.concat (List.map (fun f =>\n" ++
  "      List.concat (List.map (fun b => List.filter (fun s => match s with\n" ++
  "        | .assign _ (.havoc _) _ => .true\n" ++
  "        | _ => .false) b.stmts) f.blocks)) t.funcs))\n" ++
  "  | .none => 0\n" ++
  "def mainResult : Nat := match tu with\n" ++
  "  | .some t => match Wil.runFunction (Wil.program t.funcs) 10000 \"main\" [] with\n" ++
  "    | .ok v => Wil.Val.bitsAt 32 v\n" ++
  "    | .fault _ => 900\n" ++
  "    | .outOfFuel => 901\n" ++
  "  | .none => 999\n"

/-- The Wiz prelude every case shares: the source, the spill, the CST, the translated
unit, its first function and a whole program. -/
def prelude (name src cst : String) : String :=
  "import Scry.Lower\nimport Scry.CstStore\nimport Text\n" ++
  s!"def source : String := {wizStr src}\n" ++
  s!"def spill : String := {wizStr cst}\n" ++
  "def cst : Option Scry.Cst := match Scry.CstStore.ofText spill with\n" ++
  "  | .ok s => .some (Scry.Cst.ofStore source s)\n" ++
  "  | .error _ => .none\n" ++
  tuCommon.replace "UNIT.c" (name ++ ".c")

/-- The Wiz prelude of the preprocessed fixture: `main.i` through `Scry.preprocess` with
the two original files, so the CST's spans are mapped to `main.c`/`inc.h`, then the
usual definitions. -/
def preprocPrelude (i main inc cst : String) : String :=
  "import Scry.Lower\nimport Scry.CstStore\nimport Scry.Preproc\nimport Text\n" ++
  s!"def ppText : String := {wizStr i}\n" ++
  s!"def mainText : String := {wizStr main}\n" ++
  s!"def incText : String := {wizStr inc}\n" ++
  s!"def spill : String := {wizStr cst}\n" ++
  "def pre : Scry.Preprocessed := Scry.preprocess \"corpus/c2wil/preproc/main.c\" ppText\n" ++
  "  (.cons (\"corpus/c2wil/preproc/main.c\", mainText)\n" ++
  "    (.cons (\"corpus/c2wil/preproc/inc.h\", incText) .nil))\n" ++
  "def cst : Option Scry.Cst := match Scry.CstStore.ofText spill with\n" ++
  "  | .ok s => .some (Scry.Cst.ofPreprocessed pre s)\n" ++
  "  | .error _ => .none\n" ++
  tuCommon.replace "UNIT.c" "main.c"

/-- Run a full Wiz source and return its `#eval` texts (unexpected frontend errors are
reported with the source). -/
def wizEvalRaw (full : String) : IO (List String) := do
  let loader ← loader
  let s := runFrontend (R := ZeroOneMany) full { trustedModule := Tests.libModule, loader }
  let errs := (s.messages.filter (·.severity == .error)).map fun m => m.render full
  unless errs.isEmpty do
    throw (IO.userError s!"unexpected errors:\n{"\n".intercalate errs.toList}")
  pure (s.messages.toList.map (·.text))

/-- Run `body` (which may use the prelude) and return its `#eval` texts. -/
def wizEval (name src cst body : String) : IO (List String) :=
  wizEvalRaw (prelude name src cst ++ body)

/-- Run `body` with the preprocessed fixture's prelude. -/
def wizEvalPreproc (i main inc cst body : String) : IO (List String) :=
  wizEvalRaw (preprocPrelude i main inc cst ++ body)

/-- `main`'s exit status when `name.c` is compiled and run by the suite's `cc`. -/
def ccResult (name : String) : IO Nat := do
  let tc ← toolchain
  let dir ← IO.FS.createTempDir
  let exe := (dir / name).toString
  let out ← IO.Process.output
    { cmd := tc.cc, args := #["-w", "-std=c11", "-o", exe, s!"scry/corpus/c2wil/{name}.c"] }
  unless out.exitCode == 0 do throw (IO.userError s!"cc failed: {out.stderr}")
  let r ← IO.Process.output { cmd := exe }
  pure r.exitCode.toNat

/-- A differential case: `name.c` compiled and run, against the lowered `main`. The
lowering must also be warning-free (everything in the fixture is modelled). -/
def differential (name : String) : IO Unit := do
  let (src, cst) ← fixture name
  let expected ← ccResult name
  let outs ← wizEval name src cst "#eval mainResult\n#eval warnCount\n"
  checkEq [toString expected, "0"] outs

/-- The group. -/
def group : Group where
  name := "scry-c2wil"
  exercise := "Scry S2 (C to Wil, origins, CFG, facts)"
  cases := [
    { name := "differential: straight-line C (2 + 3 * 4) lowers and runs as compiled",
      run := fun _ => differential "straight" },
    { name := "differential: if/while C (sum of the even numbers up to 10) matches",
      run := fun _ => differential "branch" },
    { name := "differential: direct calls (twice, add3) match compiled C",
      run := fun _ => differential "call" },
    { name := "differential: signed division/remainder, unsigned wrap and shifts match",
      run := fun _ => differential "arith" },
    { name := "differential: a for loop is desugared to a header/update/back edge",
      run := fun _ => differential "forloop" },
    { name := "differential: switch lowers to a compare chain (cases, default, fallthrough)",
      run := fun _ => differential "switch" },
    { name := "switch CFG: valid, 11 blocks, 14 edges, all reachable",
      run := fun _ => do
        let (src, cst) ← fixture "switch"
        let body :=
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"static:classify\" with\n" ++
          "    | .some f => match Scry.cfgValid f with | .true => 1 | .false => 0\n" ++
          "    | .none => 999\n" ++
          "  | .none => 998\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"static:classify\" with\n" ++
          "    | .some f => List.length f.blocks\n" ++
          "    | .none => 999\n" ++
          "  | .none => 998\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"static:classify\" with\n" ++
          "    | .some f => List.length (Scry.cfgOf f)\n" ++
          "    | .none => 999\n" ++
          "  | .none => 998\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"static:classify\" with\n" ++
          "    | .some f => List.length (Scry.reachable f)\n" ++
          "    | .none => 999\n" ++
          "  | .none => 998\n"
        let outs ← wizEval "switch" src cst body
        checkEq ["1", "11", "14", "11"] outs },
    { name := "preprocessing: include, macro and #if origins point at the original files",
      run := fun _ => do
        let (i, main, inc, cst) ← preprocFixture
        let body :=
          "#eval mainResult\n" ++
          "#eval warnCount\n" ++
          "#eval pre.markers\n" ++
          "#eval pre.systemMarkers\n" ++
          "#eval match tu with | .some t => List.length t.files | .none => 999\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"main\", fnNamed t \"static:bump\" with\n" ++
          "    | .some m, .some b =>\n" ++
          "      match List.all (fun sp => Bool.or (Nat.beq sp.file 0) (Nat.beq sp.file 3))\n" ++
          "        (List.append (spansOf m) (spansOf b)) with\n" ++
          "      | .true => 1 | .false => 0\n" ++
          "    | _, _ => 998\n" ++
          "  | .none => 999\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"main\" with\n" ++
          "    | .some f => match List.find (fun sp =>\n" ++
          "        String.eq (Scry.spanText t.files sp) \"int a = TWICE(3);\") (spansOf f) with\n" ++
          "      | .some sp => Nat.add (Nat.mul sp.file 100) sp.line\n" ++
          "      | .none => 999\n" ++
          "    | .none => 998\n" ++
          "  | .none => 997\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"main\" with\n" ++
          "    | .some f => match List.find (fun sp =>\n" ++
          "        String.eq (Scry.spanText t.files sp) \"int b = a + OFFSET;\") (spansOf f) with\n" ++
          "      | .some sp => Nat.add (Nat.mul sp.file 100) sp.line\n" ++
          "      | .none => 999\n" ++
          "    | .none => 998\n" ++
          "  | .none => 997\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"main\" with\n" ++
          "    | .some f => match List.find (fun sp =>\n" ++
          "        String.eq (Scry.spanText t.files sp) \"return bump(b);\") (spansOf f) with\n" ++
          "      | .some sp => Nat.add (Nat.mul sp.file 100) sp.line\n" ++
          "      | .none => 999\n" ++
          "    | .none => 998\n" ++
          "  | .none => 997\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"static:bump\" with\n" ++
          "    | .some f => match String.startsWith (Scry.spanText t.files f.origin)\n" ++
          "        \"static int bump(int x) {\" with\n" ++
          "      | .true => Nat.add (Nat.mul f.origin.file 100) f.origin.line\n" ++
          "      | .false => 999\n" ++
          "    | .none => 998\n" ++
          "  | .none => 997\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match fnNamed t \"main\" with\n" ++
          "    | .some f => match List.any (fun sp =>\n" ++
          "        String.contains (Scry.spanText t.files sp) \"((3)\") (spansOf f) with\n" ++
          "      | .true => 0 | .false => 1\n" ++
          "    | .none => 998\n" ++
          "  | .none => 997\n"
        let outs ← wizEvalPreproc i main inc cst body
        checkEq ["12", "0", "6", "0", "4", "1", "6", "8", "12", "304", "1"] outs },
    { name := "preprocessing: #line and a system-header marker map line and column",
      run := fun _ => do
        let (i, main, inc, cst) ← preprocFixture
        let body :=
          "#eval\n" ++
          "  let lmText : String := \"# 1 \\\"a.c\\\"\\nint x;\\n# 1 \\\"/usr/include/stdio.h\\\" 3\\nint puts(const char *);\\n# 2 \\\"a.c\\\" 2\\nint y;\\n\";\n" ++
          "  let aText : String := \"int x;\\nint y;\\n\";\n" ++
          "  let hdr : String := \"int puts(const char *);\\n\";\n" ++
          "  let lm := Scry.preprocess \"a.c\" lmText\n" ++
          "    (.cons (\"a.c\", aText) (.cons (\"/usr/include/stdio.h\", hdr) .nil));\n" ++
          "  let off := List.getD lm.lineStart 3 0;\n" ++
          "  let sp := Scry.mapSpan lm 0 off (Nat.add off 8);\n" ++
          "  let checks : List Bool := [\n" ++
          "    Nat.beq (List.length lm.paths) 2,\n" ++
          "    Nat.beq (List.getD lm.lineFile 3 9) 1,\n" ++
          "    Nat.beq (List.getD lm.lineOrig 3 9) 1,\n" ++
          "    Nat.beq (List.getD lm.lineFile 5 9) 0,\n" ++
          "    Nat.beq (List.getD lm.lineOrig 5 9) 2,\n" ++
          "    Nat.beq lm.systemMarkers 1,\n" ++
          "    Bool.and (Nat.beq sp.file 1) (Bool.and (Nat.beq sp.line 1) (Nat.beq sp.col 1)),\n" ++
          "    Nat.beq (String.length (String.trim (Scry.lineText lm.text lm.lineStart 0))) 0];\n" ++
          "  List.length (List.filter (fun b => b) checks)\n"
        let outs ← wizEvalPreproc i main inc cst body
        checkEq ["8"] outs },
    { name := "differential: a struct field access is a slot store/load, not havoc",
      run := fun _ => differential "havoc" },
    { name := "CFG: valid targets, edges, back edge and reachability of the loop function",
      run := fun _ => do
        let (src, cst) ← fixture "branch"
        let outs ← wizEval "branch" src cst
          ("#eval match first with\n" ++
           "  | .some f => match Scry.cfgValid f with | .true => 1 | .false => 0\n" ++
           "  | .none => 999\n" ++
           "#eval match first with | .some f => List.length (Scry.cfgOf f) | .none => 999\n" ++
           "#eval match first with\n" ++
           "  | .some f => List.length (List.filter (fun e => Nat.lt e.2 e.1) (Scry.cfgOf f))\n" ++
           "  | .none => 999\n" ++
           "#eval match first with | .some f => List.length (Scry.reachable f) | .none => 999\n")
        checkEq ["1", "8", "1", "7"] outs },
    { name := "origins: every statement has a source span and a CST node; return is exact",
      run := fun _ => do
        let (src, cst) ← fixture "straight"
        let body :=
          "#eval match tu with\n" ++
          "  | .some t => match first with\n" ++
          "    | .some f => match List.all (fun b =>\n" ++
          "        Bool.and (List.all (fun s =>\n" ++
          "          Bool.and (Nat.lt 0 (Wil.stmtOrigin s).stop) (Nat.lt 0 (Wil.stmtOrigin s).node))\n" ++
          "          b.stmts)\n" ++
          "          (Bool.and (Nat.lt 0 (Wil.termOrigin b.term).stop)\n" ++
          "            (Nat.lt 0 (Wil.termOrigin b.term).node)))\n" ++
          "        f.blocks with\n" ++
          "      | .true => 1 | .false => 0\n" ++
          "    | .none => 999\n" ++
          "  | .none => 999\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match first with\n" ++
          "    | .some f => match String.startsWith (Scry.spanText t.files f.origin) \"int main\" with\n" ++
          "      | .true => 1 | .false => 0\n" ++
          "    | .none => 999\n" ++
          "  | .none => 999\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match first with\n" ++
          "    | .some f => match List.any (fun b =>\n" ++
          "        Bool.or (List.any (fun s =>\n" ++
          "          String.startsWith (Scry.spanText t.files (Wil.stmtOrigin s)) \"return\") b.stmts)\n" ++
          "          (String.startsWith (Scry.spanText t.files (Wil.termOrigin b.term)) \"return\"))\n" ++
          "        f.blocks with\n" ++
          "      | .true => 1 | .false => 0\n" ++
          "    | .none => 999\n" ++
          "  | .none => 999\n"
        let outs ← wizEval "straight" src cst body
        checkEq ["1", "1", "1"] outs },
    { name := "facts EDB: assign/def/use/span counts and ordered spans of the loop",
      run := fun _ => do
        let (src, cst) ← fixture "branch"
        let body :=
          "#eval match tu with\n" ++
          "  | .some t => let e := Scry.edbOf t.funcs;\n" ++
          "      match Bool.and (Nat.lt 0 (List.length e.assigns))\n" ++
          "        (Bool.and (Nat.beq (List.length e.defs) (List.length e.assigns))\n" ++
          "          (Bool.and (Nat.lt 0 (List.length e.uses))\n" ++
          "            (Bool.and (Nat.beq (List.length e.spans) e.siteCount)\n" ++
          "              (Nat.lt 0 (List.length e.cfgs))))) with\n" ++
          "      | .true => 1 | .false => 0\n" ++
          "  | .none => 999\n" ++
          "#eval match tu with\n" ++
          "  | .some t => let e := Scry.edbOf t.funcs;\n" ++
          "      match List.all (fun r => Nat.le (List.getD r 2 0) (List.getD r 3 0)) e.spans with\n" ++
          "      | .true => 1 | .false => 0\n" ++
          "  | .none => 999\n"
        let outs ← wizEval "branch" src cst body
        checkEq ["1", "1"] outs },
    { name := "call graph: two resolved edges, a static callee is TU-qualified",
      run := fun _ => do
        let (src, cst) ← fixture "call"
        let body :=
          "#eval match tu with | .some t => List.length (Scry.callGraphOf t.funcs) | .none => 999\n" ++
          "#eval match tu with | .some t => List.length t.externalCalls | .none => 999\n" ++
          "#eval match tu with\n" ++
          "  | .some t => match Scry.funcIndex t.funcs \"static:twice\",\n" ++
          "      Scry.funcIndex t.funcs \"twice\" with\n" ++
          "    | .some i, .none => i\n" ++
          "    | _, _ => 999\n" ++
          "  | .none => 888\n"
        let outs ← wizEval "call" src cst body
        checkEq ["2", "0", "0"] outs }
  ]

builtin_initialize registerGroup group

end Tests.ScryC2Wil
