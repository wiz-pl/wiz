import Tests.Elab

open Wiz

-- Closed terms are normally evaluated at program start-up; that would execute
-- unimplemented `sorry`s before any test runs.
set_option compiler.extract_closed false

namespace Tests.Elab

/-!
# Value-level semantics matrix (stage 22)

The data is `Tests/Semantics/cells.tsv`, generated by `scripts/gen-semantics-matrix.py`
together with `docs/semantics-matrix.md`.  Every cell has one documented expected value;
the cases below run the cells through each pipeline that can express them and compare,
one case per pipeline:

* `#eval` — the core interpreter (`Wiz/Core/Eval.lean`), the model;
* `#run` — the Lean frontend's IR interpreter;
* Lean → C — the `implemented_by` natives in `runtime/`;
* Wiz → C — the self-hosted frontend's C (`selfhost/`), for the prelude fragment it
  covers (its `Nat` is 63 bits and it has no `import Word`);
* the kernel, by `refl`, for a curated subset: the definitions compute, not just an
  interpreter.

A cell is skipped, not passed, where the pipeline cannot express it (see
`docs/semantics-matrix.md`, "Where a backend cannot run a cell").
-/

structure SCell where
  id : String
  family : String
  width : String
  op : String
  label : String
  expr : String
  expected : String
  channel : String
  interp : Bool
  prelude : Bool
  note : String
  deriving Inhabited

def readCells : IO (Array SCell) := do
  let text ← IO.FS.readFile "Tests/Semantics/cells.tsv"
  let lines := (text.splitOn "\n").filter (fun l => !l.trimAscii.isEmpty)
  let mut cells : Array SCell := #[]
  for line in lines.drop 1 do
    match line.splitOn "\t" with
    | [id, family, width, op, label, expr, expected, channel, interp, prelude, note] =>
      cells := cells.push
        { id, family, width, op, label, expr, expected, channel
          interp := interp == "True", prelude := prelude == "True", note }
    | fs => throw (IO.userError s!"cells.tsv: expected 11 fields, got {fs.length}: {line}")
  return cells

/-! ## Programs -/

/-- The helpers the generated programs use.  `rotl` is the documented composition (there
is no rotate primitive); `intCode` observes an `Int` by sign and magnitude. -/
def semHelpers : String :=
  "def b2n : Bool → Nat\n  | .true => 1\n  | .false => 0\n" ++
  "def rotl {ω w : Nat} (a : UIntN w) (k : Nat) : UIntN w :=\n" ++
  "  UIntN.lor (UIntN.shiftLeft a k) (UIntN.shiftRight a (Nat.sub w k))\n" ++
  "def intCode (a : Int) : Nat := Nat.add (Nat.mul (Int.natAbs a) 2) (b2n (Int.isNeg a))\n" ++
  "def halve : Nat → Float64 → Float64\n  | .zero, x => x\n  | .succ k, x => halve k (Float64.div x (Float64.ofNat 2))\n" ++
  "def double : Nat → Float64 → Float64\n  | .zero, x => x\n  | .succ k, x => double k (Float64.add x x)\n"

def imports : String :=
  "import Word\nimport Int\nimport Text\nimport IO\nimport Data.WordBytes\n"

/-- `main : List Nat`, the channel the interpreters and C read back. -/
def natProgram (cells : Array SCell) : String :=
  imports ++ semHelpers ++
  "def main : List Nat :=\n  " ++
  (cells.foldr (fun c acc => s!".cons ({c.expr}) ({acc})") ".nil") ++ "\n"

/-- `main : IO Unit`, printing one `Float64.toString` per line (C only). -/
def floatProgram (cells : Array SCell) : String :=
  "import Word\nimport Int\nimport IO\n" ++ semHelpers ++
  "def main : IO Unit := do\n" ++
  (String.join (cells.toList.map fun c =>
    s!"  IO.println (Float64.toString ({c.expr}));\n")) ++
  "  IO.pure ()\n"

/-- `main : IO Unit`, printing one value per line, in the selfhost Prelude fragment. -/
def selfhostProgram (cells : Array SCell) : String :=
  "import Prelude\ndef b2n : Bool → Nat\n  | .true => 1\n  | .false => 0\n" ++
  "def main : IO Unit := do\n" ++
  (String.join (cells.toList.map fun c =>
    s!"  IO.println (Nat.toString ({c.expr}));\n")) ++
  "  IO.pure ()\n"

/-! ## Running one pipeline -/

inductive Got where
  | ok (vals : List String)
  | skipped (why : String)
  | failed (msg : String)

/-- Maximal runs of digits: the values of `.cons 12 (.cons 3 .nil)`, for every
pipeline that prints a `List Nat`. -/
def digitRuns (s : String) : List String :=
  let rec go (cs : List Char) (cur : List Char) (acc : List String) : List String :=
    match cs with
    | [] => if cur.isEmpty then acc.reverse else (String.ofList cur.reverse) :: acc.reverse
    | c :: rest =>
      if c.isDigit then go rest (c :: cur) acc
      else if cur.isEmpty then go rest [] acc
      else go rest [] (String.ofList cur.reverse :: acc)
  go s.toList [] []

def frontendState (src : String) : IO (CommandState ZeroOneMany) := do
  let loader ← libLoader
  pure (runFrontend (R := ZeroOneMany) src { loader, trustedModule := Tests.libModule })

def frontendErrors (src : String) : IO (List String) := do
  let s ← frontendState src
  pure ((s.messages.filter (·.severity == .error)).toList.map (·.text))

/-- One of `#eval`/`#run`: elaborate `program` plus the directive on `main`, and take
the one info message it prints. -/
def runInterp (directive : String) (program : String) : IO Got := do
  let src := program ++ "\n" ++ directive ++ " main\n"
  let s ← frontendState src
  let errs := (s.messages.filter (·.severity == .error)).toList.map (·.render src)
  if !errs.isEmpty then return .failed s!"rejected:\n{"\n".intercalate errs}"
  let infos := (s.messages.filter (·.severity == .info)).toList.map (·.text)
  match infos with
  | [] => return .failed "no info message (nothing printed)"
  | is => return .ok (digitRuns ("\n".intercalate is))

def noC (e : String) : Option String :=
  if (e.splitOn "gmp.h").length > 1 then some "no GMP headers"
  else if (e.splitOn "No such file").length > 1 then some "no C toolchain"
  else if (e.splitOn "could not execute external process").length > 1 then some "no C toolchain"
  else none

/-- Lean frontend → C: compile `main` and read it back. -/
def runLeanC (program : String) : IO Got := do
  let errs ← frontendErrors program
  if !errs.isEmpty then return .failed s!"rejected:\n{"\n".intercalate errs}"
  let s ← frontendState program
  let dir ← IO.FS.createTempDir
  match ← Build.runGlobal (← toolchain) s "main" dir false (timeout := some 180) with
  | .ok out => pure (.ok (digitRuns out))
  | .error e =>
    match noC e with
    | some why => pure (.skipped why)
    | none => pure (.failed ("lean-c: " ++ e))

/-- Wiz frontend (`selfhost/`) → C, compiled with the self-hosted runtime. -/
def runWizC (program : String) : IO Got := do
  let tc ← toolchain
  if tc.gcCflags.isEmpty then return .skipped "no Boehm GC (`--gc-cflags` is empty)"
  match ← selfhostCompiler with
  | .error e =>
    match noC e with
    | some why => pure (.skipped why)
    | none => pure (.failed ("selfhost compiler: " ++ e))
  | .ok exe =>
    let dir ← IO.FS.createTempDir
    IO.FS.writeFile (dir / "input.wiz") program
    -- (`build`, not the one-shot mode: flags without a command are the host's usage, so
    -- a module root needs a command; `--no-cache` keeps the run out of `$HOME/.cache`)
    let comp ← IO.Process.output
      { cmd := "timeout", cwd := dir,
        args := #["300", exe.toString, "build", "input.wiz", "-I", "lib", "--no-cache", "-o", "out.c"] }
    if comp.exitCode != 0 then
      return .failed s!"selfhost frontend: {comp.stdout.take 1000}{comp.stderr.take 2000}"
    let rt := (← IO.currentDir) / "selfhost"
    let args := #["-O1", "-w", s!"-I{rt}"] ++ tc.gcCflags.toArray ++
      #[(dir / "out.c").toString, "-o", (dir / "prog").toString] ++ tc.gcLdflags.toArray
    let cc ← IO.Process.output { cmd := tc.cc, args, cwd := dir }
    if cc.exitCode != 0 then
      match noC cc.stderr with
      | some why => pure (.skipped why)
      | none => pure (.failed s!"selfhost cc: {cc.stderr.take 2000}")
    else
      let run ← IO.Process.output
        { cmd := "timeout", args := #["60", (dir / "prog").toString], cwd := dir }
      if run.exitCode != 0 then
        return .failed s!"selfhost program failed ({run.exitCode}): {run.stderr.take 2000}"
      pure (.ok ((run.stdout.splitOn "\n").filter (fun l => !l.trimAscii.isEmpty)))

/-! ## Comparing -/

structure Finding where
  id : String
  expected : String
  got : String

def mismatchTable (fs : Array Finding) : String :=
  let rows := fs.toList.map fun f => s!"| `{f.id}` | `{f.expected}` | {f.got} |"
  "| cell | expected | got |\n|---|---|---|\n" ++ "\n".intercalate rows

/-- Compare one pipeline's values with the cells, in order.  `missing` is the values'
length if it is wrong (a harness bug, reported as such). -/
def compare (pipeline : String) (cells : Array SCell) (got : Got) : IO (Except String (Array Finding)) := do
  match got with
  | .skipped why =>
    -- a skipped case is not a pass: the driver shows it as ⊘ (the cases that do run
    -- still compare; this one could not)
    skip s!"{why} ({pipeline}: {cells.size} cells not compared)"
    pure (.ok #[])
  | .failed msg => pure (.error s!"{pipeline}: {msg}")
  | .ok vals =>
    if vals.length != cells.size then
      pure (.error s!"{pipeline}: {vals.length} values for {cells.size} cells (harness bug)")
    else
      let fs := (cells.zip vals.toArray).foldl (init := #[]) fun acc (c, v) =>
        if c.expected == v then acc else acc.push { id := c.id, expected := c.expected, got := v }
      note s!"{pipeline}: {cells.size} cells, {fs.size} mismatches"
      if fs.isEmpty then pure (.ok #[]) else pure (.error (mismatchTable fs))

/-- Run one pipeline over its cells, compare, and print the coverage note. -/
def case (name pipeline : String) (cells : Array SCell) (run : Array SCell → IO Got) : IO Unit := do
  let got ← run cells
  match ← compare pipeline cells got with
  | .ok _ => pure ()
  | .error msg => throw (IO.userError s!"{name}:\n{msg}")

/-- Run in chunks: the IR compiler and the C backend are superlinear in the length of
one nested list literal (3000 cells take minutes, 500 take five seconds), so each chunk
is a program of its own and the values are concatenated in cell order. -/
def chunked (n : Nat) (cs : Array SCell) (one : Array SCell → IO Got) : IO Got := do
  let mut vals : List String := []
  let mut i := 0
  while i < cs.size do
    let chunk := cs.extract i (min (i + n) cs.size)
    match ← one chunk with
    | .ok v => vals := vals ++ v
    | .failed e => return .failed e
    | .skipped w => return .skipped w
    i := i + n
  return .ok vals

/-! ## The cases -/

def natCells (cells : Array SCell) : Array SCell :=
  cells.filter fun c => c.channel == "nat"
def interpCells (cells : Array SCell) : Array SCell :=
  cells.filter fun c => c.channel == "nat" && c.interp
def floatCells (cells : Array SCell) : Array SCell :=
  cells.filter fun c => c.channel == "str"
def selfhostCells (cells : Array SCell) : Array SCell :=
  cells.filter fun c => c.channel == "nat" && c.prelude

/-- The kernel subset: width 8 words, plus all of `Nat` and `Int`, so `refl` pins that
the definitions compute, not just an interpreter. -/
def kernelCells (cells : Array SCell) : Array SCell :=
  cells.filter fun c =>
    c.interp &&
    ((c.family == "uintn" || c.family == "intn") && c.width == "8" ||
     c.family == "nat" || c.family == "int")

def kernelSource (cells : Array SCell) : String :=
  imports ++ semHelpers ++
  "def main : List Nat :=\n  " ++
  (cells.foldr (fun c acc => s!".cons ({c.expr}) ({acc})") ".nil") ++ "\n" ++
  "def expected : List Nat :=\n  " ++
  (cells.foldr (fun c acc => s!".cons ({c.expected}) ({acc})") ".nil") ++ "\n"

def semanticsGroup : Group where
  name := "semantics"
  exercise := "Stage 22 (value-level semantics matrix)"
  shard := "semantics"
  cases := [
    { name := "the matrix data is well formed", run := fun _ => do
        let cells ← readCells
        check (cells.size > 1000) s!"only {cells.size} cells"
        let ids := cells.map (·.id)
        check (ids.toList.eraseDups.length == ids.size) "duplicate cell ids"
        for c in cells do
          check (!c.expected.isEmpty) s!"{c.id}: no expected value"
          if c.channel == "nat" then
            unless c.expected.toNat?.isSome do
              throw (IO.userError s!"{c.id}: expected '{c.expected}' is not a Nat")
          check (c.channel == "nat" || c.channel == "str") s!"{c.id}: channel {c.channel}"
        let fams := ["uintn", "intn", "nat", "int", "float", "text"]
        for f in fams do
          check (cells.any (·.family == f)) s!"no {f} cells"
        note s!"{cells.size} cells, {interpCells cells |>.size} evaluable by the interpreters, {selfhostCells cells |>.size} in the selfhost fragment" },
    { name := "the interpreters agree (#eval)", run := fun _ => do
        let cells ← readCells
        let cs := interpCells cells
        case "the interpreters agree (#eval)" "#eval" cs (fun cs => chunked 500 cs (fun c => runInterp "#eval" (natProgram c))) },
    { name := "the IR interpreter agrees (#run)", run := fun _ => do
        let cells ← readCells
        let cs := interpCells cells
        case "the IR interpreter agrees (#run)" "#run" cs (fun cs => chunked 100 cs (fun c => runInterp "#run" (natProgram c))) },
    { name := "Lean → C agrees with every value", run := fun _ => do
        let cells ← readCells
        let cs := natCells cells
        case "Lean → C agrees with every value" "Lean→C" cs (fun cs => chunked 500 cs (fun c => runLeanC (natProgram c))) },
    { name := "Float64 values (Lean → C)", run := fun _ => do
        let cells ← readCells
        let cs := floatCells cells
        let program := floatProgram cs
        let errs ← frontendErrors program
        unless errs.isEmpty do throw (IO.userError s!"rejected:\n{"\n".intercalate errs}")
        let s ← frontendState program
        let dir ← IO.FS.createTempDir
        match ← Build.runGlobal (← toolchain) s "main" dir false (timeout := some 180) with
        | .error e =>
          match noC e with
          | some why => skip why
          | none => throw (IO.userError e)
        | .ok out =>
          let vals := (out.splitOn "\n").filter (fun l => !l.trimAscii.isEmpty)
          if vals.length != cs.size then
            throw (IO.userError s!"{vals.length} values for {cs.size} cells (harness bug)")
          let fs := (cs.zip vals.toArray).foldl (init := #[]) fun acc (c, v) =>
            if c.expected == v then acc else acc.push { id := c.id, expected := c.expected, got := v }
          note s!"Float64: {cs.size} cells, {fs.size} mismatches"
          unless fs.isEmpty do
            throw (IO.userError ("Float64:\n" ++ mismatchTable fs)) },
    { name := "Wiz → C agrees (self-hosted frontend)", run := fun _ => do
        let cells ← readCells
        let cs := selfhostCells cells
        check (!cs.isEmpty) "no selfhost cells"
        case "Wiz → C agrees (self-hosted frontend)" "Wiz→C" cs (fun cs => chunked 200 cs (fun c => runWizC (selfhostProgram c))) },
    { name := "the kernel computes the width-8 words, Nat and Int", run := fun _ => do
        let cells ← readCells
        let cs := kernelCells cells
        let src := kernelSource cs ++ "def t : main = expected := refl main\n"
        let errs ← frontendErrors src
        unless errs.isEmpty do throw (IO.userError s!"rejected:\n{"\n".intercalate errs}")
        note s!"kernel: {cs.size} cells by refl" }
  ]

builtin_initialize registerGroup semanticsGroup

end Tests.Elab
