import Tower.Cli
-- the pure parts of tower (stage 26e), also checked through the `tower` test group
#eval Tower.latestTag (("refs/tags/v1.9.2", "") :> ("refs/tags/v1.10.0", "") :> ("refs/tags/x", "") :> ("refs/heads/v9", "") :> .nil)
#eval Tower.flakeRef "github:o/r" "abc"
#eval Tower.flakeRef "git+file:///r" "abc"
#eval Tower.flakeRef "git+file:///r?dir=x" "abc"
#eval Tower.peel (Tower.lsRows (String.splitOn "c1\trefs/heads/main\nc2\trefs/tags/v1\nc3\trefs/tags/v1^{}\n" "\n"))
#eval Tower.tcName "agent/x y"
#eval Tower.shQuote "it's"
#eval Tower.flagWords (("cflags", "-I/opt/gmp/include") :> ("cc", "gcc") :> .nil)
#eval match Settings.parse "default v1\ncflags -I/x y\noverride v1 /a b\n# comment\n" with
  | .ok s => Settings.render s
  | .error e => e
#eval match Settings.parse "colour blue\n" with
  | .ok s => "parsed"
  | .error e => e
#eval Info.render (Info.parse (Info.render (Info.mk "v1" "source" "v1" "abc" "" (("cc", "gcc") :> .nil))))
#eval Tower.opts ("v1" :> "--source" :> "release" :> "--cc" :> "gcc" :> "--force" :> .nil)
#eval Tower.flagWords (("root", "/r") :> ("region-cache", "true") :> ("cache-ro", "/a") :> ("cache-ro", "/b") :> .nil)
#eval Tower.safeMemberName "wiz-x86_64-linux/bin/wiz"
#eval Tower.safeMemberName "../escape"
#eval Tower.safeMemberName "/etc/passwd"
#eval Tower.safeMemberName "wiz-x86_64-linux/../../escape"
#eval Tower.safeMemberName "wiz-x86_64-linux/..hidden"
#eval Tower.unsafeMember (Tower.tarMembers ("wiz-x86_64-linux/bin/wiz" :> "wiz-x86_64-linux" :> .nil) ("-" :> "d" :> .nil))
#eval Tower.unsafeMember (Tower.tarMembers ("wiz-x86_64-linux/bin/wiz" :> "../escape" :> .nil) ("-" :> "-" :> .nil))
#eval Tower.unsafeMember (Tower.tarMembers ("wiz-x86_64-linux/evil" :> .nil) ("lrwxrwxrwx 0/0 0 1970-01-01 00:00 wiz-x86_64-linux/evil -> ../../outside" :> .nil))
#eval Tower.unsafeMember (Tower.tarMembers ("usr/lib/ld-linux-x86-64.so.2" :> .nil) ("lrwxrwxrwx 0/0 0 1970-01-01 00:00 usr/lib/ld-linux-x86-64.so.2 -> ld-2.27.so" :> .nil))
#eval Tower.unsafeMember (Tower.tarMembers ("usr/lib/x" :> .nil) ("lrwxrwxrwx 0/0 0 1970-01-01 00:00 usr/lib/x -> ../../lib/y" :> .nil))
#eval Tower.unsafeMember (Tower.tarMembers ("usr/lib/x" :> .nil) ("lrwxrwxrwx 0/0 0 1970-01-01 00:00 usr/lib/x -> ../../../outside" :> .nil))
#eval Tower.unsafeMember (Tower.tarMembers ("usr/lib/b" :> .nil) ("hrw-r--r-- 0/0 0 1970-01-01 00:00 usr/lib/b link to usr/lib/a" :> .nil))
#eval Tower.unsafeMember (Tower.tarMembers ("usr/lib/b" :> .nil) ("hrw-r--r-- 0/0 0 1970-01-01 00:00 usr/lib/b link to ../outside" :> .nil))
#eval Tower.unsafeMember (Tower.tarMembers ("a" :> .nil) ("drwxr-xr-x 0/0 0 1970-01-01 00:00 a/" :> .nil))
#eval Tower.safeSymlink 0 "ld-2.27.so"
#eval Tower.safeSymlink 2 "../../lib/y"
#eval Tower.safeSymlink 1 "../../outside"
#eval Tower.safeSymlink 1 "/etc/passwd"
#eval Tower.safeHardlink "usr/lib/a"
#eval Tower.safeHardlink "../a"
