#!/bin/sh
# Remind the pusher which registered light checks have no clean record for the
# commit(s) being pushed.  This is advisory: it always exits 0 and never blocks
# a push.
#
# The records live in `.checks/` (gitignored, per worktree) and are written by
# `scripts/checks-ledger.py run NAME`.  They are keyed by commit + check, so an
# amend or rebase needs fresh runs.  `.checks/` is untrusted by design: it is a
# fast-fail reminder, not a security gate, and CI does not read it.
#
# Install the repository's hooks once per clone:
#     git config core.hooksPath .githooks
# (scripts/install-hooks.sh is the older per-clone alternative; it does not
# install this warning.)
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/scripts/checks-ledger.py" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

python3 "$root/scripts/checks-ledger.py" warn --pre-push || true
exit 0
