import Prelude
def Trace (A : Type) : Type := Nat → A
def Mealy (S I O : Type) : Type := S → I → S × O
def Mealy.stateAt {S I O : Type} (m : Mealy S I O) (s0 : S) (xs : Trace I) : Nat → S
  | .zero => s0
  | .succ t => (m (Mealy.stateAt m s0 xs t) (xs t)).1
structure Bits8 where
  b0 : Bool
  b1 : Bool
  b2 : Bool
  b3 : Bool
  b4 : Bool
  b5 : Bool
  b6 : Bool
  b7 : Bool
def Bits8.zero : Bits8 := Bits8.mk .false .false .false .false .false .false .false .false
-- SLOW: the state is a record/Σ (Nat × (Nat × Bits8)): conversion η-splits the equation into 10 fields
def S : Type := Nat × (Nat × Bits8)
def spec (s : S) (x : Bool × Bits8) : S × Bool :=
  (match Nat.beq s.1 0 with
    | .true => (match x.1 with
      | .true => (10, (0, x.2))
      | .false => (match Nat.beq s.2.1 3 with
        | .true => (0, (0, s.2.2))
        | .false => (0, (Nat.succ s.2.1, s.2.2))))
    | .false => (match Nat.beq s.2.1 3 with
      | .true => (Nat.sub s.1 1, (0, s.2.2))
      | .false => (s.1, (Nat.succ s.2.1, s.2.2))),
   s.2.2.b0)
def s0 : S := (0, (0, Bits8.zero))
def tSlow (xs : Trace (Bool × Bits8)) (t : Nat) :
    Mealy.stateAt spec s0 xs (Nat.succ t) = (spec (Mealy.stateAt spec s0 xs t) (xs t)).1 := sorry
